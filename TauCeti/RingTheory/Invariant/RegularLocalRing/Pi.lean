/-!
# Product-group invariants of complete regular local rings

This file proves Katz–Mazur Variant 7.5.3: if `A` is a complete Noetherian regular local ring with
perfect residue field and regular system of parameters `x : ι → A`, and a finite product
`∀ i : ι, H i` of finite groups acts faithfully on `A` and trivially on `ResidueField A` so that
every `g` with `g j = 1` fixes `x j`, then:

1. `FixedPoints.subring A (∀ i, H i)` is a complete regular local ring of the same Krull dimension
   as `A` (`isRegularLocalRing_subring_pi`, `isAdicComplete_subring_pi`,
   `spanFinrank_maximalIdeal_subring_pi`);
2. its maximal ideal is generated by the coordinate orbit products
   `∏_{h ∈ H i} Pi.mulSingle i h • x i` (`maximalIdeal_subring_pi_eq_span`);
3. `A` is a free module over `FixedPoints.subring A (∀ i, H i)` with monomial basis
   `∏ i, x i ^ (e i : ℕ)` for `e : ∀ i, Fin (Nat.card (H i))` (`basisPi`).

The proof proceeds by finite induction over subsets `s : Finset ι`, applying Katz–Mazur
Theorem 7.5.2 one factor `H a` at a time.

## Main definitions

* `TauCeti.FixedPoints.factorOrbitProd`: the coordinate orbit product
  `∏_{h ∈ H i} Pi.mulSingle i h • x i` in `A^(∀ i, H i)`.
* `TauCeti.FixedPoints.basisPi`: the monomial basis `∏ i, x i ^ e i` (`e i < |H i|`) of `A` over
  `A^(∀ i, H i)`.

## Main results

* `TauCeti.FixedPoints.isRegularLocalRing_subring_pi`: `A^(∀ i, H i)` is a regular local ring.
* `TauCeti.FixedPoints.isAdicComplete_subring_pi`: `A^(∀ i, H i)` is complete for its maximal ideal.
* `TauCeti.FixedPoints.maximalIdeal_subring_pi_eq_span`: the coordinate orbit products form a
  regular system of parameters of `A^(∀ i, H i)`.
* `TauCeti.FixedPoints.spanFinrank_maximalIdeal_subring_pi`: `spanFinrank 𝔪 = |ι|`.
* `TauCeti.FixedPoints.basisPi_apply`: the `e`-th basis vector of `basisPi` is
  `∏ i, x i ^ (e i : ℕ)`.

## References

* N. M. Katz and B. Mazur, *Arithmetic Moduli of Elliptic Curves*, Variant 7.5.3.
-/

public section

open IsLocalRing Ideal

namespace TauCeti.FixedPoints

universe u

variable {A : Type u} [CommRing A] {ι : Type*}
variable (H : ι → Type*) [∀ i, Group (H i)] [∀ i, Finite (H i)]
variable [MulSemiringAction (∀ i, H i) A]

/-- **Coordinate orbit product** `∏_{h ∈ H i} Pi.mulSingle i h • x i` as an element of
`FixedPoints.subring A (∀ i, H i)`, assuming that every `g` with `g i = 1` fixes `x i`. -/
noncomputable def factorOrbitProd {x : ι → A}
    (hfix : ∀ (g : ∀ i, H i) (j : ι), g j = 1 → g • x j = x j) (i : ι) :
    FixedPoints.subring A (∀ i, H i) := by
  classical
  have := Fintype.ofFinite (H i)
  refine ⟨∏ h : H i, Pi.mulSingle i h • x i, fun g ↦ ?_⟩
  let g' : ∀ k, H k := (Pi.mulSingle i (g i))⁻¹ * g
  have hg : g = Pi.mulSingle i (g i) * g' := by simp [g']
  have hg'i : g' i = 1 := by simp [g']
  have hcomm : ∀ h : H i, g' * Pi.mulSingle i h = Pi.mulSingle i h * g' := fun h ↦ by
    ext k
    by_cases hki : k = i
    · subst hki; simp [hg'i]
    · simp [Pi.mulSingle_eq_of_ne hki]
  have hsmul : ∀ h : H i, g • (Pi.mulSingle i h • x i) = Pi.mulSingle i (g i * h) • x i :=
    fun h ↦ calc
      g • (Pi.mulSingle i h • x i)
          = (Pi.mulSingle i (g i) * g' * Pi.mulSingle i h) • x i := by rw [← mul_smul, ← hg]
      _ = (Pi.mulSingle i (g i) * Pi.mulSingle i h * g') • x i := by
            rw [mul_assoc, hcomm h, ← mul_assoc]
      _ = Pi.mulSingle i (g i * h) • (g' • x i) := by rw [← Pi.mulSingle_mul, mul_smul]
      _ = Pi.mulSingle i (g i * h) • x i := by rw [hfix g' i hg'i]
  rw [← MulSemiringAction.toRingHom_apply (∀ k, H k) A g, map_prod]
  trans ∏ h : H i, Pi.mulSingle i (g i * h) • x i
  · exact Finset.prod_congr rfl fun h _ ↦ hsmul h
  · exact Fintype.prod_equiv (Equiv.mulLeft (g i)) _ _ fun _ ↦ rfl

/-- The underlying element of `factorOrbitProd H hfix i` in `A` is
`∏ h : H i, Pi.mulSingle i h • x i`. -/
@[simp]
theorem coe_factorOrbitProd [DecidableEq ι] {x : ι → A}
    (hfix : ∀ (g : ∀ i, H i) (j : ι), g j = 1 → g • x j = x j) (i : ι) [Fintype (H i)] :
    (factorOrbitProd H hfix i : A) = ∏ h : H i, Pi.mulSingle i h • x i := by
  classical
  dsimp only [factorOrbitProd]
  refine Finset.prod_congr (by ext; simp) fun h _ ↦ ?_
  congr 1
  ext k
  by_cases hki : k = i
  · subst hki; simp
  · trans (1 : H k)
    · convert Pi.mulSingle_eq_of_ne hki h
    · exact (Pi.mulSingle_eq_of_ne hki h).symm

/-- The subgroup of `∀ i, H i` consisting of elements supported on a finite subset `s : Finset ι`.
-/
private def suppSubgroup (s : Finset ι) : Subgroup (∀ i, H i) where
  carrier := {g | ∀ i ∉ s, g i = 1}
  mul_mem' ha hb i hi := by simp [ha i hi, hb i hi]
  one_mem' _ _ := rfl
  inv_mem' ha i hi := by simp [ha i hi]

/-- The `i`-th parameter of the intermediate invariant ring `A^(suppSubgroup H s)`: it is
`factorOrbitProd H hfix i` for `i ∈ s` and `x i` for `i ∉ s`. -/
private noncomputable def paramAt [DecidableEq ι] {x : ι → A}
    (hfix : ∀ (g : ∀ i, H i) (j : ι), g j = 1 → g • x j = x j) (s : Finset ι) (i : ι) :
    FixedPoints.subring A (suppSubgroup H s) :=
  if hi : i ∈ s then
    ⟨(factorOrbitProd H hfix i : A), fun g ↦ (factorOrbitProd H hfix i).2 g.1⟩
  else
    ⟨x i, fun g ↦ hfix g.1 i (g.2 i hi)⟩

/-- For `a ∉ s`, the factor `H a` acts on `A^(suppSubgroup H s)` via `Pi.mulSingle a`. -/
@[instance_reducible]
private def mulSingleAction [DecidableEq ι] {s : Finset ι} {a : ι} (ha : a ∉ s) :
    MulSemiringAction (H a) (FixedPoints.subring A (suppSubgroup H s)) where
  smul h b := ⟨Pi.mulSingle a h • (b : A), fun g ↦ by
    have hga : g.1 a = 1 := g.2 a ha
    have hcomm : g.1 * Pi.mulSingle a h = Pi.mulSingle a h * g.1 := by
      ext k
      by_cases hka : k = a
      · subst hka; simp [hga]
      · simp [Pi.mulSingle_eq_of_ne hka]
    rw [Subgroup.smul_def, ← mul_smul, hcomm, mul_smul, ← Subgroup.smul_def, b.2 g]⟩
  one_smul b := Subtype.ext <| (congrArg (· • (b : A)) (Pi.mulSingle_one a)).trans (one_smul _ _)
  mul_smul h₁ h₂ b :=
    Subtype.ext <| (congrArg (· • (b : A)) (Pi.mulSingle_mul a h₁ h₂)).trans (mul_smul _ _ _)
  smul_zero h := Subtype.ext (smul_zero _)
  smul_add h b₁ b₂ := Subtype.ext (smul_add _ _ _)
  smul_one h := Subtype.ext (smul_one _)
  smul_mul h b₁ b₂ := Subtype.ext (smul_mul' _ _ _)

/-- For `a ∉ s`, taking `H a`-invariants of `A^(suppSubgroup H s)` yields
`A^(suppSubgroup H (insert a s))`. -/
private def stepRingEquiv [DecidableEq ι] {s : Finset ι} {a : ι} (ha : a ∉ s) :
    let _ := mulSingleAction (A := A) H ha
    FixedPoints.subring (FixedPoints.subring A (suppSubgroup H s)) (H a) ≃+*
      FixedPoints.subring A (suppSubgroup H (insert a s)) := by
  let _ := mulSingleAction (A := A) H ha
  refine
    { toFun := fun b ↦ ⟨(b.1 : A), fun g ↦ ?_⟩
      invFun := fun b ↦ ⟨⟨(b : A), fun g ↦ b.2 ⟨g.1, fun i hi ↦
        g.2 i fun his ↦ hi (Finset.mem_insert_of_mem his)⟩⟩, fun h ↦ Subtype.ext <|
        b.2 ⟨Pi.mulSingle a h, fun i hi ↦ Pi.mulSingle_eq_of_ne
          (fun hia ↦ hi (by rw [hia]; exact Finset.mem_insert_self a s)) h⟩⟩
      left_inv := fun _ ↦ rfl
      right_inv := fun _ ↦ rfl
      map_mul' := fun _ _ ↦ rfl
      map_add' := fun _ _ ↦ rfl }
  let g' : ∀ k, H k := (Pi.mulSingle a (g.1 a))⁻¹ * g.1
  have hg' : g' ∈ suppSubgroup H s := fun i hi ↦ by
    by_cases hia : i = a
    · subst hia; simp [g']
    · have hi' : i ∉ insert a s := by simp [hia, hi]
      simp [g', Pi.mulSingle_eq_of_ne hia, g.2 i hi']
  have hg : g.1 = Pi.mulSingle a (g.1 a) * g' := by simp [g']
  have h1 : g' • (b.1 : A) = (b.1 : A) := b.1.2 ⟨g', hg'⟩
  have h2 : Pi.mulSingle a (g.1 a) • (b.1 : A) = (b.1 : A) := congrArg Subtype.val (b.2 (g.1 a))
  rw [Subgroup.smul_def, hg, mul_smul, h1, h2]

/-- Splitting a dependent tuple on `insert a s` (`a ∉ s`) into its `a`-coordinate and its
restriction to `s`. -/
private noncomputable def piInsertEquiv [DecidableEq ι] {s : Finset ι} {a : ι} (ha : a ∉ s) :
    (Fin (Nat.card (H a)) × (∀ i : s, Fin (Nat.card (H i.1)))) ≃
      (∀ i : (insert a s : Finset ι), Fin (Nat.card (H i.1))) where
  toFun p i :=
    if h : i.1 = a then Fin.cast (by rw [h]) p.1
    else p.2 ⟨i.1, (Finset.mem_insert.mp i.2).resolve_left h⟩
  invFun f := (f ⟨a, Finset.mem_insert_self a s⟩, fun i ↦ f ⟨i.1, Finset.mem_insert_of_mem i.2⟩)
  left_inv p := by
    refine Prod.ext (by simp) (funext fun i ↦ ?_)
    have hne : i.1 ≠ a := fun h ↦ ha (h ▸ i.2)
    simp [hne]
  right_inv f := by
    funext i
    by_cases h : i.1 = a
    · rcases i with ⟨j, hj⟩
      dsimp only at h
      subst h
      simp
    · simp [h]

section InductionHelpers

variable [DecidableEq ι]

omit [∀ i, Finite (H i)] in
/-- Faithfulness of the `H a`-action on the intermediate invariant ring `A^(suppSubgroup H s)` when
`A` has a monomial basis in `x i` (`i ∈ s`) over `A^(suppSubgroup H s)`. -/
private lemma pi_step_faithful [FaithfulSMul (∀ i, H i) A] {x : ι → A}
    (hfix : ∀ (g : ∀ i, H i) (j : ι), g j = 1 → g • x j = x j)
    {s : Finset ι} {a : ι} (ha : a ∉ s)
    (b_s : Module.Basis (∀ i : s, Fin (Nat.card (H i.1)))
      (FixedPoints.subring A (suppSubgroup H s)) A)
    (hb_s : ∀ e, b_s e = ∏ i : s, x i.1 ^ (e i : ℕ)) :
    let _ := mulSingleAction (A := A) H ha
    FaithfulSMul (H a) (FixedPoints.subring A (suppSubgroup H s)) := by
  let _ := mulSingleAction (A := A) H ha
  refine ⟨fun {h₁ h₂} hh ↦ ?_⟩
  have hsingle : Pi.mulSingle a h₁ = Pi.mulSingle a h₂ := eq_of_smul_eq_smul fun r ↦ by
    rw [← b_s.sum_repr r]
    have hmap : ∀ h : H a, Pi.mulSingle a h • (∑ e, b_s.repr r e • b_s e) =
        ∑ e, (Pi.mulSingle a h • (b_s.repr r e : A)) * b_s e := fun h ↦ by
      rw [← MulSemiringAction.toRingHom_apply (∀ k, H k) A (Pi.mulSingle a h), map_sum]
      refine Finset.sum_congr rfl fun e _ ↦ ?_
      rw [Subring.smul_def, smul_eq_mul, map_mul, hb_s e, map_prod]
      congr 1
      refine Finset.prod_congr rfl fun i _ ↦ ?_
      have hne : i.1 ≠ a := fun h' ↦ ha (h' ▸ i.2)
      rw [map_pow, MulSemiringAction.toRingHom_apply, hfix _ i.1 (Pi.mulSingle_eq_of_ne hne h)]
    rw [hmap h₁, hmap h₂]
    exact Finset.sum_congr rfl fun e _ ↦ congrArg (· * b_s e) (congrArg Subtype.val (hh _))
  simpa using congrFun hsingle a

/-- Transporting the maximal ideal generating set along `stepRingEquiv H ha`. -/
private lemma pi_step_maximalIdeal [IsLocalRing A] {x : ι → A}
    (hfix : ∀ (g : ∀ i, H i) (j : ι), g j = 1 → g • x j = x j)
    {s : Finset ι} {a : ι} (ha : a ∉ s)
    (hfix_a : ∀ (h : H a) (i : {i : ι // i ≠ a}),
      (mulSingleAction (A := A) H ha).smul h (paramAt H hfix s i.1) = paramAt H hfix s i.1)
    (hmax_C : let _ := mulSingleAction (A := A) H ha
      let Bs := FixedPoints.subring A (suppSubgroup H s)
      let C := FixedPoints.subring Bs (H a)
      maximalIdeal C = span (insert (orbitProd (H a) (paramAt H hfix s a))
        (Set.range fun i : {i : ι // i ≠ a} ↦ (⟨paramAt H hfix s i.1, fun h ↦ hfix_a h i⟩ : C)))) :
    maximalIdeal (FixedPoints.subring A (suppSubgroup H (insert a s))) =
      span (Set.range (paramAt H hfix (insert a s))) := by
  let _ := mulSingleAction (A := A) H ha
  let Bs := FixedPoints.subring A (suppSubgroup H s)
  let C := FixedPoints.subring Bs (H a)
  let e := stepRingEquiv (A := A) H ha
  have horbit : (e (orbitProd (H a) (paramAt H hfix s a)) : A) =
      (factorOrbitProd H hfix a : A) := by
    have := Fintype.ofFinite (H a)
    have hcoe : (e (orbitProd (H a) (paramAt H hfix s a)) : A) =
        ((orbitProd (H a) (paramAt H hfix s a) : Bs) : A) := rfl
    rw [hcoe, coe_orbitProd, coe_factorOrbitProd, ← Subring.coe_subtype, map_prod]
    refine Finset.prod_congr rfl fun h _ ↦ ?_
    simp only [Subring.coe_subtype, paramAt, ha, ↓reduceDIte]
    rfl
  rw [← map_maximalIdeal_of_surjective e.toRingHom e.surjective, hmax_C, Ideal.map_span]
  congr 1
  ext r
  simp only [Set.mem_image, Set.mem_insert_iff, Set.mem_range]
  constructor
  · rintro ⟨_, rfl | ⟨⟨i, hia⟩, rfl⟩, rfl⟩
    · refine ⟨a, Subtype.ext ?_⟩
      simp only [paramAt, Finset.mem_insert_self, ↓reduceDIte]
      exact horbit.symm
    · refine ⟨i, Subtype.ext ?_⟩
      by_cases his : i ∈ s
      · simp [paramAt, his, e, stepRingEquiv]
      · have hi' : i ∉ insert a s := by simp [hia, his]
        simp [paramAt, his, hi', e, stepRingEquiv]
  · rintro ⟨i, rfl⟩
    by_cases hia : i = a
    · subst hia
      refine ⟨orbitProd (H i) (paramAt H hfix s i), Or.inl rfl, Subtype.ext ?_⟩
      simp only [paramAt, Finset.mem_insert_self, ↓reduceDIte]
      exact horbit
    · refine ⟨(⟨paramAt H hfix s i, fun h ↦ hfix_a h ⟨i, hia⟩⟩ : C),
        Or.inr ⟨⟨i, hia⟩, rfl⟩, Subtype.ext ?_⟩
      by_cases his : i ∈ s
      · simp [paramAt, his, e, stepRingEquiv]
      · have hi' : i ∉ insert a s := by simp [hia, his]
        simp [paramAt, his, hi', e, stepRingEquiv]

/-- Building the monomial `A^(suppSubgroup H (insert a s))`-basis of `A` from a `PowerBasis` of
`A^(suppSubgroup H s)` over `C ≃+* A^(suppSubgroup H (insert a s))` and the existing basis `b_s`.
-/
private lemma pi_step_basis {x : ι → A}
    (hfix : ∀ (g : ∀ i, H i) (j : ι), g j = 1 → g • x j = x j)
    {s : Finset ι} {a : ι} (ha : a ∉ s)
    (b_s : Module.Basis (∀ i : s, Fin (Nat.card (H i.1)))
      (FixedPoints.subring A (suppSubgroup H s)) A)
    (hb_s : ∀ e, b_s e = ∏ i : s, x i.1 ^ (e i : ℕ))
    (pb : let _ := mulSingleAction (A := A) H ha
      PowerBasis (FixedPoints.subring (FixedPoints.subring A (suppSubgroup H s)) (H a))
        (FixedPoints.subring A (suppSubgroup H s)))
    (hgen : pb.gen = paramAt H hfix s a) (hdim : pb.dim = Nat.card (H a)) :
    ∃ b' : Module.Basis (∀ i : (insert a s : Finset ι), Fin (Nat.card (H i.1)))
      (FixedPoints.subring A (suppSubgroup H (insert a s))) A,
      ∀ f, b' f = ∏ i : (insert a s : Finset ι), x i.1 ^ (f i : ℕ) := by
  let _ := mulSingleAction (A := A) H ha
  let Bs := FixedPoints.subring A (suppSubgroup H s)
  let B' := FixedPoints.subring A (suppSubgroup H (insert a s))
  let C := FixedPoints.subring Bs (H a)
  let e : C ≃+* B' := stepRingEquiv (A := A) H ha
  let y_s : Bs := paramAt H hfix s a
  have hle : B' ≤ Bs := fun r hr g ↦
    hr ⟨g.1, fun i hi ↦ g.2 i fun his ↦ hi (Finset.mem_insert_of_mem his)⟩
  let _ : Algebra B' Bs := (Subring.inclusion hle).toAlgebra
  have _ : IsScalarTower B' Bs A := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  -- Transport the power basis of `Bs` over `C` across `e : C ≃+* B'` to a `B'`-basis of `Bs`.
  let bC : Module.Basis (Fin (Nat.card (H a))) C Bs := pb.basis.reindex (finCongr hdim)
  have hbC : ∀ k : Fin (Nat.card (H a)), bC k = y_s ^ (k : ℕ) := fun k ↦ by
    rw [Module.Basis.reindex_apply, pb.basis_eq_pow, hgen]
    simp [y_s]
  have hsmul_e : ∀ (c : C) (u : Bs), e c • u = c • u := fun c u ↦ Subtype.ext <| by
    rw [Algebra.smul_def, Subring.smul_def, smul_eq_mul]
    rfl
  have hli_step : LinearIndependent B' (fun k : Fin (Nat.card (H a)) ↦ y_s ^ (k : ℕ)) := by
    rw [Fintype.linearIndependent_iff]
    intro g hg k
    have hgC : ∑ j : Fin (Nat.card (H a)), e.symm (g j) • bC j = 0 := by
      rw [← hg]
      refine Finset.sum_congr rfl fun j _ ↦ ?_
      rw [hbC, ← hsmul_e, RingEquiv.apply_symm_apply]
    have hk0 : e.symm (g k) = 0 :=
      (Fintype.linearIndependent_iff.mp bC.linearIndependent) (fun j ↦ e.symm (g j)) hgC k
    exact e.symm.injective (by simpa using hk0)
  have hspan_step :
      ⊤ ≤ Submodule.span B' (Set.range fun k : Fin (Nat.card (H a)) ↦ y_s ^ (k : ℕ)) := by
    intro u _
    rw [← bC.sum_repr u]
    refine Submodule.sum_mem _ fun k _ ↦ ?_
    rw [hbC, ← hsmul_e]
    exact Submodule.smul_mem _ (e (bC.repr u k)) (Submodule.subset_span ⟨k, rfl⟩)
  let b_step : Module.Basis (Fin (Nat.card (H a))) B' Bs := Module.Basis.mk hli_step hspan_step
  -- Combine `b_step` and `b_s` via the tower basis and reindex onto `insert a s`.
  refine ⟨(b_step.smulTower b_s).reindex (piInsertEquiv H ha), fun f ↦ ?_⟩
  rw [Module.Basis.reindex_apply, Module.Basis.smulTower_apply]
  simp only [piInsertEquiv, Equiv.coe_fn_symm_mk, b_step, Module.Basis.mk_apply]
  rw [hb_s, Subring.smul_def, smul_eq_mul, SubmonoidClass.coe_pow]
  have hy_val : (y_s : A) = x a := by simp [y_s, paramAt, ha]
  rw [hy_val]
  let g : ι → A := fun i ↦ if hi : i ∈ insert a s then x i ^ (f ⟨i, hi⟩ : ℕ) else 1
  have h1 : ∏ i : (insert a s : Finset ι), x i.1 ^ (f i : ℕ) = ∏ i ∈ insert a s, g i := by
    rw [← Finset.prod_coe_sort (insert a s) g]
    exact Finset.prod_congr rfl fun i _ ↦ by simp only [g, i.2, ↓reduceDIte]
  have h2 : ∏ i : s, x i.1 ^ (f ⟨i.1, Finset.mem_insert_of_mem i.2⟩ : ℕ) = ∏ i ∈ s, g i := by
    rw [← Finset.prod_coe_sort s g]
    exact Finset.prod_congr rfl fun i _ ↦ by
      simp only [g, Finset.mem_insert_of_mem i.2, ↓reduceDIte]
  rw [h1, h2, Finset.prod_insert ha]
  simp [g]

variable [IsRegularLocalRing A] [IsAdicComplete (maximalIdeal A) A] [PerfectField (ResidueField A)]
variable [Fintype ι]

/-- Inductive step for Katz–Mazur Variant 7.5.3: adjoining one factor `H a` (`a ∉ s`) preserves
regularity, completeness, regular parameters, and the monomial basis. -/
private lemma pi_step [FaithfulSMul (∀ i, H i) A] {x : ι → A}
    (hres : ∀ (g : ∀ i, H i) (r : A), residue A (g • r) = residue A r)
    (hfix : ∀ (g : ∀ i, H i) (j : ι), g j = 1 → g • x j = x j)
    {s : Finset ι} {a : ι} (ha : a ∉ s)
    (hreg_s : IsRegularLocalRing (FixedPoints.subring A (suppSubgroup H s)))
    (hcomp_s : IsAdicComplete (maximalIdeal (FixedPoints.subring A (suppSubgroup H s)))
      (FixedPoints.subring A (suppSubgroup H s)))
    (hmax_s : maximalIdeal (FixedPoints.subring A (suppSubgroup H s)) =
      span (Set.range (paramAt H hfix s)))
    (hrank_s : (maximalIdeal (FixedPoints.subring A (suppSubgroup H s))).spanFinrank =
      Fintype.card ι)
    (b_s : Module.Basis (∀ i : s, Fin (Nat.card (H i.1)))
      (FixedPoints.subring A (suppSubgroup H s)) A)
    (hb_s : ∀ e, b_s e = ∏ i : s, x i.1 ^ (e i : ℕ)) :
    let B' := FixedPoints.subring A (suppSubgroup H (insert a s))
    IsRegularLocalRing B' ∧
    IsAdicComplete (maximalIdeal B') B' ∧
    maximalIdeal B' = span (Set.range (paramAt H hfix (insert a s))) ∧
    (maximalIdeal B').spanFinrank = Fintype.card ι ∧
    ∃ b' : Module.Basis (∀ i : (insert a s : Finset ι), Fin (Nat.card (H i.1))) B' A,
      ∀ e, b' e = ∏ i : (insert a s : Finset ι), x i.1 ^ (e i : ℕ) := by
  let Bs := FixedPoints.subring A (suppSubgroup H s)
  let B' := FixedPoints.subring A (suppSubgroup H (insert a s))
  let _ : MulSemiringAction (H a) Bs := mulSingleAction (A := A) H ha
  -- Step 1: verify the hypotheses of KM 7.5.2 for `H a` acting on `Bs`.
  have hres_s : ∀ (g : suppSubgroup H s) (r : A), residue A (g • r) = residue A r :=
    fun g r ↦ hres g.1 r
  have _ : PerfectField (ResidueField Bs) := perfectField_residueField hres_s
  have _ : FaithfulSMul (H a) Bs := pi_step_faithful H hfix ha b_s hb_s
  have hres_a : ∀ (h : H a) (b : Bs), residue Bs (h • b) = residue Bs b := fun h b ↦ by
    apply RingHom.injective (IsLocalRing.ResidueField.map Bs.subtype)
    rw [IsLocalRing.ResidueField.map_residue, IsLocalRing.ResidueField.map_residue]
    exact hres (Pi.mulSingle a h) (b : A)
  let x_s : {i : ι // i ≠ a} → Bs := fun i ↦ paramAt H hfix s i.1
  let y_s : Bs := paramAt H hfix s a
  have hspan_s : span (insert y_s (Set.range x_s)) = maximalIdeal Bs := by
    rw [hmax_s]
    congr 1
    ext r
    simp only [Set.mem_insert_iff, Set.mem_range, Subtype.exists, x_s, y_s]
    exact ⟨by rintro (rfl | ⟨i, -, rfl⟩); exacts [⟨a, rfl⟩, ⟨i, rfl⟩],
      fun ⟨i, hi⟩ ↦ by
        by_cases hia : i = a
        · exact Or.inl (hia ▸ hi.symm)
        · exact Or.inr ⟨i, hia, hi⟩⟩
  have hcard_ne : Fintype.card {i : ι // i ≠ a} + 1 = Fintype.card ι := by
    have h1 : Fintype.card {i : ι // i = a} = 1 := Fintype.card_unique
    rw [Fintype.card_subtype_compl, h1]
    exact Nat.sub_add_cancel (Fintype.card_pos_iff.mpr ⟨a⟩)
  have hrank_s' : (maximalIdeal Bs).spanFinrank = Fintype.card {i : ι // i ≠ a} + 1 :=
    hrank_s.trans hcard_ne.symm
  have hfix_a : ∀ (h : H a) (i : {i : ι // i ≠ a}), h • x_s i = x_s i := fun h i ↦ by
    apply Subtype.ext
    dsimp only [x_s, paramAt]
    split_ifs with his
    · exact (factorOrbitProd H hfix i.1).2 (Pi.mulSingle a h)
    · exact hfix (Pi.mulSingle a h) i.1 (Pi.mulSingle_eq_of_ne i.2 h)
  -- Step 2: apply KM 7.5.2 to `C = Bs^(H a)` and transport along `e : C ≃+* B'`.
  let C := FixedPoints.subring Bs (H a)
  let e : C ≃+* B' := stepRingEquiv (A := A) H ha
  have hreg_C : IsRegularLocalRing C :=
    isRegularLocalRing_subring hres_a hspan_s hrank_s' hfix_a
  have hcomp_C : IsAdicComplete (maximalIdeal C) C :=
    isAdicComplete_subring hres_a hspan_s hrank_s' hfix_a
  have hmax_C := maximalIdeal_subring_eq_span hres_a hspan_s hrank_s' hfix_a
  have hreg' : IsRegularLocalRing B' := .of_ringEquiv e
  have hcomp' : IsAdicComplete (maximalIdeal B') B' := by
    rw [← map_maximalIdeal_of_surjective e.toRingHom e.surjective]
    exact (IsAdicComplete.congr_ringEquiv (maximalIdeal C) e).mpr hcomp_C
  have hmax' := pi_step_maximalIdeal H hfix ha hfix_a hmax_C
  have hrank' : (maximalIdeal B').spanFinrank = Fintype.card ι := by
    have h1 := IsRegularLocalRing.spanFinrank_maximalIdeal (R := B')
    have h2 := IsRegularLocalRing.spanFinrank_maximalIdeal (R := Bs)
    have h3 := ringKrullDim_subring (A := Bs) (H := H a)
    have h4 := ringKrullDim_eq_of_ringEquiv e
    rw [← hrank_s]
    exact_mod_cast h1.trans (h4.symm.trans (h3.trans h2.symm))
  have hb' := pi_step_basis H hfix ha b_s hb_s (powerBasis hres_a hspan_s hrank_s' hfix_a)
    (powerBasis_gen hres_a hspan_s hrank_s' hfix_a)
    (powerBasis_dim hres_a hspan_s hrank_s' hfix_a)
  exact ⟨hreg', hcomp', hmax', hrank', hb'⟩

omit [PerfectField (ResidueField A)] in
/-- Base case (`s = ∅`) of the induction for Katz–Mazur Variant 7.5.3. -/
private lemma pi_induction_empty {x : ι → A}
    (hspan : span (Set.range x) = maximalIdeal A)
    (hrank : (maximalIdeal A).spanFinrank = Fintype.card ι)
    (hfix : ∀ (g : ∀ i, H i) (j : ι), g j = 1 → g • x j = x j) :
    let B0 := FixedPoints.subring A (suppSubgroup H ∅)
    IsRegularLocalRing B0 ∧
    IsAdicComplete (maximalIdeal B0) B0 ∧
    maximalIdeal B0 = span (Set.range (paramAt H hfix ∅)) ∧
    (maximalIdeal B0).spanFinrank = Fintype.card ι ∧
    ∃ b : Module.Basis (∀ i : (∅ : Finset ι), Fin (Nat.card (H i.1))) B0 A,
      ∀ e, b e = ∏ i : (∅ : Finset ι), x i.1 ^ (e i : ℕ) := by
  -- For `s = ∅`, `suppSubgroup H ∅` is trivial, so `B0 = ⊤ ≃+* A`.
  let B0 := FixedPoints.subring A (suppSubgroup H ∅)
  have htop : B0 = ⊤ := by
    ext r
    refine ⟨fun _ ↦ trivial, fun _ g ↦ ?_⟩
    have hg1 : g.1 = 1 := funext fun i ↦ g.2 i (Finset.notMem_empty i)
    rw [Subgroup.smul_def, hg1, one_smul]
  let e0 : B0 ≃+* A := (RingEquiv.subringCongr htop).trans Subring.topEquiv
  have hreg0 : IsRegularLocalRing B0 := .of_ringEquiv e0.symm
  have hcomp0 : IsAdicComplete (maximalIdeal B0) B0 := by
    rw [← map_maximalIdeal_of_surjective e0.symm.toRingHom e0.symm.surjective]
    exact (IsAdicComplete.congr_ringEquiv (maximalIdeal A) e0.symm).mpr inferInstance
  have hmax0 : maximalIdeal B0 = span (Set.range (paramAt H hfix ∅)) := by
    rw [← map_maximalIdeal_of_surjective e0.symm.toRingHom e0.symm.surjective, ← hspan,
      Ideal.map_span]
    congr 1
    ext r
    simp only [Set.mem_image, Set.mem_range]
    exact ⟨fun ⟨_, ⟨i, hi⟩, hr⟩ ↦ ⟨i, Subtype.ext (by simp [paramAt, e0, ← hi, ← hr])⟩,
      fun ⟨i, hi⟩ ↦ ⟨x i, ⟨i, rfl⟩, Subtype.ext (by simp [paramAt, e0, ← hi])⟩⟩
  have hrank0 : (maximalIdeal B0).spanFinrank = Fintype.card ι := by
    have h1 := IsRegularLocalRing.spanFinrank_maximalIdeal (R := B0)
    have h2 := IsRegularLocalRing.spanFinrank_maximalIdeal (R := A)
    rw [← hrank]
    exact_mod_cast h1.trans ((ringKrullDim_eq_of_ringEquiv e0).trans h2.symm)
  -- The unique empty-product basis element `1 : A` forms a `B0`-basis of `A`.
  let u : ∀ i : (∅ : Finset ι), Fin (Nat.card (H i.1)) :=
    fun i ↦ absurd i.2 (Finset.notMem_empty i.1)
  have huniv : (Finset.univ : Finset (∀ i : (∅ : Finset ι), Fin (Nat.card (H i.1)))) = {u} := by
    ext f
    simp only [Finset.mem_univ, Finset.mem_singleton, true_iff]
    exact funext fun i ↦ absurd i.2 (Finset.notMem_empty i.1)
  have hli0 : LinearIndependent B0
      (fun _ : ∀ i : (∅ : Finset ι), Fin (Nat.card (H i.1)) ↦ (1 : A)) := by
    rw [Fintype.linearIndependent_iff]
    intro g hg j
    rw [huniv, Finset.sum_singleton, Subring.smul_def, smul_eq_mul, mul_one] at hg
    have hj : j = u := funext fun i ↦ absurd i.2 (Finset.notMem_empty i.1)
    exact hj ▸ Subtype.ext hg
  have hspan0 : ⊤ ≤ Submodule.span B0
      (Set.range fun _ : ∀ i : (∅ : Finset ι), Fin (Nat.card (H i.1)) ↦ (1 : A)) := by
    intro r _
    have hr : r = e0.symm r • (1 : A) := by rw [Subring.smul_def, smul_eq_mul, mul_one]; rfl
    rw [hr]
    exact Submodule.smul_mem _ (e0.symm r) (Submodule.subset_span ⟨u, rfl⟩)
  exact ⟨hreg0, hcomp0, hmax0, hrank0, Module.Basis.mk hli0 hspan0, fun _ ↦ by simp⟩

/-- Induction on `s : Finset ι` proving Katz–Mazur Variant 7.5.3 for `suppSubgroup H s`. -/
private lemma pi_induction [FaithfulSMul (∀ i, H i) A] {x : ι → A}
    (hres : ∀ (g : ∀ i, H i) (r : A), residue A (g • r) = residue A r)
    (hspan : span (Set.range x) = maximalIdeal A)
    (hrank : (maximalIdeal A).spanFinrank = Fintype.card ι)
    (hfix : ∀ (g : ∀ i, H i) (j : ι), g j = 1 → g • x j = x j) (s : Finset ι) :
    let B := FixedPoints.subring A (suppSubgroup H s)
    IsRegularLocalRing B ∧
    IsAdicComplete (maximalIdeal B) B ∧
    maximalIdeal B = span (Set.range (paramAt H hfix s)) ∧
    (maximalIdeal B).spanFinrank = Fintype.card ι ∧
    ∃ b : Module.Basis (∀ i : s, Fin (Nat.card (H i.1))) B A,
      ∀ e, b e = ∏ i : s, x i.1 ^ (e i : ℕ) := by
  induction s using Finset.induction with
  | empty => exact pi_induction_empty H hspan hrank hfix
  | @insert a s ha ih =>
    obtain ⟨hreg_s, hcomp_s, hmax_s, hrank_s, b_s, hb_s⟩ := ih
    exact pi_step H hres hfix ha hreg_s hcomp_s hmax_s hrank_s b_s hb_s

end InductionHelpers

omit [∀ i, Finite (H i)] in
/-- Equality between `FixedPoints.subring A (∀ i, H i)` and
`FixedPoints.subring A (suppSubgroup H Finset.univ)`. -/
private lemma subring_pi_eq_univ [Fintype ι] :
    FixedPoints.subring A (∀ i, H i) = FixedPoints.subring A (suppSubgroup H Finset.univ) := by
  ext r
  exact ⟨fun hr g ↦ hr g.1, fun hr g ↦ hr ⟨g, fun i hi ↦ absurd (Finset.mem_univ i) hi⟩⟩

variable [IsRegularLocalRing A] [IsAdicComplete (maximalIdeal A) A] [PerfectField (ResidueField A)]
variable [Fintype ι] [FaithfulSMul (∀ i, H i) A]

/-- **Katz–Mazur Variant 7.5.3 (regularity).** Let `A` be a complete Noetherian regular local ring
with perfect residue field and regular system of parameters `x : ι → A`. If a finite product
`∀ i, H i` of finite groups acts faithfully on `A` and trivially on `ResidueField A` so that every
`g` with `g j = 1` fixes `x j`, then `FixedPoints.subring A (∀ i, H i)` is a regular local ring. -/
theorem isRegularLocalRing_subring_pi {x : ι → A}
    (hres : ∀ (g : ∀ i, H i) (r : A), residue A (g • r) = residue A r)
    (hspan : span (Set.range x) = maximalIdeal A)
    (hrank : (maximalIdeal A).spanFinrank = Fintype.card ι)
    (hfix : ∀ (g : ∀ i, H i) (j : ι), g j = 1 → g • x j = x j) :
    IsRegularLocalRing (FixedPoints.subring A (∀ i, H i)) := by
  classical
  rw [subring_pi_eq_univ (A := A) H]
  exact (pi_induction H hres hspan hrank hfix Finset.univ).1

/-- **Katz–Mazur Variant 7.5.3 (completeness).** Under the hypotheses of
`isRegularLocalRing_subring_pi`, the invariant subring `FixedPoints.subring A (∀ i, H i)` is
complete for its maximal ideal. -/
theorem isAdicComplete_subring_pi {x : ι → A}
    (hres : ∀ (g : ∀ i, H i) (r : A), residue A (g • r) = residue A r)
    (hspan : span (Set.range x) = maximalIdeal A)
    (hrank : (maximalIdeal A).spanFinrank = Fintype.card ι)
    (hfix : ∀ (g : ∀ i, H i) (j : ι), g j = 1 → g • x j = x j) :
    IsAdicComplete (maximalIdeal (FixedPoints.subring A (∀ i, H i)))
      (FixedPoints.subring A (∀ i, H i)) := by
  classical
  have hcomp := (pi_induction H hres hspan hrank hfix Finset.univ).2.1
  have : ∀ (S₁ S₂ : Subring A) (_ : S₁ = S₂) [IsLocalRing S₁] [IsLocalRing S₂],
      IsAdicComplete (maximalIdeal S₂) S₂ → IsAdicComplete (maximalIdeal S₁) S₁ := by
    rintro S₁ _ rfl _ _ h
    exact h
  exact this _ _ (subring_pi_eq_univ (A := A) H) hcomp

/-- **Katz–Mazur Variant 7.5.3 (regular system of parameters).** Under the hypotheses of
`isRegularLocalRing_subring_pi`, the maximal ideal of `FixedPoints.subring A (∀ i, H i)` is
generated by the coordinate orbit products `factorOrbitProd H hfix i`. -/
theorem maximalIdeal_subring_pi_eq_span {x : ι → A}
    (hres : ∀ (g : ∀ i, H i) (r : A), residue A (g • r) = residue A r)
    (hspan : span (Set.range x) = maximalIdeal A)
    (hrank : (maximalIdeal A).spanFinrank = Fintype.card ι)
    (hfix : ∀ (g : ∀ i, H i) (j : ι), g j = 1 → g • x j = x j) :
    maximalIdeal (FixedPoints.subring A (∀ i, H i)) =
      span (Set.range (factorOrbitProd H hfix)) := by
  classical
  have hmax := (pi_induction H hres hspan hrank hfix Finset.univ).2.2.1
  have : ∀ (S₁ S₂ : Subring A) (_ : S₁ = S₂) [IsLocalRing S₁] [IsLocalRing S₂]
      (f₁ : ι → S₁) (f₂ : ι → S₂) (_ : ∀ i, (f₁ i : A) = (f₂ i : A)),
      maximalIdeal S₂ = span (Set.range f₂) →
      maximalIdeal S₁ = span (Set.range f₁) := by
    rintro S₁ _ rfl _ _ f₁ f₂ hf h₂
    have hf' : f₁ = f₂ := funext fun i ↦ Subtype.ext (hf i)
    subst hf'
    exact h₂
  exact this _ _ (subring_pi_eq_univ (A := A) H) _ _ (fun i ↦ by simp [paramAt]) hmax

/-- **Katz–Mazur Variant 7.5.3 (embedding dimension).** Under the hypotheses of
`isRegularLocalRing_subring_pi`, the maximal ideal of `FixedPoints.subring A (∀ i, H i)` has
minimal number of generators `|ι|`. -/
theorem spanFinrank_maximalIdeal_subring_pi {x : ι → A}
    (hres : ∀ (g : ∀ i, H i) (r : A), residue A (g • r) = residue A r)
    (hspan : span (Set.range x) = maximalIdeal A)
    (hrank : (maximalIdeal A).spanFinrank = Fintype.card ι)
    (hfix : ∀ (g : ∀ i, H i) (j : ι), g j = 1 → g • x j = x j) :
    (maximalIdeal (FixedPoints.subring A (∀ i, H i))).spanFinrank = Fintype.card ι := by
  have := isRegularLocalRing_subring_pi H hres hspan hrank hfix
  have h1 := IsRegularLocalRing.spanFinrank_maximalIdeal (R := FixedPoints.subring A (∀ i, H i))
  have h2 := IsRegularLocalRing.spanFinrank_maximalIdeal (R := A)
  have hdim := ringKrullDim_subring (A := A) (H := ∀ i, H i)
  rw [← hrank]
  exact_mod_cast h1.trans (hdim.trans h2.symm)

/-- **Katz–Mazur Variant 7.5.3 (monomial basis).** Under the hypotheses of
`isRegularLocalRing_subring_pi`, `A` is a free module over `FixedPoints.subring A (∀ i, H i)`
with basis the monomials `∏ i, x i ^ (e i : ℕ)` for `e : ∀ i, Fin (Nat.card (H i))`. -/
noncomputable def basisPi {x : ι → A}
    (hres : ∀ (g : ∀ i, H i) (r : A), residue A (g • r) = residue A r)
    (hspan : span (Set.range x) = maximalIdeal A)
    (hrank : (maximalIdeal A).spanFinrank = Fintype.card ι)
    (hfix : ∀ (g : ∀ i, H i) (j : ι), g j = 1 → g • x j = x j) :
    Module.Basis (∀ i : ι, Fin (Nat.card (H i))) (FixedPoints.subring A (∀ i, H i)) A := by
  classical
  have hex := (pi_induction H hres hspan hrank hfix Finset.univ).2.2.2.2
  let bU := Classical.choose hex
  have hbU : ∀ f, bU f = ∏ i : (Finset.univ : Finset ι), x i.1 ^ (f i : ℕ) :=
    Classical.choose_spec hex
  have heq := subring_pi_eq_univ (A := A) H
  let eIdx : (∀ i : (Finset.univ : Finset ι), Fin (Nat.card (H i.1))) ≃
      (∀ i : ι, Fin (Nat.card (H i))) :=
    { toFun := fun f i ↦ f ⟨i, Finset.mem_univ i⟩
      invFun := fun f i ↦ f i.1
      left_inv := fun _ ↦ rfl
      right_inv := fun _ ↦ rfl }
  have hli : LinearIndependent (FixedPoints.subring A (∀ i, H i))
      (fun e : ∀ i : ι, Fin (Nat.card (H i)) ↦ ∏ i : ι, x i ^ (e i : ℕ)) := by
    rw [heq]
    have hliU := (bU.reindex eIdx).linearIndependent
    convert hliU using 1
    funext e
    rw [Module.Basis.reindex_apply, hbU]
    exact (Finset.prod_coe_sort Finset.univ fun i ↦ x i ^ (e i : ℕ)).symm
  have hsp : ⊤ ≤ Submodule.span (FixedPoints.subring A (∀ i, H i))
      (Set.range fun e : ∀ i : ι, Fin (Nat.card (H i)) ↦ ∏ i : ι, x i ^ (e i : ℕ)) := by
    rw [heq]
    have hspU := (bU.reindex eIdx).span_eq.ge
    convert hspU using 2
    ext r
    simp only [Set.mem_range, Module.Basis.reindex_apply, hbU]
    exact ⟨fun ⟨e, he⟩ ↦ ⟨e, (Finset.prod_coe_sort Finset.univ
        fun i ↦ x i ^ (e i : ℕ)).trans he⟩,
      fun ⟨e, he⟩ ↦ ⟨e, (Finset.prod_coe_sort Finset.univ
        fun i ↦ x i ^ (e i : ℕ)).symm.trans he⟩⟩
  exact Module.Basis.mk hli hsp

/-- The `e`-th basis element of `basisPi` is `∏ i, x i ^ (e i : ℕ)`. -/
@[simp]
theorem basisPi_apply {x : ι → A}
    (hres : ∀ (g : ∀ i, H i) (r : A), residue A (g • r) = residue A r)
    (hspan : span (Set.range x) = maximalIdeal A)
    (hrank : (maximalIdeal A).spanFinrank = Fintype.card ι)
    (hfix : ∀ (g : ∀ i, H i) (j : ι), g j = 1 → g • x j = x j)
    (e : ∀ i : ι, Fin (Nat.card (H i))) :
    basisPi H hres hspan hrank hfix e = ∏ i : ι, x i ^ (e i : ℕ) := by
  simp [basisPi]

end TauCeti.FixedPoints
