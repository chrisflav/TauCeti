module

public import TauCeti.RingTheory.NovikovSeries.Localization
public import TauCeti.RingTheory.NovikovSeries.Residue

/-!
# Action-extended Novikov rings

Given a base exponent group `G` with an energy homomorphism `E : G →+ ℝ` (and optionally a degree
homomorphism `μ : G →+ B`), the *action-extended* exponent group is `G × ℝ` equipped with the
extended period homomorphism `actionPeriod E : G × ℝ →+ ℝ`, `(g, r) ↦ E g + r`, and the extended
degree `actionDegree μ : G × ℝ →+ B`, `(g, r) ↦ μ g`.

The resulting Novikov ring `NovikovSeries R (G × ℝ) (actionPeriod E)` adjoins a formal real-exponent
action variable `T^r = actionMonomial R E r = single (0, r) 1` of period `r` and degree `0`, while
retaining the full base group `G` via the continuous injective ring homomorphism
`ofBase R E : NovikovSeries R G E →+* NovikovSeries R (G × ℝ) (actionPeriod E)`. In particular,
distinct classes in `G` with equal energy remain distinct in the action-extended ring.

Its nonnegative subring `nonnegSubring R (actionPeriod E)` has two complementary structural
features:
* **Localization**: `NovikovSeries R (G × ℝ) (actionPeriod E)` is the localization of
  `nonnegSubring R (actionPeriod E)` at `actionMonomialSubmonoid R E = {T^r | r ≥ 0}` (generated by
  `{T^r | r > 0}`), and already at any single `T^r` with `r > 0`.
* **Energy-zero residue**: the kernel of `actionPeriod E` is canonically isomorphic to `G` via
  `(g, -E g) ↔ g`, identifying the energy-zero quotient
  `nonnegSubring R (actionPeriod E) ⧸ posIdeal R (actionPeriod E)` with the group ring
  `AddMonoidAlgebra R G` compatibly with any degree grading (`actionResidueQuotientEquiv R E`).

Finally, pushing forward along `actionPeriod E : G × ℝ →+ ℝ` and any coefficient ring homomorphism
`ρ : R →+* S` gives the continuous specialization `actionFieldMap ρ E` into the real-exponent
Novikov ring `NovikovSeries S ℝ (AddMonoidHom.id ℝ)` (a field when `S` is a field), which is the
unique localization extension of its nonnegative restriction `actionFieldMapNonneg ρ E`.

## Main definitions

* `TauCeti.NovikovSeries.actionPeriod` and `TauCeti.NovikovSeries.actionDegree`: period and degree
  maps on `G × ℝ`.
* `TauCeti.NovikovSeries.actionMonomial` and `TauCeti.NovikovSeries.nonnegActionMonomial`: the
  action monomials `T^r = e^(0, r)`.
* `TauCeti.NovikovSeries.actionMonomialSubmonoid`: the multiplicative submonoid `{T^r | r ≥ 0}` of
  `nonnegSubring R (actionPeriod E)`.
* `TauCeti.NovikovSeries.liftActionLocalized`: the universal localization extension of a ring
  homomorphism out of `nonnegSubring R (actionPeriod E)` inverting all `T^r` (`r > 0`).
* `TauCeti.NovikovSeries.ofBase` and `TauCeti.NovikovSeries.ofBaseNonneg`: continuous embeddings of
  the base Novikov ring and its nonnegative subring.
* `TauCeti.NovikovSeries.kerActionPeriodEquiv`, `TauCeti.NovikovSeries.actionResidueHom`, and
  `TauCeti.NovikovSeries.actionResidueQuotientEquiv`: the energy-zero residue homomorphism and
  quotient isomorphism onto `AddMonoidAlgebra R G`.
* `TauCeti.NovikovSeries.actionFieldMap` and `TauCeti.NovikovSeries.actionFieldMapNonneg`:
  continuous specialization to the real-exponent Novikov ring.

## Main results

* `TauCeti.NovikovSeries.isLocalization_actionMonomialSubmonoid` and
  `TauCeti.NovikovSeries.isLocalization_away_actionMonomial`: localization properties of the
  action-extended Novikov ring.
* `TauCeti.NovikovSeries.ker_actionResidueHom` and
  `TauCeti.NovikovSeries.actionResidueHom_mem_gradeBy`: the energy-zero residue map has kernel
  `posIdeal` and preserves degree gradings.
* `TauCeti.NovikovSeries.actionFieldMap_eq_liftActionLocalized`: the specialization to the
  real-exponent Novikov ring is the unique localization extension of its nonnegative restriction.
-/

public section

noncomputable section

open Function

namespace TauCeti

namespace NovikovSeries

section ActionMaps

variable {G B : Type*}

/-- The extended period homomorphism `(g, r) ↦ E g + r` on `G × ℝ`. -/
def actionPeriod [AddMonoid G] (E : G →+ ℝ) : G × ℝ →+ ℝ :=
  E.coprod (AddMonoidHom.id ℝ)

@[simp]
theorem actionPeriod_apply [AddMonoid G] (E : G →+ ℝ) (x : G × ℝ) :
    actionPeriod E x = E x.1 + x.2 :=
  (rfl)

/-- The extended degree homomorphism `(g, r) ↦ μ g` on `G × ℝ`, giving the action parameter `r`
degree `0`. -/
def actionDegree [AddMonoid G] [AddMonoid B] (μ : G →+ B) : G × ℝ →+ B :=
  μ.comp (AddMonoidHom.fst G ℝ)

@[simp]
theorem actionDegree_apply [AddMonoid G] [AddMonoid B] (μ : G →+ B) (x : G × ℝ) :
    actionDegree μ x = μ x.1 :=
  (rfl)

/-- The extended period homomorphism `actionPeriod E` is unbounded above on `G × ℝ`. -/
theorem exists_ge_actionPeriod [AddMonoid G] (E : G →+ ℝ) (C : ℝ) :
    ∃ x : G × ℝ, C ≤ actionPeriod E x :=
  ⟨(0, C), by simp⟩

end ActionMaps

section ActionMonomial

variable {R G B : Type*}

variable (R) in
/-- The formal action monomial `T^r = e^(0, r)` in `NovikovSeries R (G × ℝ) (actionPeriod E)`. -/
def actionMonomial [Semiring R] [AddMonoid G] (E : G →+ ℝ) (r : ℝ) :
    NovikovSeries R (G × ℝ) (actionPeriod E) :=
  single (0, r) 1

theorem actionMonomial_eq_single [Semiring R] [AddMonoid G] (E : G →+ ℝ) (r : ℝ) :
    actionMonomial R E r = single (0, r) 1 :=
  (rfl)

@[simp]
theorem actionMonomial_zero [Semiring R] [AddMonoid G] (E : G →+ ℝ) :
    actionMonomial R E 0 = 1 := by
  change single (0 : G × ℝ) 1 = 1
  exact single_zero_one

@[simp]
theorem actionMonomial_add [Semiring R] [AddMonoid G] (E : G →+ ℝ) (r s : ℝ) :
    actionMonomial R E (r + s) = actionMonomial R E r * actionMonomial R E s := by
  simp [actionMonomial, single_mul_single]

/-- The action monomial `T^r` lies in the period filtration at cutoff `r`. -/
theorem actionMonomial_mem_periodFiltration [Ring R] [AddMonoid G] (E : G →+ ℝ) (r : ℝ) :
    actionMonomial R E r ∈ periodFiltration R (actionPeriod E) r := by
  simpa [actionMonomial] using
    single_mem_periodFiltration (R := R) (N := actionPeriod E) (0, r) 1

/-- Left multiplication by `T^r` shifts the period filtration by `r`. -/
theorem actionMonomial_mul_mem_periodFiltration_iff [Ring R] [AddMonoid G] [IsLeftCancelAdd G]
    (E : G →+ ℝ) (r C : ℝ) {a : NovikovSeries R (G × ℝ) (actionPeriod E)} :
    actionMonomial R E r * a ∈ periodFiltration R (actionPeriod E) (r + C) ↔
      a ∈ periodFiltration R (actionPeriod E) C := by
  simpa [actionMonomial] using
    single_mul_mem_periodFiltration_iff (R := R) (N := actionPeriod E) (0, r) 1 (C := C) (a := a)

/-- The action monomial `T^r` has degree `0` for any extended degree `actionDegree μ`. -/
theorem actionMonomial_mem_gradeBy_zero [Semiring R] [AddMonoid G] [AddMonoid B]
    (E : G →+ ℝ) (μ : G →+ B) (r : ℝ) :
    actionMonomial R E r ∈ gradeBy R (actionPeriod E) (actionDegree μ) 0 := by
  simpa [actionMonomial] using
    single_mem_gradeBy (R := R) (N := actionPeriod E) (actionDegree μ) (0, r) 1

/-- Multiplying by `T^r` preserves and reflects every homogeneous piece of `actionDegree μ`. -/
theorem actionMonomial_mul_mem_gradeBy_iff [Semiring R] [AddGroup G] [AddMonoid B]
    (E : G →+ ℝ) (μ : G →+ B) (r : ℝ) {b : B} {a : NovikovSeries R (G × ℝ) (actionPeriod E)} :
    actionMonomial R E r * a ∈ gradeBy R (actionPeriod E) (actionDegree μ) b ↔
      a ∈ gradeBy R (actionPeriod E) (actionDegree μ) b :=
  single_mul_mem_gradeBy_iff (by simp) 1

/-- Every action monomial `T^r` is a unit in `NovikovSeries R (G × ℝ) (actionPeriod E)`. -/
theorem isUnit_actionMonomial [Semiring R] [AddGroup G] (E : G →+ ℝ) (r : ℝ) :
    IsUnit (actionMonomial R E r) :=
  isUnit_single (0, r) isUnit_one

variable (R) in
/-- For `r ≥ 0`, the action monomial `T^r` as an element of `nonnegSubring R (actionPeriod E)`. -/
def nonnegActionMonomial [Ring R] [AddMonoid G] (E : G →+ ℝ) {r : ℝ} (hr : 0 ≤ r) :
    nonnegSubring R (actionPeriod E) :=
  ⟨actionMonomial R E r, single_mem_nonnegSubring (by simpa using hr) 1⟩

@[simp]
theorem coe_nonnegActionMonomial [Ring R] [AddMonoid G] (E : G →+ ℝ) {r : ℝ} (hr : 0 ≤ r) :
    (nonnegActionMonomial R E hr : NovikovSeries R (G × ℝ) (actionPeriod E)) =
      actionMonomial R E r :=
  (rfl)

/-- For `r > 0`, `T^r` belongs to the strictly positive ideal `posIdeal R (actionPeriod E)`. -/
theorem nonnegActionMonomial_mem_posIdeal [Ring R] [AddMonoid G] (E : G →+ ℝ) {r : ℝ}
    (hr : 0 < r) :
    nonnegActionMonomial R E hr.le ∈ posIdeal R (actionPeriod E) :=
  single_mem_posIdeal (by simpa using hr) 1

/-- Over a nontrivial coefficient ring, `T^r` is not a unit in `nonnegSubring` for `r > 0`. -/
theorem not_isUnit_nonnegActionMonomial_of_pos [Ring R] [Nontrivial R] [AddMonoid G]
    (E : G →+ ℝ) {r : ℝ} (hr : 0 < r) :
    ¬ IsUnit (nonnegActionMonomial R E hr.le) :=
  not_isUnit_of_mem_posIdeal (nonnegActionMonomial_mem_posIdeal E hr)

end ActionMonomial

section ActionLocalization

variable {R G : Type*}

variable (R) in
/-- The multiplicative submonoid `{T^r | r ≥ 0}` of `nonnegSubring R (actionPeriod E)`. -/
def actionMonomialSubmonoid [Ring R] [AddMonoid G] (E : G →+ ℝ) :
    Submonoid (nonnegSubring R (actionPeriod E)) :=
  monomialSubmonoid R (actionPeriod E) ((AddSubmonoid.nonneg ℝ).map (AddMonoidHom.inr G ℝ))

theorem actionMonomialSubmonoid_eq [Ring R] [AddMonoid G] (E : G →+ ℝ) :
    actionMonomialSubmonoid R E =
      monomialSubmonoid R (actionPeriod E) ((AddSubmonoid.nonneg ℝ).map (AddMonoidHom.inr G ℝ)) :=
  (rfl)

@[simp]
theorem mem_actionMonomialSubmonoid_iff [Ring R] [AddMonoid G] {E : G →+ ℝ}
    {a : nonnegSubring R (actionPeriod E)} :
    a ∈ actionMonomialSubmonoid R E ↔
      ∃ r : ℝ, 0 ≤ r ∧
        (a : NovikovSeries R (G × ℝ) (actionPeriod E)) = actionMonomial R E r := by
  simp only [actionMonomialSubmonoid, mem_monomialSubmonoid_iff, AddSubmonoid.mem_map,
    AddSubmonoid.mem_nonneg, AddMonoidHom.inr_apply]
  exact ⟨fun ⟨_, ⟨r, hr, rfl⟩, ha⟩ => ⟨r, hr, ha⟩,
    fun ⟨r, hr, ha⟩ => ⟨(0, r), ⟨r, hr, rfl⟩, ha⟩⟩

/-- For `r ≥ 0`, `nonnegActionMonomial R E hr` belongs to `actionMonomialSubmonoid R E`. -/
theorem nonnegActionMonomial_mem_actionMonomialSubmonoid [Ring R] [AddMonoid G] (E : G →+ ℝ)
    {r : ℝ} (hr : 0 ≤ r) :
    nonnegActionMonomial R E hr ∈ actionMonomialSubmonoid R E :=
  mem_actionMonomialSubmonoid_iff.2 ⟨r, hr, rfl⟩

/-- The submonoid `{T^r | r ≥ 0}` is generated by `{T^r | r > 0}`. -/
theorem actionMonomialSubmonoid_eq_closure_pos [Ring R] [AddMonoid G] (E : G →+ ℝ) :
    actionMonomialSubmonoid R E =
      Submonoid.closure
        {a : nonnegSubring R (actionPeriod E) |
          ∃ r : ℝ, 0 < r ∧
            (a : NovikovSeries R (G × ℝ) (actionPeriod E)) = actionMonomial R E r} := by
  rw [actionMonomialSubmonoid,
    monomialSubmonoid_eq_closure_pos (R := R) (N := actionPeriod E)
      (M := (AddSubmonoid.nonneg ℝ).map (AddMonoidHom.inr G ℝ))]
  · congr 1
    ext a
    simp only [Set.mem_ofPred_eq, AddSubmonoid.mem_map, AddSubmonoid.mem_nonneg,
      AddMonoidHom.inr_apply, actionMonomial]
    constructor
    · rintro ⟨_, ⟨r, _, rfl⟩, hpos, ha⟩
      exact ⟨r, by simpa using hpos, ha⟩
    · rintro ⟨r, hpos, ha⟩
      exact ⟨(0, r), ⟨r, hpos.le, rfl⟩, by simpa using hpos, ha⟩
  · rintro _ ⟨r, hr, rfl⟩
    refine ⟨by simpa using hr, fun h0 => ?_⟩
    have hr0 : r = 0 := by simpa using h0
    subst hr0
    rfl

/-- **Action localization.** The action-extended Novikov ring is the localization of its
nonnegative subring at `{T^r | r ≥ 0}`. -/
theorem isLocalization_actionMonomialSubmonoid [CommRing R] [AddCommGroup G] (E : G →+ ℝ) :
    IsLocalization (actionMonomialSubmonoid R E) (NovikovSeries R (G × ℝ) (actionPeriod E)) :=
  isLocalization_monomialSubmonoid fun C =>
    ⟨(0, max C 0), ⟨max C 0, le_max_right _ _, rfl⟩, by simp⟩

/-- Inverting any single positive action monomial `T^r` (`r > 0`) already produces the full
action-extended Novikov ring. -/
theorem isLocalization_away_actionMonomial [CommRing R] [AddCommGroup G] (E : G →+ ℝ)
    {r : ℝ} (hr : 0 < r) :
    IsLocalization.Away (nonnegActionMonomial R E hr.le)
      (NovikovSeries R (G × ℝ) (actionPeriod E)) :=
  isLocalization_away_single (N := actionPeriod E) (g := (0, r)) (by simpa using hr)

/-- Universal property of action localization: a ring homomorphism out of
`nonnegSubring R (actionPeriod E)` sending every `T^r` (`r > 0`) to a unit factors uniquely through
`NovikovSeries R (G × ℝ) (actionPeriod E)`. -/
def liftActionLocalized [CommRing R] [AddCommGroup G] {E : G →+ ℝ} {A : Type*} [CommSemiring A]
    (f : nonnegSubring R (actionPeriod E) →+* A)
    (hf : ∀ (r : ℝ) (hr : 0 < r), IsUnit (f (nonnegActionMonomial R E hr.le))) :
    NovikovSeries R (G × ℝ) (actionPeriod E) →+* A :=
  letI := isLocalization_actionMonomialSubmonoid (R := R) E
  IsLocalization.lift (M := actionMonomialSubmonoid R E) (g := f) fun y => by
    obtain ⟨r, hr, hy⟩ := mem_actionMonomialSubmonoid_iff.1 y.2
    rcases lt_or_eq_of_le hr with hpos | rfl
    · have heq : (y : nonnegSubring R (actionPeriod E)) = nonnegActionMonomial R E hpos.le :=
        Subtype.ext hy
      rw [heq]
      exact hf r hpos
    · have heq : (y : nonnegSubring R (actionPeriod E)) = 1 :=
        Subtype.ext <| by simpa using hy
      rw [heq, _root_.map_one]
      exact isUnit_one

@[simp]
theorem liftActionLocalized_coe [CommRing R] [AddCommGroup G] {E : G →+ ℝ} {A : Type*}
    [CommSemiring A] (f : nonnegSubring R (actionPeriod E) →+* A)
    (hf : ∀ (r : ℝ) (hr : 0 < r), IsUnit (f (nonnegActionMonomial R E hr.le)))
    (a : nonnegSubring R (actionPeriod E)) :
    liftActionLocalized f hf (a : NovikovSeries R (G × ℝ) (actionPeriod E)) = f a := by
  let _ := isLocalization_actionMonomialSubmonoid (R := R) E
  rw [liftActionLocalized,
    ← Algebra.algebraMap_ofSubsemiring_apply (nonnegSubring R (actionPeriod E)) a]
  exact IsLocalization.lift_eq (M := actionMonomialSubmonoid R E) (g := f) _ a

theorem liftActionLocalized_comp [CommRing R] [AddCommGroup G] {E : G →+ ℝ} {A : Type*}
    [CommSemiring A] (f : nonnegSubring R (actionPeriod E) →+* A)
    (hf : ∀ (r : ℝ) (hr : 0 < r), IsUnit (f (nonnegActionMonomial R E hr.le))) :
    (liftActionLocalized f hf).comp (nonnegSubring R (actionPeriod E)).subtype = f :=
  RingHom.ext (liftActionLocalized_coe f hf)

theorem liftActionLocalized_unique [CommRing R] [AddCommGroup G] {E : G →+ ℝ} {A : Type*}
    [CommSemiring A] (f : nonnegSubring R (actionPeriod E) →+* A)
    (hf : ∀ (r : ℝ) (hr : 0 < r), IsUnit (f (nonnegActionMonomial R E hr.le)))
    {g : NovikovSeries R (G × ℝ) (actionPeriod E) →+* A}
    (hg : ∀ a : nonnegSubring R (actionPeriod E),
      g (a : NovikovSeries R (G × ℝ) (actionPeriod E)) = f a) :
    liftActionLocalized f hf = g := by
  let _ := isLocalization_actionMonomialSubmonoid (R := R) E
  exact IsLocalization.lift_unique (M := actionMonomialSubmonoid R E) _ hg

end ActionLocalization

section BaseEmbedding

variable {R G B : Type*}

/-- The inclusion `g ↦ (g, 0)` preserves periods for `actionPeriod E`. -/
theorem exists_period_rescale_inl [AddMonoid G] (E : G →+ ℝ) :
    ∃ c > 0, ∀ g : G, actionPeriod E (AddMonoidHom.inl G ℝ g) = c * E g :=
  ⟨1, one_pos, fun g => by simp⟩

variable (R) in
/-- The canonical embedding `NovikovSeries R G E →+* NovikovSeries R (G × ℝ) (actionPeriod E)`
sending `e^g` to `e^(g, 0)`. -/
def ofBase [Semiring R] [AddMonoid G] (E : G →+ ℝ) :
    NovikovSeries R G E →+* NovikovSeries R (G × ℝ) (actionPeriod E) :=
  mapRingHom (RingHom.id R) (AddMonoidHom.inl G ℝ) (exists_period_rescale_inl E)

variable (R) in
/-- The restriction of `ofBase` to the nonnegative subrings. -/
def ofBaseNonneg [Ring R] [AddMonoid G] (E : G →+ ℝ) :
    nonnegSubring R E →+* nonnegSubring R (actionPeriod E) :=
  mapNonnegSubring (RingHom.id R) (AddMonoidHom.inl G ℝ) (exists_period_rescale_inl E)

@[simp]
theorem ofBase_single [Semiring R] [AddMonoid G] (E : G →+ ℝ) (g : G) (r : R) :
    ofBase R E (single g r) = single (g, (0 : ℝ)) r := by
  simp [ofBase]

@[simp]
theorem coeff_ofBase_inl [Semiring R] [AddMonoid G] (E : G →+ ℝ) (a : NovikovSeries R G E)
    (g : G) : (ofBase R E a).coeff (g, 0) = a.coeff g := by
  rw [ofBase, mapRingHom_apply]
  have hinj : Injective (AddMonoidHom.inl G ℝ) := fun _ _ h => (Prod.mk.inj h).1
  simpa using coeff_map_of_injective (AddMonoidHom.id R) (AddMonoidHom.inl G ℝ)
    (exists_period_rescale_inl E) hinj a g

@[simp]
theorem coe_ofBaseNonneg [Ring R] [AddMonoid G] (E : G →+ ℝ) (a : nonnegSubring R E) :
    (ofBaseNonneg R E a : NovikovSeries R (G × ℝ) (actionPeriod E)) = ofBase R E a := by
  simp [ofBaseNonneg, ofBase]

/-- `ofBase` is injective, retaining all base exponent classes including equal-energy classes. -/
theorem ofBase_injective [Semiring R] [AddMonoid G] (E : G →+ ℝ) : Injective (ofBase R E) := by
  intro a b hab
  rw [ofBase, mapRingHom_apply, mapRingHom_apply] at hab
  exact map_injective (AddMonoidHom.id R) (AddMonoidHom.inl G ℝ) (exists_period_rescale_inl E)
    injective_id (fun _ _ h => (Prod.mk.inj h).1) hab

theorem ofBaseNonneg_injective [Ring R] [AddMonoid G] (E : G →+ ℝ) :
    Injective (ofBaseNonneg R E) :=
  mapNonnegSubring_injective (RingHom.id R) (AddMonoidHom.inl G ℝ) (exists_period_rescale_inl E)
    injective_id fun _ _ h => (Prod.mk.inj h).1

/-- Distinct base classes remain distinct monomials in the action-extended ring regardless of
whether they share the same energy. -/
theorem ofBase_single_eq_iff [Semiring R] [Nontrivial R] [AddMonoid G] (E : G →+ ℝ) {g h : G} :
    ofBase R E (single g (1 : R)) = ofBase R E (single h 1) ↔ g = h := by
  refine ⟨fun hgh => ?_, fun hgh => hgh ▸ rfl⟩
  have hsingle : (single g (1 : R) : NovikovSeries R G E) = single h 1 := ofBase_injective E hgh
  by_contra hne
  have h0 := congrArg (fun a : NovikovSeries R G E => a.coeff g) hsingle
  rw [coeff_single_same, coeff_single_of_ne hne] at h0
  exact one_ne_zero h0

@[fun_prop]
theorem continuous_ofBase [Ring R] [AddMonoid G] (E : G →+ ℝ) : Continuous (ofBase R E) :=
  continuous_mapRingHom (RingHom.id R) (AddMonoidHom.inl G ℝ) (exists_period_rescale_inl E)

@[fun_prop]
theorem continuous_ofBaseNonneg [Ring R] [AddMonoid G] (E : G →+ ℝ) :
    Continuous (ofBaseNonneg R E) :=
  continuous_mapNonnegSubring (RingHom.id R) (AddMonoidHom.inl G ℝ) (exists_period_rescale_inl E)

/-- `ofBase` preserves and reflects the period filtration. -/
theorem ofBase_mem_periodFiltration_iff [Ring R] [AddMonoid G] (E : G →+ ℝ) {C : ℝ}
    {a : NovikovSeries R G E} :
    ofBase R E a ∈ periodFiltration R (actionPeriod E) C ↔ a ∈ periodFiltration R E C := by
  refine ⟨fun ha => mem_periodFiltration.2 fun g hg => ?_, fun ha => ?_⟩
  · rw [← coeff_ofBase_inl E a g]
    exact mem_periodFiltration.1 ha (g, 0) (by simpa using hg)
  · rw [ofBase, mapRingHom_apply]
    simpa using map_mem_periodFiltration (AddMonoidHom.id R) (AddMonoidHom.inl G ℝ)
      (exists_period_rescale_inl E) zero_le_one (fun g => by simp) ha

/-- `ofBase` preserves and reflects homogeneous pieces for `actionDegree μ`. -/
theorem ofBase_mem_gradeBy_iff [Semiring R] [AddMonoid G] [AddMonoid B] (E : G →+ ℝ)
    (μ : G →+ B) {b : B} {a : NovikovSeries R G E} :
    ofBase R E a ∈ gradeBy R (actionPeriod E) (actionDegree μ) b ↔ a ∈ gradeBy R E μ b := by
  refine ⟨fun ha => mem_gradeBy_iff.2 fun g hg => ?_, fun ha => ?_⟩
  · have hmem : (g, (0 : ℝ)) ∈ (ofBase R E a).support := by
      rw [mem_support, coeff_ofBase_inl]
      exact mem_support.1 hg
    exact mem_gradeBy_iff.1 ha hmem
  · rw [ofBase, mapRingHom_apply]
    exact map_mem_gradeBy (AddMonoidHom.id R) (AddMonoidHom.inl G ℝ) (exists_period_rescale_inl E)
      (f := μ) (f' := actionDegree μ) (ψ := id) (fun _ => rfl) ha

end BaseEmbedding

section ActionResidue

variable {R G B : Type*}

/-- The kernel of `actionPeriod E : G × ℝ →+ ℝ` is canonically isomorphic to `G` via
`(g, -E g) ↔ g`. -/
def kerActionPeriodEquiv [AddGroup G] (E : G →+ ℝ) : (actionPeriod E).ker ≃+ G where
  toFun k := k.1.1
  invFun g := ⟨(g, -E g), by simp⟩
  left_inv k := Subtype.ext <| Prod.ext rfl <| by
    have hk : E k.1.1 + k.1.2 = 0 := k.2
    linarith
  right_inv _ := rfl
  map_add' _ _ := rfl

@[simp]
theorem kerActionPeriodEquiv_apply [AddGroup G] (E : G →+ ℝ) (k : (actionPeriod E).ker) :
    kerActionPeriodEquiv E k = k.1.1 :=
  (rfl)

@[simp]
theorem kerActionPeriodEquiv_symm_apply [AddGroup G] (E : G →+ ℝ) (g : G) :
    ((kerActionPeriodEquiv E).symm g : G × ℝ) = (g, -E g) :=
  (rfl)

variable (R) in
/-- The energy-zero residue homomorphism `nonnegSubring R (actionPeriod E) →+* AddMonoidAlgebra R G`
extracting the coefficients at `(g, -E g)`. -/
def actionResidueHom [Ring R] [AddGroup G] (E : G →+ ℝ) :
    nonnegSubring R (actionPeriod E) →+* AddMonoidAlgebra R G :=
  (AddMonoidAlgebra.mapDomainRingEquiv R (kerActionPeriodEquiv E)).toRingHom.comp
    (residueHom R (actionPeriod E))

@[simp]
theorem coeff_actionResidueHom [Ring R] [AddGroup G] (E : G →+ ℝ)
    (a : nonnegSubring R (actionPeriod E)) (g : G) :
    (actionResidueHom R E a).coeff g =
      (a : NovikovSeries R (G × ℝ) (actionPeriod E)).coeff (g, -E g) := by
  change (AddMonoidAlgebra.mapDomainRingEquiv R (kerActionPeriodEquiv E)
    (residueHom R (actionPeriod E) a)).coeff g = _
  rw [AddMonoidAlgebra.coeff_mapDomainRingEquiv, Finsupp.equivMapDomain_apply, coeff_residueHom]
  rfl

/-- A nonnegative series in the action-extended ring has zero energy-zero residue if and only if it
lies in `posIdeal`. -/
theorem actionResidueHom_eq_zero_iff [Ring R] [AddGroup G] {E : G →+ ℝ}
    {a : nonnegSubring R (actionPeriod E)} :
    actionResidueHom R E a = 0 ↔ a ∈ posIdeal R (actionPeriod E) := by
  change (AddMonoidAlgebra.mapDomainRingEquiv R (kerActionPeriodEquiv E))
    (residueHom R (actionPeriod E) a) = 0 ↔ _
  rw [map_eq_zero_iff _ (AddMonoidAlgebra.mapDomainRingEquiv R (kerActionPeriodEquiv E)).injective,
    residueHom_eq_zero_iff]

variable (R) in
/-- The kernel of `actionResidueHom R E` is `posIdeal R (actionPeriod E)`. -/
theorem ker_actionResidueHom [Ring R] [AddGroup G] (E : G →+ ℝ) :
    RingHom.ker (actionResidueHom R E) = posIdeal R (actionPeriod E) := by
  ext a
  exact actionResidueHom_eq_zero_iff

variable (R) in
theorem actionResidueHom_surjective [Ring R] [AddGroup G] (E : G →+ ℝ) :
    Surjective (actionResidueHom R E) :=
  (AddMonoidAlgebra.mapDomainRingEquiv R (kerActionPeriodEquiv E)).surjective.comp
    (residueHom_surjective R (actionPeriod E))

variable (R) in
/-- **Energy-zero quotient of the action-extended nonnegative Novikov subring.** Dividing
`nonnegSubring R (actionPeriod E)` by `posIdeal R (actionPeriod E)` recovers the group ring
`AddMonoidAlgebra R G`. -/
def actionResidueQuotientEquiv [Ring R] [AddGroup G] (E : G →+ ℝ) :
    (nonnegSubring R (actionPeriod E) ⧸ posIdeal R (actionPeriod E)) ≃+* AddMonoidAlgebra R G :=
  (quotientPosIdealEquiv R (actionPeriod E)).trans
    (AddMonoidAlgebra.mapDomainRingEquiv R (kerActionPeriodEquiv E))

@[simp]
theorem actionResidueQuotientEquiv_mk [Ring R] [AddGroup G] (E : G →+ ℝ)
    (a : nonnegSubring R (actionPeriod E)) :
    actionResidueQuotientEquiv R E (Ideal.Quotient.mk (posIdeal R (actionPeriod E)) a) =
      actionResidueHom R E a := by
  simp [actionResidueQuotientEquiv, actionResidueHom]

@[simp]
theorem actionResidueQuotientEquiv_symm_apply [Ring R] [AddGroup G] (E : G →+ ℝ)
    (x : AddMonoidAlgebra R G) :
    (actionResidueQuotientEquiv R E).symm x =
      Ideal.Quotient.mk (posIdeal R (actionPeriod E))
        (ofKerAddMonoidAlgebra R (actionPeriod E)
          ((AddMonoidAlgebra.mapDomainRingEquiv R (kerActionPeriodEquiv E)).symm x)) := by
  simp [actionResidueQuotientEquiv]

theorem actionResidueQuotientEquiv_symm_single [Ring R] [AddGroup G] (E : G →+ ℝ)
    (g : G) (r : R) :
    (actionResidueQuotientEquiv R E).symm (AddMonoidAlgebra.single g r) =
      Ideal.Quotient.mk (posIdeal R (actionPeriod E))
        ⟨single (g, -E g) r, single_mem_nonnegSubring (by simp) r⟩ := by
  rw [actionResidueQuotientEquiv_symm_apply]
  congr 1
  apply Subtype.ext
  have hsingle : (AddMonoidAlgebra.mapDomainRingEquiv R (kerActionPeriodEquiv E)).symm
      (AddMonoidAlgebra.single g r) =
      AddMonoidAlgebra.single ((kerActionPeriodEquiv E).symm g) r := by
    apply (AddMonoidAlgebra.mapDomainRingEquiv R (kerActionPeriodEquiv E)).injective
    simp [AddMonoidAlgebra.mapDomainRingEquiv]
  rw [hsingle, ofKerAddMonoidAlgebra_single]
  rfl

/-- `actionResidueHom` sends homogeneous series of degree `b` for `actionDegree μ` into the
degree-`b` piece of `AddMonoidAlgebra R G`. -/
theorem actionResidueHom_mem_gradeBy [CommRing R] [AddGroup G] [AddMonoid B]
    (E : G →+ ℝ) (μ : G →+ B) {b : B} {a : nonnegSubring R (actionPeriod E)}
    (ha : (a : NovikovSeries R (G × ℝ) (actionPeriod E)) ∈
      gradeBy R (actionPeriod E) (actionDegree μ) b) :
    actionResidueHom R E a ∈ AddMonoidAlgebra.gradeBy R μ b := by
  rw [AddMonoidAlgebra.mem_gradeBy_iff]
  intro g hg
  rw [Finset.mem_coe, Finsupp.mem_support_iff, coeff_actionResidueHom] at hg
  exact mem_gradeBy_iff.1 ha (mem_support.2 hg)

end ActionResidue

section ActionFieldMap

variable {R S G B B' : Type*}

/-- Pushing forward along `actionPeriod E : G × ℝ →+ ℝ` preserves periods with scale factor `1`. -/
theorem exists_period_rescale_actionPeriod [AddMonoid G] (E : G →+ ℝ) :
    ∃ c > 0, ∀ x : G × ℝ, AddMonoidHom.id ℝ (actionPeriod E x) = c * actionPeriod E x :=
  ⟨1, one_pos, fun _ => by simp⟩

/-- Specialization of the action-extended Novikov ring to the real-exponent Novikov ring
`NovikovSeries S ℝ (AddMonoidHom.id ℝ)` along a coefficient ring homomorphism `ρ : R →+* S` and
`actionPeriod E`. -/
def actionFieldMap [Semiring R] [Semiring S] [AddMonoid G] (ρ : R →+* S) (E : G →+ ℝ) :
    NovikovSeries R (G × ℝ) (actionPeriod E) →+* NovikovSeries S ℝ (AddMonoidHom.id ℝ) :=
  mapRingHom ρ (actionPeriod E) (exists_period_rescale_actionPeriod E)

/-- The restriction of `actionFieldMap ρ E` to the nonnegative subrings. -/
def actionFieldMapNonneg [Ring R] [Ring S] [AddMonoid G] (ρ : R →+* S) (E : G →+ ℝ) :
    nonnegSubring R (actionPeriod E) →+* nonnegSubring S (AddMonoidHom.id ℝ) :=
  mapNonnegSubring ρ (actionPeriod E) (exists_period_rescale_actionPeriod E)

@[simp]
theorem actionFieldMap_single [Semiring R] [Semiring S] [AddMonoid G] (ρ : R →+* S) (E : G →+ ℝ)
    (g : G) (r : ℝ) (a : R) :
    actionFieldMap ρ E (single (g, r) a) = single (E g + r) (ρ a) := by
  simp [actionFieldMap]

@[simp]
theorem actionFieldMap_actionMonomial [Semiring R] [Semiring S] [AddMonoid G]
    (ρ : R →+* S) (E : G →+ ℝ) (r : ℝ) :
    actionFieldMap ρ E (actionMonomial R E r) = single r 1 := by
  simp [actionMonomial]

theorem actionFieldMap_single_ker [Semiring R] [Semiring S] [AddGroup G]
    (ρ : R →+* S) (E : G →+ ℝ) (g : G) (a : R) :
    actionFieldMap ρ E (single (g, -E g) a) = single 0 (ρ a) := by
  simp

@[simp]
theorem coe_actionFieldMapNonneg [Ring R] [Ring S] [AddMonoid G] (ρ : R →+* S) (E : G →+ ℝ)
    (a : nonnegSubring R (actionPeriod E)) :
    (actionFieldMapNonneg ρ E a : NovikovSeries S ℝ (AddMonoidHom.id ℝ)) =
      actionFieldMap ρ E a := by
  simp [actionFieldMapNonneg, actionFieldMap]

@[fun_prop]
theorem continuous_actionFieldMap [Ring R] [Ring S] [AddMonoid G] (ρ : R →+* S) (E : G →+ ℝ) :
    Continuous (actionFieldMap ρ E) :=
  continuous_mapRingHom ρ (actionPeriod E) (exists_period_rescale_actionPeriod E)

@[fun_prop]
theorem continuous_actionFieldMapNonneg [Ring R] [Ring S] [AddMonoid G]
    (ρ : R →+* S) (E : G →+ ℝ) : Continuous (actionFieldMapNonneg ρ E) :=
  continuous_mapNonnegSubring ρ (actionPeriod E) (exists_period_rescale_actionPeriod E)

/-- `actionFieldMap` preserves the period filtration. -/
theorem actionFieldMap_mem_periodFiltration [Ring R] [Ring S] [AddMonoid G]
    (ρ : R →+* S) (E : G →+ ℝ) {C : ℝ} {a : NovikovSeries R (G × ℝ) (actionPeriod E)}
    (ha : a ∈ periodFiltration R (actionPeriod E) C) :
    actionFieldMap ρ E a ∈ periodFiltration S (AddMonoidHom.id ℝ) C := by
  rw [actionFieldMap, mapRingHom_apply]
  simpa using map_mem_periodFiltration (ρ : R →+ S) (actionPeriod E)
    (exists_period_rescale_actionPeriod E) zero_le_one (fun _ => by simp) ha

/-- `actionFieldMapNonneg` maps `posIdeal` into `posIdeal`. -/
theorem actionFieldMapNonneg_mem_posIdeal [Ring R] [Ring S] [AddMonoid G]
    (ρ : R →+* S) (E : G →+ ℝ) {a : nonnegSubring R (actionPeriod E)}
    (ha : a ∈ posIdeal R (actionPeriod E)) :
    actionFieldMapNonneg ρ E a ∈ posIdeal S (AddMonoidHom.id ℝ) :=
  mapNonnegSubring_mem_posIdeal ρ (actionPeriod E) (exists_period_rescale_actionPeriod E) ha

/-- Composing `actionFieldMap` with the base embedding recovers the direct specialization along
`E`. -/
theorem actionFieldMap_comp_ofBase [Semiring R] [Semiring S] [AddMonoid G]
    (ρ : R →+* S) (E : G →+ ℝ) :
    (actionFieldMap ρ E).comp (ofBase R E) =
      mapRingHom ρ E ⟨1, one_pos, fun g => by simp⟩ := by
  have hcomp_hom : (actionPeriod E).comp (AddMonoidHom.inl G ℝ) = E := by
    ext g
    simp
  refine RingHom.ext fun a => ?_
  rw [RingHom.comp_apply, actionFieldMap, ofBase]
  have hcomp := mapRingHom_comp (RingHom.id R) (AddMonoidHom.inl G ℝ)
    (exists_period_rescale_inl E) ρ (actionPeriod E) (exists_period_rescale_actionPeriod E)
  have happly := congrArg (fun f => f a) hcomp
  simpa only [RingHom.comp_apply, RingHom.comp_id, hcomp_hom] using happly

/-- For any degree quotient `q : B →+ B'` annihilating `μ`, `actionFieldMap` is compatible with
the trivial grading on `ℝ`. -/
theorem actionFieldMap_mem_gradeBy_of_comp_eq_zero [Semiring R] [Semiring S] [AddMonoid G]
    [AddMonoid B] [AddMonoid B'] (ρ : R →+* S) (E : G →+ ℝ) {μ : G →+ B} {q : B →+ B'}
    (hq : q.comp μ = 0) {b : B} {a : NovikovSeries R (G × ℝ) (actionPeriod E)}
    (ha : a ∈ gradeBy R (actionPeriod E) (actionDegree μ) b) :
    actionFieldMap ρ E a ∈ gradeBy S (AddMonoidHom.id ℝ) (fun _ : ℝ => (0 : B')) (q b) := by
  rw [actionFieldMap, mapRingHom_apply]
  exact map_mem_gradeBy (ρ : R →+ S) (actionPeriod E) (exists_period_rescale_actionPeriod E)
    (f := actionDegree μ) (f' := fun _ => (0 : B')) (ψ := q)
    (fun x => by simpa using (congrArg (fun f : G →+ B' => f x.1) hq).symm) ha

/-- The specialization `actionFieldMap ρ E` is the unique localization extension of its restriction
to the nonnegative subrings. -/
theorem actionFieldMap_eq_liftActionLocalized [CommRing R] [CommRing S] [AddCommGroup G]
    (ρ : R →+* S) (E : G →+ ℝ) :
    actionFieldMap ρ E =
      liftActionLocalized
        ((nonnegSubring S (AddMonoidHom.id ℝ)).subtype.comp (actionFieldMapNonneg ρ E))
        (fun r hr => by
          rw [RingHom.comp_apply, Subring.coe_subtype, coe_actionFieldMapNonneg,
            coe_nonnegActionMonomial, actionFieldMap_actionMonomial]
          exact isUnit_single r isUnit_one) :=
  (liftActionLocalized_unique _ _ fun a => by
    rw [RingHom.comp_apply, Subring.coe_subtype, coe_actionFieldMapNonneg]).symm

end ActionFieldMap

end NovikovSeries

end TauCeti
