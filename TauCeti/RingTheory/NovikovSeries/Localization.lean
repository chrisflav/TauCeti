module

public import Mathlib.Algebra.Order.Monoid.Submonoid
public import Mathlib.RingTheory.Localization.Away.Basic
public import TauCeti.RingTheory.NovikovSeries.Field

/-!
# Localization of the nonnegative Novikov subring

Let `H` be an additive group with a period homomorphism `N : H →+ ℝ` and `R` a ring of
coefficients. Every element of the strictly positive ideal `posIdeal R N` is a non-unit in
`nonnegSubring R N` when `R` is nontrivial, and in particular no positive-period monomial is a unit
in `nonnegSubring R N`, even though every monomial with coefficient `1` is a unit in the full
Novikov ring `NovikovSeries R H N`.

Conversely, for any additive submonoid `M ≤ H` on which `N` is unbounded above, the full commutative
Novikov ring `NovikovSeries R H N` is the localization of `nonnegSubring R N` at the multiplicative
submonoid `monomialSubmonoid R N M` of monomials `e^g` with `g ∈ M`
(`TauCeti.NovikovSeries.isLocalization_monomialSubmonoid`). In particular, inverting even a single
positive-period monomial `e^g` already produces the full Novikov ring
(`TauCeti.NovikovSeries.isLocalization_away_single`).

Specializing to `H = ℝ` with `N = id` shows that `NovikovSeries R ℝ (AddMonoidHom.id ℝ)` is the
localization of its nonnegative subring at `{T^r | r ≥ 0}` (generated by `{T^r | r > 0}`), and is a
field whenever `R` is a field (`TauCeti.NovikovSeries.isField_real`).

## Main definitions

* `TauCeti.NovikovSeries.monomialSubmonoid`: the multiplicative submonoid of `nonnegSubring R N`
  consisting of monomials `e^g` with `g ∈ M`.
* `TauCeti.NovikovSeries.nonnegRealMonomialSubmonoid`: the multiplicative submonoid
  `{T^r | r ≥ 0}` in the nonnegative real-exponent Novikov subring.

## Main results

* `TauCeti.NovikovSeries.not_isUnit_of_mem_posIdeal` and
  `TauCeti.NovikovSeries.not_isUnit_nonnegSubring_single_of_pos`: elements of `posIdeal R N` and
  positive-period monomials are non-units in `nonnegSubring R N`.
* `TauCeti.NovikovSeries.isLocalization_monomialSubmonoid`: `NovikovSeries R H N` is the
  localization of `nonnegSubring R N` at `monomialSubmonoid R N M` whenever `N` is unbounded above
  on `M`.
* `TauCeti.NovikovSeries.isLocalization_away_single`: `NovikovSeries R H N` is the away
  localization of `nonnegSubring R N` at any positive-period monomial `e^g`.
* `TauCeti.NovikovSeries.isLocalization_nonnegRealMonomialSubmonoid` and
  `TauCeti.NovikovSeries.isField_real`: localization and field properties for real-exponent
  Novikov series.
-/

public section

noncomputable section

namespace TauCeti

namespace NovikovSeries

section Ring

variable {R H : Type*} [Ring R] [AddMonoid H] {N : H →+ ℝ}

/-- Over a nontrivial coefficient ring, no element of the strictly positive ideal is a unit of the
nonnegative Novikov subring. -/
theorem not_isUnit_of_mem_posIdeal [Nontrivial R] {a : nonnegSubring R N}
    (ha : a ∈ posIdeal R N) : ¬ IsUnit a := by
  rintro ⟨u, rfl⟩
  have h1 : (1 : nonnegSubring R N) ∈ posIdeal R N := by
    rw [← u.mul_inv]
    exact Ideal.IsTwoSided.mul_mem_of_left (↑u⁻¹ : nonnegSubring R N) ha
  have h0 : ((1 : nonnegSubring R N) : NovikovSeries R H N).coeff 0 = 0 :=
    mem_posIdeal.1 h1 0 (le_of_eq (map_zero N))
  rw [OneMemClass.coe_one, ← single_zero_one, coeff_single_same] at h0
  exact one_ne_zero h0

variable (R N) in
/-- Over a nontrivial coefficient ring, the strictly positive ideal is a proper ideal of the
nonnegative Novikov subring. -/
theorem posIdeal_ne_top [Nontrivial R] : posIdeal R N ≠ ⊤ := fun h =>
  not_isUnit_of_mem_posIdeal (h ▸ Submodule.mem_top : (1 : nonnegSubring R N) ∈ posIdeal R N)
    isUnit_one

/-- Over a nontrivial coefficient ring, a positive-period monomial is never a unit in the
nonnegative Novikov subring. -/
theorem not_isUnit_nonnegSubring_single_of_pos [Nontrivial R] {g : H} (hg : 0 < N g) (r : R) :
    ¬ IsUnit (⟨single g r, single_mem_nonnegSubring hg.le r⟩ : nonnegSubring R N) :=
  not_isUnit_of_mem_posIdeal (single_mem_posIdeal hg r)

variable (R N) in
/-- The multiplicative submonoid of `nonnegSubring R N` consisting of monomials `e^g` with
exponents `g` in an additive submonoid `M ≤ H`. -/
def monomialSubmonoid (M : AddSubmonoid H) : Submonoid (nonnegSubring R N) where
  carrier := {a | ∃ g ∈ M, (a : NovikovSeries R H N) = single g 1}
  one_mem' := ⟨0, M.zero_mem, by simp⟩
  mul_mem' := by
    rintro a b ⟨g, hg, ha⟩ ⟨h, hh, hb⟩
    exact ⟨g + h, M.add_mem hg hh, by simp [ha, hb, single_mul_single]⟩

@[simp]
theorem mem_monomialSubmonoid_iff {M : AddSubmonoid H} {a : nonnegSubring R N} :
    a ∈ monomialSubmonoid R N M ↔ ∃ g ∈ M, (a : NovikovSeries R H N) = single g 1 :=
  Iff.rfl

/-- A nonnegative-period monomial `e^g` with `g ∈ M` belongs to `monomialSubmonoid R N M`. -/
theorem single_one_mem_monomialSubmonoid {M : AddSubmonoid H} {g : H} (hgM : g ∈ M)
    (hg : 0 ≤ N g) :
    (⟨single g 1, single_mem_nonnegSubring hg 1⟩ : nonnegSubring R N) ∈ monomialSubmonoid R N M :=
  ⟨g, hgM, rfl⟩

/-- When every nonzero element of `M` has strictly positive period, `monomialSubmonoid R N M` is
generated by its positive-period monomials. -/
theorem monomialSubmonoid_eq_closure_pos {M : AddSubmonoid H}
    (hM : ∀ g ∈ M, 0 ≤ N g ∧ (N g = 0 → g = 0)) :
    monomialSubmonoid R N M =
      Submonoid.closure
        {a : nonnegSubring R N | ∃ g ∈ M, 0 < N g ∧ (a : NovikovSeries R H N) = single g 1} := by
  refine le_antisymm ?_ (Submonoid.closure_le.2 fun a ⟨g, hgM, _, ha⟩ => ⟨g, hgM, ha⟩)
  rintro a ⟨g, hgM, ha⟩
  rcases lt_or_eq_of_le (hM g hgM).1 with hpos | hzero
  · exact Submonoid.subset_closure ⟨g, hgM, hpos, ha⟩
  · have hg0 : g = 0 := (hM g hgM).2 hzero.symm
    have ha1 : a = 1 := Subtype.ext <| by simpa [hg0] using ha
    exact ha1 ▸ Submonoid.one_mem _

end Ring

section AddGroup

variable {R H : Type*} [Ring R] [AddGroup H] {N : H →+ ℝ}

/-- Every element of `monomialSubmonoid R N M` becomes a unit in the full Novikov ring. -/
theorem isUnit_coe_of_mem_monomialSubmonoid {M : AddSubmonoid H} {a : nonnegSubring R N}
    (ha : a ∈ monomialSubmonoid R N M) : IsUnit (a : NovikovSeries R H N) := by
  obtain ⟨g, _, hga⟩ := ha
  rw [hga]
  exact isUnit_single g isUnit_one

/-- Every monomial in `monomialSubmonoid R N M` is a non-zero-divisor in `nonnegSubring R N`. -/
theorem monomialSubmonoid_le_nonZeroDivisors (M : AddSubmonoid H) :
    monomialSubmonoid R N M ≤ nonZeroDivisors (nonnegSubring R N) := by
  intro a ha
  have hu : IsUnit (a : NovikovSeries R H N) := isUnit_coe_of_mem_monomialSubmonoid ha
  refine mem_nonZeroDivisors_iff.2 ⟨fun b hab => ?_, fun b hab => ?_⟩
  · exact Subtype.ext (hu.mul_right_eq_zero.1 (congrArg Subtype.val hab))
  · exact Subtype.ext (hu.mul_left_eq_zero.1 (congrArg Subtype.val hab))

end AddGroup

section CommRing

variable {R H : Type*} [CommRing R] [AddCommGroup H] {N : H →+ ℝ}

/-- **Localization of the nonnegative Novikov subring.** If the period map `N` is unbounded above on
an additive submonoid `M ≤ H`, then `NovikovSeries R H N` is the localization of `nonnegSubring R N`
at `monomialSubmonoid R N M`. -/
theorem isLocalization_monomialSubmonoid {M : AddSubmonoid H}
    (hM_unbdd : ∀ C : ℝ, ∃ g ∈ M, C ≤ N g) :
    IsLocalization (monomialSubmonoid R N M) (NovikovSeries R H N) := by
  rw [isLocalization_iff]
  refine ⟨fun y => ?_, fun z => ?_, fun {x y} hxy => ⟨1, by rw [Subtype.ext hxy]⟩⟩
  · simpa only [Algebra.algebraMap_ofSubsemiring_apply] using
      isUnit_coe_of_mem_monomialSubmonoid y.2
  · obtain ⟨D, hz⟩ := exists_mem_periodFiltration z
    obtain ⟨g, hgM, hgD⟩ := hM_unbdd (max (-D) 0)
    have hg0 : 0 ≤ N g := le_trans (le_max_right _ _) hgD
    have hDg : 0 ≤ D + N g := by linarith [le_max_left (-D) (0 : ℝ)]
    have hzm : z * single g 1 ∈ nonnegSubring R N :=
      mem_nonnegSubring.2 <| mem_periodFiltration.1 <| antitone_periodFiltration hDg
        (mul_mem_periodFiltration hz (single_mem_periodFiltration g 1))
    refine ⟨(⟨z * single g 1, hzm⟩,
      ⟨⟨single g 1, single_mem_nonnegSubring hg0 1⟩, single_one_mem_monomialSubmonoid hgM hg0⟩), ?_⟩
    simp only [Algebra.algebraMap_ofSubsemiring_apply]

/-- Inverting any single positive-period monomial `e^g` in `nonnegSubring R N` already yields the
full Novikov ring `NovikovSeries R H N`. -/
theorem isLocalization_away_single {g : H} (hg : 0 < N g) :
    IsLocalization.Away
      (⟨single g 1, single_mem_nonnegSubring hg.le 1⟩ : nonnegSubring R N)
      (NovikovSeries R H N) := by
  rw [IsLocalization.Away, isLocalization_iff]
  refine ⟨fun y => ?_, fun z => ?_, fun {x y} hxy => ⟨1, by rw [Subtype.ext hxy]⟩⟩
  · obtain ⟨n, hn⟩ := y.2
    have hcoe : (algebraMap (nonnegSubring R N) (NovikovSeries R H N) y) =
        (single g (1 : R) : NovikovSeries R H N) ^ n := by
      rw [Algebra.algebraMap_ofSubsemiring_apply, ← hn]
      simp
    rw [hcoe]
    exact (isUnit_single g isUnit_one).pow n
  · obtain ⟨D, hz⟩ := exists_mem_periodFiltration z
    obtain ⟨n, hn⟩ := Archimedean.arch (-D) hg
    have hpow : (((⟨single g 1, single_mem_nonnegSubring hg.le 1⟩ :
        nonnegSubring R N) ^ n : nonnegSubring R N) : NovikovSeries R H N) =
        single (n • g) 1 := by
      simp [single_pow]
    have hDg : 0 ≤ D + N (n • g) := by
      rw [map_nsmul]
      linarith
    have hzm : z * single (n • g) 1 ∈ nonnegSubring R N :=
      mem_nonnegSubring.2 <| mem_periodFiltration.1 <| antitone_periodFiltration hDg
        (mul_mem_periodFiltration hz (single_mem_periodFiltration (n • g) 1))
    refine ⟨(⟨z * single (n • g) 1, hzm⟩,
      ⟨⟨single g 1, single_mem_nonnegSubring hg.le 1⟩ ^ n, n, rfl⟩), ?_⟩
    simp only [Algebra.algebraMap_ofSubsemiring_apply, hpow]

end CommRing

section Real

variable (R : Type*)

/-- The multiplicative submonoid `{T^r | r ≥ 0}` of the nonnegative real-exponent Novikov
subring. -/
def nonnegRealMonomialSubmonoid [Ring R] :
    Submonoid (nonnegSubring R (AddMonoidHom.id ℝ)) :=
  monomialSubmonoid R (AddMonoidHom.id ℝ) (AddSubmonoid.nonneg ℝ)

@[simp]
theorem mem_nonnegRealMonomialSubmonoid_iff [Ring R]
    {a : nonnegSubring R (AddMonoidHom.id ℝ)} :
    a ∈ nonnegRealMonomialSubmonoid R ↔
      ∃ r : ℝ, 0 ≤ r ∧ (a : NovikovSeries R ℝ (AddMonoidHom.id ℝ)) = single r 1 :=
  Iff.rfl

/-- `{T^r | r ≥ 0}` is generated as a submonoid by `{T^r | r > 0}`. -/
theorem nonnegRealMonomialSubmonoid_eq_closure_pos [Ring R] :
    nonnegRealMonomialSubmonoid R =
      Submonoid.closure
        {a : nonnegSubring R (AddMonoidHom.id ℝ) |
          ∃ r : ℝ, 0 < r ∧ (a : NovikovSeries R ℝ (AddMonoidHom.id ℝ)) = single r 1} := by
  rw [nonnegRealMonomialSubmonoid,
    monomialSubmonoid_eq_closure_pos (R := R) (N := AddMonoidHom.id ℝ)
      (M := AddSubmonoid.nonneg ℝ) fun r hr => ⟨hr, fun h => h⟩]
  congr 1
  ext a
  simp only [Set.mem_ofPred_eq, AddSubmonoid.mem_nonneg, AddMonoidHom.id_apply]
  exact ⟨fun ⟨r, _, hpos, ha⟩ => ⟨r, hpos, ha⟩, fun ⟨r, hpos, ha⟩ => ⟨r, hpos.le, hpos, ha⟩⟩

/-- The real-exponent Novikov ring `NovikovSeries R ℝ id` is the localization of its nonnegative
subring at `{T^r | r ≥ 0}`. -/
theorem isLocalization_nonnegRealMonomialSubmonoid [CommRing R] :
    IsLocalization (nonnegRealMonomialSubmonoid R) (NovikovSeries R ℝ (AddMonoidHom.id ℝ)) :=
  isLocalization_monomialSubmonoid fun C => ⟨max C 0, le_max_right _ _, le_max_left _ _⟩

/-- Over a field `R`, the real-exponent Novikov ring `NovikovSeries R ℝ id` is a field. -/
theorem isField_real [Field R] : IsField (NovikovSeries R ℝ (AddMonoidHom.id ℝ)) :=
  isField_iff.2 ⟨Field.toIsField R, Function.injective_id⟩

end Real

