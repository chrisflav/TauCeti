module

public import Mathlib.CategoryTheory.Monoidal.Closed.InternalCurrying
public import Mathlib.Topology.Category.CompactlyGenerated
public import TauCeti.Topology.Convenient.CartesianClosed
public import TauCeti.Topology.Convenient.CompactlyGenerated

/-!
# Coreflection and Cartesian closedness of `CompactlyGenerated`

Mathlib's `CompactlyGenerated.{u, w}` is the full subcategory of `TopCat.{w}` on `u`-compactly
generated spaces (`UCompactlyGeneratedSpace.{u}`). Using the identification of
`UCompactlyGeneratedSpace.{u}` with generation by `CompHaus.{u}`
(`TauCeti.Topology.Convenient.CompactlyGenerated`), this file establishes the categorical
coreflection and Cartesian closed structure of `CompactlyGenerated.{u, w}` together with its
comparisons against ordinary products and compact-open mapping spaces.

## Main declarations

* `CompactlyGenerated.equivGeneratedByTopCat`: strict equivalence identifying
  `CompactlyGenerated.{u, w}` with `GeneratedByTopCat.{w} (fun K : CompHaus.{u} ↦ K)`, commuting
  with the inclusions to `TopCat.{w}`.
* `TopCat.toCompactlyGenerated` and `CompactlyGenerated.adj`: the compact-generation coreflector
  `k : TopCat.{w} ⥤ CompactlyGenerated.{u, w}` right adjoint to
  `CompactlyGenerated.compactlyGeneratedToTop`, whose topology on `X` equals
  `TopologicalSpace.compactlyGenerated.{u} X` (`TopCat.toCompactlyGenerated_obj_str`) and whose
  counit `kX → X` is the identity on points (`CompactlyGenerated.adjCounit_app_hom`). This yields
  `Coreflective`, `CreatesColimits`, `HasLimits`, and `HasColimits` instances: colimits are
  computed in `TopCat`, and limits are `k` of the limits in `TopCat`.
* `CompactlyGenerated.isIso_adjCounit_app_iff`: the counit `kX → X` is an isomorphism in `TopCat`
  if and only if `X` is `u`-compactly generated, giving the homeomorphism
  `CompactlyGenerated.adjCounitHomeomorph` for every `u`-compactly generated space (in particular
  for every sequential space — hence every delta-generated space and every Hausdorff CW complex —
  and for every Hausdorff weakly locally compact space).
* `CompactlyGenerated.instCartesianMonoidalCategory`, `CompactlyGenerated.instBraidedCategory`,
  and `CompactlyGenerated.instMonoidalClosed`: explicit convenient products `k(X × Y)` and internal
  homs `k(ContinuousMapGeneratedBy (fun K : CompHaus.{u} ↦ K) X Y)`.
* `UCompactlyGeneratedSpace.prod_of_locallyCompact_left`, `prod_of_locallyCompact_right`, and
  `CompactlyGenerated.prodIsoTopCat`: the ordinary product `X × Y` of two `u`-compactly generated
  spaces is `u`-compactly generated when either factor is locally compact, so `X ⊗ Y` agrees with
  `X × Y` in `TopCat`.
* `Topology.ContinuousMapGeneratedBy.homeomorphContinuousMap` and
  `CompactlyGenerated.ihomIsoContinuousMap`: for R₁ (for instance Hausdorff) compactly generated
  `X : Type u`, the test-open topology coincides with the ordinary compact-open topology on
  `C(X, Y)`, so the internal hom `(ihom X).obj Y` is isomorphic to `k(C(X, Y))`, and
  `CompactlyGenerated.continuousMapCurryIso` yields the exponential isomorphism
  `k(C(X ⊗ Y, Z)) ≅ k(C(Y, k(C(X, Z))))` for R₁ compactly generated `X` and `Y`.

## References

* R. M. Vogt, *Convenient categories of topological spaces for homotopy theory*,
  Arch. Math. (Basel) 22 (1971), 545–555.
* M. Escardó, J. Lawson and A. Simpson, *Comparing Cartesian closed categories of (core)
  compactly generated spaces*, Topology Appl. 143 (2004), 105–145.
* A. Hatcher, [*Algebraic Topology*](https://pi.math.cornell.edu/~hatcher/AT/AT.pdf),
  Appendix, Propositions A.14–A.16.
-/

public section

universe u v w

open CategoryTheory Limits MonoidalCategory CartesianMonoidalCategory Topology

namespace Topology

/-- The `CompHaus.{u}`-generated refinement of any space is `u`-compactly generated. -/
instance instUCompactlyGeneratedSpaceWithGeneratedByCompHaus (Y : Type w) [TopologicalSpace Y] :
    UCompactlyGeneratedSpace.{u} (WithGeneratedByTopology (fun K : CompHaus.{u} ↦ K) Y) :=
  (isGeneratedBy_compHaus_iff _).1 inferInstance

/-- The binary product of two compact Hausdorff spaces in universe `u` is generated by
`CompHaus.{u}`. -/
instance instIsGeneratedByCompHausProd (K₁ K₂ : CompHaus.{u}) :
    IsGeneratedBy (fun K : CompHaus.{u} ↦ K) (K₁ × K₂) :=
  inferInstanceAs (IsGeneratedBy (fun K : CompHaus.{u} ↦ K) (CompHaus.of (K₁ × K₂)))

namespace ContinuousMapGeneratedBy

/-- For an R₁ (for instance Hausdorff) compactly generated space `Y : Type u`, the test-open
topology on `ContinuousMapGeneratedBy (fun K : CompHaus.{u} ↦ K) Y Z` coincides with the ordinary
compact-open topology on `C(Y, Z)`. -/
def homeomorphContinuousMap {Y : Type u} [TopologicalSpace Y] [R1Space Y]
    [CompactlyGeneratedSpace Y] {Z : Type v} [TopologicalSpace Z] :
    ContinuousMapGeneratedBy (fun K : CompHaus.{u} ↦ K) Y Z ≃ₜ C(Y, Z) where
  toFun := toContinuousMap
  invFun := ofContinuousMap
  left_inv f := by
    ext y
    exact (ofContinuousMap_apply _ y).trans (toContinuousMap_apply f y)
  right_inv f := by
    ext y
    exact (toContinuousMap_apply _ y).trans (ofContinuousMap_apply f y)
  continuous_toFun := by
    refine continuous_iff_continuousAt.2 fun g₀ ↦
      ContinuousMap.tendsto_nhds_compactOpen.2 fun K hK U hU hg₀ ↦ ?_
    have : CompactSpace K := isCompact_iff_compactSpace.1 hK
    let Q := SeparationQuotient K
    have : CompactSpace Q := ⟨by
      simpa [SeparationQuotient.surjective_mk.range_eq] using
        isCompact_univ.image SeparationQuotient.continuous_mk⟩
    let s : Q → K := Function.surjInv SeparationQuotient.surjective_mk
    have hms : SeparationQuotient.mk ∘ s = _root_.id :=
      funext (Function.surjInv_eq SeparationQuotient.surjective_mk)
    have hs : Continuous s := SeparationQuotient.isInducing_mk.continuous_iff.2 <| by
      rw [hms]
      exact continuous_id
    let ι : C(CompHaus.of Q, Y) := ⟨Subtype.val ∘ s, continuous_subtype_val.comp hs⟩
    have hpre : IsOpen (precomp (X := fun K : CompHaus.{u} ↦ K) (i := CompHaus.of Q) ι ⁻¹'
        {h : C(CompHaus.of Q, Z) | Set.MapsTo h Set.univ U}) :=
      (ContinuousMap.isOpen_setOfPred_mapsTo isCompact_univ hU).preimage
        (continuous_precomp (X := fun K : CompHaus.{u} ↦ K) (i := CompHaus.of Q) ι)
    refine Filter.mem_of_superset (hpre.mem_nhds fun q _ ↦ ?_) fun g hg y hy ↦ ?_
    · simpa [precomp_apply, toContinuousMap_apply, ι] using hg₀ (s q).2
    · have hsep : Inseparable (s (SeparationQuotient.mk ⟨y, hy⟩)) ⟨y, hy⟩ :=
        SeparationQuotient.mk_eq_mk.1 (Function.surjInv_eq SeparationQuotient.surjective_mk _)
      have hsep' : Inseparable (toContinuousMap g (ι (SeparationQuotient.mk ⟨y, hy⟩)))
          (toContinuousMap g y) :=
        (hsep.map continuous_subtype_val).map (toContinuousMap g).continuous
      have hmem : toContinuousMap g (ι (SeparationQuotient.mk ⟨y, hy⟩)) ∈ U := by
        simpa [precomp_apply, toContinuousMap_apply] using hg (Set.mem_univ _)
      exact (inseparable_iff_forall_isOpen.1 hsep' U hU).1 hmem
  continuous_invFun := continuous_ofContinuousMap

@[simp]
theorem homeomorphContinuousMap_apply {Y : Type u} [TopologicalSpace Y] [R1Space Y]
    [CompactlyGeneratedSpace Y] {Z : Type v} [TopologicalSpace Z]
    (f : ContinuousMapGeneratedBy (fun K : CompHaus.{u} ↦ K) Y Z) (y : Y) :
    homeomorphContinuousMap f y = f y := by
  exact toContinuousMap_apply f y

@[simp]
theorem homeomorphContinuousMap_symm_apply {Y : Type u} [TopologicalSpace Y] [R1Space Y]
    [CompactlyGeneratedSpace Y] {Z : Type v} [TopologicalSpace Z]
    (f : C(Y, Z)) (y : Y) :
    homeomorphContinuousMap.symm f y = f y := by
  exact ofContinuousMap_apply f y

end ContinuousMapGeneratedBy

end Topology

namespace UCompactlyGeneratedSpace

/-- The ordinary product `X × Y` of two `u`-compactly generated spaces is `u`-compactly generated
whenever `X` is locally compact. -/
theorem prod_of_locallyCompact_left {X : Type v} {Y : Type w} [TopologicalSpace X]
    [TopologicalSpace Y] [LocallyCompactSpace X] [UCompactlyGeneratedSpace.{u} X]
    [UCompactlyGeneratedSpace.{u} Y] : UCompactlyGeneratedSpace.{u} (X × Y) :=
  (isGeneratedBy_compHaus_iff _).1
    (IsGeneratedBy.prod_of_locallyCompact_left (X := fun K : CompHaus.{u} ↦ K))

/-- The ordinary product `X × Y` of two `u`-compactly generated spaces is `u`-compactly generated
whenever `Y` is locally compact. -/
theorem prod_of_locallyCompact_right {X : Type v} {Y : Type w} [TopologicalSpace X]
    [TopologicalSpace Y] [UCompactlyGeneratedSpace.{u} X] [LocallyCompactSpace Y]
    [UCompactlyGeneratedSpace.{u} Y] : UCompactlyGeneratedSpace.{u} (X × Y) :=
  (isGeneratedBy_compHaus_iff _).1
    (IsGeneratedBy.prod_of_locallyCompact_right (X := fun K : CompHaus.{u} ↦ K))

end UCompactlyGeneratedSpace

namespace CompactlyGenerated

/-- The functor identifying `CompactlyGenerated.{u, w}` with
`GeneratedByTopCat.{w} (fun K : CompHaus.{u} ↦ K)`. -/
@[expose, simps]
def toGeneratedByTopCat :
    CompactlyGenerated.{u, w} ⥤ GeneratedByTopCat.{w} (fun K : CompHaus.{u} ↦ K) where
  obj X := ⟨X.toTop, inferInstance⟩
  map f := ObjectProperty.homMk f.hom

/-- The inverse functor identifying `GeneratedByTopCat.{w} (fun K : CompHaus.{u} ↦ K)` with
`CompactlyGenerated.{u, w}`. -/
@[expose, simps]
def fromGeneratedByTopCat :
    GeneratedByTopCat.{w} (fun K : CompHaus.{u} ↦ K) ⥤ CompactlyGenerated.{u, w} where
  obj X :=
    { toTop := X.obj
      is_compactly_generated := (isGeneratedBy_compHaus_iff X.obj).1 X.property }
  map f := InducedCategory.homMk f.hom

/-- `CompactlyGenerated.{u, w}` is equivalent (in fact isomorphic) to
`GeneratedByTopCat.{w} (fun K : CompHaus.{u} ↦ K)`. -/
def equivGeneratedByTopCat :
    CompactlyGenerated.{u, w} ≌ GeneratedByTopCat.{w} (fun K : CompHaus.{u} ↦ K) where
  functor := toGeneratedByTopCat
  inverse := fromGeneratedByTopCat
  unitIso := Iso.refl _
  counitIso := Iso.refl _

@[simp]
theorem equivGeneratedByTopCat_functor :
    equivGeneratedByTopCat.{u, w}.functor = toGeneratedByTopCat.{u, w} := by
  rfl

@[simp]
theorem equivGeneratedByTopCat_inverse :
    equivGeneratedByTopCat.{u, w}.inverse = fromGeneratedByTopCat.{u, w} := by
  rfl

theorem toGeneratedByTopCat_comp_toTopCat :
    toGeneratedByTopCat.{u, w} ⋙ GeneratedByTopCat.toTopCat = compactlyGeneratedToTop.{u, w} := by
  rfl

theorem fromGeneratedByTopCat_comp_compactlyGeneratedToTop :
    fromGeneratedByTopCat.{u, w} ⋙ compactlyGeneratedToTop.{u, w} = GeneratedByTopCat.toTopCat := by
  rfl

end CompactlyGenerated

/-- The compact-generation coreflector `k : TopCat.{w} ⥤ CompactlyGenerated.{u, w}` sending a
topological space `X` to `X` equipped with its `u`-compactly generated topology. -/
@[expose]
def TopCat.toCompactlyGenerated : TopCat.{w} ⥤ CompactlyGenerated.{u, w} :=
  TopCat.toGeneratedByTopCat (X := fun K : CompHaus.{u} ↦ K) ⋙
    CompactlyGenerated.fromGeneratedByTopCat.{u, w}

/-- The underlying topology of `TopCat.toCompactlyGenerated.{u, w}.obj X` is
`TopologicalSpace.compactlyGenerated.{u} X`. -/
theorem TopCat.toCompactlyGenerated_obj_str (X : TopCat.{w}) :
    (TopCat.toCompactlyGenerated.{u, w}.obj X).toTop.str =
      TopologicalSpace.compactlyGenerated.{u} X :=
  TopologicalSpace.generatedBy_compHaus X

namespace CompactlyGenerated

/-- The unit isomorphism of the coreflection
`compactlyGeneratedToTop ⊣ TopCat.toCompactlyGenerated`. -/
def adjUnitIso :
    𝟭 CompactlyGenerated.{u, w} ≅ compactlyGeneratedToTop.{u, w} ⋙ TopCat.toCompactlyGenerated :=
  NatIso.ofComponents fun X ↦
    isoOfHomeo (IsGeneratedBy.homeomorph (X := fun K : CompHaus.{u} ↦ K) (Y := X)).symm

/-- The counit of the coreflection `compactlyGeneratedToTop ⊣ TopCat.toCompactlyGenerated`, whose
component at `X` is the identity on points `kX → X`. -/
def adjCounit :
    TopCat.toCompactlyGenerated.{u, w} ⋙ compactlyGeneratedToTop.{u, w} ⟶ 𝟭 TopCat.{w} :=
  GeneratedByTopCat.adjCounit (X := fun K : CompHaus.{u} ↦ K)

/-- The underlying continuous map of the counit at `X` is the generated-topology counit
(the identity on points). -/
@[simp]
theorem adjCounit_app_hom (X : TopCat.{w}) :
    (adjCounit.{u, w}.app X).hom =
      WithGeneratedByTopology.counit (fun K : CompHaus.{u} ↦ K) X :=
  GeneratedByTopCat.adjCounit_app_hom (G := fun K : CompHaus.{u} ↦ K) X

/-- The coreflection adjunction `compactlyGeneratedToTop ⊣ TopCat.toCompactlyGenerated`. -/
def adj : compactlyGeneratedToTop.{u, w} ⊣ TopCat.toCompactlyGenerated.{u, w} where
  unit := adjUnitIso.hom
  counit := adjCounit

@[simp]
theorem adj_unit : adj.{u, w}.unit = adjUnitIso.{u, w}.hom := by
  rfl

@[simp]
theorem adj_counit : adj.{u, w}.counit = adjCounit.{u, w} := by
  rfl

instance : IsIso adj.{u, w}.unit := inferInstanceAs (IsIso adjUnitIso.hom)

instance : compactlyGeneratedToTop.{u, w}.IsLeftAdjoint := adj.isLeftAdjoint

instance : TopCat.toCompactlyGenerated.{u, w}.IsRightAdjoint := adj.isRightAdjoint

instance : TopCat.toCompactlyGenerated.{u, w}.Faithful where
  map_injective h := by
    ext x
    exact congrArg (fun k ↦ k.hom x) h

/-- `CompactlyGenerated.{u, w}` is a coreflective subcategory of `TopCat.{w}`. -/
instance instCoreflectiveCompactlyGeneratedToTop : Coreflective compactlyGeneratedToTop.{u, w} where
  R := TopCat.toCompactlyGenerated
  adj := adj

noncomputable instance instCreatesColimitsCompactlyGeneratedToTop :
    CreatesColimits compactlyGeneratedToTop.{u, w} :=
  comonadicCreatesColimits _

instance : HasLimits CompactlyGenerated.{u, w} :=
  hasLimits_of_coreflective compactlyGeneratedToTop

instance : HasColimits CompactlyGenerated.{u, w} :=
  hasColimits_of_hasColimits_createsColimits compactlyGeneratedToTop

/-- The counit `kX → X` is an isomorphism in `TopCat` if and only if `X` is `u`-compactly
generated. -/
theorem isIso_adjCounit_app_iff (X : TopCat.{w}) :
    IsIso (adjCounit.{u, w}.app X) ↔ UCompactlyGeneratedSpace.{u} X :=
  (GeneratedByTopCat.isIso_adjCounit_app_iff (X := fun K : CompHaus.{u} ↦ K) X).trans
    (isGeneratedBy_compHaus_iff X)

/-- When `X` is `u`-compactly generated, the counit `kX → X` is an isomorphism in `TopCat`. -/
instance isIso_adjCounit_app (X : TopCat.{w}) [UCompactlyGeneratedSpace.{u} X] :
    IsIso (adjCounit.{u, w}.app X) :=
  (isIso_adjCounit_app_iff X).2 inferInstance

/-- When `X` is `u`-compactly generated, the counit `kX → X` is a homeomorphism. In particular,
this applies to every sequential space (in any universe) and to every Hausdorff weakly locally
compact space in universe `u`. -/
def adjCounitHomeomorph (X : Type w) [TopologicalSpace X] [UCompactlyGeneratedSpace.{u} X] :
    WithGeneratedByTopology (fun K : CompHaus.{u} ↦ K) X ≃ₜ X :=
  IsGeneratedBy.homeomorph (X := fun K : CompHaus.{u} ↦ K) (Y := X)

@[simp]
theorem adjCounitHomeomorph_apply {X : Type w} [TopologicalSpace X]
    [UCompactlyGeneratedSpace.{u} X]
    (x : WithGeneratedByTopology (fun K : CompHaus.{u} ↦ K) X) :
    adjCounitHomeomorph.{u} X x = WithGeneratedByTopology.equiv x := by
  rfl

@[simp]
theorem adjCounitHomeomorph_symm_apply {X : Type w} [TopologicalSpace X]
    [UCompactlyGeneratedSpace.{u} X] (x : X) :
    (adjCounitHomeomorph.{u} X).symm x = WithGeneratedByTopology.equiv.symm x := by
  rfl

/-- `PUnit` is a terminal object in `CompactlyGenerated.{u, w}`. -/
def isTerminalPUnit : IsTerminal (of.{u, w} PUnit.{w + 1}) :=
  IsTerminal.ofUniqueHom (fun _ ↦ ofHom (ContinuousMap.const _ PUnit.unit)) fun _ _ ↦ by ext

/-- The explicit binary product fan of `X` and `Y` in `CompactlyGenerated.{u, w}`, carried by
`k(X × Y)`. -/
@[expose]
def prodBinaryFan (X Y : CompactlyGenerated.{u, w}) : BinaryFan X Y :=
  BinaryFan.mk
    (P := of (WithGeneratedByTopology (fun K : CompHaus.{u} ↦ K) (X × Y)))
    (ofHom ⟨Prod.fst ∘ WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K),
      continuous_fst.comp
        (WithGeneratedByTopology.continuous_equiv (X := fun K : CompHaus.{u} ↦ K))⟩)
    (ofHom ⟨Prod.snd ∘ WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K),
      continuous_snd.comp
        (WithGeneratedByTopology.continuous_equiv (X := fun K : CompHaus.{u} ↦ K))⟩)

/-- `k(X × Y)` is a binary product in `CompactlyGenerated.{u, w}`. -/
def prodBinaryFanIsLimit (X Y : CompactlyGenerated.{u, w}) : IsLimit (prodBinaryFan X Y) :=
  BinaryFan.IsLimit.mk _
    (fun {W} f g ↦ ofHom
      ⟨(WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K)).symm ∘
          fun w ↦ (f.hom w, g.hom w),
        (IsGeneratedBy.equiv_symm_comp_continuous_iff (X := fun K : CompHaus.{u} ↦ K) _).2
          (f.hom.hom.continuous.prodMk g.hom.hom.continuous)⟩)
    (fun _ _ ↦ rfl)
    (fun _ _ ↦ rfl)
    (fun _ _ _ hm₁ hm₂ ↦ by
      ext w
      apply (WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K)).injective
      exact Prod.ext
        (congrArg (fun k ↦ k.hom w) hm₁)
        (congrArg (fun k ↦ k.hom w) hm₂))

instance instCartesianMonoidalCategory : CartesianMonoidalCategory CompactlyGenerated.{u, w} :=
  .ofChosenFiniteProducts ⟨_, isTerminalPUnit⟩
    (fun X Y ↦ ⟨prodBinaryFan X Y, prodBinaryFanIsLimit X Y⟩)

instance instBraidedCategory : BraidedCategory CompactlyGenerated.{u, w} :=
  .ofCartesianMonoidalCategory

/-- The convenient product `X ⊗ Y` of two Hausdorff compactly generated spaces is Hausdorff. -/
instance instT2SpaceTensor (X Y : CompactlyGenerated.{u, w}) [T2Space X] [T2Space Y] :
    T2Space ↑(X ⊗ Y) :=
  inferInstanceAs (T2Space (WithGeneratedByTopology (fun K : CompHaus.{u} ↦ K) (X × Y)))

/-- The convenient product `X ⊗ Y` of two R₁ compactly generated spaces is R₁. -/
instance instR1SpaceTensor (X Y : CompactlyGenerated.{u, w}) [R1Space X] [R1Space Y] :
    R1Space ↑(X ⊗ Y) :=
  inferInstanceAs (R1Space (WithGeneratedByTopology (fun K : CompHaus.{u} ↦ K) (X × Y)))

@[simp]
theorem fst_apply {X Y : CompactlyGenerated.{u, w}} (p : ↑(X ⊗ Y)) :
    fst X Y p = (WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K) p).1 := by
  rfl

@[simp]
theorem snd_apply {X Y : CompactlyGenerated.{u, w}} (p : ↑(X ⊗ Y)) :
    snd X Y p = (WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K) p).2 := by
  rfl

@[simp]
theorem lift_apply {W X Y : CompactlyGenerated.{u, w}} (f : W ⟶ X) (g : W ⟶ Y) (w : W) :
    CartesianMonoidalCategory.lift f g w =
      (WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K)).symm (f w, g w) := by
  rfl

@[simp]
theorem tensorHom_apply {W X Y Z : CompactlyGenerated.{u, w}} (f : W ⟶ X) (g : Y ⟶ Z)
    (p : ↑(W ⊗ Y)) :
    (f ⊗ₘ g) p = (WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K)).symm
      (f (WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K) p).1,
        g (WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K) p).2) := by
  rfl

@[simp]
theorem whiskerLeft_apply (X : CompactlyGenerated.{u, w}) {Y Z : CompactlyGenerated.{u, w}}
    (g : Y ⟶ Z) (p : ↑(X ⊗ Y)) :
    (X ◁ g) p = (WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K)).symm
      ((WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K) p).1,
        g (WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K) p).2) := by
  rfl

@[simp]
theorem whiskerRight_apply {X Y : CompactlyGenerated.{u, w}} (f : X ⟶ Y)
    (Z : CompactlyGenerated.{u, w}) (p : ↑(X ⊗ Z)) :
    (f ▷ Z) p = (WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K)).symm
      (f (WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K) p).1,
        (WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K) p).2) := by
  rfl

@[simp]
theorem braiding_hom_apply {X Y : CompactlyGenerated.{u, w}} (p : ↑(X ⊗ Y)) :
    (β_ X Y).hom p = (WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K)).symm
      ((WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K) p).2,
        (WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K) p).1) := by
  rfl

/-- When the ordinary product `X × Y` is already `u`-compactly generated (for instance when either
factor is locally compact), the convenient product `X ⊗ Y` agrees with `X × Y` in `TopCat`. -/
def prodIsoTopCat (X Y : CompactlyGenerated.{u, w}) [UCompactlyGeneratedSpace.{u} (X × Y)] :
    compactlyGeneratedToTop.obj (X ⊗ Y) ≅
      compactlyGeneratedToTop.obj X ⊗ compactlyGeneratedToTop.obj Y :=
  TopCat.isoOfHomeo (adjCounitHomeomorph.{u} (X × Y))

@[simp]
theorem prodIsoTopCat_hom_apply (X Y : CompactlyGenerated.{u, w})
    [UCompactlyGeneratedSpace.{u} (X × Y)] (p : ↑(X ⊗ Y)) :
    (prodIsoTopCat X Y).hom p =
      WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K) p := by
  rfl

@[simp]
theorem prodIsoTopCat_inv_apply (X Y : CompactlyGenerated.{u, w})
    [UCompactlyGeneratedSpace.{u} (X × Y)]
    (p : ↑(compactlyGeneratedToTop.obj X ⊗ compactlyGeneratedToTop.obj Y)) :
    (prodIsoTopCat X Y).inv p =
      (WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K)).symm p := by
  rfl

@[reassoc (attr := simp)]
theorem prodIsoTopCat_hom_fst (X Y : CompactlyGenerated.{u, w})
    [UCompactlyGeneratedSpace.{u} (X × Y)] :
    (prodIsoTopCat X Y).hom ≫
        CartesianMonoidalCategory.fst (compactlyGeneratedToTop.obj X)
          (compactlyGeneratedToTop.obj Y) =
      compactlyGeneratedToTop.map (CartesianMonoidalCategory.fst X Y) := by
  rfl

@[reassoc (attr := simp)]
theorem prodIsoTopCat_hom_snd (X Y : CompactlyGenerated.{u, w})
    [UCompactlyGeneratedSpace.{u} (X × Y)] :
    (prodIsoTopCat X Y).hom ≫
        CartesianMonoidalCategory.snd (compactlyGeneratedToTop.obj X)
          (compactlyGeneratedToTop.obj Y) =
      compactlyGeneratedToTop.map (CartesianMonoidalCategory.snd X Y) := by
  rfl

/-- The internal hom functor `Y ↦ k(ContinuousMapGeneratedBy (fun K : CompHaus.{u} ↦ K) X Y)` on
`CompactlyGenerated.{u, w}`. -/
@[expose, simps! obj]
def homFunctor (X : CompactlyGenerated.{u, w}) :
    CompactlyGenerated.{u, w} ⥤ CompactlyGenerated.{u, w} where
  obj Y := of (WithGeneratedByTopology (fun K : CompHaus.{u} ↦ K)
    (ContinuousMapGeneratedBy (fun K : CompHaus.{u} ↦ K) X Y))
  map p := ofHom
    (ContinuousMapGeneratedBy.ofContinuousMap (X := fun K : CompHaus.{u} ↦ K)
      p.hom.hom).postcomp.prop.continuousMap
  map_id Y := by
    refine InducedCategory.hom_ext (TopCat.ext fun g ↦ ?_)
    refine (WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K)
      (Y := ContinuousMapGeneratedBy (fun K : CompHaus.{u} ↦ K) X Y)).injective ?_
    ext x
    exact ContinuousMapGeneratedBy.ofContinuousMap_apply (ContinuousMap.id Y) _
  map_comp {Y Z W} f g := by
    refine InducedCategory.hom_ext (TopCat.ext fun h ↦ ?_)
    refine (WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K)
      (Y := ContinuousMapGeneratedBy (fun K : CompHaus.{u} ↦ K) X W)).injective ?_
    ext x
    let h' : ContinuousMapGeneratedBy (fun K : CompHaus.{u} ↦ K) X Y :=
      WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K) h
    change ContinuousMapGeneratedBy.ofContinuousMap (X := fun K : CompHaus.{u} ↦ K)
        (f ≫ g).hom.hom (h' x) =
      ContinuousMapGeneratedBy.ofContinuousMap (X := fun K : CompHaus.{u} ↦ K) g.hom.hom
        (ContinuousMapGeneratedBy.ofContinuousMap (X := fun K : CompHaus.{u} ↦ K) f.hom.hom
          (h' x))
    simp only [ContinuousMapGeneratedBy.ofContinuousMap_apply]
    rfl

theorem homFunctor_map_apply (X : CompactlyGenerated.{u, w}) {Y Z : CompactlyGenerated.{u, w}}
    (p : Y ⟶ Z)
    (g : WithGeneratedByTopology (fun K : CompHaus.{u} ↦ K)
      (ContinuousMapGeneratedBy (fun K : CompHaus.{u} ↦ K) X Y))
    (x : X) :
    WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K)
        (Y := ContinuousMapGeneratedBy (fun K : CompHaus.{u} ↦ K) X Z)
        ((homFunctor X).map p g) x =
      p (WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K) g x) := by
  exact ContinuousMapGeneratedBy.ofContinuousMap_apply p.hom.hom _

/-- Currying in `CompactlyGenerated.{u, w}`: continuous maps `k(X × Y) → Z` correspond bijectively
to continuous maps `Y → k(ContinuousMapGeneratedBy (fun K : CompHaus.{u} ↦ K) X Z)`. -/
def curryEquiv (X Y Z : CompactlyGenerated.{u, w}) :
    (X ⊗ Y ⟶ Z) ≃ (Y ⟶ (homFunctor X).obj Z) :=
  let e : (X ⊗ Y ⟶ Z) ≃ (toGeneratedByTopCat.obj X ⊗ toGeneratedByTopCat.obj Y ⟶
      toGeneratedByTopCat.obj Z) :=
    { toFun f := ObjectProperty.homMk f.hom
      invFun f := InducedCategory.homMk f.hom
      left_inv _ := rfl
      right_inv _ := rfl }
  let e' : (toGeneratedByTopCat.obj Y ⟶
      (GeneratedByTopCat.homFunctor (toGeneratedByTopCat.obj X)).obj (toGeneratedByTopCat.obj Z)) ≃
      (Y ⟶ (homFunctor X).obj Z) :=
    { toFun g := InducedCategory.homMk g.hom
      invFun g := ObjectProperty.homMk g.hom
      left_inv _ := rfl
      right_inv _ := rfl }
  e.trans <|
    (GeneratedByTopCat.curryEquiv (toGeneratedByTopCat.obj X) (toGeneratedByTopCat.obj Y)
      (toGeneratedByTopCat.obj Z)).trans e'

theorem curryEquiv_apply_apply {X Y Z : CompactlyGenerated.{u, w}} (f : X ⊗ Y ⟶ Z)
    (y : Y) (x : X) :
    WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K)
        (Y := ContinuousMapGeneratedBy (fun K : CompHaus.{u} ↦ K) X Z)
        (curryEquiv X Y Z f y) x =
      f ((WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K)).symm (x, y)) := by
  exact GeneratedByTopCat.curryEquiv_apply_apply
    (Y := toGeneratedByTopCat.obj X) (Z := toGeneratedByTopCat.obj Y)
    (T := toGeneratedByTopCat.obj Z) (ObjectProperty.homMk f.hom) y x

theorem curryEquiv_symm_apply {X Y Z : CompactlyGenerated.{u, w}}
    (g : Y ⟶ (homFunctor X).obj Z) (p : ↑(X ⊗ Y)) :
    (curryEquiv X Y Z).symm g p =
      WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K)
        (Y := ContinuousMapGeneratedBy (fun K : CompHaus.{u} ↦ K) X Z)
        (g (WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K) p).2)
        (WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K) p).1 := by
  exact GeneratedByTopCat.curryEquiv_symm_apply
    (Y := toGeneratedByTopCat.obj X) (Z := toGeneratedByTopCat.obj Y)
    (T := toGeneratedByTopCat.obj Z) (ObjectProperty.homMk g.hom) p

/-- The adjunction `X ⊗ - ⊣ homFunctor X` on `CompactlyGenerated.{u, w}`. -/
def tensorLeftAdjunction (X : CompactlyGenerated.{u, w}) :
    tensorLeft X ⊣ homFunctor X :=
  Adjunction.mkOfHomEquiv
    { homEquiv := curryEquiv X
      homEquiv_naturality_left_symm f g := by
        refine InducedCategory.hom_ext (TopCat.ext fun p ↦ ?_)
        change (curryEquiv X _ _).symm (f ≫ g) p = (curryEquiv X _ _).symm g ((X ◁ f) p)
        rw [curryEquiv_symm_apply, curryEquiv_symm_apply, whiskerLeft_apply]
        rfl
      homEquiv_naturality_right {Y Z W} (f : X ⊗ Y ⟶ Z) g := by
        refine InducedCategory.hom_ext (TopCat.ext fun y ↦ ?_)
        refine (WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K)
          (Y := ContinuousMapGeneratedBy (fun K : CompHaus.{u} ↦ K) X W)).injective ?_
        ext x
        refine (curryEquiv_apply_apply (f ≫ g) y x).trans ?_
        exact (congrArg g (curryEquiv_apply_apply f y x).symm).trans
          (homFunctor_map_apply X g (curryEquiv X Y Z f y) x).symm }

instance closed (X : CompactlyGenerated.{u, w}) : Closed X where
  rightAdj := homFunctor X
  adj := tensorLeftAdjunction X

instance instMonoidalClosed : MonoidalClosed CompactlyGenerated.{u, w} where
  closed := closed

theorem ihom_obj (X Y : CompactlyGenerated.{u, w}) :
    (ihom X).obj Y = of (WithGeneratedByTopology (fun K : CompHaus.{u} ↦ K)
      (ContinuousMapGeneratedBy (fun K : CompHaus.{u} ↦ K) X Y)) := by
  rfl

theorem ev_app_apply (X Y : CompactlyGenerated.{u, w}) (x : X)
    (g : WithGeneratedByTopology (fun K : CompHaus.{u} ↦ K)
      (ContinuousMapGeneratedBy (fun K : CompHaus.{u} ↦ K) X Y)) :
    (ihom.ev X).app Y
        ((WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K)).symm (x, g)) =
      WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K) g x := by
  exact curryEquiv_symm_apply (𝟙 _) _

/-- For R₁ (for instance Hausdorff) compactly generated `X : CompactlyGenerated.{u, u}`, the
internal hom `(ihom X).obj Y` is isomorphic to `k(C(X, Y))`, the compact-generation coreflection
of the ordinary compact-open mapping space. -/
def ihomIsoContinuousMap (X Y : CompactlyGenerated.{u, u}) [R1Space X] :
    (ihom X).obj Y ≅ TopCat.toCompactlyGenerated.{u, u}.obj (TopCat.of C(X, Y)) :=
  TopCat.toCompactlyGenerated.{u, u}.mapIso
    (TopCat.isoOfHomeo
      (X := TopCat.of (ContinuousMapGeneratedBy (fun K : CompHaus.{u} ↦ K) X Y))
      (Y := TopCat.of C(X, Y))
      (ContinuousMapGeneratedBy.homeomorphContinuousMap (Y := X) (Z := Y)))

@[simp]
theorem ihomIsoContinuousMap_hom_apply (X Y : CompactlyGenerated.{u, u}) [R1Space X]
    (g : WithGeneratedByTopology (fun K : CompHaus.{u} ↦ K)
      (ContinuousMapGeneratedBy (fun K : CompHaus.{u} ↦ K) X Y))
    (x : X) :
    WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K) (Y := C(X, Y))
        ((ihomIsoContinuousMap X Y).hom g) x =
      WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K) g x := by
  exact ContinuousMapGeneratedBy.homeomorphContinuousMap_apply _ x

@[simp]
theorem ihomIsoContinuousMap_inv_apply (X Y : CompactlyGenerated.{u, u}) [R1Space X]
    (g : WithGeneratedByTopology (fun K : CompHaus.{u} ↦ K) C(X, Y)) (x : X) :
    WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K)
        (Y := ContinuousMapGeneratedBy (fun K : CompHaus.{u} ↦ K) X Y)
        ((ihomIsoContinuousMap X Y).inv g) x =
      WithGeneratedByTopology.equiv (X := fun K : CompHaus.{u} ↦ K) g x := by
  exact ContinuousMapGeneratedBy.homeomorphContinuousMap_symm_apply _ x

/-- The compactly generated exponential law on compact-open mapping spaces: for R₁ (for instance
Hausdorff) compactly generated `X` and `Y`, `k(C(X ⊗ Y, Z))` is isomorphic to
`k(C(Y, k(C(X, Z))))`. -/
def continuousMapCurryIso (X Y Z : CompactlyGenerated.{u, u}) [R1Space X] [R1Space Y] :
    TopCat.toCompactlyGenerated.{u, u}.obj (TopCat.of C(↑(X ⊗ Y), Z)) ≅
      TopCat.toCompactlyGenerated.{u, u}.obj
        (TopCat.of C(Y, TopCat.toCompactlyGenerated.{u, u}.obj (TopCat.of C(X, Z)))) :=
  (ihomIsoContinuousMap (X ⊗ Y) Z).symm ≪≫
    MonoidalClosed.ihomCurryIso X Y Z ≪≫
    (ihom Y).mapIso (ihomIsoContinuousMap X Z) ≪≫
    ihomIsoContinuousMap Y (TopCat.toCompactlyGenerated.{u, u}.obj (TopCat.of C(X, Z)))

end CompactlyGenerated
