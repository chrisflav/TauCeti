/-!
# Sullivan algebras, minimality, and indecomposables

This file defines the positive part `A⁺ = ⨆_{p > 0} Aᵖ`, the module of indecomposables
`Q(A) = A⁺ / (A⁺ · A⁺)`, Sullivan algebras, and minimal Sullivan algebras on Tau Ceti's
differential graded algebra carrier `TauCeti.IsDGAlgebra`.

## Main definitions

* `TauCeti.positivePart`: the positive-degree submodule `A⁺ = ⨆_{p > 0} Aᵖ` of an internally
  `ℤ`-graded module or algebra.
* `TauCeti.decomposables` and `TauCeti.Indecomposables`: the submodule `A⁺ · A⁺ ⊆ A⁺` and the
  quotient module of indecomposables `Q(A) = A⁺ / (A⁺ · A⁺)`, with quotient projection
  `TauCeti.Indecomposables.mk` and universal property `TauCeti.Indecomposables.lift`.
* `TauCeti.Indecomposables.map` and `TauCeti.DGAlgHom.indecomposablesMap`: functoriality of
  indecomposables on graded and differential graded algebra morphisms.
* `TauCeti.IsDGAlgebra.indecomposablesDiff`: the differential `Q(d)` induced on `Q(A)`.
* `TauCeti.IsFreeGradedCommutative.indecomposablesBasis`: when `2` is invertible and every
  generator has positive degree, the classes of the generators form a basis of `Q(A)`.
* `TauCeti.IsSullivanAlgebra`: a free graded-commutative algebra on well-ordered generators of
  positive degree whose differential sends each generator into the subalgebra generated by earlier
  generators.
* `TauCeti.IsMinimalSullivanAlgebra`: a Sullivan algebra whose differential sends every generator
  into `A⁺ · A⁺`.

## Main results

* `TauCeti.IsSullivanAlgebra.isMinimal_iff`: a Sullivan algebra is minimal if and only if
  `d (A⁺) ⊆ A⁺ · A⁺`, equivalently `hA.indecomposablesDiff = 0`.
* `TauCeti.IsSullivanAlgebra.d_eq_zero_of_isMin`: every minimal generator of a Sullivan algebra is
  closed.
* `TauCeti.IsSullivanAlgebra.restrictDownwardClosed`: every downward-closed subset of generators
  of a Sullivan algebra generates a sub-DG algebra that is itself a Sullivan algebra; the
  subalgebras generated by `Set.Iic i` increase with `i` and exhaust `A`.

## References

* Y. Félix, S. Halperin, and J.-C. Thomas, *Rational Homotopy Theory*, Graduate Texts in
  Mathematics 205, Springer (2001), Section 12.
* K. Hess, *Rational homotopy theory: a brief introduction*, Contemporary Mathematics 436 (2007),
  Section 1 (Definition 1.10).
* J. W. Morgan, *The algebraic topology of smooth algebraic varieties*, Publications Mathématiques
  de l'IHÉS 48 (1978), Definition 5.2.
-/

public section

open DirectSum

namespace TauCeti

universe u v w

/-! ### Positive part of a `ℤ`-graded algebra -/

section PositivePart

variable {R : Type u} {A : Type v}

section Semiring

variable [Semiring R] [AddCommMonoid A] [Module R A]

/-- The positive part `A⁺ = ⨁_{p > 0} Aᵖ` of an internally `ℤ`-graded module or algebra. -/
def positivePart (𝒜 : ℤ → Submodule R A) : Submodule R A :=
  ⨆ (p : ℤ) (_ : 0 < p), 𝒜 p

theorem positivePart_def (𝒜 : ℤ → Submodule R A) :
    positivePart 𝒜 = ⨆ (p : ℤ) (_ : 0 < p), 𝒜 p := (rfl)

theorem le_positivePart {𝒜 : ℤ → Submodule R A} {p : ℤ} (hp : 0 < p) :
    𝒜 p ≤ positivePart 𝒜 :=
  le_iSup₂_of_le p hp le_rfl

theorem mem_positivePart_of_mem {𝒜 : ℤ → Submodule R A} {p : ℤ} (hp : 0 < p) {a : A}
    (ha : a ∈ 𝒜 p) : a ∈ positivePart 𝒜 :=
  le_positivePart hp ha

theorem positivePart_le_iff {𝒜 : ℤ → Submodule R A} {N : Submodule R A} :
    positivePart 𝒜 ≤ N ↔ ∀ p : ℤ, 0 < p → 𝒜 p ≤ N :=
  iSup₂_le_iff

/-- An element belongs to `positivePart 𝒜` if and only if all of its homogeneous components in
nonpositive degrees vanish. -/
theorem mem_positivePart_iff {𝒜 : ℤ → Submodule R A} [DirectSum.Decomposition 𝒜] {a : A} :
    a ∈ positivePart 𝒜 ↔ ∀ p : ℤ, p ≤ 0 → (DirectSum.decompose 𝒜 a p : A) = 0 := by
  constructor
  · intro ha p hp
    refine Submodule.iSup_induction (p := fun q : ℤ => ⨆ (_ : 0 < q), 𝒜 q)
      (motive := fun x => (DirectSum.decompose 𝒜 x p : A) = 0) ha
      (fun q x hx => ?_) (by simp) (fun x y hx hy => by
        rw [DirectSum.decompose_add, DirectSum.add_apply, Submodule.coe_add, hx, hy, add_zero])
    refine Submodule.iSup_induction (p := fun (_ : 0 < q) => 𝒜 q)
      (motive := fun x => (DirectSum.decompose 𝒜 x p : A) = 0) hx
      (fun hq y hy => ?_) (by simp) (fun x y hx hy => by
        rw [DirectSum.decompose_add, DirectSum.add_apply, Submodule.coe_add, hx, hy, add_zero])
    rw [DirectSum.decompose_of_mem_ne 𝒜 hy (by omega)]
  · intro h
    classical
    rw [← DirectSum.sum_support_decompose 𝒜 a]
    refine Submodule.sum_mem _ fun p hp => ?_
    have hne : (DirectSum.decompose 𝒜 a p : A) ≠ 0 := by
      intro h0
      exact (DFinsupp.mem_support_toFun _ _).1 hp (Subtype.ext h0)
    have hpos : 0 < p := by
      by_contra hle
      exact hne (h p (not_lt.1 hle))
    exact mem_positivePart_of_mem hpos (DirectSum.decompose 𝒜 a p).2

/-- The positive part of an internally `ℤ`-graded module is homogeneous. -/
theorem isHomogeneous_positivePart (𝒜 : ℤ → Submodule R A) [DirectSum.Decomposition 𝒜] :
    SetLike.IsHomogeneous 𝒜 (positivePart 𝒜) := by
  intro p a ha
  by_cases hp : 0 < p
  · exact mem_positivePart_of_mem hp (DirectSum.decompose 𝒜 a p).2
  · rw [(mem_positivePart_iff.1 ha) p (not_lt.1 hp)]
    exact zero_mem _

/-- The degree-zero piece and the positive part are disjoint. -/
theorem disjoint_gradeZero_positivePart (𝒜 : ℤ → Submodule R A) [DirectSum.Decomposition 𝒜] :
    Disjoint (𝒜 0) (positivePart 𝒜) := by
  rw [Submodule.disjoint_def]
  intro a ha0 hap
  have h0 := (mem_positivePart_iff.1 hap) 0 le_rfl
  rwa [DirectSum.decompose_of_mem_same 𝒜 ha0] at h0

/-- When negative degrees vanish, the degree-zero piece and the positive part are complementary
submodules (`A = A⁰ ⊕ A⁺`). -/
theorem isCompl_gradeZero_positivePart (𝒜 : ℤ → Submodule R A) [DirectSum.Decomposition 𝒜]
    (hneg : ∀ p < 0, 𝒜 p = ⊥) : IsCompl (𝒜 0) (positivePart 𝒜) := by
  refine ⟨disjoint_gradeZero_positivePart 𝒜, ?_⟩
  rw [codisjoint_iff, eq_top_iff]
  intro a _
  classical
  rw [← DirectSum.sum_support_decompose 𝒜 a]
  refine Submodule.sum_mem _ fun p _ => ?_
  rcases lt_trichotomy p 0 with hp | rfl | hp
  · have h0 : (DirectSum.decompose 𝒜 a p : A) = 0 :=
      (Submodule.mem_bot R).1 (hneg p hp ▸ (DirectSum.decompose 𝒜 a p).2)
    rw [h0]
    exact zero_mem _
  · exact Submodule.mem_sup_left (DirectSum.decompose 𝒜 a 0).2
  · exact Submodule.mem_sup_right (mem_positivePart_of_mem hp (DirectSum.decompose 𝒜 a p).2)

end Semiring

section GradedMul

variable [CommSemiring R] [Semiring A] [Algebra R A]

/-- The product of two elements of `A⁺` lies in `A⁺`. -/
theorem positivePart_mul_le (𝒜 : ℤ → Submodule R A) [SetLike.GradedMul 𝒜] :
    positivePart 𝒜 * positivePart 𝒜 ≤ positivePart 𝒜 := by
  rw [Submodule.mul_le]
  intro a ha b hb
  refine Submodule.iSup_induction (p := fun p : ℤ => ⨆ (_ : 0 < p), 𝒜 p)
    (motive := fun x => x * b ∈ positivePart 𝒜) ha
    (fun p x hx => ?_) (by simp) (fun x y hx hy => by rw [add_mul]; exact add_mem hx hy)
  refine Submodule.iSup_induction (p := fun (_ : 0 < p) => 𝒜 p)
    (motive := fun x => x * b ∈ positivePart 𝒜) hx
    (fun hp x hx => ?_) (by simp) (fun x y hx hy => by rw [add_mul]; exact add_mem hx hy)
  refine Submodule.iSup_induction (p := fun q : ℤ => ⨆ (_ : 0 < q), 𝒜 q)
    (motive := fun y => x * y ∈ positivePart 𝒜) hb
    (fun q y hy => ?_) (by simp) (fun y z hy hz => by rw [mul_add]; exact add_mem hy hz)
  refine Submodule.iSup_induction (p := fun (_ : 0 < q) => 𝒜 q)
    (motive := fun y => x * y ∈ positivePart 𝒜) hy
    (fun hq y hy => ?_) (by simp) (fun y z hy hz => by rw [mul_add]; exact add_mem hy hz)
  exact mem_positivePart_of_mem (add_pos hp hq) (SetLike.mul_mem_graded hx hy)

/-- When negative degrees vanish, `positivePart 𝒜` is closed under left multiplication by `A`. -/
theorem mul_mem_positivePart_left {𝒜 : ℤ → Submodule R A} [GradedAlgebra 𝒜]
    (hneg : ∀ p < 0, 𝒜 p = ⊥) (a : A) {b : A} (hb : b ∈ positivePart 𝒜) :
    a * b ∈ positivePart 𝒜 := by
  induction a using DirectSum.Decomposition.inductionOn 𝒜 with
  | zero => simp
  | add x y hx hy => rw [add_mul]; exact add_mem hx hy
  | @homogeneous p a =>
    rcases lt_or_ge p 0 with hp | hp
    · have h0 : (a : A) = 0 := (Submodule.mem_bot R).1 (hneg p hp ▸ a.2)
      simp [h0]
    · refine Submodule.iSup_induction (p := fun q : ℤ => ⨆ (_ : 0 < q), 𝒜 q)
        (motive := fun y => (a : A) * y ∈ positivePart 𝒜) hb
        (fun q y hy => ?_) (by simp) (fun y z hy hz => by rw [mul_add]; exact add_mem hy hz)
      refine Submodule.iSup_induction (p := fun (_ : 0 < q) => 𝒜 q)
        (motive := fun y => (a : A) * y ∈ positivePart 𝒜) hy
        (fun hq y hy => ?_) (by simp) (fun y z hy hz => by rw [mul_add]; exact add_mem hy hz)
      exact mem_positivePart_of_mem (by omega) (SetLike.mul_mem_graded a.2 hy)

/-- When negative degrees vanish, `positivePart 𝒜` is closed under right multiplication by `A`. -/
theorem mul_mem_positivePart_right {𝒜 : ℤ → Submodule R A} [GradedAlgebra 𝒜]
    (hneg : ∀ p < 0, 𝒜 p = ⊥) {a : A} (ha : a ∈ positivePart 𝒜) (b : A) :
    a * b ∈ positivePart 𝒜 := by
  induction b using DirectSum.Decomposition.inductionOn 𝒜 with
  | zero => simp
  | add x y hx hy => rw [mul_add]; exact add_mem hx hy
  | @homogeneous q b =>
    rcases lt_or_ge q 0 with hq | hq
    · have h0 : (b : A) = 0 := (Submodule.mem_bot R).1 (hneg q hq ▸ b.2)
      simp [h0]
    · refine Submodule.iSup_induction (p := fun p : ℤ => ⨆ (_ : 0 < p), 𝒜 p)
        (motive := fun x => x * (b : A) ∈ positivePart 𝒜) ha
        (fun p x hx => ?_) (by simp) (fun x y hx hy => by rw [add_mul]; exact add_mem hx hy)
      refine Submodule.iSup_induction (p := fun (_ : 0 < p) => 𝒜 p)
        (motive := fun x => x * (b : A) ∈ positivePart 𝒜) hx
        (fun hp x hx => ?_) (by simp) (fun x y hx hy => by rw [add_mul]; exact add_mem hx hy)
      exact mem_positivePart_of_mem (by omega) (SetLike.mul_mem_graded hx b.2)

/-- A graded algebra homomorphism sends `A⁺` into `B⁺`. -/
theorem positivePart_map_le {B : Type*} [Semiring B] [Algebra R B]
    {𝒜 : ℤ → Submodule R A} {ℬ : ℤ → Submodule R B} [GradedAlgebra 𝒜] [GradedAlgebra ℬ]
    (f : 𝒜 →ₐᵍ[R] ℬ) :
    (positivePart 𝒜).map f.toAlgHom.toLinearMap ≤ positivePart ℬ := by
  rw [Submodule.map_le_iff_le_comap, positivePart_le_iff]
  intro p hp a ha
  exact mem_positivePart_of_mem hp (f.map_mem ha)

/-- A graded algebra homomorphism sends `A⁺ · A⁺` into `B⁺ · B⁺`. -/
theorem positivePart_mul_map_le {B : Type*} [Semiring B] [Algebra R B]
    {𝒜 : ℤ → Submodule R A} {ℬ : ℤ → Submodule R B} [GradedAlgebra 𝒜] [GradedAlgebra ℬ]
    (f : 𝒜 →ₐᵍ[R] ℬ) :
    (positivePart 𝒜 * positivePart 𝒜).map f.toAlgHom.toLinearMap ≤
      positivePart ℬ * positivePart ℬ := by
  rw [Submodule.map_le_iff_le_comap, Submodule.mul_le]
  intro a ha b hb
  -- Unfold `Submodule.mem_comap` on `f.toAlgHom.toLinearMap` so `map_mul` applies.
  change f (a * b) ∈ positivePart ℬ * positivePart ℬ
  rw [map_mul]
  exact Submodule.mul_mem_mul (positivePart_map_le f (Submodule.mem_map_of_mem ha))
    (positivePart_map_le f (Submodule.mem_map_of_mem hb))

end GradedMul

section DG

variable [CommRing R] [Ring A] [Algebra R A] {𝒜 : ℤ → Submodule R A} [GradedAlgebra 𝒜]
  {d : A →ₗ[R] A}

/-- The differential of a DG algebra preserves the positive part `A⁺`. -/
theorem IsDGAlgebra.map_mem_positivePart (hA : IsDGAlgebra 𝒜 d) {a : A}
    (ha : a ∈ positivePart 𝒜) : d a ∈ positivePart 𝒜 := by
  refine Submodule.iSup_induction (p := fun p : ℤ => ⨆ (_ : 0 < p), 𝒜 p)
    (motive := fun x => d x ∈ positivePart 𝒜) ha
    (fun p x hx => ?_) (by simp) (fun x y hx hy => by rw [map_add]; exact add_mem hx hy)
  refine Submodule.iSup_induction (p := fun (_ : 0 < p) => 𝒜 p)
    (motive := fun x => d x ∈ positivePart 𝒜) hx
    (fun hp x hx => mem_positivePart_of_mem (by omega) (hA.map_mem hx))
    (by simp) (fun x y hx hy => by rw [map_add]; exact add_mem hx hy)

/-- The differential of a DG algebra maps `A⁺` into `A⁺`. -/
theorem IsDGAlgebra.positivePart_map_le (hA : IsDGAlgebra 𝒜 d) :
    (positivePart 𝒜).map d ≤ positivePart 𝒜 :=
  Submodule.map_le_iff_le_comap.2 fun _ ha => hA.map_mem_positivePart ha

/-- The differential of a DG algebra preserves the decomposables `A⁺ · A⁺`. -/
theorem IsDGAlgebra.map_mem_positivePart_mul (hA : IsDGAlgebra 𝒜 d) {a : A}
    (ha : a ∈ positivePart 𝒜 * positivePart 𝒜) : d a ∈ positivePart 𝒜 * positivePart 𝒜 := by
  have hle : positivePart 𝒜 * positivePart 𝒜 ≤
      (positivePart 𝒜 * positivePart 𝒜).comap d := by
    rw [Submodule.mul_le]
    intro x hx y hy
    -- Unfold `Submodule.mem_comap` to expose `d (x * y)` for induction on `x ∈ positivePart 𝒜`.
    change d (x * y) ∈ positivePart 𝒜 * positivePart 𝒜
    refine Submodule.iSup_induction (p := fun p : ℤ => ⨆ (_ : 0 < p), 𝒜 p)
      (motive := fun u => d (u * y) ∈ positivePart 𝒜 * positivePart 𝒜) hx
      (fun p u hu => ?_) (by simp)
      (fun u v hu hv => by rw [add_mul, map_add]; exact add_mem hu hv)
    refine Submodule.iSup_induction (p := fun (_ : 0 < p) => 𝒜 p)
      (motive := fun u => d (u * y) ∈ positivePart 𝒜 * positivePart 𝒜) hu
      (fun hp u hu => ?_) (by simp)
      (fun u v hu hv => by rw [add_mul, map_add]; exact add_mem hu hv)
    rw [hA.leibniz hu y, Units.smul_def]
    exact add_mem
      (Submodule.mul_mem_mul (mem_positivePart_of_mem (by omega) (hA.map_mem hu)) hy)
      (zsmul_mem (Submodule.mul_mem_mul (mem_positivePart_of_mem hp hu)
        (hA.map_mem_positivePart hy)) _)
  exact hle ha

/-- The differential of a DG algebra maps `A⁺ · A⁺` into `A⁺ · A⁺`. -/
theorem IsDGAlgebra.positivePart_mul_map_le (hA : IsDGAlgebra 𝒜 d) :
    (positivePart 𝒜 * positivePart 𝒜).map d ≤ positivePart 𝒜 * positivePart 𝒜 :=
  Submodule.map_le_iff_le_comap.2 fun _ ha => hA.map_mem_positivePart_mul ha

end DG

end PositivePart

/-! ### Indecomposables `Q(A) = A⁺ / (A⁺ · A⁺)` -/

section Indecomposables

variable {R : Type u} [CommRing R] {A : Type v} [Ring A] [Algebra R A]

/-- The submodule of decomposable elements `A⁺ · A⁺` viewed inside `A⁺`. -/
def decomposables (𝒜 : ℤ → Submodule R A) : Submodule R (positivePart 𝒜) :=
  (positivePart 𝒜 * positivePart 𝒜).comap (positivePart 𝒜).subtype

theorem decomposables_def (𝒜 : ℤ → Submodule R A) :
    decomposables 𝒜 = (positivePart 𝒜 * positivePart 𝒜).comap (positivePart 𝒜).subtype := (rfl)

@[simp]
theorem mem_decomposables_iff {𝒜 : ℤ → Submodule R A} {a : positivePart 𝒜} :
    a ∈ decomposables 𝒜 ↔ (a : A) ∈ positivePart 𝒜 * positivePart 𝒜 :=
  Iff.rfl

/-- The module of indecomposables `Q(A) = A⁺ / (A⁺ · A⁺)` of an internally `ℤ`-graded algebra. -/
abbrev Indecomposables (𝒜 : ℤ → Submodule R A) : Type v :=
  positivePart 𝒜 ⧸ decomposables 𝒜

namespace Indecomposables

variable (𝒜 : ℤ → Submodule R A)

/-- The canonical quotient projection `A⁺ → Q(A)`. -/
def mk : positivePart 𝒜 →ₗ[R] Indecomposables 𝒜 :=
  (decomposables 𝒜).mkQ

theorem mk_def : mk 𝒜 = (decomposables 𝒜).mkQ := (rfl)

theorem mk_surjective : Function.Surjective (mk 𝒜) :=
  Submodule.mkQ_surjective _

@[simp]
theorem mk_eq_zero_iff {a : positivePart 𝒜} :
    mk 𝒜 a = 0 ↔ (a : A) ∈ positivePart 𝒜 * positivePart 𝒜 :=
  Submodule.Quotient.mk_eq_zero _

/-- Universal property of `Q(A) = A⁺ / (A⁺ · A⁺)`: a linear map out of `A⁺` vanishing on
decomposables descends to `Q(A)`. -/
def lift {M : Type*} [AddCommGroup M] [Module R M] (f : positivePart 𝒜 →ₗ[R] M)
    (hf : decomposables 𝒜 ≤ LinearMap.ker f) : Indecomposables 𝒜 →ₗ[R] M :=
  (decomposables 𝒜).liftQ f hf

@[simp]
theorem lift_mk {M : Type*} [AddCommGroup M] [Module R M] (f : positivePart 𝒜 →ₗ[R] M)
    (hf : decomposables 𝒜 ≤ LinearMap.ker f) (a : positivePart 𝒜) :
    lift 𝒜 f hf (mk 𝒜 a) = f a := (rfl)

/-- The linear map on indecomposables induced by a graded algebra homomorphism. -/
def map {B : Type*} [Ring B] [Algebra R B] {𝒜 : ℤ → Submodule R A} {ℬ : ℤ → Submodule R B}
    [GradedAlgebra 𝒜] [GradedAlgebra ℬ] (f : 𝒜 →ₐᵍ[R] ℬ) :
    Indecomposables 𝒜 →ₗ[R] Indecomposables ℬ :=
  Submodule.mapQ (decomposables 𝒜) (decomposables ℬ)
    (f.toAlgHom.toLinearMap.restrict fun _ ha =>
      positivePart_map_le f (Submodule.mem_map_of_mem ha))
    (fun _ ha => positivePart_mul_map_le f (Submodule.mem_map_of_mem ha))

@[simp]
theorem map_mk {B : Type*} [Ring B] [Algebra R B] {𝒜 : ℤ → Submodule R A} {ℬ : ℤ → Submodule R B}
    [GradedAlgebra 𝒜] [GradedAlgebra ℬ] (f : 𝒜 →ₐᵍ[R] ℬ) (a : positivePart 𝒜) :
    map f (mk 𝒜 a) =
      mk ℬ ⟨f a, positivePart_map_le f (Submodule.mem_map_of_mem a.2)⟩ := (rfl)

@[simp]
theorem map_id (𝒜 : ℤ → Submodule R A) [GradedAlgebra 𝒜] :
    map (GradedAlgHom.id R 𝒜) = LinearMap.id := by
  refine LinearMap.ext fun q => ?_
  obtain ⟨a, rfl⟩ := mk_surjective 𝒜 q
  simp

@[simp]
theorem map_comp {B C : Type*} [Ring B] [Algebra R B] [Ring C] [Algebra R C]
    {𝒜 : ℤ → Submodule R A} {ℬ : ℤ → Submodule R B} {𝒞 : ℤ → Submodule R C}
    [GradedAlgebra 𝒜] [GradedAlgebra ℬ] [GradedAlgebra 𝒞]
    (g : ℬ →ₐᵍ[R] 𝒞) (f : 𝒜 →ₐᵍ[R] ℬ) :
    map (g.comp f) = (map g).comp (map f) := by
  refine LinearMap.ext fun q => ?_
  obtain ⟨a, rfl⟩ := mk_surjective 𝒜 q
  simp

end Indecomposables

namespace IsDGAlgebra

variable {𝒜 : ℤ → Submodule R A} [GradedAlgebra 𝒜] {d : A →ₗ[R] A}

/-- The linear differential `Q(d) : Q(A) → Q(A)` induced on indecomposables by a DG algebra
differential. -/
def indecomposablesDiff (hA : IsDGAlgebra 𝒜 d) :
    Indecomposables 𝒜 →ₗ[R] Indecomposables 𝒜 :=
  Submodule.mapQ (decomposables 𝒜) (decomposables 𝒜)
    (d.restrict fun _ ha => hA.map_mem_positivePart ha)
    (fun _ ha => hA.map_mem_positivePart_mul ha)

@[simp]
theorem indecomposablesDiff_mk (hA : IsDGAlgebra 𝒜 d) (a : positivePart 𝒜) :
    hA.indecomposablesDiff (Indecomposables.mk 𝒜 a) =
      Indecomposables.mk 𝒜 ⟨d a, hA.map_mem_positivePart a.2⟩ := (rfl)

/-- The differential induced on indecomposables squares to zero. -/
theorem indecomposablesDiff_comp_self (hA : IsDGAlgebra 𝒜 d) :
    hA.indecomposablesDiff ∘ₗ hA.indecomposablesDiff = 0 := by
  refine LinearMap.ext fun q => ?_
  obtain ⟨a, rfl⟩ := Indecomposables.mk_surjective 𝒜 q
  simp [hA.sq_zero a.1]

/-- The differential induced on indecomposables vanishes if and only if `d (A⁺) ⊆ A⁺ · A⁺`. -/
theorem indecomposablesDiff_eq_zero_iff (hA : IsDGAlgebra 𝒜 d) :
    hA.indecomposablesDiff = 0 ↔ (positivePart 𝒜).map d ≤ positivePart 𝒜 * positivePart 𝒜 := by
  constructor
  · intro h
    rw [Submodule.map_le_iff_le_comap]
    intro a ha
    rw [Submodule.mem_comap]
    have h0 := LinearMap.congr_fun h (Indecomposables.mk 𝒜 ⟨a, ha⟩)
    simpa only [indecomposablesDiff_mk, LinearMap.zero_apply,
      Indecomposables.mk_eq_zero_iff] using h0
  · intro h
    refine LinearMap.ext fun q => ?_
    obtain ⟨a, rfl⟩ := Indecomposables.mk_surjective 𝒜 q
    simp only [indecomposablesDiff_mk, LinearMap.zero_apply, Indecomposables.mk_eq_zero_iff]
    exact h (Submodule.mem_map_of_mem a.2)

end IsDGAlgebra

namespace DGAlgHom

variable {B C : Type*} [Ring B] [Algebra R B] [Ring C] [Algebra R C]
  {𝒜 : ℤ → Submodule R A} {ℬ : ℤ → Submodule R B} {𝒞 : ℤ → Submodule R C}
  [GradedAlgebra 𝒜] [GradedAlgebra ℬ] [GradedAlgebra 𝒞]
  {dA : A →ₗ[R] A} {dB : B →ₗ[R] B} {dC : C →ₗ[R] C}
  {hA : IsDGAlgebra 𝒜 dA} {hB : IsDGAlgebra ℬ dB} {hC : IsDGAlgebra 𝒞 dC}

/-- The linear map on indecomposables induced by a morphism of DG algebras. -/
def indecomposablesMap (f : DGAlgHom hA hB) : Indecomposables 𝒜 →ₗ[R] Indecomposables ℬ :=
  Indecomposables.map f.toGradedAlgHom

@[simp]
theorem indecomposablesMap_mk (f : DGAlgHom hA hB) (a : positivePart 𝒜) :
    f.indecomposablesMap (Indecomposables.mk 𝒜 a) =
      Indecomposables.mk ℬ ⟨f a, positivePart_map_le f.toGradedAlgHom
        (Submodule.mem_map_of_mem a.2)⟩ := (rfl)

@[simp]
theorem indecomposablesMap_id (hA : IsDGAlgebra 𝒜 dA) :
    (DGAlgHom.id hA).indecomposablesMap = LinearMap.id := by
  refine LinearMap.ext fun q => ?_
  obtain ⟨a, rfl⟩ := Indecomposables.mk_surjective 𝒜 q
  simp

@[simp]
theorem indecomposablesMap_comp (g : DGAlgHom hB hC) (f : DGAlgHom hA hB) :
    (g.comp f).indecomposablesMap = g.indecomposablesMap.comp f.indecomposablesMap := by
  refine LinearMap.ext fun q => ?_
  obtain ⟨a, rfl⟩ := Indecomposables.mk_surjective 𝒜 q
  simp

/-- The induced map on indecomposables commutes with the induced differentials. -/
theorem indecomposablesMap_comp_diff (f : DGAlgHom hA hB) :
    hB.indecomposablesDiff.comp f.indecomposablesMap =
      f.indecomposablesMap.comp hA.indecomposablesDiff := by
  refine LinearMap.ext fun q => ?_
  obtain ⟨a, rfl⟩ := Indecomposables.mk_surjective 𝒜 q
  simp only [LinearMap.comp_apply, indecomposablesMap_mk, IsDGAlgebra.indecomposablesDiff_mk]
  congr 1
  exact Subtype.ext (f.map_d a.1)

end DGAlgHom

end Indecomposables

/-! ### Positive part and indecomposables of a free graded-commutative algebra -/

section FreePositivePart

variable {R : Type u} [CommRing R] {A : Type v} [Ring A] [Algebra R A]
  {𝒜 : ℤ → Submodule R A} {ι : Type w} [LinearOrder ι] {x : ι → A} {deg : ι → ℕ}

namespace IsFreeGradedCommutative

/-- When every generator has positive degree, every generator lies in `A⁺`. -/
theorem mem_positivePart (hx : IsFreeGradedCommutative 𝒜 x deg) (hpos : ∀ i, 0 < deg i) (i : ι) :
    x i ∈ positivePart 𝒜 :=
  mem_positivePart_of_mem (Int.natCast_pos.2 (hpos i)) (hx.mem i)

/-- When every generator has positive degree, `A = R · 1 ⊕ A⁺`. -/
theorem isCompl_one_positivePart [GradedAlgebra 𝒜] (hx : IsFreeGradedCommutative 𝒜 x deg)
    (hpos : ∀ i, 0 < deg i) : IsCompl (1 : Submodule R A) (positivePart 𝒜) := by
  rw [← hx.grade_zero_eq_one_of_pos hpos]
  exact isCompl_gradeZero_positivePart 𝒜 fun _ hp => hx.grade_eq_bot_of_neg hp

/-- Every non-empty standard monomial in positive-degree generators lies in `A⁺`. -/
theorem standardMonomial_mem_positivePart [SetLike.GradedMonoid 𝒜]
    (hx : IsFreeGradedCommutative 𝒜 x deg) (hpos : ∀ i, 0 < deg i) {f : ι →₀ ℕ} (hf : f ≠ 0) :
    standardMonomial x f ∈ positivePart 𝒜 :=
  mem_positivePart_of_mem (Int.natCast_pos.2 ((monomialDegree_pos_iff hpos).2 hf))
    (hx.standardMonomial_mem f)

/-- When every generator has positive degree, `A⁺` is spanned by the non-empty standard
monomials. -/
theorem positivePart_eq_span_standardMonomial [GradedAlgebra 𝒜]
    (hx : IsFreeGradedCommutative 𝒜 x deg) (hpos : ∀ i, 0 < deg i) :
    positivePart 𝒜 =
      Submodule.span R (Set.range fun f : {f : ExponentVector deg // f.1 ≠ 0} =>
        standardMonomial x f.1.1) := by
  refine le_antisymm ?_ ?_
  · rw [positivePart_le_iff]
    intro p hp
    rw [hx.grade_eq_span_standardMonomial p, Submodule.span_le]
    rintro _ ⟨f, hfdeg, rfl⟩
    have hf0 : f.1 ≠ 0 := by
      intro hf0
      rw [hf0, monomialDegree_zero] at hfdeg
      omega
    exact Submodule.subset_span ⟨⟨f, hf0⟩, rfl⟩
  · rw [Submodule.span_le]
    rintro _ ⟨⟨f, hf0⟩, rfl⟩
    exact hx.standardMonomial_mem_positivePart hpos hf0

/-- Any standard monomial of total exponent weight at least `2` is decomposable (in `A⁺ · A⁺`). -/
theorem standardMonomial_mem_positivePart_mul_of_two_le_sum [SetLike.GradedMonoid 𝒜]
    (hx : IsFreeGradedCommutative 𝒜 x deg) (hpos : ∀ i, 0 < deg i) {f : ι →₀ ℕ}
    (hwt : 2 ≤ f.sum fun _ n => n) :
    standardMonomial x f ∈ positivePart 𝒜 * positivePart 𝒜 := by
  classical
  have hne : f.support.Nonempty := by
    by_contra hemp
    rw [Finset.not_nonempty_iff_eq_empty] at hemp
    simp [Finsupp.sum, hemp] at hwt
  let i := f.support.min' hne
  have hi_mem : i ∈ f.support := Finset.min'_mem _ hne
  have hfi_pos : 0 < f i := Nat.pos_of_ne_zero (Finsupp.mem_support_iff.1 hi_mem)
  let g : ι →₀ ℕ := f.update i (f i - 1)
  have hf_eq : f = Finsupp.single i 1 + g := by
    ext j
    simp only [g, Finsupp.add_apply, Finsupp.update_apply, Finsupp.single_apply]
    by_cases hji : j = i
    · subst hji; simp only [↓reduceIte]; omega
    · simp [hji, Ne.symm hji]
  have hg_ne : g ≠ 0 := by
    intro hg0
    have hf1 : f = Finsupp.single i 1 := by simpa [hg0] using hf_eq
    have hsum : (f.sum fun _ n => n) = 1 := by rw [hf1]; simp
    omega
  by_cases hgi : g i = 0
  · have hlt : ∀ a ∈ (Finsupp.single i 1).support, ∀ b ∈ g.support, a < b := by
      intro a ha b hb
      have hai : a = i := Finset.mem_singleton.1 (Finsupp.support_single_subset ha)
      subst hai
      have hbi : b ≠ i := fun h => (Finsupp.mem_support_iff.1 hb) (h ▸ hgi)
      have hb_f : b ∈ f.support := by
        rw [Finsupp.mem_support_iff] at hb ⊢
        simpa [g, Finsupp.update_apply, hbi] using hb
      exact lt_of_le_of_ne (Finset.min'_le _ _ hb_f) (Ne.symm hbi)
    rw [hf_eq, standardMonomial_add_of_lt x hlt, standardMonomial_single, pow_one]
    exact Submodule.mul_mem_mul (hx.mem_positivePart hpos i)
      (hx.standardMonomial_mem_positivePart hpos hg_ne)
  · -- Here `f i ≥ 2`, so split `f = Finsupp.single i (f i) + h` where `h` is supported above `i`.
    let h : ι →₀ ℕ := f.filter (i < ·)
    have hf_split : f = Finsupp.single i (f i) + h := by
      ext j
      simp only [h, Finsupp.add_apply, Finsupp.single_apply, Finsupp.filter_apply]
      by_cases hji : i = j
      · subst hji; simp
      · by_cases hj_supp : j ∈ f.support
        · have hlt : i < j := lt_of_le_of_ne (Finset.min'_le _ _ hj_supp) hji
          simp [hji, hlt]
        · have hfj : f j = 0 := Finsupp.notMem_support_iff.1 hj_supp
          split_ifs <;> simp [hfj]
    have hlt : ∀ a ∈ (Finsupp.single i (f i)).support, ∀ b ∈ h.support, a < b := by
      intro a ha b hb
      have hai : a = i := Finset.mem_singleton.1 (Finsupp.support_single_subset ha)
      subst hai
      have hb' := Finsupp.mem_support_iff.1 hb
      simp only [h, Finsupp.filter_apply] at hb'
      split_ifs at hb' with hlt
      · exact hlt
      · contradiction
    have hfi_ge : 2 ≤ f i := by
      have : g i = f i - 1 := by simp [g]
      omega
    have hpow : x i ^ f i = x i * x i ^ (f i - 1) := by
      conv_lhs => rw [show f i = (f i - 1) + 1 by omega, pow_succ']
    have htail_pos : x i ^ (f i - 1) * standardMonomial x h ∈ positivePart 𝒜 := by
      have h1 : x i ^ (f i - 1) ∈ 𝒜 (((f i - 1) * deg i : ℕ) : ℤ) := by
        simpa [Nat.cast_mul] using SetLike.pow_mem_graded (f i - 1) (hx.mem i)
      have h2 : standardMonomial x h ∈ 𝒜 (monomialDegree deg h : ℤ) :=
        hx.standardMonomial_mem h
      have hmul := SetLike.mul_mem_graded h1 h2
      have hdeg_pos : 0 < (((f i - 1) * deg i : ℕ) : ℤ) + (monomialDegree deg h : ℤ) := by
        have h1pos : 0 < (f i - 1) * deg i := Nat.mul_pos (by omega) (hpos i)
        omega
      exact mem_positivePart_of_mem hdeg_pos hmul
    rw [hf_split, standardMonomial_add_of_lt x hlt, standardMonomial_single, hpow, mul_assoc]
    exact Submodule.mul_mem_mul (hx.mem_positivePart hpos i) htail_pos

/-- When `2` is invertible and every generator has positive degree, the module of indecomposables
`Q(A)` is canonically isomorphic to `ι →₀ R`. -/
noncomputable def indecomposablesEquiv [GradedAlgebra 𝒜] [Invertible (2 : R)]
    (hx : IsFreeGradedCommutative 𝒜 x deg) (hpos : ∀ i, 0 < deg i) :
    Indecomposables 𝒜 ≃ₗ[R] (ι →₀ R) := by
  classical
  let weightMap : ExponentVector deg → (ι →₀ R) := fun f =>
    if (f.1.sum fun _ n => n) = 1 then f.1.mapRange Nat.cast Nat.cast_zero else 0
  let π : A →ₗ[R] (ι →₀ R) := hx.basis.constr R weightMap
  have hπ_single : ∀ i : ι, π (x i) = Finsupp.single i (1 : R) := by
    intro i
    have h1 : x i = hx.basis (ExponentVector.single (deg := deg) i) := by
      simp [ExponentVector.coe_single]
    rw [h1, Module.Basis.constr_basis]
    simp [weightMap, ExponentVector.coe_single]
  have hπ_zero_of_ne_one : ∀ f : ExponentVector deg, (f.1.sum fun _ n => n) ≠ 1 →
      π (standardMonomial x f.1) = 0 := by
    intro f hf
    rw [← hx.basis_apply f, Module.Basis.constr_basis]
    simp [weightMap, hf]
  have hπ_mul : ∀ a ∈ positivePart 𝒜, ∀ b ∈ positivePart 𝒜, π (a * b) = 0 := by
    intro a ha b hb
    rw [hx.positivePart_eq_span_standardMonomial hpos] at ha hb
    refine Submodule.span_induction (p := fun u _ => π (u * b) = 0)
      (fun u hu => ?_) (by simp)
      (fun u v _ _ hu hv => by rw [add_mul, map_add, hu, hv, add_zero])
      (fun r u _ hu => by rw [smul_mul_assoc, map_smul, hu, smul_zero]) ha
    obtain ⟨⟨f, hf0⟩, rfl⟩ := hu
    refine Submodule.span_induction (p := fun v _ => π (standardMonomial x f.1 * v) = 0)
      (fun v hv => ?_) (by simp)
      (fun u v _ _ hu hv => by rw [mul_add, map_add, hu, hv, add_zero])
      (fun r u _ hu => by rw [mul_smul_comm, map_smul, hu, smul_zero]) hb
    obtain ⟨⟨g, hg0⟩, rfl⟩ := hv
    by_cases hodd : ∃ i, Odd (deg i) ∧ f.1 i ≠ 0 ∧ g.1 i ≠ 0
    · rw [TauCeti.standardMonomial_mul_eq_zero_of_odd hx.mul_comm
        (fun _ => hx.sq_eq_zero_of_odd) hodd, map_zero]
    · push Not at hodd
      have hfg_valid : ∀ i, Odd (deg i) → (f.1 + g.1) i ≤ 1 := by
        intro i hi
        have hfi := f.2 i hi
        have hgi := g.2 i hi
        by_cases hfi0 : f.1 i = 0
        · simp [hfi0, hgi]
        · simp [hodd i hi hfi0, hfi]
      let fg : ExponentVector deg := ⟨f.1 + g.1, hfg_valid⟩
      have hwt_f : 1 ≤ f.1.sum fun _ n => n := by
        obtain ⟨i, hi⟩ := Finsupp.support_nonempty_iff.2 hf0
        exact Nat.one_le_of_lt (lt_of_lt_of_le
          (Nat.pos_of_ne_zero (Finsupp.mem_support_iff.1 hi))
          (Finset.single_le_sum (f := fun j => f.1 j) (fun _ _ => Nat.zero_le _) hi))
      have hwt_g : 1 ≤ g.1.sum fun _ n => n := by
        obtain ⟨i, hi⟩ := Finsupp.support_nonempty_iff.2 hg0
        exact Nat.one_le_of_lt (lt_of_lt_of_le
          (Nat.pos_of_ne_zero (Finsupp.mem_support_iff.1 hi))
          (Finset.single_le_sum (f := fun j => g.1 j) (fun _ _ => Nat.zero_le _) hi))
      have hwt_fg : (fg.1.sum fun _ n => n) ≠ 1 := by
        have hsum : (fg.1.sum fun _ n => n) =
            (f.1.sum fun _ n => n) + (g.1.sum fun _ n => n) :=
          Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl)
        omega
      rw [standardMonomial_mul_eq_smul hx.mul_comm f.1 g.1, Units.smul_def, map_zsmul,
        hπ_zero_of_ne_one fg hwt_fg, smul_zero]
  have hker : decomposables 𝒜 ≤ LinearMap.ker (π ∘ₗ (positivePart 𝒜).subtype) := by
    intro a ha
    rw [LinearMap.mem_ker, LinearMap.comp_apply, Submodule.coe_subtype]
    have hle : positivePart 𝒜 * positivePart 𝒜 ≤ LinearMap.ker π := by
      rw [Submodule.mul_le]
      exact fun u hu v hv => hπ_mul u hu v hv
    exact hle ha
  let fwd : Indecomposables 𝒜 →ₗ[R] (ι →₀ R) :=
    Indecomposables.lift 𝒜 (π ∘ₗ (positivePart 𝒜).subtype) hker
  let bwd : (ι →₀ R) →ₗ[R] Indecomposables 𝒜 :=
    Finsupp.linearCombination R fun i => Indecomposables.mk 𝒜 ⟨x i, hx.mem_positivePart hpos i⟩
  refine LinearEquiv.ofLinearMap fwd bwd ?_ ?_
  · refine Finsupp.lhom_ext' fun i => LinearMap.ext_ring ?_
    simp [fwd, bwd, hπ_single]
  · refine LinearMap.ext fun q => ?_
    obtain ⟨⟨a, ha⟩, rfl⟩ := Indecomposables.mk_surjective 𝒜 q
    have hspan : ∀ u : A, u ∈ positivePart 𝒜 →
        ∀ hu : u ∈ positivePart 𝒜,
          bwd (fwd (Indecomposables.mk 𝒜 ⟨u, hu⟩)) = Indecomposables.mk 𝒜 ⟨u, hu⟩ := by
      intro u hu
      rw [hx.positivePart_eq_span_standardMonomial hpos] at hu
      refine Submodule.span_induction
        (p := fun v _ => ∀ hv : v ∈ positivePart 𝒜,
          bwd (fwd (Indecomposables.mk 𝒜 ⟨v, hv⟩)) = Indecomposables.mk 𝒜 ⟨v, hv⟩)
        (fun v hv hv' => ?_) (fun hv0 => by
          have h0 : (⟨0, hv0⟩ : positivePart 𝒜) = 0 := rfl
          rw [h0, map_zero, map_zero, map_zero])
        (fun u v hu_span hv_span ihu ihv huv => by
          have hu' : u ∈ positivePart 𝒜 := by
            rw [hx.positivePart_eq_span_standardMonomial hpos]; exact hu_span
          have hv' : v ∈ positivePart 𝒜 := by
            rw [hx.positivePart_eq_span_standardMonomial hpos]; exact hv_span
          have hadd : (⟨u + v, huv⟩ : positivePart 𝒜) = ⟨u, hu'⟩ + ⟨v, hv'⟩ := rfl
          rw [hadd, map_add, map_add, map_add, ihu hu', ihv hv'])
        (fun r u hu_span ihu hru => by
          have hu' : u ∈ positivePart 𝒜 := by
            rw [hx.positivePart_eq_span_standardMonomial hpos]; exact hu_span
          have hsmul : (⟨r • u, hru⟩ : positivePart 𝒜) = r • ⟨u, hu'⟩ := rfl
          rw [hsmul, map_smul, map_smul, map_smul, ihu hu']) hu
      obtain ⟨⟨f, hf0⟩, rfl⟩ := hv
      have hwt_pos : 1 ≤ f.1.sum fun _ n => n := by
        obtain ⟨i, hi⟩ := Finsupp.support_nonempty_iff.2 hf0
        exact Nat.one_le_of_lt (lt_of_lt_of_le
          (Nat.pos_of_ne_zero (Finsupp.mem_support_iff.1 hi))
          (Finset.single_le_sum (f := fun j => f.1 j) (fun _ _ => Nat.zero_le _) hi))
      by_cases hwt1 : (f.1.sum fun _ n => n) = 1
      · obtain ⟨i, hfi⟩ := (Finsupp.sum_eq_one_iff f.1).1 hwt1
        have hxi : standardMonomial x f.1 = x i := by simp [hfi]
        have hmk : (⟨standardMonomial x f.1, hv'⟩ : positivePart 𝒜) =
            ⟨x i, hx.mem_positivePart hpos i⟩ := Subtype.ext hxi
        rw [hmk]
        simp [fwd, bwd, hπ_single]
      · have hwt2 : 2 ≤ f.1.sum fun _ n => n := by omega
        have hzero : Indecomposables.mk 𝒜 ⟨standardMonomial x f.1, hv'⟩ = 0 :=
          (Indecomposables.mk_eq_zero_iff 𝒜).2
            (hx.standardMonomial_mem_positivePart_mul_of_two_le_sum hpos hwt2)
        rw [hzero, map_zero, map_zero]
    exact hspan a ha ha

@[simp]
theorem indecomposablesEquiv_symm_single [GradedAlgebra 𝒜] [Invertible (2 : R)]
    (hx : IsFreeGradedCommutative 𝒜 x deg) (hpos : ∀ i, 0 < deg i) (i : ι) (r : R) :
    (hx.indecomposablesEquiv hpos).symm (Finsupp.single i r) =
      r • Indecomposables.mk 𝒜 ⟨x i, hx.mem_positivePart hpos i⟩ := by
  simp [indecomposablesEquiv]

@[simp]
theorem indecomposablesEquiv_mk_gen [GradedAlgebra 𝒜] [Invertible (2 : R)]
    (hx : IsFreeGradedCommutative 𝒜 x deg) (hpos : ∀ i, 0 < deg i) (i : ι) :
    hx.indecomposablesEquiv hpos (Indecomposables.mk 𝒜 ⟨x i, hx.mem_positivePart hpos i⟩) =
      Finsupp.single i 1 := by
  have h := (hx.indecomposablesEquiv hpos).apply_symm_apply (Finsupp.single i 1)
  rwa [indecomposablesEquiv_symm_single, one_smul] at h

/-- When `2` is invertible and every generator has positive degree, the classes of the generators
`x i` form a basis of the module of indecomposables `Q(A)`. -/
noncomputable def indecomposablesBasis [GradedAlgebra 𝒜] [Invertible (2 : R)]
    (hx : IsFreeGradedCommutative 𝒜 x deg) (hpos : ∀ i, 0 < deg i) :
    Module.Basis ι R (Indecomposables 𝒜) :=
  Module.Basis.ofRepr (hx.indecomposablesEquiv hpos)

@[simp]
theorem indecomposablesBasis_apply [GradedAlgebra 𝒜] [Invertible (2 : R)]
    (hx : IsFreeGradedCommutative 𝒜 x deg) (hpos : ∀ i, 0 < deg i) (i : ι) :
    hx.indecomposablesBasis hpos i =
      Indecomposables.mk 𝒜 ⟨x i, hx.mem_positivePart hpos i⟩ := by
  apply (hx.indecomposablesEquiv hpos).injective
  rw [indecomposablesEquiv_mk_gen]
  exact (hx.indecomposablesBasis hpos).repr_self i

/-- For a free graded-commutative DG algebra with positive-degree generators, the differential
maps `A⁺` into `A⁺ · A⁺` if and only if it maps every generator into `A⁺ · A⁺`. -/
theorem map_positivePart_le_mul_iff [GradedAlgebra 𝒜] {d : A →ₗ[R] A} (hA : IsDGAlgebra 𝒜 d)
    (hx : IsFreeGradedCommutative 𝒜 x deg) (hpos : ∀ i, 0 < deg i) :
    (positivePart 𝒜).map d ≤ positivePart 𝒜 * positivePart 𝒜 ↔
      ∀ i, d (x i) ∈ positivePart 𝒜 * positivePart 𝒜 := by
  constructor
  · intro h i
    exact h (Submodule.mem_map_of_mem (hx.mem_positivePart hpos i))
  · intro h
    rw [Submodule.map_le_iff_le_comap]
    conv_lhs => rw [hx.positivePart_eq_span_standardMonomial hpos]
    rw [Submodule.span_le]
    rintro _ ⟨⟨f, hf0⟩, rfl⟩
    dsimp only
    rw [SetLike.mem_coe, Submodule.mem_comap]
    have hwt_pos : 1 ≤ f.1.sum fun _ n => n := by
      obtain ⟨i, hi⟩ := Finsupp.support_nonempty_iff.2 hf0
      exact Nat.one_le_of_lt (lt_of_lt_of_le
        (Nat.pos_of_ne_zero (Finsupp.mem_support_iff.1 hi))
        (Finset.single_le_sum (f := fun j => f.1 j) (fun _ _ => Nat.zero_le _) hi))
    by_cases hwt1 : (f.1.sum fun _ n => n) = 1
    · obtain ⟨i, hfi⟩ := (Finsupp.sum_eq_one_iff f.1).1 hwt1
      simpa [hfi] using h i
    · have hwt2 : 2 ≤ f.1.sum fun _ n => n := by omega
      exact hA.map_mem_positivePart_mul
        (hx.standardMonomial_mem_positivePart_mul_of_two_le_sum hpos hwt2)

/-- The subalgebras generated by `Set.Iic i` exhaust `A`. -/
theorem iSup_adjoin_Iic_eq_top (hx : IsFreeGradedCommutative 𝒜 x deg) :
    ⨆ i : ι, Algebra.adjoin R (x '' Set.Iic i) = ⊤ := by
  rw [eq_top_iff, ← hx.adjoin_range_eq_top, Algebra.adjoin_le_iff]
  rintro _ ⟨i, rfl⟩
  exact le_iSup (fun j => Algebra.adjoin R (x '' Set.Iic j)) i
    (Algebra.subset_adjoin ⟨i, Set.mem_Iic.2 le_rfl, rfl⟩)

/-- When the generator index type is nonempty, every element of `A` lies in `Algebra.adjoin R
(x '' Set.Iic i)` for some `i : ι`. -/
theorem exists_mem_adjoin_Iic [Nonempty ι] (hx : IsFreeGradedCommutative 𝒜 x deg) (a : A) :
    ∃ i : ι, a ∈ Algebra.adjoin R (x '' Set.Iic i) := by
  have hmono : Monotone fun i : ι => Algebra.adjoin R (x '' Set.Iic i) :=
    fun _ _ hij => Algebra.adjoin_mono (Set.image_mono (Set.Iic_subset_Iic.2 hij))
  have hmem : a ∈ (⨆ i : ι, Algebra.adjoin R (x '' Set.Iic i) : Subalgebra R A) := by
    rw [hx.iSup_adjoin_Iic_eq_top]
    trivial
  have hcoe : a ∈ ((⨆ i : ι, Algebra.adjoin R (x '' Set.Iic i) : Subalgebra R A) : Set A) := hmem
  rw [Subalgebra.coe_iSup_of_directed hmono.directed_le, Set.mem_iUnion] at hcoe
  exact hcoe

end IsFreeGradedCommutative

end FreePositivePart

/-! ### Sullivan algebras and minimality -/

section Sullivan

variable {R : Type u} [CommRing R] {A : Type v} [Ring A] [Algebra R A]

/-- A **Sullivan algebra** `(ΛV, d)`: a free graded-commutative algebra on well-ordered generators
of positive degree whose differential sends each generator into the subalgebra generated by the
earlier generators. -/
structure IsSullivanAlgebra (𝒜 : ℤ → Submodule R A) (d : A →ₗ[R] A)
    {ι : Type w} [LinearOrder ι] [WellFoundedLT ι] (x : ι → A) (deg : ι → ℕ) : Prop
    extends IsFreeGradedCommutative 𝒜 x deg where
  /-- Every generator has positive degree. -/
  deg_pos : ∀ i, 0 < deg i
  /-- The differential of a generator lies in the subalgebra generated by the earlier ones. -/
  d_mem_adjoin : ∀ i, d (x i) ∈ Algebra.adjoin R (x '' Set.Iio i)

/-- A **minimal Sullivan algebra**: a Sullivan algebra whose differential sends every generator
into the decomposables `A⁺ · A⁺`. -/
structure IsMinimalSullivanAlgebra (𝒜 : ℤ → Submodule R A) (d : A →ₗ[R] A)
    {ι : Type w} [LinearOrder ι] [WellFoundedLT ι] (x : ι → A) (deg : ι → ℕ) : Prop
    extends IsSullivanAlgebra 𝒜 d x deg where
  /-- The differential of each generator is decomposable. -/
  d_mem_mul : ∀ i, d (x i) ∈ positivePart 𝒜 * positivePart 𝒜

namespace IsSullivanAlgebra

variable {𝒜 : ℤ → Submodule R A} {d : A →ₗ[R] A}
  {ι : Type w} [LinearOrder ι] [WellFoundedLT ι] {x : ι → A} {deg : ι → ℕ}

/-- A Sullivan algebra is minimal if and only if `d (A⁺) ⊆ A⁺ · A⁺`. -/
theorem isMinimal_iff [GradedAlgebra 𝒜] (hA : IsDGAlgebra 𝒜 d)
    (hx : IsSullivanAlgebra 𝒜 d x deg) :
    IsMinimalSullivanAlgebra 𝒜 d x deg ↔
      (positivePart 𝒜).map d ≤ positivePart 𝒜 * positivePart 𝒜 := by
  rw [hx.toIsFreeGradedCommutative.map_positivePart_le_mul_iff hA hx.deg_pos]
  exact ⟨fun hm => hm.d_mem_mul, fun hd => ⟨hx, hd⟩⟩

/-- A Sullivan algebra is minimal if and only if the differential induced on its indecomposables
`Q(A) = A⁺ / (A⁺ · A⁺)` vanishes. -/
theorem isMinimal_iff_indecomposablesDiff_eq_zero [GradedAlgebra 𝒜] (hA : IsDGAlgebra 𝒜 d)
    (hx : IsSullivanAlgebra 𝒜 d x deg) :
    IsMinimalSullivanAlgebra 𝒜 d x deg ↔ hA.indecomposablesDiff = 0 := by
  rw [hx.isMinimal_iff hA, hA.indecomposablesDiff_eq_zero_iff]

/-- In a Sullivan algebra, any minimal generator (with no strictly smaller index) is closed. -/
theorem d_eq_zero_of_isMin [GradedAlgebra 𝒜] (hA : IsDGAlgebra 𝒜 d)
    (hx : IsSullivanAlgebra 𝒜 d x deg) {i : ι} (hmin : ∀ j : ι, ¬ j < i) :
    d (x i) = 0 := by
  have hIio : Set.Iio i = ∅ := Set.eq_empty_iff_forall_notMem.2 hmin
  have hmem0 : d (x i) ∈ 𝒜 0 := by
    have hadj := hx.d_mem_adjoin i
    rw [hIio, Set.image_empty, Algebra.adjoin_empty] at hadj
    obtain ⟨r, hr⟩ := Algebra.mem_bot.1 hadj
    rw [← hr]
    exact SetLike.algebraMap_mem_graded 𝒜 r
  have hmempos : d (x i) ∈ positivePart 𝒜 :=
    hA.map_mem_positivePart (hx.toIsFreeGradedCommutative.mem_positivePart hx.deg_pos i)
  exact Submodule.disjoint_def.1 (disjoint_gradeZero_positivePart 𝒜) _ hmem0 hmempos

/-- Any downward-closed subset `S` of generators of a Sullivan algebra generates a `d`-stable
subalgebra. -/
theorem d_mem_adjoin_of_downwardClosed [GradedAlgebra 𝒜] (hA : IsDGAlgebra 𝒜 d)
    (hx : IsSullivanAlgebra 𝒜 d x deg) {S : Set ι} (hS : ∀ ⦃j k⦄, j < k → k ∈ S → j ∈ S)
    {a : A} (ha : a ∈ Algebra.adjoin R (x '' S)) : d a ∈ Algebra.adjoin R (x '' S) := by
  refine hA.map_mem_adjoin (s := x '' S) ?_ ?_ ha
  · rintro _ ⟨j, _, rfl⟩
    exact ⟨deg j, hx.mem j⟩
  · rintro _ ⟨j, hj, rfl⟩
    exact Algebra.adjoin_mono (Set.image_mono fun k hk => hS hk hj) (hx.d_mem_adjoin j)

/-- For every `i : ι`, `Algebra.adjoin R (x '' Set.Iio i)` is preserved by `d`. -/
theorem d_mem_adjoin_Iio [GradedAlgebra 𝒜] (hA : IsDGAlgebra 𝒜 d)
    (hx : IsSullivanAlgebra 𝒜 d x deg) (i : ι) {a : A}
    (ha : a ∈ Algebra.adjoin R (x '' Set.Iio i)) : d a ∈ Algebra.adjoin R (x '' Set.Iio i) :=
  hx.d_mem_adjoin_of_downwardClosed hA (fun _ _ h hj => lt_trans h hj) ha

/-- For every `i : ι`, `Algebra.adjoin R (x '' Set.Iic i)` is preserved by `d`. -/
theorem d_mem_adjoin_Iic [GradedAlgebra 𝒜] (hA : IsDGAlgebra 𝒜 d)
    (hx : IsSullivanAlgebra 𝒜 d x deg) (i : ι) {a : A}
    (ha : a ∈ Algebra.adjoin R (x '' Set.Iic i)) : d a ∈ Algebra.adjoin R (x '' Set.Iic i) :=
  hx.d_mem_adjoin_of_downwardClosed hA (fun _ _ h hj => le_trans h.le hj) ha

/-- When `2` is invertible, any downward-closed subset `S` of generators of a Sullivan algebra
generates a sub-DG algebra that is itself a Sullivan algebra on `S`. -/
theorem restrictDownwardClosed [GradedAlgebra 𝒜] [Invertible (2 : R)] (hA : IsDGAlgebra 𝒜 d)
    (hx : IsSullivanAlgebra 𝒜 d x deg) {S : Set ι} (hS : ∀ ⦃j k⦄, j < k → k ∈ S → j ∈ S) :
    IsSullivanAlgebra ((Algebra.adjoin R (x '' S)).grading 𝒜)
      ((Algebra.adjoin R (x '' S)).dgDifferential d fun _ ha =>
        hx.d_mem_adjoin_of_downwardClosed hA hS ha)
      (fun j : S => (⟨x j.1, Algebra.subset_adjoin ⟨j.1, j.2, rfl⟩⟩ : Algebra.adjoin R (x '' S)))
      (fun j : S => deg j.1) where
  toIsFreeGradedCommutative := hx.toIsFreeGradedCommutative.restrict S
  deg_pos j := hx.deg_pos j.1
  d_mem_adjoin j := by
    let T := Algebra.adjoin R (x '' S)
    let xS : S → T := fun k => ⟨x k.1, Algebra.subset_adjoin ⟨k.1, k.2, rfl⟩⟩
    have himg : T.val '' (xS '' Set.Iio j) = x '' Set.Iio j.1 := by
      ext y
      simp only [Set.mem_image, Set.mem_Iio, Subalgebra.coe_val, xS]
      constructor
      · rintro ⟨_, ⟨k, hk, rfl⟩, rfl⟩
        exact ⟨k.1, hk, rfl⟩
      · rintro ⟨k, hk, rfl⟩
        exact ⟨⟨x k, Algebra.subset_adjoin ⟨k, hS hk j.2, rfl⟩⟩,
          ⟨⟨k, hS hk j.2⟩, hk, rfl⟩, rfl⟩
    have hmap : ((T.dgDifferential d (fun _ ha =>
        hx.d_mem_adjoin_of_downwardClosed hA hS ha) (xS j) : T) : A) ∈
        (Algebra.adjoin R (xS '' Set.Iio j)).map T.val := by
      rw [AlgHom.map_adjoin, himg, Subalgebra.coe_dgDifferential]
      exact hx.d_mem_adjoin j.1
    obtain ⟨u, hu, hu_eq⟩ := Subalgebra.mem_map.1 hmap
    exact (Subtype.ext hu_eq) ▸ hu

/-- For every `i : ι`, when `2` is invertible, the subalgebra generated by `x j` (`j < i`) is a
Sullivan algebra on `Set.Iio i`. -/
theorem restrictIio [GradedAlgebra 𝒜] [Invertible (2 : R)] (hA : IsDGAlgebra 𝒜 d)
    (hx : IsSullivanAlgebra 𝒜 d x deg) (i : ι) :
    IsSullivanAlgebra ((Algebra.adjoin R (x '' Set.Iio i)).grading 𝒜)
      ((Algebra.adjoin R (x '' Set.Iio i)).dgDifferential d fun _ ha =>
        hx.d_mem_adjoin_Iio hA i ha)
      (fun j : Set.Iio i =>
        (⟨x j.1, Algebra.subset_adjoin ⟨j.1, j.2, rfl⟩⟩ : Algebra.adjoin R (x '' Set.Iio i)))
      (fun j : Set.Iio i => deg j.1) :=
  hx.restrictDownwardClosed hA (fun _ _ h hj => lt_trans h hj)

/-- For every `i : ι`, when `2` is invertible, the subalgebra generated by `x j` (`j ≤ i`) is a
Sullivan algebra on `Set.Iic i`. -/
theorem restrictIic [GradedAlgebra 𝒜] [Invertible (2 : R)] (hA : IsDGAlgebra 𝒜 d)
    (hx : IsSullivanAlgebra 𝒜 d x deg) (i : ι) :
    IsSullivanAlgebra ((Algebra.adjoin R (x '' Set.Iic i)).grading 𝒜)
      ((Algebra.adjoin R (x '' Set.Iic i)).dgDifferential d fun _ ha =>
        hx.d_mem_adjoin_Iic hA i ha)
      (fun j : Set.Iic i =>
        (⟨x j.1, Algebra.subset_adjoin ⟨j.1, j.2, rfl⟩⟩ : Algebra.adjoin R (x '' Set.Iic i)))
      (fun j : Set.Iic i => deg j.1) :=
  hx.restrictDownwardClosed hA (fun _ _ h hj => le_trans h.le hj)

end IsSullivanAlgebra

end Sullivan

end TauCeti
