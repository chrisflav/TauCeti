public import TauCeti.Algebra.Homology.DG.Algebra.Hom.Basic
public import TauCeti.RingTheory.GradedAlgebra.Subalgebra

/-!
# Subalgebras of differential graded algebras

A homogeneous subalgebra `T` of a differential graded algebra `(A, 𝒜, d)` that is preserved by the
differential inherits a differential graded algebra structure on its induced grading `T.grading 𝒜`,
and the canonical inclusion `T → A` is a morphism of differential graded algebras.

When `T` is generated as a subalgebra by homogeneous elements whose differentials lie in `T`, the
graded Leibniz rule implies automatically that `T` is preserved by `d`.

## Main definitions

* `Subalgebra.dgDifferential`: the restriction of a differential `d : A →ₗ[R] A` to a `d`-stable
  subalgebra `T`.
* `TauCeti.IsDGAlgebra.subalgebraVal`: the inclusion of a `d`-stable homogeneous subalgebra as a
  morphism of differential graded algebras.

## Main results

* `TauCeti.IsDGAlgebra.restrictSubalgebra`: a `d`-stable homogeneous subalgebra of a DG algebra is
  a DG algebra.
* `TauCeti.IsDGAlgebra.map_mem_of_mem_adjoin`: if `s` consists of homogeneous elements with
  `Algebra.adjoin R s ≤ T` and `d y ∈ T` for all `y ∈ s`, then `d a ∈ T` for every
  `a ∈ Algebra.adjoin R s`.
* `TauCeti.IsDGAlgebra.map_mem_adjoin`: a subalgebra generated by homogeneous elements whose
  differentials lie in the subalgebra is preserved by the differential.
-/

public section

open DirectSum

namespace Subalgebra

variable {R A : Type*} [CommRing R] [Ring A] [Algebra R A]

/-- The restriction of a linear endomorphism `d : A →ₗ[R] A` to a `d`-stable subalgebra `T`. -/
def dgDifferential (T : Subalgebra R A) (d : A →ₗ[R] A) (hd : ∀ a ∈ T, d a ∈ T) : T →ₗ[R] T where
  toFun a := ⟨d a.1, hd a.1 a.2⟩
  map_add' a b := Subtype.ext (map_add d a.1 b.1)
  map_smul' r a := Subtype.ext (map_smul d r a.1)

@[simp]
theorem coe_dgDifferential (T : Subalgebra R A) (d : A →ₗ[R] A) (hd : ∀ a ∈ T, d a ∈ T)
    (a : T) : (T.dgDifferential d hd a : A) = d a := (rfl)

end Subalgebra

namespace TauCeti

namespace IsDGAlgebra

variable {R A : Type*} [CommRing R] [Ring A] [Algebra R A]
  {𝒜 : ℤ → Submodule R A} [GradedAlgebra 𝒜] {d : A →ₗ[R] A}

/-- A `d`-stable homogeneous subalgebra of a differential graded algebra inherits a differential
graded algebra structure on its induced grading `T.grading 𝒜`. -/
theorem restrictSubalgebra (h : IsDGAlgebra 𝒜 d) (T : Subalgebra R A)
    [GradedAlgebra (T.grading 𝒜)] (hd : ∀ a ∈ T, d a ∈ T) :
    IsDGAlgebra (T.grading 𝒜) (T.dgDifferential d hd) where
  map_mem {_ _} ha := (Subalgebra.mem_grading_iff T 𝒜).2 <|
    h.map_mem ((Subalgebra.mem_grading_iff T 𝒜).1 ha)
  sq_zero a := Subtype.ext (h.sq_zero a.1)
  leibniz {_ _} ha b := Subtype.ext (h.leibniz ((Subalgebra.mem_grading_iff T 𝒜).1 ha) b.1)

/-- The inclusion of a `d`-stable homogeneous subalgebra into the ambient differential graded
algebra, as a morphism of differential graded algebras. -/
def subalgebraVal (h : IsDGAlgebra 𝒜 d) (T : Subalgebra R A) [GradedAlgebra (T.grading 𝒜)]
    (hd : ∀ a ∈ T, d a ∈ T) : DGAlgHom (h.restrictSubalgebra T hd) h where
  toGradedAlgHom := T.gradedVal 𝒜
  map_d' a := by simp [Subalgebra.coe_gradedVal]

@[simp]
theorem subalgebraVal_apply (h : IsDGAlgebra 𝒜 d) (T : Subalgebra R A)
    [GradedAlgebra (T.grading 𝒜)] (hd : ∀ a ∈ T, d a ∈ T) (a : T) :
    h.subalgebraVal T hd a = a :=
  congr_fun (Subalgebra.coe_gradedVal T 𝒜) a

/-- If a set `s` of homogeneous elements satisfies `Algebra.adjoin R s ≤ T` and `d y ∈ T` for all
`y ∈ s`, then `d a ∈ T` for every `a ∈ Algebra.adjoin R s`. -/
theorem map_mem_of_mem_adjoin (h : IsDGAlgebra 𝒜 d) {s : Set A} {T : Subalgebra R A}
    (hs : ∀ y ∈ s, SetLike.IsHomogeneousElem 𝒜 y) (hsub : Algebra.adjoin R s ≤ T)
    (hd : ∀ y ∈ s, d y ∈ T) {a : A} (ha : a ∈ Algebra.adjoin R s) : d a ∈ T := by
  have hhom : SetLike.IsHomogeneous 𝒜 (Algebra.adjoin R s) :=
    Algebra.isHomogeneous_adjoin 𝒜 hs
  have hcomp : ∀ u ∈ Algebra.adjoin R s, ∀ p : ℤ, d (DirectSum.decompose 𝒜 u p : A) ∈ T := by
    intro u hu
    induction hu using Algebra.adjoin_induction with
    | mem y hy =>
      intro p
      obtain ⟨q, hq⟩ := hs y hy
      by_cases hqp : q = p
      · subst hqp
        rw [DirectSum.decompose_of_mem_same 𝒜 hq]
        exact hd y hy
      · rw [DirectSum.decompose_of_mem_ne 𝒜 hq hqp, map_zero]
        exact zero_mem T
    | algebraMap r =>
      intro p
      by_cases hp0 : (0 : ℤ) = p
      · subst hp0
        rw [DirectSum.decompose_of_mem_same 𝒜 (SetLike.algebraMap_mem_graded 𝒜 r),
          h.map_algebraMap r]
        exact zero_mem T
      · rw [DirectSum.decompose_of_mem_ne 𝒜 (SetLike.algebraMap_mem_graded 𝒜 r) hp0, map_zero]
        exact zero_mem T
    | add x y _ _ hx hy =>
      intro p
      rw [DirectSum.decompose_add, DirectSum.add_apply, Submodule.coe_add, map_add]
      exact add_mem (hx p) (hy p)
    | mul x y hxmem hymem hx hy =>
      intro p
      classical
      have hmul : x * y =
          ∑ i ∈ (DirectSum.decompose 𝒜 x).support,
            ∑ j ∈ (DirectSum.decompose 𝒜 y).support,
              (DirectSum.decompose 𝒜 x i : A) * (DirectSum.decompose 𝒜 y j : A) := by
        conv_lhs =>
          rw [← DirectSum.sum_support_decompose 𝒜 x, ← DirectSum.sum_support_decompose 𝒜 y]
        rw [Finset.sum_mul]
        exact Finset.sum_congr rfl fun i _ => Finset.mul_sum _ _ _
      have hadd : ∀ u v : A, d (DirectSum.decompose 𝒜 u p : A) ∈ T →
          d (DirectSum.decompose 𝒜 v p : A) ∈ T →
          d (DirectSum.decompose 𝒜 (u + v) p : A) ∈ T := fun u v hu hv => by
        rw [DirectSum.decompose_add, DirectSum.add_apply, Submodule.coe_add, map_add]
        exact add_mem hu hv
      rw [hmul]
      refine Finset.sum_induction _ (fun u => d (DirectSum.decompose 𝒜 u p : A) ∈ T)
        hadd (by simp) fun i _ => ?_
      refine Finset.sum_induction _ (fun u => d (DirectSum.decompose 𝒜 u p : A) ∈ T)
        hadd (by simp) fun j _ => ?_
      have hij : (DirectSum.decompose 𝒜 x i : A) * (DirectSum.decompose 𝒜 y j : A) ∈ 𝒜 (i + j) :=
        SetLike.mul_mem_graded (DirectSum.decompose 𝒜 x i).2 (DirectSum.decompose 𝒜 y j).2
      by_cases hijp : i + j = p
      · rw [DirectSum.decompose_of_mem_same 𝒜 (hijp ▸ hij),
          h.leibniz (DirectSum.decompose 𝒜 x i).2 (DirectSum.decompose 𝒜 y j : A), Units.smul_def]
        exact add_mem (mul_mem (hx i) (hsub (hhom j hymem)))
          (zsmul_mem (mul_mem (hsub (hhom i hxmem)) (hy j)) _)
      · rw [DirectSum.decompose_of_mem_ne 𝒜 hij hijp, map_zero]
        exact zero_mem T
  classical
  rw [← DirectSum.sum_support_decompose 𝒜 a, map_sum]
  exact sum_mem fun p _ => hcomp a ha p

/-- A subalgebra generated by homogeneous elements whose differentials lie in the subalgebra is
preserved by the differential. -/
theorem map_mem_adjoin (h : IsDGAlgebra 𝒜 d) {s : Set A}
    (hs : ∀ y ∈ s, SetLike.IsHomogeneousElem 𝒜 y)
    (hd : ∀ y ∈ s, d y ∈ Algebra.adjoin R s) {a : A} (ha : a ∈ Algebra.adjoin R s) :
    d a ∈ Algebra.adjoin R s :=
  h.map_mem_of_mem_adjoin hs le_rfl hd ha

end IsDGAlgebra

end TauCeti
