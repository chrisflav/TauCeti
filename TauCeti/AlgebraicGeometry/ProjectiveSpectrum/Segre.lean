universe u

section SegrePullback

variable {R A B : Type u} [CommRing R] [CommRing A] [Algebra R A] [CommRing B] [Algebra R B]
  (𝒜 : ℕ → Submodule R A) (ℬ : ℕ → Submodule R B) [GradedAlgebra 𝒜] [GradedAlgebra ℬ]

/-- Index type for the pure-tensor standard affine charts `D₊(a ⊗ₜ b)` (`a ∈ 𝒜 d`, `b ∈ ℬ d`,
`d > 0`) of `Proj (Segre.grading 𝒜 ℬ)`. -/
abbrev SegreChartIdx : Type u :=
  Σ d : ℕ+, 𝒜 d × ℬ d

/-- The irrelevant ideal of `Segre 𝒜 ℬ` is contained in the ideal generated by the positive-degree
pure tensors `a ⊗ₜ b`. -/
theorem irrelevant_segre_le_span :
    (HomogeneousIdeal.irrelevant (Segre.grading 𝒜 ℬ)).toIdeal ≤
      Ideal.span (Set.range fun i : SegreChartIdx 𝒜 ℬ ↦
        Segre.tmul i.2.1.2 i.2.2.2) := by
  classical
  intro z hz
  rw [← DirectSum.sum_support_decompose (Segre.grading 𝒜 ℬ) z]
  refine Ideal.sum_mem _ fun c _ ↦ ?_
  by_cases hc0 : c = 0
  · subst hc0
    have hz0 : (DirectSum.decompose (Segre.grading 𝒜 ℬ) z 0 : Segre 𝒜 ℬ) = 0 := hz
    simpa only [hz0] using Ideal.zero_mem _
  · set w := DirectSum.decompose (Segre.grading 𝒜 ℬ) z c
    rw [← (Segre.gradingEquiv 𝒜 ℬ c).apply_symm_apply w]
    set u := (Segre.gradingEquiv 𝒜 ℬ c).symm w
    suffices ∀ v : 𝒜 c ⊗[R] ℬ c,
        (Segre.gradingEquiv 𝒜 ℬ c v : Segre 𝒜 ℬ) ∈
          Ideal.span (Set.range fun i : SegreChartIdx 𝒜 ℬ ↦ Segre.tmul i.2.1.2 i.2.2.2) from
      this u
    intro v
    induction v using TensorProduct.inductionOn with
    | tmul x y =>
      rw [Segre.coe_gradingEquiv_tmul]
      exact Ideal.subset_span ⟨⟨⟨c, Nat.pos_iff_ne_zero.mpr hc0⟩, x, y⟩, rfl⟩
    | add v₁ v₂ hv₁ hv₂ =>
      rw [map_add, Submodule.coe_add]
      exact add_mem hv₁ hv₂

/-- The affine open cover of `Proj (Segre.grading 𝒜 ℬ)` by the pure-tensor charts
`Spec (Segre 𝒜 ℬ)_{(a ⊗ₜ b)}`. -/
noncomputable def segreAffineOpenCover : (Proj (Segre.grading 𝒜 ℬ)).AffineOpenCover :=
  affineOpenCoverOfIrrelevantLESpan (Segre.grading 𝒜 ℬ)
    (m := fun i : SegreChartIdx 𝒜 ℬ ↦ i.1)
    (fun i ↦ Segre.tmul i.2.1.2 i.2.2.2)
    (fun i ↦ Segre.tmul_mem_grading i.2.1.2 i.2.2.2)
    (fun i ↦ i.1.pos)
    (irrelevant_segre_le_span 𝒜 ℬ)

private theorem specMap_awayMap_segreFst_awayι {d e k : ℕ} {a a' x : A} {b b' y : B}
    (ha : a ∈ 𝒜 d) (hb : b ∈ ℬ d) (hd : 0 < d)
    (ha' : a' ∈ 𝒜 e) (hb' : b' ∈ ℬ e) (hk : k = d + e) (hk0 : 0 < k)
    (hx : x = a * a') (hy : y = b * b') (hx_mem : x ∈ 𝒜 k) (hy_mem : y ∈ ℬ k)
    (hw : Segre.tmul hx_mem hy_mem = Segre.tmul ha hb * Segre.tmul ha' hb') :
    Spec.map (CommRingCat.ofHom
        (awayMap (Segre.grading 𝒜 ℬ) (Segre.tmul_mem_grading ha' hb') hw)) ≫
      Spec.map (CommRingCat.ofHom (Away.segreFst ha hb).toRingHom) ≫
      awayι 𝒜 a ha hd =
    Spec.map (CommRingCat.ofHom (Away.segreFst hx_mem hy_mem).toRingHom) ≫
      awayι 𝒜 x hx_mem hk0 := by
  subst hk
  rw [← Spec.map_comp_assoc, ← CommRingCat.ofHom_comp]
  have hcomp : (awayMap (Segre.grading 𝒜 ℬ) (Segre.tmul_mem_grading ha' hb') hw).comp
      (Away.segreFst ha hb).toRingHom =
      (Away.segreFst hx_mem hy_mem).toRingHom.comp (awayMap 𝒜 ha' hx) :=
    RingHom.ext (Away.segreFst_awayMap ha hb ha' hb' hx hy hx_mem hy_mem hw)
  rw [hcomp, CommRingCat.ofHom_comp, Spec.map_comp_assoc, SpecMap_awayMap_awayι]

private theorem specMap_awayMap_segreSnd_awayι {d e k : ℕ} {a a' x : A} {b b' y : B}
    (ha : a ∈ 𝒜 d) (hb : b ∈ ℬ d) (hd : 0 < d)
    (ha' : a' ∈ 𝒜 e) (hb' : b' ∈ ℬ e) (hk : k = d + e) (hk0 : 0 < k)
    (hx : x = a * a') (hy : y = b * b') (hx_mem : x ∈ 𝒜 k) (hy_mem : y ∈ ℬ k)
    (hw : Segre.tmul hx_mem hy_mem = Segre.tmul ha hb * Segre.tmul ha' hb') :
    Spec.map (CommRingCat.ofHom
        (awayMap (Segre.grading 𝒜 ℬ) (Segre.tmul_mem_grading ha' hb') hw)) ≫
      Spec.map (CommRingCat.ofHom (Away.segreSnd ha hb).toRingHom) ≫
      awayι ℬ b hb hd =
    Spec.map (CommRingCat.ofHom (Away.segreSnd hx_mem hy_mem).toRingHom) ≫
      awayι ℬ y hy_mem hk0 := by
  subst hk
  rw [← Spec.map_comp_assoc, ← CommRingCat.ofHom_comp]
  have hcomp : (awayMap (Segre.grading 𝒜 ℬ) (Segre.tmul_mem_grading ha' hb') hw).comp
      (Away.segreSnd ha hb).toRingHom =
      (Away.segreSnd hx_mem hy_mem).toRingHom.comp (awayMap ℬ hb' hy) :=
    RingHom.ext (Away.segreSnd_awayMap ha hb ha' hb' hx hy hx_mem hy_mem hw)
  rw [hcomp, CommRingCat.ofHom_comp, Spec.map_comp_assoc, SpecMap_awayMap_awayι]

/-- The first projection `Proj (Segre.grading 𝒜 ℬ) ⟶ Proj 𝒜`, glued from `Away.segreFst` on the
pure-tensor standard affine charts `D₊(a ⊗ₜ b)`. -/
noncomputable def segreFst : Proj (Segre.grading 𝒜 ℬ) ⟶ Proj 𝒜 :=
  (segreAffineOpenCover 𝒜 ℬ).openCover.glueMorphisms
    (fun i ↦ Spec.map (CommRingCat.ofHom (Away.segreFst i.2.1.2 i.2.2.2).toRingHom) ≫
      awayι 𝒜 i.2.1.1 i.2.1.2 i.1.pos)
    fun i j ↦ by
      dsimp only [segreAffineOpenCover, affineOpenCoverOfIrrelevantLESpan,
        Scheme.AffineOpenCover.openCover, Scheme.AffineCover.cover] at i j ⊢
      rcases i with ⟨d₁, ⟨a₁, ha₁⟩, ⟨b₁, hb₁⟩⟩
      rcases j with ⟨d₂, ⟨a₂, ha₂⟩, ⟨b₂, hb₂⟩⟩
      have hx_mem : a₁ * a₂ ∈ 𝒜 ((d₁ : ℕ) + d₂) := SetLike.mul_mem_graded ha₁ ha₂
      have hy_mem : b₁ * b₂ ∈ ℬ ((d₁ : ℕ) + d₂) := SetLike.mul_mem_graded hb₁ hb₂
      have hw : Segre.tmul hx_mem hy_mem = Segre.tmul ha₁ hb₁ * Segre.tmul ha₂ hb₂ :=
        (Segre.tmul_mul_tmul ha₁ hb₁ ha₂ hb₂).symm
      have hk0 : 0 < (d₁ : ℕ) + d₂ := Nat.add_pos_left d₁.pos d₂
      rw [← cancel_epi (pullbackAwayιIso (Segre.grading 𝒜 ℬ)
        (Segre.tmul_mem_grading ha₁ hb₁) d₁.pos
        (Segre.tmul_mem_grading ha₂ hb₂) d₂.pos hw).inv,
        pullbackAwayιIso_inv_fst_assoc, pullbackAwayιIso_inv_snd_assoc,
        specMap_awayMap_segreFst_awayι 𝒜 ℬ ha₁ hb₁ d₁.pos ha₂ hb₂ rfl hk0 rfl rfl hx_mem hy_mem hw,
        specMap_awayMap_segreFst_awayι 𝒜 ℬ ha₂ hb₂ d₂.pos ha₁ hb₁ (add_comm _ _) hk0
          (mul_comm _ _) (mul_comm _ _) hx_mem hy_mem (hw.trans (mul_comm _ _))]

/-- The second projection `Proj (Segre.grading 𝒜 ℬ) ⟶ Proj ℬ`, glued from `Away.segreSnd` on the
pure-tensor standard affine charts `D₊(a ⊗ₜ b)`. -/
noncomputable def segreSnd : Proj (Segre.grading 𝒜 ℬ) ⟶ Proj ℬ :=
  (segreAffineOpenCover 𝒜 ℬ).openCover.glueMorphisms
    (fun i ↦ Spec.map (CommRingCat.ofHom (Away.segreSnd i.2.1.2 i.2.2.2).toRingHom) ≫
      awayι ℬ i.2.2.1 i.2.2.2 i.1.pos)
    fun i j ↦ by
      dsimp only [segreAffineOpenCover, affineOpenCoverOfIrrelevantLESpan,
        Scheme.AffineOpenCover.openCover, Scheme.AffineCover.cover] at i j ⊢
      rcases i with ⟨d₁, ⟨a₁, ha₁⟩, ⟨b₁, hb₁⟩⟩
      rcases j with ⟨d₂, ⟨a₂, ha₂⟩, ⟨b₂, hb₂⟩⟩
      have hx_mem : a₁ * a₂ ∈ 𝒜 ((d₁ : ℕ) + d₂) := SetLike.mul_mem_graded ha₁ ha₂
      have hy_mem : b₁ * b₂ ∈ ℬ ((d₁ : ℕ) + d₂) := SetLike.mul_mem_graded hb₁ hb₂
      have hw : Segre.tmul hx_mem hy_mem = Segre.tmul ha₁ hb₁ * Segre.tmul ha₂ hb₂ :=
        (Segre.tmul_mul_tmul ha₁ hb₁ ha₂ hb₂).symm
      have hk0 : 0 < (d₁ : ℕ) + d₂ := Nat.add_pos_left d₁.pos d₂
      rw [← cancel_epi (pullbackAwayιIso (Segre.grading 𝒜 ℬ)
        (Segre.tmul_mem_grading ha₁ hb₁) d₁.pos
        (Segre.tmul_mem_grading ha₂ hb₂) d₂.pos hw).inv,
        pullbackAwayιIso_inv_fst_assoc, pullbackAwayιIso_inv_snd_assoc,
        specMap_awayMap_segreSnd_awayι 𝒜 ℬ ha₁ hb₁ d₁.pos ha₂ hb₂ rfl hk0 rfl rfl hx_mem hy_mem hw,
        specMap_awayMap_segreSnd_awayι 𝒜 ℬ ha₂ hb₂ d₂.pos ha₁ hb₁ (add_comm _ _) hk0
          (mul_comm _ _) (mul_comm _ _) hx_mem hy_mem (hw.trans (mul_comm _ _))]

/-- On the pure-tensor chart `D₊(a ⊗ₜ b)`, `segreFst` is `Spec` of `Away.segreFst`. -/
@[reassoc (attr := simp)]
theorem awayι_segreFst {d : ℕ} {a : A} {b : B} (ha : a ∈ 𝒜 d) (hb : b ∈ ℬ d) (hd : 0 < d) :
    awayι (Segre.grading 𝒜 ℬ) (Segre.tmul ha hb) (Segre.tmul_mem_grading ha hb) hd ≫
      segreFst 𝒜 ℬ =
    Spec.map (CommRingCat.ofHom (Away.segreFst ha hb).toRingHom) ≫ awayι 𝒜 a ha hd :=
  (segreAffineOpenCover 𝒜 ℬ).openCover.ι_glueMorphisms _ _ ⟨⟨d, hd⟩, ⟨a, ha⟩, ⟨b, hb⟩⟩

/-- On the pure-tensor chart `D₊(a ⊗ₜ b)`, `segreSnd` is `Spec` of `Away.segreSnd`. -/
@[reassoc (attr := simp)]
theorem awayι_segreSnd {d : ℕ} {a : A} {b : B} (ha : a ∈ 𝒜 d) (hb : b ∈ ℬ d) (hd : 0 < d) :
    awayι (Segre.grading 𝒜 ℬ) (Segre.tmul ha hb) (Segre.tmul_mem_grading ha hb) hd ≫
      segreSnd 𝒜 ℬ =
    Spec.map (CommRingCat.ofHom (Away.segreSnd ha hb).toRingHom) ≫ awayι ℬ b hb hd :=
  (segreAffineOpenCover 𝒜 ℬ).openCover.ι_glueMorphisms _ _ ⟨⟨d, hd⟩, ⟨a, ha⟩, ⟨b, hb⟩⟩

/-- `segreFst` commutes with the coefficient structure morphisms to `Spec R`. -/
@[reassoc (attr := simp)]
theorem segreFst_toSpecCoeff :
    segreFst 𝒜 ℬ ≫ toSpecCoeff 𝒜 = toSpecCoeff (Segre.grading 𝒜 ℬ) := by
  refine (segreAffineOpenCover 𝒜 ℬ).openCover.hom_ext _ _ fun i ↦ ?_
  dsimp only [segreAffineOpenCover, affineOpenCoverOfIrrelevantLESpan,
    Scheme.AffineOpenCover.openCover, Scheme.AffineCover.cover] at i ⊢
  rcases i with ⟨d, ⟨a, ha⟩, ⟨b, hb⟩⟩
  rw [awayι_segreFst_assoc, awayι_toSpecCoeff, awayι_toSpecCoeff, ← Spec.map_comp,
    ← CommRingCat.ofHom_comp]
  congr 2
  exact (Away.segreFst ha hb).comp_algebraMap

/-- `segreSnd` commutes with the coefficient structure morphisms to `Spec R`. -/
@[reassoc (attr := simp)]
theorem segreSnd_toSpecCoeff :
    segreSnd 𝒜 ℬ ≫ toSpecCoeff ℬ = toSpecCoeff (Segre.grading 𝒜 ℬ) := by
  refine (segreAffineOpenCover 𝒜 ℬ).openCover.hom_ext _ _ fun i ↦ ?_
  dsimp only [segreAffineOpenCover, affineOpenCoverOfIrrelevantLESpan,
    Scheme.AffineOpenCover.openCover, Scheme.AffineCover.cover] at i ⊢
  rcases i with ⟨d, ⟨a, ha⟩, ⟨b, hb⟩⟩
  rw [awayι_segreSnd_assoc, awayι_toSpecCoeff, awayι_toSpecCoeff, ← Spec.map_comp,
    ← CommRingCat.ofHom_comp]
  congr 2
  exact (Away.segreSnd ha hb).comp_algebraMap

/-- For homogeneous elements `a ∈ 𝒜 d` and `b ∈ ℬ d` of the same positive degree `d`, the
intersection of the preimages of `D₊(a)` and `D₊(b)` along the two Segre projections is the
standard open `D₊(a ⊗ₜ b)`. -/
theorem segreFst_preimage_basicOpen_inf_segreSnd_preimage_basicOpen
    {d : ℕ} {a : A} {b : B} (ha : a ∈ 𝒜 d) (hb : b ∈ ℬ d) (hd : 0 < d) :
    segreFst 𝒜 ℬ ⁻¹ᵁ basicOpen 𝒜 a ⊓ segreSnd 𝒜 ℬ ⁻¹ᵁ basicOpen ℬ b =
      basicOpen (Segre.grading 𝒜 ℬ) (Segre.tmul ha hb) := by
  ext x
  obtain ⟨⟨e, ⟨a₀, ha₀⟩, ⟨b₀, hb₀⟩⟩, hx⟩ := TopologicalSpace.Opens.mem_iSup.mp
    ((iSup_basicOpen_eq_top (Segre.grading 𝒜 ℬ) _
      (irrelevant_segre_le_span 𝒜 ℬ)).ge (Set.mem_univ x))
  set j := awayι (Segre.grading 𝒜 ℬ) (Segre.tmul ha₀ hb₀) (Segre.tmul_mem_grading ha₀ hb₀) e.pos
  obtain ⟨y, rfl⟩ : x ∈ j.opensRange := by rwa [opensRange_awayι]
  have hleft : j y ∈ segreFst 𝒜 ℬ ⁻¹ᵁ basicOpen 𝒜 a ↔
      y ∈ (PrimeSpectrum.basicOpen
        (Away.segreFst ha₀ hb₀ (Away.isLocalizationElem ha₀ ha)) : (Spec _).Opens) := by
    rw [← j.mem_preimage, ← Scheme.Hom.comp_preimage, awayι_segreFst, Scheme.Hom.comp_preimage,
      awayι_preimage_basicOpen 𝒜 ha₀ e.pos ha hd, SpecMap_preimage_basicOpen]
    rfl
  have hright : j y ∈ segreSnd 𝒜 ℬ ⁻¹ᵁ basicOpen ℬ b ↔
      y ∈ (PrimeSpectrum.basicOpen
        (Away.segreSnd ha₀ hb₀ (Away.isLocalizationElem hb₀ hb)) : (Spec _).Opens) := by
    rw [← j.mem_preimage, ← Scheme.Hom.comp_preimage, awayι_segreSnd, Scheme.Hom.comp_preimage,
      awayι_preimage_basicOpen ℬ hb₀ e.pos hb hd, SpecMap_preimage_basicOpen]
    rfl
  have hrhs : j y ∈ basicOpen (Segre.grading 𝒜 ℬ) (Segre.tmul ha hb) ↔
      y ∈ (PrimeSpectrum.basicOpen
        (Away.isLocalizationElem (Segre.tmul_mem_grading ha₀ hb₀)
          (Segre.tmul_mem_grading ha hb)) : (Spec _).Opens) := by
    rw [← j.mem_preimage, awayι_preimage_basicOpen (Segre.grading 𝒜 ℬ)
      (Segre.tmul_mem_grading ha₀ hb₀) e.pos (Segre.tmul_mem_grading ha hb) hd]
    rfl
  rw [SetLike.mem_coe, SetLike.mem_coe, TopologicalSpace.Opens.mem_inf, hleft, hright, hrhs,
    ← Away.segreFst_isLocalizationElem_mul_segreSnd_isLocalizationElem ha₀ hb₀ ha hb,
    PrimeSpectrum.basicOpen_mul (R := Away (Segre.grading 𝒜 ℬ) (Segre.tmul ha₀ hb₀))]
  exact Iff.rfl

/-- The canonical comparison morphism from `Proj (Segre.grading 𝒜 ℬ)` to the scheme-theoretic
fibre product `Proj 𝒜 ×_{Spec R} Proj ℬ`. -/
noncomputable def segreToPullback :
    Proj (Segre.grading 𝒜 ℬ) ⟶ pullback (toSpecCoeff 𝒜) (toSpecCoeff ℬ) :=
  pullback.lift (segreFst 𝒜 ℬ) (segreSnd 𝒜 ℬ)
    ((segreFst_toSpecCoeff 𝒜 ℬ).trans (segreSnd_toSpecCoeff 𝒜 ℬ).symm)

@[reassoc (attr := simp)]
theorem segreToPullback_fst :
    segreToPullback 𝒜 ℬ ≫ pullback.fst _ _ = segreFst 𝒜 ℬ :=
  pullback.lift_fst _ _ _

@[reassoc (attr := simp)]
theorem segreToPullback_snd :
    segreToPullback 𝒜 ℬ ≫ pullback.snd _ _ = segreSnd 𝒜 ℬ :=
  pullback.lift_snd _ _ _

private theorem iSup_segreTargetChart_eq_top :
    (⨆ i : SegreChartIdx 𝒜 ℬ,
      pullback.fst (toSpecCoeff 𝒜) (toSpecCoeff ℬ) ⁻¹ᵁ basicOpen 𝒜 i.2.1.1 ⊓
        pullback.snd (toSpecCoeff 𝒜) (toSpecCoeff ℬ) ⁻¹ᵁ basicOpen ℬ i.2.2.1) = ⊤ := by
  refine top_unique fun z _ ↦ ?_
  obtain ⟨d₁, hd₁, a₁, ha₁, hxa₁⟩ :=
    (pullback.fst (toSpecCoeff 𝒜) (toSpecCoeff ℬ) z).exists_le_mem_notMem 1
  obtain ⟨d₂, hd₂, b₂, hb₂, hyb₂⟩ :=
    (pullback.snd (toSpecCoeff 𝒜) (toSpecCoeff ℬ) z).exists_le_mem_notMem 1
  have hd : 0 < d₁ * d₂ := Nat.mul_pos hd₁ hd₂
  have ha : a₁ ^ d₂ ∈ 𝒜 (d₁ * d₂) := by
    simpa only [smul_eq_mul, mul_comm d₂ d₁] using SetLike.pow_mem_graded d₂ ha₁
  have hb : b₂ ^ d₁ ∈ ℬ (d₁ * d₂) := by
    simpa only [smul_eq_mul] using SetLike.pow_mem_graded d₁ hb₂
  refine TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨⟨d₁ * d₂, hd⟩, ⟨a₁ ^ d₂, ha⟩, ⟨b₂ ^ d₁, hb⟩⟩, ?_⟩
  rw [TopologicalSpace.Opens.mem_inf, basicOpen_pow 𝒜 a₁ d₂ hd₂, basicOpen_pow ℬ b₂ d₁ hd₁]
  exact ⟨hxa₁, hyb₂⟩

private noncomputable def segreTargetChartIso {d : ℕ} {a : A} {b : B}
    (ha : a ∈ 𝒜 d) (hb : b ∈ ℬ d) (hd : 0 < d) :
    (pullback.fst (toSpecCoeff 𝒜) (toSpecCoeff ℬ) ⁻¹ᵁ basicOpen 𝒜 a ⊓
      pullback.snd (toSpecCoeff 𝒜) (toSpecCoeff ℬ) ⁻¹ᵁ basicOpen ℬ b).toScheme ≅
    Spec (.of (Away 𝒜 a ⊗[R] Away ℬ b)) :=
  let W : (pullback (toSpecCoeff 𝒜) (toSpecCoeff ℬ)).Opens :=
    pullback.fst (toSpecCoeff 𝒜) (toSpecCoeff ℬ) ⁻¹ᵁ basicOpen 𝒜 a ⊓
      pullback.snd (toSpecCoeff 𝒜) (toSpecCoeff ℬ) ⁻¹ᵁ basicOpen ℬ b
  let j_tgt : pullback (awayι 𝒜 a ha hd ≫ toSpecCoeff 𝒜)
      (awayι ℬ b hb hd ≫ toSpecCoeff ℬ) ⟶ pullback (toSpecCoeff 𝒜) (toSpecCoeff ℬ) :=
    pullback.map _ _ (toSpecCoeff 𝒜) (toSpecCoeff ℬ) (awayι 𝒜 a ha hd) (awayι ℬ b hb hd)
      (𝟙 _) (Category.comp_id _) (Category.comp_id _)
  have hrange : Set.range j_tgt = Set.range W.ι := by
    rw [Scheme.Opens.range_ι, Scheme.Pullback.range_map, ← Scheme.Hom.coe_opensRange,
      ← Scheme.Hom.coe_opensRange, opensRange_awayι, opensRange_awayι]
    rfl
  (IsOpenImmersion.isoOfRangeEq j_tgt W.ι hrange).symm ≪≫
    pullback.congrHom (awayι_toSpecCoeff 𝒜 ha hd) (awayι_toSpecCoeff ℬ hb hd) ≪≫
    pullbackSpecIso R (Away 𝒜 a) (Away ℬ b)

private theorem segreTargetChartIso_inv_ι_fst {d : ℕ} {a : A} {b : B}
    (ha : a ∈ 𝒜 d) (hb : b ∈ ℬ d) (hd : 0 < d) :
    (segreTargetChartIso 𝒜 ℬ ha hb hd).inv ≫
      (pullback.fst (toSpecCoeff 𝒜) (toSpecCoeff ℬ) ⁻¹ᵁ basicOpen 𝒜 a ⊓
        pullback.snd (toSpecCoeff 𝒜) (toSpecCoeff ℬ) ⁻¹ᵁ basicOpen ℬ b).ι ≫
      pullback.fst (toSpecCoeff 𝒜) (toSpecCoeff ℬ) =
    Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) ≫
      awayι 𝒜 a ha hd := by
  rw [segreTargetChartIso, Iso.trans_inv, Iso.trans_inv, Iso.symm_inv, Category.assoc,
    Category.assoc, IsOpenImmersion.isoOfRangeEq_hom_fac_assoc, pullback.lift_fst,
    pullback.congrHom_inv, pullback.lift_fst_assoc, Category.comp_id,
    pullbackSpecIso_inv_fst_assoc]

private theorem segreTargetChartIso_inv_ι_snd {d : ℕ} {a : A} {b : B}
    (ha : a ∈ 𝒜 d) (hb : b ∈ ℬ d) (hd : 0 < d) :
    (segreTargetChartIso 𝒜 ℬ ha hb hd).inv ≫
      (pullback.fst (toSpecCoeff 𝒜) (toSpecCoeff ℬ) ⁻¹ᵁ basicOpen 𝒜 a ⊓
        pullback.snd (toSpecCoeff 𝒜) (toSpecCoeff ℬ) ⁻¹ᵁ basicOpen ℬ b).ι ≫
      pullback.snd (toSpecCoeff 𝒜) (toSpecCoeff ℬ) =
    Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom) ≫
      awayι ℬ b hb hd := by
  rw [segreTargetChartIso, Iso.trans_inv, Iso.trans_inv, Iso.symm_inv, Category.assoc,
    Category.assoc, IsOpenImmersion.isoOfRangeEq_hom_fac_assoc, pullback.lift_snd,
    pullback.congrHom_inv, pullback.lift_snd_assoc, Category.comp_id,
    pullbackSpecIso_inv_snd_assoc, AlgHom.toRingHom_eq_coe]

private theorem isIso_segreToPullback_resLE (i : SegreChartIdx 𝒜 ℬ) :
    IsIso ((segreToPullback 𝒜 ℬ) ∣_
      (pullback.fst (toSpecCoeff 𝒜) (toSpecCoeff ℬ) ⁻¹ᵁ basicOpen 𝒜 i.2.1.1 ⊓
        pullback.snd (toSpecCoeff 𝒜) (toSpecCoeff ℬ) ⁻¹ᵁ basicOpen ℬ i.2.2.1)) := by
  rcases i with ⟨d, ⟨a, ha⟩, ⟨b, hb⟩⟩
  set W : (pullback (toSpecCoeff 𝒜) (toSpecCoeff ℬ)).Opens :=
    pullback.fst (toSpecCoeff 𝒜) (toSpecCoeff ℬ) ⁻¹ᵁ basicOpen 𝒜 a ⊓
      pullback.snd (toSpecCoeff 𝒜) (toSpecCoeff ℬ) ⁻¹ᵁ basicOpen ℬ b
  have hpre : segreToPullback 𝒜 ℬ ⁻¹ᵁ W =
      basicOpen (Segre.grading 𝒜 ℬ) (Segre.tmul ha hb) := by
    rw [Scheme.Hom.preimage_inf, ← Scheme.Hom.comp_preimage, ← Scheme.Hom.comp_preimage,
      segreToPullback_fst, segreToPullback_snd,
      segreFst_preimage_basicOpen_inf_segreSnd_preimage_basicOpen 𝒜 ℬ ha hb d.pos]
  rw [← Scheme.Hom.resLE_eq_morphismRestrict, ← MorphismProperty.isomorphisms.iff,
    Scheme.Hom.resLE_congr (e₁ := rfl) (e₂ := hpre) (P := MorphismProperty.isomorphisms Scheme),
    MorphismProperty.isomorphisms.iff]
  let e_tgt := segreTargetChartIso 𝒜 ℬ ha hb d.pos
  let e_src := basicOpenIsoSpec (Segre.grading 𝒜 ℬ) (Segre.tmul ha hb)
    (Segre.tmul_mem_grading ha hb) d.pos
  have hchart : e_src.inv ≫ (segreToPullback 𝒜 ℬ).resLE W _ hpre.ge =
      Spec.map (Away.segreEquiv ha hb).toRingEquiv.toCommRingCatIso.hom ≫ e_tgt.inv := by
    rw [← cancel_mono W.ι, Category.assoc, Category.assoc, Scheme.Hom.resLE_comp_ι]
    dsimp only [e_src, e_tgt, W]
    rw [basicOpenIsoSpec_inv_ι_assoc]
    refine pullback.hom_ext ?_ ?_
    · rw [Category.assoc, Category.assoc, Category.assoc, segreToPullback_fst, awayι_segreFst,
        segreTargetChartIso_inv_ι_fst, RingEquiv.toCommRingCatIso_hom,
        AlgEquiv.toRingEquiv_toRingHom, ← Spec.map_comp_assoc, ← CommRingCat.ofHom_comp]
      congr 3
      ext u
      simp [Algebra.TensorProduct.includeLeftRingHom]
    · rw [Category.assoc, Category.assoc, Category.assoc, segreToPullback_snd, awayι_segreSnd,
        segreTargetChartIso_inv_ι_snd, RingEquiv.toCommRingCatIso_hom,
        AlgEquiv.toRingEquiv_toRingHom, ← Spec.map_comp_assoc, ← CommRingCat.ofHom_comp]
      congr 3
      ext v
      simp
  have hiso : IsIso (e_src.inv ≫ (segreToPullback 𝒜 ℬ).resLE W _ hpre.ge) := by
    rw [hchart]
    infer_instance
  exact IsIso.of_isIso_comp_left e_src.inv _

/-- `segreToPullback 𝒜 ℬ` is an isomorphism of schemes. -/
instance isIso_segreToPullback : IsIso (segreToPullback 𝒜 ℬ) := by
  rw [← MorphismProperty.isomorphisms.iff]
  refine IsZariskiLocalAtTarget.of_iSup_eq_top (P := MorphismProperty.isomorphisms Scheme) _
    (iSup_segreTargetChart_eq_top 𝒜 ℬ) fun i ↦ ?_
  rw [MorphismProperty.isomorphisms.iff]
  exact isIso_segreToPullback_resLE 𝒜 ℬ i

/-- **The Segre isomorphism of projective spectra**: for arbitrary `ℕ`-graded `R`-algebras `A`
and `B`, `Proj (Segre.grading 𝒜 ℬ)` is canonically isomorphic to the scheme-theoretic fibre product
`Proj 𝒜 ×_{Spec R} Proj ℬ`. -/
noncomputable def segreIso :
    Proj (Segre.grading 𝒜 ℬ) ≅ pullback (toSpecCoeff 𝒜) (toSpecCoeff ℬ) :=
  asIso (segreToPullback 𝒜 ℬ)

@[reassoc (attr := simp)]
theorem segreIso_hom_fst :
    (segreIso 𝒜 ℬ).hom ≫ pullback.fst _ _ = segreFst 𝒜 ℬ :=
  segreToPullback_fst 𝒜 ℬ

@[reassoc (attr := simp)]
theorem segreIso_hom_snd :
    (segreIso 𝒜 ℬ).hom ≫ pullback.snd _ _ = segreSnd 𝒜 ℬ :=
  segreToPullback_snd 𝒜 ℬ

@[reassoc (attr := simp)]
theorem segreIso_inv_segreFst :
    (segreIso 𝒜 ℬ).inv ≫ segreFst 𝒜 ℬ = pullback.fst _ _ := by
  rw [← segreIso_hom_fst 𝒜 ℬ, Iso.inv_hom_id_assoc]

@[reassoc (attr := simp)]
theorem segreIso_inv_segreSnd :
    (segreIso 𝒜 ℬ).inv ≫ segreSnd 𝒜 ℬ = pullback.snd _ _ := by
  rw [← segreIso_hom_snd 𝒜 ℬ, Iso.inv_hom_id_assoc]

/-- **Cartesian square of the Segre product**: `Proj (Segre.grading 𝒜 ℬ)` with `segreFst` and
`segreSnd` is the pullback of `toSpecCoeff 𝒜` and `toSpecCoeff ℬ`. -/
theorem isPullback_segre :
    IsPullback (segreFst 𝒜 ℬ) (segreSnd 𝒜 ℬ) (toSpecCoeff 𝒜) (toSpecCoeff ℬ) :=
  IsPullback.of_iso_pullback
    ⟨(segreFst_toSpecCoeff 𝒜 ℬ).trans (segreSnd_toSpecCoeff 𝒜 ℬ).symm⟩
    (segreIso 𝒜 ℬ) (segreIso_hom_fst 𝒜 ℬ) (segreIso_hom_snd 𝒜 ℬ)

end SegrePullback

section ClosedImmersionSymmetricAlgebra

/-- If `f : M →ₗ[R] 𝒜 1` generates `𝒜` in positive degrees over `R`, the induced closed immersion
`Proj 𝒜 ⟶ Proj (Sym_R M)` commutes with the coefficient morphisms to `Spec R`. -/
theorem map_gradedLift_projToSpec {R M A : Type u} [CommRing R] [AddCommMonoid M] [Module R M]
    [CommRing A] [Algebra R A] (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜] {f : M →ₗ[R] 𝒜 1}
    (hf : ∀ i, 0 < i → (𝒜 i : Set A) ⊆ Algebra.adjoin R (Set.range fun m ↦ (f m : A))) :
    map (SymmetricAlgebra.gradedLift R 𝒜 f)
        (HomogeneousIdeal.irrelevant_le_map_of_grade_subset_range _ fun i hi ↦
          (hf i hi).trans (SymmetricAlgebra.adjoin_range_subset_range_gradedLift R 𝒜 f)) ≫
      TauCeti.SymmetricAlgebra.projToSpec R M = toSpecCoeff 𝒜 := by
  rw [← toSpecCoeff_homogeneousSubmodule]
  exact map_toSpecCoeff _ _ _ (SymmetricAlgebra.gradedLift_gradedZeroRingHom_algebraMap R 𝒜 f)

end ClosedImmersionSymmetricAlgebra

end AlgebraicGeometry.Proj

/-! ### Permanence of `Scheme.IsProjectiveOver` -/

namespace AlgebraicGeometry.Scheme

universe u

private theorem pullback_map_isClosedImmersion {X Y S X' Y' S' : Scheme.{u}}
    (f : X ⟶ S) (g : Y ⟶ S) (f' : X' ⟶ S') (g' : Y' ⟶ S')
    (i₁ : X ⟶ X') (i₂ : Y ⟶ Y') (i₃ : S ⟶ S') (e₁ : f ≫ i₃ = i₁ ≫ f') (e₂ : g ≫ i₃ = i₂ ≫ g')
    [IsClosedImmersion i₁] [IsClosedImmersion i₂] [Mono i₃] :
    IsClosedImmersion (pullback.map f g f' g' i₁ i₂ i₃ e₁ e₂) := by
  rw [pullback_map_eq_pullbackFstFstIso_inv]
  infer_instance

/-- **Projectivity criterion for `Proj`**: if `(Proj 𝒜).Over (Spec (.of R))` has structure morphism
`Proj.toSpecCoeff 𝒜` and a linear map `f : M →ₗ[R] 𝒜 1` from a finite `R`-module `M` generates `𝒜`
in positive degrees over `R`, then `Proj 𝒜` is projective over `R`. -/
theorem IsProjectiveOver.of_proj {R M A : Type u} [CommRing R] [AddCommMonoid M] [Module R M]
    [Module.Finite R M] [CommRing A] [Algebra R A] (𝒜 : ℕ → Submodule R A) [GradedAlgebra 𝒜]
    [(Proj 𝒜).Over (Spec (.of R))] (hover : (Proj 𝒜 ↘ Spec (.of R)) = Proj.toSpecCoeff 𝒜)
    (f : M →ₗ[R] 𝒜 1)
    (hf : ∀ i, 0 < i → (𝒜 i : Set A) ⊆ Algebra.adjoin R (Set.range fun m ↦ (f m : A))) :
    (Proj 𝒜).IsProjectiveOver R := by
  let g : Proj 𝒜 ⟶ Proj (TauCeti.SymmetricAlgebra.homogeneousSubmodule R M) :=
    Proj.map (SymmetricAlgebra.gradedLift R 𝒜 f)
      (HomogeneousIdeal.irrelevant_le_map_of_grade_subset_range _ fun i hi ↦
        (hf i hi).trans (SymmetricAlgebra.adjoin_range_subset_range_gradedLift R 𝒜 f))
  have hg_closed : IsClosedImmersion g := Proj.isClosedImmersion_map_gradedLift 𝒜 hf
  have hg_over : g.IsOver (Spec (.of R)) := by
    refine ⟨?_⟩
    rw [TauCeti.SymmetricAlgebra.over_eq_projToSpec, hover]
    exact Proj.map_gradedLift_projToSpec 𝒜 hf
  exact ⟨⟨M, inferInstance, inferInstance, inferInstance, g, hg_closed, hg_over⟩⟩

/-- The affine base `Spec R` is projective over `R` (`Spec R ≅ Proj R[T]`). -/
instance isProjectiveOver_spec (R : Type u) [CommRing R] : (Spec (.of R)).IsProjectiveOver R := by
  let 𝒜 := TauCeti.SymmetricAlgebra.homogeneousSubmodule R R
  let φ : SymmetricAlgebra R R →ₐ[R] R := SymmetricAlgebra.lift LinearMap.id
  let t : SymmetricAlgebra R R := SymmetricAlgebra.ι R R (1 : R)
  have ht : t ∈ 𝒜 1 := TauCeti.SymmetricAlgebra.ι_mem_homogeneousSubmodule R R 1
  have hunit : IsUnit (φ.toRingHom t) := by simp [φ, t]
  let s : Spec (.of R) ⟶ Proj 𝒜 :=
    Spec.map (CommRingCat.ofHom (Away.lift 𝒜 φ.toRingHom hunit)) ≫ Proj.awayι 𝒜 t ht one_pos
  have hs : s ≫ (Proj 𝒜 ↘ Spec (.of R)) = 𝟙 (Spec (.of R)) := by
    rw [TauCeti.SymmetricAlgebra.over_eq_projToSpec]
    dsimp only [s]
    rw [Category.assoc, TauCeti.SymmetricAlgebra.awayι_projToSpec, ← Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← Spec.map_id]
    congr 2
    ext r
    simp only [RingHom.comp_apply, RingHom.id_apply]
    -- `fromZeroRingHom` is the structure map `algebraMap (𝒜 0) (Away 𝒜 t)`.
    change Away.lift 𝒜 φ.toRingHom hunit (algebraMap (𝒜 0) (Away 𝒜 t) (algebraMap R (𝒜 0) r)) = r
    rw [Away.lift_algebraMap]
    simp [φ]
  have hs_over : s.IsOver (Spec (.of R)) := ⟨hs⟩
  have hs_comp : IsClosedImmersion (s ≫ (Proj 𝒜 ↘ Spec (.of R))) := by
    rw [hs]
    infer_instance
  have hs_closed : IsClosedImmersion s := IsClosedImmersion.of_comp s (Proj 𝒜 ↘ Spec (.of R))
  exact IsProjectiveOver.of_isClosedImmersion R s

private theorem homogeneousSubmodule_subset_adjoin_range_ι (R M : Type u) [CommRing R]
    [AddCommMonoid M] [Module R M] :
    ∀ i, 0 < i →
      (TauCeti.SymmetricAlgebra.homogeneousSubmodule R M i : Set (SymmetricAlgebra R M)) ⊆
        Algebra.adjoin R (Set.range fun m ↦
          (((SymmetricAlgebra.ι R M).codRestrict
            (TauCeti.SymmetricAlgebra.homogeneousSubmodule R M 1)
            (TauCeti.SymmetricAlgebra.ι_mem_homogeneousSubmodule R M) m :
              TauCeti.SymmetricAlgebra.homogeneousSubmodule R M 1) : SymmetricAlgebra R M)) := by
  intro _ _ _ _
  have hrange : (Set.range fun m ↦
      (((SymmetricAlgebra.ι R M).codRestrict
        (TauCeti.SymmetricAlgebra.homogeneousSubmodule R M 1)
        (TauCeti.SymmetricAlgebra.ι_mem_homogeneousSubmodule R M) m :
          TauCeti.SymmetricAlgebra.homogeneousSubmodule R M 1) : SymmetricAlgebra R M)) =
      Set.range (SymmetricAlgebra.ι R M) := rfl
  rw [hrange, SymmetricAlgebra.adjoin_range_ι]
  exact Algebra.mem_top

/-- **Segre embedding for projective schemes**: the fibre product over `Spec R` of two projective
schemes over `R` is projective over `R`. -/
instance IsProjectiveOver.pullback {R : Type u} [CommRing R] {X Y : Scheme.{u}}
    [X.Over (Spec (.of R))] [Y.Over (Spec (.of R))]
    [X.IsProjectiveOver R] [Y.IsProjectiveOver R] :
    (Limits.pullback (X ↘ Spec (.of R)) (Y ↘ Spec (.of R))).IsProjectiveOver R := by
  obtain ⟨M, _, _, _, fX, hfX, hfXR⟩ := IsProjectiveOver.exists_isClosedImmersion (R := R) (X := X)
  obtain ⟨N, _, _, _, fY, hfY, hfYR⟩ := IsProjectiveOver.exists_isClosedImmersion (R := R) (X := Y)
  let 𝒜 := TauCeti.SymmetricAlgebra.homogeneousSubmodule R M
  let ℬ := TauCeti.SymmetricAlgebra.homogeneousSubmodule R N
  let ιM : M →ₗ[R] 𝒜 1 := (SymmetricAlgebra.ι R M).codRestrict (𝒜 1)
    (TauCeti.SymmetricAlgebra.ι_mem_homogeneousSubmodule R M)
  let ιN : N →ₗ[R] ℬ 1 := (SymmetricAlgebra.ι R N).codRestrict (ℬ 1)
    (TauCeti.SymmetricAlgebra.ι_mem_homogeneousSubmodule R N)
  have hMN := Segre.grading_subset_adjoin_range_linearMap (f := ιM) (g := ιN)
    (homogeneousSubmodule_subset_adjoin_range_ι R M)
    (homogeneousSubmodule_subset_adjoin_range_ι R N)
  let gSegre : Proj (Segre.grading 𝒜 ℬ) ⟶
      Proj (TauCeti.SymmetricAlgebra.homogeneousSubmodule R (M ⊗[R] N)) :=
    Proj.map (SymmetricAlgebra.gradedLift R (Segre.grading 𝒜 ℬ) (Segre.linearMap ιM ιN))
      (HomogeneousIdeal.irrelevant_le_map_of_grade_subset_range _ fun i hi ↦
        (hMN i hi).trans (SymmetricAlgebra.adjoin_range_subset_range_gradedLift R _ _))
  have hgSegre_closed : IsClosedImmersion gSegre :=
    Proj.isClosedImmersion_map_gradedLift (Segre.grading 𝒜 ℬ) hMN
  have heX : (X ↘ Spec (.of R)) ≫ 𝟙 _ = fX ≫ Proj.toSpecCoeff 𝒜 := by
    rw [Category.comp_id, Proj.toSpecCoeff_homogeneousSubmodule,
      ← TauCeti.SymmetricAlgebra.over_eq_projToSpec, comp_over fX (Spec (.of R))]
  have heY : (Y ↘ Spec (.of R)) ≫ 𝟙 _ = fY ≫ Proj.toSpecCoeff ℬ := by
    rw [Category.comp_id, Proj.toSpecCoeff_homogeneousSubmodule,
      ← TauCeti.SymmetricAlgebra.over_eq_projToSpec, comp_over fY (Spec (.of R))]
  let pMap := Limits.pullback.map (X ↘ Spec (.of R)) (Y ↘ Spec (.of R))
    (Proj.toSpecCoeff 𝒜) (Proj.toSpecCoeff ℬ) fX fY (𝟙 _) heX heY
  have hpMap_closed : IsClosedImmersion pMap :=
    pullback_map_isClosedImmersion _ _ _ _ fX fY (𝟙 _) heX heY
  let emb := pMap ≫ (Proj.segreIso 𝒜 ℬ).inv ≫ gSegre
  have hemb_over : emb.IsOver (Spec (.of R)) := by
    refine ⟨?_⟩
    dsimp only [emb, gSegre, pMap]
    rw [TauCeti.SymmetricAlgebra.over_eq_projToSpec, Category.assoc, Category.assoc,
      Proj.map_gradedLift_projToSpec (Segre.grading 𝒜 ℬ) hMN, ← Proj.segreSnd_toSpecCoeff 𝒜 ℬ,
      Proj.segreIso_inv_segreSnd_assoc, Limits.pullback.lift_snd_assoc, Category.assoc, ← heY,
      Category.comp_id]
    rfl
  exact ⟨⟨M ⊗[R] N, inferInstance, inferInstance, inferInstance, emb, inferInstance, hemb_over⟩⟩

end AlgebraicGeometry.Scheme

namespace HomogeneousIdeal

attribute [local instance] MvPolynomial.gradedAlgebra

universe u

/-- **`Proj` of a quotient of a polynomial ring by a homogeneous ideal is projective.** -/
instance {R : Type u} [CommRing R] {n : ℕ}
    (I : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) R)) :
    (AlgebraicGeometry.Proj I.quotientGrading).IsProjectiveOver R := by
  classical
  let v : Fin (n + 1) → I.quotientGrading 1 := fun j ↦
    ⟨Ideal.Quotient.mk I.toIdeal (MvPolynomial.X j), I.mk_X_mem_quotientGrading j⟩
  let f : (Fin (n + 1) → R) →ₗ[R] I.quotientGrading 1 :=
    LinearMap.lsum R (fun _ : Fin (n + 1) ↦ R) R fun j ↦
      LinearMap.toSpanSingleton R (I.quotientGrading 1) (v j)
  refine AlgebraicGeometry.Scheme.IsProjectiveOver.of_proj I.quotientGrading
    I.over_proj_quotientGrading f fun _ _ q _ ↦ ?_
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective q
  have hp : p ∈ Algebra.adjoin R (Set.range (MvPolynomial.X : Fin (n + 1) → _)) := by
    rw [MvPolynomial.adjoin_range_X]
    exact Algebra.mem_top
  let mkAlg : MvPolynomial (Fin (n + 1)) R →ₐ[R] MvPolynomial (Fin (n + 1)) R ⧸ I.toIdeal :=
    Ideal.Quotient.mkₐ R I.toIdeal
  have hmk : mkAlg p ∈ Algebra.adjoin R
      (mkAlg '' Set.range (MvPolynomial.X : Fin (n + 1) → _)) := by
    rw [← AlgHom.map_adjoin]
    exact ⟨p, hp, rfl⟩
  refine Algebra.adjoin_mono ?_ hmk
  rintro _ ⟨_, ⟨j, rfl⟩, rfl⟩
  refine ⟨Pi.single j 1, ?_⟩
  have hfj : f (Pi.single j 1) = v j := by
    simp [f]
  exact congrArg Subtype.val hfj

end HomogeneousIdeal
