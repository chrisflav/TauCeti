/-!
# The fixed Weyl group of a diagram fold

Let `P` be a root pairing and `σ : P.Aut` an automorphism. The **fixed Weyl group**
`P.fixedWeylGroup σ` is the subgroup of `P.weylGroup` commuting with `σ` in `P.Aut`, equivalently
the fixed-point subgroup of `σ.weylGroupEquiv`. It preserves `LinearMap.fixedSubmodule σ.weightMap`
and permutes `P.foldedIndices σ`.

When `(P, b)` is a finite reduced crystallographic root pairing over a characteristic-zero domain,
`σ` permutes `b.support`, and `F : P.OrbitSumRealization b σ` is an orbit-sum realization:
1. Restriction defines a homomorphism `F.restrictFixedWeylAut : P.fixedWeylGroup σ →* F.pairing.Aut`
   whose intersection with `F.base.basedAut` is trivial
   (`RootPairing.OrbitSumRealization.eq_one_of_restrictFixedWeylAut_mem_basedAut`), making
   `F.restrictFixedWeylAut` injective before any orthogonality assumption.
2. Combining `F.pairing.Aut ≃ F.pairing.weylGroup ⋊ F.base.basedAut` with injectivity gives
   Stembridge's simple-lift criterion
   (`RootPairing.OrbitSumRealization.fixedWeylGroupMulEquivOfSimpleLift`): whenever every simple
   folded reflection lifts to `P.fixedWeylGroup σ`, restriction induces
   `P.fixedWeylGroup σ ≃* F.pairing.weylGroup`.
3. Under simple-orbit orthogonality, `RootPairing.fixedOrbitBlockReflection` supplies these lifts
   (`RootPairing.OrbitSumRealization.fixedWeylGroupMulEquiv`), and simple-inversion descent shows
   over any characteristic-zero domain that `P.fixedWeylGroup σ` is generated by the simple-orbit
   block reflections (`RootPairing.fixedWeylGroup_eq_closure_fixedOrbitBlockReflection`).

## Main definitions

* `RootPairing.fixedWeylGroup` and `RootPairing.fixedOrbitBlockReflection`: the subgroup of
  `P.weylGroup` commuting with `σ`, and the bundled block reflection across an orthogonal `σ`-orbit.
* `RootPairing.OrbitSumRealization.restrictFixedWeylAut`,
  `RootPairing.OrbitSumRealization.fixedWeylGroupMulEquivOfSimpleLift`, and
  `RootPairing.OrbitSumRealization.fixedWeylGroupMulEquiv`: restriction to `F.pairing.Aut` and the
  resulting isomorphisms `P.fixedWeylGroup σ ≃* F.pairing.weylGroup`.

## Main results

* `RootPairing.OrbitSumRealization.restrictFixedWeylAut_injective`,
  `RootPairing.OrbitSumRealization.fixedWeylGroupMulEquiv_symm_ofIdx`, and
  `RootPairing.fixedWeylGroup_eq_closure_fixedOrbitBlockReflection`.

## References

* J. R. Stembridge, *Folding by automorphisms*, note of 20 August 2008, Claim 3 and §2.
-/

public section

namespace RootPairing

open Function Module Set Submodule TauCeti

/-! ### The fixed Weyl subgroup and its actions on fixed weights and orbit sums -/

section FixedWeylGroup

variable {ι R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  (P : RootPairing ι R M N) (σ : P.Aut)

/-- The subgroup of `P.weylGroup` commuting with `σ : P.Aut`, defined as the preimage of the
centralizer of `{σ}` in `P.Aut`. -/
noncomputable def fixedWeylGroup : Subgroup P.weylGroup :=
  (Subgroup.centralizer ({σ} : Set P.Aut)).comap P.weylGroup.subtype

variable {P σ}

theorem mem_fixedWeylGroup_iff {w : P.weylGroup} :
    w ∈ P.fixedWeylGroup σ ↔ (w : P.Aut) * σ = σ * (w : P.Aut) := by
  rw [fixedWeylGroup, Subgroup.mem_comap, Subgroup.coe_subtype,
    Subgroup.mem_centralizer_singleton_iff]

theorem mem_fixedWeylGroup_iff_weylGroupEquiv {w : P.weylGroup} :
    w ∈ P.fixedWeylGroup σ ↔ σ.weylGroupEquiv w = w := by
  have h : (σ.weylGroupEquiv w : P.Aut) = σ * (w : P.Aut) * σ⁻¹ := by
    rw [Equiv.coe_weylGroupEquiv, Equiv.autCongr_apply]; rfl
  rw [mem_fixedWeylGroup_iff, Subtype.ext_iff, h, mul_inv_eq_iff_eq_mul, eq_comm]

theorem weylGroupEquiv_eq_of_mem_fixedWeylGroup {w : P.weylGroup} (hw : w ∈ P.fixedWeylGroup σ) :
    σ.weylGroupEquiv w = w :=
  mem_fixedWeylGroup_iff_weylGroupEquiv.mp hw

@[simp]
theorem fixedWeylGroup_one : P.fixedWeylGroup 1 = ⊤ := by ext w; simp [mem_fixedWeylGroup_iff]

theorem smul_mem_fixedSubmodule_of_mem_fixedWeylGroup {w : P.weylGroup}
    (hw : w ∈ P.fixedWeylGroup σ) {x : M} (hx : x ∈ LinearMap.fixedSubmodule σ.weightMap) :
    w • x ∈ LinearMap.fixedSubmodule σ.weightMap := by
  have h : σ • ((w : P.Aut) • x) = (w : P.Aut) • (σ • x) := by
    rw [← mul_smul, ← mul_smul, mem_fixedWeylGroup_iff.mp hw]
  exact LinearMap.mem_fixedSubmodule_iff.mpr
    (h.trans (congrArg ((w : P.Aut) • ·) (LinearMap.mem_fixedSubmodule_iff.mp hx)))

noncomputable instance instDistribMulActionFixedSubmodule :
    DistribMulAction (P.fixedWeylGroup σ) (LinearMap.fixedSubmodule σ.weightMap) where
  smul w x := ⟨(w : P.weylGroup) • (x : M),
    smul_mem_fixedSubmodule_of_mem_fixedWeylGroup w.2 x.2⟩
  one_smul x := Subtype.ext (one_smul P.weylGroup (x : M))
  mul_smul w₁ w₂ x := Subtype.ext (mul_smul (w₁ : P.weylGroup) (w₂ : P.weylGroup) (x : M))
  smul_zero w := Subtype.ext (smul_zero (w : P.weylGroup))
  smul_add w x y := Subtype.ext (smul_add (w : P.weylGroup) (x : M) (y : M))

instance instSMulCommClassFixedSubmodule :
    SMulCommClass (P.fixedWeylGroup σ) R (LinearMap.fixedSubmodule σ.weightMap) where
  smul_comm w r x := Subtype.ext (smul_comm (w : P.weylGroup) r (x : M))

instance instSMulCommClassFixedSubmodule' :
    SMulCommClass R (P.fixedWeylGroup σ) (LinearMap.fixedSubmodule σ.weightMap) :=
  SMulCommClass.symm _ _ _

@[simp]
theorem coe_fixedWeylGroup_smul (w : P.fixedWeylGroup σ)
    (x : LinearMap.fixedSubmodule σ.weightMap) :
    ((w • x : LinearMap.fixedSubmodule σ.weightMap) : M) = (w : P.weylGroup) • (x : M) :=
  rfl

theorem smul_mem_foldedIndices_of_mem_fixedWeylGroup [Finite ι] {w : P.weylGroup}
    (hw : w ∈ P.fixedWeylGroup σ) {v : M} (hv : v ∈ P.foldedIndices σ) :
    w • v ∈ P.foldedIndices σ := by
  obtain ⟨m, rfl⟩ := mem_foldedIndices.mp hv
  rw [smul_orbitSum_of_weylGroupEquiv_eq (weylGroupEquiv_eq_of_mem_fixedWeylGroup hw)]
  exact mem_foldedIndices.mpr ⟨_, rfl⟩

noncomputable instance instMulActionFoldedIndices [Finite ι] :
    MulAction (P.fixedWeylGroup σ) (P.foldedIndices σ) where
  smul w β := ⟨(w : P.weylGroup) • (β : M), smul_mem_foldedIndices_of_mem_fixedWeylGroup w.2 β.2⟩
  one_smul β := Subtype.ext (one_smul P.weylGroup (β : M))
  mul_smul w₁ w₂ β := Subtype.ext (mul_smul (w₁ : P.weylGroup) (w₂ : P.weylGroup) (β : M))

@[simp]
theorem coe_fixedWeylGroup_smul_foldedIndices [Finite ι] (w : P.fixedWeylGroup σ)
    (β : P.foldedIndices σ) :
    ((w • β : P.foldedIndices σ) : M) = (w : P.weylGroup) • (β : M) :=
  rfl

@[simp]
theorem fixedWeylGroup_smul_foldedIndex [Finite ι] (w : P.fixedWeylGroup σ) (m : ι) :
    w • P.foldedIndex σ m = P.foldedIndex σ (P.weylGroupToPerm (w : P.weylGroup) m) :=
  Subtype.ext <| by
    rw [coe_fixedWeylGroup_smul_foldedIndices, coe_foldedIndex, coe_foldedIndex,
      smul_orbitSum_of_weylGroupEquiv_eq (weylGroupEquiv_eq_of_mem_fixedWeylGroup w.2)]

/-- Transporting `fixedWeylGroup` along an equivalence `e : P.Equiv P₂` of root pairings. -/
noncomputable def Equiv.fixedWeylGroupMulEquiv {ι₂ M₂ N₂ : Type*}
    [AddCommGroup M₂] [Module R M₂] [AddCommGroup N₂] [Module R N₂]
    {P₂ : RootPairing ι₂ R M₂ N₂} (e : P.Equiv P₂) (σ : P.Aut) :
    P.fixedWeylGroup σ ≃* P₂.fixedWeylGroup (e.autCongr σ) :=
  (e.weylGroupEquiv.subgroupMap (P.fixedWeylGroup σ)).trans <| MulEquiv.subgroupCongr <| by
    ext u
    refine ⟨?_, fun hu ↦ ⟨e.weylGroupEquiv.symm u, ?_, e.weylGroupEquiv.apply_symm_apply u⟩⟩
    · rintro ⟨w, hw, rfl⟩
      rw [mem_fixedWeylGroup_iff, MonoidHom.coe_ofClass, Equiv.coe_weylGroupEquiv, ← map_mul,
        mem_fixedWeylGroup_iff.mp hw, map_mul]
    · refine mem_fixedWeylGroup_iff.mpr (e.autCongr.injective ?_)
      simpa only [map_mul, ← Equiv.coe_weylGroupEquiv, e.weylGroupEquiv.apply_symm_apply] using
        mem_fixedWeylGroup_iff.mp hu

@[simp]
theorem Equiv.coe_fixedWeylGroupMulEquiv {ι₂ M₂ N₂ : Type*}
    [AddCommGroup M₂] [Module R M₂] [AddCommGroup N₂] [Module R N₂]
    {P₂ : RootPairing ι₂ R M₂ N₂} (e : P.Equiv P₂) (σ : P.Aut) (w : P.fixedWeylGroup σ) :
    (e.fixedWeylGroupMulEquiv σ w : P₂.weylGroup) = e.weylGroupEquiv w := by
  rw [Equiv.fixedWeylGroupMulEquiv]; rfl

end FixedWeylGroup

/-! ### Restriction to an orbit-sum realization and the simple-lift criterion -/

section Restriction

variable {ι R M N : Type*} [CommRing R] [CharZero R] [IsDomain R]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  {P : RootPairing ι R M N} [Finite ι] {b : P.Base} {σ : P.Aut}

namespace OrbitSumRealization

variable (F : P.OrbitSumRealization b σ)

/-- Restriction of `P.fixedWeylGroup σ` to automorphisms of `F.pairing` on
`LinearMap.fixedSubmodule σ.weightMap`. -/
noncomputable def restrictFixedWeylAut : P.fixedWeylGroup σ →* F.pairing.Aut where
  toFun w :=
    have : IsReflexive R (LinearMap.fixedSubmodule σ.weightMap) :=
      .of_isPerfPair F.pairing.toLinearMap
    Equiv.mk' F.pairing F.pairing
      (DistribMulAction.toLinearEquiv R (LinearMap.fixedSubmodule σ.weightMap) w)
      (MulAction.toPerm w) fun β ↦ Subtype.ext (by
        rw [DistribMulAction.toLinearEquiv_apply, coe_fixedWeylGroup_smul, F.root_eq, F.root_eq,
          MulAction.toPerm_apply, coe_fixedWeylGroup_smul_foldedIndices])
  map_one' := Equiv.weightHom_injective F.pairing
    (LinearEquiv.ext fun x ↦ one_smul (P.fixedWeylGroup σ) x)
  map_mul' w₁ w₂ := Equiv.weightHom_injective F.pairing
    (LinearEquiv.ext fun x ↦ mul_smul w₁ w₂ x)

@[simp]
theorem restrictFixedWeylAut_smul (w : P.fixedWeylGroup σ)
    (x : LinearMap.fixedSubmodule σ.weightMap) :
    F.restrictFixedWeylAut w • x = w • x := by rw [restrictFixedWeylAut]; rfl

theorem coe_restrictFixedWeylAut_smul (w : P.fixedWeylGroup σ)
    (x : LinearMap.fixedSubmodule σ.weightMap) :
    ((F.restrictFixedWeylAut w • x : LinearMap.fixedSubmodule σ.weightMap) : M) =
      (w : P.weylGroup) • (x : M) := by
  rw [restrictFixedWeylAut_smul, coe_fixedWeylGroup_smul]

@[simp]
theorem restrictFixedWeylAut_indexEquiv_apply (w : P.fixedWeylGroup σ) (β : P.foldedIndices σ) :
    (F.restrictFixedWeylAut w).indexEquiv β = w • β := by rw [restrictFixedWeylAut]; rfl

theorem restrictFixedWeylAut_indexEquiv_foldedIndex (w : P.fixedWeylGroup σ) (m : ι) :
    (F.restrictFixedWeylAut w).indexEquiv (P.foldedIndex σ m) =
      P.foldedIndex σ (P.weylGroupToPerm (w : P.weylGroup) m) := by
  rw [restrictFixedWeylAut_indexEquiv_apply, fixedWeylGroup_smul_foldedIndex]

variable [P.IsCrystallographic] [P.IsReduced] (hσ : ∀ i ∈ b.support, σ.indexEquiv i ∈ b.support)
include hσ

/-- An element of `P.fixedWeylGroup σ` whose restriction to `F.pairing.Aut` stabilizes the folded
base `F.base` preserves positivity on `P`, hence is `1`. -/
theorem eq_one_of_restrictFixedWeylAut_mem_basedAut
    {w : P.fixedWeylGroup σ} (hw : F.restrictFixedWeylAut w ∈ F.base.basedAut) : w = 1 :=
  Subtype.ext <| eq_one_of_mapsTo_posRoots (b := b) fun m hm ↦ by
    rw [mem_posRoots] at hm ⊢
    rw [← F.isPos_foldedIndex_iff hσ, ← F.restrictFixedWeylAut_indexEquiv_foldedIndex,
      ← mem_posRoots, ← F.base.image_posRoots_of_mem_basedAut hw]
    exact Set.mem_image_of_mem _ ((mem_posRoots F.pairing F.base _).mpr
      ((F.isPos_foldedIndex_iff hσ m).mpr hm))

/-- Restriction from `P.fixedWeylGroup σ` to `F.pairing.Aut` is injective for any orbit-sum
realization. -/
theorem restrictFixedWeylAut_injective : Function.Injective F.restrictFixedWeylAut := by
  rw [← MonoidHom.ker_eq_bot_iff, Subgroup.eq_bot_iff_forall]
  exact fun w hw ↦ F.eq_one_of_restrictFixedWeylAut_mem_basedAut hσ
    (by rw [MonoidHom.mem_ker.mp hw]; exact one_mem _)

variable (hlift : ∀ i ∈ b.support, ∃ w : P.fixedWeylGroup σ,
    F.restrictFixedWeylAut w = Equiv.reflection F.pairing (P.foldedIndex σ i))
include hlift

/-- Whenever every simple folded reflection of `(F.pairing, F.base)` lifts to `P.fixedWeylGroup σ`,
the image of `F.restrictFixedWeylAut` is `F.pairing.weylGroup`. -/
theorem range_restrictFixedWeylAut_eq_weylGroup :
    F.restrictFixedWeylAut.range = F.pairing.weylGroup := by
  have hle : F.pairing.weylGroup ≤ F.restrictFixedWeylAut.range := by
    have htop : (⊤ : Subgroup F.pairing.weylGroup) ≤
        F.restrictFixedWeylAut.range.comap F.pairing.weylGroup.subtype := by
      rw [weylGroup_eq_closure_simple F.pairing F.base, Subgroup.closure_le, Set.range_subset_iff]
      rintro ⟨β, hβ⟩
      obtain ⟨i, hi, hiβ⟩ := (F.base_eq β).mp hβ
      obtain ⟨w, hw⟩ := hlift i hi
      have hβeq : P.foldedIndex σ i = β := Subtype.ext ((P.coe_foldedIndex σ i).trans hiβ)
      exact ⟨w, hw.trans (by rw [hβeq]; rfl)⟩
    exact fun g hg ↦ htop (trivial : (⟨g, hg⟩ : F.pairing.weylGroup) ∈ ⊤)
  refine le_antisymm ?_ hle
  rintro _ ⟨w, rfl⟩
  let p := F.base.semidirectProductMulEquiv.symm (F.restrictFixedWeylAut w)
  have hp : (p.left : F.pairing.Aut) * (p.right : F.pairing.Aut) = F.restrictFixedWeylAut w :=
    F.base.semidirectProductMulEquiv_symm_left_mul_right (F.restrictFixedWeylAut w)
  obtain ⟨w₀, hw₀⟩ := hle p.left.2
  have heq : F.restrictFixedWeylAut (w₀⁻¹ * w) = (p.right : F.pairing.Aut) := by
    rw [map_mul, map_inv, hw₀, ← hp, inv_mul_cancel_left]
  have hbased : F.restrictFixedWeylAut (w₀⁻¹ * w) ∈ F.base.basedAut := heq.symm ▸ p.right.2
  rw [← inv_mul_eq_one.mp (F.eq_one_of_restrictFixedWeylAut_mem_basedAut hσ hbased), hw₀]
  exact p.left.2

/-- **Stembridge's simple-lift criterion for the fixed Weyl group.** If every simple folded
reflection of `(F.pairing, F.base)` lifts to `P.fixedWeylGroup σ`, restriction induces a group
isomorphism `P.fixedWeylGroup σ ≃* F.pairing.weylGroup`. -/
noncomputable def fixedWeylGroupMulEquivOfSimpleLift :
    P.fixedWeylGroup σ ≃* F.pairing.weylGroup :=
  (MulEquiv.ofBijective F.restrictFixedWeylAut.rangeRestrict
    ⟨fun _ _ h ↦ F.restrictFixedWeylAut_injective hσ (congrArg Subtype.val h),
      F.restrictFixedWeylAut.rangeRestrict_surjective⟩).trans
    (MulEquiv.subgroupCongr (F.range_restrictFixedWeylAut_eq_weylGroup hσ hlift))

@[simp]
theorem coe_fixedWeylGroupMulEquivOfSimpleLift (w : P.fixedWeylGroup σ) :
    ((F.fixedWeylGroupMulEquivOfSimpleLift hσ hlift w : F.pairing.weylGroup) : F.pairing.Aut) =
      F.restrictFixedWeylAut w := by
  rw [fixedWeylGroupMulEquivOfSimpleLift]; rfl

@[simp]
theorem coe_fixedWeylGroupMulEquivOfSimpleLift_smul (w : P.fixedWeylGroup σ)
    (x : LinearMap.fixedSubmodule σ.weightMap) :
    ((F.fixedWeylGroupMulEquivOfSimpleLift hσ hlift w • x :
        LinearMap.fixedSubmodule σ.weightMap) : M) = (w : P.weylGroup) • (x : M) := by
  rw [Subgroup.smul_def, coe_fixedWeylGroupMulEquivOfSimpleLift, coe_restrictFixedWeylAut_smul]

end OrbitSumRealization

end Restriction

/-! ### The fixed Weyl group of an orthogonal fold -/

section OrthogonalFixedWeyl

variable {ι R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  (P : RootPairing ι R M N) [Finite ι] (σ : P.Aut)

theorem orbitBlockReflection_mem_fixedWeylGroup {k : ι}
    (hO : (P.orbitIndices σ k : Set ι).Pairwise P.IsOrthogonal) :
    P.orbitBlockReflection σ k hO ∈ P.fixedWeylGroup σ :=
  mem_fixedWeylGroup_iff_weylGroupEquiv.mpr (weylGroupEquiv_orbitBlockReflection hO)

/-- The block reflection across a pairwise orthogonal `σ`-orbit `P.orbitIndices σ k`, bundled as an
element of `P.fixedWeylGroup σ`. -/
noncomputable def fixedOrbitBlockReflection (k : ι)
    (hO : (P.orbitIndices σ k : Set ι).Pairwise P.IsOrthogonal) : P.fixedWeylGroup σ :=
  ⟨P.orbitBlockReflection σ k hO, P.orbitBlockReflection_mem_fixedWeylGroup σ hO⟩

@[simp]
theorem coe_fixedOrbitBlockReflection (k : ι)
    (hO : (P.orbitIndices σ k : Set ι).Pairwise P.IsOrthogonal) :
    (P.fixedOrbitBlockReflection σ k hO : P.weylGroup) = P.orbitBlockReflection σ k hO := by
  rw [fixedOrbitBlockReflection]

end OrthogonalFixedWeyl

section OrthogonalRealization

variable {ι R M N : Type*} [CommRing R] [CharZero R] [IsDomain R]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  {P : RootPairing ι R M N} [Finite ι] [P.IsCrystallographic] [P.IsReduced]
  {b : P.Base} {σ : P.Aut}

namespace OrbitSumRealization

variable (F : P.OrbitSumRealization b σ)
  (hσ : ∀ i ∈ b.support, σ.indexEquiv i ∈ b.support)
  (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0)
include hσ horth

theorem restrictFixedWeylAut_fixedOrbitBlockReflection (k : ι) :
    F.restrictFixedWeylAut
        (P.fixedOrbitBlockReflection σ k (orbitIndices_pairwise_isOrthogonal hσ horth k)) =
      Equiv.reflection F.pairing (P.foldedIndex σ k) :=
  Equiv.weightHom_injective F.pairing <| LinearEquiv.ext fun x ↦ Subtype.ext <|
    (F.coe_restrictFixedWeylAut_smul _ x).trans <|
      (congrArg (· • (x : M)) (P.coe_fixedOrbitBlockReflection σ k _)).trans
        (F.coe_reflection_foldedIndex hσ horth k x).symm

/-- **The fixed Weyl group of an orthogonal fold.** Under simple-orbit orthogonality, restriction to
`LinearMap.fixedSubmodule σ.weightMap` is a group isomorphism
`P.fixedWeylGroup σ ≃* F.pairing.weylGroup`. -/
noncomputable def fixedWeylGroupMulEquiv : P.fixedWeylGroup σ ≃* F.pairing.weylGroup :=
  F.fixedWeylGroupMulEquivOfSimpleLift hσ fun i _ ↦
    ⟨P.fixedOrbitBlockReflection σ i (orbitIndices_pairwise_isOrthogonal hσ horth i),
      F.restrictFixedWeylAut_fixedOrbitBlockReflection hσ horth i⟩

@[simp]
theorem coe_fixedWeylGroupMulEquiv (w : P.fixedWeylGroup σ) :
    ((F.fixedWeylGroupMulEquiv hσ horth w : F.pairing.weylGroup) : F.pairing.Aut) =
      F.restrictFixedWeylAut w := by
  rw [fixedWeylGroupMulEquiv, coe_fixedWeylGroupMulEquivOfSimpleLift]

@[simp]
theorem coe_fixedWeylGroupMulEquiv_smul (w : P.fixedWeylGroup σ)
    (x : LinearMap.fixedSubmodule σ.weightMap) :
    ((F.fixedWeylGroupMulEquiv hσ horth w • x : LinearMap.fixedSubmodule σ.weightMap) : M) =
      (w : P.weylGroup) • (x : M) := by
  rw [fixedWeylGroupMulEquiv, coe_fixedWeylGroupMulEquivOfSimpleLift_smul]

@[simp]
theorem fixedWeylGroupMulEquiv_fixedOrbitBlockReflection (k : ι) :
    F.fixedWeylGroupMulEquiv hσ horth
        (P.fixedOrbitBlockReflection σ k (orbitIndices_pairwise_isOrthogonal hσ horth k)) =
      weylGroup.ofIdx F.pairing (P.foldedIndex σ k) :=
  Subtype.ext <| by
    rw [coe_fixedWeylGroupMulEquiv, F.restrictFixedWeylAut_fixedOrbitBlockReflection hσ horth]; rfl

@[simp]
theorem fixedWeylGroupMulEquiv_symm_ofIdx (k : ι) :
    (F.fixedWeylGroupMulEquiv hσ horth).symm (weylGroup.ofIdx F.pairing (P.foldedIndex σ k)) =
      P.fixedOrbitBlockReflection σ k (orbitIndices_pairwise_isOrthogonal hσ horth k) :=
  (F.fixedWeylGroupMulEquiv hσ horth).symm_apply_eq.mpr
    (F.fixedWeylGroupMulEquiv_fixedOrbitBlockReflection hσ horth k).symm

end OrbitSumRealization

private theorem ncard_inversions_mul_orthogonalReflectionProd_lt (b : P.Base) {s : Finset ι}
    (hs : (s : Set ι).Pairwise P.IsOrthogonal) (hne : s.Nonempty) (u : P.weylGroup)
    (hinv : ∀ j ∈ s, j ∈ inversions P b u) :
    (inversions P b (u * P.orthogonalReflectionProd s hs)).ncard < (inversions P b u).ncard := by
  induction s using Finset.cons_induction generalizing u with
  | empty => exact False.elim (Finset.not_nonempty_empty hne)
  | cons a t ha ih =>
    have ht : (t : Set ι).Pairwise P.IsOrthogonal := hs.mono fun _ h ↦ Finset.mem_cons_of_mem h
    rw [orthogonalReflectionProd_cons, ← mul_assoc]
    have hdrop := ncard_inversions_mul_ofIdx_lt_of_mem P b u (hinv a (Finset.mem_cons_self a t))
    rcases t.eq_empty_or_nonempty with rfl | htne
    · simpa using hdrop
    · refine (ih ht htne (u * weylGroup.ofIdx P a) fun k hk ↦ ?_).trans hdrop
      have hka : P.IsOrthogonal k a :=
        hs (Finset.mem_cons_of_mem hk) (Finset.mem_cons_self a t) fun h ↦ ha (h ▸ hk)
      have hfix : P.reflectionPerm a k = k :=
        P.root.injective (by rw [root_reflectionPerm, hka.reflection_apply_left])
      obtain ⟨hkpos, hkneg⟩ := (mem_inversions P b u k).mp (hinv k (Finset.mem_cons_of_mem hk))
      exact (mem_inversions P b _ k).mpr
        ⟨hkpos, by rwa [weylGroupToPerm_mul_ofIdx_apply, hfix]⟩

omit [IsDomain R] [P.IsCrystallographic] [P.IsReduced] in
private theorem mem_inversions_of_mem_orbitIndices
    (hσ : ∀ i ∈ b.support, σ.indexEquiv i ∈ b.support) {w : P.weylGroup}
    (hw : w ∈ P.fixedWeylGroup σ) {i j : ι} (hwi : i ∈ inversions P b w)
    (hj : j ∈ P.orbitIndices σ i) : j ∈ inversions P b w := by
  obtain ⟨hipos, hwineg⟩ := (mem_inversions P b w i).mp hwi
  have hwj : P.weylGroupToPerm w j ∈ P.orbitIndices σ (P.weylGroupToPerm w i) :=
    map_orbitIndices (w : P.Aut) (σ := σ) (τ := σ)
      (fun z ↦ (indexEquiv_weylGroupToPerm_of_weylGroupEquiv_eq
        (weylGroupEquiv_eq_of_mem_fixedWeylGroup hw) z).symm) i ▸
      Finset.mem_map_of_mem _ hj
  exact (mem_inversions P b w j).mpr
    ⟨(isPos_iff_of_mem_orbitIndices hσ hj).mpr hipos,
      mt (isPos_iff_of_mem_orbitIndices hσ hwj).mp hwineg⟩

variable (P b σ) in
/-- Over any characteristic-zero domain, if `σ` permutes `b.support` and every simple `σ`-orbit is
pairwise orthogonal, `P.fixedWeylGroup σ` is generated by the block reflections across the simple
`σ`-orbits. -/
theorem fixedWeylGroup_eq_closure_fixedOrbitBlockReflection
    (hσ : ∀ i ∈ b.support, σ.indexEquiv i ∈ b.support)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0) :
    (⊤ : Subgroup (P.fixedWeylGroup σ)) =
      Subgroup.closure (range fun i : b.support ↦
        P.fixedOrbitBlockReflection σ i
          (orbitIndices_pairwise_isOrthogonal_of_mem_support horth i.2)) := by
  refine le_antisymm (fun w _ ↦ ?_) le_top
  induction hn : (inversions P b (w : P.weylGroup)).ncard using Nat.strong_induction_on
      generalizing w with
  | _ n ih =>
    by_cases hw : w = 1
    · exact hw ▸ one_mem _
    · obtain ⟨i, hi, hinv_i⟩ := exists_mem_support_mem_inversions_of_ne_one P b
        (fun h ↦ hw (Subtype.ext h))
      let g := P.fixedOrbitBlockReflection σ i
        (orbitIndices_pairwise_isOrthogonal_of_mem_support horth hi)
      have hg : g ∈ Subgroup.closure (range fun j : b.support ↦
          P.fixedOrbitBlockReflection σ j
            (orbitIndices_pairwise_isOrthogonal_of_mem_support horth j.2)) :=
        Subgroup.subset_closure ⟨⟨i, hi⟩, rfl⟩
      have hlt : (inversions P b ((w * g : P.fixedWeylGroup σ) : P.weylGroup)).ncard < n := by
        rw [← hn, Subgroup.coe_mul, coe_fixedOrbitBlockReflection, orbitBlockReflection_def]
        exact ncard_inversions_mul_orthogonalReflectionProd_lt b _ (P.orbitIndices_nonempty σ i)
          (w : P.weylGroup) fun _ hj ↦ mem_inversions_of_mem_orbitIndices hσ w.2 hinv_i hj
      have hgg : g * g = 1 := Subtype.ext <| by
        rw [Subgroup.coe_mul, coe_fixedOrbitBlockReflection, orbitBlockReflection_mul_self,
          OneMemClass.coe_one]
      have heq : w = w * g * g := by rw [mul_assoc, hgg, mul_one]
      exact heq ▸ mul_mem (ih _ hlt (w * g) trivial rfl) hg

end OrthogonalRealization

end RootPairing
