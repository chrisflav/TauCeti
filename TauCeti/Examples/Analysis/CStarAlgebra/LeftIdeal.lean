module

public import Mathlib.Analysis.CStarAlgebra.ContinuousMap
public import Mathlib.Topology.UnitInterval
public import TauCeti.Analysis.CStarAlgebra.LeftIdeal

/-!
# Sharpness and nonclosedness for the principal ideal `x · C([0, 1], ℂ)`

In the commutative C⋆-algebra `C(unitInterval, ℂ)`, the algebraic principal ideal
`L = x · C(unitInterval, ℂ)` generated by the coordinate function `x(t) = t` is **not** norm-closed:
`t ↦ √t` lies in the closure of `L` (approximated uniformly by `√t · t² / (δ + t²) ∈ L`) yet does
not factor in `C(unitInterval, ℂ)` as `t · g(t)`. Closure-based C⋆-subalgebra approximate units
therefore land in the maximal ideal `{f | f(0) = 0}` rather than in `L` itself.

Evaluated on the singleton `F = {x}` and any `δ > 0`, `Submodule.rightApproxUnit` produces the
explicit rational function
`e_δ(t) = t² / (δ + t²) = x(t) · (t / (δ + t²)) ∈ L`,
and for every `0 < δ ≤ 1` the error `‖x - x * e_δ‖ ^ 2` equals `δ / 4` **exactly**, attained at
`t = √δ ∈ [0, 1]`. Thus the constant `δ / 4` in
`Submodule.norm_sub_mul_rightApproxUnit_sq_le` cannot be improved.

## Main declarations

* `TauCeti.LeftIdealExample.principalIdeal`: the algebraic complex ideal `coord · C(I, ℂ)`.
* `TauCeti.LeftIdealExample.sqrtCoord_notMem_principalIdeal` and
  `TauCeti.LeftIdealExample.sqrtCoord_mem_closure_principalIdeal`: `t ↦ √t` lies in the closure of
  `principalIdeal` but not in `principalIdeal` itself.
* `TauCeti.LeftIdealExample.not_isClosed_principalIdeal`: `principalIdeal` is not norm-closed.
* `TauCeti.LeftIdealExample.rightApproxUnit_singleton_coord_apply` and
  `TauCeti.LeftIdealExample.norm_sub_mul_rightApproxUnit_singleton_coord_sq`: explicit formula
  `t² / (δ + t²)` and exact equality `‖coord - coord * e_{{coord}, δ}‖ ^ 2 = δ / 4` for
  `0 < δ ≤ 1`.

## References

* Bruce Blackadar, *Operator Algebras: Theory of C*-Algebras and von Neumann Algebras*,
  Proposition II.5.3.3.
-/

public section

noncomputable section

open scoped CStarAlgebra Ring unitInterval

namespace TauCeti.LeftIdealExample

/-- The coordinate function `t ↦ (t : ℂ)` in `C(unitInterval, ℂ)`. -/
def coord : C(I, ℂ) :=
  ⟨fun t => ((t : ℝ) : ℂ), Complex.continuous_ofReal.comp continuous_subtype_val⟩

@[simp]
theorem coord_apply (t : I) : coord t = ((t : ℝ) : ℂ) :=
  (rfl)

/-- The continuous square-root function `t ↦ (√t : ℂ)` in `C(unitInterval, ℂ)`. -/
def sqrtCoord : C(I, ℂ) :=
  ⟨fun t => ((Real.sqrt (t : ℝ)) : ℂ),
    Complex.continuous_ofReal.comp (Real.continuous_sqrt.comp continuous_subtype_val)⟩

@[simp]
theorem sqrtCoord_apply (t : I) : sqrtCoord t = ((Real.sqrt (t : ℝ)) : ℂ) :=
  (rfl)

/-- The algebraic principal complex ideal `coord · C(unitInterval, ℂ)`. -/
def principalIdeal : Submodule ℂ C(I, ℂ) :=
  (Ideal.span {coord}).restrictScalars ℂ

/-- Membership in `principalIdeal` is factorization by `coord` inside `C(unitInterval, ℂ)`. -/
theorem mem_principalIdeal_iff {f : C(I, ℂ)} :
    f ∈ principalIdeal ↔ ∃ g : C(I, ℂ), f = coord * g := by
  rw [principalIdeal, Submodule.restrictScalars_mem, Ideal.mem_span_singleton]
  exact ⟨fun ⟨g, hg⟩ => ⟨g, hg⟩, fun ⟨g, hg⟩ => ⟨g, hg⟩⟩

/-- `coord` itself belongs to `principalIdeal`. -/
theorem coord_mem_principalIdeal : coord ∈ principalIdeal :=
  mem_principalIdeal_iff.mpr ⟨1, (mul_one coord).symm⟩

/-- `principalIdeal` absorbs left multiplication by all of `C(unitInterval, ℂ)`. -/
theorem mul_mem_left_principalIdeal (a : C(I, ℂ)) {f : C(I, ℂ)} (hf : f ∈ principalIdeal) :
    a * f ∈ principalIdeal :=
  (Ideal.span {coord}).mul_mem_left a hf

/-- `sqrtCoord` does not belong to the algebraic principal ideal `coord · C(unitInterval, ℂ)`. -/
theorem sqrtCoord_notMem_principalIdeal : sqrtCoord ∉ principalIdeal := by
  rw [mem_principalIdeal_iff]
  rintro ⟨g, hg⟩
  let M : ℕ := Nat.ceil ‖g‖ + 2
  have hM_pos : (0 : ℝ) < M := by positivity
  have hM_gt : ‖g‖ < M := by
    have : ‖g‖ ≤ Nat.ceil ‖g‖ := Nat.le_ceil ‖g‖
    push_cast [M]
    linarith
  have hM_ge : (2 : ℝ) ≤ M := by exact_mod_cast Nat.le_add_left 2 (Nat.ceil ‖g‖)
  have ht_mem : (1 : ℝ) / (M : ℝ) ^ 2 ∈ I := by
    refine ⟨by positivity, div_le_one (by positivity) |>.mpr ?_⟩
    nlinarith
  let t₀ : I := ⟨1 / (M : ℝ) ^ 2, ht_mem⟩
  have heval := congrArg (fun h : C(I, ℂ) => h t₀) hg
  simp only [sqrtCoord_apply, ContinuousMap.mul_apply, coord_apply, t₀] at heval
  have hsqrt : Real.sqrt (1 / (M : ℝ) ^ 2) = 1 / (M : ℝ) := by
    rw [one_div, Real.sqrt_inv, Real.sqrt_sq hM_pos.le, one_div]
  rw [hsqrt] at heval
  have hgt₀ : g t₀ = (M : ℂ) := by
    have : (M : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
    push_cast at heval
    field_simp at heval
    exact heval.symm
  have hnorm_gt₀ : (M : ℝ) ≤ ‖g‖ := by
    calc
      (M : ℝ) = ‖(M : ℂ)‖ := by rw [Complex.norm_natCast]
      _ = ‖g t₀‖ := by rw [hgt₀]
      _ ≤ ‖g‖ := ContinuousMap.norm_coe_le_norm g t₀
  exact hM_gt.not_ge hnorm_gt₀

/-- The rational continuous function `t ↦ (t² / (δ + t²) : ℂ)` on `unitInterval` for `δ > 0`. -/
private def ratApprox {δ : ℝ} (hδ : 0 < δ) : C(I, ℂ) :=
  ⟨fun s => (((s : ℝ) ^ 2 / (δ + (s : ℝ) ^ 2) : ℝ) : ℂ),
    Complex.continuous_ofReal.comp <|
      (continuous_subtype_val.pow 2).div
        (continuous_const.add (continuous_subtype_val.pow 2)) fun s =>
          (add_pos_of_pos_of_nonneg hδ (sq_nonneg (s : ℝ))).ne'⟩

@[simp]
private theorem ratApprox_apply {δ : ℝ} (hδ : 0 < δ) (s : I) :
    ratApprox hδ s = (((s : ℝ) ^ 2 / (δ + (s : ℝ) ^ 2) : ℝ) : ℂ) :=
  (rfl)

/-- Explicit formula for the `(F, δ)` approximant of `principalIdeal` at `F = {coord}` and `δ > 0`:
`e_δ(t) = t² / (δ + t²)`. -/
theorem rightApproxUnit_singleton_coord_apply {δ : ℝ} (hδ : 0 < δ) (t : I) :
    principalIdeal.rightApproxUnit
        ({⟨coord, coord_mem_principalIdeal⟩}, OrderDual.toDual ⟨δ, Set.mem_Ioi.mpr hδ⟩) t =
      (((t : ℝ) ^ 2 / (δ + (t : ℝ) ^ 2) : ℝ) : ℂ) := by
  let _ := CStarAlgebra.spectralOrder C(I, ℂ)
  have _ := CStarAlgebra.spectralOrderedRing C(I, ℂ)
  let x₀ : principalIdeal := ⟨coord, coord_mem_principalIdeal⟩
  suffices h : principalIdeal.rightApproxUnit
      ({x₀}, OrderDual.toDual ⟨δ, Set.mem_Ioi.mpr hδ⟩) = ratApprox hδ by
    exact congrArg (fun f : C(I, ℂ) => f t) h
  have hsum : principalIdeal.leftIdealSumSq {x₀} = coord ^ 2 := by
    ext s; simp [x₀, coord, pow_two, Complex.conj_ofReal]
  have hrat : δ • ratApprox hδ + ratApprox hδ * coord ^ 2 = coord ^ 2 := by
    ext s
    simp only [ratApprox_apply, ContinuousMap.add_apply, ContinuousMap.mul_apply,
      ContinuousMap.pow_apply, ContinuousMap.smul_apply, coord_apply, Complex.real_smul,
      ← Complex.ofReal_pow, ← Complex.ofReal_mul, ← Complex.ofReal_add]
    congr 1
    have : δ + (s : ℝ) ^ 2 ≠ 0 := (add_pos_of_pos_of_nonneg hδ (sq_nonneg _)).ne'
    field_simp
  have hinr_mul : ((ratApprox hδ : C(I, ℂ)) : C(I, ℂ)⁺¹) *
      (δ • (1 : C(I, ℂ)⁺¹) + ((coord ^ 2 : C(I, ℂ)) : C(I, ℂ)⁺¹)) =
      ((coord ^ 2 : C(I, ℂ)) : C(I, ℂ)⁺¹) := by
    conv_rhs => rw [← hrat]
    rw [Unitization.inr_add, Unitization.inr_smul, Unitization.inr_mul]
    exact Unitization.ext (by simp) (by ext s; simp [Complex.real_smul])
  have hu : IsUnit (δ • (1 : C(I, ℂ)⁺¹) + ((coord ^ 2 : C(I, ℂ)) : C(I, ℂ)⁺¹)) := by
    rw [← hsum]
    exact TauCeti.CStarAlgebra.isUnit_smul_one_add_inr hδ (principalIdeal.leftIdealSumSq_nonneg _)
  apply Unitization.inr_injective (R := ℂ)
  rw [Submodule.rightApproxUnit_def, hsum, OrderDual.ofDual_toDual,
    TauCeti.CStarAlgebra.inr_resolventApprox]
  dsimp only
  nth_rw 1 [← hinr_mul]
  exact Ring.mul_inverse_cancel_right _ _ hu

/-- Pointwise bound `√t · η⁵ / (η⁵ + t²) ≤ η` for `t ≤ 1` and `0 ≤ η`. -/
private theorem sqrt_mul_pow_five_div_le {η t : ℝ} (hη : 0 ≤ η) (ht1 : t ≤ 1) :
    Real.sqrt t * η ^ 5 / (η ^ 5 + t ^ 2) ≤ η := by
  rcases hη.eq_or_lt with rfl | hη
  · simp
  · by_cases hcase : t ≤ η ^ 2
    · have hsqrt_le : Real.sqrt t ≤ η :=
        Real.sqrt_sq hη.le ▸ Real.sqrt_le_sqrt hcase
      have hfrac_le : η ^ 5 / (η ^ 5 + t ^ 2) ≤ 1 :=
        div_le_one (by positivity) |>.mpr (by linarith [sq_nonneg t])
      calc
        Real.sqrt t * η ^ 5 / (η ^ 5 + t ^ 2) =
            Real.sqrt t * (η ^ 5 / (η ^ 5 + t ^ 2)) := mul_div_assoc _ _ _
        _ ≤ η * 1 := mul_le_mul hsqrt_le hfrac_le (by positivity) hη.le
        _ = η := mul_one η
    · push Not at hcase
      have hsq_ge : η ^ 4 ≤ t ^ 2 := by
        have hpow4 : (η ^ 2) ^ 2 = η ^ 4 := by ring
        exact hpow4 ▸ sq_le_sq' (by nlinarith) hcase.le
      have hsqrt_le_one : Real.sqrt t ≤ 1 := Real.sqrt_le_one.mpr ht1
      calc
        Real.sqrt t * η ^ 5 / (η ^ 5 + t ^ 2) ≤ 1 * η ^ 5 / (η ^ 5 + t ^ 2) :=
          div_le_div_of_nonneg_right
            (mul_le_mul_of_nonneg_right hsqrt_le_one (by positivity)) (by positivity)
        _ ≤ 1 * η ^ 5 / η ^ 4 :=
          div_le_div_of_nonneg_left (by positivity) (by positivity) (by linarith [pow_pos hη 5])
        _ = η := by
          have : η ≠ 0 := hη.ne'
          field_simp

/-- `sqrtCoord` lies in the norm closure of `principalIdeal`, approximated by
`sqrtCoord * e_{{coord}, δ} ∈ principalIdeal` as `δ → 0⁺`. -/
theorem sqrtCoord_mem_closure_principalIdeal :
    sqrtCoord ∈ closure (principalIdeal : Set C(I, ℂ)) := by
  rw [Metric.mem_closure_iff]
  intro ε hε
  let η : ℝ := min (ε / 2) 1
  have hη_pos : 0 < η := lt_min (by positivity) zero_lt_one
  have hη_lt : η < ε := (min_le_left _ _).trans_lt (half_lt_self hε)
  have hδ : 0 < η ^ 5 := by positivity
  let e : C(I, ℂ) := principalIdeal.rightApproxUnit
    ({⟨coord, coord_mem_principalIdeal⟩}, OrderDual.toDual ⟨η ^ 5, Set.mem_Ioi.mpr hδ⟩)
  refine ⟨sqrtCoord * e, mul_mem_left_principalIdeal sqrtCoord
    (principalIdeal.rightApproxUnit_mem (fun a _ hf => mul_mem_left_principalIdeal a hf) _), ?_⟩
  rw [dist_eq_norm]
  refine lt_of_le_of_lt (ContinuousMap.norm_le _ hη_pos.le |>.mpr fun t => ?_) hη_lt
  simp only [ContinuousMap.sub_apply, ContinuousMap.mul_apply, sqrtCoord_apply,
    e, rightApproxUnit_singleton_coord_apply hδ]
  have hdiff : ((Real.sqrt (t : ℝ) : ℝ) : ℂ) -
      ((Real.sqrt (t : ℝ) : ℝ) : ℂ) * (((t : ℝ) ^ 2 / (η ^ 5 + (t : ℝ) ^ 2) : ℝ) : ℂ) =
      (((Real.sqrt (t : ℝ) * η ^ 5 / (η ^ 5 + (t : ℝ) ^ 2) : ℝ)) : ℂ) := by
    rw [← Complex.ofReal_mul, ← Complex.ofReal_sub]
    congr 1
    have : η ^ 5 + (t : ℝ) ^ 2 ≠ 0 := (add_pos_of_pos_of_nonneg hδ (sq_nonneg _)).ne'
    field_simp
    ring
  rw [hdiff, Complex.norm_real, Real.norm_of_nonneg (div_nonneg
    (mul_nonneg (Real.sqrt_nonneg _) hδ.le) (by positivity))]
  exact sqrt_mul_pow_five_div_le hη_pos.le t.2.2

/-- The complex principal ideal `coord · C(unitInterval, ℂ)` is **not** closed in
`C(unitInterval, ℂ)`. -/
theorem not_isClosed_principalIdeal : ¬ IsClosed (principalIdeal : Set C(I, ℂ)) := by
  intro hclosed
  have hmem : sqrtCoord ∈ (principalIdeal : Set C(I, ℂ)) := by
    rw [← hclosed.closure_eq]
    exact sqrtCoord_mem_closure_principalIdeal
  exact sqrtCoord_notMem_principalIdeal hmem

/-- **Sharpness of the `δ / 4` constant.** For every `0 < δ ≤ 1`,
`‖coord - coord * e_{{coord}, δ}‖ ^ 2 = δ / 4`, attained at `t = √δ ∈ [0, 1]`. -/
theorem norm_sub_mul_rightApproxUnit_singleton_coord_sq {δ : ℝ} (hδ : 0 < δ) (hδ1 : δ ≤ 1) :
    ‖coord - coord * principalIdeal.rightApproxUnit
      ({⟨coord, coord_mem_principalIdeal⟩}, OrderDual.toDual ⟨δ, Set.mem_Ioi.mpr hδ⟩)‖ ^ 2 =
      δ / 4 := by
  let x₀ : principalIdeal := ⟨coord, coord_mem_principalIdeal⟩
  let i : Finset principalIdeal × (Set.Ioi (0 : ℝ))ᵒᵈ :=
    ({x₀}, OrderDual.toDual ⟨δ, Set.mem_Ioi.mpr hδ⟩)
  apply le_antisymm
  · exact principalIdeal.norm_sub_mul_rightApproxUnit_sq_le (i := i) (x := x₀)
      (Finset.mem_singleton_self x₀)
  · let t_δ : I := ⟨Real.sqrt δ, ⟨Real.sqrt_nonneg δ, Real.sqrt_le_one.mpr hδ1⟩⟩
    have heval : (coord - coord * principalIdeal.rightApproxUnit i) t_δ =
        ((Real.sqrt δ / 2 : ℝ) : ℂ) := by
      simp only [ContinuousMap.sub_apply, ContinuousMap.mul_apply, coord_apply,
        i, x₀, rightApproxUnit_singleton_coord_apply hδ, t_δ, Real.sq_sqrt hδ.le,
        ← Complex.ofReal_mul, ← Complex.ofReal_sub]
      congr 1
      have : δ + δ ≠ 0 := by positivity
      field_simp
      ring
    have hpt : Real.sqrt δ / 2 ≤ ‖coord - coord * principalIdeal.rightApproxUnit i‖ := by
      calc
        Real.sqrt δ / 2 = ‖((Real.sqrt δ / 2 : ℝ) : ℂ)‖ := by
          rw [Complex.norm_real, Real.norm_of_nonneg (by positivity)]
        _ = ‖(coord - coord * principalIdeal.rightApproxUnit i) t_δ‖ := by rw [heval]
        _ ≤ ‖coord - coord * principalIdeal.rightApproxUnit i‖ :=
          ContinuousMap.norm_coe_le_norm _ t_δ
    calc
      δ / 4 = (Real.sqrt δ / 2) ^ 2 := by rw [div_pow, Real.sq_sqrt hδ.le]; norm_num
      _ ≤ ‖coord - coord * principalIdeal.rightApproxUnit i‖ ^ 2 :=
        pow_le_pow_left₀ (by positivity) hpt 2

end TauCeti.LeftIdealExample

end
