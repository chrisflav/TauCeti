public import TauCeti.AlgebraicTopology.RationalHomotopy.Sullivan.Basic

/-!
# Relative Sullivan extensions and Hirsch extensions

This file defines relative Sullivan extensions `A → A ᵍ⊗ ΛW` and Hirsch extensions (`d(W) ⊆ A`),
proves that both preserve Sullivan algebras (ordering the base generators before the new ones via
`ι ⊕ₗ κ`), and establishes the universal property for morphisms of differential graded algebras
out of a Hirsch extension into a graded-commutative DG algebra.

## Main definitions

* `TauCeti.IsRelativeSullivanExtension`: a DG differential on `A ᵍ⊗ ΛW` extending `dA` on `A ᵍ⊗ 1`
  and sending each `1 ᵍ⊗ y j` into the subalgebra generated by `A ᵍ⊗ 1` and `1 ᵍ⊗ y k` (`k < j`).
* `TauCeti.IsHirschExtension`: a DG differential on `A ᵍ⊗ ΛW` extending `dA` on `A ᵍ⊗ 1` and
  sending each `1 ᵍ⊗ y j` into `A ᵍ⊗ 1`.
* `TauCeti.IsRelativeSullivanExtension.includeLeft` and `TauCeti.IsHirschExtension.includeLeft`:
  the canonical DG algebra inclusions `A → A ᵍ⊗ ΛW`.
* `TauCeti.IsHirschExtension.dgLift`: the unique DG algebra morphism out of a Hirsch extension
  determined by its restriction to `A` and the images of the generators `y j`.

## Main results

* `TauCeti.IsRelativeSullivanExtension.isSullivanAlgebra` and
  `TauCeti.IsHirschExtension.isSullivanAlgebra`: a relative Sullivan or Hirsch extension of a
  Sullivan algebra is a Sullivan algebra on `ι ⊕ₗ κ`.
* `TauCeti.IsHirschExtension.existsUnique_dgAlgHom` and
  `TauCeti.IsHirschExtension.exists_dgAlgHom_iff`: universal property and existence criterion for
  DG algebra morphisms out of a Hirsch extension.

## References

* Y. Félix, S. Halperin, and J.-C. Thomas, *Rational Homotopy Theory*, Graduate Texts in
  Mathematics 205, Springer (2001), Section 14.
* J. W. Morgan, *The algebraic topology of smooth algebraic varieties*, Publications Mathématiques
  de l'IHÉS 48 (1978), Definition 5.1.
-/

public section

open DirectSum
open scoped TensorProduct

namespace TauCeti

universe u

variable {R : Type u} [CommRing R] {A B : Type*} [Ring A] [Algebra R A] [Ring B] [Algebra R B]

/-- A **relative Sullivan extension** `(A, dA) → (A ᵍ⊗ ΛW, d)`: `B` is free graded-commutative on
well-ordered positive-degree generators `y j`, `d` restricts to `dA` on `A ᵍ⊗ 1`, and each
`d (1 ᵍ⊗ y j)` lies in the subalgebra generated by `A ᵍ⊗ 1` and the earlier generators
`1 ᵍ⊗ y k` (`k < j`). -/
structure IsRelativeSullivanExtension (𝒜 : ℤ → Submodule R A) [GradedAlgebra 𝒜]
    (ℬ : ℤ → Submodule R B) [GradedAlgebra ℬ]
    (dA : A →ₗ[R] A) (d : (𝒜 ᵍ⊗[R] ℬ) →ₗ[R] (𝒜 ᵍ⊗[R] ℬ))
    {κ : Type*} [LinearOrder κ] [WellFoundedLT κ] (y : κ → B) (degB : κ → ℕ) : Prop
    extends IsFreeGradedCommutative ℬ y degB where
  /-- Every new generator has positive degree. -/
  deg_pos : ∀ j, 0 < degB j
  /-- The differential restricts to `dA` on the base factor `A ᵍ⊗ 1`. -/
  d_tmul_one : ∀ a : A, d (a ᵍ⊗ₜ[R] (1 : B)) = dA a ᵍ⊗ₜ[R] (1 : B)
  /-- The differential of each generator `1 ᵍ⊗ y j` lies in the subalgebra generated by the base
  `A ᵍ⊗ 1` and the earlier generators `1 ᵍ⊗ y k` (`k < j`). -/
  d_one_tmul_mem : ∀ j,
    d ((1 : A) ᵍ⊗ₜ[R] y j) ∈
      Algebra.adjoin R (Set.range (fun a : A => (a ᵍ⊗ₜ[R] (1 : B) : 𝒜 ᵍ⊗[R] ℬ)) ∪
        (fun k : κ => ((1 : A) ᵍ⊗ₜ[R] y k : 𝒜 ᵍ⊗[R] ℬ)) '' Set.Iio j)

/-- A **Hirsch extension** `(A, dA) → (A ᵍ⊗ ΛW, d)`: `B` is free graded-commutative on
positive-degree generators `y j`, `d` restricts to `dA` on `A ᵍ⊗ 1`, and `d (1 ᵍ⊗ y j)` lies in
the base factor `A ᵍ⊗ 1`. -/
structure IsHirschExtension (𝒜 : ℤ → Submodule R A) [GradedAlgebra 𝒜]
    (ℬ : ℤ → Submodule R B) [GradedAlgebra ℬ]
    (dA : A →ₗ[R] A) (d : (𝒜 ᵍ⊗[R] ℬ) →ₗ[R] (𝒜 ᵍ⊗[R] ℬ))
    {κ : Type*} [LinearOrder κ] (y : κ → B) (degB : κ → ℕ) : Prop
    extends IsFreeGradedCommutative ℬ y degB where
  /-- Every new generator has positive degree. -/
  deg_pos : ∀ j, 0 < degB j
  /-- The differential restricts to `dA` on the base factor `A ᵍ⊗ 1`. -/
  d_tmul_one : ∀ a : A, d (a ᵍ⊗ₜ[R] (1 : B)) = dA a ᵍ⊗ₜ[R] (1 : B)
  /-- The differential of each new generator lies in the base factor `A ᵍ⊗ 1`. -/
  d_one_tmul_mem_left : ∀ j, ∃ a : A, d ((1 : A) ᵍ⊗ₜ[R] y j) = a ᵍ⊗ₜ[R] (1 : B)

namespace IsRelativeSullivanExtension

variable {𝒜 : ℤ → Submodule R A} [GradedAlgebra 𝒜]
  {ℬ : ℤ → Submodule R B} [GradedAlgebra ℬ]
  {dA : A →ₗ[R] A} {d : (𝒜 ᵍ⊗[R] ℬ) →ₗ[R] (𝒜 ᵍ⊗[R] ℬ)}
  {κ : Type*} [LinearOrder κ] [WellFoundedLT κ] {y : κ → B} {degB : κ → ℕ}

/-- The canonical DG algebra inclusion `A → A ᵍ⊗ ΛW` of a relative Sullivan extension. -/
noncomputable def includeLeft (hA : IsDGAlgebra 𝒜 dA)
    (hAB : IsDGAlgebra (gradedTensorGrading 𝒜 ℬ) d)
    (hext : IsRelativeSullivanExtension 𝒜 ℬ dA d y degB) : DGAlgHom hA hAB where
  toGradedAlgHom := gradedTensorIncludeLeft 𝒜 ℬ
  map_d' a := by
    simp only [gradedTensorIncludeLeft_apply]
    exact hext.d_tmul_one a

@[simp]
theorem includeLeft_apply (hA : IsDGAlgebra 𝒜 dA)
    (hAB : IsDGAlgebra (gradedTensorGrading 𝒜 ℬ) d)
    (hext : IsRelativeSullivanExtension 𝒜 ℬ dA d y degB) (a : A) :
    hext.includeLeft hA hAB a = a ᵍ⊗ₜ[R] (1 : B) :=
  gradedTensorIncludeLeft_apply 𝒜 ℬ a

/-- A relative Sullivan extension of a Sullivan algebra is a Sullivan algebra, ordered with the
generators of the base first (on the lexicographic disjoint union `ι ⊕ₗ κ`). -/
theorem isSullivanAlgebra {ι : Type*} [LinearOrder ι] [WellFoundedLT ι]
    {x : ι → A} {degA : ι → ℕ} (hx : IsSullivanAlgebra 𝒜 dA x degA)
    (hext : IsRelativeSullivanExtension 𝒜 ℬ dA d y degB) :
    IsSullivanAlgebra (gradedTensorGrading 𝒜 ℬ) d
      (fun k : ι ⊕ₗ κ => Sum.elim (fun i => (x i ᵍ⊗ₜ[R] (1 : B) : 𝒜 ᵍ⊗[R] ℬ))
        (fun j => ((1 : A) ᵍ⊗ₜ[R] y j : 𝒜 ᵍ⊗[R] ℬ)) (ofLex k))
      (fun k : ι ⊕ₗ κ => Sum.elim degA degB (ofLex k)) where
  toIsFreeGradedCommutative :=
    hx.toIsFreeGradedCommutative.gradedTensor hext.toIsFreeGradedCommutative
  deg_pos k := by
    cases hk : ofLex k with
    | inl i => exact hx.deg_pos i
    | inr j => exact hext.deg_pos j
  d_mem_adjoin k := by
    let z : ι ⊕ₗ κ → 𝒜 ᵍ⊗[R] ℬ := fun m =>
      Sum.elim (fun i => (x i ᵍ⊗ₜ[R] (1 : B) : 𝒜 ᵍ⊗[R] ℬ))
        (fun j => ((1 : A) ᵍ⊗ₜ[R] y j : 𝒜 ᵍ⊗[R] ℬ)) (ofLex m)
    cases hk : ofLex k with
    | inl i =>
      have hk_eq : k = toLex (Sum.inl i) := by rw [← hk]; rfl
      subst hk_eq
      -- Expose the `Sum.elim` evaluation at `inl i` for `hext.d_tmul_one`.
      change d (x i ᵍ⊗ₜ[R] (1 : B)) ∈ Algebra.adjoin R (z '' Set.Iio (toLex (Sum.inl i)))
      rw [hext.d_tmul_one, ← gradedTensorIncludeLeft_apply 𝒜 ℬ]
      have hmem : (gradedTensorIncludeLeft 𝒜 ℬ).toAlgHom (dA (x i)) ∈
          (Algebra.adjoin R (x '' Set.Iio i)).map (gradedTensorIncludeLeft 𝒜 ℬ).toAlgHom :=
        Subalgebra.mem_map.2 ⟨dA (x i), hx.d_mem_adjoin i, rfl⟩
      rw [AlgHom.map_adjoin] at hmem
      refine Algebra.adjoin_mono ?_ hmem
      rintro _ ⟨_, ⟨i', hi', rfl⟩, rfl⟩
      exact ⟨toLex (Sum.inl i'), Sum.Lex.inl_strictMono hi',
        (gradedTensorIncludeLeft_apply 𝒜 ℬ (x i')).symm⟩
    | inr j =>
      have hk_eq : k = toLex (Sum.inr j) := by rw [← hk]; rfl
      subst hk_eq
      -- Expose the `Sum.elim` evaluation at `inr j` for `hext.d_one_tmul_mem`.
      change d ((1 : A) ᵍ⊗ₜ[R] y j) ∈ Algebra.adjoin R (z '' Set.Iio (toLex (Sum.inr j)))
      have hsub : Algebra.adjoin R
          (Set.range (fun a : A => (a ᵍ⊗ₜ[R] (1 : B) : 𝒜 ᵍ⊗[R] ℬ)) ∪
            (fun m : κ => ((1 : A) ᵍ⊗ₜ[R] y m : 𝒜 ᵍ⊗[R] ℬ)) '' Set.Iio j) ≤
          Algebra.adjoin R (z '' Set.Iio (toLex (Sum.inr j))) := by
        rw [Algebra.adjoin_le_iff]
        rintro u (⟨a, rfl⟩ | ⟨m, hm, rfl⟩)
        · have ha : a ∈ Algebra.adjoin R (Set.range x) := by
            rw [hx.adjoin_range_eq_top]; trivial
          have hmem : (gradedTensorIncludeLeft 𝒜 ℬ).toAlgHom a ∈
              (Algebra.adjoin R (Set.range x)).map (gradedTensorIncludeLeft 𝒜 ℬ).toAlgHom :=
            Subalgebra.mem_map.2 ⟨a, ha, rfl⟩
          rw [AlgHom.map_adjoin] at hmem
          have hmem' : (a ᵍ⊗ₜ[R] (1 : B) : 𝒜 ᵍ⊗[R] ℬ) ∈
              Algebra.adjoin R ((gradedTensorIncludeLeft 𝒜 ℬ).toAlgHom '' Set.range x) := by
            simpa [gradedTensorIncludeLeft_apply] using hmem
          refine Algebra.adjoin_mono ?_ hmem'
          rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
          exact ⟨toLex (Sum.inl i), Sum.Lex.sep i j,
            (gradedTensorIncludeLeft_apply 𝒜 ℬ (x i)).symm⟩
        · exact Algebra.subset_adjoin ⟨toLex (Sum.inr m), Sum.Lex.inr_strictMono hm, rfl⟩
      exact hsub (hext.d_one_tmul_mem j)

end IsRelativeSullivanExtension

namespace IsHirschExtension

variable {𝒜 : ℤ → Submodule R A} [GradedAlgebra 𝒜]
  {ℬ : ℤ → Submodule R B} [GradedAlgebra ℬ]
  {dA : A →ₗ[R] A} {d : (𝒜 ᵍ⊗[R] ℬ) →ₗ[R] (𝒜 ᵍ⊗[R] ℬ)}
  {κ : Type*} [LinearOrder κ] {y : κ → B} {degB : κ → ℕ}

/-- Every Hirsch extension with well-ordered generators is a relative Sullivan extension. -/
theorem toRelativeSullivanExtension [WellFoundedLT κ]
    (hext : IsHirschExtension 𝒜 ℬ dA d y degB) :
    IsRelativeSullivanExtension 𝒜 ℬ dA d y degB where
  toIsFreeGradedCommutative := hext.toIsFreeGradedCommutative
  deg_pos := hext.deg_pos
  d_tmul_one := hext.d_tmul_one
  d_one_tmul_mem j := by
    obtain ⟨a, ha⟩ := hext.d_one_tmul_mem_left j
    rw [ha]
    exact Algebra.subset_adjoin (Or.inl ⟨a, rfl⟩)

/-- The canonical DG algebra inclusion `A → A ᵍ⊗ ΛW` of a Hirsch extension. -/
noncomputable def includeLeft (hA : IsDGAlgebra 𝒜 dA)
    (hAB : IsDGAlgebra (gradedTensorGrading 𝒜 ℬ) d)
    (hext : IsHirschExtension 𝒜 ℬ dA d y degB) : DGAlgHom hA hAB where
  toGradedAlgHom := gradedTensorIncludeLeft 𝒜 ℬ
  map_d' a := by
    simp only [gradedTensorIncludeLeft_apply]
    exact hext.d_tmul_one a

@[simp]
theorem includeLeft_apply (hA : IsDGAlgebra 𝒜 dA)
    (hAB : IsDGAlgebra (gradedTensorGrading 𝒜 ℬ) d)
    (hext : IsHirschExtension 𝒜 ℬ dA d y degB) (a : A) :
    hext.includeLeft hA hAB a = a ᵍ⊗ₜ[R] (1 : B) :=
  gradedTensorIncludeLeft_apply 𝒜 ℬ a

/-- A Hirsch extension of a Sullivan algebra by well-ordered generators in positive degrees is a
Sullivan algebra. -/
theorem isSullivanAlgebra [WellFoundedLT κ] {ι : Type*} [LinearOrder ι] [WellFoundedLT ι]
    {x : ι → A} {degA : ι → ℕ} (hx : IsSullivanAlgebra 𝒜 dA x degA)
    (hext : IsHirschExtension 𝒜 ℬ dA d y degB) :
    IsSullivanAlgebra (gradedTensorGrading 𝒜 ℬ) d
      (fun k : ι ⊕ₗ κ => Sum.elim (fun i => (x i ᵍ⊗ₜ[R] (1 : B) : 𝒜 ᵍ⊗[R] ℬ))
        (fun j => ((1 : A) ᵍ⊗ₜ[R] y j : 𝒜 ᵍ⊗[R] ℬ)) (ofLex k))
      (fun k : ι ⊕ₗ κ => Sum.elim degA degB (ofLex k)) :=
  hext.toRelativeSullivanExtension.isSullivanAlgebra hx

/-- **Universal property of Hirsch extensions for DG algebra morphisms**: when `2` is invertible, a
DG algebra morphism `f : A → C` into a graded-commutative DG algebra together with images
`c j ∈ C^(degB j)` satisfying `dC (c j) = f (α j)` (where `d (1 ᵍ⊗ y j) = α j ᵍ⊗ 1`) extends to a
unique DG algebra morphism `A ᵍ⊗ ΛW → C`. -/
noncomputable def dgLift [Invertible (2 : R)]
    (hA : IsDGAlgebra 𝒜 dA) (hAB : IsDGAlgebra (gradedTensorGrading 𝒜 ℬ) d)
    (hext : IsHirschExtension 𝒜 ℬ dA d y degB)
    {C : Type*} [Ring C] [Algebra R C] {𝒞 : ℤ → Submodule R C} [GradedAlgebra 𝒞]
    {dC : C →ₗ[R] C} (hC : IsDGAlgebra 𝒞 dC)
    (hCc : ∀ {p q : ℤ} {c₁ c₂ : C}, c₁ ∈ 𝒞 p → c₂ ∈ 𝒞 q → c₁ * c₂ = (p * q).negOnePow • (c₂ * c₁))
    (f : DGAlgHom hA hC) (c : κ → C) (hc : ∀ j, c j ∈ 𝒞 (degB j))
    {α : κ → A} (hα : ∀ j, d ((1 : A) ᵍ⊗ₜ[R] y j) = α j ᵍ⊗ₜ[R] (1 : B))
    (hd : ∀ j, dC (c j) = f (α j)) : DGAlgHom hAB hC := by
  let g : ℬ →ₐᵍ[R] 𝒞 := hext.toIsFreeGradedCommutative.gradedLift hCc c hc
  have hcomm : ∀ ⦃i j : ℤ⦄ (a : 𝒜 i) (b : ℬ j),
      f.toGradedAlgHom a * g b = (-1 : ℤˣ) ^ (j * i) • (g b * f.toGradedAlgHom a) :=
    fun i j a b => by
      rw [mul_comm j i]
      simpa [Int.negOnePow_def] using hCc (f.map_mem a.2) (g.map_mem b.2)
  let Φ : gradedTensorGrading 𝒜 ℬ →ₐᵍ[R] 𝒞 :=
    gradedTensorLift 𝒜 ℬ 𝒞 f.toGradedAlgHom g hcomm
  refine ⟨Φ, fun z => ?_⟩
  let D : (𝒜 ᵍ⊗[R] ℬ) →ₗ[R] C := dC ∘ₗ Φ.toAlgHom.toLinearMap - Φ.toAlgHom.toLinearMap ∘ₗ d
  have hD_leibniz : ∀ {p : ℤ} {u : 𝒜 ᵍ⊗[R] ℬ}, u ∈ gradedTensorGrading 𝒜 ℬ p →
      ∀ v : 𝒜 ᵍ⊗[R] ℬ, D (u * v) = D u * Φ v + p.negOnePow • (Φ u * D v) := by
    intro p u hu v
    have hΦu : Φ u ∈ 𝒞 p := Φ.map_mem hu
    simp only [D, LinearMap.sub_apply, LinearMap.comp_apply, AlgHom.toLinearMap_apply,
      GradedAlgHom.coe_toAlgHom, map_mul, hC.leibniz hΦu (Φ v), hAB.leibniz hu v, map_add,
      Units.smul_def, map_zsmul, sub_mul, mul_sub, zsmul_sub]
    abel
  have hD_one : D 1 = 0 := by simp [D, hAB.map_one_eq_zero, hC.map_one_eq_zero]
  have hD_left : ∀ a : A, D (a ᵍ⊗ₜ[R] (1 : B)) = 0 := fun a => by
    simp [D, Φ, hext.d_tmul_one a, f.map_d a]
  have hD_gen : ∀ j : κ, D ((1 : A) ᵍ⊗ₜ[R] y j) = 0 := fun j => by
    simp [D, Φ, g, hα j, hd j]
  have hD_gen_pow : ∀ (j : κ) (n : ℕ), D (((1 : A) ᵍ⊗ₜ[R] y j) ^ n) = 0 := by
    intro j n
    induction n with
    | zero => simpa using hD_one
    | succ n ih =>
      have hyj : ((1 : A) ᵍ⊗ₜ[R] y j : 𝒜 ᵍ⊗[R] ℬ) ∈ gradedTensorGrading 𝒜 ℬ (degB j) := by
        simpa using tmul_mem_gradedTensorGrading 𝒜 ℬ (SetLike.one_mem_graded 𝒜) (hext.mem j)
      rw [pow_succ', hD_leibniz hyj, hD_gen j, ih, zero_mul, mul_zero, smul_zero, add_zero]
  have hD_mon : ∀ e : κ →₀ ℕ, D ((1 : A) ᵍ⊗ₜ[R] standardMonomial y e) = 0 := by
    intro e
    have heq : ((1 : A) ᵍ⊗ₜ[R] standardMonomial y e : 𝒜 ᵍ⊗[R] ℬ) =
        standardMonomial (fun j => ((1 : A) ᵍ⊗ₜ[R] y j : 𝒜 ᵍ⊗[R] ℬ)) e := by
      simpa [Function.comp_def, gradedTensorIncludeRight_apply] using
        map_standardMonomial (gradedTensorIncludeRight 𝒜 ℬ) y e
    rw [heq, standardMonomial_def]
    have hlist : ∀ l : List κ,
        D ((l.map fun j => ((1 : A) ᵍ⊗ₜ[R] y j : 𝒜 ᵍ⊗[R] ℬ) ^ e j).prod) = 0 := by
      intro l
      induction l with
      | nil => simpa using hD_one
      | cons j l ih =>
        simp only [List.map_cons, List.prod_cons]
        have hyj : ((1 : A) ᵍ⊗ₜ[R] y j : 𝒜 ᵍ⊗[R] ℬ) ∈ gradedTensorGrading 𝒜 ℬ (degB j) := by
          simpa using tmul_mem_gradedTensorGrading 𝒜 ℬ (SetLike.one_mem_graded 𝒜) (hext.mem j)
        have hpow : ((1 : A) ᵍ⊗ₜ[R] y j : 𝒜 ᵍ⊗[R] ℬ) ^ e j ∈
            gradedTensorGrading 𝒜 ℬ ((e j * degB j : ℕ) : ℤ) := by
          simpa [Nat.cast_mul] using SetLike.pow_mem_graded (e j) hyj
        rw [hD_leibniz hpow, hD_gen_pow j (e j), ih, zero_mul, mul_zero, smul_zero, add_zero]
    exact hlist _
  have hD_right : ∀ b : B, D ((1 : A) ᵍ⊗ₜ[R] b) = 0 := by
    have hlin : (D ∘ₗ (gradedTensorIncludeRight 𝒜 ℬ).toAlgHom.toLinearMap : B →ₗ[R] C) = 0 :=
      hext.toIsFreeGradedCommutative.basis.ext fun e => by simpa using hD_mon e.1
    intro b
    simpa using LinearMap.congr_fun hlin b
  have hD_zero : D = 0 := by
    refine gradedTensor_linearMap_ext 𝒜 ℬ fun p _ a ha b _ => ?_
    have ha1 : (a ᵍ⊗ₜ[R] (1 : B) : 𝒜 ᵍ⊗[R] ℬ) ∈ gradedTensorGrading 𝒜 ℬ p := by
      simpa using tmul_mem_gradedTensorGrading 𝒜 ℬ ha (SetLike.one_mem_graded ℬ)
    rw [← GradedTensorProduct.tmul_one_mul_one_tmul 𝒜 ℬ a b, hD_leibniz ha1,
      hD_left a, hD_right b, zero_mul, mul_zero, smul_zero, add_zero, LinearMap.zero_apply]
  exact sub_eq_zero.1 (LinearMap.congr_fun hD_zero z)

@[simp]
theorem dgLift_tmul_one [Invertible (2 : R)]
    (hA : IsDGAlgebra 𝒜 dA) (hAB : IsDGAlgebra (gradedTensorGrading 𝒜 ℬ) d)
    (hext : IsHirschExtension 𝒜 ℬ dA d y degB)
    {C : Type*} [Ring C] [Algebra R C] {𝒞 : ℤ → Submodule R C} [GradedAlgebra 𝒞]
    {dC : C →ₗ[R] C} (hC : IsDGAlgebra 𝒞 dC)
    (hCc : ∀ {p q : ℤ} {c₁ c₂ : C}, c₁ ∈ 𝒞 p → c₂ ∈ 𝒞 q → c₁ * c₂ = (p * q).negOnePow • (c₂ * c₁))
    (f : DGAlgHom hA hC) (c : κ → C) (hc : ∀ j, c j ∈ 𝒞 (degB j))
    {α : κ → A} (hα : ∀ j, d ((1 : A) ᵍ⊗ₜ[R] y j) = α j ᵍ⊗ₜ[R] (1 : B))
    (hd : ∀ j, dC (c j) = f (α j)) (a : A) :
    hext.dgLift hA hAB hC hCc f c hc hα hd (a ᵍ⊗ₜ[R] (1 : B)) = f a := by
  simp [dgLift]

@[simp]
theorem dgLift_comp_includeLeft [Invertible (2 : R)]
    (hA : IsDGAlgebra 𝒜 dA) (hAB : IsDGAlgebra (gradedTensorGrading 𝒜 ℬ) d)
    (hext : IsHirschExtension 𝒜 ℬ dA d y degB)
    {C : Type*} [Ring C] [Algebra R C] {𝒞 : ℤ → Submodule R C} [GradedAlgebra 𝒞]
    {dC : C →ₗ[R] C} (hC : IsDGAlgebra 𝒞 dC)
    (hCc : ∀ {p q : ℤ} {c₁ c₂ : C}, c₁ ∈ 𝒞 p → c₂ ∈ 𝒞 q → c₁ * c₂ = (p * q).negOnePow • (c₂ * c₁))
    (f : DGAlgHom hA hC) (c : κ → C) (hc : ∀ j, c j ∈ 𝒞 (degB j))
    {α : κ → A} (hα : ∀ j, d ((1 : A) ᵍ⊗ₜ[R] y j) = α j ᵍ⊗ₜ[R] (1 : B))
    (hd : ∀ j, dC (c j) = f (α j)) :
    (hext.dgLift hA hAB hC hCc f c hc hα hd).comp (hext.includeLeft hA hAB) = f := by
  ext a
  simp

@[simp]
theorem dgLift_one_tmul [Invertible (2 : R)]
    (hA : IsDGAlgebra 𝒜 dA) (hAB : IsDGAlgebra (gradedTensorGrading 𝒜 ℬ) d)
    (hext : IsHirschExtension 𝒜 ℬ dA d y degB)
    {C : Type*} [Ring C] [Algebra R C] {𝒞 : ℤ → Submodule R C} [GradedAlgebra 𝒞]
    {dC : C →ₗ[R] C} (hC : IsDGAlgebra 𝒞 dC)
    (hCc : ∀ {p q : ℤ} {c₁ c₂ : C}, c₁ ∈ 𝒞 p → c₂ ∈ 𝒞 q → c₁ * c₂ = (p * q).negOnePow • (c₂ * c₁))
    (f : DGAlgHom hA hC) (c : κ → C) (hc : ∀ j, c j ∈ 𝒞 (degB j))
    {α : κ → A} (hα : ∀ j, d ((1 : A) ᵍ⊗ₜ[R] y j) = α j ᵍ⊗ₜ[R] (1 : B))
    (hd : ∀ j, dC (c j) = f (α j)) (j : κ) :
    hext.dgLift hA hAB hC hCc f c hc hα hd ((1 : A) ᵍ⊗ₜ[R] y j) = c j := by
  simp [dgLift]

/-- Uniqueness and existence of DG algebra morphisms out of a Hirsch extension into a
graded-commutative DG algebra. -/
theorem existsUnique_dgAlgHom [Invertible (2 : R)]
    (hA : IsDGAlgebra 𝒜 dA) (hAB : IsDGAlgebra (gradedTensorGrading 𝒜 ℬ) d)
    (hext : IsHirschExtension 𝒜 ℬ dA d y degB)
    {C : Type*} [Ring C] [Algebra R C] {𝒞 : ℤ → Submodule R C} [GradedAlgebra 𝒞]
    {dC : C →ₗ[R] C} (hC : IsDGAlgebra 𝒞 dC)
    (hCc : ∀ {p q : ℤ} {c₁ c₂ : C}, c₁ ∈ 𝒞 p → c₂ ∈ 𝒞 q → c₁ * c₂ = (p * q).negOnePow • (c₂ * c₁))
    (f : DGAlgHom hA hC) (c : κ → C) (hc : ∀ j, c j ∈ 𝒞 (degB j))
    {α : κ → A} (hα : ∀ j, d ((1 : A) ᵍ⊗ₜ[R] y j) = α j ᵍ⊗ₜ[R] (1 : B))
    (hd : ∀ j, dC (c j) = f (α j)) :
    ∃! F : DGAlgHom hAB hC,
      F.comp (hext.includeLeft hA hAB) = f ∧ ∀ j, F ((1 : A) ᵍ⊗ₜ[R] y j) = c j := by
  refine ⟨hext.dgLift hA hAB hC hCc f c hc hα hd,
    ⟨hext.dgLift_comp_includeLeft hA hAB hC hCc f c hc hα hd,
     hext.dgLift_one_tmul hA hAB hC hCc f c hc hα hd⟩, ?_⟩
  rintro F ⟨hFleft, hFgen⟩
  refine DGAlgHom.toGradedAlgHom_injective (gradedTensorAlgHom_ext 𝒜 ℬ 𝒞 ?_ ?_)
  · refine GradedAlgHom.ext fun a => ?_
    have h := DFunLike.congr_fun hFleft a
    simp only [DGAlgHom.comp_apply, includeLeft_apply] at h
    simpa only [GradedAlgHom.comp_apply, DGAlgHom.coe_toGradedAlgHom,
      gradedTensorIncludeLeft_apply, dgLift_tmul_one] using h
  · refine GradedAlgHom.coe_toAlgHom_injective <|
      hext.toIsFreeGradedCommutative.algHom_ext fun j => ?_
    simpa [dgLift_one_tmul] using hFgen j

/-- A DG algebra morphism `f : A → C` and generator images `c j ∈ C^(degB j)` extend to a DG
algebra morphism out of a Hirsch extension `A ᵍ⊗ ΛW → C` (for graded-commutative `C` with `2`
invertible) if and only if `dC (c j) = f (α j)` for every `j`. -/
theorem exists_dgAlgHom_iff [Invertible (2 : R)]
    (hA : IsDGAlgebra 𝒜 dA) (hAB : IsDGAlgebra (gradedTensorGrading 𝒜 ℬ) d)
    (hext : IsHirschExtension 𝒜 ℬ dA d y degB)
    {C : Type*} [Ring C] [Algebra R C] {𝒞 : ℤ → Submodule R C} [GradedAlgebra 𝒞]
    {dC : C →ₗ[R] C} (hC : IsDGAlgebra 𝒞 dC)
    (hCc : ∀ {p q : ℤ} {c₁ c₂ : C}, c₁ ∈ 𝒞 p → c₂ ∈ 𝒞 q → c₁ * c₂ = (p * q).negOnePow • (c₂ * c₁))
    (f : DGAlgHom hA hC) (c : κ → C) (hc : ∀ j, c j ∈ 𝒞 (degB j))
    {α : κ → A} (hα : ∀ j, d ((1 : A) ᵍ⊗ₜ[R] y j) = α j ᵍ⊗ₜ[R] (1 : B)) :
    (∃ F : DGAlgHom hAB hC,
        F.comp (hext.includeLeft hA hAB) = f ∧ ∀ j, F ((1 : A) ᵍ⊗ₜ[R] y j) = c j) ↔
      ∀ j, dC (c j) = f (α j) := by
  constructor
  · rintro ⟨F, hFleft, hFgen⟩ j
    calc dC (c j) = dC (F ((1 : A) ᵍ⊗ₜ[R] y j)) := by rw [hFgen j]
      _ = F (d ((1 : A) ᵍ⊗ₜ[R] y j)) := F.map_d _
      _ = F (α j ᵍ⊗ₜ[R] (1 : B)) := by rw [hα j]
      _ = f (α j) := by simpa using DFunLike.congr_fun hFleft (α j)
  · intro hd
    exact ⟨hext.dgLift hA hAB hC hCc f c hc hα hd,
      hext.dgLift_comp_includeLeft hA hAB hC hCc f c hc hα hd,
      hext.dgLift_one_tmul hA hAB hC hCc f c hc hα hd⟩

end IsHirschExtension

end TauCeti
