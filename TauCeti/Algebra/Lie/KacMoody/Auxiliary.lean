/-!
# Kac's auxiliary Lie algebra of a realization

For an arbitrary integral matrix `A` and a realization `R` of `A` on a `K`-vector space `H`, Kac's
auxiliary Lie algebra `𝔤~(A)` is presented by the Cartan space `H` together with raising and
lowering generators `e~ᵢ`, `f~ᵢ`, subject to the Cartan and Chevalley relations

* `H` is abelian, `⁅h, e~ⱼ⁆ = αⱼ(h) e~ⱼ` and `⁅h, f~ⱼ⁆ = -αⱼ(h) f~ⱼ` for `h ∈ H`;
* `⁅e~ᵢ, f~ᵢ⁆ = hᵢ` and `⁅e~ᵢ, f~ⱼ⁆ = 0` for `i ≠ j`,

with no Serre relations imposed.

Following [Kac, Theorem 1.2], for each linear functional `λ ∈ H*` we construct a representation of
the auxiliary Lie algebra on the free associative algebra `FreeAlgebra K I` (the universal
enveloping algebra of `FreeLieAlgebra K I`): `f~ⱼ` acts by left multiplication by the `j`-th
indeterminate, `H` acts diagonally on words with highest weight `λ` on `1`, and `e~ᵢ` acts by the
recursive commutator rule determined by `e~ᵢ · 1 = 0` and `⁅e~ᵢ, f~ⱼ⁆ = δᵢⱼ hᵢ`. Evaluating this
family of representations at `1`, together with the Chevalley involution exchanging `e~ᵢ` and
`-f~ᵢ`, shows that `𝔤~(A)` decomposes as the vector-space direct sum `n~⁻ ⊕ H ⊕ n~⁺`, where `n~⁻`
and `n~⁺` are freely generated as Lie algebras by the `f~ᵢ` and the `e~ᵢ`, and `H` embeds
injectively. Neither a generalized Cartan matrix assumption on `A` nor a characteristic assumption
on `K` is needed here.

## Main definitions

* `TauCeti.KacMoody.IsAuxRelator`: the Cartan and Chevalley relators (without Serre's relations).
* `TauCeti.KacMoody.AuxiliaryLieAlgebra`: Kac's auxiliary Lie algebra `𝔤~(A)` on the realization
  `R`.
* `TauCeti.KacMoody.auxCartanElement`, `TauCeti.KacMoody.auxPositiveGenerator` and
  `TauCeti.KacMoody.auxNegativeGenerator`: the Cartan, raising and lowering generators of `𝔤~(A)`.
* `TauCeti.KacMoody.SatisfiesAuxRelations` and `TauCeti.KacMoody.auxLift`: the universal property
  of `𝔤~(A)`.
* `TauCeti.KacMoody.toPresented`: the canonical quotient homomorphism from `𝔤~(A)` onto
  `TauCeti.KacMoody.PresentedLieAlgebra R`.
* `TauCeti.KacMoody.auxChevalleyInvolution`: the Chevalley involution exchanging `e~ᵢ` and `-f~ᵢ`
  and negating `H`.
* `TauCeti.KacMoody.auxPositiveHom` and `TauCeti.KacMoody.auxNegativeHom`: the Lie homomorphisms
  from `FreeLieAlgebra K I` generated by `e~ᵢ` and `f~ᵢ`.
* `TauCeti.KacMoody.auxTriangularEquiv`: the linear isomorphism
  `FreeLieAlgebra K I × H × FreeLieAlgebra K I ≃ₗ[K] AuxiliaryLieAlgebra R`.

## Main results

* `TauCeti.KacMoody.toPresented_surjective`: `toPresented` is surjective.
* `TauCeti.KacMoody.auxCartanElement_injective`: `H` embeds injectively into `𝔤~(A)`.
* `TauCeti.KacMoody.auxPositiveHom_injective` and `TauCeti.KacMoody.auxNegativeHom_injective`:
  the raising and lowering subalgebras of `𝔤~(A)` are free Lie algebras on `I`.

## References

* V. G. Kac, *Infinite-dimensional Lie algebras*, third edition, Cambridge University Press,
  1990, §1.2, Theorem 1.2.
-/

public section

open LieAlgebra

namespace TauCeti

namespace KacMoody

variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H] {A : Matrix I I ℤ}
  (R : CartanRealization (A.map (Int.cast : ℤ → K)) H)

open _root_.FreeLieAlgebra Generator in
/-- The defining relators of Kac's auxiliary Lie algebra `𝔤~(A)` on a realization `R`: Cartan
linearity, commutativity of `H`, the root weights of `e~ⱼ` and `f~ⱼ`, and `⁅e~ᵢ, f~ⱼ⁆ = δᵢⱼ hᵢ`. -/
inductive IsAuxRelator : FreeLieAlgebra K (Generator I H) → Prop
  /-- Additivity of the Cartan generators. -/
  | cartan_add (x y : H) :
      IsAuxRelator (of K (cartan (x + y)) - of K (cartan x) - of K (cartan y))
  /-- Homogeneity of the Cartan generators. -/
  | cartan_smul (c : K) (x : H) : IsAuxRelator (of K (cartan (c • x)) - c • of K (cartan x))
  /-- The Cartan generators commute. -/
  | lie_cartan_cartan (x y : H) :
      IsAuxRelator ⁅of K (cartan x : Generator I H), of K (cartan y)⁆
  /-- `e~ⱼ` has weight `αⱼ`. -/
  | lie_cartan_positive (x : H) (j : I) :
      IsAuxRelator (⁅of K (cartan x : Generator I H), of K (positive j)⁆ -
        R.root j x • of K (positive j))
  /-- `f~ⱼ` has weight `-αⱼ`. -/
  | lie_cartan_negative (x : H) (j : I) :
      IsAuxRelator (⁅of K (cartan x : Generator I H), of K (negative j)⁆ +
        R.root j x • of K (negative j))
  /-- `⁅e~ᵢ, f~ᵢ⁆ = hᵢ`. -/
  | lie_positive_negative_self (i : I) :
      IsAuxRelator (⁅of K (positive i : Generator I H), of K (negative i)⁆ -
        of K (cartan (R.coroot i)))
  /-- `⁅e~ᵢ, f~ⱼ⁆ = 0` for `i ≠ j`. -/
  | lie_positive_negative_of_ne (i j : I) (hij : i ≠ j) :
      IsAuxRelator ⁅of K (positive i : Generator I H), of K (negative j)⁆

/-- Every relator of the auxiliary Lie algebra is a relator of the Serre-presented Kac–Moody
algebra. -/
theorem IsAuxRelator.isRelator {x : FreeLieAlgebra K (Generator I H)}
    (hx : IsAuxRelator R x) : IsRelator R x := by
  cases hx with
  | cartan_add x y => exact .cartan_add x y
  | cartan_smul c x => exact .cartan_smul c x
  | lie_cartan_cartan x y => exact .lie_cartan_cartan x y
  | lie_cartan_positive x j => exact .lie_cartan_positive x j
  | lie_cartan_negative x j => exact .lie_cartan_negative x j
  | lie_positive_negative_self i => exact .lie_positive_negative_self i
  | lie_positive_negative_of_ne i j hij => exact .lie_positive_negative_of_ne i j hij

/-- The Lie ideal of the free Lie algebra generated by `TauCeti.KacMoody.IsAuxRelator`. -/
noncomputable def auxPresentationIdeal : LieIdeal K (FreeLieAlgebra K (Generator I H)) :=
  LieSubmodule.lieSpan K _ {x | IsAuxRelator R x}

/-- Unfolding characterization of `auxPresentationIdeal`. -/
theorem auxPresentationIdeal_def :
    auxPresentationIdeal R = LieSubmodule.lieSpan K _ {x | IsAuxRelator R x} := (rfl)

/-- Kac's auxiliary Lie algebra `𝔤~(A)` of the realization `R`, prior to imposing Serre's
relations. -/
def AuxiliaryLieAlgebra : Type _ :=
  FreeLieAlgebra K (Generator I H) ⧸ auxPresentationIdeal R

noncomputable instance : LieRing (AuxiliaryLieAlgebra R) :=
  inferInstanceAs (LieRing (FreeLieAlgebra K (Generator I H) ⧸ auxPresentationIdeal R))

noncomputable instance : LieAlgebra K (AuxiliaryLieAlgebra R) :=
  inferInstanceAs (LieAlgebra K (FreeLieAlgebra K (Generator I H) ⧸ auxPresentationIdeal R))

/-! ## Generators and universal property -/

/-- The quotient map presenting `TauCeti.KacMoody.AuxiliaryLieAlgebra R`. -/
noncomputable def auxPresentationMk :
    FreeLieAlgebra K (Generator I H) →ₗ⁅K⁆ AuxiliaryLieAlgebra R :=
  LieIdeal.mkQ (auxPresentationIdeal R)

@[simp]
theorem ker_auxPresentationMk : (auxPresentationMk R).ker = auxPresentationIdeal R :=
  LieIdeal.mkQ_ker _

theorem auxPresentationMk_surjective : Function.Surjective (auxPresentationMk R) :=
  (auxPresentationIdeal R).surjective_mkQ

theorem auxPresentationMk_eq_zero_of_isAuxRelator {x : FreeLieAlgebra K (Generator I H)}
    (hx : IsAuxRelator R x) : auxPresentationMk R x = 0 :=
  (LieIdeal.mkQ_apply _ x).trans
    (LieSubmodule.Quotient.mk_eq_zero'.mpr (LieSubmodule.subset_lieSpan hx))

/-- The canonical linear map from `H` into the auxiliary Lie algebra `𝔤~(A)`. -/
noncomputable def auxCartanElement : H →ₗ[K] AuxiliaryLieAlgebra R where
  toFun x := auxPresentationMk R (FreeLieAlgebra.of K (Generator.cartan x))
  map_add' x y := by
    have h := auxPresentationMk_eq_zero_of_isAuxRelator R (.cartan_add x y)
    rwa [map_sub, map_sub, sub_sub, sub_eq_zero] at h
  map_smul' c x := by
    have h := auxPresentationMk_eq_zero_of_isAuxRelator R (.cartan_smul c x)
    rwa [map_sub, map_smul, sub_eq_zero] at h

/-- The raising generator `e~ᵢ` of the auxiliary Lie algebra. -/
noncomputable def auxPositiveGenerator (i : I) : AuxiliaryLieAlgebra R :=
  auxPresentationMk R (FreeLieAlgebra.of K (Generator.positive i))

/-- The lowering generator `f~ᵢ` of the auxiliary Lie algebra. -/
noncomputable def auxNegativeGenerator (i : I) : AuxiliaryLieAlgebra R :=
  auxPresentationMk R (FreeLieAlgebra.of K (Generator.negative i))

@[simp]
theorem auxPresentationMk_of_cartan (x : H) :
    auxPresentationMk R (FreeLieAlgebra.of K (Generator.cartan x)) = auxCartanElement R x := (rfl)

@[simp]
theorem auxPresentationMk_of_positive (i : I) :
    auxPresentationMk R (FreeLieAlgebra.of K (Generator.positive i)) =
      auxPositiveGenerator R i := (rfl)

@[simp]
theorem auxPresentationMk_of_negative (i : I) :
    auxPresentationMk R (FreeLieAlgebra.of K (Generator.negative i)) =
      auxNegativeGenerator R i := (rfl)

@[simp]
theorem lie_auxCartanElement_auxCartanElement (x y : H) :
    ⁅auxCartanElement R x, auxCartanElement R y⁆ = 0 := by
  simpa using auxPresentationMk_eq_zero_of_isAuxRelator R (.lie_cartan_cartan x y)

@[simp]
theorem lie_auxCartanElement_auxPositiveGenerator (x : H) (j : I) :
    ⁅auxCartanElement R x, auxPositiveGenerator R j⁆ = R.root j x • auxPositiveGenerator R j := by
  simpa [sub_eq_zero] using auxPresentationMk_eq_zero_of_isAuxRelator R (.lie_cartan_positive x j)

@[simp]
theorem lie_auxCartanElement_auxNegativeGenerator (x : H) (j : I) :
    ⁅auxCartanElement R x, auxNegativeGenerator R j⁆ =
      -(R.root j x • auxNegativeGenerator R j) := by
  simpa [add_eq_zero_iff_eq_neg] using
    auxPresentationMk_eq_zero_of_isAuxRelator R (.lie_cartan_negative x j)

@[simp]
theorem lie_auxPositiveGenerator_auxNegativeGenerator_self (i : I) :
    ⁅auxPositiveGenerator R i, auxNegativeGenerator R i⁆ = auxCartanElement R (R.coroot i) := by
  simpa [sub_eq_zero] using
    auxPresentationMk_eq_zero_of_isAuxRelator R (.lie_positive_negative_self i)

@[simp]
theorem lie_auxPositiveGenerator_auxNegativeGenerator_of_ne {i j : I} (hij : i ≠ j) :
    ⁅auxPositiveGenerator R i, auxNegativeGenerator R j⁆ = 0 := by
  simpa using auxPresentationMk_eq_zero_of_isAuxRelator R (.lie_positive_negative_of_ne i j hij)

section UniversalProperty

variable {L : Type*} [LieRing L] [LieAlgebra K L]

/-- A linear map `φ : H →ₗ[K] L` and families `E`, `F : I → L` satisfy the auxiliary Kac–Moody
relations when `φ(H)` is abelian, `E j` and `F j` have weights `±αⱼ`, and
`⁅E i, F j⁆ = δᵢⱼ φ(hᵢ)`. -/
structure SatisfiesAuxRelations (φ : H →ₗ[K] L) (E F : I → L) : Prop where
  /-- The image of `H` is abelian. -/
  lie_cartan_cartan : ∀ x y, ⁅φ x, φ y⁆ = 0
  /-- `E j` has weight `αⱼ`. -/
  lie_cartan_positive : ∀ x j, ⁅φ x, E j⁆ = R.root j x • E j
  /-- `F j` has weight `-αⱼ`. -/
  lie_cartan_negative : ∀ x j, ⁅φ x, F j⁆ = -(R.root j x • F j)
  /-- `⁅E i, F i⁆` is the image of `hᵢ`. -/
  lie_positive_negative_self : ∀ i, ⁅E i, F i⁆ = φ (R.coroot i)
  /-- `E i` and `F j` commute for `i ≠ j`. -/
  lie_positive_negative_of_ne : ∀ i j, i ≠ j → ⁅E i, F j⁆ = 0

/-- The generators of the auxiliary Lie algebra satisfy its defining relations. -/
theorem satisfiesAuxRelations_generators :
    SatisfiesAuxRelations R (auxCartanElement R) (auxPositiveGenerator R)
      (auxNegativeGenerator R) where
  lie_cartan_cartan := lie_auxCartanElement_auxCartanElement R
  lie_cartan_positive := lie_auxCartanElement_auxPositiveGenerator R
  lie_cartan_negative := lie_auxCartanElement_auxNegativeGenerator R
  lie_positive_negative_self := lie_auxPositiveGenerator_auxNegativeGenerator_self R
  lie_positive_negative_of_ne _ _ := lie_auxPositiveGenerator_auxNegativeGenerator_of_ne R

variable {R}

/-- Data satisfying the full Kac–Moody relations also satisfy the auxiliary relations. -/
theorem SatisfiesRelations.toSatisfiesAuxRelations {φ : H →ₗ[K] L} {E F : I → L}
    (h : SatisfiesRelations R φ E F) : SatisfiesAuxRelations R φ E F where
  lie_cartan_cartan := h.lie_cartan_cartan
  lie_cartan_positive := h.lie_cartan_positive
  lie_cartan_negative := h.lie_cartan_negative
  lie_positive_negative_self := h.lie_positive_negative_self
  lie_positive_negative_of_ne := h.lie_positive_negative_of_ne

/-- Auxiliary relations are preserved under signed exchange `(φ, E, F) ↦ (-φ, -F, -E)`. -/
theorem SatisfiesAuxRelations.neg_swap {φ : H →ₗ[K] L} {E F : I → L}
    (h : SatisfiesAuxRelations R φ E F) : SatisfiesAuxRelations R (-φ) (-F) (-E) where
  lie_cartan_cartan x y := by simp [h.lie_cartan_cartan]
  lie_cartan_positive x j := by simp [h.lie_cartan_negative]
  lie_cartan_negative x j := by simp [h.lie_cartan_positive]
  lie_positive_negative_self i := by
    simp only [Pi.neg_apply, neg_lie, lie_neg, neg_neg, LinearMap.neg_apply]
    rw [← lie_skew, h.lie_positive_negative_self]
  lie_positive_negative_of_ne i j hij := by
    simp only [Pi.neg_apply, neg_lie, lie_neg, neg_neg]
    rw [← lie_skew, h.lie_positive_negative_of_ne j i hij.symm, neg_zero]

private def auxGeneratorMap (φ : H →ₗ[K] L) (E F : I → L) : Generator I H → L
  | .cartan x => φ x
  | .positive i => E i
  | .negative i => F i

private theorem auxPresentationIdeal_le_ker {φ : H →ₗ[K] L} {E F : I → L}
    (h : SatisfiesAuxRelations R φ E F) :
    auxPresentationIdeal R ≤ (FreeLieAlgebra.lift K (auxGeneratorMap φ E F)).ker := by
  refine LieSubmodule.lieSpan_le.mpr fun x hx => ?_
  rw [SetLike.mem_coe, LieHom.mem_ker]
  induction hx with
  | cartan_add x y => simp [auxGeneratorMap]
  | cartan_smul c x => simp [auxGeneratorMap]
  | lie_cartan_cartan x y => simpa [auxGeneratorMap] using h.lie_cartan_cartan x y
  | lie_cartan_positive x j => simpa [auxGeneratorMap, sub_eq_zero] using h.lie_cartan_positive x j
  | lie_cartan_negative x j =>
    simpa [auxGeneratorMap, add_eq_zero_iff_eq_neg] using h.lie_cartan_negative x j
  | lie_positive_negative_self i =>
    simpa [auxGeneratorMap, sub_eq_zero] using h.lie_positive_negative_self i
  | lie_positive_negative_of_ne i j hij =>
    simpa [auxGeneratorMap] using h.lie_positive_negative_of_ne i j hij

/-- The universal property of `TauCeti.KacMoody.AuxiliaryLieAlgebra`: data satisfying the auxiliary
relations induce a Lie algebra homomorphism out of `𝔤~(A)`. -/
noncomputable def auxLift {φ : H →ₗ[K] L} {E F : I → L} (h : SatisfiesAuxRelations R φ E F) :
    AuxiliaryLieAlgebra R →ₗ⁅K⁆ L :=
  (auxPresentationIdeal R).liftQ (FreeLieAlgebra.lift K (auxGeneratorMap φ E F))
    (auxPresentationIdeal_le_ker h)

private theorem auxLift_auxPresentationMk {φ : H →ₗ[K] L} {E F : I → L}
    (h : SatisfiesAuxRelations R φ E F) (g : Generator I H) :
    auxLift h (auxPresentationMk R (FreeLieAlgebra.of K g)) = auxGeneratorMap φ E F g :=
  (LieIdeal.liftQ_apply _ _ _ _).trans (FreeLieAlgebra.lift_of_apply _ _)

@[simp]
theorem auxLift_auxCartanElement {φ : H →ₗ[K] L} {E F : I → L}
    (h : SatisfiesAuxRelations R φ E F) (x : H) :
    auxLift h (auxCartanElement R x) = φ x :=
  auxLift_auxPresentationMk h (Generator.cartan x)

@[simp]
theorem auxLift_auxPositiveGenerator {φ : H →ₗ[K] L} {E F : I → L}
    (h : SatisfiesAuxRelations R φ E F) (i : I) :
    auxLift h (auxPositiveGenerator R i) = E i :=
  auxLift_auxPresentationMk h (Generator.positive i)

@[simp]
theorem auxLift_auxNegativeGenerator {φ : H →ₗ[K] L} {E F : I → L}
    (h : SatisfiesAuxRelations R φ E F) (i : I) :
    auxLift h (auxNegativeGenerator R i) = F i :=
  auxLift_auxPresentationMk h (Generator.negative i)

/-- Two homomorphisms out of the auxiliary Lie algebra agreeing on the generators are equal. -/
@[ext]
theorem aux_hom_ext {g₁ g₂ : AuxiliaryLieAlgebra R →ₗ⁅K⁆ L}
    (hH : ∀ x, g₁ (auxCartanElement R x) = g₂ (auxCartanElement R x))
    (hE : ∀ i, g₁ (auxPositiveGenerator R i) = g₂ (auxPositiveGenerator R i))
    (hF : ∀ i, g₁ (auxNegativeGenerator R i) = g₂ (auxNegativeGenerator R i)) : g₁ = g₂ := by
  refine (auxPresentationIdeal R).lieHom_qext fun x => ?_
  have hcomp : g₁.comp (auxPresentationMk R) = g₂.comp (auxPresentationMk R) := by
    refine FreeLieAlgebra.hom_ext fun g => ?_
    cases g with
    | cartan x => exact hH x
    | positive i => exact hE i
    | negative i => exact hF i
  exact DFunLike.congr_fun hcomp x

end UniversalProperty

/-- The Cartan, raising and lowering generators generate `AuxiliaryLieAlgebra R` as a Lie
algebra. -/
theorem lieSpan_auxGenerators_eq_top :
    LieSubalgebra.lieSpan K (AuxiliaryLieAlgebra R) (Set.range (auxCartanElement R) ∪
      Set.range (auxPositiveGenerator R) ∪ Set.range (auxNegativeGenerator R)) = ⊤ := by
  set S := LieSubalgebra.lieSpan K (AuxiliaryLieAlgebra R) (Set.range (auxCartanElement R) ∪
    Set.range (auxPositiveGenerator R) ∪ Set.range (auxNegativeGenerator R))
  have hle : LieSubalgebra.lieSpan K (FreeLieAlgebra K (Generator I H))
      (Set.range (FreeLieAlgebra.of K)) ≤ S.comap (auxPresentationMk R) := by
    refine LieSubalgebra.lieSpan_le.mpr ?_
    rintro _ ⟨g, rfl⟩
    refine LieSubalgebra.subset_lieSpan ?_
    cases g with
    | cartan x => exact Or.inl (Or.inl ⟨x, rfl⟩)
    | positive i => exact Or.inl (Or.inr ⟨i, rfl⟩)
    | negative i => exact Or.inr ⟨i, rfl⟩
  refine eq_top_iff.2 fun y _ => ?_
  obtain ⟨x, rfl⟩ := auxPresentationMk_surjective R y
  exact hle (by rw [FreeLieAlgebra.lieSpan_range_of_eq_top]; trivial)

/-- The canonical quotient homomorphism from the auxiliary Lie algebra `𝔤~(A)` onto the
Serre-presented Kac–Moody algebra `PresentedLieAlgebra R`. -/
noncomputable def toPresented : AuxiliaryLieAlgebra R →ₗ⁅K⁆ PresentedLieAlgebra R :=
  auxLift (satisfiesRelations_generators R).toSatisfiesAuxRelations

@[simp]
theorem toPresented_auxCartanElement (x : H) :
    toPresented R (auxCartanElement R x) = cartanElement R x :=
  auxLift_auxCartanElement _ x

@[simp]
theorem toPresented_auxPositiveGenerator (i : I) :
    toPresented R (auxPositiveGenerator R i) = positiveGenerator R i :=
  auxLift_auxPositiveGenerator _ i

@[simp]
theorem toPresented_auxNegativeGenerator (i : I) :
    toPresented R (auxNegativeGenerator R i) = negativeGenerator R i :=
  auxLift_auxNegativeGenerator _ i

@[simp]
theorem toPresented_comp_auxPresentationMk :
    (toPresented R).comp (auxPresentationMk R) = presentationMk R := by
  refine FreeLieAlgebra.hom_ext fun g => ?_
  cases g <;> simp

/-- `toPresented` is surjective: every element of `PresentedLieAlgebra R` lifts to `𝔤~(A)`. -/
theorem toPresented_surjective : Function.Surjective (toPresented R) := fun y => by
  obtain ⟨x, rfl⟩ := presentationMk_surjective R y
  exact ⟨auxPresentationMk R x, DFunLike.congr_fun (toPresented_comp_auxPresentationMk R) x⟩

/-- The Chevalley involution of `AuxiliaryLieAlgebra R`, negating `H` and exchanging `e~ᵢ` with
`-f~ᵢ`. -/
noncomputable def auxChevalleyInvolution :
    AuxiliaryLieAlgebra R ≃ₗ⁅K⁆ AuxiliaryLieAlgebra R :=
  let f := auxLift (satisfiesAuxRelations_generators R).neg_swap
  have hf : f.comp f = LieHom.id := by ext <;> simp [f]
  { f with
    invFun := f
    left_inv := fun z => DFunLike.congr_fun hf z
    right_inv := fun z => DFunLike.congr_fun hf z }

@[simp]
theorem auxChevalleyInvolution_auxCartanElement (x : H) :
    auxChevalleyInvolution R (auxCartanElement R x) = -auxCartanElement R x :=
  auxLift_auxCartanElement (satisfiesAuxRelations_generators R).neg_swap x

@[simp]
theorem auxChevalleyInvolution_auxPositiveGenerator (i : I) :
    auxChevalleyInvolution R (auxPositiveGenerator R i) = -auxNegativeGenerator R i :=
  auxLift_auxPositiveGenerator (satisfiesAuxRelations_generators R).neg_swap i

@[simp]
theorem auxChevalleyInvolution_auxNegativeGenerator (i : I) :
    auxChevalleyInvolution R (auxNegativeGenerator R i) = -auxPositiveGenerator R i :=
  auxLift_auxNegativeGenerator (satisfiesAuxRelations_generators R).neg_swap i

@[simp]
theorem auxChevalleyInvolution_symm :
    (auxChevalleyInvolution R).symm = auxChevalleyInvolution R := by
  ext z
  rfl

@[simp]
theorem auxChevalleyInvolution_apply_apply (z : AuxiliaryLieAlgebra R) :
    auxChevalleyInvolution R (auxChevalleyInvolution R z) = z := by
  simpa only [auxChevalleyInvolution_symm] using (auxChevalleyInvolution R).symm_apply_apply z

/-! ## Triangular spanning of the auxiliary Lie algebra -/

/-- The Lie homomorphism from the free Lie algebra on `I` sending `i` to `e~ᵢ`. -/
noncomputable def auxPositiveHom : FreeLieAlgebra K I →ₗ⁅K⁆ AuxiliaryLieAlgebra R :=
  FreeLieAlgebra.lift K (auxPositiveGenerator R)

/-- The Lie homomorphism from the free Lie algebra on `I` sending `i` to `f~ᵢ`. -/
noncomputable def auxNegativeHom : FreeLieAlgebra K I →ₗ⁅K⁆ AuxiliaryLieAlgebra R :=
  FreeLieAlgebra.lift K (auxNegativeGenerator R)

@[simp]
theorem auxPositiveHom_of (i : I) :
    auxPositiveHom R (FreeLieAlgebra.of K i) = auxPositiveGenerator R i :=
  FreeLieAlgebra.lift_of_apply _ i

@[simp]
theorem auxNegativeHom_of (i : I) :
    auxNegativeHom R (FreeLieAlgebra.of K i) = auxNegativeGenerator R i :=
  FreeLieAlgebra.lift_of_apply _ i

/-- The image of `auxPositiveHom R` is the Lie subalgebra generated by the `e~ᵢ`. -/
theorem range_auxPositiveHom :
    (auxPositiveHom R).range =
      LieSubalgebra.lieSpan K (AuxiliaryLieAlgebra R) (Set.range (auxPositiveGenerator R)) :=
  FreeLieAlgebra.range_lift (auxPositiveGenerator R)

/-- The image of `auxNegativeHom R` is the Lie subalgebra generated by the `f~ᵢ`. -/
theorem range_auxNegativeHom :
    (auxNegativeHom R).range =
      LieSubalgebra.lieSpan K (AuxiliaryLieAlgebra R) (Set.range (auxNegativeGenerator R)) :=
  FreeLieAlgebra.range_lift (auxNegativeGenerator R)

/-- The triangular addition map `(uNeg, x, uPos) ↦ auxNegativeHom uNeg + auxCartanElement x +
auxPositiveHom uPos`. -/
noncomputable def auxTriangularMap :
    (FreeLieAlgebra K I × H × FreeLieAlgebra K I) →ₗ[K] AuxiliaryLieAlgebra R where
  toFun p := auxNegativeHom R p.1 + auxCartanElement R p.2.1 + auxPositiveHom R p.2.2
  map_add' p q := by
    simp only [Prod.fst_add, Prod.snd_add, map_add]
    abel
  map_smul' c p := by
    simp only [Prod.smul_fst, Prod.smul_snd, map_smul, RingHom.id_apply, smul_add]

@[simp]
theorem auxTriangularMap_apply (uNeg : FreeLieAlgebra K I) (x : H) (uPos : FreeLieAlgebra K I) :
    auxTriangularMap R (uNeg, x, uPos) =
      auxNegativeHom R uNeg + auxCartanElement R x + auxPositiveHom R uPos := (rfl)

theorem auxChevalleyInvolution_auxPositiveHom (u : FreeLieAlgebra K I) :
    auxChevalleyInvolution R (auxPositiveHom R u) =
      auxNegativeHom R (FreeLieAlgebra.lift K (fun i => -FreeLieAlgebra.of K i) u) := by
  have h : (auxChevalleyInvolution R).toLieHom.comp (auxPositiveHom R) =
      (auxNegativeHom R).comp (FreeLieAlgebra.lift K fun i => -FreeLieAlgebra.of K i) := by
    refine FreeLieAlgebra.hom_ext fun i => ?_
    simp
  exact DFunLike.congr_fun h u

theorem auxChevalleyInvolution_auxNegativeHom (u : FreeLieAlgebra K I) :
    auxChevalleyInvolution R (auxNegativeHom R u) =
      auxPositiveHom R (FreeLieAlgebra.lift K (fun i => -FreeLieAlgebra.of K i) u) := by
  have h : (auxChevalleyInvolution R).toLieHom.comp (auxNegativeHom R) =
      (auxPositiveHom R).comp (FreeLieAlgebra.lift K fun i => -FreeLieAlgebra.of K i) := by
    refine FreeLieAlgebra.hom_ext fun i => ?_
    simp
  exact DFunLike.congr_fun h u

/-- The image of `H` normalizes the raising subalgebra `n~⁺` of `AuxiliaryLieAlgebra R`. -/
theorem lie_mem_range_auxPositiveHom_of_mem_range_auxCartanElement
    {u z : AuxiliaryLieAlgebra R} (hu : u ∈ LinearMap.range (auxCartanElement R))
    (hz : z ∈ (auxPositiveHom R).range) : ⁅u, z⁆ ∈ (auxPositiveHom R).range := by
  obtain ⟨x, rfl⟩ := hu
  rw [range_auxPositiveHom] at hz ⊢
  refine LieSubalgebra.lie_mem_of_mem_lieSpan ?_ hz
  rintro _ ⟨j, rfl⟩
  rw [lie_auxCartanElement_auxPositiveGenerator]
  exact LieSubalgebra.smul_mem _ _ (LieSubalgebra.subset_lieSpan ⟨j, rfl⟩)

/-- The image of `H` normalizes the lowering subalgebra `n~⁻` of `AuxiliaryLieAlgebra R`. -/
theorem lie_mem_range_auxNegativeHom_of_mem_range_auxCartanElement
    {u z : AuxiliaryLieAlgebra R} (hu : u ∈ LinearMap.range (auxCartanElement R))
    (hz : z ∈ (auxNegativeHom R).range) : ⁅u, z⁆ ∈ (auxNegativeHom R).range := by
  obtain ⟨x, rfl⟩ := hu
  rw [range_auxNegativeHom] at hz ⊢
  refine LieSubalgebra.lie_mem_of_mem_lieSpan ?_ hz
  rintro _ ⟨j, rfl⟩
  rw [lie_auxCartanElement_auxNegativeGenerator]
  exact neg_mem (LieSubalgebra.smul_mem _ _ (LieSubalgebra.subset_lieSpan ⟨j, rfl⟩))

/-- `ad e~ᵢ` carries the lowering subalgebra `n~⁻` into `n~⁻ + H`. -/
theorem lie_auxPositive_mem_sup (i : I) {y : AuxiliaryLieAlgebra R}
    (hy : y ∈ (auxNegativeHom R).range) :
    ⁅auxPositiveGenerator R i, y⁆ ∈
      (auxNegativeHom R).range.toSubmodule ⊔ LinearMap.range (auxCartanElement R) := by
  rw [range_auxNegativeHom] at hy ⊢
  refine LieSubalgebra.lie_mem_sup_of_mem_lieSpan
    (fun u hu z hz => by
      rw [← range_auxNegativeHom] at hz ⊢
      exact lie_mem_range_auxNegativeHom_of_mem_range_auxCartanElement R hu hz) ?_ hy
  rintro _ ⟨j, rfl⟩
  rcases eq_or_ne i j with rfl | hij
  · rw [lie_auxPositiveGenerator_auxNegativeGenerator_self]
    exact Submodule.mem_sup_right ⟨R.coroot i, rfl⟩
  · rw [lie_auxPositiveGenerator_auxNegativeGenerator_of_ne R hij]
    exact zero_mem _

/-- `ad f~ᵢ` carries the raising subalgebra `n~⁺` into `n~⁺ + H`. -/
theorem lie_auxNegative_mem_sup (i : I) {y : AuxiliaryLieAlgebra R}
    (hy : y ∈ (auxPositiveHom R).range) :
    ⁅auxNegativeGenerator R i, y⁆ ∈
      (auxPositiveHom R).range.toSubmodule ⊔ LinearMap.range (auxCartanElement R) := by
  rw [range_auxPositiveHom] at hy ⊢
  refine LieSubalgebra.lie_mem_sup_of_mem_lieSpan
    (fun u hu z hz => by
      rw [← range_auxPositiveHom] at hz ⊢
      exact lie_mem_range_auxPositiveHom_of_mem_range_auxCartanElement R hu hz) ?_ hy
  rintro _ ⟨j, rfl⟩
  rw [← lie_skew]
  rcases eq_or_ne j i with rfl | hji
  · rw [lie_auxPositiveGenerator_auxNegativeGenerator_self]
    exact Submodule.mem_sup_right (neg_mem ⟨R.coroot j, rfl⟩)
  · rw [lie_auxPositiveGenerator_auxNegativeGenerator_of_ne R hji, neg_zero]
    exact zero_mem _

private theorem lie_mem_triangularSup_of_mem_auxGenerators {g v : AuxiliaryLieAlgebra R}
    (hg : g ∈ Set.range (auxCartanElement R) ∪ Set.range (auxPositiveGenerator R) ∪
      Set.range (auxNegativeGenerator R))
    (hv : v ∈ (auxNegativeHom R).range.toSubmodule ⊔ LinearMap.range (auxCartanElement R) ⊔
      (auxPositiveHom R).range.toSubmodule) :
    ⁅g, v⁆ ∈ (auxNegativeHom R).range.toSubmodule ⊔ LinearMap.range (auxCartanElement R) ⊔
      (auxPositiveHom R).range.toSubmodule := by
  have hFV : ∀ y ∈ (auxNegativeHom R).range, y ∈
      (auxNegativeHom R).range.toSubmodule ⊔ LinearMap.range (auxCartanElement R) ⊔
        (auxPositiveHom R).range.toSubmodule := fun _ hy =>
    Submodule.mem_sup_left (Submodule.mem_sup_left hy)
  have hHV : ∀ y ∈ LinearMap.range (auxCartanElement R), y ∈
      (auxNegativeHom R).range.toSubmodule ⊔ LinearMap.range (auxCartanElement R) ⊔
        (auxPositiveHom R).range.toSubmodule := fun _ hy =>
    Submodule.mem_sup_left (Submodule.mem_sup_right hy)
  have hEV : ∀ y ∈ (auxPositiveHom R).range, y ∈
      (auxNegativeHom R).range.toSubmodule ⊔ LinearMap.range (auxCartanElement R) ⊔
        (auxPositiveHom R).range.toSubmodule := fun _ hy => Submodule.mem_sup_right hy
  rcases hg with (⟨x, rfl⟩ | ⟨i, rfl⟩) | ⟨i, rfl⟩
  · obtain ⟨ab, hab, c, hc, rfl⟩ := Submodule.mem_sup.1 hv
    obtain ⟨a, ha, _, ⟨y, rfl⟩, rfl⟩ := Submodule.mem_sup.1 hab
    rw [lie_add, lie_add, lie_auxCartanElement_auxCartanElement, add_zero]
    exact add_mem (hFV _ (lie_mem_range_auxNegativeHom_of_mem_range_auxCartanElement R ⟨x, rfl⟩ ha))
      (hEV _ (lie_mem_range_auxPositiveHom_of_mem_range_auxCartanElement R ⟨x, rfl⟩ hc))
  · obtain ⟨ab, hab, c, hc, rfl⟩ := Submodule.mem_sup.1 hv
    obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.1 hab
    rw [lie_add, lie_add, ← lie_skew _ b]
    refine add_mem (add_mem (Submodule.mem_sup_left (lie_auxPositive_mem_sup R i ha))
      (neg_mem (hEV _ (lie_mem_range_auxPositiveHom_of_mem_range_auxCartanElement R hb
        ⟨FreeLieAlgebra.of K i, auxPositiveHom_of R i⟩)))) ?_
    exact hEV _ (LieSubalgebra.lie_mem _ ⟨FreeLieAlgebra.of K i, auxPositiveHom_of R i⟩ hc)
  · obtain ⟨ab, hab, c, hc, rfl⟩ := Submodule.mem_sup.1 hv
    obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.1 hab
    rw [lie_add, lie_add, ← lie_skew _ b]
    obtain ⟨c', hc', b', hb', hcb'⟩ := Submodule.mem_sup.1 (lie_auxNegative_mem_sup R i hc)
    rw [← hcb']
    refine add_mem (add_mem ?_ ?_) (add_mem (hEV _ hc') (hHV _ hb'))
    · exact hFV _ (LieSubalgebra.lie_mem _ ⟨FreeLieAlgebra.of K i, auxNegativeHom_of R i⟩ ha)
    · exact neg_mem (hFV _ (lie_mem_range_auxNegativeHom_of_mem_range_auxCartanElement R hb
        ⟨FreeLieAlgebra.of K i, auxNegativeHom_of R i⟩))

/-- The auxiliary Lie algebra is the sum `n~⁻ + H + n~⁺`. -/
theorem range_auxNegativeHom_sup_range_auxCartanElement_sup_range_auxPositiveHom :
    (auxNegativeHom R).range.toSubmodule ⊔ LinearMap.range (auxCartanElement R) ⊔
      (auxPositiveHom R).range.toSubmodule = ⊤ := by
  set V := (auxNegativeHom R).range.toSubmodule ⊔ LinearMap.range (auxCartanElement R) ⊔
    (auxPositiveHom R).range.toSubmodule
  let V' : LieSubalgebra K (AuxiliaryLieAlgebra R) :=
    { V with
      lie_mem' := fun {x y} hxV hy => by
        clear hxV
        have hx : x ∈ LieSubalgebra.lieSpan K (AuxiliaryLieAlgebra R)
            (Set.range (auxCartanElement R) ∪ Set.range (auxPositiveGenerator R) ∪
              Set.range (auxNegativeGenerator R)) := by
          rw [lieSpan_auxGenerators_eq_top]
          trivial
        induction hx using LieSubalgebra.lieSpan_induction generalizing y with
        | mem g hg => exact lie_mem_triangularSup_of_mem_auxGenerators R hg hy
        | zero => simp
        | add a b _ _ ha hb => rw [add_lie]; exact V.add_mem (ha hy) (hb hy)
        | smul c a _ ha => rw [smul_lie]; exact V.smul_mem c (ha hy)
        | lie a b _ _ ha hb => rw [lie_lie]; exact V.sub_mem (ha (hb hy)) (hb (ha hy)) }
  have hle : (⊤ : LieSubalgebra K (AuxiliaryLieAlgebra R)) ≤ V' := by
    rw [← lieSpan_auxGenerators_eq_top, LieSubalgebra.lieSpan_le]
    rintro _ ((⟨x, rfl⟩ | ⟨i, rfl⟩) | ⟨i, rfl⟩)
    · exact Submodule.mem_sup_left (Submodule.mem_sup_right ⟨x, rfl⟩)
    · exact Submodule.mem_sup_right ⟨FreeLieAlgebra.of K i, auxPositiveHom_of R i⟩
    · exact Submodule.mem_sup_left
        (Submodule.mem_sup_left ⟨FreeLieAlgebra.of K i, auxNegativeHom_of R i⟩)
  exact eq_top_iff.2 fun z _ => hle (LieSubalgebra.mem_top z)

/-- Every element of `AuxiliaryLieAlgebra R` is in the range of `auxTriangularMap R`. -/
theorem auxTriangularMap_surjective : Function.Surjective (auxTriangularMap R) := fun z => by
  have hz : z ∈ (auxNegativeHom R).range.toSubmodule ⊔ LinearMap.range (auxCartanElement R) ⊔
      (auxPositiveHom R).range.toSubmodule := by
    rw [range_auxNegativeHom_sup_range_auxCartanElement_sup_range_auxPositiveHom]
    trivial
  obtain ⟨ab, hab, _, ⟨uPos, rfl⟩, rfl⟩ := Submodule.mem_sup.1 hz
  obtain ⟨_, ⟨uNeg, rfl⟩, _, ⟨x, rfl⟩, rfl⟩ := Submodule.mem_sup.1 hab
  exact ⟨(uNeg, x, uPos), rfl⟩

/-! ## Kac's representation on the free associative algebra (Theorem 1.2) -/

section FreeAlgebraRep

attribute [local instance 100] LieRing.ofAssociativeRing

/-- Weight functional `λ - ∑_{m ∈ l} αₘ` of a word `l` on `H`. -/
private def wordWeight (lam : Module.Dual K H) : List I → Module.Dual K H
  | [] => lam
  | j :: l => wordWeight lam l - R.root j

private noncomputable def hEnd (lam : Module.Dual K H) :
    H →ₗ[K] Module.End K (FreeAlgebra K I) where
  toFun x := (FreeAlgebra.basisFreeMonoid K I).constr K fun w =>
    wordWeight R lam w.toList x • FreeAlgebra.basisFreeMonoid K I w
  map_add' x y :=
    (FreeAlgebra.basisFreeMonoid K I).ext fun w => by
      simp only [Module.Basis.constr_basis, map_add, LinearMap.add_apply, add_smul]
  map_smul' c x :=
    (FreeAlgebra.basisFreeMonoid K I).ext fun w => by
      simp only [Module.Basis.constr_basis, map_smul, smul_eq_mul, LinearMap.smul_apply,
        mul_smul, RingHom.id_apply]

private theorem hEnd_basisFreeMonoid (lam : Module.Dual K H) (x : H) (w : FreeMonoid I) :
    hEnd R lam x (FreeAlgebra.basisFreeMonoid K I w) =
      wordWeight R lam w.toList x • FreeAlgebra.basisFreeMonoid K I w :=
  (FreeAlgebra.basisFreeMonoid K I).constr_basis K _ w

private theorem lie_hEnd_hEnd (lam : Module.Dual K H) (x y : H) :
    ⁅hEnd R lam x, hEnd R lam y⁆ = 0 := by
  refine (FreeAlgebra.basisFreeMonoid K I).ext fun w => ?_
  simp only [LieRing.of_associative_ring_bracket, LinearMap.sub_apply, mul_apply_eq_comp,
    hEnd_basisFreeMonoid, map_smul, LinearMap.zero_apply]
  rw [smul_smul, smul_smul, mul_comm, sub_self]

private theorem lie_hEnd_mulLeft_ι (lam : Module.Dual K H) (x : H) (j : I) :
    ⁅hEnd R lam x, LinearMap.mulLeft K (FreeAlgebra.ι K j)⁆ =
      -(R.root j x • LinearMap.mulLeft K (FreeAlgebra.ι K j)) := by
  have hmul (w : FreeMonoid I) :
      FreeAlgebra.ι K j * FreeAlgebra.basisFreeMonoid K I w =
        FreeAlgebra.basisFreeMonoid K I (FreeMonoid.of j * w) := by simp [basisFreeMonoid_apply]
  refine (FreeAlgebra.basisFreeMonoid K I).ext fun w => ?_
  simp only [LieRing.of_associative_ring_bracket, LinearMap.sub_apply, mul_apply_eq_comp,
    LinearMap.mulLeft_apply, hmul, hEnd_basisFreeMonoid, FreeMonoid.toList_mul,
    FreeMonoid.toList_of, List.singleton_append, wordWeight, map_smul, LinearMap.neg_apply,
    LinearMap.smul_apply]
  rw [sub_smul]
  abel

private theorem hEnd_mul_ι_apply (lam : Module.Dual K H) (x : H) (j : I) (u : FreeAlgebra K I) :
    hEnd R lam x (FreeAlgebra.ι K j * u) =
      FreeAlgebra.ι K j * hEnd R lam x u - R.root j x • (FreeAlgebra.ι K j * u) := by
  have h := LinearMap.congr_fun (lie_hEnd_mulLeft_ι R lam x j) u
  simp only [LieRing.of_associative_ring_bracket, LinearMap.sub_apply, mul_apply_eq_comp,
    LinearMap.mulLeft_apply, LinearMap.neg_apply, LinearMap.smul_apply] at h
  rw [sub_eq_iff_eq_add] at h
  rw [h, sub_eq_add_neg, add_comm]

private noncomputable def eWord [DecidableEq I] (lam : Module.Dual K H) (i : I) :
    List I → FreeAlgebra K I
  | [] => 0
  | j :: l =>
      FreeAlgebra.ι K j * eWord lam i l +
        if i = j then
          wordWeight R lam l (R.coroot i) • FreeAlgebra.basisFreeMonoid K I (FreeMonoid.ofList l)
        else 0

private noncomputable def eEnd [DecidableEq I] (lam : Module.Dual K H) (i : I) :
    Module.End K (FreeAlgebra K I) :=
  (FreeAlgebra.basisFreeMonoid K I).constr K fun w => eWord R lam i w.toList

private theorem eEnd_basisFreeMonoid [DecidableEq I] (lam : Module.Dual K H) (i : I)
    (w : FreeMonoid I) :
    eEnd R lam i (FreeAlgebra.basisFreeMonoid K I w) = eWord R lam i w.toList :=
  (FreeAlgebra.basisFreeMonoid K I).constr_basis K _ w

private theorem hEnd_eWord [DecidableEq I] (lam : Module.Dual K H) (x : H) (i : I) :
    ∀ l : List I,
      hEnd R lam x (eWord R lam i l) =
        (wordWeight R lam l x + R.root i x) • eWord R lam i l
  | [] => by simp [eWord]
  | j :: l => by
    simp only [eWord, map_add, hEnd_mul_ι_apply, hEnd_eWord lam x i l, mul_smul_comm, smul_add]
    congr 1
    · simp only [wordWeight, LinearMap.sub_apply, ← sub_smul]
      exact congrArg (· • _) (by abel)
    · split_ifs with hij
      · subst hij
        simp only [map_smul, hEnd_basisFreeMonoid, wordWeight, LinearMap.sub_apply, sub_add_cancel]
        rw [smul_smul, smul_smul, mul_comm]
      · simp

private theorem satisfiesAuxRelations_freeAlgebra [DecidableEq I] (lam : Module.Dual K H) :
    SatisfiesAuxRelations R (hEnd R lam) (eEnd R lam)
      (fun j => LinearMap.mulLeft K (FreeAlgebra.ι K j)) :=
  have hmul (j : I) (w : FreeMonoid I) :
      FreeAlgebra.ι K j * FreeAlgebra.basisFreeMonoid K I w =
        FreeAlgebra.basisFreeMonoid K I (FreeMonoid.of j * w) := by simp [basisFreeMonoid_apply]
  { lie_cartan_cartan := lie_hEnd_hEnd R lam
    lie_cartan_positive x i := (FreeAlgebra.basisFreeMonoid K I).ext fun w => by
      simp only [LieRing.of_associative_ring_bracket, LinearMap.sub_apply, mul_apply_eq_comp,
        eEnd_basisFreeMonoid, hEnd_basisFreeMonoid, map_smul, hEnd_eWord, LinearMap.smul_apply]
      rw [add_smul, add_sub_cancel_left]
    lie_cartan_negative := lie_hEnd_mulLeft_ι R lam
    lie_positive_negative_self i := (FreeAlgebra.basisFreeMonoid K I).ext fun w => by
      simp only [LieRing.of_associative_ring_bracket, LinearMap.sub_apply, mul_apply_eq_comp,
        LinearMap.mulLeft_apply, hmul, eEnd_basisFreeMonoid, FreeMonoid.toList_mul,
        FreeMonoid.toList_of, List.singleton_append, eWord, ↓reduceIte,
        FreeMonoid.ofList_toList, hEnd_basisFreeMonoid, add_sub_cancel_left]
    lie_positive_negative_of_ne i j hij := (FreeAlgebra.basisFreeMonoid K I).ext fun w => by
      simp only [LieRing.of_associative_ring_bracket, LinearMap.sub_apply, mul_apply_eq_comp,
        LinearMap.mulLeft_apply, hmul, eEnd_basisFreeMonoid, FreeMonoid.toList_mul,
        FreeMonoid.toList_of, List.singleton_append, eWord, hij, ↓reduceIte, add_zero, sub_self,
        LinearMap.zero_apply] }

private theorem auxPositiveHom_apply_one [DecidableEq I] (lam : Module.Dual K H)
    (uPos : FreeLieAlgebra K I) :
    auxLift (satisfiesAuxRelations_freeAlgebra R lam) (auxPositiveHom R uPos) 1 = 0 := by
  have hmem : auxPositiveHom R uPos ∈
      LieSubalgebra.lieSpan K (AuxiliaryLieAlgebra R) (Set.range (auxPositiveGenerator R)) := by
    rw [← range_auxPositiveHom]
    exact ⟨uPos, rfl⟩
  have hone : FreeAlgebra.basisFreeMonoid K I 1 = 1 := by simp
  generalize auxPositiveHom R uPos = z at hmem ⊢
  induction hmem using LieSubalgebra.lieSpan_induction with
  | mem _ hg =>
    obtain ⟨i, rfl⟩ := hg
    rw [auxLift_auxPositiveGenerator, ← hone, eEnd_basisFreeMonoid, FreeMonoid.toList_one, eWord]
  | zero => simp
  | add _ _ _ _ ha hb => simp [ha, hb]
  | smul _ _ _ ha => simp [ha]
  | lie _ _ _ _ ha hb =>
    simp [LieHom.map_lie, LieRing.of_associative_ring_bracket, mul_apply_eq_comp, ha, hb]

private theorem auxNegativeHom_apply_one [DecidableEq I] (lam : Module.Dual K H)
    (uNeg : FreeLieAlgebra K I) :
    auxLift (satisfiesAuxRelations_freeAlgebra R lam) (auxNegativeHom R uNeg) 1 =
      FreeLieAlgebra.universalEnvelopingEquivFreeAlgebra K I
        (_root_.UniversalEnvelopingAlgebra.ι K uNeg) := by
  have hhom : (auxLift (satisfiesAuxRelations_freeAlgebra R lam)).comp (auxNegativeHom R) =
      (Algebra.lmul K (FreeAlgebra K I)).toLieHom.comp
        ((FreeLieAlgebra.universalEnvelopingEquivFreeAlgebra K I).toAlgHom.toLieHom.comp
          (_root_.UniversalEnvelopingAlgebra.ι K)) := by
    refine FreeLieAlgebra.hom_ext fun j => ?_
    ext w
    simp
  have happ := DFunLike.congr_fun hhom uNeg
  simpa [LieHom.comp_apply] using congrFun (congrArg DFunLike.coe happ) 1

private theorem eq_zero_of_auxPositiveHom_eq_zero {u : FreeLieAlgebra K I}
    (hu : auxPositiveHom R u = 0) : u = 0 := by
  classical
  let signAut : FreeLieAlgebra K I →ₗ⁅K⁆ FreeLieAlgebra K I :=
    FreeLieAlgebra.lift K fun i => -FreeLieAlgebra.of K i
  have hsign_inv : signAut.comp signAut = LieHom.id :=
    FreeLieAlgebra.hom_ext fun i => by simp [signAut]
  have hu_neg : auxNegativeHom R (signAut u) = 0 := by
    have := auxChevalleyInvolution_auxPositiveHom R u
    simpa [signAut, hu] using this.symm
  have hzero := congrFun (congrArg DFunLike.coe
    (congrArg (auxLift (satisfiesAuxRelations_freeAlgebra R 0)) hu_neg)) 1
  simp only [map_zero, LinearMap.zero_apply, auxNegativeHom_apply_one] at hzero
  have hsign0 : signAut u = 0 :=
    UniversalEnvelopingAlgebra.ι_injective K (FreeLieAlgebra K I)
      ((FreeLieAlgebra.universalEnvelopingEquivFreeAlgebra K I).injective (by simpa using hzero))
  have hcomp := DFunLike.congr_fun hsign_inv u
  simpa [LieHom.comp_apply, hsign0] using hcomp.symm

/-- **Kac, Theorem 1.2 (injectivity half)**: the triangular addition map
`FreeLieAlgebra K I × H × FreeLieAlgebra K I → AuxiliaryLieAlgebra R` is injective. -/
theorem auxTriangularMap_injective : Function.Injective (auxTriangularMap R) := by
  classical
  rw [injective_iff_map_eq_zero]
  rintro ⟨uNeg, x, uPos⟩ h0
  have hone : FreeAlgebra.basisFreeMonoid K I 1 = 1 := by simp
  have heval (lam : Module.Dual K H) :
      FreeLieAlgebra.universalEnvelopingEquivFreeAlgebra K I
          (_root_.UniversalEnvelopingAlgebra.ι K uNeg) +
        algebraMap K (FreeAlgebra K I) (lam x) = 0 := by
    have h1 := congrFun (congrArg DFunLike.coe
      (congrArg (auxLift (satisfiesAuxRelations_freeAlgebra R lam)) h0)) 1
    simp only [auxTriangularMap_apply, map_add, map_zero, LinearMap.add_apply,
      LinearMap.zero_apply, auxPositiveHom_apply_one, add_zero, auxNegativeHom_apply_one,
      auxLift_auxCartanElement] at h1
    have hx1 : hEnd R lam x 1 = algebraMap K (FreeAlgebra K I) (lam x) := by
      rw [← hone, hEnd_basisFreeMonoid, FreeMonoid.toList_one, wordWeight, hone,
        Algebra.algebraMap_eq_smul_one]
    rwa [hx1] at h1
  have haug : FreeAlgebra.algebraMapInv
      (FreeLieAlgebra.universalEnvelopingEquivFreeAlgebra K I
        (_root_.UniversalEnvelopingAlgebra.ι K uNeg)) = 0 := by
    have hhom : (FreeAlgebra.algebraMapInv (R := K) (X := I)).toLieHom.comp
        ((FreeLieAlgebra.universalEnvelopingEquivFreeAlgebra K I).toAlgHom.toLieHom.comp
          (_root_.UniversalEnvelopingAlgebra.ι K)) = 0 :=
      FreeLieAlgebra.hom_ext fun j => by simp [FreeAlgebra.algebraMapInv]
    exact DFunLike.congr_fun hhom uNeg
  have hx : x = 0 := by
    refine (Module.forall_dual_apply_eq_zero_iff K x).mp fun lam => ?_
    have hinv := congrArg FreeAlgebra.algebraMapInv (heval lam)
    rwa [map_add, map_zero, haug, FreeAlgebra.algebraMap_leftInverse (lam x), zero_add] at hinv
  subst hx
  have huNeg : uNeg = 0 := by
    have hzero := heval 0
    simp only [map_zero, add_zero] at hzero
    exact UniversalEnvelopingAlgebra.ι_injective K (FreeLieAlgebra K I)
      ((FreeLieAlgebra.universalEnvelopingEquivFreeAlgebra K I).injective (by simpa using hzero))
  subst huNeg
  simp only [auxTriangularMap_apply, map_zero, zero_add] at h0
  simp [eq_zero_of_auxPositiveHom_eq_zero R h0]

end FreeAlgebraRep

/-- **Kac, Theorem 1.2**: Kac's auxiliary Lie algebra decomposes as the `K`-linear direct sum
`FreeLieAlgebra K I ⊕ H ⊕ FreeLieAlgebra K I` via `(uNeg, x, uPos) ↦ uNeg + x + uPos`. -/
noncomputable def auxTriangularEquiv :
    (FreeLieAlgebra K I × H × FreeLieAlgebra K I) ≃ₗ[K] AuxiliaryLieAlgebra R :=
  LinearEquiv.ofBijective (auxTriangularMap R)
    ⟨auxTriangularMap_injective R, auxTriangularMap_surjective R⟩

@[simp]
theorem auxTriangularEquiv_apply (uNeg : FreeLieAlgebra K I) (x : H) (uPos : FreeLieAlgebra K I) :
    auxTriangularEquiv R (uNeg, x, uPos) =
      auxNegativeHom R uNeg + auxCartanElement R x + auxPositiveHom R uPos := (rfl)

@[simp]
theorem auxTriangularEquiv_symm_auxNegativeHom (u : FreeLieAlgebra K I) :
    (auxTriangularEquiv R).symm (auxNegativeHom R u) = (u, 0, 0) :=
  (auxTriangularEquiv R).symm_apply_eq.mpr (by simp)

@[simp]
theorem auxTriangularEquiv_symm_auxCartanElement (x : H) :
    (auxTriangularEquiv R).symm (auxCartanElement R x) = (0, x, 0) :=
  (auxTriangularEquiv R).symm_apply_eq.mpr (by simp)

@[simp]
theorem auxTriangularEquiv_symm_auxPositiveHom (u : FreeLieAlgebra K I) :
    (auxTriangularEquiv R).symm (auxPositiveHom R u) = (0, 0, u) :=
  (auxTriangularEquiv R).symm_apply_eq.mpr (by simp)

/-- **Cartan injectivity for the auxiliary Lie algebra** [Kac, Theorem 1.2(a)]: the canonical map
`H → AuxiliaryLieAlgebra R` is injective for every matrix `A` and realization `R`. -/
theorem auxCartanElement_injective : Function.Injective (auxCartanElement R) := by
  intro x y hxy
  have h : auxTriangularMap R (0, x, 0) = auxTriangularMap R (0, y, 0) := by
    simpa using hxy
  exact congrArg (fun p => p.2.1) (auxTriangularMap_injective R h)

/-- The raising generators freely generate `n~⁺` as a Lie algebra [Kac, Theorem 1.2(b)]. -/
theorem auxPositiveHom_injective : Function.Injective (auxPositiveHom R) := by
  intro u v huv
  have h : auxTriangularMap R (0, 0, u) = auxTriangularMap R (0, 0, v) := by
    simpa using huv
  exact congrArg (fun p => p.2.2) (auxTriangularMap_injective R h)

/-- The lowering generators freely generate `n~⁻` as a Lie algebra [Kac, Theorem 1.2(b)]. -/
theorem auxNegativeHom_injective : Function.Injective (auxNegativeHom R) := by
  intro u v huv
  have h : auxTriangularMap R (u, 0, 0) = auxTriangularMap R (v, 0, 0) := by
    simpa using huv
  exact congrArg Prod.fst (auxTriangularMap_injective R h)

end KacMoody

end TauCeti
