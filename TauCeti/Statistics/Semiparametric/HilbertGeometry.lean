section MeanZeroL2

variable {X : Type*} [MeasurableSpace X]

/-- The closed subspace `L²₀(P)` of mean-zero elements of `L²(P)`, defined as the orthogonal
complement of the constant functions. -/
def meanZeroL2 (P : Measure X) [IsFiniteMeasure P] : Submodule ℝ (Lp ℝ 2 P) :=
  (Submodule.span ℝ {Lp.const 2 P (1 : ℝ)})ᗮ

/-- Unfolding lemma for `meanZeroL2`. -/
theorem meanZeroL2_def (P : Measure X) [IsFiniteMeasure P] :
    meanZeroL2 P = (Submodule.span ℝ {Lp.const 2 P (1 : ℝ)})ᗮ :=
  (rfl)

/-- `meanZeroL2 P` is a closed subspace of `L²(P)`. -/
theorem isClosed_meanZeroL2 (P : Measure X) [IsFiniteMeasure P] :
    IsClosed (meanZeroL2 P : Set (Lp ℝ 2 P)) :=
  Submodule.isClosed_orthogonal _

/-- `meanZeroL2 P` is a complete subspace of `L²(P)`. -/
instance instCompleteSpaceMeanZeroL2 (P : Measure X) [IsFiniteMeasure P] :
    CompleteSpace (meanZeroL2 P) :=
  (isClosed_meanZeroL2 P).completeSpace_coe

/-- An element of `L²(P)` lies in `meanZeroL2 P` if and only if its integral vanishes. -/
@[simp]
theorem mem_meanZeroL2_iff {P : Measure X} [IsFiniteMeasure P] {f : Lp ℝ 2 P} :
    f ∈ meanZeroL2 P ↔ ∫ x, f x ∂P = 0 := by
  rw [meanZeroL2_def, Submodule.mem_orthogonal_singleton_iff_inner_right,
    ← indicatorConstLp_univ, L2.inner_indicatorConstLp_one, setIntegral_univ]

/-- The orthogonal complement of `meanZeroL2 P` is the line of constant functions. -/
@[simp]
theorem orthogonal_meanZeroL2 (P : Measure X) [IsFiniteMeasure P] :
    (meanZeroL2 P)ᗮ = Submodule.span ℝ {Lp.const 2 P (1 : ℝ)} :=
  Submodule.orthogonal_orthogonal _

/-- `L²(P)` is the direct sum of the constant functions and `meanZeroL2 P`. -/
theorem isCompl_span_const_meanZeroL2 (P : Measure X) [IsFiniteMeasure P] :
    IsCompl (Submodule.span ℝ {Lp.const 2 P (1 : ℝ)}) (meanZeroL2 P) :=
  Submodule.isCompl_orthogonal _

/-- On a finite measure space, orthogonal projection onto `meanZeroL2 P` subtracts the average. -/
theorem starProjection_meanZeroL2_apply (P : Measure X) [IsFiniteMeasure P] (f : Lp ℝ 2 P) :
    (meanZeroL2 P).starProjection f = f - Lp.const 2 P (⨍ x, f x ∂P) := by
  refine Submodule.eq_starProjection_of_mem_orthogonal ?_ ?_
  · rw [mem_meanZeroL2_iff]
    have hsub : (⇑(f - Lp.const 2 P (⨍ x, f x ∂P)) : X → ℝ) =ᵐ[P] fun x ↦ f x - ⨍ y, f y ∂P :=
      (Lp.coeFn_sub _ _).trans (.sub .rfl (Lp.coeFn_const 2 P _))
    rw [integral_congr_ae hsub]
    exact integral_sub_average P f
  · rw [sub_sub_cancel, orthogonal_meanZeroL2]
    have hconst : Lp.const 2 P (⨍ x, f x ∂P) = (⨍ x, f x ∂P) • Lp.const 2 P (1 : ℝ) := by
      simpa using (Lp.constₗ 2 P ℝ).map_smul (⨍ x, f x ∂P) (1 : ℝ)
    rw [hconst]
    exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)

/-- On a probability space, orthogonal projection onto `meanZeroL2 P` subtracts the mean. -/
theorem starProjection_meanZeroL2_eq_sub_const (P : Measure X) [IsProbabilityMeasure P]
    (f : Lp ℝ 2 P) :
    (meanZeroL2 P).starProjection f = f - Lp.const 2 P (∫ x, f x ∂P) := by
  rw [starProjection_meanZeroL2_apply, average_eq_integral]

/-- On a probability space, the squared `L²` norm of the orthogonal projection of `f` onto
`meanZeroL2 P` equals its variance. -/
theorem norm_sq_starProjection_meanZeroL2 (P : Measure X) [IsProbabilityMeasure P]
    (f : Lp ℝ 2 P) :
    ‖(meanZeroL2 P).starProjection f‖ ^ 2 = variance f P := by
  rw [starProjection_meanZeroL2_eq_sub_const, variance_eq_norm_sub_const_sq]

/-- Bounded mean-zero elements are dense in `meanZeroL2 P`. -/
theorem meanZeroL2_subset_closure_bounded (P : Measure X) [IsFiniteMeasure P] :
    (meanZeroL2 P : Set (Lp ℝ 2 P)) ⊆
      closure {u | u ∈ meanZeroL2 P ∧ ∃ C, ∀ᵐ x ∂P, |u x| ≤ C} := by
  conv_lhs =>
    rw [← (meanZeroL2 P).range_starProjection,
      LinearMap.coe_range ((meanZeroL2 P).starProjection : Lp ℝ 2 P →ₗ[ℝ] Lp ℝ 2 P)]
  refine ((meanZeroL2 P).starProjection.continuous.range_subset_closure_image_dense
    (Lp.simpleFunc.dense (E := ℝ) (μ := P) ENNReal.ofNat_ne_top)).trans (closure_mono ?_)
  rintro _ ⟨f, hf, rfl⟩
  refine ⟨(meanZeroL2 P).starProjection_apply_mem f, ?_⟩
  let s : Lp.simpleFunc ℝ 2 P := ⟨f, hf⟩
  let C : ℝ := ((Lp.simpleFunc.toSimpleFunc s).range.sup (fun r ↦ ‖r‖₊) : NNReal)
  refine ⟨C + |⨍ x, f x ∂P|, ?_⟩
  rw [starProjection_meanZeroL2_apply]
  filter_upwards [Lp.coeFn_sub f (Lp.const 2 P (⨍ x, f x ∂P)),
    Lp.coeFn_const 2 P (⨍ x, f x ∂P), Lp.simpleFunc.toSimpleFunc_eq_toFun s] with x hsub hconst hs
  rw [hsub, Pi.sub_apply, hconst]
  calc |f x - ⨍ y, f y ∂P| ≤ |f x| + |⨍ y, f y ∂P| := abs_sub _ _
    _ = |Lp.simpleFunc.toSimpleFunc s x| + |⨍ y, f y ∂P| := by rw [← hs]
    _ ≤ C + |⨍ y, f y ∂P| := by
      gcongr
      simpa only [C, ← Real.norm_eq_abs, ← coe_nnNorm] using
        NNReal.coe_le_coe.2
          (Finset.le_sup (f := fun r ↦ ‖r‖₊) (SimpleFunc.mem_range_self _ x))

/-- On a normal topological space with its Borel σ-algebra and a weakly regular finite measure `P`,
bounded continuous mean-zero functions are dense in `meanZeroL2 P`. -/
theorem meanZeroL2_subset_closure_boundedContinuous [TopologicalSpace X] [NormalSpace X]
    [BorelSpace X] (P : Measure X) [P.WeaklyRegular] [IsFiniteMeasure P] :
    (meanZeroL2 P : Set (Lp ℝ 2 P)) ⊆
      closure {u | u ∈ meanZeroL2 P ∧ ∃ g : X →ᵇ ℝ, (u : X → ℝ) =ᵐ[P] g} := by
  have hD : Dense (Set.range (BoundedContinuousFunction.toLp 2 P ℝ : (X →ᵇ ℝ) →L[ℝ] Lp ℝ 2 P)) :=
    BoundedContinuousFunction.toLp_denseRange (p := 2) ℝ P ℝ ENNReal.ofNat_ne_top
  conv_lhs =>
    rw [← (meanZeroL2 P).range_starProjection,
      LinearMap.coe_range ((meanZeroL2 P).starProjection : Lp ℝ 2 P →ₗ[ℝ] Lp ℝ 2 P)]
  refine ((meanZeroL2 P).starProjection.continuous.range_subset_closure_image_dense hD).trans
    (closure_mono ?_)
  rintro _ ⟨_, ⟨g, rfl⟩, rfl⟩
  refine ⟨(meanZeroL2 P).starProjection_apply_mem _,
    g - BoundedContinuousFunction.const X (⨍ x, (g.toLp 2 P ℝ) x ∂P), ?_⟩
  rw [starProjection_meanZeroL2_apply]
  filter_upwards [Lp.coeFn_sub (g.toLp 2 P ℝ) (Lp.const 2 P (⨍ x, (g.toLp 2 P ℝ) x ∂P)),
    BoundedContinuousFunction.coeFn_toLp g (p := 2) (μ := P) (𝕜 := ℝ),
    Lp.coeFn_const 2 P (⨍ x, (g.toLp 2 P ℝ) x ∂P)] with x hsub hg hconst
  simp only [hsub, Pi.sub_apply, hg, hconst, Function.const_apply,
    FunLike.coe_sub, BoundedContinuousFunction.const_apply]

end MeanZeroL2

section TangentSpace

variable {X : Type*} [MeasurableSpace X]

/-- The tangent space generated by a set of scores `T ⊆ L²(P)`: the closed linear span of `T`. -/
def tangentSpace (P : Measure X) (T : Set (Lp ℝ 2 P)) : ClosedSubmodule ℝ (Lp ℝ 2 P) :=
  (Submodule.span ℝ T).closure

/-- The underlying submodule of `tangentSpace P T` is the topological closure of `span ℝ T`. -/
theorem toSubmodule_tangentSpace (P : Measure X) (T : Set (Lp ℝ 2 P)) :
    (tangentSpace P T).toSubmodule = (Submodule.span ℝ T).topologicalClosure :=
  (rfl)

/-- Every element of `T` lies in `tangentSpace P T`. -/
theorem subset_tangentSpace (P : Measure X) (T : Set (Lp ℝ 2 P)) :
    T ⊆ tangentSpace P T :=
  Submodule.subset_span.trans (Submodule.span ℝ T).le_topologicalClosure

/-- Universal property of `tangentSpace`: it is the least closed submodule containing `T`. -/
@[simp]
theorem tangentSpace_le_iff {P : Measure X} {T : Set (Lp ℝ 2 P)}
    {K : ClosedSubmodule ℝ (Lp ℝ 2 P)} :
    tangentSpace P T ≤ K ↔ T ⊆ K := by
  rw [tangentSpace, Submodule.closure_le, Submodule.span_le, ClosedSubmodule.coe_toSubmodule]

/-- `tangentSpace P` is monotone in the generating set of scores. -/
theorem tangentSpace_mono (P : Measure X) {T T' : Set (Lp ℝ 2 P)} (h : T ⊆ T') :
    tangentSpace P T ≤ tangentSpace P T' :=
  tangentSpace_le_iff.2 (h.trans (subset_tangentSpace P T'))

/-- The tangent space generated by a closed submodule is itself. -/
@[simp]
theorem tangentSpace_coe (P : Measure X) (K : ClosedSubmodule ℝ (Lp ℝ 2 P)) :
    tangentSpace P (K : Set (Lp ℝ 2 P)) = K :=
  le_antisymm (tangentSpace_le_iff.2 Subset.rfl) (subset_tangentSpace P K)

/-- The tangent space of the empty set is `⊥`. -/
@[simp]
theorem tangentSpace_empty (P : Measure X) : tangentSpace P ∅ = ⊥ :=
  le_antisymm (tangentSpace_le_iff.2 (empty_subset _)) bot_le

/-- The orthogonal complement of `tangentSpace P T` agrees with the orthogonal complement of
`span ℝ T`. -/
@[simp]
theorem orthogonal_toSubmodule_tangentSpace (P : Measure X) (T : Set (Lp ℝ 2 P)) :
    (tangentSpace P T).toSubmoduleᗮ = (Submodule.span ℝ T)ᗮ :=
  Submodule.orthogonal_closure _

/-- A vector is orthogonal to `tangentSpace P T` if and only if it is orthogonal to every element
of `T`. -/
theorem mem_orthogonal_tangentSpace_iff {P : Measure X} {T : Set (Lp ℝ 2 P)} {f : Lp ℝ 2 P} :
    f ∈ (tangentSpace P T).toSubmoduleᗮ ↔ ∀ g ∈ T, ⟪g, f⟫_ℝ = 0 := by
  rw [orthogonal_toSubmodule_tangentSpace]
  refine ⟨fun hf g hg ↦ hf g (Submodule.subset_span hg), fun hf u hu ↦ ?_⟩
  have hle : Submodule.span ℝ T ≤ (ℝ ∙ f)ᗮ :=
    Submodule.span_le.2 fun g hg ↦ Submodule.mem_orthogonal_singleton_iff_inner_left.2 (hf g hg)
  exact Submodule.mem_orthogonal_singleton_iff_inner_left.1 (hle hu)

/-- A tangent space lies inside `meanZeroL2 P` if and only if its generating scores do. -/
@[simp]
theorem tangentSpace_le_meanZeroL2_iff {P : Measure X} [IsFiniteMeasure P] {T : Set (Lp ℝ 2 P)} :
    (tangentSpace P T).toSubmodule ≤ meanZeroL2 P ↔ T ⊆ meanZeroL2 P := by
  refine ⟨(subset_tangentSpace P T).trans, fun hT ↦ ?_⟩
  rw [toSubmodule_tangentSpace]
  exact (Submodule.span ℝ T).topologicalClosure_minimal (Submodule.span_le.2 hT)
    (isClosed_meanZeroL2 P)

/-- The tangent space of a union of tangent sets is the closed-submodule join of their tangent
spaces. -/
@[simp]
theorem tangentSpace_union (P : Measure X) (T T' : Set (Lp ℝ 2 P)) :
    tangentSpace P (T ∪ T') = tangentSpace P T ⊔ tangentSpace P T' :=
  le_antisymm
    (tangentSpace_le_iff.2 (union_subset
      (fun _ hx ↦ le_sup_left (a := tangentSpace P T) (b := tangentSpace P T')
        (subset_tangentSpace P T hx))
      (fun _ hx ↦ le_sup_right (a := tangentSpace P T) (b := tangentSpace P T')
        (subset_tangentSpace P T' hx))))
    (sup_le (tangentSpace_mono P subset_union_left) (tangentSpace_mono P subset_union_right))

/-- When two tangent spaces are orthogonal, the tangent space of their union is their algebraic
sum (no closure is needed). -/
theorem toSubmodule_tangentSpace_union_of_isOrtho (P : Measure X) {T T' : Set (Lp ℝ 2 P)}
    (h : (tangentSpace P T).toSubmodule ⟂ (tangentSpace P T').toSubmodule) :
    (tangentSpace P (T ∪ T')).toSubmodule =
      (tangentSpace P T).toSubmodule ⊔ (tangentSpace P T').toSubmodule := by
  rw [tangentSpace_union, ClosedSubmodule.toSubmodule_sup]
  exact h.isClosed_sup.submodule_topologicalClosure_eq

/-- When two tangent spaces are orthogonal, the orthogonal projection onto the tangent space of
their union is the sum of the two projections. -/
theorem starProjection_tangentSpace_union_of_isOrtho (P : Measure X) {T T' : Set (Lp ℝ 2 P)}
    (h : (tangentSpace P T).toSubmodule ⟂ (tangentSpace P T').toSubmodule) :
    (tangentSpace P (T ∪ T')).toSubmodule.starProjection =
      (tangentSpace P T).toSubmodule.starProjection +
        (tangentSpace P T').toSubmodule.starProjection := by
  have hsum := toSubmodule_tangentSpace_union_of_isOrtho P h
  have := h.hasOrthogonalProjection_sup
  simpa only [hsum] using h.starProjection_sup

end TangentSpace

section EfficientScore

variable {X : Type*} [MeasurableSpace X]

/-- The efficient score of `ℓ` relative to a set of nuisance scores `N`: the residual of `ℓ` after
orthogonal projection onto the nuisance tangent space `tangentSpace P N`. -/
def efficientScore (P : Measure X) (N : Set (Lp ℝ 2 P)) (ℓ : Lp ℝ 2 P) : Lp ℝ 2 P :=
  ℓ - (tangentSpace P N).toSubmodule.starProjection ℓ

/-- Unfolding lemma for `efficientScore`. -/
theorem efficientScore_def (P : Measure X) (N : Set (Lp ℝ 2 P)) (ℓ : Lp ℝ 2 P) :
    efficientScore P N ℓ = ℓ - (tangentSpace P N).toSubmodule.starProjection ℓ :=
  (rfl)

/-- The efficient score is the orthogonal projection of `ℓ` onto the orthogonal complement of the
nuisance tangent space. -/
theorem efficientScore_eq_starProjection_orthogonal (P : Measure X) (N : Set (Lp ℝ 2 P))
    (ℓ : Lp ℝ 2 P) :
    efficientScore P N ℓ = (tangentSpace P N).toSubmoduleᗮ.starProjection ℓ := by
  rw [efficientScore_def, Submodule.starProjection_orthogonal_val]

/-- The efficient score is orthogonal to the nuisance tangent space. -/
theorem efficientScore_mem_orthogonal (P : Measure X) (N : Set (Lp ℝ 2 P)) (ℓ : Lp ℝ 2 P) :
    efficientScore P N ℓ ∈ (tangentSpace P N).toSubmoduleᗮ := by
  rw [efficientScore_eq_starProjection_orthogonal]
  exact Submodule.starProjection_apply_mem _ _

/-- The efficient score is orthogonal to every nuisance score in `N`. -/
theorem inner_efficientScore_eq_zero_of_mem {P : Measure X} {N : Set (Lp ℝ 2 P)} {g : Lp ℝ 2 P}
    (hg : g ∈ N) (ℓ : Lp ℝ 2 P) :
    ⟪g, efficientScore P N ℓ⟫_ℝ = 0 :=
  (mem_orthogonal_tangentSpace_iff.1 (efficientScore_mem_orthogonal P N ℓ)) g hg

/-- The efficient score equals `ℓ` if and only if `ℓ` is orthogonal to every nuisance score
in `N`. -/
theorem efficientScore_eq_self_iff {P : Measure X} {N : Set (Lp ℝ 2 P)} {ℓ : Lp ℝ 2 P} :
    efficientScore P N ℓ = ℓ ↔ ∀ g ∈ N, ⟪g, ℓ⟫_ℝ = 0 := by
  rw [efficientScore_eq_starProjection_orthogonal, Submodule.starProjection_eq_self_iff,
    mem_orthogonal_tangentSpace_iff]

/-- The efficient score vanishes if and only if `ℓ` lies in the nuisance tangent space. -/
theorem efficientScore_eq_zero_iff {P : Measure X} {N : Set (Lp ℝ 2 P)} {ℓ : Lp ℝ 2 P} :
    efficientScore P N ℓ = 0 ↔ ℓ ∈ tangentSpace P N := by
  rw [efficientScore_def, sub_eq_zero, eq_comm, Submodule.starProjection_eq_self_iff,
    ClosedSubmodule.mem_toSubmodule_iff]

/-- With no nuisance scores, the efficient score is `ℓ` itself. -/
@[simp]
theorem efficientScore_empty (P : Measure X) (ℓ : Lp ℝ 2 P) :
    efficientScore P ∅ ℓ = ℓ :=
  efficientScore_eq_self_iff.2 fun _ hg ↦ hg.elim

/-- If both the score and all nuisance scores have mean zero, then the efficient score also has
mean zero. -/
theorem efficientScore_mem_meanZeroL2 {P : Measure X} [IsFiniteMeasure P] {N : Set (Lp ℝ 2 P)}
    {ℓ : Lp ℝ 2 P} (hℓ : ℓ ∈ meanZeroL2 P) (hN : N ⊆ meanZeroL2 P) :
    efficientScore P N ℓ ∈ meanZeroL2 P := by
  rw [efficientScore_def]
  exact (meanZeroL2 P).sub_mem hℓ
    ((tangentSpace_le_meanZeroL2_iff.2 hN) (Submodule.starProjection_apply_mem _ ℓ))

/-- The information matrix `Iᵢⱼ = ⟪ℓᵢ, ℓⱼ⟫` of an indexed family of scores in `L²(P)`. -/
def informationMatrix {ι : Type*} (P : Measure X) (ℓ : ι → Lp ℝ 2 P) : Matrix ι ι ℝ :=
  Matrix.gram ℝ ℓ

/-- The efficient information matrix of an indexed family of scores relative to a set of nuisance
scores `N`: the Gram matrix of `i ↦ efficientScore P N (ℓ i)`. -/
def efficientInformationMatrix {ι : Type*} (P : Measure X) (N : Set (Lp ℝ 2 P))
    (ℓ : ι → Lp ℝ 2 P) : Matrix ι ι ℝ :=
  Matrix.gram ℝ fun i ↦ efficientScore P N (ℓ i)

/-- `informationMatrix P ℓ` is the Gram matrix of `ℓ`. -/
theorem informationMatrix_eq_gram {ι : Type*} (P : Measure X) (ℓ : ι → Lp ℝ 2 P) :
    informationMatrix P ℓ = Matrix.gram ℝ ℓ :=
  (rfl)

/-- Entrywise formula for `informationMatrix`. -/
@[simp]
theorem informationMatrix_apply {ι : Type*} (P : Measure X) (ℓ : ι → Lp ℝ 2 P) (i j : ι) :
    informationMatrix P ℓ i j = ⟪ℓ i, ℓ j⟫_ℝ :=
  (rfl)

/-- `efficientInformationMatrix P N ℓ` is the Gram matrix of the efficient scores. -/
theorem efficientInformationMatrix_eq_gram {ι : Type*} (P : Measure X) (N : Set (Lp ℝ 2 P))
    (ℓ : ι → Lp ℝ 2 P) :
    efficientInformationMatrix P N ℓ = Matrix.gram ℝ fun i ↦ efficientScore P N (ℓ i) :=
  (rfl)

/-- Entrywise formula for `efficientInformationMatrix`. -/
@[simp]
theorem efficientInformationMatrix_apply {ι : Type*} (P : Measure X) (N : Set (Lp ℝ 2 P))
    (ℓ : ι → Lp ℝ 2 P) (i j : ι) :
    efficientInformationMatrix P N ℓ i j =
      ⟪efficientScore P N (ℓ i), efficientScore P N (ℓ j)⟫_ℝ :=
  (rfl)

/-- With no nuisance scores, the efficient information matrix coincides with the information
matrix. -/
@[simp]
theorem efficientInformationMatrix_empty {ι : Type*} (P : Measure X) (ℓ : ι → Lp ℝ 2 P) :
    efficientInformationMatrix P ∅ ℓ = informationMatrix P ℓ := by
  ext i j
  simp

/-- The information loss `informationMatrix P ℓ - efficientInformationMatrix P N ℓ` is the Gram
matrix of the nuisance projections `Π_N ℓᵢ`. -/
theorem informationMatrix_sub_efficientInformationMatrix {ι : Type*} (P : Measure X)
    (N : Set (Lp ℝ 2 P)) (ℓ : ι → Lp ℝ 2 P) :
    informationMatrix P ℓ - efficientInformationMatrix P N ℓ =
      Matrix.gram ℝ fun i ↦ (tangentSpace P N).toSubmodule.starProjection (ℓ i) := by
  simpa only [informationMatrix_eq_gram, efficientInformationMatrix_eq_gram,
    efficientScore_eq_starProjection_orthogonal] using
    (tangentSpace P N).toSubmodule.gram_sub_gram_starProjection_orthogonal ℓ

/-- Information loss inequality: `informationMatrix P ℓ - efficientInformationMatrix P N ℓ` is
positive semidefinite. -/
theorem posSemidef_informationMatrix_sub_efficientInformationMatrix {ι : Type*} (P : Measure X)
    (N : Set (Lp ℝ 2 P)) (ℓ : ι → Lp ℝ 2 P) :
    (informationMatrix P ℓ - efficientInformationMatrix P N ℓ).PosSemidef := by
  rw [informationMatrix_sub_efficientInformationMatrix]
  exact Matrix.posSemidef_gram ℝ _

/-- Adaptation criterion: `efficientInformationMatrix P N ℓ = informationMatrix P ℓ` if and only
if every coordinate of `ℓ` is orthogonal to every nuisance score in `N`. -/
theorem efficientInformationMatrix_eq_informationMatrix_iff {ι : Type*} (P : Measure X)
    (N : Set (Lp ℝ 2 P)) (ℓ : ι → Lp ℝ 2 P) :
    efficientInformationMatrix P N ℓ = informationMatrix P ℓ ↔
      ∀ i, ∀ g ∈ N, ⟪g, ℓ i⟫_ℝ = 0 := by
  simp only [efficientInformationMatrix_eq_gram, informationMatrix_eq_gram,
    efficientScore_eq_starProjection_orthogonal,
    Submodule.gram_starProjection_orthogonal_eq_gram_iff, mem_orthogonal_tangentSpace_iff]

/-- For nested sets of nuisance scores `N ⊆ N'`, the difference of efficient information matrices
is the Gram matrix of the projection differences `(Π_{N'} - Π_N) ℓᵢ`. -/
theorem efficientInformationMatrix_sub_of_subset {ι : Type*} (P : Measure X)
    {N N' : Set (Lp ℝ 2 P)} (h : N ⊆ N') (ℓ : ι → Lp ℝ 2 P) :
    efficientInformationMatrix P N ℓ - efficientInformationMatrix P N' ℓ =
      Matrix.gram ℝ fun i ↦
        (tangentSpace P N').toSubmodule.starProjection (ℓ i) -
          (tangentSpace P N).toSubmodule.starProjection (ℓ i) := by
  simpa only [efficientInformationMatrix_eq_gram, efficientScore_eq_starProjection_orthogonal] using
    Submodule.gram_starProjection_orthogonal_sub_of_le (𝕜 := ℝ)
      (ClosedSubmodule.toSubmodule_le_toSubmodule.2 (tangentSpace_mono P h)) ℓ

/-- Enlarging the set of nuisance scores lowers the efficient information matrix in the Loewner
order. -/
theorem posSemidef_efficientInformationMatrix_sub_of_subset {ι : Type*} (P : Measure X)
    {N N' : Set (Lp ℝ 2 P)} (h : N ⊆ N') (ℓ : ι → Lp ℝ 2 P) :
    (efficientInformationMatrix P N ℓ - efficientInformationMatrix P N' ℓ).PosSemidef := by
  rw [efficientInformationMatrix_sub_of_subset P h ℓ]
  exact Matrix.posSemidef_gram ℝ _

/-- The efficient information matrix is positive definite if and only if the efficient scores are
linearly independent in `L²(P)`. -/
theorem posDef_efficientInformationMatrix_iff {ι : Type*} (P : Measure X) (N : Set (Lp ℝ 2 P))
    (ℓ : ι → Lp ℝ 2 P) :
    (efficientInformationMatrix P N ℓ).PosDef ↔
      LinearIndependent ℝ fun i ↦ efficientScore P N (ℓ i) :=
  Matrix.posDef_gram_iff_linearIndependent

end EfficientScore

section ScoreOperators

variable {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y]

/-- Pullback along a measurable map `m : Y → X`, as a continuous linear isometry
`L²(η.map m) → L²(η)`. -/
def pullbackL2 (η : Measure Y) (m : Y → X) (hm : Measurable m) :
    Lp ℝ 2 (η.map m) →L[ℝ] Lp ℝ 2 η :=
  (Lp.compMeasurePreservingₗᵢ ℝ m (hm.measurePreserving η)).toContinuousLinearMap

/-- Pointwise a.e. action of `pullbackL2`. -/
theorem coeFn_pullbackL2 (η : Measure Y) (m : Y → X) (hm : Measurable m)
    (g : Lp ℝ 2 (η.map m)) :
    (pullbackL2 η m hm g : Y → ℝ) =ᵐ[η] g ∘ m :=
  Lp.coeFn_compMeasurePreserving g (hm.measurePreserving η)

/-- `pullbackL2` is an isometry. -/
theorem isometry_pullbackL2 (η : Measure Y) (m : Y → X) (hm : Measurable m) :
    Isometry (pullbackL2 η m hm) :=
  (Lp.compMeasurePreservingₗᵢ ℝ m (hm.measurePreserving η)).isometry

/-- `pullbackL2` preserves `L²` norms. -/
@[simp]
theorem norm_pullbackL2 (η : Measure Y) (m : Y → X) (hm : Measurable m)
    (g : Lp ℝ 2 (η.map m)) :
    ‖pullbackL2 η m hm g‖ = ‖g‖ :=
  Lp.norm_compMeasurePreserving g (hm.measurePreserving η)

/-- `pullbackL2` preserves inner products. -/
@[simp]
theorem inner_pullbackL2 (η : Measure Y) (m : Y → X) (hm : Measurable m)
    (f g : Lp ℝ 2 (η.map m)) :
    ⟪pullbackL2 η m hm f, pullbackL2 η m hm g⟫_ℝ = ⟪f, g⟫_ℝ :=
  (Lp.compMeasurePreservingₗᵢ ℝ m (hm.measurePreserving η)).inner_map_map f g

/-- `pullbackL2` sends constant functions to constant functions. -/
@[simp]
theorem pullbackL2_const (η : Measure Y) [IsFiniteMeasure η] (m : Y → X) (hm : Measurable m)
    (c : ℝ) :
    pullbackL2 η m hm (Lp.const 2 (η.map m) c) = Lp.const 2 η c := by
  rw [← indicatorConstLp_univ, ← indicatorConstLp_univ]
  exact Lp.indicatorConstLp_compMeasurePreserving .univ (measure_ne_top (η.map m) Set.univ) c
    (hm.measurePreserving η)

/-- The conditional expectation operator `L²(η) → L²(η.map m)` given a measurable map `m`,
defined as the Hilbert-space adjoint of `pullbackL2`. -/
def condExpOperator (η : Measure Y) (m : Y → X) (hm : Measurable m) :
    Lp ℝ 2 η →L[ℝ] Lp ℝ 2 (η.map m) :=
  ContinuousLinearMap.adjoint (pullbackL2 η m hm)

/-- Unfolding lemma for `condExpOperator`. -/
theorem condExpOperator_def (η : Measure Y) (m : Y → X) (hm : Measurable m) :
    condExpOperator η m hm = ContinuousLinearMap.adjoint (pullbackL2 η m hm) :=
  (rfl)

/-- Adjoint identity for `condExpOperator` on the left. -/
theorem inner_condExpOperator_left (η : Measure Y) (m : Y → X) (hm : Measurable m)
    (b : Lp ℝ 2 η) (g : Lp ℝ 2 (η.map m)) :
    ⟪condExpOperator η m hm b, g⟫_ℝ = ⟪b, pullbackL2 η m hm g⟫_ℝ :=
  ContinuousLinearMap.adjoint_inner_left (pullbackL2 η m hm) g b

/-- Adjoint identity for `condExpOperator` on the right. -/
theorem inner_condExpOperator_right (η : Measure Y) (m : Y → X) (hm : Measurable m)
    (g : Lp ℝ 2 (η.map m)) (b : Lp ℝ 2 η) :
    ⟪g, condExpOperator η m hm b⟫_ℝ = ⟪pullbackL2 η m hm g, b⟫_ℝ :=
  ContinuousLinearMap.adjoint_inner_right (pullbackL2 η m hm) g b

/-- `condExpOperator` is a left inverse of `pullbackL2`. -/
@[simp]
theorem condExpOperator_comp_pullbackL2 (η : Measure Y) (m : Y → X) (hm : Measurable m) :
    condExpOperator η m hm ∘L pullbackL2 η m hm = ContinuousLinearMap.id ℝ _ :=
  (ContinuousLinearMap.isometry_iff_adjoint_comp_self (pullbackL2 η m hm)).1
    (isometry_pullbackL2 η m hm)

/-- Pointwise left-inverse identity `condExpOperator (pullbackL2 g) = g`. -/
@[simp]
theorem condExpOperator_pullbackL2 (η : Measure Y) (m : Y → X) (hm : Measurable m)
    (g : Lp ℝ 2 (η.map m)) :
    condExpOperator η m hm (pullbackL2 η m hm g) = g :=
  congrArg (fun T : Lp ℝ 2 (η.map m) →L[ℝ] Lp ℝ 2 (η.map m) ↦ T g)
    (condExpOperator_comp_pullbackL2 η m hm)

/-- `condExpOperator` is surjective onto `L²(η.map m)`. -/
theorem condExpOperator_surjective (η : Measure Y) (m : Y → X) (hm : Measurable m) :
    Function.Surjective (condExpOperator η m hm) :=
  Function.LeftInverse.surjective (condExpOperator_pullbackL2 η m hm)

/-- `condExpOperator` is a contraction. -/
theorem norm_condExpOperator_le_one (η : Measure Y) (m : Y → X) (hm : Measurable m) :
    ‖condExpOperator η m hm‖ ≤ 1 := by
  rw [condExpOperator_def, ContinuousLinearMap.adjoint.norm_map]
  exact ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun g ↦ by simp

/-- Read back on `Y` via `pullbackL2`, `condExpOperator η m hm b` equals the conditional
expectation `η[b | σ(m)]` almost everywhere. -/
theorem pullbackL2_condExpOperator_ae_eq (η : Measure Y) [IsFiniteMeasure η] (m : Y → X)
    (hm : Measurable m) (b : Lp ℝ 2 η) :
    (pullbackL2 η m hm (condExpOperator η m hm b) : Y → ℝ) =ᵐ[η]
      η[(b : Y → ℝ) | MeasurableSpace.comap m inferInstance] := by
  refine ae_eq_condExp_of_forall_setIntegral_eq hm.comap_le ((Lp.memLp b).integrable one_le_two)
    (fun s _ _ ↦ ((Lp.memLp _).integrable one_le_two).integrableOn) ?_ ?_
  · rintro _ ⟨t, ht, rfl⟩ _
    have hpull : pullbackL2 η m hm (indicatorConstLp 2 ht (measure_ne_top (η.map m) t) (1 : ℝ)) =
        indicatorConstLp 2 (hm ht) (measure_ne_top η (m ⁻¹' t)) (1 : ℝ) :=
      Lp.indicatorConstLp_compMeasurePreserving ht (measure_ne_top (η.map m) t) (1 : ℝ)
        (hm.measurePreserving η)
    rw [← L2.inner_indicatorConstLp_one (hm ht) (measure_ne_top η (m ⁻¹' t)),
      ← L2.inner_indicatorConstLp_one (hm ht) (measure_ne_top η (m ⁻¹' t)),
      ← hpull, inner_pullbackL2, inner_condExpOperator_right]
  · exact (Lp.mem_range_compMeasurePreservingₗᵢ_iff (𝕜 := ℝ) (hm.measurePreserving η) _).1
      ⟨condExpOperator η m hm b, rfl⟩

/-- `condExpOperator` preserves integrals. -/
@[simp]
theorem integral_condExpOperator (η : Measure Y) [IsFiniteMeasure η] (m : Y → X)
    (hm : Measurable m) (b : Lp ℝ 2 η) :
    ∫ x, (condExpOperator η m hm b) x ∂(η.map m) = ∫ y, b y ∂η := by
  rw [← setIntegral_univ, ← L2.inner_indicatorConstLp_one .univ (measure_ne_top (η.map m) _),
    indicatorConstLp_univ, inner_condExpOperator_right, pullbackL2_const,
    ← indicatorConstLp_univ, L2.inner_indicatorConstLp_one, setIntegral_univ]

/-- An element of `L²(η)` has mean zero if and only if its conditional expectation given `m` has
mean zero. -/
theorem condExpOperator_mem_meanZeroL2_iff (η : Measure Y) [IsFiniteMeasure η] (m : Y → X)
    (hm : Measurable m) (b : Lp ℝ 2 η) :
    condExpOperator η m hm b ∈ meanZeroL2 (η.map m) ↔ b ∈ meanZeroL2 η := by
  rw [mem_meanZeroL2_iff, mem_meanZeroL2_iff, integral_condExpOperator]

/-- A pullback along `m` has mean zero if and only if the original function has mean zero under
`η.map m`. -/
theorem pullbackL2_mem_meanZeroL2_iff (η : Measure Y) [IsFiniteMeasure η] (m : Y → X)
    (hm : Measurable m) (g : Lp ℝ 2 (η.map m)) :
    pullbackL2 η m hm g ∈ meanZeroL2 η ↔ g ∈ meanZeroL2 (η.map m) := by
  rw [← condExpOperator_mem_meanZeroL2_iff η m hm, condExpOperator_pullbackL2]

/-- `condExpOperator` maps `meanZeroL2 η` onto `meanZeroL2 (η.map m)`. -/
theorem map_meanZeroL2_condExpOperator (η : Measure Y) [IsFiniteMeasure η] (m : Y → X)
    (hm : Measurable m) :
    (meanZeroL2 η).map (condExpOperator η m hm : Lp ℝ 2 η →ₗ[ℝ] Lp ℝ 2 (η.map m)) =
      meanZeroL2 (η.map m) := by
  ext g
  simp only [Submodule.mem_map, ContinuousLinearMap.coe_coe]
  refine ⟨?_, fun hg ↦ ⟨pullbackL2 η m hm g, (pullbackL2_mem_meanZeroL2_iff η m hm g).2 hg,
    condExpOperator_pullbackL2 η m hm g⟩⟩
  rintro ⟨b, hb, rfl⟩
  exact (condExpOperator_mem_meanZeroL2_iff η m hm b).2 hb

/-- If the information operator `A† A` of a score operator `A : H →L[ℝ] L²(P)` is invertible,
then the tangent space generated by its range equals its range (which is closed). -/
theorem toSubmodule_tangentSpace_range_of_isUnit_adjoint_comp {H : Type*} [NormedAddCommGroup H]
    [InnerProductSpace ℝ H] [CompleteSpace H] (P : Measure X) (A : H →L[ℝ] Lp ℝ 2 P)
    (hA : IsUnit (ContinuousLinearMap.adjoint A ∘L A)) :
    (tangentSpace P (Set.range A)).toSubmodule = A.range := by
  have hclosed : IsClosed (A.range : Set (Lp ℝ 2 P)) :=
    ContinuousLinearMap.isClosed_range_of_isUnit_adjoint_comp hA
  have hrange : Set.range A = (A.range : Set (Lp ℝ 2 P)) :=
    (LinearMap.coe_range (A : H →ₗ[ℝ] Lp ℝ 2 P)).symm
  rw [toSubmodule_tangentSpace, hrange, Submodule.span_eq,
    hclosed.submodule_topologicalClosure_eq]

/-- For a score operator `A : H →L[ℝ] L²(P)` from a real Hilbert space whose information operator
`A† A` is invertible, the orthogonal projection onto `tangentSpace P (Set.range A)` is
`A (A† A)⁻¹ A†`. -/
theorem starProjection_tangentSpace_range_eq {H : Type*} [NormedAddCommGroup H]
    [InnerProductSpace ℝ H] [CompleteSpace H] (P : Measure X) (A : H →L[ℝ] Lp ℝ 2 P)
    (hA : IsUnit (ContinuousLinearMap.adjoint A ∘L A)) :
    (tangentSpace P (Set.range A)).toSubmodule.starProjection =
      A ∘L Ring.inverse (ContinuousLinearMap.adjoint A ∘L A) ∘L ContinuousLinearMap.adjoint A := by
  have hclosed : IsClosed (A.range : Set (Lp ℝ 2 P)) :=
    ContinuousLinearMap.isClosed_range_of_isUnit_adjoint_comp hA
  have : A.range.HasOrthogonalProjection := Submodule.hasOrthogonalProjection_iff_isClosed.2 hclosed
  simpa only [toSubmodule_tangentSpace_range_of_isUnit_adjoint_comp P A hA] using
    ContinuousLinearMap.starProjection_range_eq hA

end ScoreOperators

end TauCeti
