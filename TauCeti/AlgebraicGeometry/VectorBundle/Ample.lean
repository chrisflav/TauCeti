section SplitExact

private lemma dualFunctor_map_add {X : Scheme.{u}} {A B : FiniteLocallyFreeSheaf X}
    (f g : A ⟶ B) :
    dualFunctor.map (f + g).op = dualFunctor.map f.op + dualFunctor.map g.op := by
  have : MonoidalPreadditive X.Modules := TauCeti.SheafOfModules.monoidalPreadditive X.sheaf
  apply ObjectProperty.hom_ext
  change (pre (f.hom + g.hom)).app (𝟙_ X.Modules) =
    (pre f.hom).app (𝟙_ X.Modules) + (pre g.hom).app (𝟙_ X.Modules)
  apply uncurry_injective
  rw [uncurry_pre, MonoidalPreadditive.add_whiskerRight, Preadditive.add_comp,
    uncurry_eq, MonoidalPreadditive.whiskerLeft_add, Preadditive.add_comp,
    ← uncurry_eq, ← uncurry_eq, uncurry_pre, uncurry_pre]

private lemma dualFunctor_map_zero {X : Scheme.{u}} {A B : FiniteLocallyFreeSheaf X} :
    dualFunctor.map (0 : A ⟶ B).op = 0 := by
  have : MonoidalPreadditive X.Modules := TauCeti.SheafOfModules.monoidalPreadditive X.sheaf
  apply ObjectProperty.hom_ext
  change (pre (0 : A.obj ⟶ B.obj)).app (𝟙_ X.Modules) = 0
  apply uncurry_injective
  rw [uncurry_pre, uncurry_eq, MonoidalPreadditive.zero_whiskerRight,
    MonoidalPreadditive.whiskerLeft_zero, Limits.zero_comp, Limits.zero_comp]

private lemma dualFunctor_map_sum {X : Scheme.{u}} {ι : Type*} (s : Finset ι)
    {A B : FiniteLocallyFreeSheaf X} (f : ι → (A ⟶ B)) :
    dualFunctor.map (∑ i ∈ s, f i).op = ∑ i ∈ s, dualFunctor.map (f i).op := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    rw [Finset.sum_empty, Finset.sum_empty]
    exact dualFunctor_map_zero
  | insert a s ha ih =>
    rw [Finset.sum_insert ha, Finset.sum_insert ha, dualFunctor_map_add, ih]

/-- A split short exact diagram in a preadditive category: `a ≫ b = 0` with `a ≫ s = 𝟙`,
`t ≫ b = 𝟙`, and `s ≫ a + b ≫ t = 𝟙`. -/
private structure IsSplitExact {C : Type*} [Category C] [Preadditive C]
    {A B D : C} (a : A ⟶ B) (b : B ⟶ D) : Prop where
  w : a ≫ b = 0
  exists_split : ∃ (s : B ⟶ A) (t : D ⟶ B),
    a ≫ s = 𝟙 A ∧ t ≫ b = 𝟙 D ∧ s ≫ a + b ≫ t = 𝟙 B

private lemma IsSplitExact.mono {C : Type*} [Category C] [Preadditive C]
    {A B D : C} {a : A ⟶ B} {b : B ⟶ D} (h : IsSplitExact a b) : Mono a := by
  obtain ⟨s, _, has, _, _⟩ := h.exists_split
  exact ⟨fun f g hfg ↦ by
    have := congrArg (· ≫ s) hfg
    simpa only [Category.assoc, has, Category.comp_id] using this⟩

private def IsSplitExact.isLimitKernelFork {C : Type*} [Category C] [Preadditive C]
    {A B D : C} {a : A ⟶ B} {b : B ⟶ D} (h : IsSplitExact a b) :
    IsLimit (KernelFork.ofι a h.w) := by
  haveI := h.mono
  let s : B ⟶ A := h.exists_split.choose
  let t : D ⟶ B := h.exists_split.choose_spec.choose
  have hst := h.exists_split.choose_spec.choose_spec
  refine KernelFork.IsLimit.ofι _ _ (fun {W} k _ ↦ k ≫ s) (fun {W} k hk ↦ ?_)
    (fun {W} k hk m hm ↦ ?_)
  · have h1 : k ≫ (s ≫ a + b ≫ t) = k := by rw [hst.2.2, Category.comp_id]
    rw [Preadditive.comp_add, ← Category.assoc, ← Category.assoc, hk,
      Limits.zero_comp, add_zero] at h1
    exact h1
  · rw [← cancel_mono a, hm]
    have h1 : k ≫ (s ≫ a + b ≫ t) = k := by rw [hst.2.2, Category.comp_id]
    rw [Preadditive.comp_add, ← Category.assoc, ← Category.assoc, hk,
      Limits.zero_comp, add_zero] at h1
    exact h1.symm

private lemma IsSplitExact.of_iso {C : Type*} [Category C] [Preadditive C]
    {A B D A' B' D' : C} {a : A ⟶ B} {b : B ⟶ D} {a' : A' ⟶ B'} {b' : B' ⟶ D'}
    (h : IsSplitExact a b) (eA : A ≅ A') (eB : B ≅ B') (eD : D ≅ D')
    (ha : eA.hom ≫ a' = a ≫ eB.hom) (hb : eB.hom ≫ b' = b ≫ eD.hom) :
    IsSplitExact a' b' := by
  have ha' : a' = eA.inv ≫ a ≫ eB.hom := by rw [← ha, Iso.inv_hom_id_assoc]
  have hb' : b' = eB.inv ≫ b ≫ eD.hom := by rw [← hb, Iso.inv_hom_id_assoc]
  refine ⟨?_, ?_⟩
  · rw [ha', hb']
    simp only [Category.assoc, Iso.hom_inv_id_assoc]
    rw [← Category.assoc a b, h.w, Limits.zero_comp, Limits.comp_zero]
  · obtain ⟨s, t, has, htb, hsum⟩ := h.exists_split
    refine ⟨eB.inv ≫ s ≫ eA.hom, eD.inv ≫ t ≫ eB.hom, ?_, ?_, ?_⟩
    · rw [ha']
      simp only [Category.assoc, Iso.hom_inv_id_assoc]
      rw [← Category.assoc a s, has, Category.id_comp, Iso.inv_hom_id]
    · rw [hb']
      simp only [Category.assoc, Iso.hom_inv_id_assoc]
      rw [← Category.assoc t b, htb, Category.id_comp, Iso.inv_hom_id]
    · rw [ha', hb']
      simp only [Category.assoc, Iso.hom_inv_id_assoc]
      rw [← Category.assoc s a, ← Category.assoc b t, ← Preadditive.comp_add,
        ← Preadditive.add_comp, hsum, Category.id_comp, Iso.inv_hom_id]

private lemma IsSplitExact.map {C D : Type*} [Category C] [Category D]
    [Preadditive C] [Preadditive D] (F : C ⥤ D) [F.Additive]
    {A B E : C} {a : A ⟶ B} {b : B ⟶ E} (h : IsSplitExact a b) :
    IsSplitExact (F.map a) (F.map b) := by
  refine ⟨by rw [← F.map_comp, h.w, F.map_zero], ?_⟩
  obtain ⟨s, t, has, htb, hsum⟩ := h.exists_split
  refine ⟨F.map s, F.map t, by rw [← F.map_comp, has, F.map_id],
    by rw [← F.map_comp, htb, F.map_id], ?_⟩
  rw [← F.map_comp, ← F.map_comp, ← F.map_add, hsum, F.map_id]

private lemma IsSplitExact.dual_of_kernel_splitEpi {X : Scheme.{u}}
    {K P E : FiniteLocallyFreeSheaf X} (ι : K ⟶ P) (π : P ⟶ E)
    (hιπ : ι ≫ π = 0) (hK : IsLimit (KernelFork.ofι ι.hom (by
      rw [← ObjectProperty.FullSubcategory.comp_hom, hιπ]; rfl)))
    (σ : E ⟶ P) (hσ : σ ≫ π = 𝟙 E) :
    IsSplitExact (dualFunctor.map π.op) (dualFunctor.map ι.op) := by
  -- Construct the retraction `r : P ⟶ K` in `FiniteLocallyFreeSheaf X` from the kernel property.
  have hcomp : (𝟙 P.obj - π.hom ≫ σ.hom) ≫ π.hom = 0 := by
    rw [Preadditive.sub_comp, Category.id_comp, Category.assoc,
      ← ObjectProperty.FullSubcategory.comp_hom, hσ]
    simp
  let r : P ⟶ K := ObjectProperty.homMk (hK.lift (KernelFork.ofι (𝟙 P.obj - π.hom ≫ σ.hom) hcomp))
  have hrι : r ≫ ι = 𝟙 P - π ≫ σ := by
    apply ObjectProperty.hom_ext
    exact hK.fac (KernelFork.ofι (𝟙 P.obj - π.hom ≫ σ.hom) hcomp) .zero
  have hιr : ι ≫ r = 𝟙 K := by
    apply ObjectProperty.hom_ext
    have hmono : Mono ι.hom := Limits.mono_of_isLimit_fork hK
    rw [← cancel_mono ι.hom]
    have h1 : (ι ≫ r ≫ ι).hom = (𝟙 K ≫ ι).hom := by
      rw [hrι, Preadditive.comp_sub, Category.comp_id, ← Category.assoc, hιπ, Limits.zero_comp,
        sub_zero, Category.id_comp]
    simpa only [ObjectProperty.FullSubcategory.comp_hom, Category.assoc] using h1
  refine ⟨by rw [← dualFunctor.map_comp, ← op_comp, hιπ, dualFunctor_map_zero],
    dualFunctor.map σ.op, dualFunctor.map r.op,
    by rw [← dualFunctor.map_comp, ← op_comp, hσ, op_id, dualFunctor.map_id],
    by rw [← dualFunctor.map_comp, ← op_comp, hιr, op_id, dualFunctor.map_id], ?_⟩
  rw [← dualFunctor.map_comp, ← dualFunctor.map_comp, ← op_comp, ← op_comp, ← dualFunctor_map_add]
  have hsum : π ≫ σ + r ≫ ι = 𝟙 P := by rw [hrι, add_sub_cancel]
  rw [hsum, op_id, dualFunctor.map_id]

/-- On `Spec R`, every epimorphism of finite locally free sheaves splits and has finite locally
free kernel. -/
private theorem exists_split_and_isFiniteLocallyFree_kernel_spec {R : CommRingCat.{u}}
    {P E : FiniteLocallyFreeSheaf (Spec R)} (π : P ⟶ E) [Epi π.hom] :
    (∃ σ : E ⟶ P, σ ≫ π = 𝟙 E) ∧ Scheme.Modules.isFiniteLocallyFree (Spec R) (kernel π.hom) := by
  let qP : QuasicoherentSheaf (Spec R) := (toQuasicoherent (Spec R)).obj P
  let qE : QuasicoherentSheaf (Spec R) := (toQuasicoherent (Spec R)).obj E
  let qπ : qP ⟶ qE := ObjectProperty.homMk π.hom
  have hqπ : Epi qπ := ⟨fun _ _ h ↦ ObjectProperty.hom_ext _ ((cancel_epi π.hom).mp
    (congrArg (·.hom) h))⟩
  have hΓπ : Epi (moduleSpecΓFunctor.map π.hom) :=
    inferInstanceAs (Epi ((tildeEquiv (R := R)).inverse.map qπ))
  have hsurj : Function.Surjective (moduleSpecΓFunctor.map π.hom).hom :=
    (ModuleCat.epi_iff_surjective _).mp hΓπ
  have hPfin : Module.Finite R (moduleSpecΓFunctor.obj P.obj) :=
    (finite_projective_moduleSpecΓ P).1
  have hPproj : Module.Projective R (moduleSpecΓFunctor.obj P.obj) :=
    (finite_projective_moduleSpecΓ P).2
  have hEproj : Module.Projective R (moduleSpecΓFunctor.obj E.obj) :=
    (finite_projective_moduleSpecΓ E).2
  obtain ⟨s, hs⟩ := Module.projective_lifting_property (moduleSpecΓFunctor.map π.hom).hom
    LinearMap.id hsurj
  let σΓ : (tildeEquiv (R := R)).inverse.obj qE ⟶ (tildeEquiv (R := R)).inverse.obj qP :=
    ConcreteCategory.ofHom (C := ModuleCat R) s
  have hσΓ : σΓ ≫ (tildeEquiv (R := R)).inverse.map qπ = 𝟙 _ := ModuleCat.hom_ext hs
  -- Transport `σΓ` across `tildeEquiv` to split `π`.
  let qσ : qE ⟶ qP := (tildeEquiv (R := R)).counitIso.inv.app qE ≫
    (tildeEquiv (R := R)).functor.map σΓ ≫ (tildeEquiv (R := R)).counitIso.hom.app qP
  have hqσ : qσ ≫ qπ = 𝟙 qE := by
    have hnat := (tildeEquiv (R := R)).counitIso.hom.naturality qπ
    dsimp only [Functor.comp_map, Functor.id_map] at hnat
    simp only [qσ, Category.assoc]
    rw [← hnat, ← Functor.map_comp_assoc, hσΓ, CategoryTheory.Functor.map_id, Category.id_comp,
      Iso.inv_hom_id_app]
    rfl
  let σ : E ⟶ P := ObjectProperty.homMk qσ.hom
  have hσ : σ ≫ π = 𝟙 E := ObjectProperty.hom_ext _ (congrArg (·.hom) hqσ)
  -- The kernel in `ModuleCat R` is a direct summand of `Γ(P)`, hence finitely generated projective.
  let fΓ := moduleSpecΓFunctor.map π.hom
  let KΓ := kernel fΓ
  let σΓ' : moduleSpecΓFunctor.obj E.obj ⟶ moduleSpecΓFunctor.obj P.obj :=
    ConcreteCategory.ofHom (C := ModuleCat R) s
  have hσΓ' : σΓ' ≫ fΓ = 𝟙 _ := ModuleCat.hom_ext hs
  have hsub : (𝟙 _ - fΓ ≫ σΓ') ≫ fΓ = 0 := by
    rw [Preadditive.sub_comp, Category.id_comp, Category.assoc, hσΓ', Category.comp_id, sub_self]
  let rΓ : moduleSpecΓFunctor.obj P.obj ⟶ KΓ := kernel.lift fΓ (𝟙 _ - fΓ ≫ σΓ') hsub
  have hιrΓ : kernel.ι fΓ ≫ rΓ = 𝟙 KΓ := by
    rw [← cancel_mono (kernel.ι fΓ), Category.assoc, kernel.lift_ι, Preadditive.comp_sub,
      Category.comp_id, ← Category.assoc, kernel.condition, Limits.zero_comp, sub_zero,
      Category.id_comp]
  have hrΓ_surj : Function.Surjective rΓ.hom := fun x ↦
    ⟨(kernel.ι fΓ).hom x, congrArg (fun φ : KΓ ⟶ KΓ ↦ φ.hom x) hιrΓ⟩
  have hKfin : Module.Finite R KΓ := Module.Finite.of_surjective rΓ.hom hrΓ_surj
  have hKproj : Module.Projective R KΓ :=
    Module.Projective.of_split (kernel.ι fΓ).hom rΓ.hom (congrArg ModuleCat.Hom.hom hιrΓ)
  have hKflf : Scheme.Modules.isFiniteLocallyFree (Spec R) (kernel π.hom) :=
    (Scheme.Modules.isFiniteLocallyFree (Spec R)).prop_of_iso (Scheme.Modules.tildeKernelIso π.hom)
      ((isFiniteLocallyFree_tilde_iff KΓ).mpr ⟨hKfin, hKproj⟩)
  exact ⟨⟨σ, hσ⟩, hKflf⟩

/-- On an affine scheme, every epimorphism of finite locally free sheaves admits a section. -/
private theorem exists_split_of_isAffine {X : Scheme.{u}} [IsAffine X]
    {P E : FiniteLocallyFreeSheaf X} (π : P ⟶ E) [Epi π.hom] :
    ∃ σ : E ⟶ P, σ ≫ π = 𝟙 E := by
  let e : X ≅ Spec Γ(X, ⊤) := X.isoSpec
  let π' := (pullback e.inv).map π
  have hπ' : Epi π'.hom := by
    rw [pullback_map_hom]
    infer_instance
  obtain ⟨σ', hσ'⟩ := (@exists_split_and_isFiniteLocallyFree_kernel_spec _ _ _ π' hπ').1
  let σ'Mod : (Scheme.Modules.pullback e.inv).obj E.obj ⟶
      (Scheme.Modules.pullback e.inv).obj P.obj :=
    eqToHom (pullback_obj_obj e.inv E).symm ≫ σ'.hom ≫ eqToHom (pullback_obj_obj e.inv P)
  have hσ'Mod : σ'Mod ≫ (Scheme.Modules.pullback e.inv).map π.hom = 𝟙 _ := by
    have h1 := congrArg (·.hom) hσ'
    simp only [ObjectProperty.FullSubcategory.comp_hom, ObjectProperty.FullSubcategory.id_hom,
      π', pullback_map_hom] at h1
    have h2 := congrArg (eqToHom (pullback_obj_obj e.inv E).symm ≫ · ≫
      eqToHom (pullback_obj_obj e.inv E)) h1
    simpa only [σ'Mod, Category.assoc, eqToHom_trans_assoc, eqToHom_refl, Category.id_comp,
      eqToHom_trans, Category.comp_id] using h2
  let ηMod : Scheme.Modules.pullback e.inv ⋙ Scheme.Modules.pullback e.hom ≅ 𝟭 X.Modules :=
    Scheme.Modules.pullbackComp e.hom e.inv ≪≫
      Scheme.Modules.pullbackCongr e.hom_inv_id ≪≫
      Scheme.Modules.pullbackId X
  let σ : E ⟶ P := ObjectProperty.homMk
    (ηMod.inv.app E.obj ≫ (Scheme.Modules.pullback e.hom).map σ'Mod ≫ ηMod.hom.app P.obj)
  refine ⟨σ, ?_⟩
  apply ObjectProperty.hom_ext
  simp only [ObjectProperty.FullSubcategory.comp_hom, ObjectProperty.homMk_hom,
    ObjectProperty.FullSubcategory.id_hom, σ, Category.assoc]
  have hnat := ηMod.hom.naturality π.hom
  dsimp only [Functor.comp_map, Functor.id_map] at hnat
  rw [← hnat, ← Functor.map_comp_assoc, hσ'Mod, CategoryTheory.Functor.map_id, Category.id_comp,
    Iso.inv_hom_id_app]
  rfl

/-- The kernel of an epimorphism of finite locally free sheaves on an arbitrary scheme is finite
locally free. -/
theorem isFiniteLocallyFree_kernel_of_epi {X : Scheme.{u}}
    {P E : FiniteLocallyFreeSheaf X} (π : P ⟶ E) [Epi π.hom] :
    Scheme.Modules.isFiniteLocallyFree X (kernel π.hom) := by
  refine (Scheme.Modules.isFiniteLocallyFree_iff_forall_pullback X.affineCover _).mpr fun i ↦ ?_
  let f := X.affineCover.f i
  let πi := (pullback f).map π
  have hπi : Epi πi.hom := by
    rw [pullback_map_hom]
    infer_instance
  have hflf := (@exists_split_and_isFiniteLocallyFree_kernel_spec _ _ _ πi hπi).2
  have e : (Scheme.Modules.pullback f).obj (kernel π.hom) ≅ kernel πi.hom :=
    PreservesKernel.iso (Scheme.Modules.pullback f) π.hom ≪≫
      kernel.mapIso _ _ (eqToIso (pullback_obj_obj f P).symm)
        (eqToIso (pullback_obj_obj f E).symm) (by simp [πi, pullback_map_hom])
  exact (Scheme.Modules.isFiniteLocallyFree _).prop_of_iso e.symm hflf

-- Exposed so that `(kernelOfEpi π).obj` reduces definitionally to `kernel π.hom`, allowing
-- `kernelOfEpiι` and its `simp` lemmas to state `kernel.ι π.hom` without casts.
/-- The kernel of an epimorphism of finite locally free sheaves, bundled as a finite locally free
sheaf. -/
@[expose]
def kernelOfEpi {X : Scheme.{u}} {P E : FiniteLocallyFreeSheaf X} (π : P ⟶ E) [Epi π.hom] :
    FiniteLocallyFreeSheaf X :=
  ⟨kernel π.hom, isFiniteLocallyFree_kernel_of_epi π⟩

/-- The underlying module of `kernelOfEpi π` is `kernel π.hom`. -/
@[simp]
theorem kernelOfEpi_obj {X : Scheme.{u}} {P E : FiniteLocallyFreeSheaf X} (π : P ⟶ E) [Epi π.hom] :
    (kernelOfEpi π).obj = kernel π.hom :=
  (rfl)

/-- The canonical inclusion `kernelOfEpi π ⟶ P` of the kernel of an epimorphism of finite locally
free sheaves. -/
def kernelOfEpiι {X : Scheme.{u}} {P E : FiniteLocallyFreeSheaf X} (π : P ⟶ E) [Epi π.hom] :
    kernelOfEpi π ⟶ P :=
  ObjectProperty.homMk (kernel.ι π.hom)

/-- The underlying morphism of `kernelOfEpiι π` is `kernel.ι π.hom`. -/
@[simp]
theorem kernelOfEpiι_hom {X : Scheme.{u}} {P E : FiniteLocallyFreeSheaf X} (π : P ⟶ E) [Epi π.hom] :
    (kernelOfEpiι π).hom = kernel.ι π.hom :=
  (rfl)

/-- The kernel inclusion composed with `π` vanishes. -/
@[reassoc (attr := simp)]
theorem kernelOfEpiι_comp {X : Scheme.{u}} {P E : FiniteLocallyFreeSheaf X} (π : P ⟶ E)
    [Epi π.hom] :
    kernelOfEpiι π ≫ π = 0 :=
  ObjectProperty.hom_ext _ (kernel.condition π.hom)

/-- The pullback of the dualized sequence `E∨ → P∨ → (ker π)∨` along any morphism composes to
zero. -/
@[reassoc]
theorem pullback_dual_comp_eq_zero {X Y : Scheme.{u}} {P E : FiniteLocallyFreeSheaf X}
    (π : P ⟶ E) [Epi π.hom] (g : Y ⟶ X) :
    (Scheme.Modules.pullback g).map (dualFunctor.map π.op).hom ≫
      (Scheme.Modules.pullback g).map (dualFunctor.map (kernelOfEpiι π).op).hom = 0 := by
  rw [← Functor.map_comp, ← ObjectProperty.FullSubcategory.comp_hom, ← dualFunctor.map_comp,
    ← op_comp, kernelOfEpiι_comp, dualFunctor_map_zero]
  exact (Scheme.Modules.pullback g).map_zero _ _

/-- On an affine open `U` of `X`, the pullback along `g : Y ⟶ X` of the dualized sequence
`E∨ → P∨ → (ker π)∨`, restricted to `g ⁻¹ᵁ U`, is split exact. -/
private lemma isSplitExact_pullback_dual_on_preimage {X Y : Scheme.{u}}
    {P E : FiniteLocallyFreeSheaf X} (π : P ⟶ E) [Epi π.hom] (g : Y ⟶ X)
    (U : X.affineOpens) :
    IsSplitExact
      ((Scheme.Modules.pullback (g ⁻¹ᵁ U.1).ι).map
        ((Scheme.Modules.pullback g).map (dualFunctor.map π.op).hom))
      ((Scheme.Modules.pullback (g ⁻¹ᵁ U.1).ι).map
        ((Scheme.Modules.pullback g).map (dualFunctor.map (kernelOfEpiι π).op).hom)) := by
  have : IsAffine U.1.toScheme := U.2
  let πU := (pullback U.1.ι).map π
  let ιU := (pullback U.1.ι).map (kernelOfEpiι π)
  have hπU_epi : Epi πU.hom := by
    rw [pullback_map_hom]
    infer_instance
  obtain ⟨σU, hσU⟩ := @exists_split_of_isAffine _ _ _ _ πU hπU_epi
  have hιUπU : ιU ≫ πU = 0 := by
    rw [← Functor.map_comp, kernelOfEpiι_comp]
    apply ObjectProperty.hom_ext
    rw [pullback_map_hom]
    simp
  -- `ιU.hom` is a kernel of `πU.hom`, since `pullback U.1.ι` preserves limits.
  have hKU : IsLimit (KernelFork.ofι ιU.hom (by
      rw [← ObjectProperty.FullSubcategory.comp_hom, hιUπU]; rfl)) := by
    let eK : kernel ((Scheme.Modules.pullback U.1.ι).map π.hom) ≅
        ((pullback U.1.ι).obj (kernelOfEpi π)).obj :=
      (PreservesKernel.iso (Scheme.Modules.pullback U.1.ι) π.hom).symm ≪≫
        eqToIso (pullback_obj_obj U.1.ι (kernelOfEpi π)).symm
    let eP : (Scheme.Modules.pullback U.1.ι).obj P.obj ≅ ((pullback U.1.ι).obj P).obj :=
      eqToIso (pullback_obj_obj U.1.ι P).symm
    let eE : (Scheme.Modules.pullback U.1.ι).obj E.obj ≅ ((pullback U.1.ι).obj E).obj :=
      eqToIso (pullback_obj_obj U.1.ι E).symm
    have hι : ιU.hom = eK.inv ≫ kernel.ι ((Scheme.Modules.pullback U.1.ι).map π.hom) ≫ eP.hom := by
      simp only [ιU, eK, eP, pullback_map_hom, Iso.trans_inv, Iso.symm_inv, eqToIso.hom,
        Category.assoc]
      rw [PreservesKernel.iso_hom, kernelComparison_comp_ι_assoc]
      rfl
    have hπ : πU.hom = eP.inv ≫ (Scheme.Modules.pullback U.1.ι).map π.hom ≫ eE.hom := by
      simp [πU, eP, eE, pullback_map_hom]
    have : Mono ιU.hom := by rw [hι]; infer_instance
    refine KernelFork.IsLimit.ofι _ _
      (fun {W} f hf ↦ kernel.lift ((Scheme.Modules.pullback U.1.ι).map π.hom) (f ≫ eP.inv) (by
        rw [hπ] at hf
        rw [Category.assoc, ← cancel_mono eE.hom, Category.assoc, Limits.zero_comp]
        simpa [Category.assoc] using hf) ≫ eK.hom)
      (fun {W} f hf ↦ by
        rw [Category.assoc, hι, Iso.hom_inv_id_assoc, kernel.lift_ι_assoc, Category.assoc,
          Iso.inv_hom_id, Category.comp_id])
      (fun {W} f hf m hm ↦ by
        rw [← cancel_mono ιU.hom, hm, Category.assoc, hι, Iso.hom_inv_id_assoc,
          kernel.lift_ι_assoc, Category.assoc, Iso.inv_hom_id, Category.comp_id])
  have hsplitU : IsSplitExact (dualFunctor.map πU.op) (dualFunctor.map ιU.op) :=
    IsSplitExact.dual_of_kernel_splitEpi ιU πU hιUπU hKU σU hσU
  let fU : (g ⁻¹ᵁ U.1).toScheme ⟶ U.1.toScheme := g.resLE U.1 (g ⁻¹ᵁ U.1) le_rfl
  let F : FiniteLocallyFreeSheaf U.1.toScheme ⥤ (g ⁻¹ᵁ U.1).toScheme.Modules :=
    (Scheme.Modules.isFiniteLocallyFree _).ι ⋙ Scheme.Modules.pullback fU
  have : F.Additive := inferInstance
  have hsplitV : IsSplitExact (F.map (dualFunctor.map πU.op)) (F.map (dualFunctor.map ιU.op)) :=
    hsplitU.map F
  let compIso := Scheme.Modules.pullbackComp fU U.1.ι ≪≫
    Scheme.Modules.pullbackCongr (g.resLE_comp_ι le_rfl) ≪≫
    (Scheme.Modules.pullbackComp (g ⁻¹ᵁ U.1).ι g).symm
  let e (A : FiniteLocallyFreeSheaf X) :
      F.obj (dual ((pullback U.1.ι).obj A)) ≅
        (Scheme.Modules.pullback (g ⁻¹ᵁ U.1).ι).obj
          ((Scheme.Modules.pullback g).obj (dual A).obj) :=
    (Scheme.Modules.pullback fU).mapIso
      ((Scheme.Modules.isFiniteLocallyFree _).ι.mapIso (pullbackDualIso U.1.ι A).symm ≪≫
        eqToIso (pullback_obj_obj U.1.ι (dual A))) ≪≫
      compIso.app (dual A).obj
  have he_nat {A B : FiniteLocallyFreeSheaf X} (φ : A ⟶ B) :
      (e B).hom ≫ (Scheme.Modules.pullback (g ⁻¹ᵁ U.1).ι).map
        ((Scheme.Modules.pullback g).map (dualFunctor.map φ.op).hom) =
      F.map (dualFunctor.map ((pullback U.1.ι).map φ).op) ≫ (e A).hom := by
    have hnat : (dualFunctor.map ((pullback U.1.ι).map φ).op).hom ≫
        (pullbackDualIso U.1.ι A).inv.hom ≫
          eqToHom (pullback_obj_obj U.1.ι (dualFunctor.obj (op A))) =
        (pullbackDualIso U.1.ι B).inv.hom ≫
          eqToHom (pullback_obj_obj U.1.ι (dualFunctor.obj (op B))) ≫
          (Scheme.Modules.pullback U.1.ι).map (dualFunctor.map φ.op).hom := by
      let invA : (dualFunctor.obj (op ((pullback U.1.ι).obj A))).obj ⟶
          ((pullback U.1.ι).obj (dualFunctor.obj (op A))).obj :=
        (pullbackDualIso U.1.ι A).inv.hom
      let invB : (dualFunctor.obj (op ((pullback U.1.ι).obj B))).obj ⟶
          ((pullback U.1.ι).obj (dualFunctor.obj (op B))).obj :=
        (pullbackDualIso U.1.ι B).inv.hom
      have h1 := (pullbackDualNatIso U.1.ι).inv.naturality φ.op
      dsimp only [Functor.comp_map, Functor.op_map] at h1
      simp only [pullbackDualNatIso_inv_app] at h1
      have h2 : (dualFunctor.map ((pullback U.1.ι).map φ).op).hom ≫ invA =
          invB ≫ ((pullback U.1.ι).map (dualFunctor.map φ.op)).hom :=
        congrArg (·.hom) h1
      rw [pullback_map_hom] at h2
      have h3 := congrArg (· ≫ eqToHom (pullback_obj_obj U.1.ι (dualFunctor.obj (op A)))) h2
      rw [Category.assoc, Category.assoc, Category.assoc, Category.assoc, eqToHom_trans,
        eqToHom_refl, Category.comp_id] at h3
      exact h3
    have hcomp : (Scheme.Modules.pullback fU).map
        ((Scheme.Modules.pullback U.1.ι).map (dualFunctor.map φ.op).hom) ≫
        compIso.hom.app (dualFunctor.obj (op A)).obj =
        compIso.hom.app (dualFunctor.obj (op B)).obj ≫
        (Scheme.Modules.pullback (g ⁻¹ᵁ U.1).ι).map
          ((Scheme.Modules.pullback g).map (dualFunctor.map φ.op).hom) :=
      compIso.hom.naturality (dualFunctor.map φ.op).hom
    change (Scheme.Modules.pullback fU).map
        ((pullbackDualIso U.1.ι B).inv.hom ≫
          eqToHom (pullback_obj_obj U.1.ι (dualFunctor.obj (op B)))) ≫
        compIso.hom.app (dualFunctor.obj (op B)).obj ≫
        (Scheme.Modules.pullback (g ⁻¹ᵁ U.1).ι).map
          ((Scheme.Modules.pullback g).map (dualFunctor.map φ.op).hom) =
      (Scheme.Modules.pullback fU).map (dualFunctor.map ((pullback U.1.ι).map φ).op).hom ≫
        (Scheme.Modules.pullback fU).map
          ((pullbackDualIso U.1.ι A).inv.hom ≫
            eqToHom (pullback_obj_obj U.1.ι (dualFunctor.obj (op A)))) ≫
        compIso.hom.app (dualFunctor.obj (op A)).obj
    rw [← hcomp, ← Functor.map_comp_assoc, ← Functor.map_comp_assoc, hnat, Category.assoc]
    rfl
  exact hsplitV.of_iso (e E) (e P) (e (kernelOfEpi π)) (he_nat π) (he_nat (kernelOfEpiι π))

/-- For an epimorphism `π : P ⟶ E` of finite locally free sheaves, the pullback of `E∨ ⟶ P∨`
along any scheme morphism `g : Y ⟶ X` is a monomorphism. -/
theorem mono_pullback_dual_of_epi {X Y : Scheme.{u}} {P E : FiniteLocallyFreeSheaf X}
    (π : P ⟶ E) [Epi π.hom] (g : Y ⟶ X) :
    Mono ((Scheme.Modules.pullback g).map (dualFunctor.map π.op).hom) := by
  have hV : IsOpenCover (fun U : X.affineOpens ↦ g ⁻¹ᵁ U.1) :=
    X.isBasis_affineOpens.isOpenCover.comap g.base.hom
  exact (Scheme.Modules.mono_iff_of_isOpenCover hV _).mpr fun U ↦
    (isSplitExact_pullback_dual_on_preimage π g U).mono

/-- **Universal exactness of dualized short exact sequences.** For an epimorphism `π : P ⟶ E` of
finite locally free sheaves with kernel `ι : K ⟶ P`, the pullback of `E∨ → P∨ → K∨` along an
arbitrary scheme morphism `g : Y ⟶ X` is a kernel. -/
def isLimitPullbackDualOfEpi {X Y : Scheme.{u}} {P E : FiniteLocallyFreeSheaf X}
    (π : P ⟶ E) [Epi π.hom] (g : Y ⟶ X) :
    IsLimit (KernelFork.ofι ((Scheme.Modules.pullback g).map (dualFunctor.map π.op).hom)
      (pullback_dual_comp_eq_zero π g)) := by
  let α := (Scheme.Modules.pullback g).map (dualFunctor.map π.op).hom
  let β := (Scheme.Modules.pullback g).map (dualFunctor.map (kernelOfEpiι π).op).hom
  let k := kernel.lift β α (pullback_dual_comp_eq_zero π g)
  have hV : IsOpenCover (fun U : X.affineOpens ↦ g ⁻¹ᵁ U.1) :=
    X.isBasis_affineOpens.isOpenCover.comap g.base.hom
  have hk_iso : IsIso k := by
    refine (Scheme.Modules.isIso_iff_of_isOpenCover hV k).mpr fun U ↦ ?_
    let R := Scheme.Modules.pullback (g ⁻¹ᵁ U.1).ι
    have hsplit := isSplitExact_pullback_dual_on_preimage π g U
    have hlim₁ : IsLimit (KernelFork.ofι (R.map α) hsplit.w) := hsplit.isLimitKernelFork
    have hlim₂ : IsLimit (KernelFork.ofι (kernel.ι (R.map β)) (kernel.condition _)) :=
      kernelIsKernel (R.map β)
    let e := IsLimit.conePointUniqueUpToIso hlim₁ hlim₂
    have heq : R.map k ≫ (PreservesKernel.iso R β).hom = e.hom := by
      rw [← cancel_mono (kernel.ι (R.map β)), Category.assoc, PreservesKernel.iso_hom,
        kernelComparison_comp_ι, ← R.map_comp, kernel.lift_ι]
      exact (IsLimit.conePointUniqueUpToIso_hom_comp hlim₁ hlim₂ .zero).symm
    have : IsIso (R.map k ≫ (PreservesKernel.iso R β).hom) := heq ▸ e.isIso_hom
    exact IsIso.of_isIso_comp_right (R.map k) (PreservesKernel.iso R β).hom
  refine IsLimit.ofIsoLimit (kernelIsKernel β) (Fork.ext (asIso k).symm ?_)
  simp [k, α]

end SplitExact

end FiniteLocallyFreeSheaf

/-! ### Global generation by an ample line bundle -/

section AmpleGeneration

private lemma tensorPow_obj_iso_invertibleTensorPow {X : Scheme.{u}}
    (L : InvertibleSheaf X) (n : ℕ) :
    Nonempty (TauCeti.tensorPow L.obj n ≅ (L.tensorPow n).obj) := by
  induction n with
  | zero =>
    exact ⟨(InvertibleSheaf.trivialObjIsoUnit X).symm ≪≫
      eqToIso (congrArg (·.obj) (InvertibleSheaf.tensorPow_zero L).symm)⟩
  | succ n ih =>
    obtain ⟨e⟩ := ih
    exact ⟨whiskerLeftIso L.obj e ≪≫ β_ L.obj (L.tensorPow n).obj ≪≫
      (InvertibleSheaf.tensorProductObjIso (L.tensorPow n) L).symm ≪≫
      eqToIso (congrArg (·.obj) (InvertibleSheaf.tensorPow_succ L n).symm)⟩

private lemma associator_hom_app_tmulRight {X : Scheme.{u}}
    (F A B : X.Modules) {U : X.Opens} (b : Γ(B, U)) (a : Γ(A, U)) (t : Γ(F, U)) :
    (α_ F A B).hom.app U (Scheme.Modules.tmulRight (F ⊗ A) b (Scheme.Modules.tmulRight F a t)) =
      Scheme.Modules.tmulRight F (Scheme.Modules.tmulRight A b a) t := by
  have h := congrArg (fun φ ↦ φ.hom ((t ⊗ₜ a) ⊗ₜ b))
    (Functor.LaxMonoidal.associativity (Scheme.Modules.sectionsFunctor U) F A B)
  simp only [ModuleCat.hom_comp, LinearMap.comp_apply] at h
  rw [Scheme.Modules.tmulRight_apply (F := F ⊗ A), Scheme.Modules.tmulRight_apply (F := F),
    Scheme.Modules.tmulRight_apply (F := F), Scheme.Modules.tmulRight_apply (F := A)]
  exact h

private lemma leftUnitor_hom_app_tmulRight {X : Scheme.{u}}
    (M : X.Modules) {U : X.Opens} (m : Γ(M, U)) (r : Γ(X, U)) :
    (λ_ M).hom.app U (Scheme.Modules.tmulRight (𝟙_ X.Modules) m r) = r • m := by
  have h := congrArg (fun φ ↦ φ.hom (r ⊗ₜ m))
    (Functor.LaxMonoidal.left_unitality (Scheme.Modules.sectionsFunctor U) M)
  simp only [Scheme.Modules.sectionsFunctor_ε, ModuleCat.hom_comp, LinearMap.comp_apply] at h
  let r' : Γ(𝟙_ X.Modules, U) := r
  change (λ_ M).hom.app U (Scheme.Modules.tmulRight (𝟙_ X.Modules) m r') = r • m
  rw [Scheme.Modules.tmulRight_apply]
  exact h.symm

private lemma tensorPowAddIso_hom_app_tmulRight_tensorPowSection {X : Scheme.{u}}
    {L : X.Modules} {U : X.Opens} (s : Γ(L, U)) (m n : ℕ) :
    (TauCeti.tensorPowAddIso L m n).hom.app U
      (Scheme.Modules.tmulRight (TauCeti.tensorPow L m)
        (Scheme.Modules.tensorPowSection s n) (Scheme.Modules.tensorPowSection s m)) =
      Scheme.Modules.tensorPowSection s (n + m) := by
  induction m with
  | zero =>
    rw [TauCeti.tensorPowAddIso_zero, Scheme.Modules.tensorPowSection_zero]
    simpa [Nat.add_zero] using
      leftUnitor_hom_app_tmulRight (TauCeti.tensorPow L n)
        (Scheme.Modules.tensorPowSection s n) (1 : Γ(X, U))
  | succ m ih =>
    rw [TauCeti.tensorPowAddIso_succ_hom, Scheme.Modules.Hom.comp_app,
      ConcreteCategory.comp_apply, Scheme.Modules.tensorPowSection_succ,
      associator_hom_app_tmulRight, Scheme.Modules.whiskerLeft_app_tmulRight, ih]
    exact (Scheme.Modules.tensorPowSection_succ s (n + m)).symm

/-- If `t ∈ Γ(F, X_s)` satisfies `t ⊗ s^n = g|_{X_s}` for a section `g` of `F ⊗ L^n` over `U`,
then for every `d ≥ n` there is a section of `F ⊗ L^d` over `U` restricting to `t ⊗ s^d` on
`X_s`. -/
private lemma exists_map_eq_tmulRight_tensorPowSection_of_le {X : Scheme.{u}}
    (F : X.Modules) {L : X.Modules} [SheafOfModules.isInvertible X L]
    {U : X.Opens} (s : Γ(L, U))
    (t : Γ(F, L.nonvanishingLocus s)) {n d : ℕ} (hnd : n ≤ d)
    (g : Γ(F ⊗ TauCeti.tensorPow L n, U))
    (hg : (F ⊗ TauCeti.tensorPow L n).presheaf.map (homOfLE (L.nonvanishingLocus_le s)).op g =
      Scheme.Modules.tmulRight F
        (Scheme.Modules.tensorPowSection
          (L.presheaf.map (homOfLE (L.nonvanishingLocus_le s)).op s) n) t) :
    ∃ g' : Γ(F ⊗ TauCeti.tensorPow L d, U),
      (F ⊗ TauCeti.tensorPow L d).presheaf.map (homOfLE (L.nonvanishingLocus_le s)).op g' =
        Scheme.Modules.tmulRight F
          (Scheme.Modules.tensorPowSection
            (L.presheaf.map (homOfLE (L.nonvanishingLocus_le s)).op s) d) t := by
  obtain ⟨e, he⟩ := Nat.exists_eq_add_of_le' hnd
  subst he
  let ψ : (F ⊗ TauCeti.tensorPow L n) ⊗ TauCeti.tensorPow L e ⟶ F ⊗ TauCeti.tensorPow L (e + n) :=
    (α_ F (TauCeti.tensorPow L n) (TauCeti.tensorPow L e)).hom ≫
      F ◁ (TauCeti.tensorPowAddIso L n e).hom
  refine ⟨ψ.app U (Scheme.Modules.tmulRight _ (Scheme.Modules.tensorPowSection s e) g), ?_⟩
  have hnat := congrArg (fun φ ↦ φ (Scheme.Modules.tmulRight _
    (Scheme.Modules.tensorPowSection s e) g))
    (ψ.mapPresheaf.naturality (homOfLE (L.nonvanishingLocus_le s)).op)
  simp only [ConcreteCategory.comp_apply] at hnat
  change (F ⊗ TauCeti.tensorPow L (e + n)).presheaf.map (homOfLE (L.nonvanishingLocus_le s)).op
    ((ψ.mapPresheaf.app (op U)) _) = _
  rw [← hnat, Scheme.Modules.map_tmulRight_tensorPowSection, hg]
  change ψ.app (L.nonvanishingLocus s) _ = _
  simp only [ψ, Scheme.Modules.Hom.comp_app, ConcreteCategory.comp_apply,
    associator_hom_app_tmulRight, Scheme.Modules.whiskerLeft_app_tmulRight,
    tensorPowAddIso_hom_app_tmulRight_tensorPowSection]

/-- **Global generation by an ample line bundle** (Stacks, Lemma 28.26.13, Tag 01Q3). On a
quasi-separated scheme `X` with an ample line bundle `L`, every quasi-coherent `𝒪_X`-module `F`
of finite type admits, for any `N : ℕ`, a power `p ≥ N` and an epimorphism from a finite direct
sum of copies of `(L^{⊗ p})∨` onto `F`. -/
@[stacks 01Q3]
theorem _root_.AlgebraicGeometry.Scheme.Modules.exists_epi_biproduct_dual_tensorPow_of_isAmple
    {X : Scheme.{u}} [QuasiSeparatedSpace X]
    {L : InvertibleSheaf X} (hL : (LineBundleClass.mk L).IsAmple)
    (F : X.Modules) [F.IsQuasicoherent] [F.IsFiniteType] (N : ℕ) :
    ∃ (p : ℕ), N ≤ p ∧ ∃ (r : ℕ)
      (π : (⨁ fun _ : Fin r ↦
        (InvertibleSheaf.toFiniteLocallyFree X).obj (L.tensorPow p).dual).obj ⟶ F), Epi π := by
  classical
  have : CompactSpace X := hL.compactSpace
  have : HasFiniteBiproducts X.Modules := Abelian.hasFiniteBiproducts
  have : MonoidalPreadditive X.Modules := TauCeti.SheafOfModules.monoidalPreadditive X.sheaf
  -- Cover `X` by finitely many affine nonvanishing loci `U i = X_{s i}` of powers `L^{⊗ k i}`.
  have hpt (x : X) : ∃ (k : ℕ) (_ : 0 < k) (s : Γ((L.tensorPow k).obj, ⊤)),
      x ∈ (L.tensorPow k).obj.nonvanishingLocus s ∧
      IsAffineOpen ((L.tensorPow k).obj.nonvanishingLocus s) := by
    obtain ⟨k, hk, hspec⟩ := hL.exists_pos_forall_mk_eq x
    obtain ⟨s, hx, haff⟩ := hspec (L.tensorPow k) (LineBundleClass.mk_tensorPow L k)
    exact ⟨k, hk, s, hx, haff⟩
  choose k hk s hx haff using hpt
  obtain ⟨I, hIcov⟩ := isCompact_univ.elim_finite_subcover
    (fun x : X ↦ ((L.tensorPow (k x)).obj.nonvanishingLocus (s x) : Set X))
    (fun x ↦ ((L.tensorPow (k x)).obj.nonvanishingLocus (s x)).isOpen)
    (fun x _ ↦ Set.mem_iUnion.mpr ⟨x, hx x⟩)
  let U (i : I) : X.Opens := (L.tensorPow (k i.1)).obj.nonvanishingLocus (s i.1)
  have hUcov : IsOpenCover U := by
    refine eq_top_iff.mpr fun x _ ↦ ?_
    obtain ⟨y, hyI, hxy⟩ := Set.mem_iUnion₂.mp (hIcov (Set.mem_univ x))
    exact Opens.mem_iSup.mpr ⟨⟨y, hyI⟩, hxy⟩
  -- On each affine `U i`, choose finitely many generators `S i` of `Γ(F, U i)`.
  have hfg (i : I) : ∃ S : Finset Γ(F, U i),
      Submodule.span Γ(X, U i) (S : Set Γ(F, U i)) = ⊤ := by
    have : Module.Finite Γ(X, U i) Γ(F, U i) := F.finite_sections_of_isAffineOpen (U i) (haff i.1)
    exact Module.Finite.fg_top
  choose S hS using hfg
  -- Extend each generator `t ∈ S i` after multiplying by a power of `s i`.
  have hext (i : I) (t : S i) : ∃ (n : ℕ)
      (g : Γ(F ⊗ TauCeti.tensorPow (L.tensorPow (k i.1)).obj n, ⊤)),
      (F ⊗ TauCeti.tensorPow (L.tensorPow (k i.1)).obj n).presheaf.map
        (homOfLE ((L.tensorPow (k i.1)).obj.nonvanishingLocus_le (s i.1))).op g =
      Scheme.Modules.tmulRight F (Scheme.Modules.tensorPowSection
        ((L.tensorPow (k i.1)).obj.presheaf.map
          (homOfLE ((L.tensorPow (k i.1)).obj.nonvanishingLocus_le (s i.1))).op (s i.1)) n) t.1 :=
    have : SheafOfModules.isInvertible X (L.tensorPow (k i.1)).obj := (L.tensorPow (k i.1)).property
    Scheme.Modules.exists_map_eq_tmulRight_tensorPowSection F isCompact_univ
      isQuasiSeparated_univ (s i.1) t.1
  choose n g hg using hext
  -- Choose a common multiple `p ≥ N` of all `k i` with `p / k i ≥ n i t`.
  let K : ℕ := ∏ i : I, k i.1
  have hKpos : 0 < K := Finset.prod_pos fun i _ ↦ hk i.1
  let M₀ : ℕ := max N (Finset.univ.sup fun i : I ↦ Finset.univ.sup fun t : S i ↦ n i t)
  let p : ℕ := (M₀ + 1) * K
  have hNp : N ≤ p :=
    le_trans (le_max_left N _) (le_trans (Nat.le_succ M₀) (Nat.le_mul_of_pos_right _ hKpos))
  let d (i : I) : ℕ := (M₀ + 1) * (K / k i.1)
  have hkd (i : I) : k i.1 * d i = p := by
    have hdvd : k i.1 ∣ K := Finset.dvd_prod_of_mem (fun j : I ↦ k j.1) (Finset.mem_univ i)
    calc k i.1 * ((M₀ + 1) * (K / k i.1))
        = (M₀ + 1) * (k i.1 * (K / k i.1)) := by ring
      _ = (M₀ + 1) * K := by rw [Nat.mul_div_cancel' hdvd]
  have hnd (i : I) (t : S i) : n i t ≤ d i := by
    have hdiv_pos : 0 < K / k i.1 := Nat.div_pos
      (Nat.le_of_dvd hKpos (Finset.dvd_prod_of_mem (fun j : I ↦ k j.1) (Finset.mem_univ i)))
      (hk i.1)
    have hle1 : n i t ≤ M₀ := le_trans
      (le_trans (Finset.le_sup (f := fun t : S i ↦ n i t) (Finset.mem_univ t))
        (Finset.le_sup (f := fun j : I ↦ Finset.univ.sup fun t : S j ↦ n j t) (Finset.mem_univ i)))
      (le_max_right _ _)
    exact le_trans hle1 (le_trans (Nat.le_succ M₀) (Nat.le_mul_of_pos_right _ hdiv_pos))
  -- Boost each extended section to exponent `d i`, then identify `(L^{⊗ k i})^{⊗ d i} ≅ L^{⊗ p}`.
  have hboost (i : I) (t : S i) :=
    have : SheafOfModules.isInvertible X (L.tensorPow (k i.1)).obj := (L.tensorPow (k i.1)).property
    exists_map_eq_tmulRight_tensorPowSection_of_le F (s i.1) t.1 (hnd i t) (g i t) (hg i t)
  choose g' hg' using hboost
  have hiso (i : I) :
      Nonempty (TauCeti.tensorPow (L.tensorPow (k i.1)).obj (d i) ≅ (L.tensorPow p).obj) := by
    obtain ⟨e₁⟩ := tensorPow_obj_iso_invertibleTensorPow (L.tensorPow (k i.1)) (d i)
    obtain ⟨e₂⟩ := InvertibleSheaf.nonempty_tensorPow_tensorPow_iso L (k i.1) (d i)
    exact ⟨e₁ ≪≫ e₂ ≪≫ eqToIso (congrArg (fun m ↦ (L.tensorPow m).obj) (hkd i))⟩
  let e (i : I) : TauCeti.tensorPow (L.tensorPow (k i.1)).obj (d i) ≅ (L.tensorPow p).obj :=
    (hiso i).some
  -- Package all global sections of `F ⊗ L^{⊗ p}` into a map from a finite direct sum of `𝒪_X`.
  let idx := Σ i : I, S i
  let equivFin := Fintype.equivFin idx
  let r : ℕ := Fintype.card idx
  let sec (a : idx) : Γ(F ⊗ (L.tensorPow p).obj, ⊤) :=
    (F ◁ (e a.1).hom).app ⊤ (g' a.1 a.2)
  let ψ (j : Fin r) : (𝟙_ X.Modules : X.Modules) ⟶ F ⊗ (L.tensorPow p).obj :=
    (F ⊗ (L.tensorPow p).obj).unitHomEquivTop.symm (sec (equivFin.symm j))
  let φ : (⨁ fun _ : Fin r ↦ (𝟙_ X.Modules : X.Modules)) ⟶ F ⊗ (L.tensorPow p).obj :=
    biproduct.desc ψ
  -- Show `φ` is an epimorphism by verifying `image.ι φ` is an isomorphism on each affine `U i`.
  have hφ_epi : Epi φ := by
    have hflf_sum : Scheme.Modules.isFiniteLocallyFree X
        (⨁ fun _ : Fin r ↦ (𝟙_ X.Modules : X.Modules)) :=
      ObjectProperty.prop_of_isLimit (Scheme.Modules.isFiniteLocallyFree X)
        (biproduct.isLimit _) fun _ ↦ (Scheme.Modules.isFiniteLocallyFree X).prop_unit
    have : (⨁ fun _ : Fin r ↦ (𝟙_ X.Modules : X.Modules)).IsQuasicoherent := by
      let S : X.Modules := ⨁ fun _ : Fin r ↦ (𝟙_ X.Modules : X.Modules)
      let S0 : _root_.SheafOfModules X.ringCatSheaf := S
      have : S0.IsLocallyFree := hflf_sum.1
      exact inferInstanceAs S0.IsQuasicoherent
    have : (F ⊗ (L.tensorPow p).obj).IsQuasicoherent := inferInstance
    have hι_iso : IsIso (image.ι φ) := by
      refine (Scheme.Modules.isIso_iff_of_isOpenCover hUcov (image.ι φ)).mpr fun i ↦ ?_
      refine (NatIso.isIso_map_iff (Scheme.Modules.restrictFunctorIsoPullback (U i).ι)
        (image.ι φ)).mp ?_
      have : IsAffine (U i).toScheme := haff i.1
      have : Mono ((Scheme.Modules.restrictFunctor (U i).ι).map (image.ι φ)) :=
        (Scheme.Modules.restrictFunctor (U i).ι).map_mono (image.ι φ)
      refine Scheme.Modules.isIso_of_mono_of_surjective_sectionsFunctor_map_top _ ?_
      let ιU := (U i).ι
      have htop : ιU ''ᵁ ⊤ = U i := Scheme.Opens.ι_image_top (U i)
      -- Show `(image.ι φ).app (U i)` is surjective by showing its range contains the span of
      -- `Ψ (S i)` where `Ψ : Γ(F, U i) → Γ(F ⊗ L^{⊗ p}, U i)` is bijective.
      have hsurj_Ui : Function.Surjective ((image.ι φ).app (U i)) := by
        let s_res := (L.tensorPow (k i.1)).obj.presheaf.map
          (homOfLE ((L.tensorPow (k i.1)).obj.nonvanishingLocus_le (s i.1))).op (s i.1)
        let Ψ : Γ(F, U i) →ₗ[Γ(X, U i)] Γ(F ⊗ (L.tensorPow p).obj, U i) :=
          ((Scheme.Modules.sectionsFunctor (U i)).map (F ◁ (e i).hom)).hom.comp
            (Scheme.Modules.tmulRight F (Scheme.Modules.tensorPowSection s_res (d i)))
        have : SheafOfModules.isInvertible X (L.tensorPow (k i.1)).obj :=
          (L.tensorPow (k i.1)).property
        have hΨ_bij : Function.Bijective Ψ := by
          have h1 : Function.Bijective
              (Scheme.Modules.tmulRight F (Scheme.Modules.tensorPowSection s_res (d i))) :=
            Scheme.Modules.bijective_tmulRight_tensorPowSection_of_le_nonvanishingLocus F s_res
              (by rw [Scheme.Modules.nonvanishingLocus_map]; exact le_inf le_rfl le_rfl) (d i)
          have h2 : Function.Bijective
              ((Scheme.Modules.sectionsFunctor (U i)).map (F ◁ (e i).hom)).hom :=
            ConcreteCategory.bijective_of_isIso _
          exact h2.comp h1
        have hΨ_mem (t : S i) :
            Ψ t.1 ∈ LinearMap.range
              ((Scheme.Modules.sectionsFunctor (U i)).map (image.ι φ)).hom := by
          let j : Fin r := equivFin ⟨i, t⟩
          let one : Γ(𝟙_ X.Modules, U i) := (1 : Γ(X, U i))
          let u : Γ(image φ, U i) :=
            (biproduct.ι (fun _ : Fin r ↦ (𝟙_ X.Modules : X.Modules)) j ≫ factorThruImage φ).app
              (U i) one
          refine ⟨u, ?_⟩
          change (image.ι φ).app (U i) u = Ψ t.1
          dsimp only [u]
          rw [← ConcreteCategory.comp_apply, ← Scheme.Modules.Hom.comp_app, Category.assoc,
            image.fac]
          dsimp only [φ]
          rw [biproduct.ι_desc]
          have hsec : (ψ j).app (U i) one =
              (F ⊗ (L.tensorPow p).obj).presheaf.map (U i).leTop.op (sec ⟨i, t⟩) := by
            have := (F ⊗ (L.tensorPow p).obj).unitHomEquivTop_symm_val_app
              (sec (equivFin.symm j)) (U i) (1 : Γ(X, U i))
            rw [one_smul, Equiv.symm_apply_apply] at this
            change ((F ⊗ (L.tensorPow p).obj).unitHomEquivTop.symm
              (sec (equivFin.symm j))).val.app (op (U i)) (1 : Γ(X, U i)) = _
            rw [Equiv.symm_apply_apply]
            exact this
          rw [hsec]
          have hnat := congrArg (fun f ↦ f (g' i t))
            ((F ◁ (e i).hom).mapPresheaf.naturality (U i).leTop.op)
          simp only [ConcreteCategory.comp_apply] at hnat
          change (F ⊗ (L.tensorPow p).obj).presheaf.map (U i).leTop.op
            (((F ◁ (e i).hom).mapPresheaf.app (op ⊤)) (g' i t)) = Ψ t.1
          rw [← hnat]
          have hle : (U i).leTop =
              homOfLE ((L.tensorPow (k i.1)).obj.nonvanishingLocus_le (s i.1)) :=
            Subsingleton.elim _ _
          rw [hle, hg' i t]
          rfl
        intro y
        obtain ⟨x, rfl⟩ := hΨ_bij.2 y
        have hx : x ∈ Submodule.span Γ(X, U i) (S i : Set Γ(F, U i)) := hS i ▸ Submodule.mem_top
        have hle_range : Submodule.span Γ(X, U i) (S i : Set Γ(F, U i)) ≤
            Submodule.comap Ψ (LinearMap.range
              ((Scheme.Modules.sectionsFunctor (U i)).map (image.ι φ)).hom) :=
          Submodule.span_le.mpr fun t ht ↦ hΨ_mem ⟨t, ht⟩
        exact hle_range hx
      intro y
      let y' : Γ(F ⊗ (L.tensorPow p).obj, ιU ''ᵁ ⊤) := y
      obtain ⟨x, hx⟩ := hsurj_Ui ((F ⊗ (L.tensorPow p).obj).presheaf.map (eqToHom htop.symm).op y')
      refine ⟨(image φ).presheaf.map (eqToHom htop).op x, ?_⟩
      change ((image.ι φ).mapPresheaf.app (op (ιU ''ᵁ ⊤)))
        ((image φ).presheaf.map (eqToHom htop).op x) = y'
      have hnat := congrArg (fun f ↦ f x) ((image.ι φ).mapPresheaf.naturality (eqToHom htop).op)
      simp only [ConcreteCategory.comp_apply] at hnat
      rw [hnat]
      change (F ⊗ (L.tensorPow p).obj).presheaf.map (eqToHom htop).op ((image.ι φ).app (U i) x) = y'
      rw [hx, ← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp,
        eqToHom_trans, eqToHom_refl, op_id, CategoryTheory.Functor.map_id]
      rfl
    have := epi_comp (factorThruImage φ) (image.ι φ)
    rwa [image.fac] at this
  -- Tensor `φ` with `(L^{⊗ p})∨` and identify `(F ⊗ L^{⊗ p}) ⊗ (L^{⊗ p})∨ ≅ F`.
  let D : X.Modules := (L.tensorPow p).dual.obj
  let eBip : (⨁ fun _ : Fin r ↦
      (InvertibleSheaf.toFiniteLocallyFree X).obj (L.tensorPow p).dual).obj ≅
      (⨁ fun _ : Fin r ↦ D) :=
    (Scheme.Modules.isFiniteLocallyFree X).ι.mapBiproduct _
  let eL : (⨁ fun _ : Fin r ↦ D) ≅ (⨁ fun _ : Fin r ↦ (𝟙_ X.Modules : X.Modules)) ⊗ D :=
    (biproduct.mapIso fun _ ↦ (λ_ D).symm) ≪≫ (rightDistributor _ D).symm
  let eR : (F ⊗ (L.tensorPow p).obj) ⊗ D ≅ F :=
    α_ F (L.tensorPow p).obj D ≪≫
      whiskerLeftIso F
        (whiskerLeftIso (L.tensorPow p).obj (eqToIso (InvertibleSheaf.dual_obj (L.tensorPow p))) ≪≫
          InvertibleSheaf.evaluationDualIsoSheaf (L.tensorPow p)) ≪≫
      ρ_ F
  have : Epi (φ ▷ D) := (tensorRight D).map_epi φ
  refine ⟨p, hNp, r, eBip.hom ≫ eL.hom ≫ (φ ▷ D) ≫ eR.hom, inferInstance⟩

end AmpleGeneration

/-! ### Universally exact ample resolutions of finite locally free sheaves -/

namespace FiniteLocallyFreeSheaf

private def dualInvertibleDualIso {X : Scheme.{u}} (M : InvertibleSheaf X) :
    dual ((InvertibleSheaf.toFiniteLocallyFree X).obj M.dual) ≅
      (InvertibleSheaf.toFiniteLocallyFree X).obj M := by
  let B := (InvertibleSheaf.toFiniteLocallyFree X).obj M
  let e1 : (InvertibleSheaf.toFiniteLocallyFree X).obj M.dual ≅ dual B :=
    ObjectProperty.isoMk _ (eqToIso (InvertibleSheaf.dual_obj M))
  exact (dualFunctor.mapIso e1.op).symm ≪≫ (evalIso B).symm

private def dualOfBiproduct {X : Scheme.{u}} {ι : Type} [Fintype ι]
    (A B : ι → FiniteLocallyFreeSheaf X) (e : ∀ i, dualFunctor.obj (op (A i)) ≅ B i)
    (P : FiniteLocallyFreeSheaf X)
    (ιP : ∀ i, A i ⟶ P) (πP : ∀ i, P ⟶ A i)
    (hιπ_self : ∀ i, ιP i ≫ πP i = 𝟙 (A i))
    (hιπ_ne : ∀ i j, i ≠ j → ιP i ≫ πP j = 0)
    (htotal : ∑ i : ι, πP i ≫ ιP i = 𝟙 P) :
    dualFunctor.obj (op P) ≅ ⨁ B := by
  let f (i : ι) : dualFunctor.obj (op P) ⟶ B i := dualFunctor.map (ιP i).op ≫ (e i).hom
  let g (i : ι) : B i ⟶ dualFunctor.obj (op P) := (e i).inv ≫ dualFunctor.map (πP i).op
  let hom : dualFunctor.obj (op P) ⟶ ⨁ B := biproduct.lift f
  let inv : (⨁ B) ⟶ dualFunctor.obj (op P) := biproduct.desc g
  refine ⟨hom, inv, ?_, ?_⟩
  · calc hom ≫ inv
        = ∑ i : ι, (hom ≫ biproduct.π B i) ≫ (biproduct.ι B i ≫ inv) := by
          conv_lhs => rw [← Category.comp_id hom, ← biproduct.total (f := B)]
          rw [Preadditive.comp_sum, Preadditive.sum_comp]
          refine Finset.sum_congr rfl fun i _ ↦ ?_
          simp only [Category.assoc]
      _ = ∑ i : ι, dualFunctor.map (πP i ≫ ιP i).op := by
          refine Finset.sum_congr rfl fun i _ ↦ ?_
          dsimp only [hom, inv]
          rw [biproduct.lift_π, biproduct.ι_desc]
          dsimp only [f, g]
          rw [Category.assoc, Iso.hom_inv_id_assoc, ← dualFunctor.map_comp, ← op_comp]
      _ = dualFunctor.map (∑ i : ι, πP i ≫ ιP i).op :=
          (dualFunctor_map_sum _ _).symm
      _ = 𝟙 _ := by rw [htotal, op_id, dualFunctor.map_id]
  · refine biproduct.hom_ext' _ _ fun i ↦ biproduct.hom_ext _ _ fun j ↦ ?_
    dsimp only [hom, inv]
    rw [Category.comp_id, ← Category.assoc, biproduct.ι_desc,
      Category.assoc, biproduct.lift_π]
    dsimp only [f, g]
    rw [Category.assoc, ← dualFunctor.map_comp_assoc, ← op_comp]
    by_cases h : i = j
    · subst h
      rw [hιπ_self, op_id, dualFunctor.map_id, Category.id_comp, Iso.inv_hom_id,
        biproduct.ι_π_self]
    · rw [hιπ_ne _ _ (Ne.symm h), dualFunctor_map_zero, Limits.zero_comp, Limits.comp_zero,
        biproduct.ι_π_ne _ h]

private def isLimitKernelForkOfIso {C : Type*} [Category C] [HasZeroMorphisms C]
    {K P Q K' P' Q' : C} {f : K ⟶ P} {g : P ⟶ Q} {hfg : f ≫ g = 0}
    {f' : K' ⟶ P'} {g' : P' ⟶ Q'} {hf'g' : f' ≫ g' = 0}
    (hlim : IsLimit (KernelFork.ofι f hfg))
    (e₁ : K' ≅ K) (e₂ : P ≅ P') (e₃ : Q ≅ Q')
    (hf : f' = e₁.hom ≫ f ≫ e₂.hom) (hg : g' = e₂.inv ≫ g ≫ e₃.hom) :
    IsLimit (KernelFork.ofι f' hf'g') := by
  have : Mono f := Limits.mono_of_isLimit_fork hlim
  have : Mono f' := by rw [hf]; infer_instance
  have hw {W : C} (u : W ⟶ P') (hu : u ≫ g' = 0) : (u ≫ e₂.inv) ≫ g = 0 := by
    rw [← cancel_mono e₃.hom, Category.assoc, Category.assoc, Limits.zero_comp, ← hg]
    exact hu
  refine KernelFork.IsLimit.ofι _ _
    (fun {W} u hu ↦ hlim.lift (KernelFork.ofι (u ≫ e₂.inv) (hw u hu)) ≫ e₁.inv)
    (fun {W} u hu ↦ ?_) (fun {W} u hu m hm ↦ ?_)
  · have hfac : hlim.lift (KernelFork.ofι (u ≫ e₂.inv) (hw u hu)) ≫ f = u ≫ e₂.inv :=
      hlim.fac (KernelFork.ofι (u ≫ e₂.inv) (hw u hu)) .zero
    rw [Category.assoc, hf, Iso.inv_hom_id_assoc, ← Category.assoc, hfac, Category.assoc,
      Iso.inv_hom_id, Category.comp_id]
  · have hfac : hlim.lift (KernelFork.ofι (u ≫ e₂.inv) (hw u hu)) ≫ f = u ≫ e₂.inv :=
      hlim.fac (KernelFork.ofι (u ≫ e₂.inv) (hw u hu)) .zero
    rw [← cancel_mono f', hm, Category.assoc, hf, Iso.inv_hom_id_assoc, ← Category.assoc, hfac,
      Category.assoc, Iso.inv_hom_id, Category.comp_id]

private theorem exists_universallyExact_ample_step_of_iso {X : Scheme.{u}}
    {E P Q0 : FiniteLocallyFreeSheaf X} (π : P ⟶ dual E) [Epi π.hom]
    (eDualP : dualFunctor.obj (op P) ≅ Q0) :
    ∃ (Q : FiniteLocallyFreeSheaf X) (α : E ⟶ Q0) (δ : Q0 ⟶ Q) (hαδ : α ≫ δ = 0),
      ∀ {Y : Scheme.{u}} (g : Y ⟶ X),
        Nonempty (IsLimit (KernelFork.ofι ((Scheme.Modules.pullback g).map α.hom)
          (show (Scheme.Modules.pullback g).map α.hom ≫
              (Scheme.Modules.pullback g).map δ.hom = 0 by
            rw [← Functor.map_comp, ← ObjectProperty.FullSubcategory.comp_hom, hαδ]
            exact (Scheme.Modules.pullback g).map_zero _ _))) := by
  let K := kernelOfEpi π
  let eEval : E ≅ dualFunctor.obj (op (dual E)) := evalIso E
  let α : E ⟶ Q0 := eEval.hom ≫ dualFunctor.map π.op ≫ eDualP.hom
  let δ : Q0 ⟶ dualFunctor.obj (op K) := eDualP.inv ≫ dualFunctor.map (kernelOfEpiι π).op
  have hαδ : α ≫ δ = 0 := by
    dsimp only [α, δ]
    rw [Category.assoc, Category.assoc, Iso.hom_inv_id_assoc, ← dualFunctor.map_comp,
      ← op_comp, kernelOfEpiι_comp, dualFunctor_map_zero, Limits.comp_zero]
  refine ⟨dualFunctor.obj (op K), α, δ, hαδ, fun {Y} g ↦ ?_⟩
  let gStar := Scheme.Modules.pullback g
  let e₁ : gStar.obj E.obj ≅ gStar.obj (dualFunctor.obj (op (dual E))).obj :=
    gStar.mapIso ((Scheme.Modules.isFiniteLocallyFree X).ι.mapIso eEval)
  let e₂ : gStar.obj (dualFunctor.obj (op P)).obj ≅ gStar.obj Q0.obj :=
    gStar.mapIso ((Scheme.Modules.isFiniteLocallyFree X).ι.mapIso eDualP)
  let e₃ := Iso.refl (gStar.obj (dualFunctor.obj (op K)).obj)
  have hα : gStar.map α.hom = e₁.hom ≫ gStar.map (dualFunctor.map π.op).hom ≫ e₂.hom := by
    change gStar.map (eEval.hom.hom ≫ (dualFunctor.map π.op).hom ≫ eDualP.hom.hom) = _
    rw [Functor.map_comp, Functor.map_comp]
    rfl
  have hδ : gStar.map δ.hom =
      e₂.inv ≫ gStar.map (dualFunctor.map (kernelOfEpiι π).op).hom ≫ e₃.hom := by
    change gStar.map (eDualP.inv.hom ≫ (dualFunctor.map (kernelOfEpiι π).op).hom) = _
    dsimp only [e₂, e₃]
    rw [Functor.map_comp, Iso.refl_hom, Category.comp_id]
    rfl
  exact ⟨isLimitKernelForkOfIso (isLimitPullbackDualOfEpi π g) e₁ e₂ e₃ hα hδ⟩

/-- One-step universally exact ample resolution of a finite locally free sheaf `E`: there exist
`p ≥ N`, `r : ℕ`, a finite locally free sheaf `Q`, and maps `α : E ⟶ ⨁_{Fin r} L^{⊗ p}` and
`δ : (⨁_{Fin r} L^{⊗ p}) ⟶ Q` whose pullback along every scheme morphism is a kernel. -/
private theorem exists_universallyExact_ample_step {X : Scheme.{u}} [QuasiSeparatedSpace X]
    {L : InvertibleSheaf X} (hL : (LineBundleClass.mk L).IsAmple)
    (E : FiniteLocallyFreeSheaf X) (N : ℕ) :
    ∃ (p : ℕ) (_ : N ≤ p) (r : ℕ) (Q : FiniteLocallyFreeSheaf X)
      (α : E ⟶ ⨁ fun _ : Fin r ↦ (InvertibleSheaf.toFiniteLocallyFree X).obj (L.tensorPow p))
      (δ : (⨁ fun _ : Fin r ↦ (InvertibleSheaf.toFiniteLocallyFree X).obj (L.tensorPow p)) ⟶ Q)
      (hαδ : α ≫ δ = 0),
      ∀ {Y : Scheme.{u}} (g : Y ⟶ X),
        Nonempty (IsLimit (KernelFork.ofι ((Scheme.Modules.pullback g).map α.hom)
          (show (Scheme.Modules.pullback g).map α.hom ≫
              (Scheme.Modules.pullback g).map δ.hom = 0 by
            rw [← Functor.map_comp, ← ObjectProperty.FullSubcategory.comp_hom, hαδ]
            exact (Scheme.Modules.pullback g).map_zero _ _))) := by
  have hdE_qc : (dual E).obj.IsQuasicoherent := by
    let F : _root_.SheafOfModules X.ringCatSheaf := (dual E).obj
    have : F.IsLocallyFree := (dual E).property.1
    exact inferInstanceAs F.IsQuasicoherent
  have hdE_ft : (dual E).obj.IsFiniteType := by
    let F : _root_.SheafOfModules X.ringCatSheaf := (dual E).obj
    have : F.IsFinitePresentation := (dual E).property.2
    exact inferInstanceAs F.IsFiniteType
  obtain ⟨p, hNp, r, π₀, hπ₀⟩ :=
    Scheme.Modules.exists_epi_biproduct_dual_tensorPow_of_isAmple hL (dual E).obj N
  let A : Fin r → FiniteLocallyFreeSheaf X :=
    fun _ ↦ (InvertibleSheaf.toFiniteLocallyFree X).obj (L.tensorPow p).dual
  let B : Fin r → FiniteLocallyFreeSheaf X :=
    fun _ ↦ (InvertibleSheaf.toFiniteLocallyFree X).obj (L.tensorPow p)
  let π : (⨁ A) ⟶ dual E := ObjectProperty.homMk π₀
  have : Epi π.hom := hπ₀
  let eDualP : dualFunctor.obj (op (⨁ A)) ≅ ⨁ B :=
    dualOfBiproduct A B (fun _ ↦ dualInvertibleDualIso (L.tensorPow p)) (⨁ A)
      (biproduct.ι A) (biproduct.π A) (biproduct.ι_π_self A)
      (fun _ _ h ↦ biproduct.ι_π_ne A h) (biproduct.total (f := A))
  obtain ⟨Q, α, δ, hαδ, hlim⟩ := exists_universallyExact_ample_step_of_iso π eDualP
  exact ⟨p, hNp, r, Q, α, δ, hαδ, hlim⟩

/-- **Universally exact ample resolution of a finite locally free sheaf.** On a quasi-separated
scheme `X` with an ample line bundle `L`, every finite locally free sheaf `E` admits, for every
bound `N : ℕ`, powers `p, q ≥ N` and a sequence
`0 → E → ⨁_{Fin r} L^{⊗ p} → ⨁_{Fin s} L^{⊗ q}` whose pullback along every scheme morphism
`g : Y ⟶ X` is a kernel. -/
theorem exists_universallyExact_ample_resolution {X : Scheme.{u}} [QuasiSeparatedSpace X]
    {L : InvertibleSheaf X} (hL : (LineBundleClass.mk L).IsAmple)
    (E : FiniteLocallyFreeSheaf X) (N : ℕ) :
    ∃ (p q : ℕ) (_ : N ≤ p) (_ : N ≤ q) (r s : ℕ)
      (α : E ⟶ ⨁ fun _ : Fin r ↦ (InvertibleSheaf.toFiniteLocallyFree X).obj (L.tensorPow p))
      (β : (⨁ fun _ : Fin r ↦ (InvertibleSheaf.toFiniteLocallyFree X).obj (L.tensorPow p)) ⟶
        ⨁ fun _ : Fin s ↦ (InvertibleSheaf.toFiniteLocallyFree X).obj (L.tensorPow q))
      (hαβ : α ≫ β = 0),
      ∀ {Y : Scheme.{u}} (g : Y ⟶ X),
        Nonempty (IsLimit (KernelFork.ofι ((Scheme.Modules.pullback g).map α.hom)
          (show (Scheme.Modules.pullback g).map α.hom ≫
              (Scheme.Modules.pullback g).map β.hom = 0 by
            rw [← Functor.map_comp, ← ObjectProperty.FullSubcategory.comp_hom, hαβ]
            exact (Scheme.Modules.pullback g).map_zero _ _))) := by
  obtain ⟨p, hNp, r, Q, α, δ, hαδ, hlim₁⟩ := exists_universallyExact_ample_step hL E N
  obtain ⟨q, hNq, s, _, γ, _, _, hlim₂⟩ := exists_universallyExact_ample_step hL Q N
  have hαβ : α ≫ (δ ≫ γ) = 0 := by rw [← Category.assoc, hαδ, Limits.zero_comp]
  refine ⟨p, q, hNp, hNq, r, s, α, δ ≫ γ, hαβ, fun {Y} g ↦ ?_⟩
  obtain ⟨h₁⟩ := hlim₁ g
  obtain ⟨h₂⟩ := hlim₂ g
  have hγ_mono : Mono ((Scheme.Modules.pullback g).map γ.hom) := Limits.mono_of_isLimit_fork h₂
  have hα_mono : Mono ((Scheme.Modules.pullback g).map α.hom) := Limits.mono_of_isLimit_fork h₁
  refine ⟨KernelFork.IsLimit.ofι _ _
    (fun {W} f hf ↦ h₁.lift (KernelFork.ofι f (by
      rw [← cancel_mono ((Scheme.Modules.pullback g).map γ.hom), Limits.zero_comp,
        Category.assoc, ← Functor.map_comp]
      exact hf)))
    (fun {W} f hf ↦ h₁.fac (KernelFork.ofι f _) .zero)
    (fun {W} f hf m hm ↦ by
      rw [← cancel_mono ((Scheme.Modules.pullback g).map α.hom), hm]
      exact (h₁.fac (KernelFork.ofι f _) .zero).symm)⟩

end FiniteLocallyFreeSheaf

end

