open scoped ComplexConjugate ComplexOrder

namespace TauCeti.TemperleyLieb

/-! ### The primitive cube root of unity `ω = exp (2πi / 3)` in `ℂ` -/

/-- The primitive cube root of unity `ω = exp (2πi / 3)` as a unit of `ℂ`. -/
noncomputable def cubeRootOfUnity : ℂˣ :=
  Units.mk0 (Complex.exp (2 * Real.pi / 3 * Complex.I)) (Complex.exp_ne_zero _)

/-- Unfolding `cubeRootOfUnity` as `Complex.exp (2πi / 3)`. -/
theorem coe_cubeRootOfUnity :
    (cubeRootOfUnity : ℂ) = Complex.exp (2 * Real.pi / 3 * Complex.I) :=
  (rfl)

/-- `ω ^ 3 = 1` in `ℂˣ`. -/
@[simp]
theorem cubeRootOfUnity_pow_three : cubeRootOfUnity ^ 3 = 1 := by
  ext
  simp only [Units.val_pow_eq_pow_val, coe_cubeRootOfUnity, Units.val_one]
  rw [← Complex.exp_nat_mul]
  convert Complex.exp_two_pi_mul_I using 2
  push_cast
  ring

/-- `ω ^ 3 = 1` in `ℂ`. -/
@[simp]
theorem coe_cubeRootOfUnity_pow_three : (cubeRootOfUnity : ℂ) ^ 3 = 1 := by
  rw [← Units.val_pow_eq_pow_val, cubeRootOfUnity_pow_three, Units.val_one]

/-- Explicit rectangular form `ω = -1 / 2 + (√3 / 2) * I`. -/
theorem coe_cubeRootOfUnity_eq :
    (cubeRootOfUnity : ℂ) = -1 / 2 + Real.sqrt 3 / 2 * Complex.I := by
  have harg : (2 * Real.pi / 3 : ℂ) = ((Real.pi - Real.pi / 3 : ℝ) : ℂ) := by
    push_cast
    ring
  rw [coe_cubeRootOfUnity, harg, Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin,
    Real.cos_pi_sub, Real.sin_pi_sub, Real.cos_pi_div_three, Real.sin_pi_div_three]
  push_cast
  ring

/-- `ω ≠ 1` in `ℂ`. -/
theorem coe_cubeRootOfUnity_ne_one : (cubeRootOfUnity : ℂ) ≠ 1 := by
  intro h
  have hre := congrArg Complex.re h
  rw [coe_cubeRootOfUnity_eq] at hre
  simp at hre
  norm_num at hre

/-- Minimal polynomial relation `ω ^ 2 + ω + 1 = 0`. -/
theorem coe_cubeRootOfUnity_sq_add_add_one :
    (cubeRootOfUnity : ℂ) ^ 2 + (cubeRootOfUnity : ℂ) + 1 = 0 := by
  have h3 :
      ((cubeRootOfUnity : ℂ) - 1) * ((cubeRootOfUnity : ℂ) ^ 2 + cubeRootOfUnity + 1) = 0 := by
    linear_combination coe_cubeRootOfUnity_pow_three
  exact (mul_eq_zero.mp h3).resolve_left (sub_ne_zero.mpr coe_cubeRootOfUnity_ne_one)

/-- Complex conjugation inverts `ω`. -/
@[simp]
theorem star_coe_cubeRootOfUnity :
    star (cubeRootOfUnity : ℂ) = ((cubeRootOfUnity⁻¹ : ℂˣ) : ℂ) := by
  rw [Complex.star_def, coe_cubeRootOfUnity, ← Complex.exp_conj, Units.val_inv_eq_inv_val,
    coe_cubeRootOfUnity, ← Complex.exp_neg]
  congr 1
  simp [Complex.conj_ofReal, map_ofNat]

/-- The `ZMod 3`-indexed powers `x ↦ ω ^ x.val` in `ℂˣ`. -/
noncomputable def cubeRootPow (x : ZMod 3) : ℂˣ :=
  cubeRootOfUnity ^ x.val

/-- `cubeRootPow` sends `0` to `1`. -/
@[simp]
theorem cubeRootPow_zero : cubeRootPow 0 = 1 := by
  simp [cubeRootPow]

/-- `cubeRootPow` sends `1` to `cubeRootOfUnity`. -/
@[simp]
theorem cubeRootPow_one : cubeRootPow 1 = cubeRootOfUnity := by
  have h1 : (1 : ZMod 3).val = 1 := by decide
  rw [cubeRootPow, h1, pow_one]

/-- `cubeRootPow` is additive in the exponent `ZMod 3`. -/
theorem cubeRootPow_add (x y : ZMod 3) :
    cubeRootPow (x + y) = cubeRootPow x * cubeRootPow y := by
  simp only [cubeRootPow, ZMod.val_add]
  rw [← pow_add, ← pow_eq_pow_mod _ cubeRootOfUnity_pow_three]

/-- Negating the exponent inverts `cubeRootPow`. -/
theorem cubeRootPow_neg (x : ZMod 3) : cubeRootPow (-x) = (cubeRootPow x)⁻¹ :=
  eq_inv_of_mul_eq_one_left (by rw [← cubeRootPow_add, neg_add_cancel, cubeRootPow_zero])

/-- Complex conjugation negates the `ZMod 3` exponent of `cubeRootPow`. -/
@[simp]
theorem star_coe_cubeRootPow (x : ZMod 3) :
    star (cubeRootPow x : ℂ) = (cubeRootPow (-x) : ℂ) := by
  rw [cubeRootPow_neg, Units.val_inv_eq_inv_val, cubeRootPow, Units.val_pow_eq_pow_val,
    star_pow, star_coe_cubeRootOfUnity, Units.val_inv_eq_inv_val, inv_pow]

/-! ### The chain alternating form and the cubic quantum torus `CubicTorus N` -/

/-- The alternating nearest-neighbor **chain form**
`B(a, b) = ∑_{j < N - 1} (a_j b_{j + 1} - b_j a_{j + 1})` on `Fin N → ZMod 3`. -/
def chainForm (N : ℕ) : LinearMap.BilinForm (ZMod 3) (Fin N → ZMod 3) :=
  LinearMap.mk₂ (ZMod 3)
    (fun a b ↦ ∑ j : Fin (N - 1),
      (a ⟨j.1, by omega⟩ * b ⟨j.1 + 1, by omega⟩ - b ⟨j.1, by omega⟩ * a ⟨j.1 + 1, by omega⟩))
    (fun a₁ a₂ b ↦ by
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun j _ ↦ ?_
      simp only [Pi.add_apply]; ring)
    (fun c a b ↦ by
      simp only [smul_eq_mul, Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ ↦ ?_
      simp only [Pi.smul_apply, smul_eq_mul]; ring)
    (fun a b₁ b₂ ↦ by
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun j _ ↦ ?_
      simp only [Pi.add_apply]; ring)
    (fun c a b ↦ by
      simp only [smul_eq_mul, Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ ↦ ?_
      simp only [Pi.smul_apply, smul_eq_mul]; ring)

/-- Coordinate formula for `chainForm N`. -/
theorem chainForm_apply (N : ℕ) (a b : Fin N → ZMod 3) :
    chainForm N a b =
      ∑ j : Fin (N - 1),
        (a ⟨j.1, by omega⟩ * b ⟨j.1 + 1, by omega⟩ - b ⟨j.1, by omega⟩ * a ⟨j.1 + 1, by omega⟩) :=
  (rfl)

/-- `chainForm N` is alternating. -/
theorem isAlt_chainForm (N : ℕ) : (chainForm N).IsAlt := by
  intro a
  rw [chainForm_apply]
  refine Finset.sum_eq_zero fun j _ ↦ by ring

/-- `chainForm N` vanishes on the diagonal. -/
@[simp]
theorem chainForm_self (N : ℕ) (a : Fin N → ZMod 3) : chainForm N a a = 0 :=
  isAlt_chainForm N a

/-- Swapping arguments negates `chainForm N`. -/
theorem chainForm_swap (N : ℕ) (a b : Fin N → ZMod 3) :
    chainForm N b a = -chainForm N a b := by
  rw [chainForm_apply, chainForm_apply, ← Finset.sum_neg_distrib]
  refine Finset.sum_congr rfl fun j _ ↦ by ring

/-- Simultaneous negation preserves `chainForm N`. -/
theorem chainForm_neg_neg (N : ℕ) (a b : Fin N → ZMod 3) :
    chainForm N (-a) (-b) = chainForm N a b := by
  simp

/-- Evaluating `chainForm N a (Pi.single k 1)` extracts the difference of the two coordinates of `a`
adjacent to `k`. -/
theorem chainForm_single_right (N : ℕ) (a : Fin N → ZMod 3) (k : Fin N) :
    chainForm N a (Pi.single k 1) =
      (if h : 0 < (k : ℕ) then a ⟨k.1 - 1, by omega⟩ else 0) -
        (if h : (k : ℕ) + 1 < N then a ⟨k.1 + 1, h⟩ else 0) := by
  rw [chainForm_apply, Finset.sum_sub_distrib]
  congr 1
  · split_ifs with hk
    · rw [Finset.sum_eq_single ⟨k.1 - 1, by omega⟩]
      · have hidx : (⟨(⟨k.1 - 1, by omega⟩ : Fin (N - 1)).1 + 1, by omega⟩ : Fin N) = k :=
          Fin.ext (by dsimp; omega)
        rw [hidx, Pi.single_eq_same, mul_one]
      · intro j _ hj
        have hne : (⟨j.1 + 1, by omega⟩ : Fin N) ≠ k := fun h ↦
          hj (Fin.ext (by have := congrArg Fin.val h; dsimp at *; omega))
        rw [Pi.single_eq_of_ne hne, mul_zero]
      · intro hmem; exact absurd (Finset.mem_univ _) hmem
    · refine Finset.sum_eq_zero fun j _ ↦ ?_
      have hne : (⟨j.1 + 1, by omega⟩ : Fin N) ≠ k := ne_of_apply_ne Fin.val (by dsimp; omega)
      rw [Pi.single_eq_of_ne hne, mul_zero]
  · split_ifs with hk
    · rw [Finset.sum_eq_single ⟨k.1, by omega⟩]
      · have hidx : (⟨(⟨k.1, by omega⟩ : Fin (N - 1)).1, by omega⟩ : Fin N) = k := Fin.ext rfl
        rw [hidx, Pi.single_eq_same, one_mul]
      · intro j _ hj
        have hne : (⟨j.1, by omega⟩ : Fin N) ≠ k := fun h ↦
          hj (Fin.ext (by have := congrArg Fin.val h; dsimp at *; omega))
        rw [Pi.single_eq_of_ne hne, zero_mul]
      · intro hmem; exact absurd (Finset.mem_univ _) hmem
    · refine Finset.sum_eq_zero fun j _ ↦ ?_
      have hne : (⟨j.1, by omega⟩ : Fin N) ≠ k := ne_of_apply_ne Fin.val (by dsimp; omega)
      rw [Pi.single_eq_of_ne hne, zero_mul]

/-- Evaluating `chainForm N` on two standard basis vectors. -/
theorem chainForm_single_single (N : ℕ) (i j : Fin N) :
    chainForm N (Pi.single i 1) (Pi.single j 1) =
      (if (i : ℕ) + 1 = j then (1 : ZMod 3) else 0) -
        (if (j : ℕ) + 1 = i then (1 : ZMod 3) else 0) := by
  rw [chainForm_single_right]
  congr 1
  · split_ifs with h1 h2 h2
    · have heq : (⟨j.1 - 1, by omega⟩ : Fin N) = i := Fin.ext (by dsimp; omega)
      rw [heq, Pi.single_eq_same]
    · have hne : (⟨j.1 - 1, by omega⟩ : Fin N) ≠ i := fun h ↦
        h2 (by have := congrArg Fin.val h; dsimp at *; omega)
      exact Pi.single_eq_of_ne hne 1
    · omega
    · rfl
  · split_ifs with h1 h2 h2
    · have heq : (⟨j.1 + 1, h1⟩ : Fin N) = i := Fin.ext (by dsimp; omega)
      rw [heq, Pi.single_eq_same]
    · have hne : (⟨j.1 + 1, h1⟩ : Fin N) ≠ i := fun h ↦
        h2 (by have := congrArg Fin.val h; dsimp at *; omega)
      exact Pi.single_eq_of_ne hne 1
    · omega
    · rfl

/-- The normalized factor set `α(a, b) = ω ^ (2 * B(a, b))` of the cubic quantum torus on
`Multiplicative (Fin N → ZMod 3)`. -/
noncomputable def cubicFactor (N : ℕ) (a b : Multiplicative (Fin N → ZMod 3)) : ℂˣ :=
  cubeRootPow (2 * chainForm N a.toAdd b.toAdd)

/-- Evaluation formula for `cubicFactor`. -/
theorem cubicFactor_apply (N : ℕ) (a b : Multiplicative (Fin N → ZMod 3)) :
    cubicFactor N a b = cubeRootPow (2 * chainForm N a.toAdd b.toAdd) :=
  (rfl)

/-- `cubicFactor N` is a normalized factor set. -/
instance cubicFactor_isFactorSet (N : ℕ) : IsFactorSet (cubicFactor N) where
  cocycle g h j := by
    simp only [cubicFactor, toAdd_mul, ← cubeRootPow_add]
    congr 1
    simp only [map_add, LinearMap.add_apply]
    ring
  one_left g := by
    simp [cubicFactor]

/-- Simultaneous inversion preserves `cubicFactor N`. -/
theorem cubicFactor_inv_inv (N : ℕ) (a b : Multiplicative (Fin N → ZMod 3)) :
    cubicFactor N a⁻¹ b⁻¹ = cubicFactor N a b := by
  simp [cubicFactor]

/-- Swapping arguments inverts `cubicFactor N`. -/
theorem cubicFactor_swap (N : ℕ) (a b : Multiplicative (Fin N → ZMod 3)) :
    cubicFactor N b a = (cubicFactor N a b)⁻¹ := by
  rw [cubicFactor, cubicFactor, chainForm_swap, mul_neg, cubeRootPow_neg]

/-- `cubicFactor N` evaluates to `1` on inverse pairs `(a⁻¹, a)`. -/
@[simp]
theorem cubicFactor_inv_self (N : ℕ) (a : Multiplicative (Fin N → ZMod 3)) :
    cubicFactor N a⁻¹ a = 1 := by
  simp [cubicFactor]

/-- `cubicFactor N` evaluates to `1` on inverse pairs `(a, a⁻¹)`. -/
@[simp]
theorem cubicFactor_self_inv (N : ℕ) (a : Multiplicative (Fin N → ZMod 3)) :
    cubicFactor N a a⁻¹ = 1 := by
  simp [cubicFactor]

/-- Complex conjugation of `cubicFactor N a b` equals `cubicFactor N b⁻¹ a⁻¹`. -/
theorem star_coe_cubicFactor (N : ℕ) (a b : Multiplicative (Fin N → ZMod 3)) :
    star (cubicFactor N a b : ℂ) = (cubicFactor N b⁻¹ a⁻¹ : ℂ) := by
  rw [cubicFactor, star_coe_cubeRootPow, cubicFactor, toAdd_inv, toAdd_inv, chainForm_neg_neg,
    chainForm_swap, mul_neg, neg_neg]

/-- **The cubic quantum torus** `G_N`: the twisted group algebra of `(ZMod 3)^N` over `ℂ` for the
alternating chain factor set `cubicFactor N`. -/
noncomputable abbrev CubicTorus (N : ℕ) :=
  twistedMonoidAlgebra ℂ (Multiplicative (Fin N → ZMod 3)) (cubicFactor N)

/-- `CubicTorus N` has complex dimension `3 ^ N`. -/
@[simp]
theorem finrank_cubicTorus (N : ℕ) :
    Module.finrank ℂ (CubicTorus N) = 3 ^ N := by
  rw [TwistedMonoidAlgebra.finrank_eq_natCard, Nat.card_eq_fintype_card]
  simp [Fintype.card_pi]

/-- On `CubicTorus N`, `TwistedMonoidAlgebra.adjoint` reverses multiplication. -/
@[simp]
theorem adjoint_mul_cubicTorus {N : ℕ} (x y : CubicTorus N) :
    TwistedMonoidAlgebra.adjoint (x * y) =
      TwistedMonoidAlgebra.adjoint y * TwistedMonoidAlgebra.adjoint x :=
  TwistedMonoidAlgebra.adjoint_mul (star_coe_cubicFactor N) x y

/-- Positivity of `TwistedMonoidAlgebra.scalarTrace` on `CubicTorus N`. -/
theorem scalarTrace_adjoint_mul_self_cubicTorus_nonneg {N : ℕ} (x : CubicTorus N) :
    0 ≤ TwistedMonoidAlgebra.scalarTrace (TwistedMonoidAlgebra.adjoint x * x) :=
  TwistedMonoidAlgebra.scalarTrace_adjoint_mul_self_nonneg (cubicFactor_inv_self N) x

/-- Faithfulness of `TwistedMonoidAlgebra.scalarTrace` on `CubicTorus N`. -/
@[simp]
theorem scalarTrace_adjoint_mul_self_cubicTorus_eq_zero_iff {N : ℕ} {x : CubicTorus N} :
    TwistedMonoidAlgebra.scalarTrace (TwistedMonoidAlgebra.adjoint x * x) = 0 ↔ x = 0 :=
  TwistedMonoidAlgebra.scalarTrace_adjoint_mul_self_eq_zero_iff (cubicFactor_inv_self N)

/-! ### The inversion involution and its fixed subalgebra `cubicFixed N` -/

/-- The **inversion automorphism** `θ_N : of a ↦ of a⁻¹` of `CubicTorus N`, induced by group
inversion on `(ZMod 3)^N`. -/
noncomputable def cubicInversion (N : ℕ) : CubicTorus N →ₐ[ℂ] CubicTorus N :=
  TwistedMonoidAlgebra.map invMonoidHom fun a b ↦ by
    rw [invMonoidHom_apply, invMonoidHom_apply, cubicFactor_inv_inv]

/-- `cubicInversion N` sends `of a` to `of a⁻¹`. -/
@[simp]
theorem cubicInversion_of (N : ℕ) (a : Multiplicative (Fin N → ZMod 3)) :
    cubicInversion N (TwistedMonoidAlgebra.of a) = TwistedMonoidAlgebra.of a⁻¹ :=
  TwistedMonoidAlgebra.map_of ..

/-- `cubicInversion N` is an involution. -/
@[simp]
theorem cubicInversion_cubicInversion (N : ℕ) (x : CubicTorus N) :
    cubicInversion N (cubicInversion N x) = x := by
  have hcomp : (cubicInversion N).comp (cubicInversion N) = AlgHom.id ℂ (CubicTorus N) := by
    ext a
    simp
  exact AlgHom.congr_fun hcomp x

/-- `cubicInversion N` commutes with `TwistedMonoidAlgebra.adjoint`. -/
@[simp]
theorem cubicInversion_adjoint (N : ℕ) (x : CubicTorus N) :
    cubicInversion N (TwistedMonoidAlgebra.adjoint x) =
      TwistedMonoidAlgebra.adjoint (cubicInversion N x) := by
  rw [cubicInversion]
  exact (TwistedMonoidAlgebra.adjoint_map (α := cubicFactor N) (β := cubicFactor N)
    invMonoidHom _ x).symm

/-- `cubicInversion N` preserves `TwistedMonoidAlgebra.scalarTrace`. -/
@[simp]
theorem scalarTrace_cubicInversion (N : ℕ) (x : CubicTorus N) :
    TwistedMonoidAlgebra.scalarTrace (cubicInversion N x) =
      TwistedMonoidAlgebra.scalarTrace x := by
  rw [cubicInversion]
  exact TwistedMonoidAlgebra.scalarTrace_map invMonoidHom _ (fun _ hg ↦ inv_eq_one.mp hg) x

/-- **The inversion-fixed subalgebra** `C_N = {x ∈ G_N : θ_N x = x}` of `CubicTorus N`. -/
noncomputable def cubicFixed (N : ℕ) : Subalgebra ℂ (CubicTorus N) :=
  AlgHom.equalizer (cubicInversion N) (AlgHom.id ℂ (CubicTorus N))

/-- Membership in `cubicFixed N` is invariance under `cubicInversion N`. -/
theorem mem_cubicFixed_iff {N : ℕ} {x : CubicTorus N} :
    x ∈ cubicFixed N ↔ cubicInversion N x = x :=
  Iff.rfl

/-- `cubicFixed N` is closed under `TwistedMonoidAlgebra.adjoint`. -/
theorem adjoint_mem_cubicFixed {N : ℕ} {x : CubicTorus N} (hx : x ∈ cubicFixed N) :
    TwistedMonoidAlgebra.adjoint x ∈ cubicFixed N := by
  rw [mem_cubicFixed_iff] at hx ⊢
  rw [cubicInversion_adjoint, hx]

/-- `TwistedMonoidAlgebra.adjoint x` lies in `cubicFixed N` if and only if `x` does. -/
@[simp]
theorem adjoint_mem_cubicFixed_iff {N : ℕ} {x : CubicTorus N} :
    TwistedMonoidAlgebra.adjoint x ∈ cubicFixed N ↔ x ∈ cubicFixed N :=
  ⟨fun h ↦ TwistedMonoidAlgebra.adjoint_adjoint x ▸ adjoint_mem_cubicFixed h,
    adjoint_mem_cubicFixed⟩

/-- Restriction of `TwistedMonoidAlgebra.adjoint` to `cubicFixed N`. -/
noncomputable def cubicFixedAdjoint (N : ℕ) : cubicFixed N →ₗ⋆[ℂ] cubicFixed N where
  toFun x := ⟨TwistedMonoidAlgebra.adjoint x, adjoint_mem_cubicFixed x.2⟩
  map_add' x y := Subtype.ext (by simp)
  map_smul' z x := Subtype.ext (by simp)

/-- Coercing `cubicFixedAdjoint` to the ambient cubic torus gives
`TwistedMonoidAlgebra.adjoint`. -/
@[simp]
theorem coe_cubicFixedAdjoint (N : ℕ) (x : cubicFixed N) :
    (cubicFixedAdjoint N x : CubicTorus N) = TwistedMonoidAlgebra.adjoint x :=
  (rfl)

/-- `cubicFixedAdjoint N` fixes `1`. -/
@[simp]
theorem cubicFixedAdjoint_one (N : ℕ) : cubicFixedAdjoint N 1 = 1 :=
  Subtype.ext TwistedMonoidAlgebra.adjoint_one

/-- `cubicFixedAdjoint N` conjugates scalar multiples of `1`. -/
@[simp]
theorem cubicFixedAdjoint_algebraMap (N : ℕ) (z : ℂ) :
    cubicFixedAdjoint N (algebraMap ℂ (cubicFixed N) z) =
      algebraMap ℂ (cubicFixed N) (conj z) :=
  Subtype.ext (TwistedMonoidAlgebra.adjoint_algebraMap z)

/-- `cubicFixedAdjoint N` reverses multiplication. -/
@[simp]
theorem cubicFixedAdjoint_mul (N : ℕ) (x y : cubicFixed N) :
    cubicFixedAdjoint N (x * y) = cubicFixedAdjoint N y * cubicFixedAdjoint N x :=
  Subtype.ext (adjoint_mul_cubicTorus (x : CubicTorus N) (y : CubicTorus N))

/-- `cubicFixedAdjoint N` is an involution. -/
@[simp]
theorem cubicFixedAdjoint_cubicFixedAdjoint (N : ℕ) (x : cubicFixed N) :
    cubicFixedAdjoint N (cubicFixedAdjoint N x) = x :=
  Subtype.ext (TwistedMonoidAlgebra.adjoint_adjoint (x : CubicTorus N))

/-- The only fixed point of negation in `(ZMod 3)^N` is `0`, so the trace of `cubicInversion N`
equals `1`. -/
private theorem trace_cubicInversion (N : ℕ) :
    LinearMap.trace ℂ (CubicTorus N) (cubicInversion N).toLinearMap = 1 := by
  rw [cubicInversion, TwistedMonoidAlgebra.trace_map]
  have hcard : Nat.card {g : Multiplicative (Fin N → ZMod 3) // invMonoidHom g = g} = 1 := by
    let : Unique {g : Multiplicative (Fin N → ZMod 3) // invMonoidHom g = g} :=
      { default := ⟨1, inv_one⟩
        uniq := fun ⟨g, hg⟩ ↦ Subtype.ext <| by
          apply Multiplicative.toAdd.injective
          ext j
          have hgj : -(g.toAdd j) = g.toAdd j := congrFun (congrArg Multiplicative.toAdd hg) j
          exact ((ZMod.neg_eq_self_iff (g.toAdd j)).mp hgj).resolve_right (by omega) }
    exact Nat.card_unique
  rw [hcard, Nat.cast_one]

/-- **The complex dimension of `cubicFixed N` is `(3 ^ N + 1) / 2`.** -/
@[simp]
theorem finrank_cubicFixed (N : ℕ) :
    Module.finrank ℂ (cubicFixed N) = (3 ^ N + 1) / 2 := by
  let σ : Module.End ℂ (CubicTorus N) := -(cubicInversion N).toLinearMap
  have hσ : σ ^ 2 = 1 := by
    ext x
    simp [σ, sq, mul_apply_eq_comp]
  have hker : LinearMap.ker (1 + σ) = (cubicFixed N).toSubmodule := by
    ext x
    simp only [LinearMap.mem_ker, LinearMap.add_apply, one_apply_eq_self, LinearMap.neg_apply,
      AlgHom.toLinearMap_apply, Subalgebra.mem_toSubmodule, mem_cubicFixed_iff, σ, add_neg_eq_zero]
    exact eq_comm
  have hdim := TauCeti.LinearMap.two_mul_finrank_ker_one_add_of_sq_eq_one hσ
  rw [hker, finrank_cubicTorus, map_neg, trace_cubicInversion, sub_neg_eq_add] at hdim
  have hnat : 2 * Module.finrank ℂ (cubicFixed N) = 3 ^ N + 1 := by
    exact_mod_cast hdim
  omega

/-! ### Site unitaries and the universal property of `CubicTorus N` -/

/-- The `j`-th **site unitary** `U_j = of (ofAdd (Pi.single j 1))` of `CubicTorus N`. -/
noncomputable def cubicSite (N : ℕ) (j : Fin N) : CubicTorus N :=
  TwistedMonoidAlgebra.of (Multiplicative.ofAdd (Pi.single j 1))

/-- Unfolding `cubicSite` as a Weyl basis element. -/
theorem cubicSite_def (N : ℕ) (j : Fin N) :
    cubicSite N j = TwistedMonoidAlgebra.of (Multiplicative.ofAdd (Pi.single j 1)) :=
  (rfl)

/-- Each site unitary has order dividing `3`: `U_j ^ 3 = 1`. -/
@[simp]
theorem cubicSite_pow_three (N : ℕ) (j : Fin N) : cubicSite N j ^ 3 = 1 := by
  have h1 : (2 : ZMod 3) + 1 = 0 := by decide
  have hsq : cubicSite N j * cubicSite N j =
      TwistedMonoidAlgebra.of (Multiplicative.ofAdd (Pi.single j (2 : ZMod 3))) := by
    rw [cubicSite, TwistedMonoidAlgebra.of_mul_of]
    have hfac : cubicFactor N (Multiplicative.ofAdd (Pi.single j 1))
        (Multiplicative.ofAdd (Pi.single j 1)) = 1 := by
      simp [cubicFactor]
    rw [hfac, Units.val_one, one_smul, ← ofAdd_add, ← Pi.single_add]
    rfl
  have hcub : cubicSite N j ^ 3 = cubicSite N j * cubicSite N j * cubicSite N j := by
    rw [pow_succ, sq]
  rw [hcub, hsq, cubicSite, TwistedMonoidAlgebra.of_mul_of]
  have hfac2 : cubicFactor N (Multiplicative.ofAdd (Pi.single j (2 : ZMod 3)))
      (Multiplicative.ofAdd (Pi.single j 1)) = 1 := by
    have h2 : (Pi.single j (2 : ZMod 3) : Fin N → ZMod 3) = (2 : ZMod 3) • Pi.single j 1 := by
      ext k; simp [Pi.single_apply]
    simp [cubicFactor, h2]
  rw [hfac2, Units.val_one, one_smul, ← ofAdd_add, ← Pi.single_add, h1, Pi.single_zero,
    ofAdd_zero, TwistedMonoidAlgebra.of_one]

/-- `U_j ^ 2 = of (ofAdd (-Pi.single j 1))`. -/
theorem cubicSite_sq_eq_of_neg (N : ℕ) (j : Fin N) :
    cubicSite N j ^ 2 = TwistedMonoidAlgebra.of (Multiplicative.ofAdd (-Pi.single j 1)) := by
  have hneg : -(Pi.single j (1 : ZMod 3) : Fin N → ZMod 3) = Pi.single j 1 + Pi.single j 1 := by
    ext k
    simp only [Pi.neg_apply, Pi.add_apply, Pi.single_apply]
    split_ifs <;> decide
  rw [sq, cubicSite, TwistedMonoidAlgebra.of_mul_of]
  have hfac : cubicFactor N (Multiplicative.ofAdd (Pi.single j 1))
      (Multiplicative.ofAdd (Pi.single j 1)) = 1 := by
    simp [cubicFactor]
  rw [hfac, Units.val_one, one_smul, ← ofAdd_add, ← hneg]

/-- `cubicInversion N` squares each site unitary. -/
@[simp]
theorem cubicInversion_cubicSite (N : ℕ) (j : Fin N) :
    cubicInversion N (cubicSite N j) = cubicSite N j ^ 2 := by
  rw [cubicSite_sq_eq_of_neg, cubicSite, cubicInversion_of, ofAdd_neg]

/-- `TwistedMonoidAlgebra.adjoint` squares each site unitary. -/
@[simp]
theorem adjoint_cubicSite (N : ℕ) (j : Fin N) :
    TwistedMonoidAlgebra.adjoint (cubicSite N j) = cubicSite N j ^ 2 := by
  rw [cubicSite_sq_eq_of_neg, cubicSite, TwistedMonoidAlgebra.adjoint_of, ofAdd_neg]

/-- Adjacent site unitaries obey `U_j * U_{j + 1} = ω • (U_{j + 1} * U_j)`. -/
theorem cubicSite_mul_succ {N : ℕ} (j : Fin (N - 1)) :
    cubicSite N ⟨j.1, by omega⟩ * cubicSite N ⟨j.1 + 1, by omega⟩ =
      (cubeRootOfUnity : ℂ) •
        (cubicSite N ⟨j.1 + 1, by omega⟩ * cubicSite N ⟨j.1, by omega⟩) := by
  let a : Multiplicative (Fin N → ZMod 3) := Multiplicative.ofAdd (Pi.single ⟨j.1, by omega⟩ 1)
  let b : Multiplicative (Fin N → ZMod 3) := Multiplicative.ofAdd (Pi.single ⟨j.1 + 1, by omega⟩ 1)
  have hB : chainForm N a.toAdd b.toAdd = 1 := by
    have h1 : (⟨j.1, by omega⟩ : Fin N).1 + 1 = (⟨j.1 + 1, by omega⟩ : Fin N).1 := rfl
    have h2 : ¬ ((⟨j.1 + 1, by omega⟩ : Fin N).1 + 1 = (⟨j.1, by omega⟩ : Fin N).1) := by
      dsimp; omega
    dsimp only [a, b]
    rw [toAdd_ofAdd, toAdd_ofAdd, chainForm_single_single,
      ite_eq_left_iff.mpr (fun h ↦ absurd h1 h), ite_eq_right_iff.mpr (fun h ↦ absurd h h2),
      sub_zero]
  have hratio : cubicFactor N a b = cubeRootOfUnity * cubicFactor N b a := by
    rw [cubicFactor, cubicFactor, chainForm_swap N a.toAdd b.toAdd, hB]
    have hcalc : (2 : ZMod 3) * 1 = 1 + 2 * (-1) := by decide
    rw [hcalc, cubeRootPow_add, cubeRootPow_one]
  rw [cubicSite, cubicSite, TwistedMonoidAlgebra.of_mul_of, TwistedMonoidAlgebra.of_mul_of,
    mul_comm b a, smul_smul, ← Units.val_mul, ← hratio]

/-- Site unitaries at distance at least `2` commute. -/
theorem commute_cubicSite {N : ℕ} {i j : Fin N}
    (h : (i : ℕ) + 2 ≤ j ∨ (j : ℕ) + 2 ≤ i) :
    Commute (cubicSite N i) (cubicSite N j) := by
  have hB : chainForm N (Pi.single i 1) (Pi.single j 1) = 0 := by
    rw [chainForm_single_single]
    have h1 : ¬ ((i : ℕ) + 1 = j) := by omega
    have h2 : ¬ ((j : ℕ) + 1 = i) := by omega
    simp [h1, h2]
  have hfac1 : cubicFactor N (Multiplicative.ofAdd (Pi.single i 1))
      (Multiplicative.ofAdd (Pi.single j 1)) = 1 := by
    simp [cubicFactor, hB]
  have hfac2 : cubicFactor N (Multiplicative.ofAdd (Pi.single j 1))
      (Multiplicative.ofAdd (Pi.single i 1)) = 1 := by
    simp [cubicFactor, chainForm_swap, hB]
  rw [Commute, SemiconjBy, cubicSite, cubicSite, TwistedMonoidAlgebra.of_mul_of,
    TwistedMonoidAlgebra.of_mul_of, hfac1, hfac2, mul_comm]

/-- Each site unitary has scalar trace `0`. -/
@[simp]
theorem scalarTrace_cubicSite (N : ℕ) (j : Fin N) :
    TwistedMonoidAlgebra.scalarTrace (cubicSite N j) = 0 := by
  refine TwistedMonoidAlgebra.scalarTrace_of_ne_one fun h ↦ ?_
  have h0 : (Pi.single j (1 : ZMod 3) : Fin N → ZMod 3) j = 0 :=
    congrFun (congrArg Multiplicative.toAdd h) j
  simp at h0

/-- The square of each site unitary has scalar trace `0`. -/
@[simp]
theorem scalarTrace_cubicSite_sq (N : ℕ) (j : Fin N) :
    TwistedMonoidAlgebra.scalarTrace (cubicSite N j ^ 2) = 0 := by
  rw [cubicSite_sq_eq_of_neg]
  refine TwistedMonoidAlgebra.scalarTrace_of_ne_one fun h ↦ ?_
  have h0 : (-(Pi.single j (1 : ZMod 3)) : Fin N → ZMod 3) j = 0 :=
    congrFun (congrArg Multiplicative.toAdd h) j
  simp at h0

/-- The quadratic phase `∑_{j < N - 1} a_j a_{j + 1}` translating ordered site products into the
symmetric Weyl basis `TwistedMonoidAlgebra.of`. -/
private def cubicQuadPhase (N : ℕ) (a : Fin N → ZMod 3) : ZMod 3 :=
  ∑ j : Fin (N - 1), a ⟨j.1, by omega⟩ * a ⟨j.1 + 1, by omega⟩

/-- The ordered product `∏_{j = 0}^{N - 1} u_j ^ (a j).val` in a `ℂ`-algebra `A`. -/
private def orderedSiteProd {A : Type*} [Semiring A] (N : ℕ) (u : Fin N → A)
    (a : Fin N → ZMod 3) : A :=
  ((List.finRange N).map fun j ↦ u j ^ (a j).val).prod

private theorem pow_comm_of_mul_eq_smul {A : Type*} [Semiring A] [Algebra ℂ A]
    {x y : A} (hxy : x * y = (cubeRootOfUnity : ℂ) • (y * x)) (r s : ℕ) :
    y ^ r * x ^ s = (cubeRootPow (-((r : ZMod 3) * (s : ZMod 3))) : ℂ) • (x ^ s * y ^ r) := by
  have hyx : y * x = (cubeRootPow (-1) : ℂ) • (x * y) := by
    rw [hxy, smul_smul, ← Units.val_mul, cubeRootPow_neg, cubeRootPow_one, inv_mul_cancel,
      Units.val_one, one_smul]
  have h1 : ∀ t : ℕ, y * x ^ t = (cubeRootPow (-(t : ZMod 3)) : ℂ) • (x ^ t * y) := by
    intro t
    induction t with
    | zero => simp
    | succ t ih =>
      rw [pow_succ', ← mul_assoc, hyx, smul_mul_assoc, mul_assoc, ih, mul_smul_comm, smul_smul,
        ← Units.val_mul, ← cubeRootPow_add, ← mul_assoc, Nat.cast_succ]
      congr 2
      exact congrArg cubeRootPow (by ring)
  induction r with
  | zero => simp
  | succ r ih =>
    rw [pow_succ, mul_assoc, h1 s, mul_smul_comm, ← mul_assoc, ih, smul_mul_assoc, smul_smul,
      ← Units.val_mul, ← cubeRootPow_add, mul_assoc, Nat.cast_succ]
    congr 2
    exact congrArg cubeRootPow (by ring)

private theorem orderedSiteProd_succ_mul_zero {A : Type*} [Semiring A] [Algebra ℂ A] {M : ℕ}
    (u : Fin (M + 2) → A)
    (hadj : u 0 * u 1 = (cubeRootOfUnity : ℂ) • (u 1 * u 0))
    (hcomm : ∀ {i j : Fin (M + 2)}, (i : ℕ) + 2 ≤ j → Commute (u i) (u j))
    (a b : Fin (M + 2) → ZMod 3) :
    orderedSiteProd (M + 1) (u ∘ Fin.succ) (a ∘ Fin.succ) * u 0 ^ (b 0).val =
      (cubeRootPow (-(a 1 * b 0)) : ℂ) •
        (u 0 ^ (b 0).val * orderedSiteProd (M + 1) (u ∘ Fin.succ) (a ∘ Fin.succ)) := by
  have htail :
      Commute (orderedSiteProd M (u ∘ Fin.succ ∘ Fin.succ) (a ∘ Fin.succ ∘ Fin.succ))
        (u 0 ^ (b 0).val) := by
    unfold orderedSiteProd
    refine Commute.list_prod_left _ _ fun x hx ↦ ?_
    rw [List.mem_map] at hx
    obtain ⟨j, _, rfl⟩ := hx
    exact ((hcomm (i := 0) (j := j.succ.succ) (by simp)).symm.pow_left _).pow_right _
  have hhead : u 1 ^ (a 1).val * u 0 ^ (b 0).val =
      (cubeRootPow (-(a 1 * b 0)) : ℂ) • (u 0 ^ (b 0).val * u 1 ^ (a 1).val) := by
    simpa [ZMod.natCast_zmod_val] using pow_comm_of_mul_eq_smul hadj (a 1).val (b 0).val
  have hsp : orderedSiteProd (M + 1) (u ∘ Fin.succ) (a ∘ Fin.succ) =
      u 1 ^ (a 1).val *
        orderedSiteProd M (u ∘ Fin.succ ∘ Fin.succ) (a ∘ Fin.succ ∘ Fin.succ) := by
    simp [orderedSiteProd, List.finRange_succ, List.map_map, Function.comp_def]
  rw [hsp, mul_assoc, htail.eq, ← mul_assoc, hhead, smul_mul_assoc, mul_assoc]

private theorem orderedSiteProd_mul {A : Type*} [Semiring A] [Algebra ℂ A] :
    ∀ (N : ℕ) (u : Fin N → A)
      (_hpow : ∀ j, u j ^ 3 = 1)
      (_hadj : ∀ j : Fin (N - 1),
        u ⟨j.1, by omega⟩ * u ⟨j.1 + 1, by omega⟩ =
          (cubeRootOfUnity : ℂ) • (u ⟨j.1 + 1, by omega⟩ * u ⟨j.1, by omega⟩))
      (_hcomm : ∀ {i j : Fin N}, (i : ℕ) + 2 ≤ j → Commute (u i) (u j))
      (a b : Fin N → ZMod 3),
      orderedSiteProd N u a * orderedSiteProd N u b =
        (cubeRootPow (-(∑ j : Fin (N - 1), a ⟨j.1 + 1, by omega⟩ * b ⟨j.1, by omega⟩)) : ℂ) •
          orderedSiteProd N u (a + b)
  | 0, _, _, _, _, _, _ => by simp [orderedSiteProd]
  | 1, u, hpow, _, _, a, b => by
    have hempty : ∑ j : Fin (1 - 1), a ⟨j.1 + 1, by omega⟩ * b ⟨j.1, by omega⟩ = 0 :=
      Finset.sum_eq_zero fun j _ ↦ Fin.elim0 j
    rw [hempty, neg_zero, cubeRootPow_zero, Units.val_one, one_smul]
    simp only [orderedSiteProd, List.finRange_succ, List.finRange_zero, List.map_nil, List.map_cons,
      List.prod_cons, List.prod_nil, mul_one]
    rw [← pow_add, Pi.add_apply, ZMod.val_add, ← pow_eq_pow_mod _ (hpow 0)]
  | M + 2, u, hpow, hadj, hcomm, a, b => by
    have hsplit (v : Fin (M + 2) → ZMod 3) :
        orderedSiteProd (M + 2) u v =
          u 0 ^ (v 0).val * orderedSiteProd (M + 1) (u ∘ Fin.succ) (v ∘ Fin.succ) := by
      simp [orderedSiteProd, List.finRange_succ, List.map_map, Function.comp_def]
    have hih := orderedSiteProd_mul (M + 1) (u ∘ Fin.succ) (fun j ↦ hpow j.succ)
      (fun j ↦ hadj ⟨j.1 + 1, by omega⟩)
      (fun {i j} hij ↦ hcomm (by simp only [Fin.val_succ]; omega)) (a ∘ Fin.succ) (b ∘ Fin.succ)
    have hpow0 : u 0 ^ (a 0).val * u 0 ^ (b 0).val = u 0 ^ ((a + b) 0).val := by
      rw [← pow_add, Pi.add_apply, ZMod.val_add, ← pow_eq_pow_mod _ (hpow 0)]
    have hswap := orderedSiteProd_succ_mul_zero u (hadj ⟨0, by omega⟩) hcomm a b
    have hsum : a 1 * b 0 +
        (∑ j : Fin (M + 1 - 1),
          (a ∘ Fin.succ) ⟨j.1 + 1, by omega⟩ * (b ∘ Fin.succ) ⟨j.1, by omega⟩) =
        ∑ j : Fin (M + 2 - 1), a ⟨j.1 + 1, by omega⟩ * b ⟨j.1, by omega⟩ :=
      (Fin.sum_univ_succ (n := M) fun j : Fin (M + 1) ↦
        a ⟨j.1 + 1, by omega⟩ * b ⟨j.1, by omega⟩).symm
    rw [hsplit a, hsplit b, hsplit (a + b), mul_assoc,
      ← mul_assoc (orderedSiteProd (M + 1) (u ∘ Fin.succ) (a ∘ Fin.succ)),
      hswap, smul_mul_assoc, mul_smul_comm, mul_assoc, hih, mul_smul_comm, mul_smul_comm,
      ← mul_assoc (u 0 ^ (a 0).val), hpow0, smul_smul, ← Units.val_mul, ← cubeRootPow_add,
      ← neg_add, hsum]
    rfl

private theorem orderedSiteProd_single {A : Type*} [Semiring A] (N : ℕ) (u : Fin N → A)
    (k : Fin N) : orderedSiteProd N u (Pi.single k 1) = u k := by
  have h1 : (1 : ZMod 3).val = 1 := by decide
  have hval (j : Fin N) : u j ^ ((Pi.single k (1 : ZMod 3) : Fin N → ZMod 3) j).val =
      if j = k then u k else 1 := by
    by_cases hjk : j = k
    · subst hjk; simp [h1]
    · simp [hjk]
  have haux : ∀ (l : List (Fin N)), l.Nodup →
      (l.map fun j ↦ if j = k then u k else 1).prod = if k ∈ l then u k else 1 := by
    intro l hl
    induction l with
    | nil => simp
    | cons x xs ih =>
      rw [List.nodup_cons] at hl
      rw [List.map_cons, List.prod_cons, ih hl.2]
      by_cases hxk : x = k
      · subst hxk; simp [hl.1]
      · simp [hxk, Ne.symm hxk]
  simp only [orderedSiteProd, hval]
  rw [haux _ (List.nodup_finRange N)]
  simp

private theorem cubicQuadPhase_add_chainForm (N : ℕ) (a b : Fin N → ZMod 3) :
    cubicQuadPhase N a + cubicQuadPhase N b +
        -(∑ j : Fin (N - 1), a ⟨j.1 + 1, by omega⟩ * b ⟨j.1, by omega⟩) =
      2 * chainForm N a b + cubicQuadPhase N (a + b) := by
  have hquad : cubicQuadPhase N (a + b) - cubicQuadPhase N a - cubicQuadPhase N b =
      ∑ j : Fin (N - 1),
        (a ⟨j.1, by omega⟩ * b ⟨j.1 + 1, by omega⟩ +
          b ⟨j.1, by omega⟩ * a ⟨j.1 + 1, by omega⟩) := by
    simp only [cubicQuadPhase, ← Finset.sum_sub_distrib, Pi.add_apply]
    refine Finset.sum_congr rfl fun j _ ↦ by ring
  have h3 : (3 : ZMod 3) = 0 := by decide
  have hstep :
      2 * chainForm N a b +
          (cubicQuadPhase N (a + b) - cubicQuadPhase N a - cubicQuadPhase N b) +
          (∑ j : Fin (N - 1), a ⟨j.1 + 1, by omega⟩ * b ⟨j.1, by omega⟩) =
        3 * ∑ j : Fin (N - 1), a ⟨j.1, by omega⟩ * b ⟨j.1 + 1, by omega⟩ := by
    rw [chainForm_apply, hquad, Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib,
      ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun j _ ↦ by ring
  have hzero :
      2 * chainForm N a b + cubicQuadPhase N (a + b) -
        (cubicQuadPhase N a + cubicQuadPhase N b +
          -(∑ j : Fin (N - 1), a ⟨j.1 + 1, by omega⟩ * b ⟨j.1, by omega⟩)) = 0 := by
    calc
      2 * chainForm N a b + cubicQuadPhase N (a + b) -
          (cubicQuadPhase N a + cubicQuadPhase N b +
            -(∑ j : Fin (N - 1), a ⟨j.1 + 1, by omega⟩ * b ⟨j.1, by omega⟩))
          = 2 * chainForm N a b +
              (cubicQuadPhase N (a + b) - cubicQuadPhase N a - cubicQuadPhase N b) +
              (∑ j : Fin (N - 1), a ⟨j.1 + 1, by omega⟩ * b ⟨j.1, by omega⟩) := by ring
      _ = 3 * ∑ j : Fin (N - 1), a ⟨j.1, by omega⟩ * b ⟨j.1 + 1, by omega⟩ := hstep
      _ = 0 := by rw [h3, zero_mul]
  exact (sub_eq_zero.mp hzero).symm

/-- **Universal property of `CubicTorus N`**: any family `u : Fin N → A` of order-`3` elements in a
`ℂ`-algebra `A` with `u_j u_{j + 1} = ω u_{j + 1} u_j` and commuting at distance `≥ 2` extends
uniquely to an algebra homomorphism `CubicTorus N →ₐ[ℂ] A` sending `cubicSite N j` to `u j`. -/
noncomputable def cubicTorusLift {N : ℕ} {A : Type*} [Semiring A] [Algebra ℂ A]
    (u : Fin N → A) (hpow : ∀ j, u j ^ 3 = 1)
    (hadj : ∀ j : Fin (N - 1),
      u ⟨j.1, by omega⟩ * u ⟨j.1 + 1, by omega⟩ =
        (cubeRootOfUnity : ℂ) • (u ⟨j.1 + 1, by omega⟩ * u ⟨j.1, by omega⟩))
    (hcomm : ∀ {i j : Fin N}, (i : ℕ) + 2 ≤ j → Commute (u i) (u j)) :
    CubicTorus N →ₐ[ℂ] A :=
  TwistedMonoidAlgebra.lift
    (fun a ↦ (cubeRootPow (cubicQuadPhase N a.toAdd) : ℂ) • orderedSiteProd N u a.toAdd)
    (by
      have h1 : orderedSiteProd N u 0 = 1 := by simp [orderedSiteProd]
      simp [cubicQuadPhase, h1])
    (fun g h ↦ by
      rw [smul_mul_smul_comm, orderedSiteProd_mul N u hpow hadj hcomm g.toAdd h.toAdd, smul_smul,
        ← Units.val_mul, ← Units.val_mul, ← cubeRootPow_add, ← cubeRootPow_add, toAdd_mul,
        smul_smul, cubicFactor, ← Units.val_mul, ← cubeRootPow_add]
      congr 2
      exact congrArg cubeRootPow (cubicQuadPhase_add_chainForm N g.toAdd h.toAdd))

/-- `cubicTorusLift` sends the `j`-th site unitary to `u j`. -/
@[simp]
theorem cubicTorusLift_cubicSite {N : ℕ} {A : Type*} [Semiring A] [Algebra ℂ A]
    (u : Fin N → A) (hpow : ∀ j, u j ^ 3 = 1)
    (hadj : ∀ j : Fin (N - 1),
      u ⟨j.1, by omega⟩ * u ⟨j.1 + 1, by omega⟩ =
        (cubeRootOfUnity : ℂ) • (u ⟨j.1 + 1, by omega⟩ * u ⟨j.1, by omega⟩))
    (hcomm : ∀ {i j : Fin N}, (i : ℕ) + 2 ≤ j → Commute (u i) (u j)) (j : Fin N) :
    cubicTorusLift u hpow hadj hcomm (cubicSite N j) = u j := by
  rw [cubicSite, cubicTorusLift, TwistedMonoidAlgebra.lift_of, toAdd_ofAdd,
    orderedSiteProd_single]
  have hq : cubicQuadPhase N (Pi.single j 1) = 0 := by
    refine Finset.sum_eq_zero fun k _ ↦ ?_
    by_cases hkj : (⟨k.1, by omega⟩ : Fin N) = j
    · have hne : (⟨k.1 + 1, by omega⟩ : Fin N) ≠ j := by
        intro h; have := congrArg Fin.val h; have := congrArg Fin.val hkj; dsimp at *; omega
      simp [Pi.single_eq_of_ne hne]
    · simp [Pi.single_eq_of_ne hkj]
  rw [hq, cubeRootPow_zero, Units.val_one, one_smul]

private theorem of_single_mem_adjoin_range_cubicSite (N : ℕ) (j : Fin N) (r : ZMod 3) :
    (TwistedMonoidAlgebra.of (Multiplicative.ofAdd (Pi.single j r)) : CubicTorus N) ∈
      Algebra.adjoin ℂ (Set.range (cubicSite N)) := by
  rcases (by decide : ∀ r : ZMod 3, r = 0 ∨ r = 1 ∨ r = 2) r with rfl | rfl | rfl
  · rw [Pi.single_zero, ofAdd_zero, TwistedMonoidAlgebra.of_one]; exact one_mem _
  · exact Algebra.subset_adjoin (Set.mem_range_self j)
  · have h2 : (2 : ZMod 3) = -1 := by decide
    rw [h2, Pi.single_neg, ← cubicSite_sq_eq_of_neg]
    exact pow_mem (Algebra.subset_adjoin (Set.mem_range_self j)) 2

/-- Every Weyl basis element `TwistedMonoidAlgebra.of a` lies in the subalgebra generated by the
site unitaries `cubicSite N j`. -/
private theorem of_mem_adjoin_range_cubicSite (N : ℕ)
    (a : Multiplicative (Fin N → ZMod 3)) :
    (TwistedMonoidAlgebra.of a : CubicTorus N) ∈
      Algebra.adjoin ℂ (Set.range (cubicSite N)) := by
  have hsum : ∀ (s : Finset (Fin N)) (v : Fin N → ZMod 3),
      (∀ j, j ∉ s → v j = 0) →
      (TwistedMonoidAlgebra.of (Multiplicative.ofAdd v) : CubicTorus N) ∈
        Algebra.adjoin ℂ (Set.range (cubicSite N)) := by
    intro s
    induction s using Finset.cons_induction with
    | empty =>
      intro v hv
      have hv0 : v = 0 := funext fun j ↦ hv j (Finset.notMem_empty j)
      rw [hv0, ofAdd_zero, TwistedMonoidAlgebra.of_one]; exact one_mem _
    | cons j s hjs ih =>
      intro v hv
      let v' := Function.update v j 0
      have hv' : ∀ k, k ∉ s → v' k = 0 := by
        intro k hk
        by_cases hkj : k = j
        · simp [v', hkj]
        · simp [v', hkj, hv k (by simp [hk, hkj])]
      have hv_eq : v = v' + Pi.single j (v j) := by
        ext k
        by_cases hkj : k = j
        · subst hkj; simp [v']
        · simp [v', hkj]
      have hmul := TwistedMonoidAlgebra.of_mul_of (k := ℂ) (α := cubicFactor N)
        (Multiplicative.ofAdd v') (Multiplicative.ofAdd (Pi.single j (v j)))
      rw [← ofAdd_add, ← hv_eq] at hmul
      have hinv : (TwistedMonoidAlgebra.of (Multiplicative.ofAdd v) : CubicTorus N) =
          (((cubicFactor N (Multiplicative.ofAdd v')
            (Multiplicative.ofAdd (Pi.single j (v j))))⁻¹ : ℂˣ) : ℂ) •
            (TwistedMonoidAlgebra.of (Multiplicative.ofAdd v') *
              TwistedMonoidAlgebra.of (Multiplicative.ofAdd (Pi.single j (v j)))) := by
        rw [hmul, smul_smul, ← Units.val_mul, inv_mul_cancel, Units.val_one, one_smul]
      rw [hinv]
      exact Subalgebra.smul_mem _
        (mul_mem (ih v' hv') (of_single_mem_adjoin_range_cubicSite N j (v j))) _
  simpa using hsum Finset.univ a.toAdd fun j hj ↦ absurd (Finset.mem_univ j) hj

/-- Two `ℂ`-algebra homomorphisms out of `CubicTorus N` agreeing on all site unitaries
`cubicSite N j` are equal. -/
theorem cubicTorus_hom_ext {N : ℕ} {A : Type*} [Semiring A] [Algebra ℂ A]
    {f g : CubicTorus N →ₐ[ℂ] A} (h : ∀ j : Fin N, f (cubicSite N j) = g (cubicSite N j)) :
    f = g := by
  apply TwistedMonoidAlgebra.algHom_ext
  intro a
  have hle : Algebra.adjoin ℂ (Set.range (cubicSite N)) ≤ AlgHom.equalizer f g := by
    rw [Algebra.adjoin_le_iff]
    rintro _ ⟨j, rfl⟩
    exact h j
  exact hle (of_mem_adjoin_range_cubicSite N a)

/-! ### Cubic projections and the comparison homomorphism `cubicFixedHom` -/

/-- The `j`-th **cubic projection** `p_j = 3⁻¹ • (1 + U_j + U_j ^ 2)` in `CubicTorus N`. -/
noncomputable def cubicProjection (N : ℕ) (j : Fin N) : CubicTorus N :=
  (3 : ℂ)⁻¹ • (1 + cubicSite N j + cubicSite N j ^ 2)

/-- Explicit formula for `cubicProjection`. -/
theorem cubicProjection_def (N : ℕ) (j : Fin N) :
    cubicProjection N j = (3 : ℂ)⁻¹ • (1 + cubicSite N j + cubicSite N j ^ 2) :=
  (rfl)

/-- Each cubic projection lies in the inversion-fixed subalgebra `cubicFixed N`. -/
theorem cubicProjection_mem_cubicFixed (N : ℕ) (j : Fin N) :
    cubicProjection N j ∈ cubicFixed N := by
  rw [mem_cubicFixed_iff, cubicProjection_def, map_smul, map_add, map_add, map_one, map_pow,
    cubicInversion_cubicSite]
  have h4 : (cubicSite N j ^ 2) ^ 2 = cubicSite N j := by
    calc
      (cubicSite N j ^ 2) ^ 2 = cubicSite N j ^ 3 * cubicSite N j := by noncomm_ring
      _ = cubicSite N j := by rw [cubicSite_pow_three, one_mul]
  rw [h4]
  congr 1
  abel

/-- Every cubic projection is self-adjoint for `TwistedMonoidAlgebra.adjoint`. -/
@[simp]
theorem adjoint_cubicProjection (N : ℕ) (j : Fin N) :
    TwistedMonoidAlgebra.adjoint (cubicProjection N j) = cubicProjection N j := by
  have hsq : TwistedMonoidAlgebra.adjoint (cubicSite N j ^ 2) = cubicSite N j := by
    rw [← adjoint_cubicSite, TwistedMonoidAlgebra.adjoint_adjoint]
  rw [cubicProjection_def, map_smulₛₗ, starRingEnd_apply, map_add, map_add,
    TwistedMonoidAlgebra.adjoint_one, adjoint_cubicSite, hsq]
  have h3 : star ((3 : ℂ)⁻¹) = (3 : ℂ)⁻¹ := by simp
  rw [h3]
  congr 1
  abel

/-- Every cubic projection has scalar trace `3⁻¹`. -/
@[simp]
theorem scalarTrace_cubicProjection (N : ℕ) (j : Fin N) :
    TwistedMonoidAlgebra.scalarTrace (cubicProjection N j) = (3 : ℂ)⁻¹ := by
  simp [cubicProjection_def]

/-- `(1 + U_j + U_j ^ 2) ^ 2 = 3 • (1 + U_j + U_j ^ 2)`. -/
private theorem one_add_site_mul_self (N : ℕ) (j : Fin N) :
    (1 + cubicSite N j + cubicSite N j ^ 2) * (1 + cubicSite N j + cubicSite N j ^ 2) =
      (3 : ℂ) • (1 + cubicSite N j + cubicSite N j ^ 2) := by
  set u := cubicSite N j
  have hu : u ^ 3 = 1 := cubicSite_pow_three N j
  have h4 : u ^ 4 = u := by rw [pow_succ, hu, one_mul]
  calc
    (1 + u + u ^ 2) * (1 + u + u ^ 2) = 1 + 2 * u + 3 * u ^ 2 + 2 * u ^ 3 + u ^ 4 := by
      noncomm_ring
    _ = 3 * (1 + u + u ^ 2) := by rw [hu, h4]; noncomm_ring
    _ = (3 : ℂ) • (1 + u + u ^ 2) := by rw [Algebra.smul_def, map_ofNat]

/-- Every cubic projection is idempotent. -/
@[simp]
theorem cubicProjection_mul_self (N : ℕ) (j : Fin N) :
    cubicProjection N j * cubicProjection N j = cubicProjection N j := by
  rw [cubicProjection_def, smul_mul_smul_comm, one_add_site_mul_self, smul_smul]
  congr 1
  norm_num

/-- Auxiliary vanishing identity for a `q`-commuting pair with `u ^ 3 = 1` and
`1 + η + η ^ 2 = 0`. -/
private theorem one_add_pow_mul_mul_one_add_pow_eq_zero {A : Type*} [Semiring A] [Algebra ℂ A]
    {u v : A} {η : ℂ} (hu : u ^ 3 = 1) (hvu : v * u = η • (u * v))
    (hη : 1 + η + η ^ 2 = 0) :
    (1 + u + u ^ 2) * v * (1 + u + u ^ 2) = 0 := by
  set s := 1 + u + u ^ 2
  have hsu : s * u = s := by
    calc
      s * u = u + u ^ 2 + u ^ 3 := by
        simp only [s, add_mul, one_mul]
        rw [← sq, ← pow_succ]
      _ = s := by rw [hu]; dsimp [s]; abel
  have h1 : s * v * u = η • (s * v) := by
    rw [mul_assoc, hvu, mul_smul_comm, ← mul_assoc, hsu]
  have h2 : s * v * u ^ 2 = η ^ 2 • (s * v) := by
    rw [sq, ← mul_assoc, h1, smul_mul_assoc, h1, smul_smul, sq]
  calc
    s * v * (1 + u + u ^ 2) = s * v + s * v * u + s * v * u ^ 2 := by
      simp only [mul_add, mul_one]
    _ = (1 + η + η ^ 2) • (s * v) := by
      rw [h1, h2, add_smul, add_smul, one_smul]
    _ = 0 := by rw [hη, zero_smul]

private theorem exists_adj_cubicSite_phase {N : ℕ} {i j : Fin N}
    (h : (i : ℕ) + 1 = j ∨ (j : ℕ) + 1 = i) :
    ∃ η : ℂ, cubicSite N j * cubicSite N i = η • (cubicSite N i * cubicSite N j) ∧
      η ^ 3 = 1 ∧ 1 + η + η ^ 2 = 0 := by
  rcases h with hij | hji
  · have hinv : ((cubeRootOfUnity⁻¹ : ℂˣ) : ℂ) = (cubeRootOfUnity : ℂ) ^ 2 := by
      apply mul_left_cancel₀ cubeRootOfUnity.ne_zero
      rw [← Units.val_mul, mul_inv_cancel, Units.val_one, ← pow_succ',
        coe_cubeRootOfUnity_pow_three]
    refine ⟨((cubeRootOfUnity⁻¹ : ℂˣ) : ℂ), ?_, ?_, ?_⟩
    · have hmul := cubicSite_mul_succ (N := N) ⟨i.1, by omega⟩
      have hi : (⟨i.1, by omega⟩ : Fin N) = i := Fin.ext rfl
      have hj : (⟨i.1 + 1, by omega⟩ : Fin N) = j := Fin.ext hij
      rw [hi, hj] at hmul
      rw [hmul, smul_smul, ← Units.val_mul, inv_mul_cancel, Units.val_one, one_smul]
    · rw [hinv, ← pow_mul, mul_comm, pow_mul, coe_cubeRootOfUnity_pow_three, one_pow]
    · rw [hinv]
      linear_combination
        (cubeRootOfUnity : ℂ) * coe_cubeRootOfUnity_pow_three + coe_cubeRootOfUnity_sq_add_add_one
  · refine ⟨(cubeRootOfUnity : ℂ), ?_, coe_cubeRootOfUnity_pow_three,
      by linear_combination coe_cubeRootOfUnity_sq_add_add_one⟩
    have hmul := cubicSite_mul_succ (N := N) ⟨j.1, by omega⟩
    have hj : (⟨j.1, by omega⟩ : Fin N) = j := Fin.ext rfl
    have hi : (⟨j.1 + 1, by omega⟩ : Fin N) = i := Fin.ext hji
    rw [hj, hi] at hmul
    exact hmul

/-- Adjacent cubic projections satisfy `p_i * p_j * p_i = 3⁻¹ • p_i`. -/
theorem cubicProjection_mul_cubicProjection_mul_cubicProjection {N : ℕ} {i j : Fin N}
    (h : (i : ℕ) + 1 = j ∨ (j : ℕ) + 1 = i) :
    cubicProjection N i * cubicProjection N j * cubicProjection N i =
      (3 : ℂ)⁻¹ • cubicProjection N i := by
  rw [cubicProjection_def, cubicProjection_def]
  set u := cubicSite N i
  set v := cubicSite N j
  set s := 1 + u + u ^ 2
  obtain ⟨η, hvu, hη3, hηsum⟩ := exists_adj_cubicSite_phase h
  have hv2u : v ^ 2 * u = η ^ 2 • (u * v ^ 2) := by
    rw [sq, mul_assoc, hvu, mul_smul_comm, ← mul_assoc, hvu, smul_mul_assoc, smul_smul, sq,
      mul_assoc]
  have hz1 : s * v * s = 0 :=
    one_add_pow_mul_mul_one_add_pow_eq_zero (cubicSite_pow_three N i) hvu hηsum
  have hz2 : s * v ^ 2 * s = 0 :=
    one_add_pow_mul_mul_one_add_pow_eq_zero (cubicSite_pow_three N i) hv2u
      (by linear_combination η * hη3 + hηsum)
  have hprod : s * (1 + v + v ^ 2) * s = (3 : ℂ) • s := by
    calc
      s * (1 + v + v ^ 2) * s = s * s + s * v * s + s * v ^ 2 * s := by
        simp only [mul_add, add_mul, mul_one]
      _ = (3 : ℂ) • s := by
        rw [one_add_site_mul_self N i, hz1, hz2, add_zero, add_zero]
  simp only [smul_mul_assoc, mul_smul_comm, hprod, smul_smul]
  congr 1
  norm_num

/-- Distant cubic projections commute. -/
theorem commute_cubicProjection {N : ℕ} {i j : Fin N}
    (h : (i : ℕ) + 2 ≤ j ∨ (j : ℕ) + 2 ≤ i) :
    Commute (cubicProjection N i) (cubicProjection N j) := by
  have hc := commute_cubicSite h
  have h1 : Commute (cubicSite N i) (1 + cubicSite N j + cubicSite N j ^ 2) :=
    ((Commute.one_right _).add_right hc).add_right (hc.pow_right 2)
  have h2 : Commute (cubicSite N i ^ 2) (1 + cubicSite N j + cubicSite N j ^ 2) :=
    ((Commute.one_right _).add_right (hc.pow_left 2)).add_right
      ((hc.pow_left 2).pow_right 2)
  rw [cubicProjection_def, cubicProjection_def]
  exact ((((Commute.one_left _).add_left h1).add_left h2).smul_left _).smul_right _

end TauCeti.TemperleyLieb
