/-! ### Tensor powers of invertible sheaves and sections -/

/-- Every monoidal tensor power `L^{⊗n}` of an invertible sheaf is invertible. -/
instance isInvertible_tensorPow (L : X.Modules) [SheafOfModules.isInvertible X L] (n : ℕ) :
    SheafOfModules.isInvertible X (tensorPow L n) := by
  induction n with
  | zero => exact SheafOfModules.isInvertible_tensorUnit X
  | succ n ih =>
    let K : InvertibleSheaf X := ⟨tensorPow L n, ih⟩
    let L' : InvertibleSheaf X := ⟨L, inferInstance⟩
    exact (SheafOfModules.isInvertible X).prop_of_iso
      (InvertibleSheaf.tensorProductObjIso L' K) (L'.tensorProduct K).property

/-- Every monoidal tensor power of a quasi-coherent module is quasi-coherent. -/
private theorem isQuasicoherent_tensorPow (L : X.Modules) [L.IsQuasicoherent] (n : ℕ) :
    (tensorPow L n).IsQuasicoherent := by
  induction n with
  | zero => exact isQuasicoherent_unit X
  | succ n ih => exact isQuasicoherent_tensorObj X L (tensorPow L n)

/-- The underlying sheaf of `InvertibleSheaf.tensorPow L n` is isomorphic to the monoidal tensor
power `TauCeti.tensorPow L.obj n`. -/
private def tensorPowObjIso (L : InvertibleSheaf X) :
    ∀ n : ℕ, (L.tensorPow n).obj ≅ tensorPow L.obj n
  | 0 => eqToIso (congrArg (·.obj) L.tensorPow_zero) ≪≫ InvertibleSheaf.trivialObjIsoUnit X
  | n + 1 =>
    eqToIso (congrArg (·.obj) (L.tensorPow_succ n)) ≪≫
      InvertibleSheaf.tensorProductObjIso (L.tensorPow n) L ≪≫
      whiskerRightIso (tensorPowObjIso L n) L.obj ≪≫ tensorPowSuccIso L.obj n

/-- The line-bundle class of the monoidal tensor power `L^{⊗n}` is `[L]ⁿ`. -/
private theorem mk_tensorPow_eq (L : InvertibleSheaf X) (n : ℕ) :
    LineBundleClass.mk ⟨tensorPow L.obj n, inferInstance⟩ = LineBundleClass.mk L ^ n := by
  rw [← LineBundleClass.mk_tensorPow, LineBundleClass.mk_eq_mk_iff]
  exact ⟨(tensorPowObjIso L n).symm⟩

/-- The sections of `M ⊗ N` over affine opens are finitely generated when those of `M` and `N`
are, so the tensor product of quasi-coherent finite-type modules is of finite type. -/
private theorem isFiniteType_tensorObj (M N : X.Modules) [M.IsQuasicoherent] [N.IsQuasicoherent]
    [M.IsFiniteType] [N.IsFiniteType] : (M ⊗ N).IsFiniteType := by
  refine isFiniteType_of_finite_sections (M ⊗ N) fun U hU ↦ ?_
  have : Module.Finite Γ(X, U) Γ(M, U) := M.finite_sections_of_isAffineOpen U hU
  have : Module.Finite Γ(X, U) Γ(N, U) := N.finite_sections_of_isAffineOpen U hU
  have : Module.Finite Γ(X, U) (((sectionsFunctor U).obj M ⊗ (sectionsFunctor U).obj N :
      ModuleCat Γ(X, U)) : Type u) :=
    Module.Finite.tensorProduct Γ(X, U) Γ(M, U) Γ(N, U)
  exact Module.Finite.equiv
    (LinearEquiv.ofBijective (Functor.LaxMonoidal.μ (sectionsFunctor U) M N).hom
      (bijective_μ_sectionsFunctor M N hU))

/-- The left unitor `𝒪_X ⊗ M ≅ M` sends `1 ⊗ t` to `t`. -/
private theorem leftUnitor_hom_app_tmulRight (M : X.Modules) {U : X.Opens} (t : Γ(M, U)) :
    (λ_ M).hom.app U (tmulRight (𝟙_ X.Modules) t (1 : Γ(X, U))) = t := by
  have h := congrArg (fun φ ↦ φ.hom ((1 : Γ(X, U)) ⊗ₜ t))
    (Functor.LaxMonoidal.left_unitality (sectionsFunctor U) M)
  simp only [sectionsFunctor_ε, ModuleCat.hom_comp, LinearMap.comp_apply] at h
  have h1 : tmulRight (𝟙_ X.Modules) t (1 : Γ(X, U)) =
      Functor.LaxMonoidal.μ (sectionsFunctor U) (𝟙_ X.Modules) M ((1 : Γ(X, U)) ⊗ₜ t) :=
    tmulRight_apply (𝟙_ X.Modules) t (1 : Γ(X, U))
  rw [h1]
  exact h.symm.trans (one_smul Γ(X, U) t)

/-- The associator `(M ⊗ N) ⊗ P ≅ M ⊗ (N ⊗ P)` sends `(m ⊗ n) ⊗ p` to `m ⊗ (n ⊗ p)`. -/
private theorem associator_hom_app_tmulRight (M N P : X.Modules) {U : X.Opens}
    (m : Γ(M, U)) (n : Γ(N, U)) (p : Γ(P, U)) :
    (α_ M N P).hom.app U (tmulRight (M ⊗ N) p (tmulRight M n m)) =
      tmulRight M (tmulRight N p n) m := by
  have h := congrArg (fun φ ↦ φ.hom ((m ⊗ₜ n) ⊗ₜ p))
    (Functor.LaxMonoidal.associativity (sectionsFunctor U) M N P)
  simp only [ModuleCat.hom_comp, LinearMap.comp_apply, ModuleCat.hom_whiskerRight,
    ModuleCat.hom_whiskerLeft] at h
  rw [tmulRight_apply, tmulRight_apply, tmulRight_apply, tmulRight_apply]
  exact h

/-- The block decomposition `L^{⊗m} ⊗ L^{⊗k} ≅ L^{⊗(k + m)}` sends `sᵐ ⊗ sᵏ` to `s^{k + m}`. -/
private theorem tensorPowAddIso_hom_app_tmulRight {L : X.Modules} {U : X.Opens} (s : Γ(L, U))
    (m k : ℕ) :
    (tensorPowAddIso L m k).hom.app U
        (tmulRight (tensorPow L m) (tensorPowSection s k) (tensorPowSection s m)) =
      tensorPowSection s (k + m) := by
  induction m with
  | zero =>
    simpa only [tensorPowAddIso_zero, tensorPowSection_zero, Nat.add_zero] using
      leftUnitor_hom_app_tmulRight (tensorPow L k) (tensorPowSection s k)
  | succ m ih =>
    rw [tensorPowAddIso_succ_hom, Hom.comp_app, ConcreteCategory.comp_apply, tensorPowSection_succ,
      associator_hom_app_tmulRight, whiskerLeft_app_tmulRight, ih]
    exact (tensorPowSection_succ s (k + m)).symm

/-- **The nonvanishing locus of a positive tensor power of a section.** For `n > 0` and a section
`s` of an invertible sheaf `L` over `U`, the nonvanishing locus of `sⁿ` in `L^{⊗n}` coincides
with the nonvanishing locus of `s` in `L`. -/
theorem nonvanishingLocus_tensorPowSection {L : X.Modules} [SheafOfModules.isInvertible X L]
    {U : X.Opens} (s : Γ(L, U)) {n : ℕ} (hn : 0 < n) :
    (tensorPow L n).nonvanishingLocus (tensorPowSection s n) = L.nonvanishingLocus s := by
  ext x
  by_cases hxU : x ∈ U
  · obtain ⟨V, t, hxV⟩ := exists_mem_trivialization L x
    let W := U ⊓ V
    let iU : W ⟶ U := homOfLE inf_le_left
    let iV : W ⟶ V := homOfLE inf_le_right
    have hxW : x ∈ W := ⟨hxU, hxV⟩
    let e : Γ(L, W) := L.presheaf.map iV.op (trivializationGenerator L t)
    have hWe : W ≤ L.nonvanishingLocus e := by
      rw [nonvanishingLocus_map, nonvanishingLocus_trivializationGenerator]
      exact le_inf le_rfl inf_le_right
    obtain ⟨f, hf⟩ := surjective_smul_of_le_nonvanishingLocus hWe (L.presheaf.map iU.op s)
    have hL : W ⊓ L.nonvanishingLocus s = X.basicOpen f := by
      rw [← nonvanishingLocus_map iU, ← hf, nonvanishingLocus_smul,
        inf_eq_left.mpr ((X.basicOpen_le f).trans hWe)]
    have hWn : W ≤ (tensorPow L n).nonvanishingLocus (tensorPowSection e n) := by
      rw [le_nonvanishingLocus_iff _ (𝟙 W)]
      intro W' j
      simpa only [Category.comp_id] using
        bijective_smul_tensorPowSection e
          (fun W'' j' ↦ by
            simpa only [Category.comp_id] using (le_nonvanishingLocus_iff e (𝟙 W)).mp hWe W'' j')
          n W' j
    have hLn : W ⊓ (tensorPow L n).nonvanishingLocus (tensorPowSection s n) =
        X.basicOpen (f ^ n) := by
      rw [← nonvanishingLocus_map iU, map_tensorPowSection, ← hf, tensorPowSection_smul,
        nonvanishingLocus_smul, inf_eq_left.mpr ((X.basicOpen_le (f ^ n)).trans hWn)]
    have hmem : x ∈ W ⊓ (tensorPow L n).nonvanishingLocus (tensorPowSection s n) ↔
        x ∈ W ⊓ L.nonvanishingLocus s := by
      rw [hLn, hL, Scheme.basicOpen_pow _ _ hn]
    simpa only [SetLike.mem_coe, Opens.mem_inf, hxW, true_and] using hmem
  · exact iff_of_false (fun h ↦ hxU (nonvanishingLocus_le _ h))
      (fun h ↦ hxU (nonvanishingLocus_le _ h))

/-! ### Quasi-separatedness and epimorphisms from an affine cover -/

/-- A morphism into a quasi-coherent module is an epimorphism as soon as it is surjective on
sections over every member of an affine open cover of `X`. -/
private theorem epi_of_iSup_eq_top_of_surjective {M N : X.Modules} [N.IsQuasicoherent]
    (φ : M ⟶ N) {ι : Type*} (U : ι → X.Opens) (hU : ∀ i, IsAffineOpen (U i))
    (hcover : ⨆ i, U i = ⊤) (hsurj : ∀ i, Function.Surjective (φ.app (U i))) : Epi φ := by
  have : CategoryTheory.Sheaf.IsLocallySurjective
      ((TauCeti.AlgebraicGeometry.Scheme.Modules.toSheaf X).map φ) := by
    constructor
    intro V t x hxV
    let t' : Γ(N, V) := t
    obtain ⟨i, hxU⟩ := Opens.mem_iSup.mp (hcover.symm ▸ Opens.mem_top x)
    obtain ⟨f, hfV, hxf⟩ := (hU i).exists_basicOpen_le ⟨x, hxV⟩ hxU
    have hloc := N.isLocalizedModule_basicOpenRestrict (hU i) f
    obtain ⟨⟨y, k, hk⟩, hy⟩ := hloc.surj (N.presheaf.map (homOfLE hfV).op t')
    obtain ⟨m, rfl⟩ := hk
    obtain ⟨z, hz⟩ := hsurj i y
    obtain ⟨u, hu⟩ := (X.toRingedSpace.isUnit_res_basicOpen f).pow m
    let uval : Γ(X, X.basicOpen f) := u.val
    let uinv : Γ(X, X.basicOpen f) := (u⁻¹).val
    have hres : N.presheaf.map (homOfLE hfV).op t' =
        uinv • N.presheaf.map (homOfLE (X.basicOpen_le f)).op (φ.app (U i) z) := by
      rw [hz, ← N.basicOpenRestrict_apply f y]
      have hy' : uval • N.presheaf.map (homOfLE hfV).op t' = N.basicOpenRestrict f y := by
        rw [show uval = (X.presheaf.map (homOfLE (X.basicOpen_le f)).op f) ^ m from hu,
          ← map_pow, ← N.basicOpen_smul_def f (f ^ m)]
        exact hy
      rw [← hy', smul_smul, show uinv * uval = 1 from u.inv_mul, one_smul]
    refine ⟨X.basicOpen f, homOfLE hfV,
      ⟨uinv • M.presheaf.map (homOfLE (X.basicOpen_le f)).op z, ?_⟩, hxf⟩
    -- Unfold the sheaf morphism action on sections to `Hom.app`.
    change φ.app (X.basicOpen f) _ = N.presheaf.map (homOfLE hfV).op t'
    rw [Hom.app_smul, show φ.app (X.basicOpen f) = (Hom.mapPresheaf φ).app (op (X.basicOpen f))
        from rfl,
      φ.mapPresheaf.naturality_apply (homOfLE (X.basicOpen_le f)).op z,
      show (Hom.mapPresheaf φ).app (op (U i)) = φ.app (U i) from rfl, ← hres]
  exact (TauCeti.AlgebraicGeometry.Scheme.Modules.toSheaf X).epi_of_epi_map
    (CategoryTheory.Sheaf.epi_of_isLocallySurjective _)

/-- If `X` is covered by affine nonvanishing loci of global sections of an invertible sheaf `L`,
then `X` is quasi-separated: any two such loci meet in an affine basic open of the first. -/
private theorem quasiSeparatedSpace_of_iSup_nonvanishingLocus {L : X.Modules}
    [SheafOfModules.isInvertible X L] {ι : Type*} (s : ι → Γ(L, ⊤))
    (haff : ∀ i, IsAffineOpen (L.nonvanishingLocus (s i)))
    (hcover : ⨆ i, L.nonvanishingLocus (s i) = ⊤) : QuasiSeparatedSpace X := by
  refine Scheme.quasiSeparatedSpace_of_isOpenCover (fun i ↦ L.nonvanishingLocus (s i))
    (IsOpenCover.mk hcover) haff fun i j ↦ ?_
  let U := L.nonvanishingLocus (s i)
  have hUi : U ≤ L.nonvanishingLocus (L.presheaf.map U.leTop.op (s i)) := by
    rw [nonvanishingLocus_map]
    exact le_inf le_rfl le_rfl
  obtain ⟨f, hf⟩ := surjective_smul_of_le_nonvanishingLocus hUi
    (L.presheaf.map U.leTop.op (s j))
  have hinter : U ⊓ L.nonvanishingLocus (s j) = X.basicOpen f := by
    rw [← nonvanishingLocus_map U.leTop, ← hf, nonvanishingLocus_smul,
      inf_eq_left.mpr ((X.basicOpen_le f).trans hUi)]
  have hcoe : (U : Set X) ∩ (L.nonvanishingLocus (s j) : Set X) = (X.basicOpen f : Set X) :=
    congrArg (fun W : X.Opens ↦ (W : Set X)) hinter
  rw [hcoe]
  exact ((haff i).basicOpen f).isCompact

/-- Restricting a global section obtained by tensoring `g` with `s^{n - m}` and reassociating
recovers `t ⊗ sⁿ` on the nonvanishing locus `X_s`. -/
private theorem map_reassociate_eq_tmulRight (F : X.Modules) {L : X.Modules}
    [SheafOfModules.isInvertible X L] (s : Γ(L, ⊤)) {m n : ℕ} (hmn : m ≤ n)
    (t : Γ(F, L.nonvanishingLocus s)) (g : Γ(F ⊗ tensorPow L m, ⊤))
    (hg : (F ⊗ tensorPow L m).presheaf.map (L.nonvanishingLocus s).leTop.op g =
      tmulRight F (tensorPowSection (L.presheaf.map (L.nonvanishingLocus s).leTop.op s) m) t) :
    let μ : (F ⊗ tensorPow L m) ⊗ tensorPow L (n - m) ⟶ F ⊗ tensorPow L n :=
      (α_ F (tensorPow L m) (tensorPow L (n - m))).hom ≫
        F ◁ ((tensorPowAddIso L m (n - m)).hom ≫
          eqToHom (congrArg (tensorPow L) (Nat.sub_add_cancel hmn)))
    (F ⊗ tensorPow L n).presheaf.map (L.nonvanishingLocus s).leTop.op
        (μ.app ⊤ (tmulRight (F ⊗ tensorPow L m) (tensorPowSection s (n - m)) g)) =
      tmulRight F (tensorPowSection (L.presheaf.map (L.nonvanishingLocus s).leTop.op s) n) t := by
  intro μ
  let U := L.nonvanishingLocus s
  have hnat := μ.mapPresheaf.naturality_apply U.leTop.op
    (tmulRight (F ⊗ tensorPow L m) (tensorPowSection s (n - m)) g)
  rw [show μ.app ⊤ = (Hom.mapPresheaf μ).app (op ⊤) from rfl, ← hnat,
    show (Hom.mapPresheaf μ).app (op U) = μ.app U from rfl,
    map_tmulRight_tensorPowSection, hg]
  have hcast : ∀ (a b : ℕ) (hab : a = b),
      (F ◁ eqToHom (congrArg (tensorPow L) hab)).app U
        (tmulRight F (tensorPowSection (L.presheaf.map U.leTop.op s) a) t) =
        tmulRight F (tensorPowSection (L.presheaf.map U.leTop.op s) b) t := by
    rintro a _ rfl
    simp
  simp only [μ, whiskerLeft_comp, ← Category.assoc, Hom.comp_app, ConcreteCategory.comp_apply]
  rw [associator_hom_app_tmulRight, whiskerLeft_app_tmulRight, tensorPowAddIso_hom_app_tmulRight,
    hcast _ _ (Nat.sub_add_cancel hmn)]

/-- If the restrictions of global sections `h : K → Γ(N, ⊤)` span `Γ(N, U)` over `Γ(X, U)`, then
the associated morphism `free K ⟶ N` is surjective on sections over `U`. -/
private theorem surjective_freeHom_app_of_span {N : X.Modules} {K : Type u}
    (h : K → Γ(N, ⊤)) (U : X.Opens)
    (hspan : Submodule.span Γ(X, U) (Set.range fun k ↦ N.presheaf.map U.leTop.op (h k)) = ⊤) :
    let F : X.Modules := _root_.SheafOfModules.free K
    let φ : F ⟶ N := N.freeHomEquiv.symm fun k ↦ N.sectionsEquivTop.symm (h k)
    Function.Surjective (φ.app U) := by
  intro F φ y
  have hy : y ∈ Submodule.span Γ(X, U) (Set.range fun k ↦ N.presheaf.map U.leTop.op (h k)) :=
    hspan ▸ Submodule.mem_top
  induction hy using Submodule.span_induction with
  | mem _ hk =>
    obtain ⟨k, rfl⟩ := hk
    refine ⟨F.presheaf.map U.leTop.op (F.sectionsEquivTop (_root_.SheafOfModules.freeSection k)),
      ?_⟩
    rw [show φ.app U = (Hom.mapPresheaf φ).app (op U) from rfl,
      φ.mapPresheaf.naturality_apply U.leTop.op,
      show (Hom.mapPresheaf φ).app (op ⊤) = φ.app ⊤ from rfl, ← sectionsEquivTop_sectionsMap]
    have hsec : _root_.SheafOfModules.sectionsMap φ (_root_.SheafOfModules.freeSection k) =
        N.freeHomEquiv φ k :=
      (_root_.SheafOfModules.freeHomEquiv_apply (M := N) φ k).symm
    rw [hsec, Equiv.apply_symm_apply, Equiv.apply_symm_apply]
  | zero => exact ⟨0, map_zero _⟩
  | add _ _ _ _ ha hb =>
    obtain ⟨a, rfl⟩ := ha
    obtain ⟨b, rfl⟩ := hb
    exact ⟨a + b, map_add _ _ _⟩
  | smul r _ _ ha =>
    obtain ⟨a, rfl⟩ := ha
    exact ⟨r • a, Hom.app_smul _ _ _⟩

/-- **Global generation of twists from a finite affine cover by nonvanishing loci.** If `X` is
covered by finitely many affine nonvanishing loci `X_{sᵢ}` of global sections `sᵢ` of an
invertible sheaf `L`, then for every quasi-coherent sheaf `F` of finite type there exists `n₀`
such that `F ⊗ L^{⊗n}` is generated by finitely many global sections for every `n ≥ n₀`. -/
theorem exists_generatingSections_tensorPow_of_iSup_nonvanishingLocus
    (F : X.Modules) [F.IsQuasicoherent] [F.IsFiniteType]
    {L : X.Modules} [SheafOfModules.isInvertible X L]
    {ι : Type*} [Finite ι] (s : ι → Γ(L, ⊤))
    (haff : ∀ i, IsAffineOpen (L.nonvanishingLocus (s i)))
    (hcover : ⨆ i, L.nonvanishingLocus (s i) = ⊤) :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, ∃ σ : (F ⊗ tensorPow L n).GeneratingSections, σ.IsFiniteType := by
  classical
  cases nonempty_fintype ι
  have : QuasiSeparatedSpace X := quasiSeparatedSpace_of_iSup_nonvanishingLocus s haff hcover
  have : CompactSpace X := by
    rw [← isCompact_univ_iff, ← Opens.coe_top, ← hcover, Opens.coe_iSup]
    exact isCompact_iUnion fun i ↦ (haff i).isCompact
  have : L.IsQuasicoherent := InvertibleSheaf.isQuasicoherent_obj ⟨L, inferInstance⟩
  let U : ι → X.Opens := fun i ↦ L.nonvanishingLocus (s i)
  choose T hT using fun i ↦ @Module.Finite.fg_top Γ(X, U i) Γ(F, U i) _ _ _
    (F.finite_sections_of_isAffineOpen (U i) (haff i))
  let J := Σ i : ι, { t : Γ(F, U i) // t ∈ T i }
  choose m g hg using fun p : J ↦ exists_map_eq_tmulRight_tensorPowSection F
    (U := (⊤ : X.Opens)) isCompact_univ isQuasiSeparated_univ (s p.1) p.2.1
  refine ⟨Finset.univ.sup m, fun n hn ↦ ?_⟩
  have hle (p : J) : m p ≤ n := (Finset.le_sup (f := m) (Finset.mem_univ p)).trans hn
  let hsec (p : J) : Γ(F ⊗ tensorPow L n, ⊤) :=
    ((α_ F (tensorPow L (m p)) (tensorPow L (n - m p))).hom ≫
      F ◁ ((tensorPowAddIso L (m p) (n - m p)).hom ≫
        eqToHom (congrArg (tensorPow L) (Nat.sub_add_cancel (hle p))))).app ⊤
      (tmulRight (F ⊗ tensorPow L (m p)) (tensorPowSection (s p.1) (n - m p)) (g p))
  let eJ : J ≃ ULift.{u} (Fin (Fintype.card J)) := (Fintype.equivFin J).trans Equiv.ulift.symm
  let secFam : ULift.{u} (Fin (Fintype.card J)) → (F ⊗ tensorPow L n).sections :=
    fun q ↦ (F ⊗ tensorPow L n).sectionsEquivTop.symm (hsec (eJ.symm q))
  have : (tensorPow L n).IsQuasicoherent := isQuasicoherent_tensorPow L n
  let Ffree : X.Modules := _root_.SheafOfModules.free (ULift.{u} (Fin (Fintype.card J)))
  let φ : Ffree ⟶ F ⊗ tensorPow L n := (F ⊗ tensorPow L n).freeHomEquiv.symm secFam
  have hφ_epi : Epi φ := by
    refine epi_of_iSup_eq_top_of_surjective φ U haff hcover fun i ↦
      surjective_freeHom_app_of_span (fun q ↦ hsec (eJ.symm q)) (U i)
        (Submodule.eq_top_iff'.mpr fun y ↦ ?_)
    have hUi : U i ≤ L.nonvanishingLocus (L.presheaf.map (U i).leTop.op (s i)) := by
      rw [nonvanishingLocus_map]
      exact le_inf le_rfl le_rfl
    obtain ⟨x, rfl⟩ :=
      (bijective_tmulRight_tensorPowSection_of_le_nonvanishingLocus F _ hUi n).2 y
    have hx : x ∈ Submodule.span Γ(X, U i) (T i : Set Γ(F, U i)) := hT i ▸ Submodule.mem_top
    let ψ := tmulRight F (tensorPowSection (L.presheaf.map (U i).leTop.op (s i)) n)
    change ψ x ∈ _
    induction hx using Submodule.span_induction with
    | mem t ht =>
      refine Submodule.subset_span ⟨eJ ⟨i, t, ht⟩, ?_⟩
      simpa only [Equiv.symm_apply_apply] using
        map_reassociate_eq_tmulRight F (s i) (hle ⟨i, t, ht⟩) t (g ⟨i, t, ht⟩) (hg ⟨i, t, ht⟩)
    | zero => exact (map_zero ψ).symm ▸ Submodule.zero_mem _
    | add _ _ _ _ ha hb => exact (map_add ψ _ _).symm ▸ Submodule.add_mem _ ha hb
    | smul r _ _ ha => exact (LinearMap.map_smul ψ r _).symm ▸ Submodule.smul_mem _ r ha
  exact ⟨⟨ULift.{u} (Fin (Fintype.card J)), secFam, hφ_epi⟩, ⟨inferInstance⟩⟩

/-! ### Common-degree affine cover for an ample line bundle -/

/-- Every ample line bundle `L` has a positive tensor power `L^{⊗d}` admitting finitely many
global sections whose nonvanishing loci are affine and cover `X`. -/
private theorem exists_finite_affine_cover_tensorPow_of_isAmple (L : InvertibleSheaf X)
    (hL : (LineBundleClass.mk L).IsAmple) :
    ∃ (d : ℕ) (_ : 0 < d) (ι : Type u) (_ : Finite ι) (s : ι → Γ(tensorPow L.obj d, ⊤)),
      (∀ i, IsAffineOpen ((tensorPow L.obj d).nonvanishingLocus (s i))) ∧
        ⨆ i, (tensorPow L.obj d).nonvanishingLocus (s i) = ⊤ := by
  classical
  have : CompactSpace X := hL.compactSpace
  have H (x : X) : ∃ (d : ℕ) (_ : 0 < d) (s : Γ(tensorPow L.obj d, ⊤)),
      x ∈ (tensorPow L.obj d).nonvanishingLocus s ∧
        IsAffineOpen ((tensorPow L.obj d).nonvanishingLocus s) := by
    obtain ⟨d, hd, hsec⟩ := hL.exists_pos_forall_mk_eq x
    obtain ⟨s, hx, haff⟩ := hsec ⟨tensorPow L.obj d, inferInstance⟩ (mk_tensorPow_eq L d)
    exact ⟨d, hd, s, hx, haff⟩
  choose d hd s hx haff using H
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover
    (fun x : X ↦ ((tensorPow L.obj (d x)).nonvanishingLocus (s x) : Set X))
    (fun x ↦ ((tensorPow L.obj (d x)).nonvanishingLocus (s x)).isOpen)
    fun x _ ↦ Set.mem_iUnion.mpr ⟨x, hx x⟩
  let D : ℕ := ∏ x ∈ t, d x
  have hD : 0 < D := Finset.prod_pos fun x _ ↦ hd x
  have hdvd (x : t) : d x.1 ∣ D := Finset.dvd_prod_of_mem d x.2
  have hqpos (x : t) : 0 < D / d x.1 := Nat.div_pos (Nat.le_of_dvd hD (hdvd x)) (hd x.1)
  have hiso (x : t) :
      Nonempty (tensorPow (tensorPow L.obj (d x.1)) (D / d x.1) ≅ tensorPow L.obj D) := by
    refine (LineBundleClass.mk_eq_mk_iff
      (L := ⟨tensorPow (tensorPow L.obj (d x.1)) (D / d x.1), inferInstance⟩)
      (K := ⟨tensorPow L.obj D, inferInstance⟩)).mp ?_
    rw [mk_tensorPow_eq ⟨tensorPow L.obj (d x.1), inferInstance⟩, mk_tensorPow_eq L,
      mk_tensorPow_eq L, ← pow_mul, Nat.mul_div_cancel' (hdvd x)]
  let e (x : t) := (hiso x).some
  let s' : t → Γ(tensorPow L.obj D, ⊤) :=
    fun x ↦ (e x).hom.app ⊤ (tensorPowSection (s x.1) (D / d x.1))
  have hlocus (x : t) :
      (tensorPow L.obj D).nonvanishingLocus (s' x) =
        (tensorPow L.obj (d x.1)).nonvanishingLocus (s x.1) := by
    rw [nonvanishingLocus_hom_app (e x), nonvanishingLocus_tensorPowSection (s x.1) (hqpos x)]
  refine ⟨D, hD, t, inferInstance, s', fun x ↦ hlocus x ▸ haff x.1, top_unique fun y _ ↦ ?_⟩
  obtain ⟨x, hxt, hyx⟩ := Set.mem_iUnion₂.mp (ht (Set.mem_univ y))
  exact Opens.mem_iSup.mpr ⟨⟨x, hxt⟩, (hlocus ⟨x, hxt⟩).symm ▸ hyx⟩

end AlgebraicGeometry.Scheme.Modules

namespace TauCeti.AlgebraicGeometry.LineBundleClass

variable {X : Scheme.{u}}

/-- **A scheme carrying an ample line bundle is quasi-separated** (Stacks Tag 01PR). -/
theorem IsAmple.quasiSeparatedSpace {a : LineBundleClass X} (h : a.IsAmple) :
    QuasiSeparatedSpace X := by
  obtain ⟨L, rfl⟩ := mk_surjective a
  obtain ⟨d, -, _, _, s, haff, hcover⟩ :=
    AlgebraicGeometry.Scheme.Modules.exists_finite_affine_cover_tensorPow_of_isAmple L h
  exact AlgebraicGeometry.Scheme.Modules.quasiSeparatedSpace_of_iSup_nonvanishingLocus
    s haff hcover

end TauCeti.AlgebraicGeometry.LineBundleClass

namespace AlgebraicGeometry.Scheme.Modules

variable {X : Scheme.{u}}

/-- **Serre's Theorem A (global generation of ample twists).** Let `L` be an ample line bundle on
a scheme `X`, and let `F` be a quasi-coherent `𝒪_X`-module of finite type. Then there exists
`n₀ : ℕ` such that `F ⊗ L^{⊗n}` is generated by finitely many global sections for every `n ≥ n₀`.
Neither Noetherianity nor an extra quasi-separatedness hypothesis is needed. -/
theorem exists_generatingSections_tensorPow_of_isAmple
    (F : X.Modules) [F.IsQuasicoherent] [F.IsFiniteType]
    (L : InvertibleSheaf X) (hL : (LineBundleClass.mk L).IsAmple) :
    ∃ n₀ : ℕ, ∀ n ≥ n₀,
      ∃ σ : (F ⊗ (L.tensorPow n).obj).GeneratingSections, σ.IsFiniteType := by
  obtain ⟨d, hd, ι, _, s, haff, hcover⟩ :=
    exists_finite_affine_cover_tensorPow_of_isAmple L hL
  have hrem (r : Fin d) :
      ∃ N : ℕ, ∀ q ≥ N,
        ∃ σ : ((F ⊗ (L.tensorPow r.1).obj) ⊗ tensorPow (tensorPow L.obj d) q).GeneratingSections,
          σ.IsFiniteType := by
    have : TauCeti.SheafOfModules.IsInvertible (R := X.ringCatSheaf) (L.tensorPow r.1).obj :=
      (L.tensorPow r.1).property
    let Mr : _root_.SheafOfModules X.ringCatSheaf := (L.tensorPow r.1).obj
    have : ((L.tensorPow r.1).obj).IsFiniteType := inferInstanceAs Mr.IsFiniteType
    have : (F ⊗ (L.tensorPow r.1).obj).IsFiniteType :=
      isFiniteType_tensorObj F (L.tensorPow r.1).obj
    exact exists_generatingSections_tensorPow_of_iSup_nonvanishingLocus
      (F ⊗ (L.tensorPow r.1).obj) s haff hcover
  choose N hN using hrem
  refine ⟨d * Finset.univ.sup N, fun n hn ↦ ?_⟩
  let r : Fin d := ⟨n % d, Nat.mod_lt n hd⟩
  let q : ℕ := n / d
  have hq : N r ≤ q :=
    (Finset.le_sup (f := N) (Finset.mem_univ r)).trans ((Nat.le_div_iff_mul_le hd).mpr (by
      simpa only [mul_comm] using hn))
  obtain ⟨σ, hσ⟩ := hN r q hq
  let K : InvertibleSheaf X := ⟨tensorPow (tensorPow L.obj d) q, inferInstance⟩
  have hpow : Nonempty (((L.tensorPow r.1).tensorProduct K).obj ≅ (L.tensorPow n).obj) := by
    refine LineBundleClass.mk_eq_mk_iff.mp ?_
    rw [LineBundleClass.mk_tensorProduct, LineBundleClass.mk_tensorPow,
      mk_tensorPow_eq ⟨tensorPow L.obj d, inferInstance⟩, mk_tensorPow_eq L, ← pow_mul, ← pow_add,
      LineBundleClass.mk_tensorPow, add_comm, Nat.div_add_mod]
  obtain ⟨e⟩ := hpow
  let eF : (F ⊗ (L.tensorPow r.1).obj) ⊗ K.obj ≅ F ⊗ (L.tensorPow n).obj :=
    α_ F (L.tensorPow r.1).obj K.obj ≪≫
      whiskerLeftIso F ((InvertibleSheaf.tensorProductObjIso (L.tensorPow r.1) K).symm ≪≫ e)
  exact ⟨_root_.SheafOfModules.GeneratingSections.equivOfIso eF σ, ⟨hσ.finite⟩⟩

end AlgebraicGeometry.Scheme.Modules

namespace TauCeti.AlgebraicGeometry.InvertibleSheaf

variable {X : Scheme.{u}}

/-- **Global generation of ample twists of a line bundle.** If `L` is ample and `K` is any line
bundle on `X`, then `K ⊗ L^{⊗n}` is globally generated for all sufficiently large `n`. -/
theorem exists_isGloballyGenerated_tensorProduct_tensorPow (K L : InvertibleSheaf X)
    (hL : (LineBundleClass.mk L).IsAmple) :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, (K.tensorProduct (L.tensorPow n)).IsGloballyGenerated := by
  have : TauCeti.SheafOfModules.IsInvertible (R := X.ringCatSheaf) K.obj := K.property
  let MK : _root_.SheafOfModules X.ringCatSheaf := K.obj
  have : K.obj.IsFiniteType := inferInstanceAs MK.IsFiniteType
  obtain ⟨n₀, hn₀⟩ :=
    AlgebraicGeometry.Scheme.Modules.exists_generatingSections_tensorPow_of_isAmple K.obj L hL
  refine ⟨n₀, fun n hn ↦ ?_⟩
  obtain ⟨σ, -⟩ := hn₀ n hn
  exact isGloballyGenerated_iff_nonempty_generatingSections.mpr
    ⟨_root_.SheafOfModules.GeneratingSections.equivOfIso
      (tensorProductObjIso K (L.tensorPow n)).symm σ⟩

/-- **Global generation of high powers of an ample line bundle.** If `L` is ample on `X`, then
`L^{⊗n}` is globally generated for all sufficiently large `n`. -/
theorem exists_isGloballyGenerated_tensorPow (L : InvertibleSheaf X)
    (hL : (LineBundleClass.mk L).IsAmple) :
    ∃ n₀ : ℕ, ∀ n ≥ n₀, (L.tensorPow n).IsGloballyGenerated := by
  obtain ⟨n₀, hn₀⟩ := exists_isGloballyGenerated_tensorProduct_tensorPow (trivial X) L hL
  exact ⟨n₀, fun n hn ↦ (isGloballyGenerated_iff_of_iso
    (tensorTrivialLeftIsoSheaf (L.tensorPow n))).mp (hn₀ n hn)⟩

end TauCeti.AlgebraicGeometry.InvertibleSheaf
