/-!
# Algebraic Mahler rationality and regularity of Mahler function fields

This file proves the algebraic rationality theorem for Mahler series over an arbitrary field `K`
of characteristic zero (Nishioka, Theorem 5.1.7): every `q`-Mahler Laurent series `f : K⸨X⸩`
that is algebraic over `K(X)` already belongs to `K(X)`
(`TauCeti.isMahlerSeries_isAlgebraic_mem_range_ratFunc`).

## Proof outline

1. By coefficient-field descent (`LaurentSeries.mem_range_ratFunc_mapRingHom_iff`,
   `LaurentSeries.isAlgebraic_mapRingHom_iff`, `TauCeti.isMahlerSeries_mapRingHom_iff`), we reduce
   to an algebraically closed base field `K` of characteristic zero.
2. Given a `q`-Mahler series `f : K⸨X⸩` algebraic over `K(X)`, the intermediate field `L`
   generated over `K(X)` by finitely many iterates `f(X^(q^i))` is finite-dimensional over `K(X)`
   and stable under the expansion `X ↦ X^q`, hence under `X ↦ X^(q^m)` for every `m ≥ 1`.
3. Comparing degrees in the tower `K(X^(q^m)) ⊆ expand (q^m) (L) ⊆ L` via
   `TauCeti.RatFunc.finrank_adjoin_X_pow` shows `[L : expand (q^m) (L)] = q^m`. The powers
   `1, X, …, X^(q^m - 1)` are linearly independent over `expand (q^m) (L)` by
   `LaurentSeries.contract_eq_of_sum_eq`, hence form a basis; consequently, rescaling `X ↦ ζ X`
   by any `q^m`-th root of unity `ζ ∈ Kˣ` stabilizes `L`.
4. Let `R₀` and `R∞` be the integral closures of `K[X]` and `K[X⁻¹]` in `L`. Using the
   nondegenerate trace pairing over `K(X)`, each intersection `V_N = R₀ ∩ X^N R∞` embeds into
   a finite product of bounded-degree polynomial spaces and is therefore finite-dimensional over
   `K`, while remaining invariant under every `X ↦ ζ X` with `ζ^(q^m) = 1`.
5. Applying `X ↦ ζ X` for a primitive `q^m`-th root of unity with `q^m` larger than the span of
   `s + 1` support exponents (where `s = dim_K V_N`) produces a nonzero polynomial of degree `≤ s`
   with `s + 1` distinct roots, a contradiction. Thus every element of `V_N` has finite Laurent
   support, hence belongs to `K(X)`. Clearing denominators shows `L ⊆ K(X)`.

As an application (Adamczewski–Faverjon, Lemma 2.2), for any invertible rational `q`-Mahler system
`F(X) = A(X) F(X^q)` over `K(X)`, the generated function field `L = K(X)(F)` is regular over
`K(X)`: its relative algebraic closure `algebraicClosure (RatFunc K) L` is `⊥`
(`TauCeti.algebraicClosure_adjoin_mahlerSystem_eq_bot`), and `L ⊗[K(X)] E` is a domain for every
algebraic extension `E / K(X)` (`TauCeti.isDomain_tensorProduct_adjoin_mahlerSystem`).

## Main results

* `TauCeti.isMahlerSeries_isAlgebraic_mem_range_ratFunc`: any `q`-Mahler Laurent series algebraic
  over `K(X)` lies in `K(X)` (Nishioka, Theorem 5.1.7).
* `TauCeti.isMahlerSeries_transcendental_of_not_mem_range_ratFunc`: contrapositive — a nonrational
  `q`-Mahler Laurent series is transcendental over `K(X)`.
* `TauCeti.algebraicClosure_adjoin_mahlerSystem_eq_bot`: `K(X)` is algebraically closed in the
  function field generated by an invertible `q`-Mahler system (AF17, Lemma 2.2).
* `TauCeti.isDomain_tensorProduct_adjoin_mahlerSystem`: geometric integrality of that function
  field.

## References

* K. Nishioka, *Mahler Functions and Transcendence*, Lecture Notes in Math. **1631**, Springer,
  1996, Theorem 5.1.7.
* B. Adamczewski and C. Faverjon, *Méthode de Mahler : relations linéaires, transcendance et
  applications aux nombres automatiques*, Proc. London Math. Soc. (3) **115** (2017), Lemma 2.2,
  p. 10.
-/

public section

open Polynomial HahnSeries LaurentSeries
open scoped LaurentSeries PowerSeries TensorProduct IntermediateField nonZeroDivisors

attribute [local instance 10] RatFunc.liftAlgebra

namespace TauCeti

section RationalFunctionMaps

variable {K : Type*} [Field K]

private theorem ratFunc_X_pow_ne_C (e : ℕ+) :
    ¬∃ c : K, (RatFunc.X : RatFunc K) ^ (e : ℕ) = RatFunc.C c := by
  rintro ⟨c, h⟩
  have h1 := congrArg RatFunc.intDegree h
  rw [← RatFunc.algebraMap_X, ← map_pow, RatFunc.intDegree_polynomial,
    Polynomial.natDegree_X_pow, RatFunc.intDegree_C] at h1
  have : (e : ℕ) ≠ 0 := e.ne_zero
  omega

/-- The `K`-algebra isomorphism `RatFunc K ≃ K(X ^ e)`. -/
private noncomputable def ratFuncExpandEquiv (e : ℕ+) :
    RatFunc K ≃ₐ[K] K⟮(RatFunc.X : RatFunc K) ^ (e : ℕ)⟯ :=
  RatFunc.algEquivOfTranscendental _
    (RatFunc.transcendental_of_ne_C _ (ratFunc_X_pow_ne_C e))

/-- The `K`-algebra endomorphism `r(X) ↦ r(X ^ e)` of `RatFunc K`. -/
private noncomputable def ratFuncExpand (e : ℕ+) : RatFunc K →ₐ[K] RatFunc K :=
  (K⟮(RatFunc.X : RatFunc K) ^ (e : ℕ)⟯.val).comp (ratFuncExpandEquiv e).toAlgHom

private theorem ratFuncExpand_algebraMap (e : ℕ+) (p : K[X]) :
    ratFuncExpand e (algebraMap K[X] (RatFunc K) p) =
      algebraMap K[X] (RatFunc K) (p.comp (Polynomial.X ^ (e : ℕ))) := by
  have h1 : ratFuncExpand e (algebraMap K[X] (RatFunc K) p) =
      Polynomial.aeval ((RatFunc.X : RatFunc K) ^ (e : ℕ)) p := by
    rw [ratFuncExpand, AlgHom.comp_apply, AlgEquiv.coe_toAlgHom,
      ratFuncExpandEquiv, RatFunc.algEquivOfTranscendental_algebraMap]
    exact (Polynomial.aeval_algHom_apply
      K⟮(RatFunc.X : RatFunc K) ^ (e : ℕ)⟯.val _ p).symm
  rw [h1, ← RatFunc.algebraMap_X, ← map_pow, Polynomial.comp_eq_aeval]
  exact Polynomial.aeval_algHom_apply (IsScalarTower.toAlgHom K K[X] (RatFunc K))
    (Polynomial.X ^ (e : ℕ)) p

private theorem expand_algebraMap_ratFunc (e : ℕ+) (r : RatFunc K) :
    LaurentSeries.expand K e (algebraMap (RatFunc K) K⸨X⸩ r) =
      algebraMap (RatFunc K) K⸨X⸩ (ratFuncExpand e r) := by
  rw [← RatFunc.num_div_denom r, map_div₀, map_div₀, map_div₀, map_div₀,
    ← IsScalarTower.algebraMap_apply K[X] (RatFunc K) K⸨X⸩,
    ← IsScalarTower.algebraMap_apply K[X] (RatFunc K) K⸨X⸩,
    expand_algebraMap_polynomial, expand_algebraMap_polynomial,
    ratFuncExpand_algebraMap, ratFuncExpand_algebraMap,
    IsScalarTower.algebraMap_apply K[X] (RatFunc K) K⸨X⸩,
    IsScalarTower.algebraMap_apply K[X] (RatFunc K) K⸨X⸩]

private theorem isAlgebraic_expand (e : ℕ+) {f : K⸨X⸩} (hf : IsAlgebraic (RatFunc K) f) :
    IsAlgebraic (RatFunc K) (LaurentSeries.expand K e f) := by
  obtain ⟨P, hP0, hPeval⟩ := hf
  refine ⟨P.map (ratFuncExpand e).toRingHom, Polynomial.map_ne_zero hP0, ?_⟩
  have hcomm : (algebraMap (RatFunc K) K⸨X⸩).comp (ratFuncExpand e).toRingHom =
      (LaurentSeries.expand K e).toRingHom.comp (algebraMap (RatFunc K) K⸨X⸩) :=
    RingHom.ext fun r ↦ (expand_algebraMap_ratFunc e r).symm
  rw [Polynomial.aeval_def, Polynomial.eval₂_map, hcomm]
  exact (Polynomial.hom_eval₂ P (algebraMap (RatFunc K) K⸨X⸩)
    (LaurentSeries.expand K e).toRingHom f).symm.trans
    (by rw [← Polynomial.aeval_def, hPeval, map_zero])

/-- The `K`-algebra involution `r(X) ↦ r(X⁻¹)` of `RatFunc K`. -/
private noncomputable abbrev invRatFunc : RatFunc K ≃ₐ[K] RatFunc K :=
  RatFunc.branchPointAut K (Equiv.swap 0 2)

private theorem invRatFunc_algebraMap (p : K[X]) :
    invRatFunc (algebraMap K[X] (RatFunc K) p) =
      Polynomial.aeval (RatFunc.X⁻¹ : RatFunc K) p := by
  rw [← RatFunc.aeval_X_left_eq_algebraMap, ← AlgEquiv.coe_toAlgHom,
    ← Polynomial.aeval_algHom_apply, AlgEquiv.coe_toAlgHom, invRatFunc,
    RatFunc.branchPointAut_swap_zero_two_X]

private theorem algebraMap_ratFunc_C (c : K) :
    algebraMap (RatFunc K) K⸨X⸩ (RatFunc.C c) = HahnSeries.C c := by
  rw [← RatFunc.algebraMap_C]
  exact (RatFunc.coe_coe (Polynomial.C c)).symm.trans (by simp)

private theorem algebraMap_ratFunc_X :
    algebraMap (RatFunc K) K⸨X⸩ RatFunc.X = HahnSeries.single (1 : ℤ) (1 : K) :=
  RatFunc.coe_X

private theorem algebraMap_ratFunc_X_zpow (n : ℤ) :
    algebraMap (RatFunc K) K⸨X⸩ ((RatFunc.X : RatFunc K) ^ n) =
      HahnSeries.single n (1 : K) := by
  rw [map_zpow₀, algebraMap_ratFunc_X, ← RatFunc.single_zpow]

/-- If `expand K d` maps every generator in `s` into an intermediate field `L`, then it maps
`IntermediateField.adjoin (RatFunc K) s` into `L`. -/
private theorem expand_mem_of_adjoin {L : IntermediateField (RatFunc K) K⸨X⸩} (d : ℕ+)
    {s : Set K⸨X⸩} (hs : ∀ x ∈ s, LaurentSeries.expand K d x ∈ L)
    {y : K⸨X⸩} (hy : y ∈ IntermediateField.adjoin (RatFunc K) s) :
    LaurentSeries.expand K d y ∈ L := by
  let S : Subfield K⸨X⸩ := L.toSubfield.comap (LaurentSeries.expand K d).toRingHom
  have hle : (IntermediateField.adjoin (RatFunc K) s).toSubfield ≤ S := by
    rw [IntermediateField.adjoin_toSubfield, Subfield.closure_le]
    rintro x (⟨r, rfl⟩ | hx)
    · rw [SetLike.mem_coe, Subfield.mem_comap, IntermediateField.mem_toSubfield]
      have h : (LaurentSeries.expand K d).toRingHom (algebraMap (RatFunc K) K⸨X⸩ r) =
          algebraMap (RatFunc K) K⸨X⸩ (ratFuncExpand d r) := expand_algebraMap_ratFunc d r
      rw [h]
      exact L.algebraMap_mem _
    · exact hs x hx
  exact hle hy

end RationalFunctionMaps

/-! ### Rescaling invariance of `expand`-stable finite extensions of `K(X)` -/

section RescaleInvariance

variable {K : Type*} [Field K]

/-- Every intermediate field `L` of `K⸨X⸩ / K(X)` is naturally a `K`-algebra via
`K → K(X) → L`. -/
private noncomputable abbrev intermediateFieldAlgebraK
    (L : IntermediateField (RatFunc K) K⸨X⸩) : Algebra K L :=
  ((algebraMap (RatFunc K) L).comp (algebraMap K (RatFunc K))).toAlgebra

private theorem intermediateField_isScalarTower (L : IntermediateField (RatFunc K) K⸨X⸩) :
    let _ := intermediateFieldAlgebraK L
    IsScalarTower K (RatFunc K) L := by
  intro _
  exact IsScalarTower.of_algebraMap_eq fun _ ↦ rfl

private theorem coe_algebraMap_intermediateField (L : IntermediateField (RatFunc K) K⸨X⸩)
    (r : RatFunc K) :
    ((algebraMap (RatFunc K) L r : L) : K⸨X⸩) = algebraMap (RatFunc K) K⸨X⸩ r :=
  rfl

/-- The coerced `K`-algebra map on `L` agrees with `algebraMap K K⸨X⸩`. -/
private theorem intermediateFieldAlgebraK_val (L : IntermediateField (RatFunc K) K⸨X⸩) (c : K) :
    let _ := intermediateFieldAlgebraK L
    ((algebraMap K L c : L) : K⸨X⸩) = algebraMap K K⸨X⸩ c := by
  intro _
  have h : ((algebraMap K L c : L) : K⸨X⸩) =
      algebraMap (RatFunc K) K⸨X⸩ (algebraMap K (RatFunc K) c) := rfl
  rw [h, RatFunc.algebraMap_eq_C, algebraMap_ratFunc_C, LaurentSeries.algebraMap_apply]

/-- Restrict `LaurentSeries.expand K e` to a `K`-algebra endomorphism of an `expand`-stable
intermediate field `L` of `K⸨X⸩ / K(X)`. -/
private noncomputable def expandAlgHom (L : IntermediateField (RatFunc K) K⸨X⸩) (e : ℕ+)
    (hexp : ∀ y : L, LaurentSeries.expand K e y.1 ∈ L) :
    let _ := intermediateFieldAlgebraK L
    L →ₐ[K] L :=
  let _ := intermediateFieldAlgebraK L
  { toFun := fun y ↦ ⟨LaurentSeries.expand K e y.1, hexp y⟩
    map_one' := Subtype.ext (map_one _)
    map_mul' := fun x y ↦ Subtype.ext (map_mul _ x.1 y.1)
    map_zero' := Subtype.ext (map_zero _)
    map_add' := fun x y ↦ Subtype.ext (map_add _ x.1 y.1)
    commutes' := fun c ↦ Subtype.ext (by
      simpa only [intermediateFieldAlgebraK_val L c] using
        (LaurentSeries.expand K e).commutes c) }

/-- If `L / K(X)` is finite-dimensional inside `K⸨X⸩` and stable under `expand K e`, then
`[L : expand K e (L)] = e`. -/
private theorem finrank_expand_fieldRange_eq (L : IntermediateField (RatFunc K) K⸨X⸩)
    [FiniteDimensional (RatFunc K) L] (e : ℕ+)
    (hexp : ∀ y : L, LaurentSeries.expand K e y.1 ∈ L) :
    let _ := intermediateFieldAlgebraK L
    Module.finrank (expandAlgHom L e hexp).fieldRange L = (e : ℕ) := by
  intro _
  have _ : IsScalarTower K (RatFunc K) L := intermediateField_isScalarTower L
  let φ : L →ₐ[K] L := expandAlgHom L e hexp
  let ι : RatFunc K →ₐ[K] L := IsScalarTower.toAlgHom K (RatFunc K) L
  let F₀ : IntermediateField K L := (K⟮(RatFunc.X : RatFunc K) ^ (e : ℕ)⟯).map ι
  let F₁ : IntermediateField K L := (⊤ : IntermediateField K (RatFunc K)).map ι
  let E : IntermediateField K L := φ.fieldRange
  -- Compare degrees in the two towers `F₀ ≤ F₁ ≤ L` and `F₀ ≤ E ≤ L`.
  have hF01 : F₀ ≤ F₁ := IntermediateField.map_mono ι le_top
  have hF0E : F₀ = F₁.map φ := by
    apply le_antisymm
    · rw [IntermediateField.map_le_iff_le_comap]
      refine IntermediateField.adjoin_le_iff.mpr ?_
      rintro _ rfl
      refine ⟨ι RatFunc.X, ⟨RatFunc.X, trivial, rfl⟩, Subtype.ext ?_⟩
      have heq : LaurentSeries.expand K e (algebraMap (RatFunc K) K⸨X⸩ RatFunc.X) =
          algebraMap (RatFunc K) K⸨X⸩ ((RatFunc.X : RatFunc K) ^ (e : ℕ)) := by
        rw [expand_algebraMap_ratFunc, ratFuncExpand, AlgHom.comp_apply, AlgEquiv.coe_toAlgHom,
          IntermediateField.coe_val, ratFuncExpandEquiv, RatFunc.algEquivOfTranscendental_X]
      exact heq
    · rintro y ⟨z, ⟨r, -, rfl⟩, rfl⟩
      exact ⟨ratFuncExpand e r, (ratFuncExpandEquiv e r).2,
        Subtype.ext (expand_algebraMap_ratFunc e r).symm⟩
  have hEeq : E = (⊤ : IntermediateField K L).map φ := AlgHom.fieldRange_eq_map φ
  have hF0leE : F₀ ≤ E := by
    rw [hF0E, hEeq]
    exact IntermediateField.map_mono φ le_top
  have h01 : F₀.relfinrank F₁ = (e : ℕ) := by
    rw [IntermediateField.relfinrank_map_map, IntermediateField.relfinrank_top_right,
      TauCeti.RatFunc.finrank_adjoin_X_pow]
  have h1top : Module.finrank F₁ L = Module.finrank (RatFunc K) L := by
    let eF₁ : RatFunc K ≃+* F₁ :=
      ((IntermediateField.topEquiv (F := K) (E := RatFunc K)).symm.trans
        ((⊤ : IntermediateField K (RatFunc K)).equivMap ι)).toRingEquiv
    exact (Algebra.finrank_eq_of_equiv_equiv eF₁ (RingEquiv.refl L)
      (RingHom.ext fun _ ↦ rfl)).symm
  have h0E : F₀.relfinrank E = Module.finrank (RatFunc K) L := by
    rw [hF0E, hEeq, IntermediateField.relfinrank_map_map,
      IntermediateField.relfinrank_top_right, h1top]
  have hmul₁ := IntermediateField.relfinrank_mul_finrank_top hF01
  have hmul₂ := IntermediateField.relfinrank_mul_finrank_top hF0leE
  have hDpos : 0 < Module.finrank (RatFunc K) L := Module.finrank_pos
  have heq : Module.finrank (RatFunc K) L * Module.finrank E L =
      (e : ℕ) * Module.finrank (RatFunc K) L := by
    calc Module.finrank (RatFunc K) L * Module.finrank E L
        = F₀.relfinrank E * Module.finrank E L := by rw [h0E]
      _ = Module.finrank F₀ L := hmul₂
      _ = F₀.relfinrank F₁ * Module.finrank F₁ L := hmul₁.symm
      _ = (e : ℕ) * Module.finrank (RatFunc K) L := by rw [h01, h1top]
  exact Nat.eq_of_mul_eq_mul_left hDpos (by linarith)

/-- If `L / K(X)` is finite-dimensional inside `K⸨X⸩` and stable under `expand K e`, then
rescaling `X ↦ ζ X` by any `e`-th root of unity `ζ ∈ Kˣ` stabilizes `L`. -/
private theorem rescale_mem_of_expand_mem (L : IntermediateField (RatFunc K) K⸨X⸩)
    [FiniteDimensional (RatFunc K) L] (e : ℕ+)
    (hexp : ∀ y : L, LaurentSeries.expand K e y.1 ∈ L)
    {ζ : Kˣ} (hζ : ζ ^ (e : ℕ) = 1) {y : K⸨X⸩} (hy : y ∈ L) :
    TauCeti.LaurentSeries.rescale ζ y ∈ L := by
  let _ := intermediateFieldAlgebraK L
  let φ : L →ₐ[K] L := expandAlgHom L e hexp
  let E : IntermediateField K L := φ.fieldRange
  -- Step 1: `[L : E] = e`, and `{1, X, …, X^(e - 1)}` is `E`-linearly independent, hence a basis.
  have hfin : Module.finrank E L = (e : ℕ) := finrank_expand_fieldRange_eq L e hexp
  have : Module.Free E L := Module.Free.of_divisionRing E L
  have : FiniteDimensional E L := Module.finite_of_finrank_pos (hfin ▸ e.pos)
  let b : Fin e → L := fun r ↦ algebraMap (RatFunc K) L ((RatFunc.X : RatFunc K) ^ (r : ℕ))
  have hbs : ∀ s : Fin e,
      ((b s : L) : K⸨X⸩) = HahnSeries.single (s : ℤ) (1 : K) := fun s ↦ by
    rw [coe_algebraMap_intermediateField, ← zpow_natCast, algebraMap_ratFunc_X_zpow]
  have hli : LinearIndependent E b := by
    rw [Fintype.linearIndependent_iff]
    intro c hc r
    choose g hg using fun s : Fin e ↦ AlgHom.mem_fieldRange.mp (c s).2
    have hval : ∑ s : Fin e, HahnSeries.single (s : ℤ) (1 : K) *
        LaurentSeries.expand K e (g s).1 = 0 := by
      have hcval := congrArg L.val hc
      rw [map_zero, map_sum] at hcval
      rw [← hcval]
      refine Finset.sum_congr rfl fun s _ ↦ ?_
      rw [Algebra.smul_def, map_mul, IntermediateField.coe_val,
        IntermediateField.algebraMap_apply, ← hg s, hbs s, mul_comm]
      rfl
    have hgr : (g r).1 = 0 := by
      simpa [eq_comm] using LaurentSeries.contract_eq_of_sum_eq e (fun s ↦ (g s).1) 0 hval r
    exact Subtype.ext (by rw [← hg r]; exact Subtype.ext (by simp [φ, expandAlgHom, hgr]))
  -- Step 2: Expand `y` in the `E`-basis `b` and apply `rescale ζ` term by term.
  have hy_mem : (⟨y, hy⟩ : L) ∈ Submodule.span E (Set.range b) :=
    (hli.span_eq_top_of_card_eq_finrank (by rw [Fintype.card_fin, hfin])) ▸ trivial
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun E).mp hy_mem
  choose g hg using fun s : Fin e ↦ AlgHom.mem_fieldRange.mp (c s).2
  have hy_eq : y = ∑ s : Fin e, LaurentSeries.expand K e (g s).1 *
      HahnSeries.single (s : ℤ) (1 : K) := by
    have hcv := congrArg L.val hc
    rw [map_sum] at hcv
    have hy_val : y = L.val ⟨y, hy⟩ := rfl
    rw [hy_val, ← hcv]
    refine Finset.sum_congr rfl fun s _ ↦ ?_
    rw [Algebra.smul_def, map_mul, IntermediateField.coe_val,
      IntermediateField.algebraMap_apply, ← hg s, hbs s]
    rfl
  rw [hy_eq, map_sum]
  refine L.sum_mem fun s _ ↦ ?_
  rw [map_mul, TauCeti.LaurentSeries.rescale_expand_of_pow_eq_one hζ,
    TauCeti.LaurentSeries.rescale_single, mul_one]
  have hsingle : HahnSeries.single (s : ℤ) (↑(ζ ^ (s : ℤ)) : K) =
      algebraMap (RatFunc K) K⸨X⸩
        (RatFunc.C (↑(ζ ^ (s : ℤ)) : K) * (RatFunc.X : RatFunc K) ^ (s : ℤ)) := by
    rw [map_mul, algebraMap_ratFunc_C, algebraMap_ratFunc_X_zpow, HahnSeries.C_mul_eq_smul]
    ext k; simp [HahnSeries.coeff_smul, HahnSeries.coeff_single]
  rw [hsingle]
  exact L.mul_mem (hexp (g s)) (L.algebraMap_mem _)

end RescaleInvariance

/-! ### Finite-dimensional integral subspaces and finite support -/

section FiniteSupport

variable {K : Type*} [Field K]

/-- Polynomial degree bound from integrality at infinity: if `X ^ (-M) * p(X)` is a polynomial in
`X⁻¹`, then `p.natDegree ≤ M`. -/
private theorem natDegree_le_of_invRatFunc_eq {p q : K[X]} {M : ℕ}
    (h : (RatFunc.X : RatFunc K)⁻¹ ^ M * algebraMap K[X] (RatFunc K) p =
      invRatFunc (algebraMap K[X] (RatFunc K) q)) : p.natDegree ≤ M := by
  by_cases hp : p = 0
  · simp [hp]
  let d : ℕ := q.natDegree
  let r : K[X] := ∑ j ∈ Finset.range (d + 1), Polynomial.monomial (d - j) (q.coeff j)
  have hqr : invRatFunc (algebraMap K[X] (RatFunc K) q) * (RatFunc.X : RatFunc K) ^ d =
      algebraMap K[X] (RatFunc K) r := by
    rw [invRatFunc_algebraMap, Polynomial.as_sum_range_C_mul_X_pow q, map_sum, Finset.sum_mul,
      map_sum]
    refine Finset.sum_congr rfl fun j hj ↦ ?_
    have hjd : j ≤ d := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
    rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_mul, map_pow, map_pow,
      Polynomial.aeval_C, Polynomial.aeval_X, RatFunc.algebraMap_C, RatFunc.algebraMap_X,
      mul_assoc, inv_pow]
    congr 1
    rw [inv_mul_eq_div, div_eq_iff (pow_ne_zero j RatFunc.X_ne_zero), ← pow_add,
      Nat.sub_add_cancel hjd]
  have hpoly : p * Polynomial.X ^ d = Polynomial.X ^ M * r := by
    apply RatFunc.algebraMap_injective K
    rw [map_mul, map_mul, map_pow, map_pow, RatFunc.algebraMap_X, ← hqr, ← h]
    have hXM : (RatFunc.X : RatFunc K) ^ M ≠ 0 := pow_ne_zero M RatFunc.X_ne_zero
    rw [inv_pow]; field_simp [hXM]
  have hr_deg : r.natDegree ≤ d :=
    Polynomial.natDegree_sum_le_of_forall_le _ _ fun j _ ↦
      (Polynomial.natDegree_monomial_le _).trans (Nat.sub_le d j)
  have hr0 : r ≠ 0 := fun hr0 ↦ by
    rw [hr0, mul_zero] at hpoly
    exact mul_ne_zero hp (pow_ne_zero d Polynomial.X_ne_zero) hpoly
  have hdeg := congrArg Polynomial.natDegree hpoly
  rw [Polynomial.natDegree_mul hp (pow_ne_zero d Polynomial.X_ne_zero),
    Polynomial.natDegree_mul (pow_ne_zero M Polynomial.X_ne_zero) hr0,
    Polynomial.natDegree_X_pow, Polynomial.natDegree_X_pow] at hdeg
  omega

/-- Every polynomial `a` of degree `≤ m` satisfies `X ^ (-m) * a(X) ∈ K[X⁻¹]`. -/
private theorem exists_invRatFunc_eq_X_inv_pow_mul (a : K[X]) {m : ℕ} (hm : a.natDegree ≤ m) :
    ∃ b : K[X], (RatFunc.X : RatFunc K)⁻¹ ^ m * algebraMap K[X] (RatFunc K) a =
      invRatFunc (algebraMap K[X] (RatFunc K) b) := by
  let b : K[X] := ∑ j ∈ Finset.range (a.natDegree + 1), Polynomial.monomial (m - j) (a.coeff j)
  refine ⟨b, ?_⟩
  rw [invRatFunc_algebraMap, map_sum]
  conv_lhs => rw [Polynomial.as_sum_range_C_mul_X_pow a]
  rw [map_sum, Finset.mul_sum]
  refine Finset.sum_congr rfl fun j hj ↦ ?_
  have hjm : j ≤ m := (Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)).trans hm
  rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_mul, map_pow, map_pow,
    Polynomial.aeval_C, Polynomial.aeval_X, RatFunc.algebraMap_C, RatFunc.algebraMap_X,
    mul_left_comm, inv_pow, inv_pow]
  congr 1
  have hXm : (RatFunc.X : RatFunc K) ^ m ≠ 0 := pow_ne_zero m RatFunc.X_ne_zero
  have hXmj : (RatFunc.X : RatFunc K) ^ (m - j) ≠ 0 := pow_ne_zero (m - j) RatFunc.X_ne_zero
  rw [inv_mul_eq_div, div_eq_iff hXm, inv_mul_eq_div, eq_div_iff hXmj, ← pow_add,
    Nat.add_sub_of_le hjm]

/-- In a `RatFunc K`-algebra `L`, the subalgebra `K[X]` inside `L`. -/
private noncomputable def polySubalg (L : Type*) [Field L] [Algebra (RatFunc K) L]
    [Algebra K L] [IsScalarTower K (RatFunc K) L] : Subalgebra K L :=
  (AlgHom.comp (IsScalarTower.toAlgHom K (RatFunc K) L)
    (IsScalarTower.toAlgHom K K[X] (RatFunc K))).range

/-- In a `RatFunc K`-algebra `L`, the subalgebra `K[X⁻¹]` inside `L`. -/
private noncomputable def invPolySubalg (L : Type*) [Field L] [Algebra (RatFunc K) L]
    [Algebra K L] [IsScalarTower K (RatFunc K) L] : Subalgebra K L :=
  (AlgHom.comp (IsScalarTower.toAlgHom K (RatFunc K) L)
    (invRatFunc.toAlgHom.comp (IsScalarTower.toAlgHom K K[X] (RatFunc K)))).range

/-- Lift integrality over the range of an algebra homomorphism `f : R →ₐ[K] L` to integrality
along `f.toRingHom.toAlgebra`. -/
private theorem isIntegral_of_mem_integralClosure_range {R L : Type*} [CommRing R] [Field L]
    [Algebra K R] [Algebra K L] (f : R →ₐ[K] L) {x : L}
    (hx : x ∈ integralClosure f.range L) :
    @IsIntegral R L _ _ f.toRingHom.toAlgebra x := by
  let _ : Algebra R L := f.toRingHom.toAlgebra
  obtain ⟨P, hPmon, hPeval⟩ := hx
  choose c hc using fun i ↦ (P.coeff i).2
  let Q : R[X] := Polynomial.X ^ P.natDegree +
    ∑ i ∈ Finset.range P.natDegree, Polynomial.monomial i (c i)
  refine ⟨Q, Polynomial.monic_X_pow_add (by
    refine lt_of_le_of_lt (Polynomial.degree_sum_le _ _) ?_
    rw [Finset.sup_lt_iff (WithBot.bot_lt_coe _)]
    intro i hi
    exact lt_of_le_of_lt (Polynomial.degree_monomial_le i _)
      (WithBot.coe_lt_coe.mpr (Finset.mem_range.mp hi))), ?_⟩
  have hQ_eval : Polynomial.eval₂ (algebraMap R L) x
      (∑ i ∈ Finset.range P.natDegree, Polynomial.monomial i (c i)) =
    ∑ i ∈ Finset.range P.natDegree,
      Polynomial.eval₂ (algebraMap R L) x (Polynomial.monomial i (c i)) :=
    map_sum (Polynomial.eval₂RingHom (algebraMap R L) x) _ _
  rw [Polynomial.eval₂_add, Polynomial.eval₂_X_pow, hQ_eval,
    ← hPeval, Polynomial.eval₂_eq_sum_range, Finset.sum_range_succ, add_comm]
  congr 1
  · refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [Polynomial.eval₂_monomial]
    exact congrArg (· * x ^ i) (hc i)
  · rw [hPmon.coeff_natDegree, map_one, one_mul]

private theorem mem_integralClosure_polySubalg_iff {L : Type*} [Field L]
    [Algebra (RatFunc K) L] [Algebra K L] [IsScalarTower K (RatFunc K) L] {x : L} :
    x ∈ integralClosure (polySubalg (K := K) L) L ↔
      @IsIntegral K[X] L _ _
        ((algebraMap (RatFunc K) L).comp (algebraMap K[X] (RatFunc K))).toAlgebra x := by
  constructor
  · exact isIntegral_of_mem_integralClosure_range _
  · rintro ⟨P, hPmon, hPeval⟩
    let φ : K[X] →+* polySubalg (K := K) L :=
      (AlgHom.comp (IsScalarTower.toAlgHom K (RatFunc K) L)
        (IsScalarTower.toAlgHom K K[X] (RatFunc K))).rangeRestrict.toRingHom
    refine ⟨P.map φ, hPmon.map φ, ?_⟩
    rw [Polynomial.eval₂_map]
    exact hPeval

/-- Every element of a finite `RatFunc K`-extension `L` can be scaled by a nonzero polynomial
into `integralClosure (polySubalg L) L`. -/
private theorem exists_poly_smul_mem_integralClosure_poly {L : Type*} [Field L]
    [Algebra (RatFunc K) L] [Algebra K L] [IsScalarTower K (RatFunc K) L]
    [FiniteDimensional (RatFunc K) L] (x : L) :
    ∃ a : K[X], a ≠ 0 ∧
      algebraMap K[X] (RatFunc K) a • x ∈ integralClosure (polySubalg (K := K) L) L := by
  let _ : Algebra K[X] L :=
    ((algebraMap (RatFunc K) L).comp (algebraMap K[X] (RatFunc K))).toAlgebra
  have _ : IsScalarTower K[X] (RatFunc K) L := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  obtain ⟨⟨a, ha0⟩, ha⟩ :=
    IsIntegral.exists_multiple_integral_of_isLocalization (Rₘ := RatFunc K) K[X]⁰ x
      (Algebra.IsIntegral.isIntegral (R := RatFunc K) x)
  refine ⟨a, nonZeroDivisors.ne_zero ha0, ?_⟩
  rw [mem_integralClosure_polySubalg_iff]
  have hsmul : algebraMap K[X] (RatFunc K) a • x = a • x := by
    rw [Algebra.smul_def, Algebra.smul_def]; rfl
  rw [hsmul]
  exact ha

/-- Every element integral over `K[X]` becomes integral over `K[X⁻¹]` after multiplying by a
sufficiently negative power `X ^ (-N)`. -/
private theorem exists_X_inv_pow_mul_mem_integralClosure_invPoly {L : Type*} [Field L]
    [Algebra (RatFunc K) L] [Algebra K L] [IsScalarTower K (RatFunc K) L]
    {x : L} (hx : x ∈ integralClosure (polySubalg (K := K) L) L) :
    ∃ N : ℕ, algebraMap (RatFunc K) L ((RatFunc.X : RatFunc K)⁻¹ ^ N) * x ∈
      integralClosure (invPolySubalg (K := K) L) L := by
  rw [mem_integralClosure_polySubalg_iff] at hx
  obtain ⟨P, hPmon, hPeval⟩ := hx
  let N : ℕ := (Finset.range P.natDegree).sup (fun i ↦ (P.coeff i).natDegree)
  refine ⟨N, ?_⟩
  choose b hb using fun i : Fin P.natDegree ↦
    exists_invRatFunc_eq_X_inv_pow_mul (P.coeff i) (m := N * (P.natDegree - i))
      (le_trans (Finset.le_sup (f := fun j ↦ (P.coeff j).natDegree) (Finset.mem_range.mpr i.isLt))
        (Nat.le_mul_of_pos_right N (Nat.sub_pos_of_lt i.isLt)))
  let ψ : K[X] →+* invPolySubalg (K := K) L :=
    (AlgHom.comp (IsScalarTower.toAlgHom K (RatFunc K) L)
      (invRatFunc.toAlgHom.comp
        (IsScalarTower.toAlgHom K K[X] (RatFunc K)))).rangeRestrict.toRingHom
  let Q : (invPolySubalg (K := K) L)[X] := Polynomial.X ^ P.natDegree +
    ∑ i : Fin P.natDegree, Polynomial.monomial i (ψ (b i))
  refine ⟨Q, Polynomial.monic_X_pow_add (by
    refine lt_of_le_of_lt (Polynomial.degree_sum_le _ _) ?_
    rw [Finset.sup_lt_iff (WithBot.bot_lt_coe _)]
    intro i _
    exact lt_of_le_of_lt (Polynomial.degree_monomial_le i _) (WithBot.coe_lt_coe.mpr i.isLt)), ?_⟩
  have hQ_eval : Polynomial.eval₂ (algebraMap (invPolySubalg (K := K) L) L)
      (algebraMap (RatFunc K) L ((RatFunc.X : RatFunc K)⁻¹ ^ N) * x)
      (∑ i : Fin P.natDegree, Polynomial.monomial i (ψ (b i))) =
    ∑ i : Fin P.natDegree, Polynomial.eval₂ (algebraMap (invPolySubalg (K := K) L) L)
      (algebraMap (RatFunc K) L ((RatFunc.X : RatFunc K)⁻¹ ^ N) * x)
      (Polynomial.monomial i (ψ (b i))) :=
    map_sum (Polynomial.eval₂RingHom _ _) _ _
  rw [Polynomial.eval₂_add, Polynomial.eval₂_X_pow, hQ_eval]
  have hPeval' : x ^ P.natDegree + ∑ i : Fin P.natDegree,
      algebraMap (RatFunc K) L (algebraMap K[X] (RatFunc K) (P.coeff i)) *
        x ^ (i : ℕ) = 0 := by
    rw [Polynomial.eval₂_eq_sum_range, Finset.sum_range_succ, hPmon.coeff_natDegree, map_one,
      one_mul, ← Fin.sum_univ_eq_sum_range, add_comm] at hPeval
    exact hPeval
  have hmul : algebraMap (RatFunc K) L ((RatFunc.X : RatFunc K)⁻¹ ^ (N * P.natDegree)) *
      (x ^ P.natDegree + ∑ i : Fin P.natDegree,
        algebraMap (RatFunc K) L (algebraMap K[X] (RatFunc K) (P.coeff i)) *
          x ^ (i : ℕ)) = 0 := by
    rw [hPeval', mul_zero]
  rw [mul_add, Finset.mul_sum] at hmul
  rw [← hmul]
  congr 1
  · rw [mul_pow, ← map_pow, ← pow_mul]
  · refine Finset.sum_congr rfl fun i _ ↦ ?_
    have hψ : algebraMap (invPolySubalg (K := K) L) L (ψ (b i)) =
        algebraMap (RatFunc K) L (invRatFunc (algebraMap K[X] (RatFunc K) (b i))) := rfl
    rw [Polynomial.eval₂_monomial, hψ, ← hb i, mul_pow, ← map_pow, ← pow_mul,
      ← mul_assoc, ← map_mul, ← mul_assoc, ← map_mul]
    congr 2
    rw [mul_right_comm, ← pow_add, ← mul_add, Nat.sub_add_cancel i.isLt.le]

/-- If `x ∈ L` is integral over `K[X]`, then its trace over `K(X)` lies in `K[X]`. -/
private theorem exists_poly_trace_of_mem_integralClosure_poly {L : Type*} [Field L]
    [Algebra (RatFunc K) L] [Algebra K L] [IsScalarTower K (RatFunc K) L]
    [FiniteDimensional (RatFunc K) L] {x : L}
    (hx : x ∈ integralClosure (polySubalg (K := K) L) L) :
    ∃ p : K[X], algebraMap K[X] (RatFunc K) p = Algebra.trace (RatFunc K) L x := by
  let _ : Algebra K[X] L :=
    ((algebraMap (RatFunc K) L).comp (algebraMap K[X] (RatFunc K))).toAlgebra
  have _ : IsScalarTower K[X] (RatFunc K) L := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  rw [mem_integralClosure_polySubalg_iff] at hx
  exact IsIntegrallyClosed.isIntegral_iff.mp (Algebra.isIntegral_trace hx)

/-- Type synonym for `L` with `RatFunc K` acting via the involution `X ↦ X⁻¹`. -/
private def InvLift (L : Type*) := L

/-- If `x ∈ L` is integral over `K[X⁻¹]`, then its trace over `K(X)` lies in `K[X⁻¹]`. -/
private theorem exists_invPoly_trace_of_mem_integralClosure_invPoly {L : Type*} [Field L]
    [Algebra (RatFunc K) L] [Algebra K L] [IsScalarTower K (RatFunc K) L]
    [FiniteDimensional (RatFunc K) L] {x : L}
    (hx : x ∈ integralClosure (invPolySubalg (K := K) L) L) :
    ∃ q : K[X], invRatFunc (algebraMap K[X] (RatFunc K) q) = Algebra.trace (RatFunc K) L x := by
  let _ : Field (InvLift L) := ‹Field L›
  let _ : Algebra (RatFunc K) (InvLift L) :=
    ((algebraMap (RatFunc K) L).comp invRatFunc.toRingHom).toAlgebra
  let _ : Algebra K[X] (InvLift L) :=
    ((algebraMap (RatFunc K) L).comp
      (invRatFunc.toRingHom.comp (algebraMap K[X] (RatFunc K)))).toAlgebra
  have _ : IsScalarTower K[X] (RatFunc K) (InvLift L) :=
    IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  let eL : InvLift L ≃+* L :=
    { toFun := id, invFun := id, left_inv := fun _ ↦ rfl, right_inv := fun _ ↦ rfl,
      map_mul' := fun _ _ ↦ rfl, map_add' := fun _ _ ↦ rfl }
  let x' : InvLift L := x
  have htr : Algebra.trace (RatFunc K) (InvLift L) x' =
      invRatFunc.symm (Algebra.trace (RatFunc K) L x) :=
    Algebra.trace_eq_of_equiv_equiv invRatFunc.toRingEquiv eL (RingHom.ext fun _ ↦ rfl) x'
  have hfin : Module.Finite (RatFunc K) (InvLift L) := by
    let b := Module.finBasis (RatFunc K) L
    let eLin : InvLift L ≃ₗ[RatFunc K] (Fin (Module.finrank (RatFunc K) L) →₀ RatFunc K) :=
      { toFun := fun y ↦ (b.repr (eL y)).mapRange invRatFunc.symm (map_zero _)
        invFun := fun f ↦ eL.symm (b.repr.symm (f.mapRange invRatFunc (map_zero _)))
        left_inv := fun y ↦ by
          apply eL.injective
          have h1 : ((b.repr (eL y)).mapRange invRatFunc.symm (map_zero _)).mapRange
              invRatFunc (map_zero _) = b.repr (eL y) := by
            ext i; simp
          simp [h1]
        right_inv := fun f ↦ by ext i; simp
        map_add' := fun y z ↦ by
          ext i
          simp only [Finsupp.mapRange_apply, Finsupp.add_apply, map_add]
        map_smul' := fun r y ↦ by
          ext i
          have hsmul : eL (r • y) = invRatFunc r • eL y := by
            rw [Algebra.smul_def, Algebra.smul_def]; rfl
          simp only [Finsupp.mapRange_apply, RingHom.id_apply, Finsupp.coe_smul, Pi.smul_apply,
            smul_eq_mul, hsmul, map_smul, map_mul, AlgEquiv.symm_apply_apply] }
    exact Module.Finite.of_basis ⟨eLin⟩
  have hint : IsIntegral K[X] x' := by
    obtain ⟨P, hPmon, hPeval⟩ := isIntegral_of_mem_integralClosure_range _ hx
    exact ⟨P, hPmon, hPeval⟩
  have htr_int : IsIntegral K[X] (Algebra.trace (RatFunc K) (InvLift L) x') :=
    Algebra.isIntegral_trace hint
  obtain ⟨q, hq⟩ := IsIntegrallyClosed.isIntegral_iff.mp htr_int
  exact ⟨q, by rw [hq, htr, AlgEquiv.apply_symm_apply]⟩

/-- Scaled trace-dual basis elements lying in `R₀ ∩ X ^ M • R∞`. -/
private theorem exists_integral_scaled_dualBasis [CharZero K] {L : Type*} [Field L]
    [Algebra (RatFunc K) L] [Algebra K L] [IsScalarTower K (RatFunc K) L]
    [FiniteDimensional (RatFunc K) L] :
    ∃ (e es : Module.Basis (Fin (Module.finrank (RatFunc K) L)) (RatFunc K) L)
      (Δ : K[X]) (M : ℕ),
      Δ ≠ 0 ∧
      (∀ i j, Algebra.trace (RatFunc K) L (e i * es j) = if i = j then 1 else 0) ∧
      (∀ j, algebraMap K[X] (RatFunc K) Δ • es j ∈
        integralClosure (polySubalg (K := K) L) L) ∧
      (∀ j, algebraMap (RatFunc K) L ((RatFunc.X : RatFunc K)⁻¹ ^ M) *
        (algebraMap K[X] (RatFunc K) Δ • es j) ∈
        integralClosure (invPolySubalg (K := K) L) L) := by
  let D := Module.finrank (RatFunc K) L
  let b0 := Module.finBasis (RatFunc K) L
  choose a ha0 _ using fun i : Fin D ↦ exists_poly_smul_mem_integralClosure_poly (K := K) (b0 i)
  let e : Module.Basis (Fin D) (RatFunc K) L :=
    b0.unitsSMul fun i ↦ Units.mk0 (algebraMap K[X] (RatFunc K) (a i))
      (RatFunc.algebraMap_ne_zero (ha0 i))
  have hnd : (Algebra.traceForm (RatFunc K) L).Nondegenerate :=
    traceForm_nondegenerate (RatFunc K) L
  let es : Module.Basis (Fin D) (RatFunc K) L := (Algebra.traceForm (RatFunc K) L).dualBasis hnd e
  choose c hc0 hc using fun j : Fin D ↦ exists_poly_smul_mem_integralClosure_poly (K := K) (es j)
  let Δ : K[X] := ∏ j : Fin D, c j
  have hΔ0 : Δ ≠ 0 := Finset.prod_ne_zero_iff.mpr fun j _ ↦ hc0 j
  have hΔes : ∀ j : Fin D,
      algebraMap K[X] (RatFunc K) Δ • es j ∈ integralClosure (polySubalg (K := K) L) L := by
    intro j
    have hsplit : Δ = (∏ i ∈ Finset.univ.erase j, c i) * c j :=
      (Finset.prod_erase_mul Finset.univ c (Finset.mem_univ j)).symm
    rw [hsplit, map_mul, mul_smul, Algebra.smul_def]
    refine Subalgebra.mul_mem _ ?_ (hc j)
    let q : K[X] := ∏ i ∈ Finset.univ.erase j, c i
    exact algebraMap_mem (integralClosure (polySubalg (K := K) L) L)
      ⟨algebraMap (RatFunc K) L (algebraMap K[X] (RatFunc K) q), ⟨q, rfl⟩⟩
  choose Mj hMj using fun j : Fin D ↦
    exists_X_inv_pow_mul_mem_integralClosure_invPoly (K := K) (hΔes j)
  let M : ℕ := Finset.univ.sup Mj
  refine ⟨e, es, Δ, M, hΔ0, fun i j ↦ ?_, hΔes, fun j ↦ ?_⟩
  · simpa [Algebra.traceForm_apply] using
      (Algebra.traceForm (RatFunc K) L).apply_dualBasis_right hnd
        (Algebra.traceForm_isSymm (RatFunc K)) e i j
  · have hle : Mj j ≤ M := Finset.le_sup (Finset.mem_univ j)
    have hpow : (RatFunc.X : RatFunc K)⁻¹ ^ M =
        (RatFunc.X : RatFunc K)⁻¹ ^ (M - Mj j) * (RatFunc.X : RatFunc K)⁻¹ ^ Mj j := by
      rw [← pow_add, Nat.sub_add_cancel hle]
    rw [hpow, map_mul, mul_assoc]
    refine Subalgebra.mul_mem _ ?_ (hMj j)
    refine algebraMap_mem (integralClosure (invPolySubalg (K := K) L) L)
      ⟨_, ⟨Polynomial.X ^ (M - Mj j), ?_⟩⟩
    have h1 : invRatFunc (algebraMap K[X] (RatFunc K) (Polynomial.X ^ (M - Mj j))) =
        (RatFunc.X : RatFunc K)⁻¹ ^ (M - Mj j) := by
      rw [invRatFunc_algebraMap, Polynomial.aeval_X_pow]
    exact congrArg (algebraMap (RatFunc K) L) h1

/-- Trace pairing of an element of `R₀ ∩ X ^ N • R∞` with a scaled dual basis element is a
polynomial of degree `≤ N + M`. -/
private theorem exists_trace_poly_of_mem_inter {L : Type*} [Field L]
    [Algebra (RatFunc K) L] [Algebra K L] [IsScalarTower K (RatFunc K) L]
    [FiniteDimensional (RatFunc K) L] {N M : ℕ} {y z : L}
    (hy₀ : y ∈ integralClosure (polySubalg (K := K) L) L)
    (hyinf : algebraMap (RatFunc K) L ((RatFunc.X : RatFunc K)⁻¹ ^ N) * y ∈
      integralClosure (invPolySubalg (K := K) L) L)
    (hz₀ : z ∈ integralClosure (polySubalg (K := K) L) L)
    (hzinf : algebraMap (RatFunc K) L ((RatFunc.X : RatFunc K)⁻¹ ^ M) * z ∈
      integralClosure (invPolySubalg (K := K) L) L) :
    ∃ p : K[X], algebraMap K[X] (RatFunc K) p = Algebra.trace (RatFunc K) L (y * z) ∧
      p.natDegree ≤ N + M := by
  obtain ⟨p, hp⟩ := exists_poly_trace_of_mem_integralClosure_poly (K := K)
    (Subalgebra.mul_mem _ hy₀ hz₀)
  have hprod_inf : algebraMap (RatFunc K) L ((RatFunc.X : RatFunc K)⁻¹ ^ (N + M)) * (y * z) ∈
      integralClosure (invPolySubalg (K := K) L) L := by
    have : algebraMap (RatFunc K) L ((RatFunc.X : RatFunc K)⁻¹ ^ (N + M)) * (y * z) =
        (algebraMap (RatFunc K) L ((RatFunc.X : RatFunc K)⁻¹ ^ N) * y) *
        (algebraMap (RatFunc K) L ((RatFunc.X : RatFunc K)⁻¹ ^ M) * z) := by
      rw [pow_add, map_mul]; ring
    rw [this]
    exact Subalgebra.mul_mem _ hyinf hzinf
  obtain ⟨q, hq⟩ := exists_invPoly_trace_of_mem_integralClosure_invPoly (K := K) hprod_inf
  rw [← Algebra.smul_def, map_smul, smul_eq_mul, ← hp] at hq
  exact ⟨p, hp, natDegree_le_of_invRatFunc_eq hq.symm⟩

/-- For a finite extension `L / K(X)` in characteristic zero, the intersection
`R₀ ∩ X ^ N • R∞` is finite-dimensional over `K`. -/
private theorem finiteDimensional_inter_integralClosure [CharZero K] {L : Type*} [Field L]
    [Algebra (RatFunc K) L] [Algebra K L] [IsScalarTower K (RatFunc K) L]
    [FiniteDimensional (RatFunc K) L] (N : ℕ) :
    let R₀ : Submodule K L :=
      ((integralClosure (polySubalg (K := K) L) L).restrictScalars K).toSubmodule
    let Rinf : Submodule K L :=
      ((integralClosure (invPolySubalg (K := K) L) L).restrictScalars K).toSubmodule
    let V : Submodule K L :=
      R₀ ⊓ Rinf.comap
        (LinearMap.mulLeft K (algebraMap (RatFunc K) L ((RatFunc.X : RatFunc K)⁻¹ ^ N)))
    FiniteDimensional K V := by
  intro R₀ Rinf V
  -- Step 1: Map each `y ∈ V` to the vector of polynomial trace pairings with a dual basis.
  obtain ⟨e, es, Δ, M, hΔ0, hdual, hΔes, hMes⟩ :=
    exists_integral_scaled_dualBasis (K := K) (L := L)
  choose P hP_eq hP_deg using fun (y : V) j ↦
    exists_trace_poly_of_mem_inter (K := K) y.2.1 y.2.2 (hΔes j) (hMes j)
  let Ψ : V →ₗ[K] (Fin (Module.finrank (RatFunc K) L) → Polynomial.degreeLT K (N + M + 1)) :=
    { toFun := fun y j ↦ ⟨P y j, Polynomial.mem_degreeLT.mpr (by
        by_cases h0 : P y j = 0
        · simp [h0]
        · rw [Polynomial.degree_eq_natDegree h0]
          exact WithBot.coe_lt_coe.mpr (Nat.lt_succ_of_le (hP_deg y j)))⟩
      map_add' := fun y₁ y₂ ↦ by
        funext j; apply Subtype.ext; apply RatFunc.algebraMap_injective K
        simp only [Pi.add_apply, Submodule.coe_add]
        rw [map_add, hP_eq, hP_eq, hP_eq, Submodule.coe_add, add_mul, map_add]
      map_smul' := fun c y ↦ by
        funext j; apply Subtype.ext; apply RatFunc.algebraMap_injective K
        simp only [RingHom.id_apply, Pi.smul_apply, SetLike.val_smul]
        rw [Polynomial.smul_eq_C_mul, map_mul, RatFunc.algebraMap_C, hP_eq, hP_eq,
          Submodule.coe_smul, smul_mul_assoc, Algebra.smul_def (R := K) (A := L),
          IsScalarTower.algebraMap_apply K (RatFunc K) L, ← Algebra.smul_def, map_smul,
          smul_eq_mul, RatFunc.algebraMap_eq_C] }
  -- Step 2: Nondegeneracy of the trace pairing makes `Ψ` injective into a finite-dim space.
  have hΨ_inj : Function.Injective Ψ := by
    intro y₁ y₂ h
    apply Subtype.ext; rw [← sub_eq_zero]; apply e.repr.injective; ext j
    rw [map_zero, Finsupp.zero_apply]
    have hj : P y₁ j = P y₂ j := congrArg (fun f ↦ (f j).1) h
    have htr : Algebra.trace (RatFunc K) L
        ((y₁.1 - y₂.1) * (algebraMap K[X] (RatFunc K) Δ • es j)) = 0 := by
      rw [sub_mul, map_sub, ← hP_eq y₁ j, ← hP_eq y₂ j, hj, sub_self]
    have htr2 : Algebra.trace (RatFunc K) L
        ((y₁.1 - y₂.1) * (algebraMap K[X] (RatFunc K) Δ • es j)) =
        algebraMap K[X] (RatFunc K) Δ * e.repr (y₁.1 - y₂.1) j := by
      rw [mul_smul_comm, map_smul, smul_eq_mul]
      congr 1
      conv_lhs => rw [← e.sum_repr (y₁.1 - y₂.1)]
      rw [Finset.sum_mul, map_sum, Finset.sum_eq_single j]
      · simp [hdual j j]
      · intro i _ hij; simp [hdual i j, hij]
      · simp
    rw [htr2] at htr
    exact (mul_eq_zero.mp htr).resolve_left (RatFunc.algebraMap_ne_zero hΔ0)
  have : FiniteDimensional K (Polynomial.degreeLT K (N + M + 1)) :=
    (Polynomial.degreeLTEquiv K (N + M + 1)).symm.finiteDimensional
  exact FiniteDimensional.of_injective Ψ hΨ_inj

/-- An endomorphism `ρ : L →ₐ[K] L` stabilizing a subalgebra `A ⊆ L` stabilizes
`integralClosure A L`. -/
private theorem map_mem_integralClosure {L : Type*} [Field L] [Algebra K L]
    (A : Subalgebra K L) (ρ : L →ₐ[K] L) (hA : ∀ a ∈ A, ρ a ∈ A)
    {y : L} (hy : y ∈ integralClosure A L) : ρ y ∈ integralClosure A L := by
  obtain ⟨P, hPmon, hPeval⟩ := hy
  let ρA : A →+* A := (ρ.comp A.val).codRestrict A (fun a ↦ hA a.1 a.2) |>.toRingHom
  refine ⟨P.map ρA, hPmon.map ρA, ?_⟩
  have hcomm : (algebraMap A L).comp ρA = ρ.toRingHom.comp (algebraMap A L) :=
    RingHom.ext fun _ ↦ rfl
  rw [Polynomial.eval₂_map, hcomm]
  exact (Polynomial.hom_eval₂ P (algebraMap A L) ρ.toRingHom y).symm.trans
    (by rw [hPeval, map_zero])

/-- Restrict `TauCeti.LaurentSeries.rescale ζ` to a `K`-algebra endomorphism of a rescale-stable
intermediate field `L` of `K⸨X⸩ / K(X)`. -/
private noncomputable def rescaleAlgHom (L : IntermediateField (RatFunc K) K⸨X⸩) {ζ : Kˣ}
    (hL : ∀ y ∈ L, TauCeti.LaurentSeries.rescale ζ y ∈ L) :
    let _ := intermediateFieldAlgebraK L
    L →ₐ[K] L :=
  let _ := intermediateFieldAlgebraK L
  { toFun := fun z ↦ ⟨TauCeti.LaurentSeries.rescale ζ z.1, hL z.1 z.2⟩
    map_one' := Subtype.ext (map_one _)
    map_mul' := fun a b ↦ Subtype.ext (map_mul _ a.1 b.1)
    map_zero' := Subtype.ext (map_zero _)
    map_add' := fun a b ↦ Subtype.ext (map_add _ a.1 b.1)
    commutes' := fun c ↦ Subtype.ext (by
      simpa only [intermediateFieldAlgebraK_val L c] using
        (TauCeti.LaurentSeries.rescale ζ).commutes c) }

private theorem rescaleAlgHom_X_and_inv (L : IntermediateField (RatFunc K) K⸨X⸩) {ζ : Kˣ}
    (hL : ∀ y ∈ L, TauCeti.LaurentSeries.rescale ζ y ∈ L) :
    let _ := intermediateFieldAlgebraK L
    rescaleAlgHom L hL (algebraMap (RatFunc K) L RatFunc.X) =
      (ζ : K) • algebraMap (RatFunc K) L RatFunc.X ∧
    rescaleAlgHom L hL (algebraMap (RatFunc K) L (RatFunc.X : RatFunc K)⁻¹) =
      ((ζ⁻¹ : Kˣ) : K) • algebraMap (RatFunc K) L (RatFunc.X : RatFunc K)⁻¹ := by
  let _ := intermediateFieldAlgebraK L
  constructor
  · apply Subtype.ext
    dsimp only [rescaleAlgHom, AlgHom.coe_mk, RingHom.coe_mk, MonoidHom.coe_mk, OneHom.coe_mk]
    rw [Algebra.smul_def, IntermediateField.coe_mul, intermediateFieldAlgebraK_val L (ζ : K),
      coe_algebraMap_intermediateField, LaurentSeries.algebraMap_apply, algebraMap_ratFunc_X,
      TauCeti.LaurentSeries.rescale_single, zpow_one, mul_one, HahnSeries.C_mul_eq_smul]
    ext k; simp [HahnSeries.coeff_smul, HahnSeries.coeff_single]
  · apply Subtype.ext
    dsimp only [rescaleAlgHom, AlgHom.coe_mk, RingHom.coe_mk, MonoidHom.coe_mk, OneHom.coe_mk]
    rw [Algebra.smul_def, IntermediateField.coe_mul,
      intermediateFieldAlgebraK_val L ((ζ⁻¹ : Kˣ) : K), coe_algebraMap_intermediateField,
      LaurentSeries.algebraMap_apply, ← zpow_neg_one, algebraMap_ratFunc_X_zpow,
      TauCeti.LaurentSeries.rescale_single, zpow_neg_one, mul_one, HahnSeries.C_mul_eq_smul]
    ext k; simp [HahnSeries.coeff_smul, HahnSeries.coeff_single]

/-- Rescaling by a unit `ζ : Kˣ` stabilizes the integral closures of `K[X]` and `K[X⁻¹]`, and
hence stabilizes `R₀ ∩ X ^ N • R∞`. -/
private theorem rescale_mem_inter_integralClosure (L : IntermediateField (RatFunc K) K⸨X⸩)
    (N : ℕ) {ζ : Kˣ} (hL : ∀ y ∈ L, TauCeti.LaurentSeries.rescale ζ y ∈ L) :
    let _ := intermediateFieldAlgebraK L
    have _ : IsScalarTower K (RatFunc K) L := intermediateField_isScalarTower L
    ∀ {y : L}, y ∈ integralClosure (polySubalg (K := K) L) L →
      algebraMap (RatFunc K) L ((RatFunc.X : RatFunc K)⁻¹ ^ N) * y ∈
        integralClosure (invPolySubalg (K := K) L) L →
      let y' : L := ⟨TauCeti.LaurentSeries.rescale ζ y.1, hL y.1 y.2⟩
      y' ∈ integralClosure (polySubalg (K := K) L) L ∧
        algebraMap (RatFunc K) L ((RatFunc.X : RatFunc K)⁻¹ ^ N) * y' ∈
          integralClosure (invPolySubalg (K := K) L) L := by
  intro _ _ y hy₀ hyinf y'
  let ρ : L →ₐ[K] L := rescaleAlgHom L hL
  let ι : RatFunc K →ₐ[K] L := IsScalarTower.toAlgHom K (RatFunc K) L
  obtain ⟨hρX, hρXinv⟩ := rescaleAlgHom_X_and_inv L hL
  -- Step 1: `ρ` stabilizes both `K[X]` and `K[X⁻¹]` inside `L`.
  have hA0 : ∀ a ∈ polySubalg (K := K) L, ρ a ∈ polySubalg (K := K) L := by
    rintro _ ⟨p, rfl⟩
    refine ⟨p.comp (Polynomial.C (ζ : K) * Polynomial.X), ?_⟩
    have hcomp : ∀ q : K[X], ι (algebraMap K[X] (RatFunc K) q) =
        Polynomial.aeval (ι RatFunc.X) q := fun q ↦ by
      rw [← RatFunc.algebraMap_X]
      have hq : algebraMap K[X] (RatFunc K) q =
          Polynomial.aeval (algebraMap K[X] (RatFunc K) Polynomial.X) q := by simp
      conv_lhs => rw [hq]
      exact (Polynomial.aeval_algHom_apply ι _ q).symm
    have heq : ι (algebraMap K[X] (RatFunc K) (p.comp (Polynomial.C (ζ : K) * Polynomial.X))) =
        ρ (ι (algebraMap K[X] (RatFunc K) p)) := by
      rw [hcomp, hcomp, ← Polynomial.aeval_algHom_apply ρ, Polynomial.aeval_comp,
        Polynomial.aeval_mul, Polynomial.aeval_C, Polynomial.aeval_X, ← Algebra.smul_def]
      exact congrArg (fun z ↦ Polynomial.aeval z p) hρX.symm
    exact heq
  have hAinf : ∀ a ∈ invPolySubalg (K := K) L, ρ a ∈ invPolySubalg (K := K) L := by
    rintro _ ⟨p, rfl⟩
    refine ⟨p.comp (Polynomial.C ((ζ⁻¹ : Kˣ) : K) * Polynomial.X), ?_⟩
    have heq : ι (invRatFunc (algebraMap K[X] (RatFunc K)
        (p.comp (Polynomial.C ((ζ⁻¹ : Kˣ) : K) * Polynomial.X)))) =
        ρ (ι (invRatFunc (algebraMap K[X] (RatFunc K) p))) := by
      rw [invRatFunc_algebraMap, invRatFunc_algebraMap,
        ← Polynomial.aeval_algHom_apply ι, ← Polynomial.aeval_algHom_apply ι,
        ← Polynomial.aeval_algHom_apply ρ, Polynomial.aeval_comp,
        Polynomial.aeval_mul, Polynomial.aeval_C, Polynomial.aeval_X, ← Algebra.smul_def]
      exact congrArg (fun z ↦ Polynomial.aeval z p) hρXinv.symm
    exact heq
  -- Step 2: Transfer integrality along `ρ` and cancel the scalar factor `(ζ⁻¹) ^ N`.
  refine ⟨map_mem_integralClosure _ ρ hA0 hy₀, ?_⟩
  have hinf := map_mem_integralClosure _ ρ hAinf hyinf
  have hmul : ρ (algebraMap (RatFunc K) L ((RatFunc.X : RatFunc K)⁻¹ ^ N) * y) =
      (((ζ⁻¹ : Kˣ) : K) ^ N) •
        (algebraMap (RatFunc K) L ((RatFunc.X : RatFunc K)⁻¹ ^ N) * y') := by
    rw [map_mul, map_pow, map_pow, hρXinv, _root_.smul_pow, smul_mul_assoc]; rfl
  rw [hmul] at hinf
  have hunit : ((ζ : K) ^ N) •
      ((((ζ⁻¹ : Kˣ) : K) ^ N) •
        (algebraMap (RatFunc K) L ((RatFunc.X : RatFunc K)⁻¹ ^ N) * y')) =
      algebraMap (RatFunc K) L ((RatFunc.X : RatFunc K)⁻¹ ^ N) * y' := by
    rw [smul_smul, ← mul_pow, Units.val_inv_eq_inv_val, mul_inv_cancel₀ ζ.ne_zero,
      one_pow, one_smul]
  rw [← hunit]
  exact Subalgebra.smul_mem ((integralClosure (invPolySubalg (K := K) L) L).restrictScalars K)
    hinf ((ζ : K) ^ N)

/-- Powers of a primitive `Q`-th root of unity are injective on any finite set of integers of
diameter `< Q`. -/
private theorem injOn_zpow_of_isPrimitiveRoot {Q : ℕ} {ζ₀ : K}
    (hζ₀ : IsPrimitiveRoot ζ₀ Q) (hQpos : 0 < Q) {T : Finset ℤ} (hTne : T.Nonempty)
    (hspan : (T.max' hTne - T.min' hTne).toNat < Q) :
    let ζ : Kˣ := Units.mk0 ζ₀ (hζ₀.ne_zero hQpos.ne')
    Set.InjOn (fun k : ℤ ↦ ((ζ ^ k : Kˣ) : K)) T := by
  intro ζ k₁ hk₁ k₂ hk₂ heq
  have hunit : ζ ^ (k₂ - k₁) = 1 := by
    rw [zpow_sub, mul_inv_eq_one]
    exact (Units.ext heq).symm
  have hzero_of_le : ∀ {u v : ℤ},
      u ∈ T → v ∈ T → u ≤ v → ζ ^ (v - u) = 1 → u = v := by
    intro u v hu hv hle h1
    have hnonneg : 0 ≤ v - u := sub_nonneg.mpr hle
    have hlt : (v - u).toNat < Q :=
      lt_of_le_of_lt (Int.toNat_le_toNat
        (sub_le_sub (Finset.le_max' T v hv) (Finset.min'_le T u hu))) hspan
    have hpow1 : ζ₀ ^ (v - u).toNat = 1 := by
      have := congrArg Units.val h1
      rwa [← Int.toNat_of_nonneg hnonneg, zpow_natCast, Units.val_pow_eq_pow_val] at this
    have h0 : (v - u).toNat = 0 := Nat.eq_zero_of_dvd_of_lt (hζ₀.dvd_of_pow_eq_one _ hpow1) hlt
    omega
  rcases le_total k₁ k₂ with hle | hle
  · exact hzero_of_le hk₁ hk₂ hle hunit
  · exact (hzero_of_le hk₂ hk₁ hle (by
      rw [← neg_sub k₂ k₁, zpow_neg, hunit, inv_one])).symm

/-- A nontrivial linear relation among `rescale (ζ ^ j) y` (`j = 0, …, s`) yields a nonzero
polynomial of degree `≤ s` vanishing at `ζ ^ k` for every `k ∈ y.support`. -/
private theorem exists_poly_vanish_of_rescale_dep {s : ℕ} {ζ : Kˣ} {y : K⸨X⸩}
    (c : Fin (s + 1) → K)
    (hc0 : ∑ j : Fin (s + 1), c j • TauCeti.LaurentSeries.rescale (ζ ^ (j : ℕ)) y = 0)
    (hcne : ∃ j, c j ≠ 0) :
    ∃ P : K[X], P ≠ 0 ∧ P.natDegree ≤ s ∧
      ∀ k ∈ y.support, P.eval ((ζ ^ k : Kˣ) : K) = 0 := by
  let P : K[X] := ∑ j : Fin (s + 1), Polynomial.monomial j (c j)
  have hP0 : P ≠ 0 := by
    obtain ⟨j₀, hj₀⟩ := hcne
    intro h0
    have := congrArg (fun p : K[X] ↦ p.coeff j₀) h0
    simp only [P, Polynomial.finsetSum_coeff, Polynomial.coeff_monomial_apply,
      Polynomial.coeff_zero] at this
    rw [Finset.sum_eq_single j₀] at this
    · simp [hj₀] at this
    · intro j _ hne; simp [Fin.val_ne_of_ne hne]
    · simp
  refine ⟨P, hP0, Polynomial.natDegree_sum_le_of_forall_le _ _ fun j _ ↦
    (Polynomial.natDegree_monomial_le _).trans (Nat.lt_succ_iff.mp j.isLt), fun k hk ↦ ?_⟩
  have hcval : ∑ j : Fin (s + 1),
      (c j • TauCeti.LaurentSeries.rescale (ζ ^ (j : ℕ)) y).coeff k = 0 := by
    have h := congrArg (fun f : K⸨X⸩ ↦ f.coeff k) hc0
    rwa [HahnSeries.coeff_sum, HahnSeries.coeff_zero] at h
  have hP_eval : P.eval ((ζ ^ k : Kˣ) : K) =
      ∑ j : Fin (s + 1), (Polynomial.monomial (j : ℕ) (c j)).eval ((ζ ^ k : Kˣ) : K) :=
    map_sum (Polynomial.evalRingHom ((ζ ^ k : Kˣ) : K)) _ _
  have heval : P.eval ((ζ ^ k : Kˣ) : K) * y.coeff k = 0 := by
    rw [← hcval, hP_eval, Finset.sum_mul]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [Polynomial.eval_monomial, HahnSeries.coeff_smul, smul_eq_mul,
      TauCeti.LaurentSeries.coeff_rescale, mul_assoc]
    congr 1
    rw [← Units.val_pow_eq_pow_val, ← zpow_natCast, ← zpow_mul, ← zpow_natCast,
      ← zpow_mul, mul_comm (k : ℤ), mul_comm]
  exact (mul_eq_zero.mp heval).resolve_right ((HahnSeries.mem_support y k).mp hk)

/-- If a finite-dimensional `K`-subspace `V ⊆ K⸨X⸩` over an algebraically closed
characteristic-zero field is stabilized by `rescale ζ` for every `(q ^ m)`-th root of unity `ζ`
(`q ≥ 2`), then every element of `V` has finite Laurent support. -/
private theorem finite_support_of_rescale_invariant [CharZero K] [IsAlgClosed K]
    {q : ℕ} (hq : 2 ≤ q) (V : Submodule K K⸨X⸩) [FiniteDimensional K V]
    (hV : ∀ (m : ℕ) (ζ : Kˣ), ζ ^ (q ^ m) = 1 →
      ∀ y ∈ V, TauCeti.LaurentSeries.rescale ζ y ∈ V)
    {y : K⸨X⸩} (hy : y ∈ V) : y.support.Finite := by
  classical
  by_contra hinf
  let s : ℕ := Module.finrank K V
  obtain ⟨T, hTsub, hTcard⟩ := Set.Infinite.exists_subset_card_eq hinf (s + 1)
  have hTne : T.Nonempty := Finset.card_pos.mp (by omega)
  let m : ℕ := (T.max' hTne - T.min' hTne).toNat + 1
  let Q : ℕ := q ^ m
  have hQpos : 0 < Q := pow_pos (by omega) m
  have hspan : (T.max' hTne - T.min' hTne).toNat < Q :=
    lt_of_lt_of_le (Nat.lt_succ_self _)
      (le_trans (Nat.lt_two_pow_self (n := m)).le (Nat.pow_le_pow_left hq m))
  have : NeZero (Q : K) := ⟨Nat.cast_ne_zero.mpr hQpos.ne'⟩
  obtain ⟨ζ₀, hζ₀⟩ := HasEnoughRootsOfUnity.exists_isPrimitiveRoot K Q
  let ζ : Kˣ := Units.mk0 ζ₀ (hζ₀.ne_zero hQpos.ne')
  have hζQ : ζ ^ Q = 1 := Units.ext (by simpa [ζ] using hζ₀.pow_eq_one)
  let v : Fin (s + 1) → V := fun j ↦
    ⟨TauCeti.LaurentSeries.rescale (ζ ^ (j : ℕ)) y,
      hV m (ζ ^ (j : ℕ)) (by rw [← pow_mul, mul_comm, pow_mul, hζQ, one_pow]) y hy⟩
  have hdep : ¬LinearIndependent K v := fun hli ↦ by
    have hle := hli.fintype_card_le_finrank
    simp only [Fintype.card_fin, s] at hle; omega
  obtain ⟨c, hc0, hcne⟩ := Fintype.not_linearIndependent_iff.mp hdep
  have hc0' :
      ∑ j : Fin (s + 1), c j • TauCeti.LaurentSeries.rescale (ζ ^ (j : ℕ)) y = 0 := by
    simpa [v] using congrArg V.subtype hc0
  obtain ⟨P, hP0, hPdeg, hroot⟩ := exists_poly_vanish_of_rescale_dep c hc0' hcne
  have hinj := injOn_zpow_of_isPrimitiveRoot hζ₀ hQpos hTne hspan
  have hsub : T.image (fun k : ℤ ↦ ((ζ ^ k : Kˣ) : K)) ⊆ P.roots.toFinset := fun x hx ↦ by
    obtain ⟨k, hk, rfl⟩ := Finset.mem_image.mp hx
    rw [Multiset.mem_toFinset, Polynomial.mem_roots hP0, Polynomial.IsRoot.def]
    exact hroot k (hTsub hk)
  have hcard1 : (T.image (fun k : ℤ ↦ ((ζ ^ k : Kˣ) : K))).card = s + 1 := by
    rw [Finset.card_image_of_injOn hinj, hTcard]
  have hcard2 := (Finset.card_le_card hsub).trans
    ((Multiset.toFinset_card_le _).trans (Polynomial.card_roots' P))
  omega

/-- Every `expand`-stable finite extension `L / K(X)` inside `K⸨X⸩` (for algebraically closed
`K` of characteristic zero and `q ≥ 2`) is contained in `K(X)`. -/
private theorem subset_range_ratFunc_of_expand_stable [CharZero K] [IsAlgClosed K]
    (L : IntermediateField (RatFunc K) K⸨X⸩) [FiniteDimensional (RatFunc K) L]
    {q : ℕ} (hq : 2 ≤ q)
    (hstab : ∀ y ∈ L, LaurentSeries.expand K (Nat.toPNat q (by omega)) y ∈ L)
    {y : K⸨X⸩} (hy : y ∈ L) : y ∈ Set.range (algebraMap (RatFunc K) K⸨X⸩) := by
  let _ := intermediateFieldAlgebraK L
  have _ : IsScalarTower K (RatFunc K) L := intermediateField_isScalarTower L
  let d : ℕ+ := Nat.toPNat q (by omega)
  -- Step 1: Stability under `expand (q ^ m)` implies rescaling invariance for `q ^ m`-th roots.
  have hstab_pow : ∀ m : ℕ, ∀ z : L, LaurentSeries.expand K (d ^ m) z.1 ∈ L := fun m ↦ by
    induction m with
    | zero => intro z; simp [LaurentSeries.expand_one]
    | succ m ih =>
      intro z
      rw [pow_succ', ← LaurentSeries.expand_expand]
      exact hstab _ (ih z)
  have hrescL : ∀ (m : ℕ) (ζ : Kˣ), ζ ^ (q ^ m) = 1 →
      ∀ z ∈ L, TauCeti.LaurentSeries.rescale ζ z ∈ L := fun m ζ hζ z hz ↦
    rescale_mem_of_expand_mem L (d ^ m) (hstab_pow m) (by rwa [PNat.pow_coe]) hz
  -- Step 2: Scale `y` by a nonzero polynomial into a finite-dimensional rescale-stable `V'`.
  obtain ⟨a, ha0, ha⟩ := exists_poly_smul_mem_integralClosure_poly (K := K) (⟨y, hy⟩ : L)
  obtain ⟨N, hN⟩ := exists_X_inv_pow_mul_mem_integralClosure_invPoly (K := K) ha
  let R₀ : Submodule K L :=
    ((integralClosure (polySubalg (K := K) L) L).restrictScalars K).toSubmodule
  let Rinf : Submodule K L :=
    ((integralClosure (invPolySubalg (K := K) L) L).restrictScalars K).toSubmodule
  let V : Submodule K L :=
    R₀ ⊓ Rinf.comap
      (LinearMap.mulLeft K (algebraMap (RatFunc K) L ((RatFunc.X : RatFunc K)⁻¹ ^ N)))
  have : FiniteDimensional K V := finiteDimensional_inter_integralClosure (K := K) (L := L) N
  let ιK : L →ₗ[K] K⸨X⸩ :=
    { toFun := Subtype.val
      map_add' := fun _ _ ↦ rfl
      map_smul' := fun c z ↦ by
        dsimp only [RingHom.id_apply]
        rw [Algebra.smul_def, IntermediateField.coe_mul, intermediateFieldAlgebraK_val L c,
          LaurentSeries.algebraMap_apply, HahnSeries.C_mul_eq_smul] }
  let V' : Submodule K K⸨X⸩ := V.map ιK
  have : FiniteDimensional K V' := Module.Finite.map V ιK
  have hV' : ∀ (m : ℕ) (ζ : Kˣ), ζ ^ (q ^ m) = 1 →
      ∀ z ∈ V', TauCeti.LaurentSeries.rescale ζ z ∈ V' := by
    rintro m ζ hζ _ ⟨z, hz, rfl⟩
    have hmem := rescale_mem_inter_integralClosure L N (hrescL m ζ hζ) hz.1 hz.2
    exact ⟨⟨TauCeti.LaurentSeries.rescale ζ z.1, hrescL m ζ hζ z.1 z.2⟩,
      ⟨hmem.1, hmem.2⟩, rfl⟩
  -- Step 3: Finite support yields `a • y ∈ K(X)`, hence `y ∈ K(X)`.
  have hfin : (algebraMap K[X] (RatFunc K) a • y).support.Finite :=
    finite_support_of_rescale_invariant hq V' hV'
      ⟨algebraMap K[X] (RatFunc K) a • (⟨y, hy⟩ : L), ⟨ha, hN⟩, rfl⟩
  obtain ⟨r, hr⟩ := mem_range_ratFunc_of_finite_support hfin
  refine ⟨r / algebraMap K[X] (RatFunc K) a, ?_⟩
  rw [map_div₀, hr, Algebra.smul_def, mul_div_cancel_left₀ _
    ((map_ne_zero_iff _ (algebraMap (RatFunc K) K⸨X⸩).injective).mpr
      (RatFunc.algebraMap_ne_zero ha0))]

end FiniteSupport

/-! ### Algebraic Mahler rationality (Nishioka, Theorem 5.1.7) -/

section MainTheorems

variable {K : Type*} [Field K] [CharZero K]

/-- Nishioka's algebraic Mahler rationality theorem over an algebraically closed field of
characteristic zero. -/
private theorem isMahlerSeries_isAlgebraic_mem_range_ratFunc_of_isAlgClosed [IsAlgClosed K]
    {q : ℕ} {f : K⸨X⸩} (hf : IsMahlerSeries q f) (halg : IsAlgebraic (RatFunc K) f) :
    f ∈ Set.range (algebraMap (RatFunc K) K⸨X⸩) := by
  rcases eq_or_ne f 0 with rfl | hf0
  · exact ⟨0, map_zero _⟩
  obtain ⟨hq, n, hn, p, _, hplast, hsum⟩ := hf.exists_first_last_ne_zero hf0
  let d : ℕ+ := Nat.toPNat q (by omega)
  let gens : Set K⸨X⸩ := Set.range fun i : Fin n ↦ LaurentSeries.expand K (d ^ (i : ℕ)) f
  let L : IntermediateField (RatFunc K) K⸨X⸩ := IntermediateField.adjoin (RatFunc K) gens
  have : FiniteDimensional (RatFunc K) L :=
    IntermediateField.finiteDimensional_adjoin (by
      rintro _ ⟨i, rfl⟩
      exact (isAlgebraic_expand (d ^ (i : ℕ)) halg).isIntegral)
  have hstab : ∀ y ∈ L, LaurentSeries.expand K d y ∈ L := by
    refine fun y hy ↦ expand_mem_of_adjoin d ?_ hy
    rintro _ ⟨i, rfl⟩
    rw [LaurentSeries.expand_expand, ← pow_succ']
    by_cases hi : i.1 + 1 < n
    · exact IntermediateField.subset_adjoin _ _ ⟨⟨i.1 + 1, hi⟩, rfl⟩
    · have heq : i.1 + 1 = n := by omega
      rw [heq]
      have hpn : algebraMap (RatFunc K) K⸨X⸩
          (algebraMap K[X] (RatFunc K) (p (Fin.last n))) ≠ 0 :=
        (map_ne_zero_iff _ (algebraMap (RatFunc K) K⸨X⸩).injective).mpr
          (RatFunc.algebraMap_ne_zero hplast)
      rw [Fin.sum_univ_castSucc] at hsum
      have htop : LaurentSeries.expand K (d ^ n) f =
          ∑ j : Fin n, (-(algebraMap K[X] (RatFunc K) (p j.castSucc)) /
            algebraMap K[X] (RatFunc K) (p (Fin.last n))) •
              LaurentSeries.expand K (d ^ (j : ℕ)) f := by
        apply mul_left_cancel₀ hpn
        have h1 : algebraMap (RatFunc K) K⸨X⸩
            (algebraMap K[X] (RatFunc K) (p (Fin.last n))) *
            LaurentSeries.expand K (d ^ n) f =
            -(∑ j : Fin n, algebraMap K[X] K⸨X⸩ (p j.castSucc) *
              LaurentSeries.expand K (d ^ (j : ℕ)) f) := by
          rw [← IsScalarTower.algebraMap_apply K[X] (RatFunc K) K⸨X⸩]
          exact eq_neg_of_add_eq_zero_right hsum
        rw [h1, Finset.mul_sum, ← Finset.sum_neg_distrib]
        refine Finset.sum_congr rfl fun j _ ↦ ?_
        rw [Algebra.smul_def, map_div₀, map_neg, ← mul_assoc, mul_div_cancel₀ _ hpn, neg_mul,
          ← IsScalarTower.algebraMap_apply K[X] (RatFunc K) K⸨X⸩]
      rw [htop]
      exact L.sum_mem fun j _ ↦
        SMulMemClass.smul_mem _ (IntermediateField.subset_adjoin _ _ ⟨j, rfl⟩)
  have hfL : f ∈ L := by
    have : LaurentSeries.expand K (d ^ 0) f ∈ L :=
      IntermediateField.subset_adjoin _ _ ⟨⟨0, hn⟩, rfl⟩
    simpa [LaurentSeries.expand_one] using this
  exact subset_range_ratFunc_of_expand_stable L hq hstab hfL

/-- **Algebraic Mahler rationality** (Nishioka, Theorem 5.1.7): over any field `K` of
characteristic zero, a `q`-Mahler Laurent series `f : K⸨X⸩` that is algebraic over `K(X)` is
already a rational function in `K(X)`. -/
theorem isMahlerSeries_isAlgebraic_mem_range_ratFunc {q : ℕ} {f : K⸨X⸩}
    (hf : IsMahlerSeries q f) (halg : IsAlgebraic (RatFunc K) f) :
    f ∈ Set.range (algebraMap (RatFunc K) K⸨X⸩) := by
  let σ : K →+* AlgebraicClosure K := algebraMap K (AlgebraicClosure K)
  rw [← mem_range_ratFunc_mapRingHom_iff σ]
  exact isMahlerSeries_isAlgebraic_mem_range_ratFunc_of_isAlgClosed
    ((isMahlerSeries_mapRingHom_iff σ).mpr hf) ((isAlgebraic_mapRingHom_iff σ).mpr halg)

/-- Contrapositive of algebraic Mahler rationality: a `q`-Mahler Laurent series over a field `K` of
characteristic zero that does not lie in `K(X)` is transcendental over `K(X)`. -/
theorem isMahlerSeries_transcendental_of_not_mem_range_ratFunc {q : ℕ} {f : K⸨X⸩}
    (hf : IsMahlerSeries q f) (hnot : f ∉ Set.range (algebraMap (RatFunc K) K⸨X⸩)) :
    Transcendental (RatFunc K) f := fun halg ↦
  hnot (isMahlerSeries_isAlgebraic_mem_range_ratFunc hf halg)

/-! ### Regularity of Mahler function fields (AF17, Lemma 2.2) -/

omit [CharZero K] in
/-- The function field `K(X)(F)` generated by an invertible rational `q`-Mahler system
`F(X) = A(X) F(X ^ q)` is stable under `LaurentSeries.expand K q`. -/
private theorem expand_mem_adjoin_mahlerSystem {ι : Type*} [Fintype ι] [DecidableEq ι]
    {q : ℕ} (hq : 2 ≤ q) {A : Matrix ι ι (RatFunc K)} (hdet : IsUnit A.det)
    {F : ι → K⸨X⸩}
    (hsys : F = (A.map (algebraMap (RatFunc K) K⸨X⸩)).mulVec
      (fun i ↦ LaurentSeries.expand K (Nat.toPNat q (by omega)) (F i)))
    {y : K⸨X⸩} (hy : y ∈ IntermediateField.adjoin (RatFunc K) (Set.range F)) :
    LaurentSeries.expand K (Nat.toPNat q (by omega)) y ∈
      IntermediateField.adjoin (RatFunc K) (Set.range F) := by
  let d : ℕ+ := Nat.toPNat q (by omega)
  let L : IntermediateField (RatFunc K) K⸨X⸩ :=
    IntermediateField.adjoin (RatFunc K) (Set.range F)
  have hinv : (fun i ↦ LaurentSeries.expand K d (F i)) =
      (A⁻¹.map (algebraMap (RatFunc K) K⸨X⸩)).mulVec F := by
    calc (fun i ↦ LaurentSeries.expand K d (F i))
        = ((A⁻¹ * A).map (algebraMap (RatFunc K) K⸨X⸩)).mulVec
            (fun i ↦ LaurentSeries.expand K d (F i)) := by
          rw [Matrix.nonsing_inv_mul A hdet, Matrix.map_one _ (map_zero _) (map_one _),
            Matrix.one_mulVec]
      _ = (A⁻¹.map (algebraMap (RatFunc K) K⸨X⸩)).mulVec F := by
          rw [Matrix.map_mul, ← Matrix.mulVec_mulVec, ← hsys]
  refine expand_mem_of_adjoin d ?_ hy
  rintro _ ⟨i, rfl⟩
  have hi := congrFun hinv i
  simp only [Matrix.mulVec, dotProduct, Matrix.map_apply] at hi
  rw [hi]
  exact L.sum_mem fun j _ ↦
    L.mul_mem (L.algebraMap_mem _) (IntermediateField.subset_adjoin _ _ ⟨j, rfl⟩)

/-- **Regularity of Mahler function fields** (Adamczewski–Faverjon, Lemma 2.2): if
`F : ι → K⸨X⸩` is a finite tuple of Laurent series over a characteristic-zero field solving
an invertible rational `q`-Mahler system `F(X) = A(X) F(X ^ q)` with `q ≥ 2`, then `K(X)` is
algebraically closed in the generated function field `K(X)(F)`. -/
theorem algebraicClosure_adjoin_mahlerSystem_eq_bot {ι : Type*} [Fintype ι] [DecidableEq ι]
    {q : ℕ} (hq : 2 ≤ q) {A : Matrix ι ι (RatFunc K)} (hdet : IsUnit A.det)
    {F : ι → K⸨X⸩}
    (hsys : F = (A.map (algebraMap (RatFunc K) K⸨X⸩)).mulVec
      (fun i ↦ LaurentSeries.expand K (Nat.toPNat q (by omega)) (F i))) :
    algebraicClosure (RatFunc K) (IntermediateField.adjoin (RatFunc K) (Set.range F)) = ⊥ := by
  let d : ℕ+ := Nat.toPNat q (by omega)
  let L : IntermediateField (RatFunc K) K⸨X⸩ :=
    IntermediateField.adjoin (RatFunc K) (Set.range F)
  have : Finite (Set.range F) := (Set.finite_range F).to_subtype
  let L' : IntermediateField (RatFunc K) L := algebraicClosure (RatFunc K) L
  have : FiniteDimensional (RatFunc K) L' := TauCeti.finiteDimensional_algebraicClosure
  have hstabL : ∀ y ∈ L, LaurentSeries.expand K d y ∈ L := fun _ hy ↦
    expand_mem_adjoin_mahlerSystem hq hdet hsys hy
  let V : Submodule (RatFunc K) K⸨X⸩ := (L'.map L.val).toSubalgebra.toSubmodule
  have hVfin : FiniteDimensional (RatFunc K) V :=
    (L'.equivMap L.val).toLinearEquiv.finiteDimensional
  have hstabV : ∀ y ∈ V, LaurentSeries.expand K d y ∈ V := by
    rintro _ ⟨⟨y, hyL⟩, hyalg, rfl⟩
    refine ⟨⟨LaurentSeries.expand K d y, hstabL y hyL⟩, ?_, rfl⟩
    have halg : IsAlgebraic (RatFunc K) y :=
      (isAlgebraic_algHom_iff L.val L.val.injective).mpr (mem_algebraicClosure_iff.mp hyalg)
    exact mem_algebraicClosure_iff.mpr
      ((isAlgebraic_algHom_iff L.val L.val.injective).mp (isAlgebraic_expand d halg))
  rw [eq_bot_iff]
  intro x hx
  have hmah : IsMahlerSeries q x.1 := by
    rw [isMahlerSeries_iff_exists_finiteDimensional]
    refine ⟨hq, V, hVfin, fun k ↦ ?_⟩
    induction k with
    | zero =>
      have hxV : x.1 ∈ V := ⟨x, hx, rfl⟩
      simpa [LaurentSeries.expand_one] using hxV
    | succ k ih =>
      rw [pow_succ', ← LaurentSeries.expand_expand]
      exact hstabV _ ih
  have halg : IsAlgebraic (RatFunc K) x.1 :=
    (isAlgebraic_algHom_iff L.val L.val.injective).mpr (mem_algebraicClosure_iff.mp hx)
  obtain ⟨r, hr⟩ := isMahlerSeries_isAlgebraic_mem_range_ratFunc hmah halg
  exact IntermediateField.mem_bot.mpr ⟨r, Subtype.ext hr⟩

/-- **Geometric integrality of Mahler function fields**: if `F : ι → K⸨X⸩` solves an
invertible rational `q`-Mahler system over a characteristic-zero field `K`, then
`K(X)(F) ⊗[K(X)] E` is an integral domain for every algebraic extension `E / K(X)`. -/
theorem isDomain_tensorProduct_adjoin_mahlerSystem {ι : Type*} [Fintype ι] [DecidableEq ι]
    {q : ℕ} (hq : 2 ≤ q) {A : Matrix ι ι (RatFunc K)} (hdet : IsUnit A.det)
    {F : ι → K⸨X⸩}
    (hsys : F = (A.map (algebraMap (RatFunc K) K⸨X⸩)).mulVec
      (fun i ↦ LaurentSeries.expand K (Nat.toPNat q (by omega)) (F i)))
    (E : Type*) [Field E] [Algebra (RatFunc K) E] [Algebra.IsAlgebraic (RatFunc K) E] :
    IsDomain (IntermediateField.adjoin (RatFunc K) (Set.range F) ⊗[RatFunc K] E) := by
  have hex : IsIntegrallyClosedIn (RatFunc K)
      (IntermediateField.adjoin (RatFunc K) (Set.range F)) :=
    TauCeti.algebraicClosure_eq_bot_iff_isIntegrallyClosedIn.mp
      (algebraicClosure_adjoin_mahlerSystem_eq_bot hq hdet hsys)
  exact TauCeti.isDomain_tensorProduct_of_isIntegrallyClosedIn hex E

end MainTheorems

end TauCeti
