/-!
# Ore's conditions for wild exponents of totally ramified extensions

Let `K` be a nonarchimedean local field and `n ≥ 1`. A totally ramified subextension `L ∈ σ_K(n)`
of a separable closure of `K` has wild exponent `c(L) = d(L) - n + 1`, where `d(L)` is the
discriminant exponent of `L / K`. Writing `j = a n + b` with `0 ≤ b < n` and `v_K(h)` for the
additive valuation of `(h : 𝒪[K])` in `ℕ∞` (so `v_K(h) = ⊤` when `(h : K) = 0`), **Ore's
conditions** assert that either

* `b = 0` and `a = v_K(n)`, or
* `0 < b`, `v_K(b) ≤ a`, and `a + 1 ≤ v_K(n)`.

This file defines Ore's admissibility predicate `TauCeti.IsOreAdmissible`, the coefficient depths
`TauCeti.oreCoefficientDepth` that cut out the Eisenstein polynomials realizing a given wild
exponent, and proves **Ore's realizability theorem** (`TauCeti.ore_realizability`): a nonnegative
integer `j` occurs as the wild exponent of some `L ∈ σ_K(n)` if and only if `IsOreAdmissible K n j`
holds, in both mixed and equal characteristic.

For a monic Eisenstein polynomial `f` of degree `n > 0` over `𝒪[K]`, the derivative infimum
`⨅ i : Fin n, n • v_K(f_{i+1} · (i + 1)) + i` gives the discriminant exponent of any extension
generated by a root of `f`. Adding `1` expresses this infimum as
`⨅ i : Fin n, n * (v_K(f_{i+1}) + v_K(i + 1)) + (i + 1)`, whose terms are pairwise incongruent
modulo `n`. Hence the infimum equals `n - 1 + j` if and only if `IsOreAdmissible K n j` holds and
the coefficients of `f` satisfy the exact valuation inequalities given by `oreCoefficientDepth`
(`TauCeti.iInf_eisenstein_derivative_eq_iff`). The forward direction of Ore's theorem follows
immediately; the converse constructs the explicit witness `X ^ n + ϖ` (when `b = 0`) or
`X ^ n + ϖ ^ m X ^ b + ϖ` (when `0 < b`, with `m = oreCoefficientDepth K n j b`).

## Main definitions

* `TauCeti.IsOreAdmissible K n j`: Ore's conditions on the degree `n` and wild exponent `j`.
* `TauCeti.oreCoefficientDepth K n j h`: the minimal valuation
  `max 1 (j / n + 1 + [h < j % n] - v_K(h))` forced on the degree-`h` coefficient of an Eisenstein
  polynomial of degree `n` and wild exponent `j`.

## Main results

* `TauCeti.iInf_eisenstein_derivative_eq_iff`: the Eisenstein derivative infimum equals `n - 1 + j`
  exactly when `IsOreAdmissible K n j` holds and the polynomial coefficients satisfy the depth
  conditions from `oreCoefficientDepth`.
* `TauCeti.ore_realizability`: `j` is the wild exponent of a member of `σ_K(n)` if and only if
  `IsOreAdmissible K n j`.

## References

* Ø. Ore, *Bemerkungen zur Theorie der Differente*, Math. Z. **25** (1926), 1–8.
* M. Krasner, *Nombre des extensions d'un degré donné d'un corps `𝔭`-adique*, in *Les tendances
  géométriques en algèbre et théorie des nombres*, Colloq. Internat. CNRS **143** (1966), 143–169.
* S. Pauli and X.-F. Roblot, *On the computation of all extensions of a `p`-adic field of a given
  degree*, Math. Comp. **70** (2001), 1641–1659, Proposition 3.1.
-/

public section
noncomputable section

open ValuativeRel Polynomial IsDiscreteValuationRing TauCeti.Polynomial
open scoped IntermediateField

namespace TauCeti

variable {K : Type*} [Field K] [ValuativeRel K]

section DiscreteValuation

variable [IsDiscreteValuationRing 𝒪[K]]

variable (K) in
/-- **Ore's admissibility conditions** on a degree `n` and wild exponent `j`. Writing `j = a n + b`
with `0 ≤ b < n` and `v_K(h) = addVal 𝒪[K] (h : 𝒪[K]) ∈ ℕ∞`, admissibility requires `0 < n` and
either `b = 0` with `a = v_K(n)`, or `0 < b` with `v_K(b) ≤ a` and `a + 1 ≤ v_K(n)`. -/
def IsOreAdmissible (n j : ℕ) : Prop :=
  0 < n ∧
    ((j % n = 0 ∧ ((j / n : ℕ) : ℕ∞) = addVal 𝒪[K] (n : 𝒪[K])) ∨
      (0 < j % n ∧ addVal 𝒪[K] ((j % n : ℕ) : 𝒪[K]) ≤ (j / n : ℕ) ∧
        ((j / n : ℕ) : ℕ∞) + 1 ≤ addVal 𝒪[K] (n : 𝒪[K])))

/-- Unfolding `TauCeti.IsOreAdmissible`. -/
theorem isOreAdmissible_iff {n j : ℕ} :
    IsOreAdmissible K n j ↔
      0 < n ∧
        ((j % n = 0 ∧ ((j / n : ℕ) : ℕ∞) = addVal 𝒪[K] (n : 𝒪[K])) ∨
          (0 < j % n ∧ addVal 𝒪[K] ((j % n : ℕ) : 𝒪[K]) ≤ (j / n : ℕ) ∧
            ((j / n : ℕ) : ℕ∞) + 1 ≤ addVal 𝒪[K] (n : 𝒪[K]))) := by
  rw [IsOreAdmissible]

/-- An Ore-admissible degree is positive. -/
theorem IsOreAdmissible.pos {n j : ℕ} (h : IsOreAdmissible K n j) : 0 < n :=
  h.1

/-- Degree zero has no Ore-admissible wild exponent. -/
@[simp]
theorem isOreAdmissible_zero_left (j : ℕ) : ¬ IsOreAdmissible K 0 j :=
  fun h ↦ Nat.lt_irrefl 0 h.1

/-- At degree `1`, only wild exponent `0` is Ore-admissible. -/
@[simp]
theorem isOreAdmissible_one_left (j : ℕ) : IsOreAdmissible K 1 j ↔ j = 0 := by
  simp [isOreAdmissible_iff, Nat.mod_one]

/-- Ore's condition when `n ∣ j` (`j % n = 0`): for `0 < n`, admissibility holds exactly when
`j / n = v_K(n)`. -/
theorem isOreAdmissible_iff_of_mod_eq_zero {n j : ℕ} (hn : 0 < n) (hb : j % n = 0) :
    IsOreAdmissible K n j ↔ ((j / n : ℕ) : ℕ∞) = addVal 𝒪[K] (n : 𝒪[K]) := by
  simp [isOreAdmissible_iff, hn, hb]

/-- Ore's condition when `n ∤ j` (`0 < j % n`): for `0 < n`, admissibility holds exactly when
`v_K(j % n) ≤ j / n` and `j / n + 1 ≤ v_K(n)`. -/
theorem isOreAdmissible_iff_of_mod_pos {n j : ℕ} (hn : 0 < n) (hb : 0 < j % n) :
    IsOreAdmissible K n j ↔
      addVal 𝒪[K] ((j % n : ℕ) : 𝒪[K]) ≤ (j / n : ℕ) ∧
        ((j / n : ℕ) : ℕ∞) + 1 ≤ addVal 𝒪[K] (n : 𝒪[K]) := by
  simp [isOreAdmissible_iff, hn, hb, hb.ne']

/-- When `n` is a unit of `𝒪[K]` (the tame case), `j` is Ore-admissible for `0 < n` exactly when
`j = 0`. -/
theorem isOreAdmissible_iff_eq_zero_of_isUnit {n j : ℕ} (hn : 0 < n) (hu : IsUnit (n : 𝒪[K])) :
    IsOreAdmissible K n j ↔ j = 0 := by
  have hv : addVal 𝒪[K] (n : 𝒪[K]) = 0 := addVal_eq_zero_iff.mpr hu
  rw [isOreAdmissible_iff, hv]
  refine ⟨fun ⟨_, h⟩ ↦ ?_, fun hj ↦ ⟨hn, Or.inl ⟨by simp [hj], by simp [hj]⟩⟩⟩
  rcases h with ⟨hb, ha⟩ | ⟨_, _, ha⟩
  · have ha0 : j / n = 0 := by exact_mod_cast ha
    have hdiv : n * (j / n) + j % n = j := Nat.div_add_mod j n
    rw [ha0, hb] at hdiv
    omega
  · norm_cast at ha

/-- When `0 < n` and `(n : K) = 0` (positive characteristic `p` with `p ∣ n`), `j` is Ore-admissible
exactly when `ringChar K ∤ j`. -/
theorem isOreAdmissible_iff_not_dvd_of_natCast_eq_zero {n j : ℕ} (hn : 0 < n) (hnK : (n : K) = 0) :
    IsOreAdmissible K n j ↔ ¬ ringChar K ∣ j := by
  have hchar0 : ringChar K ≠ 0 := by
    intro h0
    have : CharP K 0 := h0 ▸ ringChar.charP K
    have : CharZero K := CharP.charP_to_charZero K
    exact hn.ne' (Nat.cast_eq_zero.mp hnK)
  have hp : (ringChar K).Prime := CharP.char_prime_of_ne_zero K hchar0
  have hpn : ringChar K ∣ n := (ringChar.spec K n).mp hnK
  have hvn : addVal 𝒪[K] (n : 𝒪[K]) = ⊤ :=
    addVal_eq_top_iff.mpr (Subtype.ext (by simpa using hnK))
  have hmod_dvd : ringChar K ∣ j % n ↔ ringChar K ∣ j := by
    conv_rhs => rw [← Nat.div_add_mod j n]
    exact (Nat.dvd_add_right (dvd_mul_of_dvd_left hpn _)).symm
  rw [isOreAdmissible_iff, hvn]
  simp only [hn, true_and, ENat.natCast_ne_top, and_false, false_or, le_top, and_true]
  constructor
  · rintro ⟨_, hle⟩ hdj
    have hdb : ringChar K ∣ j % n := hmod_dvd.mpr hdj
    have hb0 : ((j % n : ℕ) : 𝒪[K]) = 0 :=
      Subtype.ext (by simpa using (ringChar.spec K (j % n)).mpr hdb)
    rw [hb0, addVal_zero, top_le_iff] at hle
    exact ENat.natCast_ne_top _ hle
  · intro hnd
    have hndb : ¬ ringChar K ∣ j % n := mt hmod_dvd.mp hnd
    have hbpos : 0 < j % n := Nat.pos_of_ne_zero fun h0 ↦ hndb (h0 ▸ dvd_zero _)
    have hcop : IsCoprime ((ringChar K : ℕ) : 𝒪[K]) ((j % n : ℕ) : 𝒪[K]) := by
      have h := (Nat.isCoprime_iff_coprime.mpr (hp.coprime_iff_not_dvd.mpr hndb)).map
        (Int.castRingHom 𝒪[K])
      simpa only [map_natCast] using h
    have hp0 : ((ringChar K : ℕ) : 𝒪[K]) = 0 :=
      Subtype.ext (by push_cast; exact ringChar.Nat.cast_ringChar (R := K))
    rw [hp0] at hcop
    have hvb : addVal 𝒪[K] ((j % n : ℕ) : 𝒪[K]) = 0 :=
      addVal_eq_zero_iff.mpr (isCoprime_zero_left.mp hcop)
    exact ⟨hbpos, by simp [hvb]⟩

variable (K) in
/-- The lower bound on the additive valuation of the degree-`h` coefficient of a monic Eisenstein
polynomial of degree `n` realizing wild exponent `j`:
`max 1 (j / n + 1 + [h < j % n] - v_K(h))`, taking the value `1` when `(h : K) = 0`. -/
def oreCoefficientDepth (n j h : ℕ) : ℕ :=
  max 1 ((((j / n + 1 + if h < j % n then 1 else 0 : ℕ) : ℕ∞) -
    addVal 𝒪[K] (h : 𝒪[K])).toNat)

/-- Unfolding `TauCeti.oreCoefficientDepth`. -/
theorem oreCoefficientDepth_def (n j h : ℕ) :
    oreCoefficientDepth K n j h =
      max 1 ((((j / n + 1 + if h < j % n then 1 else 0 : ℕ) : ℕ∞) -
        addVal 𝒪[K] (h : 𝒪[K])).toNat) := by
  rw [oreCoefficientDepth]

/-- Every coefficient depth is at least `1`. -/
@[simp]
theorem one_le_oreCoefficientDepth (n j h : ℕ) : 1 ≤ oreCoefficientDepth K n j h := by
  rw [oreCoefficientDepth_def]
  exact le_max_left _ _

/-- Every coefficient depth is positive. -/
theorem oreCoefficientDepth_pos (n j h : ℕ) : 0 < oreCoefficientDepth K n j h :=
  one_le_oreCoefficientDepth n j h

/-- When `h` vanishes in `K`, the degree-`h` coefficient contributes no derivative term and its
depth is `1`. -/
theorem oreCoefficientDepth_eq_one_of_natCast_eq_zero {n j h : ℕ} (hh : (h : K) = 0) :
    oreCoefficientDepth K n j h = 1 := by
  have h0 : (h : 𝒪[K]) = 0 := Subtype.ext (by simpa using hh)
  simp [oreCoefficientDepth_def, h0]

/-- When `addVal 𝒪[K] (h : 𝒪[K]) = v`, the coefficient depth evaluates in `ℕ` as
`max 1 (j / n + 1 + [h < j % n] - v)`. -/
theorem oreCoefficientDepth_eq_of_addVal_eq {n j h v : ℕ}
    (hv : addVal 𝒪[K] (h : 𝒪[K]) = (v : ℕ∞)) :
    oreCoefficientDepth K n j h =
      max 1 (j / n + 1 + (if h < j % n then 1 else 0) - v) := by
  rw [oreCoefficientDepth_def, hv, ← ENat.natCast_sub, ENat.toNat_natCast]

/-- Upper bound on the coefficient depth: dropping `- v_K(h)` leaves `j / n + 1 + [h < j % n]`. -/
theorem oreCoefficientDepth_le (n j h : ℕ) :
    oreCoefficientDepth K n j h ≤ j / n + 1 + if h < j % n then 1 else 0 := by
  have h1 : 1 ≤ j / n + 1 + if h < j % n then 1 else 0 :=
    le_trans (Nat.le_add_left 1 (j / n)) (Nat.le_add_right _ _)
  cases hv : addVal 𝒪[K] (h : 𝒪[K]) with
  | top =>
    rw [oreCoefficientDepth_def, hv]
    simpa using h1
  | coe v =>
    rw [oreCoefficientDepth_eq_of_addVal_eq hv]
    exact max_le h1 (Nat.sub_le _ _)

/-- At the remainder index `b = j % n > 0` of an Ore-admissible pair `(n, j)`, the depth satisfies
`v_K(b) + oreCoefficientDepth K n j b = j / n + 1`. -/
theorem addVal_add_oreCoefficientDepth_mod_eq {n j : ℕ} (hadm : IsOreAdmissible K n j)
    (hb : 0 < j % n) :
    addVal 𝒪[K] ((j % n : ℕ) : 𝒪[K]) + (oreCoefficientDepth K n j (j % n) : ℕ∞) =
      ((j / n + 1 : ℕ) : ℕ∞) := by
  have hle : addVal 𝒪[K] ((j % n : ℕ) : 𝒪[K]) ≤ (j / n : ℕ) :=
    ((isOreAdmissible_iff_of_mod_pos hadm.pos hb).mp hadm).1
  cases hv : addVal 𝒪[K] ((j % n : ℕ) : 𝒪[K]) with
  | top =>
    rw [hv, top_le_iff] at hle
    exact absurd hle (ENat.natCast_ne_top _)
  | coe v =>
    rw [oreCoefficientDepth_eq_of_addVal_eq hv]
    rw [hv] at hle
    have hvn : v ≤ j / n := by exact_mod_cast hle
    norm_cast
    simp only [lt_self_iff_false, ↓reduceIte, add_zero]
    omega

/-- Intermediate upper bound on the sum of coefficient depths over `1 ≤ h < n`. -/
private theorem sum_oreCoefficientDepth_le_aux {n : ℕ} (hn : 0 < n) (j : ℕ) :
    ∑ h ∈ Finset.Ico 1 n, oreCoefficientDepth K n j h ≤
      (n - 1) * (j / n + 1) + (j % n - 1) := by
  have hbound : ∑ h ∈ Finset.Ico 1 n, oreCoefficientDepth K n j h ≤
      ∑ h ∈ Finset.Ico 1 n, (j / n + 1 + if h < j % n then 1 else 0) :=
    Finset.sum_le_sum fun h _ ↦ oreCoefficientDepth_le n j h
  have hfilt : Finset.filter (fun h ↦ h < j % n) (Finset.Ico 1 n) = Finset.Ico 1 (j % n) := by
    ext h
    have hlt : j % n < n := Nat.mod_lt j hn
    simp only [Finset.mem_filter, Finset.mem_Ico]
    omega
  rw [Finset.sum_add_distrib, Finset.sum_const, Nat.card_Ico, smul_eq_mul,
    Finset.sum_boole, Nat.cast_id, hfilt, Nat.card_Ico] at hbound
  exact hbound

private theorem sum_oreCoefficientDepth_mul_identity {n : ℕ} (hn : 0 < n) (j : ℕ) :
    (n - 1) * (j / n + 1) + (j / n + 1) + j % n = n + j := by
  calc (n - 1) * (j / n + 1) + (j / n + 1) + j % n
      = (n - 1 + 1) * (j / n + 1) + j % n := by ring
    _ = n * (j / n + 1) + j % n := by rw [Nat.sub_add_cancel hn]
    _ = n + (n * (j / n) + j % n) := by ring
    _ = n + j := by rw [Nat.div_add_mod]

/-- The sum of the coefficient depths over `1 ≤ h < n` is at most `n + j - 1` whenever `0 < n`. -/
theorem sum_oreCoefficientDepth_le {n : ℕ} (hn : 0 < n) (j : ℕ) :
    ∑ h ∈ Finset.Ico 1 n, oreCoefficientDepth K n j h ≤ n + j - 1 := by
  have h1 := sum_oreCoefficientDepth_le_aux (K := K) hn j
  have hmul := sum_oreCoefficientDepth_mul_identity hn j
  have hsub : j % n - 1 ≤ j % n := Nat.sub_le _ _
  exact Nat.le_sub_of_add_le (by linarith [Nat.zero_le (j / n)])

/-- When `0 < j % n`, the sum of the coefficient depths over `1 ≤ h < n` is strictly less than
`n + j - 1`. -/
theorem sum_oreCoefficientDepth_add_one_le {n j : ℕ} (hn : 0 < n) (hb : 0 < j % n) :
    (∑ h ∈ Finset.Ico 1 n, oreCoefficientDepth K n j h) + 1 ≤ n + j - 1 := by
  have h1 := sum_oreCoefficientDepth_le_aux (K := K) hn j
  have hmul := sum_oreCoefficientDepth_mul_identity hn j
  have hsub : j % n - 1 + 1 = j % n := Nat.sub_add_cancel hb
  exact Nat.le_sub_of_add_le (by linarith [Nat.zero_le (j / n)])

/-! ### Characterization of the Eisenstein derivative infimum -/

/-- Shifting an `ℕ∞`-valued term by `+ 1` compares `n * v + n` against `n + j`: exact equality
forces `j % n = 0` and `v = j / n`. -/
private theorem mul_add_self_eq_iff {n j : ℕ} (hn : 0 < n) (v : ℕ∞) :
    (n : ℕ∞) * v + (n : ℕ∞) = ((n + j : ℕ) : ℕ∞) ↔ j % n = 0 ∧ ((j / n : ℕ) : ℕ∞) = v := by
  cases v with
  | top =>
    have hne : (n : ℕ∞) * ⊤ + (n : ℕ∞) = ⊤ := by simp [hn.ne']
    rw [hne]
    exact iff_of_false (ENat.natCast_ne_top _).symm (fun h ↦ ENat.natCast_ne_top _ h.2)
  | coe m =>
    norm_cast
    have hdiv : n * (j / n) + j % n = j := Nat.div_add_mod j n
    have hlt : j % n < n := Nat.mod_lt j hn
    constructor
    · intro h
      have hmul : n * m = n * (j / n) + j % n := by omega
      have hmod : j % n = 0 := by
        have := congrArg (· % n) hmul
        simpa [Nat.mul_mod_right, Nat.mod_eq_of_lt hlt] using this.symm
      exact ⟨hmod, by nlinarith⟩
    · rintro ⟨hmod, rfl⟩
      omega

/-- Inequality version of `mul_add_self_eq_iff`: `n + j ≤ n * v + n` holds iff `j / n ≤ v` when
`n ∣ j`, and `j / n + 1 ≤ v` when `n ∤ j`. -/
private theorem le_mul_add_self_iff {n j : ℕ} (hn : 0 < n) (v : ℕ∞) :
    ((n + j : ℕ) : ℕ∞) ≤ (n : ℕ∞) * v + (n : ℕ∞) ↔
      (if j % n = 0 then ((j / n : ℕ) : ℕ∞) else ((j / n : ℕ) : ℕ∞) + 1) ≤ v := by
  cases v with
  | top =>
    simp [hn.ne']
  | coe m =>
    split_ifs with hb <;> norm_cast
    · have hdiv : n * (j / n) + j % n = j := Nat.div_add_mod j n
      constructor <;> intro <;> nlinarith
    · have hdiv : n * (j / n) + j % n = j := Nat.div_add_mod j n
      have hlt : j % n < n := Nat.mod_lt j hn
      have hbpos : 1 ≤ j % n := Nat.pos_of_ne_zero hb
      constructor <;> intro <;> nlinarith

/-- For `1 ≤ h < n`, exact equality `n * (vf + vh) + h = n + j` forces `h = j % n` and
`vf + vh = j / n + 1`. -/
private theorem mul_add_eq_iff {n j h : ℕ} (hh0 : 0 < h) (hhn : h < n) (vf vh : ℕ∞) :
    (n : ℕ∞) * (vf + vh) + (h : ℕ∞) = ((n + j : ℕ) : ℕ∞) ↔
      h = j % n ∧ vf + vh = ((j / n + 1 : ℕ) : ℕ∞) := by
  have hn : 0 < n := lt_trans hh0 hhn
  cases hsum : vf + vh with
  | top =>
    have hne : (n : ℕ∞) * ⊤ + (h : ℕ∞) = ⊤ := by simp [hn.ne']
    rw [hne]
    exact iff_of_false (ENat.natCast_ne_top _).symm (fun h ↦ (ENat.natCast_ne_top _).symm h.2)
  | coe m =>
    norm_cast
    have hdiv : n * (j / n) + j % n = j := Nat.div_add_mod j n
    have hlt : j % n < n := Nat.mod_lt j hn
    constructor
    · intro heq
      have heq' : n * m + h = n + j := by exact_mod_cast heq
      have hmod : h = j % n := by
        have := congrArg (· % n) heq'
        rw [Nat.mul_add_mod, Nat.mod_eq_of_lt hhn, Nat.add_mod, Nat.mod_self, zero_add,
          Nat.mod_mod] at this
        exact this
      have hm : m = j / n + 1 := by nlinarith
      exact ⟨hmod, by exact_mod_cast hm⟩
    · rintro ⟨rfl, rfl⟩
      rw [mul_add, mul_one]
      omega

/-- For `1 ≤ h < n` and `1 ≤ vf`, the inequality `n + j ≤ n * (vf + v_K(h)) + h` is equivalent to
`oreCoefficientDepth K n j h ≤ vf`. -/
private theorem le_mul_add_iff_oreCoefficientDepth_le {n j h : ℕ} (hh0 : 0 < h) (hhn : h < n)
    {vf : ℕ∞} (hvf : 1 ≤ vf) :
    ((n + j : ℕ) : ℕ∞) ≤ (n : ℕ∞) * (vf + addVal 𝒪[K] (h : 𝒪[K])) + (h : ℕ∞) ↔
      (oreCoefficientDepth K n j h : ℕ∞) ≤ vf := by
  have hn : 0 < n := lt_trans hh0 hhn
  have hdiv : n * (j / n) + j % n = j := Nat.div_add_mod j n
  have hlt : j % n < n := Nat.mod_lt j hn
  cases hvh : addVal 𝒪[K] (h : 𝒪[K]) with
  | top =>
    simp [oreCoefficientDepth_def, hvh, hvf, hn.ne']
  | coe vh =>
    rw [oreCoefficientDepth_eq_of_addVal_eq hvh]
    cases vf with
    | top =>
      simp [hn.ne']
    | coe mf =>
      have hvf' : 1 ≤ mf := by exact_mod_cast hvf
      norm_cast
      split_ifs with hltb
      · constructor
        · intro hle
          refine max_le hvf' ?_
          have hmf : j / n + 2 ≤ mf + vh := by
            by_contra hlt'
            have hmul : n * (mf + vh) ≤ n * (j / n + 1) := Nat.mul_le_mul_left n (by omega)
            nlinarith
          omega
        · intro hge
          have hmul : n * (j / n + 2) ≤ n * (mf + vh) :=
            Nat.mul_le_mul_left n (by have := le_trans (le_max_right _ _) hge; omega)
          nlinarith
      · constructor
        · intro hle
          refine max_le hvf' ?_
          have hmf : j / n + 1 ≤ mf + vh := by
            by_contra hlt'
            have hmul : n * (mf + vh) ≤ n * (j / n) := Nat.mul_le_mul_left n (by omega)
            omega
          omega
        · intro hge
          have hmul : n * (j / n + 1) ≤ n * (mf + vh) :=
            Nat.mul_le_mul_left n (by have := le_trans (le_max_right _ _) hge; omega)
          nlinarith

/-- Shifted derivative term `n * (v_K(f_{i+1}) + v_K(i + 1)) + (i + 1)` for `i : Fin n`. -/
private def shiftedDerivTerm (n : ℕ) (f : 𝒪[K][X]) (i : Fin n) : ℕ∞ :=
  (n : ℕ∞) * (addVal 𝒪[K] (f.coeff (i + 1)) + addVal 𝒪[K] ((i + 1 : ℕ) : 𝒪[K])) +
    ((i + 1 : ℕ) : ℕ∞)

private theorem iInf_eisenstein_derivative_eq_iff_shifted {n j : ℕ} (hn : 0 < n) (f : 𝒪[K][X]) :
    (⨅ i : Fin n, n • addVal 𝒪[K] (f.coeff (i + 1) * (i + 1)) + (i : ℕ)) =
        ((n - 1 + j : ℕ) : ℕ∞) ↔
      (⨅ i : Fin n, shiftedDerivTerm n f i) = ((n + j : ℕ) : ℕ∞) := by
  have : Nonempty (Fin n) := ⟨⟨0, hn⟩⟩
  have hadd1 : ∀ x : ℕ∞, x = ((n - 1 + j : ℕ) : ℕ∞) ↔ x + 1 = ((n + j : ℕ) : ℕ∞) := by
    intro x
    cases x with
    | top =>
      rw [top_add]
      exact iff_of_false (ENat.natCast_ne_top _).symm (ENat.natCast_ne_top _).symm
    | coe m => norm_cast; omega
  have hterm_eq : (⨅ i : Fin n, n • addVal 𝒪[K] (f.coeff (i + 1) * (i + 1)) + (i : ℕ) + 1) =
      ⨅ i : Fin n, shiftedDerivTerm n f i :=
    iInf_congr fun i ↦ by
      simp only [shiftedDerivTerm, nsmul_eq_mul, addVal_mul, Nat.cast_add, Nat.cast_one, add_assoc]
  rw [hadd1, ENat.iInf_add, hterm_eq]

private theorem shiftedDerivTerm_last {n : ℕ} (hn : 0 < n) {f : 𝒪[K][X]}
    (hmonic : f.Monic) (hdeg : f.natDegree = n) :
    shiftedDerivTerm n f ⟨n - 1, Nat.sub_lt hn one_pos⟩ =
      (n : ℕ∞) * addVal 𝒪[K] (n : 𝒪[K]) + n := by
  have h1 : n - 1 + 1 = n := Nat.sub_add_cancel hn
  have hlead : f.coeff n = 1 := hdeg ▸ hmonic.leadingCoeff
  simp only [shiftedDerivTerm, h1, hlead, addVal_one, zero_add]

private theorem one_le_addVal_coeff_of_isEisensteinAt {n : ℕ} {f : 𝒪[K][X]}
    (hf : f.IsEisensteinAt 𝓂[K]) (hdeg : f.natDegree = n) {h : ℕ} (hh : h < n) :
    1 ≤ addVal 𝒪[K] (f.coeff h) := by
  have hmem : f.coeff h ∈ 𝓂[K] ^ 1 := by simpa using hf.mem (hdeg ▸ hh)
  exact_mod_cast (TauCeti.IsDiscreteValuationRing.mem_maximalIdeal_pow_iff_le_addVal).mp hmem

private theorem exists_nat_of_enat_add_eq_natCast {a b : ℕ∞} {m : ℕ} (h : a + b = (m : ℕ∞)) :
    ∃ x y : ℕ, a = x ∧ b = y ∧ x + y = m := by
  cases a with
  | top => simp at h
  | coe x =>
    cases b with
    | top => simp at h
    | coe y => exact ⟨x, y, rfl, rfl, by exact_mod_cast h⟩

private theorem iInf_shiftedDerivTerm_mp {n j : ℕ} (hn : 0 < n) {f : 𝒪[K][X]}
    (hmonic : f.Monic) (hf : f.IsEisensteinAt 𝓂[K]) (hdeg : f.natDegree = n)
    (hinf : (⨅ i : Fin n, shiftedDerivTerm n f i) = ((n + j : ℕ) : ℕ∞)) :
    IsOreAdmissible K n j ∧
      (∀ i : Fin n, 0 < i.1 →
        if i.1 = j % n then
          addVal 𝒪[K] (f.coeff i.1) = oreCoefficientDepth K n j i.1
        else
          (oreCoefficientDepth K n j i.1 : ℕ∞) ≤ addVal 𝒪[K] (f.coeff i.1)) := by
  have : Nonempty (Fin n) := ⟨⟨0, hn⟩⟩
  have hle_all : ∀ i : Fin n, ((n + j : ℕ) : ℕ∞) ≤ shiftedDerivTerm n f i :=
    fun i ↦ hinf ▸ iInf_le _ i
  have hcoeff_ge : ∀ i : Fin n, 0 < i.1 →
      (oreCoefficientDepth K n j i.1 : ℕ∞) ≤ addVal 𝒪[K] (f.coeff i.1) := by
    intro i hi0
    have hterm := hle_all ⟨i.1 - 1, by omega⟩
    have h1 : i.1 - 1 + 1 = i.1 := Nat.sub_add_cancel hi0
    simp only [shiftedDerivTerm, h1] at hterm
    exact (le_mul_add_iff_oreCoefficientDepth_le hi0 i.isLt
      (one_le_addVal_coeff_of_isEisensteinAt hf hdeg i.isLt)).mp hterm
  obtain ⟨i₀, hi₀⟩ := exists_eq_ciInf_of_finite (f := shiftedDerivTerm n f)
  rw [hinf] at hi₀
  rcases (Nat.succ_le_of_lt i₀.isLt).lt_or_eq with hlt | heq
  · obtain ⟨hb_eq, hsum⟩ := (mul_add_eq_iff (Nat.succ_pos i₀.1) hlt _ _).mp hi₀
    have hsum' : addVal 𝒪[K] (f.coeff (j % n)) + addVal 𝒪[K] ((j % n : ℕ) : 𝒪[K]) =
        ((j / n + 1 : ℕ) : ℕ∞) := by simpa only [← hb_eq] using hsum
    have hbpos : 0 < j % n := hb_eq ▸ Nat.succ_pos i₀.1
    obtain ⟨mf, mv, hfv, hvv, hfmv⟩ := exists_nat_of_enat_add_eq_natCast hsum'
    have hvf1 : 1 ≤ mf := by
      have := hfv ▸ hb_eq ▸ one_le_addVal_coeff_of_isEisensteinAt hf hdeg hlt
      exact_mod_cast this
    have hvb_le : addVal 𝒪[K] ((j % n : ℕ) : 𝒪[K]) ≤ (j / n : ℕ) := by
      rw [hvv]; norm_cast; omega
    have hvn_ge : ((j / n : ℕ) : ℕ∞) + 1 ≤ addVal 𝒪[K] (n : 𝒪[K]) := by
      have := hle_all ⟨n - 1, Nat.sub_lt hn one_pos⟩
      rwa [shiftedDerivTerm_last hn hmonic hdeg, le_mul_add_self_iff hn,
        ite_eq_right hbpos.ne'] at this
    have hadm : IsOreAdmissible K n j :=
      (isOreAdmissible_iff_of_mod_pos hn hbpos).mpr ⟨hvb_le, hvn_ge⟩
    refine ⟨hadm, fun i hi0 ↦ ?_⟩
    split_ifs with him
    · have h1 := addVal_add_oreCoefficientDepth_mod_eq hadm hbpos
      rw [him, hfv]
      rw [hvv] at h1
      norm_cast at h1 ⊢; omega
    · exact hcoeff_ge i hi0
  · have hlast_eq : (n : ℕ∞) * addVal 𝒪[K] (n : 𝒪[K]) + n = ((n + j : ℕ) : ℕ∞) := by
      have hi₀_eq : i₀ = ⟨n - 1, Nat.sub_lt hn one_pos⟩ := Fin.ext (by dsimp; omega)
      rw [← shiftedDerivTerm_last hn hmonic hdeg, ← hi₀_eq, hi₀]
    obtain ⟨hb0, hva⟩ := (mul_add_self_eq_iff hn _).mp hlast_eq
    refine ⟨(isOreAdmissible_iff_of_mod_eq_zero hn hb0).mpr hva, fun i hi0 ↦ ?_⟩
    rw [ite_eq_right (by omega)]
    exact hcoeff_ge i hi0

private theorem iInf_shiftedDerivTerm_mpr {n j : ℕ} (hn : 0 < n) {f : 𝒪[K][X]}
    (hmonic : f.Monic) (hf : f.IsEisensteinAt 𝓂[K]) (hdeg : f.natDegree = n)
    (hadm : IsOreAdmissible K n j)
    (hcoeff : ∀ i : Fin n, 0 < i.1 →
      if i.1 = j % n then
        addVal 𝒪[K] (f.coeff i.1) = oreCoefficientDepth K n j i.1
      else
        (oreCoefficientDepth K n j i.1 : ℕ∞) ≤ addVal 𝒪[K] (f.coeff i.1)) :
    (⨅ i : Fin n, shiftedDerivTerm n f i) = ((n + j : ℕ) : ℕ∞) := by
  refine le_antisymm ?_ (le_iInf fun i ↦ ?_)
  · rcases (j % n).eq_zero_or_pos with hb0 | hbpos
    · refine iInf_le_of_le ⟨n - 1, Nat.sub_lt hn one_pos⟩ ?_
      rw [shiftedDerivTerm_last hn hmonic hdeg, (mul_add_self_eq_iff hn _).mpr
        ⟨hb0, (isOreAdmissible_iff_of_mod_eq_zero hn hb0).mp hadm⟩]
    · have hblt : j % n < n := Nat.mod_lt j hn
      refine iInf_le_of_le ⟨j % n - 1, by omega⟩ ?_
      have h1 : j % n - 1 + 1 = j % n := Nat.sub_add_cancel hbpos
      have hcb : addVal 𝒪[K] (f.coeff (j % n)) = oreCoefficientDepth K n j (j % n) := by
        simpa using hcoeff ⟨j % n, hblt⟩ hbpos
      have hsum : addVal 𝒪[K] (f.coeff (j % n)) + addVal 𝒪[K] ((j % n : ℕ) : 𝒪[K]) =
          ((j / n + 1 : ℕ) : ℕ∞) := by
        rw [hcb, add_comm, addVal_add_oreCoefficientDepth_mod_eq hadm hbpos]
      simp only [shiftedDerivTerm, h1]
      rw [(mul_add_eq_iff hbpos hblt _ _).mpr ⟨rfl, hsum⟩]
  · rcases (Nat.succ_le_of_lt i.isLt).lt_or_eq with hlt | heq
    · have hge : (oreCoefficientDepth K n j (i.1 + 1) : ℕ∞) ≤
          addVal 𝒪[K] (f.coeff (i.1 + 1)) := by
        have hc := hcoeff ⟨i.1 + 1, hlt⟩ (Nat.succ_pos i.1)
        split_ifs at hc
        · exact hc.ge
        · exact hc
      exact (le_mul_add_iff_oreCoefficientDepth_le (Nat.succ_pos i.1) hlt
        (one_le_addVal_coeff_of_isEisensteinAt hf hdeg hlt)).mpr hge
    · have hi_eq : i = ⟨n - 1, Nat.sub_lt hn one_pos⟩ := Fin.ext (by dsimp; omega)
      rw [hi_eq, shiftedDerivTerm_last hn hmonic hdeg, le_mul_add_self_iff hn]
      split_ifs with hb0
      · exact ((isOreAdmissible_iff_of_mod_eq_zero hn hb0).mp hadm).le
      · exact ((isOreAdmissible_iff_of_mod_pos hn (Nat.pos_of_ne_zero hb0)).mp hadm).2

/-- **The Eisenstein derivative infimum characterizes Ore admissibility and the coefficient box.**
For a monic Eisenstein polynomial `f` of degree `n > 0` over `𝒪[K]`, its derivative infimum equals
`n - 1 + j` if and only if `IsOreAdmissible K n j` holds and every coefficient `f.coeff h`
(`1 ≤ h < n`) has additive valuation at least `oreCoefficientDepth K n j h`, with equality when
`h = j % n`. -/
theorem iInf_eisenstein_derivative_eq_iff {n j : ℕ} (hn : 0 < n) {f : 𝒪[K][X]}
    (hmonic : f.Monic) (hf : f.IsEisensteinAt 𝓂[K]) (hdeg : f.natDegree = n) :
    (⨅ i : Fin n, n • addVal 𝒪[K] (f.coeff (i + 1) * (i + 1)) + (i : ℕ)) =
        ((n - 1 + j : ℕ) : ℕ∞) ↔
      IsOreAdmissible K n j ∧
        (∀ i : Fin n, 0 < i.1 →
          if i.1 = j % n then
            addVal 𝒪[K] (f.coeff i.1) = oreCoefficientDepth K n j i.1
          else
            (oreCoefficientDepth K n j i.1 : ℕ∞) ≤ addVal 𝒪[K] (f.coeff i.1)) := by
  rw [iInf_eisenstein_derivative_eq_iff_shifted hn]
  exact ⟨iInf_shiftedDerivTerm_mp hn hmonic hf hdeg,
    fun ⟨hadm, hcoeff⟩ ↦ iInf_shiftedDerivTerm_mpr hn hmonic hf hdeg hadm hcoeff⟩

/-- A monic Eisenstein polynomial of positive degree over `𝒪[K]` has separable image in `K[X]`
exactly when its derivative infimum is finite. -/
theorem separable_map_iff_iInf_eisenstein_derivative_ne_top {n : ℕ} (hn : 0 < n) {f : 𝒪[K][X]}
    (hmonic : f.Monic) (hf : f.IsEisensteinAt 𝓂[K]) (hdeg : f.natDegree = n) :
    (f.map (algebraMap 𝒪[K] K)).Separable ↔
      (⨅ i : Fin n, n • addVal 𝒪[K] (f.coeff (i + 1) * (i + 1)) + (i : ℕ)) ≠ ⊤ := by
  let a : Fin n → K := fun i ↦ (f.coeff i.1 : K)
  have hfmap : f.map (algebraMap 𝒪[K] K) = monicOfCoeff a := by
    have hfdeg : (f.map (algebraMap 𝒪[K] K)).natDegree = n := by
      rwa [natDegree_map_eq_of_injective (FaithfulSMul.algebraMap_injective 𝒪[K] K)]
    rw [← monicOfCoeff_coeff (hmonic.map _) hfdeg]
    exact congrArg monicOfCoeff (funext fun i ↦ by simp [a, coeff_map,
      Algebra.algebraMap_ofSubsemiring_apply])
  have ha_mem : a ∈ eisensteinSet K n :=
    mem_eisensteinSet_iff_exists_isEisensteinAt.mpr ⟨f, hfmap, hf⟩
  rw [hfmap, separable_iff_derivative_ne_zero (irreducible_monicOfCoeff_of_mem_eisensteinSet hn
    ha_mem), ← hfmap]
  have hder_ne : (f.map (algebraMap 𝒪[K] K)).derivative ≠ 0 ↔
      ∃ i : Fin n, f.coeff (i + 1) * (i + 1) ≠ 0 := by
    constructor
    · intro hne
      by_contra hall
      push Not at hall
      apply hne
      ext k
      by_cases hkn : k < n
      · simp [Polynomial.derivative_map, coeff_map, coeff_derivative,
          Algebra.algebraMap_ofSubsemiring_apply, hall ⟨k, hkn⟩]
      · simp [Polynomial.derivative_map, coeff_map, coeff_derivative,
          coeff_eq_zero_of_natDegree_lt (by omega : f.natDegree < k + 1)]
    · rintro ⟨i, hi⟩ hzero
      apply hi
      have hci := congrArg (fun p : K[X] ↦ p.coeff i.1) hzero
      exact Subtype.ext (by simpa [Polynomial.derivative_map, coeff_map, coeff_derivative,
        Algebra.algebraMap_ofSubsemiring_apply] using hci)
  rw [hder_ne, ne_eq, iInf_eq_top]
  push Not
  refine exists_congr fun i ↦ ?_
  cases hv : addVal 𝒪[K] (f.coeff (i + 1) * (i + 1)) with
  | top => simp [addVal_eq_top_iff.mp hv, hn.ne']
  | coe m =>
    have hne : f.coeff (i + 1) * (i + 1) ≠ 0 :=
      addVal_eq_top_iff.not.mp (hv ▸ ENat.natCast_ne_top m)
    have hfin : (n • (m : ℕ∞) + (i : ℕ)) ≠ ⊤ := by
      rw [nsmul_eq_mul, ← Nat.cast_mul, ← Nat.cast_add]; exact ENat.natCast_ne_top _
    exact iff_of_true hne hfin

/-- For any Ore-admissible `(n, j)`, there exists a monic Eisenstein polynomial of degree `n` over
`𝒪[K]` whose derivative infimum equals `n - 1 + j`. -/
theorem exists_eisenstein_iInf_derivative_eq {n j : ℕ} (hadm : IsOreAdmissible K n j) :
    ∃ f : 𝒪[K][X], f.Monic ∧ f.IsEisensteinAt 𝓂[K] ∧ f.natDegree = n ∧
      (⨅ i : Fin n, n • addVal 𝒪[K] (f.coeff (i + 1) * (i + 1)) + (i : ℕ)) =
        ((n - 1 + j : ℕ) : ℕ∞) := by
  have hn : 0 < n := hadm.pos
  obtain ⟨π, hπ⟩ := exists_irreducible 𝒪[K]
  let c : Fin n → 𝒪[K] := fun i ↦
    if i.1 = 0 then π
    else if i.1 = j % n then π ^ oreCoefficientDepth K n j i.1
    else 0
  let f : 𝒪[K][X] := monicOfCoeff c
  have hmonic : f.Monic := monic_monicOfCoeff c
  have hdeg : f.natDegree = n := natDegree_monicOfCoeff c
  have hπmem : π ∈ 𝓂[K] := hπ.not_isUnit
  have hf : f.IsEisensteinAt 𝓂[K] := by
    refine hmonic.isEisensteinAt_of_mem_of_notMem (Ideal.IsMaximal.ne_top inferInstance)
      (fun {i} hi ↦ ?_) ?_
    · rw [hdeg] at hi
      dsimp only [f]
      rw [coeff_monicOfCoeff c ⟨i, hi⟩]
      simp only [c]
      split_ifs
      · exact hπmem
      · exact Ideal.pow_mem_of_mem _ hπmem _ (oreCoefficientDepth_pos n j i)
      · exact Ideal.zero_mem _
    · dsimp only [f]
      rw [coeff_monicOfCoeff c ⟨0, hn⟩]
      simp [c, TauCeti.IsDiscreteValuationRing.mem_maximalIdeal_pow_iff_le_addVal,
        addVal_uniformizer hπ]
  refine ⟨f, hmonic, hf, hdeg, (iInf_eisenstein_derivative_eq_iff hn hmonic hf hdeg).mpr
    ⟨hadm, fun i hi0 ↦ ?_⟩⟩
  dsimp only [f]
  rw [coeff_monicOfCoeff c i]
  simp only [c, hi0.ne', ↓reduceIte]
  split_ifs
  · rw [addVal_pow, addVal_uniformizer hπ, nsmul_one]
  · simp

end DiscreteValuation

section LocalField

variable [TopologicalSpace K] [IsNonarchimedeanLocalField K]

/-- In a nonarchimedean local field, the tame Ore admissibility condition reads
`¬ ringChar 𝓀[K] ∣ n`: for `0 < n` prime to the residue characteristic, only wild exponent `0` is
admissible. -/
theorem isOreAdmissible_iff_eq_zero_of_not_dvd {n j : ℕ} (hn : 0 < n)
    (hp : ¬ ringChar 𝓀[K] ∣ n) : IsOreAdmissible K n j ↔ j = 0 :=
  isOreAdmissible_iff_eq_zero_of_isUnit hn (IsLocalRing.isUnit_natCast_iff_not_dvd.mpr hp)

/-- When `(n : K) ≠ 0`, every Ore-admissible wild exponent satisfies `j ≤ n * v_K(n)`. -/
theorem IsOreAdmissible.le_mul_natCastValuation {n j : ℕ} (h : IsOreAdmissible K n j)
    (hnK : (n : K) ≠ 0) : j ≤ n * natCastValuation K n hnK := by
  have hvn : addVal 𝒪[K] (n : 𝒪[K]) = (natCastValuation K n hnK : ℕ∞) :=
    TauCeti.IsDiscreteValuationRing.addVal_natCast K n hnK
  have hdiv : n * (j / n) + j % n = j := Nat.div_add_mod j n
  have hlt : j % n < n := Nat.mod_lt j h.pos
  rcases h.2 with ⟨hb, ha⟩ | ⟨_, _, ha⟩
  · rw [hvn] at ha
    have ha' : j / n = natCastValuation K n hnK := by exact_mod_cast ha
    rw [ha', hb] at hdiv
    omega
  · rw [hvn] at ha
    have ha' : j / n + 1 ≤ natCastValuation K n hnK := by exact_mod_cast ha
    nlinarith

/-- For a nonzero natural number `h` in a nonarchimedean local field, `oreCoefficientDepth`
evaluates directly in terms of `natCastValuation`. -/
theorem oreCoefficientDepth_eq_of_natCast_ne_zero {n j h : ℕ} (hh : (h : K) ≠ 0) :
    oreCoefficientDepth K n j h =
      max 1 (j / n + 1 + (if h < j % n then 1 else 0) - natCastValuation K h hh) :=
  oreCoefficientDepth_eq_of_addVal_eq (TauCeti.IsDiscreteValuationRing.addVal_natCast K h hh)

/-- **Ore's realizability theorem** ([Ore 1926], [Pauli–Roblot 2001, Proposition 3.1]): a
nonnegative integer `j` occurs as the wild exponent of some totally ramified subextension of
degree `n` inside `SeparableClosure K` if and only if `IsOreAdmissible K n j` holds. -/
theorem ore_realizability (n j : ℕ) :
    (∃ E ∈ totallyRamifiedOfDegree K n, E.wildExponent = j) ↔ IsOreAdmissible K n j := by
  constructor
  · rintro ⟨E, hE, rfl⟩
    have hn : 0 < n := Nat.pos_of_ne_zero fun h0 ↦ by simp [h0] at hE
    obtain ⟨f, x, hmonic, hf, hdeg, hx, hgen⟩ :=
      exists_eisenstein_generator_of_mem_totallyRamifiedOfDegree hE
    have hd := natCast_discriminantExponent_adjoin_eq_iInf_of_eisenstein hf hx
    rw [hgen, hdeg] at hd
    have hwd : E.discriminantExponent = n - 1 + E.wildExponent := by
      have := IntermediateField.wildExponent_add_eq_discriminantExponent_add_one hE
      omega
    rw [hwd] at hd
    exact ((iInf_eisenstein_derivative_eq_iff hn hmonic hf hdeg).mp hd.symm).1
  · intro hadm
    have hn : 0 < n := hadm.pos
    obtain ⟨f, hmonic, hf, hdeg, hinf⟩ := exists_eisenstein_iInf_derivative_eq hadm
    have hsep : (f.map (algebraMap 𝒪[K] K)).Separable :=
      (separable_map_iff_iInf_eisenstein_derivative_ne_top hn hmonic hf hdeg).mpr
        (hinf ▸ ENat.natCast_ne_top _)
    have hcard : ((f.map (algebraMap 𝒪[K] K)).aroots (SeparableClosure K)).card = n := by
      rw [aroots_def, ← (IsSepClosed.splits_codomain _ hsep).natDegree_eq_card_roots,
        natDegree_map, natDegree_map_eq_of_injective (FaithfulSMul.algebraMap_injective 𝒪[K] K),
        hdeg]
    obtain ⟨x, hx⟩ := Multiset.card_pos_iff_exists_mem.mp (hcard ▸ hn)
    have hroot : aeval x (f.map (algebraMap 𝒪[K] K)) = 0 := (mem_aroots.mp hx).2
    have hmem : K⟮x⟯ ∈ totallyRamifiedOfDegree K n :=
      adjoin_mem_totallyRamifiedOfDegree_of_eisenstein hf hdeg hroot
    refine ⟨K⟮x⟯, hmem, ?_⟩
    have hd := natCast_discriminantExponent_adjoin_eq_iInf_of_eisenstein hf hroot
    rw [hdeg, hinf] at hd
    have hd_eq : (K⟮x⟯).discriminantExponent = n - 1 + j := by exact_mod_cast hd
    have hwd := IntermediateField.wildExponent_add_eq_discriminantExponent_add_one hmem
    omega

end LocalField

end TauCeti
