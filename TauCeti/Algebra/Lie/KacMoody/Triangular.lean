/-!
# Cartan injectivity and triangular decomposition for Kac–Moody Lie algebras

For a generalized Cartan matrix `A : Matrix I I ℤ` (`Matrix.IsGeneralizedCartan`) and any
realization `R` of `A` on a `K`-vector space `H` over an arbitrary field `K`, we prove that Serre's
relations preserve Kac's triangular decomposition of the auxiliary Lie algebra `𝔤~(A)`:

* the positive Serre ideal `S⁺` generated in `FreeLieAlgebra K I` by `(ad eᵢ) ^ (-Aᵢⱼ) ⁅eᵢ, eⱼ⁆`
  maps into `n~⁺ ⊆ 𝔤~(A)` as a Lie ideal of the whole auxiliary algebra `𝔤~(A)` — crucially, every
  lowering generator `f~ₖ` annihilates the Serre relators in `n~⁺` thanks to the three generalized
  Cartan matrix axioms `Aᵢᵢ = 2`, `Aᵢⱼ ≤ 0` (`i ≠ j`), and `Aᵢⱼ = 0 ↔ Aⱼᵢ = 0`;
* symmetrically, the negative Serre ideal `S⁻` maps into `n~⁻ ⊆ 𝔤~(A)` as a Lie ideal of `𝔤~(A)`,
  and the kernel of `toPresented : 𝔤~(A) →ₗ⁅K⁆ PresentedLieAlgebra R` is `S⁻ ⊕ S⁺`.

Combining this ideal decomposition with Kac's Theorem 1.2 (`TauCeti.KacMoody.auxTriangularEquiv`)
yields the structural consequences of [Kac, §§1.2–1.3] without any characteristic, finiteness or
symmetrizability hypotheses:

* `TauCeti.KacMoody.cartanElement_injective`: `H` embeds injectively into `PresentedLieAlgebra R`.
* `TauCeti.KacMoody.triangularEquiv`: `PresentedLieAlgebra R` is linearly isomorphic to
  `negativeSubalgebra R × H × positiveSubalgebra R`.
* `TauCeti.KacMoody.positiveSubalgebraEquiv` and `TauCeti.KacMoody.negativeSubalgebraEquiv`: the
  raising and lowering subalgebras `n⁺`, `n⁻` are presented by the positive and negative Serre
  relations alone (`FreeLieAlgebra K I ⧸ serreHalfIdeal K A`).
* `TauCeti.KacMoody.isSl2Triple_generators`, `TauCeti.KacMoody.linearIndependent_positiveGenerator`
  and `TauCeti.KacMoody.ad_pow_positiveGenerator_ne_zero`: each node gives an `sl₂` triple, the
  Chevalley generators are linearly independent, and Serre's exponent `1 - Aᵢⱼ` is sharp
  (`(ad eᵢ)^m eⱼ ≠ 0` for `i ≠ j` and `m ≤ -Aᵢⱼ`).
* `TauCeti.KacMoody.cartanElement_mem_center_iff`: `cartanElement R x` is central in
  `PresentedLieAlgebra R` if and only if `x ∈ R.cartanCenter` (`∀ i, αᵢ(x) = 0`).
* `TauCeti.KacMoody.serreHom_injective` and
  `TauCeti.KacMoody.range_serreHom_inf_range_cartanElement`: Serre's presentation
  `Matrix.ToLieAlgebra K A` embeds isomorphically onto the derived algebra `⁅𝔤, 𝔤⁆`, and
  `⁅𝔤, 𝔤⁆ ∩ H` is the image of the coroot span `R.corootSpan`.

## Main definitions

* `TauCeti.KacMoody.chevalleyInvolution`: the Chevalley involution on `PresentedLieAlgebra R`.
* `TauCeti.KacMoody.positiveSubalgebra`, `TauCeti.KacMoody.negativeSubalgebra` and
  `TauCeti.KacMoody.cartanSubalgebra`: the subalgebras `n⁺`, `n⁻` and `H` of
  `PresentedLieAlgebra R`.
* `TauCeti.KacMoody.cartanEquiv` and `TauCeti.KacMoody.cartanElementEquivOfIsEmpty`: linear
  equivalences `H ≃ₗ[K] cartanSubalgebra R` and (for empty `I`) `H ≃ₗ[K] PresentedLieAlgebra R`.
* `TauCeti.KacMoody.serreHalfIdeal`: the Lie ideal of `FreeLieAlgebra K I` generated by the
  one-sided Serre relators `(ad xᵢ) ^ (-Aᵢⱼ) ⁅xᵢ, xⱼ⁆`.
* `TauCeti.KacMoody.positiveSubalgebraEquiv` and `TauCeti.KacMoody.negativeSubalgebraEquiv`:
  presentations `(FreeLieAlgebra K I ⧸ serreHalfIdeal K A) ≃ₗ⁅K⁆ positiveSubalgebra R` and
  `negativeSubalgebra R`.
* `TauCeti.KacMoody.triangularEquiv`: the triangular linear isomorphism
  `(negativeSubalgebra R × H × positiveSubalgebra R) ≃ₗ[K] PresentedLieAlgebra R`.
* `TauCeti.KacMoody.negativePart`, `TauCeti.KacMoody.cartanPart` and
  `TauCeti.KacMoody.positivePart`: the three linear projections of the triangular decomposition.
* `TauCeti.KacMoody.serreRangeEquiv` and `TauCeti.KacMoody.serreEquivOfCorootSpanEqTop`:
  comparison equivalences with `Matrix.ToLieAlgebra K A`.

## Main results

* `TauCeti.KacMoody.cartanElement_injective` and `TauCeti.KacMoody.triangularMap_injective`
* `TauCeti.KacMoody.ker_lift_positiveGenerator` and `TauCeti.KacMoody.ker_lift_negativeGenerator`
* `TauCeti.KacMoody.isSl2Triple_auxGenerators` and `TauCeti.KacMoody.isSl2Triple_generators`
* `TauCeti.KacMoody.linearIndependent_positiveGenerator` and
  `TauCeti.KacMoody.linearIndependent_negativeGenerator`
* `TauCeti.KacMoody.ad_pow_positiveGenerator_ne_zero` and
  `TauCeti.KacMoody.ad_pow_negativeGenerator_ne_zero`
* `TauCeti.KacMoody.cartanElement_mem_center_iff`
* `TauCeti.KacMoody.serreHom_injective`
* `TauCeti.KacMoody.range_serreHom_inf_range_cartanElement`

## References

* V. G. Kac, *Infinite-dimensional Lie algebras*, third edition, Cambridge University Press,
  1990, §§1.2–1.3.
-/

public section

open LieAlgebra

namespace TauCeti

namespace KacMoody

section GeneralMatrix

variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H] {A : Matrix I I ℤ}
  (R : CartanRealization (A.map (Int.cast : ℤ → K)) H)

/-- The Kac–Moody defining relations are preserved under signed exchange
`(φ, E, F) ↦ (-φ, -F, -E)`. -/
theorem SatisfiesRelations.neg_swap {L : Type*} [LieRing L] [LieAlgebra K L]
    {R : CartanRealization (A.map (Int.cast : ℤ → K)) H}
    {φ : H →ₗ[K] L} {E F : I → L} (h : SatisfiesRelations R φ E F) :
    SatisfiesRelations R (-φ) (-F) (-E) :=
  have haux := h.toSatisfiesAuxRelations.neg_swap
  { lie_cartan_cartan := haux.lie_cartan_cartan
    lie_cartan_positive := haux.lie_cartan_positive
    lie_cartan_negative := haux.lie_cartan_negative
    lie_positive_negative_self := haux.lie_positive_negative_self
    lie_positive_negative_of_ne := haux.lie_positive_negative_of_ne
    serre_positive i j := by
      simp only [Pi.neg_apply, neg_lie, lie_neg, neg_neg]
      exact ad_neg_pow_apply_eq_zero (h.serre_negative i j)
    serre_negative i j := by
      simp only [Pi.neg_apply, neg_lie, lie_neg, neg_neg]
      exact ad_neg_pow_apply_eq_zero (h.serre_positive i j) }

/-- The Chevalley involution of `PresentedLieAlgebra R`, negating `H` and exchanging `eᵢ` with
`-fᵢ`. -/
noncomputable def chevalleyInvolution :
    PresentedLieAlgebra R ≃ₗ⁅K⁆ PresentedLieAlgebra R :=
  let f := lift (satisfiesRelations_generators R).neg_swap
  have hf : f.comp f = LieHom.id := by ext <;> simp [f]
  { f with
    invFun := f
    left_inv := fun z => DFunLike.congr_fun hf z
    right_inv := fun z => DFunLike.congr_fun hf z }

@[simp]
theorem chevalleyInvolution_cartanElement (x : H) :
    chevalleyInvolution R (cartanElement R x) = -cartanElement R x :=
  lift_cartanElement (satisfiesRelations_generators R).neg_swap x

@[simp]
theorem chevalleyInvolution_positiveGenerator (i : I) :
    chevalleyInvolution R (positiveGenerator R i) = -negativeGenerator R i :=
  lift_positiveGenerator (satisfiesRelations_generators R).neg_swap i

@[simp]
theorem chevalleyInvolution_negativeGenerator (i : I) :
    chevalleyInvolution R (negativeGenerator R i) = -positiveGenerator R i :=
  lift_negativeGenerator (satisfiesRelations_generators R).neg_swap i

@[simp]
theorem chevalleyInvolution_symm :
    (chevalleyInvolution R).symm = chevalleyInvolution R := by
  ext z
  rfl

@[simp]
theorem chevalleyInvolution_apply_apply (z : PresentedLieAlgebra R) :
    chevalleyInvolution R (chevalleyInvolution R z) = z := by
  simpa only [chevalleyInvolution_symm] using (chevalleyInvolution R).symm_apply_apply z

/-- The raising Lie subalgebra `n⁺` of `PresentedLieAlgebra R`, generated by the `eᵢ`. -/
noncomputable def positiveSubalgebra : LieSubalgebra K (PresentedLieAlgebra R) :=
  LieSubalgebra.lieSpan K (PresentedLieAlgebra R) (Set.range (positiveGenerator R))

/-- Unfolding characterization of `positiveSubalgebra`. -/
theorem positiveSubalgebra_def :
    positiveSubalgebra R =
      LieSubalgebra.lieSpan K (PresentedLieAlgebra R) (Set.range (positiveGenerator R)) := (rfl)

/-- The lowering Lie subalgebra `n⁻` of `PresentedLieAlgebra R`, generated by the `fᵢ`. -/
noncomputable def negativeSubalgebra : LieSubalgebra K (PresentedLieAlgebra R) :=
  LieSubalgebra.lieSpan K (PresentedLieAlgebra R) (Set.range (negativeGenerator R))

/-- Unfolding characterization of `negativeSubalgebra`. -/
theorem negativeSubalgebra_def :
    negativeSubalgebra R =
      LieSubalgebra.lieSpan K (PresentedLieAlgebra R) (Set.range (negativeGenerator R)) := (rfl)

/-- The Cartan Lie subalgebra of `PresentedLieAlgebra R`, given by the image of `H`. -/
noncomputable def cartanSubalgebra : LieSubalgebra K (PresentedLieAlgebra R) where
  __ := LinearMap.range (cartanElement R)
  lie_mem' := by
    rintro _ _ ⟨x, rfl⟩ ⟨y, rfl⟩
    rw [lie_cartanElement_cartanElement]
    exact (LinearMap.range (cartanElement R)).zero_mem

@[simp]
theorem cartanSubalgebra_toSubmodule :
    (cartanSubalgebra R).toSubmodule = LinearMap.range (cartanElement R) := (rfl)

@[simp]
theorem mem_cartanSubalgebra_iff {z : PresentedLieAlgebra R} :
    z ∈ cartanSubalgebra R ↔ z ∈ LinearMap.range (cartanElement R) := Iff.rfl

/-- Every `cartanElement R x` belongs to `cartanSubalgebra R`. -/
theorem cartanElement_mem_cartanSubalgebra (x : H) :
    cartanElement R x ∈ cartanSubalgebra R := ⟨x, rfl⟩

@[simp]
theorem positiveGenerator_mem_positiveSubalgebra (i : I) :
    positiveGenerator R i ∈ positiveSubalgebra R :=
  LieSubalgebra.subset_lieSpan ⟨i, rfl⟩

@[simp]
theorem negativeGenerator_mem_negativeSubalgebra (i : I) :
    negativeGenerator R i ∈ negativeSubalgebra R :=
  LieSubalgebra.subset_lieSpan ⟨i, rfl⟩

instance : IsLieAbelian (cartanSubalgebra R) := by
  constructor
  rintro ⟨_, x, rfl⟩ ⟨_, y, rfl⟩
  exact Subtype.ext (lie_cartanElement_cartanElement R x y)

/-- The Chevalley involution carries `positiveSubalgebra R` onto `negativeSubalgebra R`. -/
@[simp]
theorem map_chevalleyInvolution_positiveSubalgebra :
    (positiveSubalgebra R).map (chevalleyInvolution R).toLieHom = negativeSubalgebra R := by
  refine le_antisymm ?_ ?_
  · rw [LieSubalgebra.map_le_iff_le_comap, positiveSubalgebra_def, LieSubalgebra.lieSpan_le]
    rintro _ ⟨i, rfl⟩
    simp only [SetLike.mem_coe, LieSubalgebra.mem_comap, LieEquiv.coe_toLieHom,
      chevalleyInvolution_positiveGenerator]
    exact neg_mem (negativeGenerator_mem_negativeSubalgebra R i)
  · rw [negativeSubalgebra_def, LieSubalgebra.lieSpan_le]
    rintro _ ⟨i, rfl⟩
    exact ⟨-positiveGenerator R i, neg_mem (positiveGenerator_mem_positiveSubalgebra R i), by simp⟩

/-- The Chevalley involution carries `negativeSubalgebra R` onto `positiveSubalgebra R`. -/
@[simp]
theorem map_chevalleyInvolution_negativeSubalgebra :
    (negativeSubalgebra R).map (chevalleyInvolution R).toLieHom = positiveSubalgebra R := by
  refine le_antisymm ?_ ?_
  · rw [LieSubalgebra.map_le_iff_le_comap, negativeSubalgebra_def, LieSubalgebra.lieSpan_le]
    rintro _ ⟨i, rfl⟩
    simp only [SetLike.mem_coe, LieSubalgebra.mem_comap, LieEquiv.coe_toLieHom,
      chevalleyInvolution_negativeGenerator]
    exact neg_mem (positiveGenerator_mem_positiveSubalgebra R i)
  · rw [positiveSubalgebra_def, LieSubalgebra.lieSpan_le]
    rintro _ ⟨i, rfl⟩
    exact ⟨-negativeGenerator R i, neg_mem (negativeGenerator_mem_negativeSubalgebra R i), by simp⟩

/-- The Chevalley involution preserves `cartanSubalgebra R`. -/
@[simp]
theorem map_chevalleyInvolution_cartanSubalgebra :
    (cartanSubalgebra R).map (chevalleyInvolution R).toLieHom = cartanSubalgebra R := by
  ext z
  simp only [LieSubalgebra.mem_map, mem_cartanSubalgebra_iff, LinearMap.mem_range,
    LieEquiv.coe_toLieHom]
  constructor
  · rintro ⟨_, ⟨x, rfl⟩, rfl⟩
    exact ⟨-x, by simp⟩
  · rintro ⟨x, rfl⟩
    exact ⟨cartanElement R (-x), ⟨-x, rfl⟩, by simp⟩

@[simp]
theorem toPresented_comp_auxPositiveHom :
    (toPresented R).comp (auxPositiveHom R) = FreeLieAlgebra.lift K (positiveGenerator R) :=
  FreeLieAlgebra.hom_ext fun i => by simp

@[simp]
theorem toPresented_comp_auxNegativeHom :
    (toPresented R).comp (auxNegativeHom R) = FreeLieAlgebra.lift K (negativeGenerator R) :=
  FreeLieAlgebra.hom_ext fun i => by simp

/-- The range of `FreeLieAlgebra.lift K (positiveGenerator R)` is `positiveSubalgebra R`. -/
theorem range_lift_positiveGenerator :
    (FreeLieAlgebra.lift K (positiveGenerator R)).range = positiveSubalgebra R :=
  FreeLieAlgebra.range_lift (positiveGenerator R)

/-- The range of `FreeLieAlgebra.lift K (negativeGenerator R)` is `negativeSubalgebra R`. -/
theorem range_lift_negativeGenerator :
    (FreeLieAlgebra.lift K (negativeGenerator R)).range = negativeSubalgebra R :=
  FreeLieAlgebra.range_lift (negativeGenerator R)

/-- For any matrix `A`, `PresentedLieAlgebra R` is spanned as a `K`-module by `n⁻`, `H`, and
`n⁺`. -/
theorem negativeSubalgebra_sup_cartanSubalgebra_sup_positiveSubalgebra :
    (negativeSubalgebra R).toSubmodule ⊔ (cartanSubalgebra R).toSubmodule ⊔
      (positiveSubalgebra R).toSubmodule = ⊤ := by
  refine eq_top_iff.2 fun z _ => ?_
  obtain ⟨w, rfl⟩ := toPresented_surjective R z
  obtain ⟨⟨uNeg, x, uPos⟩, rfl⟩ := auxTriangularMap_surjective R w
  simp only [auxTriangularMap_apply, map_add, toPresented_auxCartanElement]
  refine add_mem (add_mem ?_ (Submodule.mem_sup_left (Submodule.mem_sup_right ⟨x, rfl⟩))) ?_
  · refine Submodule.mem_sup_left (Submodule.mem_sup_left ?_)
    rw [← range_lift_negativeGenerator]
    exact ⟨uNeg, DFunLike.congr_fun (toPresented_comp_auxNegativeHom R).symm uNeg⟩
  · refine Submodule.mem_sup_right ?_
    rw [← range_lift_positiveGenerator]
    exact ⟨uPos, DFunLike.congr_fun (toPresented_comp_auxPositiveHom R).symm uPos⟩

/-- The triangular addition map `(n⁻, x, n⁺) ↦ n⁻ + cartanElement x + n⁺` into
`PresentedLieAlgebra R`. -/
noncomputable def triangularMap :
    (negativeSubalgebra R × H × positiveSubalgebra R) →ₗ[K] PresentedLieAlgebra R where
  toFun p := p.1.1 + cartanElement R p.2.1 + p.2.2.1
  map_add' p q := by
    simp only [Prod.fst_add, Prod.snd_add, AddMemClass.coe_add, map_add]
    abel
  map_smul' c p := by
    simp only [Prod.smul_fst, Prod.smul_snd, SetLike.val_smul, map_smul, RingHom.id_apply,
      smul_add]

@[simp]
theorem triangularMap_apply (yNeg : negativeSubalgebra R) (x : H) (yPos : positiveSubalgebra R) :
    triangularMap R (yNeg, x, yPos) = yNeg.1 + cartanElement R x + yPos.1 := (rfl)

/-- For any matrix `A`, `triangularMap R` is surjective onto `PresentedLieAlgebra R`. -/
theorem triangularMap_surjective : Function.Surjective (triangularMap R) := fun z => by
  have hz : z ∈ (negativeSubalgebra R).toSubmodule ⊔ (cartanSubalgebra R).toSubmodule ⊔
      (positiveSubalgebra R).toSubmodule := by
    rw [negativeSubalgebra_sup_cartanSubalgebra_sup_positiveSubalgebra]
    trivial
  obtain ⟨ab, hab, c, hc, rfl⟩ := Submodule.mem_sup.1 hz
  obtain ⟨a, ha, _, ⟨x, rfl⟩, rfl⟩ := Submodule.mem_sup.1 hab
  exact ⟨(⟨a, ha⟩, x, ⟨c, hc⟩), rfl⟩

/-- Elements of `R.cartanCenter` (`∀ i, αᵢ(x) = 0`) map into the center of
`PresentedLieAlgebra R`. -/
theorem cartanElement_mem_center_of_mem_cartanCenter {x : H} (hx : x ∈ R.cartanCenter) :
    cartanElement R x ∈ LieAlgebra.center K (PresentedLieAlgebra R) := by
  rw [LieModule.mem_maxTrivSubmodule]
  intro z
  rw [← lie_skew, neg_eq_zero]
  have hz : z ∈ LieSubalgebra.lieSpan K (PresentedLieAlgebra R) (Set.range (cartanElement R) ∪
      Set.range (positiveGenerator R) ∪ Set.range (negativeGenerator R)) := by
    rw [lieSpan_generators_eq_top]
    trivial
  induction hz using LieSubalgebra.lieSpan_induction with
  | mem y hy =>
    rcases hy with (⟨y, rfl⟩ | ⟨i, rfl⟩) | ⟨i, rfl⟩
    · exact lie_cartanElement_cartanElement R x y
    · simp [(CartanRealization.mem_cartanCenter_iff R x).mp hx i]
    · simp [(CartanRealization.mem_cartanCenter_iff R x).mp hx i]
  | zero => simp
  | add _ _ _ _ ha hb => rw [lie_add, ha, hb, add_zero]
  | smul c _ _ ha => rw [lie_smul, ha, smul_zero]
  | lie a b _ _ ha hb => rw [leibniz_lie, ha, hb, zero_lie, lie_zero, add_zero]

end GeneralMatrix

/-! ## The one-sided Serre ideal and kernel of `toPresented` -/

/-- The Lie ideal of `FreeLieAlgebra K I` generated by the one-sided Serre relators
`(ad xᵢ) ^ (-Aᵢⱼ) ⁅xᵢ, xⱼ⁆`. -/
noncomputable def serreHalfIdeal (K : Type*) [CommRing K] {I : Type*} (A : Matrix I I ℤ) :
    LieIdeal K (FreeLieAlgebra K I) :=
  LieSubmodule.lieSpan K (FreeLieAlgebra K I)
    {u | ∃ i j : I, u =
      (ad K (FreeLieAlgebra K I) (FreeLieAlgebra.of K i) ^ (-A i j).toNat)
        ⁅FreeLieAlgebra.of K i, FreeLieAlgebra.of K j⁆}

/-- Unfolding characterization of `serreHalfIdeal`. -/
theorem serreHalfIdeal_def (K : Type*) [CommRing K] {I : Type*} (A : Matrix I I ℤ) :
    serreHalfIdeal K A =
      LieSubmodule.lieSpan K (FreeLieAlgebra K I)
        {u | ∃ i j : I, u =
          (ad K (FreeLieAlgebra K I) (FreeLieAlgebra.of K i) ^ (-A i j).toNat)
            ⁅FreeLieAlgebra.of K i, FreeLieAlgebra.of K j⁆} := (rfl)

/-- Every one-sided Serre relator `(ad xᵢ) ^ (-Aᵢⱼ) ⁅xᵢ, xⱼ⁆` belongs to `serreHalfIdeal K A`. -/
theorem ad_pow_lie_of_mem_serreHalfIdeal (K : Type*) [CommRing K] {I : Type*}
    (A : Matrix I I ℤ) (i j : I) :
    (ad K (FreeLieAlgebra K I) (FreeLieAlgebra.of K i) ^ (-A i j).toNat)
      ⁅FreeLieAlgebra.of K i, FreeLieAlgebra.of K j⁆ ∈ serreHalfIdeal K A :=
  LieSubmodule.subset_lieSpan ⟨i, j, rfl⟩

section SerreIdealDecomposition

variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H] {A : Matrix I I ℤ}
  (R : CartanRealization (A.map (Int.cast : ℤ → K)) H)

/-- For a generalized Cartan matrix `A`, each node `i` gives an `sl₂` triple
`(auxCartanElement R (R.coroot i), auxPositiveGenerator R i, auxNegativeGenerator R i)` in
`AuxiliaryLieAlgebra R`. -/
theorem isSl2Triple_auxGenerators (hA : A.IsGeneralizedCartan) (i : I) :
    IsSl2Triple (auxCartanElement R (R.coroot i)) (auxPositiveGenerator R i)
      (auxNegativeGenerator R i) where
  h_ne_zero := (map_ne_zero_iff (auxCartanElement R) (auxCartanElement_injective R)).mpr
    (R.coroot_linearIndependent.ne_zero i)
  lie_e_f := lie_auxPositiveGenerator_auxNegativeGenerator_self R i
  lie_h_e_nsmul := by
    rw [lie_auxCartanElement_auxPositiveGenerator, R.root_coroot, Matrix.map_apply, hA.diag i,
      Int.cast_ofNat, two_smul, two_smul]
  lie_h_f_nsmul := by
    rw [lie_auxCartanElement_auxNegativeGenerator, R.root_coroot, Matrix.map_apply, hA.diag i,
      Int.cast_ofNat, two_smul, two_smul]

private theorem lie_auxNegativeGenerator_serreRelator_eq_zero (hA : A.IsGeneralizedCartan)
    (k i j : I) :
    ⁅auxNegativeGenerator R k,
      auxPositiveHom R ((ad K (FreeLieAlgebra K I) (FreeLieAlgebra.of K i) ^ (-A i j).toNat)
        ⁅FreeLieAlgebra.of K i, FreeLieAlgebra.of K j⁆)⁆ = 0 := by
  rw [LieHom.map_ad_pow, LieHom.map_lie, auxPositiveHom_of, auxPositiveHom_of]
  rcases eq_or_ne i j with rfl | hij
  · simp
  by_cases hki : k = i
  · subst hki
    rw [← ad_pow_succ_apply, ad_eq_toEnd]
    have hhv : ⁅auxCartanElement R (R.coroot k), auxPositiveGenerator R j⁆ =
        (A k j : K) • auxPositiveGenerator R j := by simp
    have hfv : ⁅auxNegativeGenerator R k, auxPositiveGenerator R j⁆ = 0 := by
      rw [← lie_skew, lie_auxPositiveGenerator_auxNegativeGenerator_of_ne R hij.symm, neg_zero]
    rw [(isSl2Triple_auxGenerators R hA k).lie_f_pow_succ_toEnd_e hhv hfv]
    have hcast : -(A k j : K) - ((-A k j).toNat : K) = 0 := by
      rw [← Int.cast_natCast, hA.natCast_toNat_neg_of_ne hij, Int.cast_neg, sub_self]
    rw [hcast, mul_zero, zero_smul]
  have hfk_ei : ⁅auxNegativeGenerator R k, auxPositiveGenerator R i⁆ = 0 := by
    rw [← lie_skew, lie_auxPositiveGenerator_auxNegativeGenerator_of_ne R (Ne.symm hki), neg_zero]
  have hcomm : Commute (ad K (AuxiliaryLieAlgebra R) (auxNegativeGenerator R k))
      (ad K (AuxiliaryLieAlgebra R) (auxPositiveGenerator R i)) := by
    ext w
    simp only [mul_apply_eq_comp, ad_apply]
    rw [leibniz_lie, hfk_ei, zero_lie, zero_add]
  have had_comm : ⁅auxNegativeGenerator R k,
      (ad K (AuxiliaryLieAlgebra R) (auxPositiveGenerator R i) ^ (-A i j).toNat)
        ⁅auxPositiveGenerator R i, auxPositiveGenerator R j⁆⁆ =
      (ad K (AuxiliaryLieAlgebra R) (auxPositiveGenerator R i) ^ (-A i j).toNat)
        ⁅auxNegativeGenerator R k, ⁅auxPositiveGenerator R i, auxPositiveGenerator R j⁆⁆ :=
    LinearMap.congr_fun (hcomm.pow_right (-A i j).toNat).eq _
  rw [had_comm]
  by_cases hkj : k = j
  · subst hkj
    have hinner : ⁅auxNegativeGenerator R k,
        ⁅auxPositiveGenerator R i, auxPositiveGenerator R k⁆⁆ =
        (A k i : K) • auxPositiveGenerator R i := by
      rw [leibniz_lie, hfk_ei, zero_lie, zero_add,
        ← lie_skew (auxNegativeGenerator R k) (auxPositiveGenerator R k),
        lie_auxPositiveGenerator_auxNegativeGenerator_self, lie_neg,
        ← lie_skew (auxPositiveGenerator R i), neg_neg,
        lie_auxCartanElement_auxPositiveGenerator, R.root_coroot, Matrix.map_apply]
    rw [hinner, map_smul]
    by_cases h0 : A i k = 0
    · rw [(hA.zero_comm i k).mp h0, Int.cast_zero, zero_smul]
    · have hm : (-A i k).toNat ≠ 0 := by
        have hpos : 0 < -A i k := neg_pos.mpr (hA.neg_of_ne_of_ne_zero hij h0)
        exact (Int.pos_iff_toNat_pos.mp hpos).ne'
      obtain ⟨n, hn⟩ := Nat.exists_eq_succ_of_ne_zero hm
      rw [hn, ad_pow_succ_apply, lie_self, map_zero, smul_zero]
  · have hfk_ej : ⁅auxNegativeGenerator R k, auxPositiveGenerator R j⁆ = 0 := by
      rw [← lie_skew, lie_auxPositiveGenerator_auxNegativeGenerator_of_ne R (Ne.symm hkj),
        neg_zero]
    rw [leibniz_lie, hfk_ei, hfk_ej, zero_lie, lie_zero, add_zero, map_zero]

private theorem lie_auxPositiveHom_mem_map_serreHalfIdeal (v : FreeLieAlgebra K I)
    {y : AuxiliaryLieAlgebra R}
    (hy : y ∈ (serreHalfIdeal K A).toSubmodule.map (auxPositiveHom R).toLinearMap) :
    ⁅auxPositiveHom R v, y⁆ ∈
      (serreHalfIdeal K A).toSubmodule.map (auxPositiveHom R).toLinearMap := by
  obtain ⟨u, hu, rfl⟩ := hy
  exact ⟨⁅v, u⁆, (serreHalfIdeal K A).lie_mem hu, (auxPositiveHom R).map_lie v u⟩

private theorem lie_auxCartanElement_mem_map_serreHalfIdeal (x : H)
    {u : FreeLieAlgebra K I} (hu : u ∈ serreHalfIdeal K A) :
    ⁅auxCartanElement R x, auxPositiveHom R u⁆ ∈
      (serreHalfIdeal K A).toSubmodule.map (auxPositiveHom R).toLinearMap := by
  induction hu using LieSubmodule.lieSpan_induction generalizing x with
  | mem w hw =>
    obtain ⟨i, j, rfl⟩ := hw
    have hw_mem : auxPositiveHom R
        ((ad K (FreeLieAlgebra K I) (FreeLieAlgebra.of K i) ^ (-A i j).toNat)
          ⁅FreeLieAlgebra.of K i, FreeLieAlgebra.of K j⁆) ∈
        (serreHalfIdeal K A).toSubmodule.map (auxPositiveHom R).toLinearMap :=
      ⟨_, ad_pow_lie_of_mem_serreHalfIdeal K A i j, rfl⟩
    have hwt : ⁅auxCartanElement R x, auxPositiveHom R
        ((ad K (FreeLieAlgebra K I) (FreeLieAlgebra.of K i) ^ (-A i j).toNat)
          ⁅FreeLieAlgebra.of K i, FreeLieAlgebra.of K j⁆)⁆ =
        ((R.root i x + R.root j x) + ((-A i j).toNat : K) * R.root i x) •
          auxPositiveHom R ((ad K (FreeLieAlgebra K I) (FreeLieAlgebra.of K i) ^ (-A i j).toNat)
            ⁅FreeLieAlgebra.of K i, FreeLieAlgebra.of K j⁆) := by
      rw [LieHom.map_ad_pow, LieHom.map_lie, auxPositiveHom_of, auxPositiveHom_of, ad_eq_toEnd]
      refine lie_pow_toEnd_eq_smul ?_ (lie_auxCartanElement_auxPositiveGenerator R x i) _
      rw [leibniz_lie, lie_auxCartanElement_auxPositiveGenerator,
        lie_auxCartanElement_auxPositiveGenerator, smul_lie, lie_smul, add_smul]
    rw [hwt]
    exact Submodule.smul_mem _ _ hw_mem
  | zero => simp
  | add _ _ _ _ ha hb =>
    rw [map_add, lie_add]
    exact add_mem (ha x) (hb x)
  | smul c _ _ ha =>
    rw [map_smul, lie_smul]
    exact Submodule.smul_mem _ c (ha x)
  | lie v w hw ih =>
    rw [LieHom.map_lie, leibniz_lie]
    obtain ⟨v', hv'⟩ := lie_mem_range_auxPositiveHom_of_mem_range_auxCartanElement R ⟨x, rfl⟩
      ⟨v, rfl⟩
    simp only [LieHom.coe_toLinearMap] at hv'
    rw [← hv']
    exact add_mem
      (lie_auxPositiveHom_mem_map_serreHalfIdeal R v' ⟨w, hw, rfl⟩)
      (lie_auxPositiveHom_mem_map_serreHalfIdeal R v (ih x))

private theorem lie_auxNegativeGenerator_mem_map_serreHalfIdeal (hA : A.IsGeneralizedCartan)
    (k : I) {u : FreeLieAlgebra K I} (hu : u ∈ serreHalfIdeal K A) :
    ⁅auxNegativeGenerator R k, auxPositiveHom R u⁆ ∈
      (serreHalfIdeal K A).toSubmodule.map (auxPositiveHom R).toLinearMap := by
  induction hu using LieSubmodule.lieSpan_induction generalizing k with
  | mem w hw =>
    obtain ⟨i, j, rfl⟩ := hw
    rw [lie_auxNegativeGenerator_serreRelator_eq_zero R hA k i j]
    exact zero_mem _
  | zero => simp
  | add _ _ _ _ ha hb =>
    rw [map_add, lie_add]
    exact add_mem (ha k) (hb k)
  | smul c _ _ ha =>
    rw [map_smul, lie_smul]
    exact Submodule.smul_mem _ c (ha k)
  | lie v w hw ih =>
    rw [LieHom.map_lie, leibniz_lie]
    obtain ⟨p, ⟨v', rfl⟩, _, ⟨y, rfl⟩, hp⟩ :=
      Submodule.mem_sup.1 (lie_auxNegative_mem_sup R k ⟨v, rfl⟩)
    simp only [LieHom.coe_toLinearMap] at hp
    rw [← hp, add_lie]
    exact add_mem
      (add_mem (lie_auxPositiveHom_mem_map_serreHalfIdeal R v' ⟨w, hw, rfl⟩)
        (lie_auxCartanElement_mem_map_serreHalfIdeal R y hw))
      (lie_auxPositiveHom_mem_map_serreHalfIdeal R v (ih k))

private noncomputable def auxPositiveSerreIdeal (hA : A.IsGeneralizedCartan) :
    LieIdeal K (AuxiliaryLieAlgebra R) :=
  { (serreHalfIdeal K A).toSubmodule.map (auxPositiveHom R).toLinearMap with
    lie_mem := fun {z m} hm => by
      have hz : z ∈ LieSubalgebra.lieSpan K (AuxiliaryLieAlgebra R)
          (Set.range (auxCartanElement R) ∪ Set.range (auxPositiveGenerator R) ∪
            Set.range (auxNegativeGenerator R)) :=
        lieSpan_auxGenerators_eq_top R ▸ LieSubalgebra.mem_top z
      induction hz using LieSubalgebra.lieSpan_induction generalizing m with
      | mem g hg =>
        obtain ⟨u, hu, rfl⟩ := hm
        rcases hg with (⟨x, rfl⟩ | ⟨i, rfl⟩) | ⟨k, rfl⟩
        · exact lie_auxCartanElement_mem_map_serreHalfIdeal R x hu
        · rw [← auxPositiveHom_of]
          exact lie_auxPositiveHom_mem_map_serreHalfIdeal R (FreeLieAlgebra.of K i) ⟨u, hu, rfl⟩
        · exact lie_auxNegativeGenerator_mem_map_serreHalfIdeal R hA k hu
      | zero => rw [zero_lie]; exact Submodule.zero_mem _
      | add _ _ _ _ ha hb => rw [add_lie]; exact Submodule.add_mem _ (ha hm) (hb hm)
      | smul c _ _ ha => rw [smul_lie]; exact Submodule.smul_mem _ c (ha hm)
      | lie _ _ _ _ ha hb => rw [lie_lie]; exact Submodule.sub_mem _ (ha (hb hm)) (hb (ha hm)) }

private theorem signAut_mem_serreHalfIdeal {u : FreeLieAlgebra K I}
    (hu : u ∈ serreHalfIdeal K A) :
    FreeLieAlgebra.lift K (fun i => -FreeLieAlgebra.of K i) u ∈ serreHalfIdeal K A := by
  induction hu using LieSubmodule.lieSpan_induction with
  | mem w hw =>
    obtain ⟨i, j, rfl⟩ := hw
    have hneg : ad K (FreeLieAlgebra K I) (-FreeLieAlgebra.of K i) =
        (-1 : K) • ad K (FreeLieAlgebra K I) (FreeLieAlgebra.of K i) := by
      rw [map_neg, neg_smul, one_smul]
    rw [LieHom.map_ad_pow, LieHom.map_lie]
    simp only [FreeLieAlgebra.lift_of_apply, neg_lie, lie_neg, neg_neg, hneg, smul_pow,
      LinearMap.smul_apply]
    exact Submodule.smul_mem _ _ (ad_pow_lie_of_mem_serreHalfIdeal K A i j)
  | zero => simp
  | add _ _ _ _ ha hb => rw [map_add]; exact add_mem ha hb
  | smul c _ _ ha => rw [map_smul]; exact Submodule.smul_mem _ c ha
  | lie v _ _ ih => rw [LieHom.map_lie]; exact (serreHalfIdeal K A).lie_mem ih

private theorem map_auxChevalleyInvolution_auxPositiveSerreIdeal
    (hA : A.IsGeneralizedCartan) :
    ((auxPositiveSerreIdeal R hA).toSubmodule).map
        (auxChevalleyInvolution R).toLinearEquiv.toLinearMap =
      (serreHalfIdeal K A).toSubmodule.map (auxNegativeHom R).toLinearMap := by
  let σ := FreeLieAlgebra.lift K (fun i : I => -FreeLieAlgebra.of K i)
  have hσ_inv : σ.comp σ = LieHom.id := FreeLieAlgebra.hom_ext fun i => by simp [σ]
  ext z
  simp only [auxPositiveSerreIdeal, Submodule.mem_map,
    LieHom.coe_toLinearMap, LinearEquiv.coe_coe, LieEquiv.coe_toLinearEquiv]
  constructor
  · rintro ⟨_, ⟨u, hu, rfl⟩, rfl⟩
    exact ⟨σ u, signAut_mem_serreHalfIdeal hu, (auxChevalleyInvolution_auxPositiveHom R u).symm⟩
  · rintro ⟨u, hu, rfl⟩
    refine ⟨auxPositiveHom R (σ u), ⟨σ u, signAut_mem_serreHalfIdeal hu, rfl⟩, ?_⟩
    rw [auxChevalleyInvolution_auxPositiveHom]
    exact congrArg (auxNegativeHom R) (DFunLike.congr_fun hσ_inv u)

private theorem lie_mem_map_auxNegativeHom_serreHalfIdeal (hA : A.IsGeneralizedCartan)
    (x : AuxiliaryLieAlgebra R) {y : AuxiliaryLieAlgebra R}
    (hy : y ∈ (serreHalfIdeal K A).toSubmodule.map (auxNegativeHom R).toLinearMap) :
    ⁅x, y⁆ ∈ (serreHalfIdeal K A).toSubmodule.map (auxNegativeHom R).toLinearMap := by
  rw [← map_auxChevalleyInvolution_auxPositiveSerreIdeal R hA] at hy ⊢
  obtain ⟨y', hy', rfl⟩ := hy
  refine ⟨⁅auxChevalleyInvolution R x, y'⁆, (auxPositiveSerreIdeal R hA).lie_mem hy', ?_⟩
  simp [LieEquiv.map_lie]

private noncomputable def auxNegativeSerreIdeal (hA : A.IsGeneralizedCartan) :
    LieIdeal K (AuxiliaryLieAlgebra R) :=
  { (serreHalfIdeal K A).toSubmodule.map (auxNegativeHom R).toLinearMap with
    lie_mem := fun {x _} hy => lie_mem_map_auxNegativeHom_serreHalfIdeal R hA x hy }

private theorem serreHalfIdeal_le_ker_lift_positiveGenerator :
    serreHalfIdeal K A ≤ (FreeLieAlgebra.lift K (positiveGenerator R)).ker := by
  refine LieSubmodule.lieSpan_le.mpr ?_
  rintro _ ⟨i, j, rfl⟩
  simp only [SetLike.mem_coe, LieHom.mem_ker, LieHom.map_ad_pow, LieHom.map_lie,
    FreeLieAlgebra.lift_of_apply, ad_pow_lie_positiveGenerator_positiveGenerator]

private theorem serreHalfIdeal_le_ker_lift_negativeGenerator :
    serreHalfIdeal K A ≤ (FreeLieAlgebra.lift K (negativeGenerator R)).ker := by
  refine LieSubmodule.lieSpan_le.mpr ?_
  rintro _ ⟨i, j, rfl⟩
  simp only [SetLike.mem_coe, LieHom.mem_ker, LieHom.map_ad_pow, LieHom.map_lie,
    FreeLieAlgebra.lift_of_apply, ad_pow_lie_negativeGenerator_negativeGenerator]

private theorem ker_toPresented_eq_sup (hA : A.IsGeneralizedCartan) :
    (toPresented R).ker = auxNegativeSerreIdeal R hA ⊔ auxPositiveSerreIdeal R hA := by
  set J := auxNegativeSerreIdeal R hA ⊔ auxPositiveSerreIdeal R hA
  refine le_antisymm ?_ (sup_le ?_ ?_)
  · let q := J.mkQ
    have hsat : SatisfiesRelations R (q.toLinearMap ∘ₗ auxCartanElement R)
        (q ∘ auxPositiveGenerator R) (q ∘ auxNegativeGenerator R) :=
      { lie_cartan_cartan x y := by simp [← LieHom.map_lie]
        lie_cartan_positive x j := by simp [← LieHom.map_lie]
        lie_cartan_negative x j := by simp [← LieHom.map_lie]
        lie_positive_negative_self i := by simp [← LieHom.map_lie]
        lie_positive_negative_of_ne i j hij := by
          simp [← LieHom.map_lie, lie_auxPositiveGenerator_auxNegativeGenerator_of_ne R hij]
        serre_positive i j := by
          simp only [Function.comp_apply, ← LieHom.map_lie, ← LieHom.map_ad_pow]
          rw [← auxPositiveHom_of R i, ← auxPositiveHom_of R j, ← LieHom.map_lie,
            ← LieHom.map_ad_pow, ← LieHom.mem_ker, LieIdeal.mkQ_ker]
          exact LieSubmodule.mem_sup_right ⟨_, ad_pow_lie_of_mem_serreHalfIdeal K A i j, rfl⟩
        serre_negative i j := by
          simp only [Function.comp_apply, ← LieHom.map_lie, ← LieHom.map_ad_pow]
          rw [← auxNegativeHom_of R i, ← auxNegativeHom_of R j, ← LieHom.map_lie,
            ← LieHom.map_ad_pow, ← LieHom.mem_ker, LieIdeal.mkQ_ker]
          exact LieSubmodule.mem_sup_left ⟨_, ad_pow_lie_of_mem_serreHalfIdeal K A i j, rfl⟩ }
    have hsec : (lift hsat).comp (toPresented R) = q := by ext <;> simp
    intro z hz
    rw [LieHom.mem_ker] at hz
    have hqz : q z = 0 := by rw [← hsec, LieHom.comp_apply, hz, map_zero]
    rwa [← LieHom.mem_ker, LieIdeal.mkQ_ker] at hqz
  · rintro _ ⟨u, hu, rfl⟩
    rw [LieHom.mem_ker, LieHom.coe_toLinearMap, ← LieHom.comp_apply,
      toPresented_comp_auxNegativeHom]
    exact serreHalfIdeal_le_ker_lift_negativeGenerator R hu
  · rintro _ ⟨u, hu, rfl⟩
    rw [LieHom.mem_ker, LieHom.coe_toLinearMap, ← LieHom.comp_apply,
      toPresented_comp_auxPositiveHom]
    exact serreHalfIdeal_le_ker_lift_positiveGenerator R hu

/-- An element `(uNeg, x, uPos)` of `FreeLieAlgebra K I × H × FreeLieAlgebra K I` maps to `0` in
`PresentedLieAlgebra R` if and only if `uNeg ∈ serreHalfIdeal K A`, `x = 0`, and
`uPos ∈ serreHalfIdeal K A`. -/
theorem toPresented_auxTriangularEquiv_eq_zero_iff (hA : A.IsGeneralizedCartan)
    {uNeg : FreeLieAlgebra K I} {x : H} {uPos : FreeLieAlgebra K I} :
    toPresented R (auxTriangularEquiv R (uNeg, x, uPos)) = 0 ↔
      uNeg ∈ serreHalfIdeal K A ∧ x = 0 ∧ uPos ∈ serreHalfIdeal K A := by
  rw [← LieHom.mem_ker, ker_toPresented_eq_sup R hA, ← LieSubmodule.mem_toSubmodule,
    LieSubmodule.sup_toSubmodule]
  constructor
  · intro hmem
    obtain ⟨_, ⟨vNeg, hvNeg, rfl⟩, _, ⟨vPos, hvPos, rfl⟩, heq⟩ := Submodule.mem_sup.1 hmem
    have hinj : auxTriangularMap R (uNeg, x, uPos) = auxTriangularMap R (vNeg, 0, vPos) := by
      simpa [auxTriangularMap_apply] using heq.symm
    have hprod := auxTriangularMap_injective R hinj
    obtain ⟨rfl, rfl, rfl⟩ : uNeg = vNeg ∧ x = 0 ∧ uPos = vPos := by
      simpa [Prod.ext_iff] using hprod
    exact ⟨hvNeg, rfl, hvPos⟩
  · rintro ⟨huNeg, rfl, huPos⟩
    simp only [auxTriangularEquiv_apply, map_zero, add_zero]
    exact Submodule.add_mem_sup ⟨uNeg, huNeg, rfl⟩ ⟨uPos, huPos, rfl⟩

end SerreIdealDecomposition

/-! ## Cartan injectivity and triangular decomposition of `PresentedLieAlgebra R` -/

section GeneralizedCartan

variable {I K H : Type*} [Field K] [AddCommGroup H] [Module K H] {A : Matrix I I ℤ}
  (R : CartanRealization (A.map (Int.cast : ℤ → K)) H)

/-- **Cartan injectivity for Kac–Moody Lie algebras** [Kac, §1.3]: for any generalized Cartan
matrix `A` and realization `R` on `H`, the canonical map `H →ₗ[K] PresentedLieAlgebra R` is
injective. -/
theorem cartanElement_injective (hA : A.IsGeneralizedCartan) :
    Function.Injective (cartanElement R) := by
  rw [injective_iff_map_eq_zero]
  intro x hx
  have h0 : toPresented R (auxTriangularEquiv R (0, x, 0)) = 0 := by simpa using hx
  exact ((toPresented_auxTriangularEquiv_eq_zero_iff R hA).mp h0).2.1

/-- The linear isomorphism between the realization `H` and `cartanSubalgebra R`. -/
noncomputable def cartanEquiv (hA : A.IsGeneralizedCartan) : H ≃ₗ[K] cartanSubalgebra R :=
  LinearEquiv.ofInjective (cartanElement R) (cartanElement_injective R hA)

@[simp]
theorem coe_cartanEquiv_apply (hA : A.IsGeneralizedCartan) (x : H) :
    (cartanEquiv R hA x : PresentedLieAlgebra R) = cartanElement R x := (rfl)

@[simp]
theorem cartanEquiv_symm_cartanElement (hA : A.IsGeneralizedCartan) (x : H) :
    (cartanEquiv R hA).symm ⟨cartanElement R x, cartanElement_mem_cartanSubalgebra R x⟩ = x :=
  (cartanEquiv R hA).symm_apply_eq.mpr rfl

/-- When the index type `I` is empty, `cartanElement R` is a linear equivalence
`H ≃ₗ[K] PresentedLieAlgebra R`. -/
noncomputable def cartanElementEquivOfIsEmpty [IsEmpty I] :
    H ≃ₗ[K] PresentedLieAlgebra R :=
  LinearEquiv.ofBijective (cartanElement R)
    ⟨cartanElement_injective R (Matrix.isGeneralizedCartan_of_isEmpty A), fun z => by
      obtain ⟨⟨⟨yNeg, hyNeg⟩, x, ⟨yPos, hyPos⟩⟩, rfl⟩ := triangularMap_surjective R z
      have hpos : positiveSubalgebra R = ⊥ := by
        simp [positiveSubalgebra, Set.range_eq_empty]
      have hneg : negativeSubalgebra R = ⊥ := by
        simp [negativeSubalgebra, Set.range_eq_empty]
      rw [hneg, LieSubalgebra.mem_bot] at hyNeg
      rw [hpos, LieSubalgebra.mem_bot] at hyPos
      exact ⟨x, by simp [hyNeg, hyPos]⟩⟩

@[simp]
theorem cartanElementEquivOfIsEmpty_apply [IsEmpty I] (x : H) :
    cartanElementEquivOfIsEmpty R x = cartanElement R x := (rfl)

@[simp]
theorem cartanElementEquivOfIsEmpty_symm_cartanElement [IsEmpty I] (x : H) :
    (cartanElementEquivOfIsEmpty R).symm (cartanElement R x) = x :=
  (cartanElementEquivOfIsEmpty R).symm_apply_eq.mpr rfl

/-- When `I` is empty, `PresentedLieAlgebra R` is abelian. -/
instance isLieAbelian_of_isEmpty [IsEmpty I] : IsLieAbelian (PresentedLieAlgebra R) := by
  constructor
  intro y z
  obtain ⟨u, rfl⟩ := (cartanElementEquivOfIsEmpty R).surjective y
  obtain ⟨v, rfl⟩ := (cartanElementEquivOfIsEmpty R).surjective z
  exact lie_cartanElement_cartanElement R u v

/-- The kernel of `FreeLieAlgebra.lift K (positiveGenerator R)` is the one-sided Serre ideal
`serreHalfIdeal K A` [Kac, §1.3]. -/
theorem ker_lift_positiveGenerator (hA : A.IsGeneralizedCartan) :
    (FreeLieAlgebra.lift K (positiveGenerator R)).ker = serreHalfIdeal K A := by
  ext u
  rw [LieHom.mem_ker, ← toPresented_comp_auxPositiveHom, LieHom.comp_apply]
  have heq : auxPositiveHom R u = auxTriangularEquiv R (0, 0, u) := by simp
  rw [heq, toPresented_auxTriangularEquiv_eq_zero_iff R hA]
  simp

/-- The kernel of `FreeLieAlgebra.lift K (negativeGenerator R)` is the one-sided Serre ideal
`serreHalfIdeal K A` [Kac, §1.3]. -/
theorem ker_lift_negativeGenerator (hA : A.IsGeneralizedCartan) :
    (FreeLieAlgebra.lift K (negativeGenerator R)).ker = serreHalfIdeal K A := by
  ext u
  rw [LieHom.mem_ker, ← toPresented_comp_auxNegativeHom, LieHom.comp_apply]
  have heq : auxNegativeHom R u = auxTriangularEquiv R (u, 0, 0) := by simp
  rw [heq, toPresented_auxTriangularEquiv_eq_zero_iff R hA]
  simp

private noncomputable def liftToPositiveSubalgebra :
    FreeLieAlgebra K I →ₗ⁅K⁆ positiveSubalgebra R :=
  FreeLieAlgebra.lift K fun i =>
    ⟨positiveGenerator R i, positiveGenerator_mem_positiveSubalgebra R i⟩

private theorem incl_comp_liftToPositiveSubalgebra :
    (positiveSubalgebra R).incl.comp (liftToPositiveSubalgebra R) =
      FreeLieAlgebra.lift K (positiveGenerator R) :=
  FreeLieAlgebra.hom_ext fun i => by simp [liftToPositiveSubalgebra]

private theorem ker_liftToPositiveSubalgebra (hA : A.IsGeneralizedCartan) :
    (liftToPositiveSubalgebra R).ker = serreHalfIdeal K A := by
  rw [← ker_lift_positiveGenerator R hA, ← incl_comp_liftToPositiveSubalgebra]
  ext u
  simp

private theorem liftToPositiveSubalgebra_surjective :
    Function.Surjective (liftToPositiveSubalgebra R) := by
  rintro ⟨z, hz⟩
  rw [← range_lift_positiveGenerator] at hz
  obtain ⟨u, rfl⟩ := hz
  exact ⟨u, Subtype.ext (DFunLike.congr_fun (incl_comp_liftToPositiveSubalgebra R) u)⟩

/-- The raising subalgebra `n⁺` is presented as a Lie algebra by the positive Serre relations
alone. -/
noncomputable def positiveSubalgebraEquiv (hA : A.IsGeneralizedCartan) :
    (FreeLieAlgebra K I ⧸ serreHalfIdeal K A) ≃ₗ⁅K⁆ positiveSubalgebra R :=
  ((serreHalfIdeal K A).quotEquivOfEq _ (ker_liftToPositiveSubalgebra R hA).symm).trans
    ((liftToPositiveSubalgebra R).quotKerEquivOfSurjective (liftToPositiveSubalgebra_surjective R))

@[simp]
theorem coe_positiveSubalgebraEquiv_mk (hA : A.IsGeneralizedCartan) (u : FreeLieAlgebra K I) :
    (positiveSubalgebraEquiv R hA (LieSubmodule.Quotient.mk u) : PresentedLieAlgebra R) =
      FreeLieAlgebra.lift K (positiveGenerator R) u := by
  simpa [positiveSubalgebraEquiv] using
    DFunLike.congr_fun (incl_comp_liftToPositiveSubalgebra R) u

@[simp]
theorem positiveSubalgebraEquiv_symm_positiveGenerator (hA : A.IsGeneralizedCartan) (i : I) :
    (positiveSubalgebraEquiv R hA).symm
        ⟨positiveGenerator R i, positiveGenerator_mem_positiveSubalgebra R i⟩ =
      LieSubmodule.Quotient.mk (FreeLieAlgebra.of K i) :=
  (positiveSubalgebraEquiv R hA).symm_apply_eq.mpr (Subtype.ext (by simp))

private noncomputable def liftToNegativeSubalgebra :
    FreeLieAlgebra K I →ₗ⁅K⁆ negativeSubalgebra R :=
  FreeLieAlgebra.lift K fun i =>
    ⟨negativeGenerator R i, negativeGenerator_mem_negativeSubalgebra R i⟩

private theorem incl_comp_liftToNegativeSubalgebra :
    (negativeSubalgebra R).incl.comp (liftToNegativeSubalgebra R) =
      FreeLieAlgebra.lift K (negativeGenerator R) :=
  FreeLieAlgebra.hom_ext fun i => by simp [liftToNegativeSubalgebra]

private theorem ker_liftToNegativeSubalgebra (hA : A.IsGeneralizedCartan) :
    (liftToNegativeSubalgebra R).ker = serreHalfIdeal K A := by
  rw [← ker_lift_negativeGenerator R hA, ← incl_comp_liftToNegativeSubalgebra]
  ext u
  simp

private theorem liftToNegativeSubalgebra_surjective :
    Function.Surjective (liftToNegativeSubalgebra R) := by
  rintro ⟨z, hz⟩
  rw [← range_lift_negativeGenerator] at hz
  obtain ⟨u, rfl⟩ := hz
  exact ⟨u, Subtype.ext (DFunLike.congr_fun (incl_comp_liftToNegativeSubalgebra R) u)⟩

/-- The lowering subalgebra `n⁻` is presented as a Lie algebra by the negative Serre relations
alone. -/
noncomputable def negativeSubalgebraEquiv (hA : A.IsGeneralizedCartan) :
    (FreeLieAlgebra K I ⧸ serreHalfIdeal K A) ≃ₗ⁅K⁆ negativeSubalgebra R :=
  ((serreHalfIdeal K A).quotEquivOfEq _ (ker_liftToNegativeSubalgebra R hA).symm).trans
    ((liftToNegativeSubalgebra R).quotKerEquivOfSurjective (liftToNegativeSubalgebra_surjective R))

@[simp]
theorem coe_negativeSubalgebraEquiv_mk (hA : A.IsGeneralizedCartan) (u : FreeLieAlgebra K I) :
    (negativeSubalgebraEquiv R hA (LieSubmodule.Quotient.mk u) : PresentedLieAlgebra R) =
      FreeLieAlgebra.lift K (negativeGenerator R) u := by
  simpa [negativeSubalgebraEquiv] using
    DFunLike.congr_fun (incl_comp_liftToNegativeSubalgebra R) u

@[simp]
theorem negativeSubalgebraEquiv_symm_negativeGenerator (hA : A.IsGeneralizedCartan) (i : I) :
    (negativeSubalgebraEquiv R hA).symm
        ⟨negativeGenerator R i, negativeGenerator_mem_negativeSubalgebra R i⟩ =
      LieSubmodule.Quotient.mk (FreeLieAlgebra.of K i) :=
  (negativeSubalgebraEquiv R hA).symm_apply_eq.mpr (Subtype.ext (by simp))

/-- **Triangular injectivity** [Kac, §1.3]: `(yNeg, x, yPos) ↦ yNeg + cartanElement x + yPos` is
injective on `negativeSubalgebra R × H × positiveSubalgebra R`. -/
theorem triangularMap_injective (hA : A.IsGeneralizedCartan) :
    Function.Injective (triangularMap R) := by
  rw [injective_iff_map_eq_zero]
  rintro ⟨⟨yNeg, hyNeg⟩, x, ⟨yPos, hyPos⟩⟩ h0
  rw [← range_lift_negativeGenerator] at hyNeg
  rw [← range_lift_positiveGenerator] at hyPos
  obtain ⟨uNeg, rfl⟩ := hyNeg
  obtain ⟨uPos, rfl⟩ := hyPos
  have haux : toPresented R (auxTriangularEquiv R (uNeg, x, uPos)) = 0 := by
    have hN : toPresented R (auxNegativeHom R uNeg) =
        FreeLieAlgebra.lift K (negativeGenerator R) uNeg :=
      DFunLike.congr_fun (toPresented_comp_auxNegativeHom R) uNeg
    have hP : toPresented R (auxPositiveHom R uPos) =
        FreeLieAlgebra.lift K (positiveGenerator R) uPos :=
      DFunLike.congr_fun (toPresented_comp_auxPositiveHom R) uPos
    rw [auxTriangularEquiv_apply, map_add, map_add, toPresented_auxCartanElement, hN, hP]
    exact h0
  obtain ⟨huNeg, rfl, huPos⟩ := (toPresented_auxTriangularEquiv_eq_zero_iff R hA).mp haux
  rw [← ker_lift_negativeGenerator R hA, LieHom.mem_ker] at huNeg
  rw [← ker_lift_positiveGenerator R hA, LieHom.mem_ker] at huPos
  ext <;> simp [huNeg, huPos]

/-- **Triangular decomposition of `PresentedLieAlgebra R`** [Kac, §1.3]:
`PresentedLieAlgebra R` decomposes as the `K`-linear direct sum `n⁻ ⊕ H ⊕ n⁺`. -/
noncomputable def triangularEquiv (hA : A.IsGeneralizedCartan) :
    (negativeSubalgebra R × H × positiveSubalgebra R) ≃ₗ[K] PresentedLieAlgebra R :=
  LinearEquiv.ofBijective (triangularMap R)
    ⟨triangularMap_injective R hA, triangularMap_surjective R⟩

@[simp]
theorem triangularEquiv_apply (hA : A.IsGeneralizedCartan) (yNeg : negativeSubalgebra R) (x : H)
    (yPos : positiveSubalgebra R) :
    triangularEquiv R hA (yNeg, x, yPos) = yNeg.1 + cartanElement R x + yPos.1 := (rfl)

@[simp]
theorem triangularEquiv_symm_coe_negativeSubalgebra (hA : A.IsGeneralizedCartan)
    (y : negativeSubalgebra R) :
    (triangularEquiv R hA).symm y = (y, 0, 0) :=
  (triangularEquiv R hA).symm_apply_eq.mpr (by simp)

@[simp]
theorem triangularEquiv_symm_cartanElement (hA : A.IsGeneralizedCartan) (x : H) :
    (triangularEquiv R hA).symm (cartanElement R x) = (0, x, 0) :=
  (triangularEquiv R hA).symm_apply_eq.mpr (by simp)

@[simp]
theorem triangularEquiv_symm_coe_positiveSubalgebra (hA : A.IsGeneralizedCartan)
    (y : positiveSubalgebra R) :
    (triangularEquiv R hA).symm y = (0, 0, y) :=
  (triangularEquiv R hA).symm_apply_eq.mpr (by simp)

/-- Projection of `PresentedLieAlgebra R` onto `negativeSubalgebra R` along `H ⊕ n⁺`. -/
noncomputable def negativePart (hA : A.IsGeneralizedCartan) :
    PresentedLieAlgebra R →ₗ[K] negativeSubalgebra R :=
  (LinearMap.fst K _ _) ∘ₗ (triangularEquiv R hA).symm.toLinearMap

/-- Projection of `PresentedLieAlgebra R` onto `H` along `n⁻ ⊕ n⁺`. -/
noncomputable def cartanPart (hA : A.IsGeneralizedCartan) :
    PresentedLieAlgebra R →ₗ[K] H :=
  (LinearMap.fst K H _) ∘ₗ (LinearMap.snd K _ _) ∘ₗ (triangularEquiv R hA).symm.toLinearMap

/-- Projection of `PresentedLieAlgebra R` onto `positiveSubalgebra R` along `n⁻ ⊕ H`. -/
noncomputable def positivePart (hA : A.IsGeneralizedCartan) :
    PresentedLieAlgebra R →ₗ[K] positiveSubalgebra R :=
  (LinearMap.snd K H _) ∘ₗ (LinearMap.snd K _ _) ∘ₗ (triangularEquiv R hA).symm.toLinearMap

@[simp]
theorem negativePart_add_cartanElement_cartanPart_add_positivePart (hA : A.IsGeneralizedCartan)
    (z : PresentedLieAlgebra R) :
    (negativePart R hA z : PresentedLieAlgebra R) + cartanElement R (cartanPart R hA z) +
      (positivePart R hA z : PresentedLieAlgebra R) = z :=
  (triangularEquiv R hA).apply_symm_apply z

@[simp]
theorem negativePart_coe_negativeSubalgebra (hA : A.IsGeneralizedCartan)
    (y : negativeSubalgebra R) :
    negativePart R hA y = y := by simp [negativePart]

@[simp]
theorem negativePart_cartanElement (hA : A.IsGeneralizedCartan) (x : H) :
    negativePart R hA (cartanElement R x) = 0 := by simp [negativePart]

@[simp]
theorem negativePart_coe_positiveSubalgebra (hA : A.IsGeneralizedCartan)
    (y : positiveSubalgebra R) :
    negativePart R hA y = 0 := by simp [negativePart]

@[simp]
theorem cartanPart_coe_negativeSubalgebra (hA : A.IsGeneralizedCartan)
    (y : negativeSubalgebra R) :
    cartanPart R hA y = 0 := by simp [cartanPart]

@[simp]
theorem cartanPart_cartanElement (hA : A.IsGeneralizedCartan) (x : H) :
    cartanPart R hA (cartanElement R x) = x := by simp [cartanPart]

@[simp]
theorem cartanPart_coe_positiveSubalgebra (hA : A.IsGeneralizedCartan)
    (y : positiveSubalgebra R) :
    cartanPart R hA y = 0 := by simp [cartanPart]

@[simp]
theorem positivePart_coe_negativeSubalgebra (hA : A.IsGeneralizedCartan)
    (y : negativeSubalgebra R) :
    positivePart R hA y = 0 := by simp [positivePart]

@[simp]
theorem positivePart_cartanElement (hA : A.IsGeneralizedCartan) (x : H) :
    positivePart R hA (cartanElement R x) = 0 := by simp [positivePart]

@[simp]
theorem positivePart_coe_positiveSubalgebra (hA : A.IsGeneralizedCartan)
    (y : positiveSubalgebra R) :
    positivePart R hA y = y := by simp [positivePart]

/-- `cartanPart R hA` vanishes on `positiveSubalgebra R`. -/
theorem cartanPart_of_mem_positiveSubalgebra (hA : A.IsGeneralizedCartan)
    {z : PresentedLieAlgebra R} (hz : z ∈ positiveSubalgebra R) :
    cartanPart R hA z = 0 :=
  cartanPart_coe_positiveSubalgebra R hA ⟨z, hz⟩

/-- `cartanPart R hA` vanishes on `negativeSubalgebra R`. -/
theorem cartanPart_of_mem_negativeSubalgebra (hA : A.IsGeneralizedCartan)
    {z : PresentedLieAlgebra R} (hz : z ∈ negativeSubalgebra R) :
    cartanPart R hA z = 0 :=
  cartanPart_coe_negativeSubalgebra R hA ⟨z, hz⟩

/-- `negativeSubalgebra R` is disjoint from `cartanSubalgebra R ⊔ positiveSubalgebra R`. -/
theorem disjoint_negativeSubalgebra_cartanSubalgebra_sup_positiveSubalgebra
    (hA : A.IsGeneralizedCartan) :
    Disjoint (negativeSubalgebra R).toSubmodule
      ((cartanSubalgebra R).toSubmodule ⊔ (positiveSubalgebra R).toSubmodule) := by
  rw [Submodule.disjoint_def]
  intro z hzNeg hzHP
  obtain ⟨_, ⟨x, rfl⟩, yPos, hyPos, rfl⟩ := Submodule.mem_sup.1 hzHP
  have h : triangularMap R (⟨-(cartanElement R x + yPos), neg_mem hzNeg⟩, x, ⟨yPos, hyPos⟩) =
      triangularMap R (0, 0, 0) := by
    simp [triangularMap_apply]
  have hprod := triangularMap_injective R hA h
  obtain ⟨-, rfl, hy0⟩ :
      -(cartanElement R x + yPos) = 0 ∧ x = 0 ∧ yPos = 0 := by
    simpa [Prod.ext_iff, Subtype.ext_iff] using hprod
  simp [hy0]

/-- `cartanSubalgebra R` is disjoint from `positiveSubalgebra R`. -/
theorem disjoint_cartanSubalgebra_positiveSubalgebra (hA : A.IsGeneralizedCartan) :
    Disjoint (cartanSubalgebra R).toSubmodule (positiveSubalgebra R).toSubmodule := by
  rw [Submodule.disjoint_def]
  rintro _ ⟨x, rfl⟩ hzPos
  have h := cartanPart_of_mem_positiveSubalgebra R hA hzPos
  rw [cartanPart_cartanElement] at h
  simp [h]

/-! ## `sl₂` triples, linear independence of generators, and sharpness of Serre's exponents -/

/-- Every simple coroot maps to a nonzero element of `PresentedLieAlgebra R`. -/
theorem cartanElement_coroot_ne_zero (hA : A.IsGeneralizedCartan) (i : I) :
    cartanElement R (R.coroot i) ≠ 0 :=
  (map_ne_zero_iff (cartanElement R) (cartanElement_injective R hA)).mpr
    (R.coroot_linearIndependent.ne_zero i)

/-- For each node `i`, `(cartanElement R (R.coroot i), positiveGenerator R i,
negativeGenerator R i)` is an `sl₂` triple in `PresentedLieAlgebra R`. -/
theorem isSl2Triple_generators (hA : A.IsGeneralizedCartan) (i : I) :
    IsSl2Triple (cartanElement R (R.coroot i)) (positiveGenerator R i)
      (negativeGenerator R i) where
  h_ne_zero := cartanElement_coroot_ne_zero R hA i
  lie_e_f := lie_positiveGenerator_negativeGenerator_self R i
  lie_h_e_nsmul := by
    rw [lie_cartanElement_positiveGenerator, R.root_coroot, Matrix.map_apply, hA.diag i,
      Int.cast_ofNat, two_smul, two_smul]
  lie_h_f_nsmul := by
    rw [lie_cartanElement_negativeGenerator, R.root_coroot, Matrix.map_apply, hA.diag i,
      Int.cast_ofNat, two_smul, two_smul]

/-- Every raising Chevalley generator `eᵢ` is nonzero in `PresentedLieAlgebra R`. -/
theorem positiveGenerator_ne_zero (hA : A.IsGeneralizedCartan) (i : I) :
    positiveGenerator R i ≠ 0 :=
  (isSl2Triple_generators R hA i).e_ne_zero

/-- Every lowering Chevalley generator `fᵢ` is nonzero in `PresentedLieAlgebra R`. -/
theorem negativeGenerator_ne_zero (hA : A.IsGeneralizedCartan) (i : I) :
    negativeGenerator R i ≠ 0 :=
  (isSl2Triple_generators R hA i).f_ne_zero

/-- A Cartan element `cartanElement R x` lies in the center of `PresentedLieAlgebra R` if and only
if `x ∈ R.cartanCenter` (`∀ i, αᵢ(x) = 0`) [Kac, §1.3, Proposition 1.6]. -/
theorem cartanElement_mem_center_iff (hA : A.IsGeneralizedCartan) (x : H) :
    cartanElement R x ∈ LieAlgebra.center K (PresentedLieAlgebra R) ↔ x ∈ R.cartanCenter := by
  refine ⟨fun hc => (CartanRealization.mem_cartanCenter_iff R x).mpr fun i => ?_,
    cartanElement_mem_center_of_mem_cartanCenter R⟩
  have h0 : ⁅cartanElement R x, positiveGenerator R i⁆ = 0 := by
    rw [← lie_skew, (LieModule.mem_maxTrivSubmodule K _ _ _).mp hc (positiveGenerator R i),
      neg_zero]
  rw [lie_cartanElement_positiveGenerator, smul_eq_zero] at h0
  exact h0.resolve_right (positiveGenerator_ne_zero R hA i)

section AssociativeLieModel

attribute [local instance 100] LieRing.ofAssociativeRing

/-- The raising Chevalley generators `eᵢ` are `K`-linearly independent in
`PresentedLieAlgebra R`. -/
theorem linearIndependent_positiveGenerator (hA : A.IsGeneralizedCartan) :
    LinearIndependent K (positiveGenerator R) := by
  classical
  rw [linearIndependent_iff]
  intro l hl
  ext i₀
  let u : FreeLieAlgebra K I := l.sum fun j c => c • FreeLieAlgebra.of K j
  have hu_lift : FreeLieAlgebra.lift K (positiveGenerator R) u = 0 := by
    simpa [u, Finsupp.linearCombination_apply, map_finsuppSum] using hl
  have hu_mem : u ∈ serreHalfIdeal K A := by
    rwa [← ker_lift_positiveGenerator R hA, LieHom.mem_ker]
  let π : FreeLieAlgebra K I →ₗ⁅K⁆ K :=
    FreeLieAlgebra.lift K fun j => if j = i₀ then (1 : K) else 0
  have hker : serreHalfIdeal K A ≤ π.ker := by
    refine LieSubmodule.lieSpan_le.mpr ?_
    rintro _ ⟨i, j, rfl⟩
    have hcomm : π ⁅FreeLieAlgebra.of K i, FreeLieAlgebra.of K j⁆ = 0 := by
      rw [LieHom.map_lie, LieRing.of_associative_ring_bracket, mul_comm, sub_self]
    simp only [SetLike.mem_coe, LieHom.mem_ker, LieHom.map_ad_pow, hcomm, map_zero]
  have hπu : π u = 0 := hker hu_mem
  simpa [u, π, map_finsuppSum] using hπu

private def shiftMat (K : Type*) [Semiring K] (m : ℕ) : Matrix (Fin (m + 2)) (Fin (m + 2)) K :=
  Matrix.of fun a b => if (a : ℕ) = (b : ℕ) + 1 ∧ 1 ≤ (b : ℕ) then 1 else 0

private def unitMat (K : Type*) [Semiring K] (m : ℕ) : Matrix (Fin (m + 2)) (Fin (m + 2)) K :=
  Matrix.of fun a b => if (a : ℕ) = 1 ∧ (b : ℕ) = 0 then 1 else 0

private theorem unitMat_mul_shiftMat (m : ℕ) :
    unitMat K m * shiftMat K m = 0 := by
  ext a b
  simp only [Matrix.mul_apply, unitMat, shiftMat, Matrix.of_apply, Matrix.zero_apply]
  refine Finset.sum_eq_zero fun k _ => ?_
  rcases eq_or_ne (k : ℕ) 0 with hk | hk <;> simp [hk]

private theorem unitMat_mul_unitMat (m : ℕ) :
    unitMat K m * unitMat K m = 0 := by
  ext a b
  simp only [Matrix.mul_apply, unitMat, Matrix.of_apply, Matrix.zero_apply]
  refine Finset.sum_eq_zero fun k _ => ?_
  rcases eq_or_ne (k : ℕ) 0 with hk | hk <;> simp [hk]

private theorem shiftMat_pow_mul_unitMat (m r : ℕ) (a b : Fin (m + 2)) :
    (shiftMat K m ^ r * unitMat K m) a b =
      if (a : ℕ) = r + 1 ∧ (b : ℕ) = 0 then 1 else 0 := by
  induction r generalizing a b with
  | zero => simp [unitMat]
  | succ r ih =>
    rw [pow_succ', mul_assoc, Matrix.mul_apply]
    simp_rw [ih]
    by_cases hr : r + 1 < m + 2
    · rw [Finset.sum_eq_single ⟨r + 1, hr⟩]
      · by_cases ha : (a : ℕ) = r + 1 + 1 <;> by_cases hb : (b : ℕ) = 0 <;>
          simp [shiftMat, ha, hb]
      · intro k _ hk
        have hkne : (k : ℕ) ≠ r + 1 := Fin.val_ne_of_ne hk
        simp [hkne]
      · simp
    · rw [Finset.sum_eq_zero]
      · have ha : (a : ℕ) ≠ r + 1 + 1 := by have := a.isLt; lia
        simp [ha]
      · intro k _
        have hk : (k : ℕ) ≠ r + 1 := by have := k.isLt; lia
        simp [hk]

private theorem serreHalfIdeal_le_ker_matrixRep (hA : A.IsGeneralizedCartan) [DecidableEq I]
    {i j : I} (hij : i ≠ j) {m : ℕ} (hm1 : 1 ≤ m) (hm : m ≤ (-A i j).toNat) :
    serreHalfIdeal K A ≤
      (FreeLieAlgebra.lift K fun k : I =>
        if k = i then shiftMat K m else if k = j then unitMat K m else 0).ker := by
  set φ : I → Matrix (Fin (m + 2)) (Fin (m + 2)) K := fun k =>
    if k = i then shiftMat K m else if k = j then unitMat K m else 0
  refine LieSubmodule.lieSpan_le.mpr ?_
  rintro _ ⟨p, q, rfl⟩
  simp only [SetLike.mem_coe, LieHom.mem_ker, LieHom.map_ad_pow, LieHom.map_lie,
    FreeLieAlgebra.lift_of_apply]
  rcases eq_or_ne p q with rfl | hpq
  · simp
  by_cases hpi : p = i
  · subst hpi
    by_cases hqj : q = j
    · subst hqj
      have hφp : φ p = shiftMat K m := by simp [φ]
      have hφq : φ q = unitMat K m := by simp [φ, Ne.symm hpq]
      rw [hφp, hφq, ← ad_pow_succ_apply,
        LieAlgebra.ad_pow_apply_of_mul_eq_zero (unitMat_mul_shiftMat m)]
      ext a b
      rw [shiftMat_pow_mul_unitMat, Matrix.zero_apply]
      have ha : (a : ℕ) ≠ (-A p q).toNat + 1 + 1 := by have := a.isLt; lia
      simp [ha]
    · have hφq : φ q = 0 := by simp [φ, Ne.symm hpq, hqj]
      simp [hφq]
  · by_cases hpj : p = j
    · subst hpj
      by_cases hqi : q = i
      · subst hqi
        have hφp : φ p = unitMat K m := by simp [φ, hpq]
        have hφq : φ q = shiftMat K m := by simp [φ]
        have haij : A q p ≠ 0 := by
          intro h0
          rw [h0] at hm
          lia
        have hji_pos : (-A p q).toNat ≠ 0 := by
          have hneg := hA.neg_of_ne_of_ne_zero hpq ((hA.ne_zero_comm q p).mp haij)
          exact (Int.pos_iff_toNat_pos.mp (neg_pos.mpr hneg)).ne'
        obtain ⟨r, hr⟩ := Nat.exists_eq_succ_of_ne_zero hji_pos
        have hlie0 : ⁅unitMat K m, ⁅unitMat K m, shiftMat K m⁆⁆ = 0 := by
          simp only [LieRing.of_associative_ring_bracket, unitMat_mul_shiftMat, zero_sub,
            mul_neg, neg_mul, sub_neg_eq_add]
          rw [← mul_assoc, unitMat_mul_shiftMat, zero_mul, neg_zero, mul_assoc,
            unitMat_mul_unitMat, mul_zero, zero_add]
        rw [hφp, hφq, hr, ad_pow_succ_apply, hlie0, map_zero]
      · have hφq : φ q = 0 := by simp [φ, hqi, Ne.symm hpq]
        simp [hφq]
    · have hφp : φ p = 0 := by simp [φ, hpi, hpj]
      simp [hφp]

/-- **Sharpness of Serre's raising relations**: for `i ≠ j` and `m ≤ (-A i j).toNat`, the iterated
commutator `(ad eᵢ ^ m) eⱼ` in `PresentedLieAlgebra R` is nonzero, whereas
`(ad eᵢ ^ (1 - Aᵢⱼ)) eⱼ` vanishes by `ad_pow_lie_positiveGenerator_positiveGenerator`. -/
theorem ad_pow_positiveGenerator_ne_zero (hA : A.IsGeneralizedCartan) {i j : I} (hij : i ≠ j)
    {m : ℕ} (hm : m ≤ (-A i j).toNat) :
    (ad K (PresentedLieAlgebra R) (positiveGenerator R i) ^ m) (positiveGenerator R j) ≠ 0 := by
  rcases eq_or_ne m 0 with rfl | hm0
  · simpa using positiveGenerator_ne_zero R hA j
  classical
  intro hzero
  let u : FreeLieAlgebra K I :=
    (ad K (FreeLieAlgebra K I) (FreeLieAlgebra.of K i) ^ m) (FreeLieAlgebra.of K j)
  have hu_ker : u ∈ serreHalfIdeal K A := by
    rw [← ker_lift_positiveGenerator R hA, LieHom.mem_ker]
    simpa [u, LieHom.map_ad_pow] using hzero
  have hrep := serreHalfIdeal_le_ker_matrixRep (K := K) hA hij (Nat.pos_of_ne_zero hm0) hm hu_ker
  rw [LieHom.mem_ker] at hrep
  simp only [u, LieHom.map_ad_pow, FreeLieAlgebra.lift_of_apply, ↓reduceIte, Ne.symm hij] at hrep
  rw [LieAlgebra.ad_pow_apply_of_mul_eq_zero (unitMat_mul_shiftMat m)] at hrep
  have hentry := congr_fun (congr_fun hrep ⟨m + 1, by lia⟩) ⟨0, by lia⟩
  rw [shiftMat_pow_mul_unitMat] at hentry
  simp at hentry

end AssociativeLieModel

/-- The lowering Chevalley generators `fᵢ` are `K`-linearly independent in
`PresentedLieAlgebra R`. -/
theorem linearIndependent_negativeGenerator (hA : A.IsGeneralizedCartan) :
    LinearIndependent K (negativeGenerator R) := by
  have heq : negativeGenerator R =
      (-(chevalleyInvolution R).toLinearEquiv.toLinearMap) ∘ positiveGenerator R := by
    funext i
    simp
  rw [heq]
  exact (linearIndependent_positiveGenerator R hA).map' _
    (LinearMap.ker_eq_bot.mpr (neg_injective.comp (chevalleyInvolution R).injective))

/-- **Sharpness of Serre's lowering relations**: for `i ≠ j` and `m ≤ (-A i j).toNat`,
`(ad fᵢ ^ m) fⱼ ≠ 0` in `PresentedLieAlgebra R`. -/
theorem ad_pow_negativeGenerator_ne_zero (hA : A.IsGeneralizedCartan) {i j : I} (hij : i ≠ j)
    {m : ℕ} (hm : m ≤ (-A i j).toNat) :
    (ad K (PresentedLieAlgebra R) (negativeGenerator R i) ^ m) (negativeGenerator R j) ≠ 0 := by
  intro h0
  have hneg := ad_neg_pow_apply_eq_zero h0
  have himg := congrArg (chevalleyInvolution R).toLieHom hneg
  rw [map_zero, LieHom.map_ad_pow, map_neg, LieEquiv.coe_toLieHom,
    chevalleyInvolution_negativeGenerator, chevalleyInvolution_negativeGenerator, neg_neg,
    map_neg, neg_eq_zero] at himg
  exact ad_pow_positiveGenerator_ne_zero R hA hij hm himg

end GeneralizedCartan

/-! ## Comparison with Serre's presentation `Matrix.ToLieAlgebra K A` -/

section SerreComparison

variable {I K H : Type*} [DecidableEq I] [Field K] [AddCommGroup H] [Module K H]
  {A : Matrix I I ℤ} (R : CartanRealization (A.map (Int.cast : ℤ → K)) H)

private theorem exists_serre_triangular_decomp (z : Matrix.ToLieAlgebra K A) :
    ∃ (uNeg : FreeLieAlgebra K I) (zH : Matrix.ToLieAlgebra K A) (uPos : FreeLieAlgebra K I),
      zH ∈ Submodule.span K (Set.range (serreH K A)) ∧
      z = FreeLieAlgebra.lift K (serreF K A) uNeg + zH +
        FreeLieAlgebra.lift K (serreE K A) uPos := by
  have htop : z ∈
      (LieSubalgebra.lieSpan K (Matrix.ToLieAlgebra K A) (Set.range (serreF K A))).toSubmodule ⊔
        Submodule.span K (Set.range (serreH K A)) ⊔
      (LieSubalgebra.lieSpan K (Matrix.ToLieAlgebra K A) (Set.range (serreE K A))).toSubmodule :=
    lieSpan_serreF_sup_span_serreH_sup_lieSpan_serreE_eq_top K A ▸ Submodule.mem_top
  obtain ⟨ab, hab, zPos, hzPos, rfl⟩ := Submodule.mem_sup.1 htop
  obtain ⟨zNeg, hzNeg, zH, hzH, rfl⟩ := Submodule.mem_sup.1 hab
  rw [LieSubalgebra.mem_toSubmodule, ← FreeLieAlgebra.range_lift] at hzPos hzNeg
  obtain ⟨uPos, rfl⟩ := hzPos
  obtain ⟨uNeg, rfl⟩ := hzNeg
  exact ⟨uNeg, zH, uPos, hzH, rfl⟩

private theorem serreHom_mem_map_corootSpan_of_mem_span_serreH {zH : Matrix.ToLieAlgebra K A}
    (hzH : zH ∈ Submodule.span K (Set.range (serreH K A))) :
    serreHom R zH ∈ R.corootSpan.map (cartanElement R) := by
  have hle : Submodule.span K (Set.range (serreH K A)) ≤
      (R.corootSpan.map (cartanElement R)).comap (serreHom R).toLinearMap := by
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨i, rfl⟩
    exact ⟨R.coroot i, R.coroot_mem_corootSpan i, (serreHom_serreH R i).symm⟩
  exact hle hzH

private theorem serreHom_eq_zero_of_mem_span_serreH (hA : A.IsGeneralizedCartan)
    {z : Matrix.ToLieAlgebra K A} (hz : z ∈ Submodule.span K (Set.range (serreH K A)))
    (h0 : serreHom R z = 0) : z = 0 := by
  rw [Finsupp.mem_span_range_iff_exists_finsupp] at hz
  obtain ⟨c, rfl⟩ := hz
  have hcoroot : c.sum (fun i a => a • R.coroot i) = 0 := by
    apply cartanElement_injective R hA
    simpa [map_finsuppSum] using h0
  have hc0 : c = 0 :=
    linearIndependent_iff.mp R.coroot_linearIndependent c
      (by simpa [Finsupp.linearCombination_apply] using hcoroot)
  simp [hc0]

private theorem serreHom_lift_serreE (u : FreeLieAlgebra K I) :
    serreHom R (FreeLieAlgebra.lift K (serreE K A) u) =
      FreeLieAlgebra.lift K (positiveGenerator R) u := by
  have h : (serreHom R).comp (FreeLieAlgebra.lift K (serreE K A)) =
      FreeLieAlgebra.lift K (positiveGenerator R) := FreeLieAlgebra.hom_ext fun i => by simp
  exact DFunLike.congr_fun h u

private theorem serreHom_lift_serreF (u : FreeLieAlgebra K I) :
    serreHom R (FreeLieAlgebra.lift K (serreF K A) u) =
      FreeLieAlgebra.lift K (negativeGenerator R) u := by
  have h : (serreHom R).comp (FreeLieAlgebra.lift K (serreF K A)) =
      FreeLieAlgebra.lift K (negativeGenerator R) := FreeLieAlgebra.hom_ext fun i => by simp
  exact DFunLike.congr_fun h u

/-- **Injectivity of `serreHom`** [Kac, §1.3]: for a generalized Cartan matrix `A`, Serre's
presentation `Matrix.ToLieAlgebra K A` embeds injectively into `PresentedLieAlgebra R` onto the
derived algebra `⁅𝔤, 𝔤⁆`. -/
theorem serreHom_injective (hA : A.IsGeneralizedCartan) :
    Function.Injective (serreHom R) := by
  rw [injective_iff_map_eq_zero]
  intro z hz0
  obtain ⟨uNeg, zH, uPos, hzH, rfl⟩ := exists_serre_triangular_decomp z
  obtain ⟨x, _, hx⟩ := serreHom_mem_map_corootSpan_of_mem_span_serreH R hzH
  have htri : triangularMap R
      (⟨FreeLieAlgebra.lift K (negativeGenerator R) uNeg,
          by rw [← range_lift_negativeGenerator]; exact ⟨uNeg, rfl⟩⟩,
        x,
       ⟨FreeLieAlgebra.lift K (positiveGenerator R) uPos,
          by rw [← range_lift_positiveGenerator]; exact ⟨uPos, rfl⟩⟩) = 0 := by
    simp only [triangularMap_apply]
    rw [← serreHom_lift_serreF R uNeg, ← serreHom_lift_serreE R uPos, hx, ← map_add, ← map_add]
    exact hz0
  have hzero := triangularMap_injective R hA (htri.trans (map_zero _).symm)
  obtain ⟨huNeg0, rfl, huPos0⟩ :
      FreeLieAlgebra.lift K (negativeGenerator R) uNeg = 0 ∧ x = 0 ∧
        FreeLieAlgebra.lift K (positiveGenerator R) uPos = 0 := by
    simpa [Prod.ext_iff, Subtype.ext_iff] using hzero
  have huPos_serre : uPos ∈ serreHalfIdeal K A := by
    rwa [← ker_lift_positiveGenerator R hA, LieHom.mem_ker]
  have huNeg_serre : uNeg ∈ serreHalfIdeal K A := by
    rwa [← ker_lift_negativeGenerator R hA, LieHom.mem_ker]
  have hzPos0 : FreeLieAlgebra.lift K (serreE K A) uPos = 0 := by
    rw [← LieHom.mem_ker]
    refine LieSubmodule.lieSpan_le.mpr ?_ huPos_serre
    rintro _ ⟨i, j, rfl⟩
    simp [(isSerreSystem_serre K A).ad_pow_lie_E_E]
  have hzNeg0 : FreeLieAlgebra.lift K (serreF K A) uNeg = 0 := by
    rw [← LieHom.mem_ker]
    refine LieSubmodule.lieSpan_le.mpr ?_ huNeg_serre
    rintro _ ⟨i, j, rfl⟩
    simp [(isSerreSystem_serre K A).ad_pow_lie_F_F]
  have hzH0 : zH = 0 :=
    serreHom_eq_zero_of_mem_span_serreH R hA hzH (by simpa using hx.symm)
  simp [hzNeg0, hzH0, hzPos0]

/-- `Matrix.ToLieAlgebra K A` is isomorphic as a Lie algebra to the image `(serreHom R).range`
(which equals the derived algebra `⁅𝔤, 𝔤⁆` by `range_serreHom_eq_derivedSeries`). -/
noncomputable def serreRangeEquiv (hA : A.IsGeneralizedCartan) :
    Matrix.ToLieAlgebra K A ≃ₗ⁅K⁆ (serreHom R).range :=
  LieEquiv.ofInjective (serreHom R) (serreHom_injective R hA)

@[simp]
theorem coe_serreRangeEquiv_apply (hA : A.IsGeneralizedCartan) (z : Matrix.ToLieAlgebra K A) :
    (serreRangeEquiv R hA z : PresentedLieAlgebra R) = serreHom R z := (rfl)

/-- **Intersection of the derived algebra with `H`** [Kac, §1.3]:
`(serreHom R).range ∩ cartanElement(H) = cartanElement(R.corootSpan)`. -/
theorem range_serreHom_inf_range_cartanElement (hA : A.IsGeneralizedCartan) :
    (serreHom R).range.toSubmodule ⊓ LinearMap.range (cartanElement R) =
      R.corootSpan.map (cartanElement R) := by
  refine le_antisymm ?_ ?_
  · rintro _ ⟨⟨z, rfl⟩, ⟨x, hx⟩⟩
    obtain ⟨uNeg, zH, uPos, hzH, rfl⟩ := exists_serre_triangular_decomp z
    obtain ⟨x₀, hx₀, hzx₀⟩ := serreHom_mem_map_corootSpan_of_mem_span_serreH R hzH
    have hmPos : serreHom R (FreeLieAlgebra.lift K (serreE K A) uPos) ∈ positiveSubalgebra R := by
      rw [serreHom_lift_serreE, ← range_lift_positiveGenerator]
      exact ⟨uPos, rfl⟩
    have hmNeg : serreHom R (FreeLieAlgebra.lift K (serreF K A) uNeg) ∈ negativeSubalgebra R := by
      rw [serreHom_lift_serreF, ← range_lift_negativeGenerator]
      exact ⟨uNeg, rfl⟩
    have htri : triangularMap R
        (⟨serreHom R (FreeLieAlgebra.lift K (serreF K A) uNeg), hmNeg⟩, x₀,
         ⟨serreHom R (FreeLieAlgebra.lift K (serreE K A) uPos), hmPos⟩) =
        triangularMap R (0, x, 0) := by
      simpa [triangularMap_apply, map_add, ← hzx₀] using hx.symm
    have hprod := triangularMap_injective R hA htri
    obtain rfl : x₀ = x := (Prod.ext_iff.mp (Prod.ext_iff.mp hprod).2).1
    exact ⟨x₀, hx₀, hx⟩
  · rintro _ ⟨y, hy, rfl⟩
    refine ⟨?_, ⟨y, rfl⟩⟩
    rw [CartanRealization.corootSpan_def] at hy
    have hle : Submodule.span K (Set.range R.coroot) ≤
        (serreHom R).range.toSubmodule.comap (cartanElement R) := by
      refine Submodule.span_le.mpr ?_
      rintro _ ⟨i, rfl⟩
      exact ⟨serreH K A i, serreHom_serreH R i⟩
    exact hle hy

/-- When the simple coroots span `H` (for instance, for a minimal realization of a nonsingular
generalized Cartan matrix), `serreHom R` is an isomorphism of Lie algebras
`Matrix.ToLieAlgebra K A ≃ₗ⁅K⁆ PresentedLieAlgebra R`. -/
noncomputable def serreEquivOfCorootSpanEqTop (hA : A.IsGeneralizedCartan)
    (hspan : R.corootSpan = ⊤) :
    Matrix.ToLieAlgebra K A ≃ₗ⁅K⁆ PresentedLieAlgebra R :=
  LieEquiv.ofBijective (serreHom R) ⟨serreHom_injective R hA, fun z => by
    have hz : z ∈ (serreHom R).range.toSubmodule ⊔ LinearMap.range (cartanElement R) := by
      rw [range_serreHom_sup_range_cartanElement R]
      trivial
    obtain ⟨a, ha, _, ⟨x, rfl⟩, rfl⟩ := Submodule.mem_sup.1 hz
    have hx_mem : cartanElement R x ∈ (serreHom R).range := by
      have hmem : cartanElement R x ∈ R.corootSpan.map (cartanElement R) :=
        ⟨x, hspan ▸ Submodule.mem_top, rfl⟩
      rw [← range_serreHom_inf_range_cartanElement R hA] at hmem
      exact hmem.1
    exact add_mem ha hx_mem⟩

@[simp]
theorem serreEquivOfCorootSpanEqTop_apply (hA : A.IsGeneralizedCartan)
    (hspan : R.corootSpan = ⊤) (z : Matrix.ToLieAlgebra K A) :
    serreEquivOfCorootSpanEqTop R hA hspan z = serreHom R z := (rfl)

@[simp]
theorem serreEquivOfCorootSpanEqTop_symm_cartanElement_coroot (hA : A.IsGeneralizedCartan)
    (hspan : R.corootSpan = ⊤) (i : I) :
    (serreEquivOfCorootSpanEqTop R hA hspan).symm (cartanElement R (R.coroot i)) =
      serreH K A i :=
  (serreEquivOfCorootSpanEqTop R hA hspan).symm_apply_eq.mpr (serreHom_serreH R i).symm

@[simp]
theorem serreEquivOfCorootSpanEqTop_symm_positiveGenerator (hA : A.IsGeneralizedCartan)
    (hspan : R.corootSpan = ⊤) (i : I) :
    (serreEquivOfCorootSpanEqTop R hA hspan).symm (positiveGenerator R i) = serreE K A i :=
  (serreEquivOfCorootSpanEqTop R hA hspan).symm_apply_eq.mpr (serreHom_serreE R i).symm

@[simp]
theorem serreEquivOfCorootSpanEqTop_symm_negativeGenerator (hA : A.IsGeneralizedCartan)
    (hspan : R.corootSpan = ⊤) (i : I) :
    (serreEquivOfCorootSpanEqTop R hA hspan).symm (negativeGenerator R i) = serreF K A i :=
  (serreEquivOfCorootSpanEqTop R hA hspan).symm_apply_eq.mpr (serreHom_serreF R i).symm

end SerreComparison

/-! ### Examples -/

section Examples

/-- On an empty index set, the Kac–Moody algebra of the realization `ℚ²` is abelian and linearly
isomorphic to `ℚ²`. -/
example :
    let R : CartanRealization ((!![] : Matrix (Fin 0) (Fin 0) ℤ).map (Int.cast : ℤ → ℚ))
      (Fin 2 → ℚ) :=
      { coroot := nofun
        root := nofun
        coroot_linearIndependent := linearIndependent_empty_type
        root_linearIndependent := linearIndependent_empty_type
        root_coroot := nofun }
    IsLieAbelian (PresentedLieAlgebra R) ∧ Nonempty ((Fin 2 → ℚ) ≃ₗ[ℚ] PresentedLieAlgebra R) :=
  ⟨inferInstance, ⟨cartanElementEquivOfIsEmpty _⟩⟩

/-- Enlarged realization of `A₁ = [[2]]` on `ℚ²`: `z = cartanElement R ![0, 1]` is a nonzero
central element of `PresentedLieAlgebra R` outside the derived algebra `(serreHom R).range`. -/
example :
    let R : CartanRealization ((!![2] : Matrix (Fin 1) (Fin 1) ℤ).map (Int.cast : ℤ → ℚ))
      (Fin 2 → ℚ) :=
      { coroot := fun _ => ![1, 0]
        root := fun _ => (2 : ℚ) • LinearMap.proj 0
        coroot_linearIndependent :=
          Fintype.linearIndependent_iff.mpr fun g hg i => by
            fin_cases i
            simpa using congr_fun hg 0
        root_linearIndependent :=
          Fintype.linearIndependent_iff.mpr fun g hg i => by
            fin_cases i
            have h := LinearMap.congr_fun hg ![1, 0]
            simpa using h
        root_coroot := fun i j => by fin_cases i; fin_cases j; simp }
    let z := cartanElement R ![0, 1]
    z ≠ 0 ∧ z ∈ LieAlgebra.center ℚ (PresentedLieAlgebra R) ∧ z ∉ (serreHom R).range := by
  intro R z
  have hA : (!![2] : Matrix (Fin 1) (Fin 1) ℤ).IsGeneralizedCartan :=
    { diag := by decide
      offDiag_nonpos := by simp [Fin.forall_fin_one]
      zero_comm := by simp }
  refine ⟨?_, ?_, ?_⟩
  · exact (map_ne_zero_iff _ (cartanElement_injective R hA)).mpr fun h =>
      absurd (congr_fun h 1) one_ne_zero
  · rw [cartanElement_mem_center_iff R hA, CartanRealization.mem_cartanCenter_iff]
    intro i
    fin_cases i
    simp [R]
  · intro hz
    have hinf : z ∈ (serreHom R).range.toSubmodule ⊓ LinearMap.range (cartanElement R) :=
      ⟨hz, ⟨![0, 1], rfl⟩⟩
    rw [range_serreHom_inf_range_cartanElement R hA] at hinf
    obtain ⟨y, hy, hyz⟩ := hinf
    have hyeq : y = ![0, 1] := cartanElement_injective R hA hyz
    rw [hyeq, CartanRealization.corootSpan_def, SetLike.mem_coe,
      Finsupp.mem_span_range_iff_exists_finsupp] at hy
    obtain ⟨c, hc⟩ := hy
    have h1 := congr_fun hc 1
    simp [R, Finsupp.sum_fintype] at h1

/-- Minimal realization of the affine Cartan matrix `A₁⁽¹⁾ = [[2, -2], [-2, 2]]` on `ℚ³`:
`(ad e₀ ^ 2) e₁ ≠ 0`, while `(ad e₀ ^ 3) e₁ = 0`. -/
example :
    let A : Matrix (Fin 2) (Fin 2) ℤ := !![2, -2; -2, 2]
    let R : CartanRealization (A.map (Int.cast : ℤ → ℚ)) (Fin 3 → ℚ) :=
      { coroot := ![![1, 0, 0], ![0, 1, 0]]
        root := ![(2 : ℚ) • LinearMap.proj 0 - (2 : ℚ) • LinearMap.proj 1,
          -(2 : ℚ) • LinearMap.proj 0 + (2 : ℚ) • LinearMap.proj 1 + LinearMap.proj 2]
        coroot_linearIndependent :=
          Fintype.linearIndependent_iff.mpr fun g hg i => by
            fin_cases i
            · simpa [Fin.sum_univ_two] using congr_fun hg 0
            · simpa [Fin.sum_univ_two] using congr_fun hg 1
        root_linearIndependent :=
          Fintype.linearIndependent_iff.mpr fun g hg => by
            have h2 := LinearMap.congr_fun hg ![0, 0, 1]
            have hg1 : g 1 = 0 := by simpa [Fin.sum_univ_two] using h2
            have h0 := LinearMap.congr_fun hg ![1, 0, 0]
            have hg0 : g 0 = 0 := by simpa [Fin.sum_univ_two, hg1] using h0
            intro i
            fin_cases i <;> assumption
        root_coroot := fun i j => by fin_cases i <;> fin_cases j <;> simp [A] }
    (ad ℚ (PresentedLieAlgebra R) (positiveGenerator R 0) ^ 2) (positiveGenerator R 1) ≠ 0 ∧
      (ad ℚ (PresentedLieAlgebra R) (positiveGenerator R 0) ^ 3) (positiveGenerator R 1) = 0 := by
  intro A R
  have hA : A.IsGeneralizedCartan :=
    { diag := by decide
      offDiag_nonpos := by simp [A, Fin.forall_fin_two]
      zero_comm := by simp [A, Fin.forall_fin_two] }
  refine ⟨ad_pow_positiveGenerator_ne_zero R hA (by decide) (by decide), ?_⟩
  rw [ad_pow_succ_apply]
  exact ad_pow_lie_positiveGenerator_positiveGenerator R 0 1

end Examples

end KacMoody

