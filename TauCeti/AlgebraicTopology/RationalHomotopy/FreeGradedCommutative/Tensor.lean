/-!
# Restriction and graded tensor products of free graded-commutative algebras

This file establishes the structural closure properties of free graded-commutative algebras:

* `TauCeti.IsFreeGradedCommutative.isHomogeneous_adjoin`: the subalgebra generated by any subset
  of generators of a free graded-commutative algebra is homogeneous.
* `TauCeti.IsFreeGradedCommutative.restrict`: when `2` is invertible, the subalgebra generated by
  any subset `S` of generators of a free graded-commutative algebra is free graded-commutative on
  `S`.
* `TauCeti.IsFreeGradedCommutative.gradedTensor`: the Koszul-signed tensor product of two free
  graded-commutative algebras is free graded-commutative on the lexicographic disjoint union of
  their generator sets (`ΛV ᵍ⊗ ΛW ≅ Λ(V ⊕ W)`).
* `TauCeti.IsFreeGradedCommutative.tensorDecompositionEquiv`: when `2` is invertible,
  multiplication identifies `Λ(S) ᵍ⊗ Λ(Sᶜ)` with `A`.

## References

* Y. Félix, S. Halperin, and J.-C. Thomas, *Rational Homotopy Theory*, Graduate Texts in
  Mathematics 205, Springer (2001), Section 3.
* K. Hess, *Rational homotopy theory: a brief introduction*, Contemporary Mathematics 436 (2007),
  Section 1.
-/

public section

open DirectSum
open scoped TensorProduct

namespace TauCeti

universe u v w

variable {R : Type u} [CommRing R] {A : Type v} [Ring A] [Algebra R A]

/-- Mapping an exponent vector along a strictly monotone map `ι' → ι` commutes with forming
standard monomials. -/
theorem standardMonomial_mapDomain_strictMono {M : Type*} [Monoid M]
    {ι ι' : Type*} [LinearOrder ι] [LinearOrder ι'] {x : ι → M}
    {e : ι' → ι} (he : StrictMono e) (f : ι' →₀ ℕ) :
    standardMonomial x (f.mapDomain e) = standardMonomial (x ∘ e) f := by
  have hsupp : (f.mapDomain e).support = f.support.map ⟨e, he.injective⟩ := by
    ext j
    simp only [Finsupp.mem_support_iff, Finset.mem_map, Function.Embedding.coeFn_mk]
    constructor
    · intro hj
      obtain ⟨i, hi, rfl⟩ := Finset.mem_image.1 (Finsupp.mapDomain_support
        (Finsupp.mem_support_iff.2 hj))
      exact ⟨i, Finsupp.mem_support_iff.1 hi, rfl⟩
    · rintro ⟨i, hi, rfl⟩
      rw [Finsupp.mapDomain_apply_of_injective he.injective]
      exact hi
  have hsort : (f.mapDomain e).support.sort (· ≤ ·) = (f.support.sort (· ≤ ·)).map e := by
    have hnodup : ((f.support.sort (· ≤ ·)).map e).Nodup :=
      (Finset.sort_nodup _ _).map he.injective
    have hperm : ((f.mapDomain e).support.sort (· ≤ ·)).Perm ((f.support.sort (· ≤ ·)).map e) := by
      refine (List.perm_ext_iff_of_nodup (Finset.sort_nodup _ _) hnodup).2 fun j => ?_
      simp [Finset.mem_sort, hsupp]
    have hpw : ((f.support.sort (· ≤ ·)).map e).Pairwise (· ≤ ·) :=
      List.pairwise_map.2 ((Finset.pairwise_sort _ _).imp fun h => he.monotone h)
    exact hperm.eq_of_pairwise' (Finset.pairwise_sort _ _) hpw
  simp only [standardMonomial_def, hsort, List.map_map, Function.comp_def]
  congr 1
  refine List.map_congr_left fun i _ => ?_
  rw [Finsupp.mapDomain_apply_of_injective he.injective]

namespace IsFreeGradedCommutative

variable {𝒜 : ℤ → Submodule R A} {ι : Type w} [LinearOrder ι] {x : ι → A} {deg : ι → ℕ}

/-- The subalgebra generated by any subset of generators of a free graded-commutative algebra is
homogeneous. -/
theorem isHomogeneous_adjoin [GradedAlgebra 𝒜] (hx : IsFreeGradedCommutative 𝒜 x deg)
    (S : Set ι) : SetLike.IsHomogeneous 𝒜 (Algebra.adjoin R (x '' S)) :=
  Algebra.isHomogeneous_adjoin 𝒜 fun _ ⟨i, _, hi⟩ => ⟨deg i, hi ▸ hx.mem i⟩

/-- **Restriction**: when `2` is invertible, the subalgebra generated by any subset `S` of
generators of a free graded-commutative algebra is free graded-commutative on `S`. -/
theorem restrict [Invertible (2 : R)] (hx : IsFreeGradedCommutative 𝒜 x deg) (S : Set ι) :
    IsFreeGradedCommutative ((Algebra.adjoin R (x '' S)).grading 𝒜)
      (fun i : S => (⟨x i.1, Algebra.subset_adjoin ⟨i.1, i.2, rfl⟩⟩ : Algebra.adjoin R (x '' S)))
      (fun i : S => deg i.1) := by
  let T := Algebra.adjoin R (x '' S)
  let xS : S → T := fun i => ⟨x i.1, Algebra.subset_adjoin ⟨i.1, i.2, rfl⟩⟩
  let degS : S → ℕ := fun i => deg i.1
  let emb : ExponentVector degS → ExponentVector deg := fun f =>
    ⟨f.1.mapDomain Subtype.val, fun i hi => by
      classical
      by_cases h : i ∈ S
      · simpa [Finsupp.mapDomain_apply_of_injective Subtype.val_injective f.1 ⟨i, h⟩] using
          f.2 ⟨i, h⟩ hi
      · rw [Finsupp.mapDomain_of_notMem_range (f := Subtype.val) f.1 i (by simpa using h)]
        exact Nat.zero_le 1⟩
  have hemb_inj : Function.Injective emb := fun f g h => by
    ext ⟨i, hi⟩
    have h1 := congrArg (fun k : ExponentVector deg => k.1 i) h
    have hf : (emb f).1 i = f.1 ⟨i, hi⟩ :=
      Finsupp.mapDomain_apply_of_injective Subtype.val_injective f.1 ⟨i, hi⟩
    have hg : (emb g).1 i = g.1 ⟨i, hi⟩ :=
      Finsupp.mapDomain_apply_of_injective Subtype.val_injective g.1 ⟨i, hi⟩
    rw [hf, hg] at h1
    exact h1
  have hcoe_mon : ∀ f : ExponentVector degS,
      T.val (standardMonomial xS f.1) = standardMonomial x (emb f).1 := fun f =>
    (map_standardMonomial T.val xS f.1).trans
      (standardMonomial_mapDomain_strictMono (x := x) (e := Subtype.val) (fun _ _ h => h) f.1).symm
  refine ⟨fun i => (Subalgebra.mem_grading_iff T 𝒜).2 (hx.mem i.1),
    fun i j => Subtype.ext (hx.mul_comm i.1 j.1), ?_, ?_⟩
  · refine LinearIndependent.of_comp T.val.toLinearMap ?_
    convert hx.linearIndependent.comp emb hemb_inj using 1
    exact funext fun f => hcoe_mon f
  · let M : Submodule R A :=
      Submodule.span R (Set.range fun f : ExponentVector degS => standardMonomial x (emb f).1)
    have hM_mul : ∀ a ∈ M, ∀ b ∈ M, a * b ∈ M := by
      intro a ha b hb
      induction ha using Submodule.span_induction generalizing b with
      | mem u hu =>
        obtain ⟨f, rfl⟩ := hu
        induction hb using Submodule.span_induction with
        | mem v hv =>
          obtain ⟨g, rfl⟩ := hv
          by_cases hodd : ∃ i, Odd (deg i) ∧ (emb f).1 i ≠ 0 ∧ (emb g).1 i ≠ 0
          · rw [hx.standardMonomial_mul_eq_zero_of_odd hodd]; exact zero_mem _
          · push Not at hodd
            let fg : ExponentVector degS := ⟨f.1 + g.1, fun i hi => by
              have hf := f.2 i hi; have hg := g.2 i hi
              by_cases hfi : f.1 i = 0
              · simp [hfi, hg]
              · have hne : (emb f).1 i.1 ≠ 0 := by
                  simpa [emb, Finsupp.mapDomain_apply_of_injective Subtype.val_injective] using hfi
                have hgi : g.1 i = 0 := by
                  simpa [emb, Finsupp.mapDomain_apply_of_injective Subtype.val_injective] using
                    hodd i.1 hi hne
                simp [hgi, hf]⟩
            have hemb_add : (emb f).1 + (emb g).1 = (emb fg).1 :=
              (Finsupp.mapDomain_add (f := Subtype.val) (v₁ := f.1) (v₂ := g.1)).symm
            rw [standardMonomial_mul_eq_smul hx.mul_comm, hemb_add, Units.smul_def]
            exact Submodule.smul_of_tower_mem M _ (Submodule.subset_span ⟨fg, rfl⟩)
        | zero => simp
        | add _ _ _ _ hv₁ hv₂ => rw [mul_add]; exact add_mem hv₁ hv₂
        | smul r _ _ hv => rw [mul_smul_comm]; exact Submodule.smul_mem M r hv
      | zero => simp
      | add _ _ _ _ hu₁ hu₂ => rw [add_mul]; exact add_mem (hu₁ b hb) (hu₂ b hb)
      | smul r _ _ hu => rw [smul_mul_assoc]; exact Submodule.smul_mem M r (hu b hb)
    have hT_le : T.toSubmodule ≤ M := by
      intro a ha
      induction ha using Algebra.adjoin_induction with
      | mem y hy =>
        obtain ⟨i, hi, rfl⟩ := hy
        have hsingle : x i = standardMonomial x (emb (ExponentVector.single ⟨i, hi⟩)).1 := by
          simp [emb, Finsupp.mapDomain_single]
        rw [hsingle]; exact Submodule.subset_span ⟨ExponentVector.single ⟨i, hi⟩, rfl⟩
      | algebraMap r =>
        rw [Algebra.algebraMap_eq_smul_one]
        refine Submodule.smul_mem M r ?_
        have hone : (1 : A) = standardMonomial x (emb 0).1 := by simp [emb]
        rw [hone]; exact Submodule.subset_span ⟨0, rfl⟩
      | add _ _ _ _ hu hv => exact add_mem hu hv
      | mul u v _ _ hu hv => exact hM_mul u hu v hv
    rw [eq_top_iff]
    intro a _
    have haM : (a : A) ∈ M := hT_le a.2
    have hmap : (Submodule.span R (Set.range fun f : ExponentVector degS =>
        standardMonomial xS f.1)).map T.val.toLinearMap = M := by
      rw [Submodule.map_span, ← Set.range_comp]
      congr 1; ext y
      simp only [Set.mem_range, Function.comp_apply, AlgHom.toLinearMap_apply, Subalgebra.coe_val]
      exact ⟨fun ⟨f, hf⟩ => ⟨f, hf ▸ (hcoe_mon f).symm⟩, fun ⟨f, hf⟩ => ⟨f, hf ▸ hcoe_mon f⟩⟩
    rw [← hmap] at haM
    obtain ⟨b, hb, hba⟩ := Submodule.mem_map.1 haM
    exact (Subtype.ext hba) ▸ hb

/-- **Graded tensor product of free graded-commutative algebras**: if `A` is free on `x : ι → A`
and `B` is free on `y : κ → B`, then `𝒜 ᵍ⊗[R] ℬ` is free on the disjoint union `ι ⊕ₗ κ` ordered
with `ι` before `κ`. -/
theorem gradedTensor [GradedAlgebra 𝒜] (hx : IsFreeGradedCommutative 𝒜 x deg)
    {B : Type*} [Ring B] [Algebra R B] {ℬ : ℤ → Submodule R B} [GradedAlgebra ℬ]
    {κ : Type*} [LinearOrder κ] {y : κ → B} {degB : κ → ℕ}
    (hy : IsFreeGradedCommutative ℬ y degB) :
    IsFreeGradedCommutative (gradedTensorGrading 𝒜 ℬ)
      (fun k : ι ⊕ₗ κ => Sum.elim (fun i => (x i ᵍ⊗ₜ[R] (1 : B) : 𝒜 ᵍ⊗[R] ℬ))
        (fun j => ((1 : A) ᵍ⊗ₜ[R] y j : 𝒜 ᵍ⊗[R] ℬ)) (ofLex k))
      (fun k : ι ⊕ₗ κ => Sum.elim deg degB (ofLex k)) := by
  let z : ι ⊕ₗ κ → 𝒜 ᵍ⊗[R] ℬ := fun k =>
    Sum.elim (fun i => (x i ᵍ⊗ₜ[R] (1 : B) : 𝒜 ᵍ⊗[R] ℬ))
      (fun j => ((1 : A) ᵍ⊗ₜ[R] y j : 𝒜 ᵍ⊗[R] ℬ)) (ofLex k)
  let degZ : ι ⊕ₗ κ → ℕ := fun k => Sum.elim deg degB (ofLex k)
  have hz_mem : ∀ k : ι ⊕ₗ κ, z k ∈ gradedTensorGrading 𝒜 ℬ (degZ k) := by
    intro k
    rcases hk : ofLex k with i | j
    · simpa [z, degZ, hk] using
        tmul_mem_gradedTensorGrading 𝒜 ℬ (hx.mem i) (SetLike.one_mem_graded ℬ)
    · simpa [z, degZ, hk] using
        tmul_mem_gradedTensorGrading 𝒜 ℬ (SetLike.one_mem_graded 𝒜) (hy.mem j)
  have hz_comm : ∀ k₁ k₂ : ι ⊕ₗ κ,
      z k₁ * z k₂ = (((degZ k₁ : ℤ) * degZ k₂).negOnePow) • (z k₂ * z k₁) := fun k₁ k₂ =>
    gradedTensor_mul_comm_of_mul_comm 𝒜 ℬ hx.mul_comm_graded hy.mul_comm_graded
      (hz_mem k₁) (hz_mem k₂)
  let eFinsupp : ((ι ⊕ₗ κ) →₀ ℕ) ≃ (ι →₀ ℕ) × (κ →₀ ℕ) :=
    (Finsupp.domCongr ofLex).toEquiv.trans Finsupp.sumFinsuppEquivProdFinsupp
  have he_symm (p : (ι →₀ ℕ) × (κ →₀ ℕ)) :
      eFinsupp.symm p = p.1.mapDomain (toLex ∘ Sum.inl) + p.2.mapDomain (toLex ∘ Sum.inr) := by
    ext k
    rcases hk : ofLex k with i | j
    · have hkeq : k = toLex (Sum.inl i) := by rw [← hk]; rfl
      subst hkeq
      have h1 : (p.1.mapDomain (toLex ∘ Sum.inl : ι → ι ⊕ₗ κ)) (toLex (Sum.inl i)) = p.1 i :=
        Finsupp.mapDomain_apply_of_injective (toLex.injective.comp Sum.inl_injective) p.1 i
      rw [Finsupp.add_apply, h1,
        Finsupp.mapDomain_of_notMem_range (f := toLex ∘ Sum.inr) p.2 (toLex (Sum.inl i)) (by simp),
        add_zero]
      simp [eFinsupp, Finsupp.sumFinsuppEquivProdFinsupp]
    · have hkeq : k = toLex (Sum.inr j) := by rw [← hk]; rfl
      subst hkeq
      have h2 : (p.2.mapDomain (toLex ∘ Sum.inr : κ → ι ⊕ₗ κ)) (toLex (Sum.inr j)) = p.2 j :=
        Finsupp.mapDomain_apply_of_injective (toLex.injective.comp Sum.inr_injective) p.2 j
      rw [Finsupp.add_apply,
        Finsupp.mapDomain_of_notMem_range (f := toLex ∘ Sum.inl) p.1 (toLex (Sum.inr j)) (by simp),
        h2, zero_add]
      simp [eFinsupp, Finsupp.sumFinsuppEquivProdFinsupp]
  let toPair : ExponentVector degZ ≃ ExponentVector deg × ExponentVector degB :=
    { toFun := fun f =>
        (⟨(eFinsupp f.1).1, fun i hi => by
            simpa [eFinsupp, Finsupp.sumFinsuppEquivProdFinsupp] using
              f.2 (toLex (Sum.inl i)) (by simpa [degZ] using hi)⟩,
         ⟨(eFinsupp f.1).2, fun j hj => by
            simpa [eFinsupp, Finsupp.sumFinsuppEquivProdFinsupp] using
              f.2 (toLex (Sum.inr j)) (by simpa [degZ] using hj)⟩)
      invFun := fun p =>
        ⟨eFinsupp.symm (p.1.1, p.2.1), fun k hk => by
          rcases hk' : ofLex k with i | j
          · have hkeq : k = toLex (Sum.inl i) := by rw [← hk']; rfl
            subst hkeq
            simpa [eFinsupp, Finsupp.sumFinsuppEquivProdFinsupp] using
              p.1.2 i (by simpa [degZ] using hk)
          · have hkeq : k = toLex (Sum.inr j) := by rw [← hk']; rfl
            subst hkeq
            simpa [eFinsupp, Finsupp.sumFinsuppEquivProdFinsupp] using
              p.2.2 j (by simpa [degZ] using hk)⟩
      left_inv := fun f => Subtype.ext (eFinsupp.symm_apply_apply f.1)
      right_inv := fun ⟨f₁, f₂⟩ => Prod.ext
        (Subtype.ext (congrArg Prod.fst (eFinsupp.apply_symm_apply (f₁.1, f₂.1))))
        (Subtype.ext (congrArg Prod.snd (eFinsupp.apply_symm_apply (f₁.1, f₂.1)))) }
  let bZ : Module.Basis (ExponentVector degZ) R (𝒜 ᵍ⊗[R] ℬ) :=
    ((hx.basis.tensorProduct hy.basis).map (GradedTensorProduct.of R 𝒜 ℬ)).reindex toPair.symm
  have hbZ_apply : ∀ f : ExponentVector degZ, bZ f = standardMonomial z f.1 := by
    intro f
    set p := toPair f
    have hsplit : f.1 = p.1.1.mapDomain (toLex ∘ Sum.inl) + p.2.1.mapDomain (toLex ∘ Sum.inr) := by
      have h := congrArg Subtype.val (toPair.symm_apply_apply f)
      simpa [p, toPair, he_symm] using h.symm
    have hlt : ∀ a ∈ (p.1.1.mapDomain (toLex ∘ Sum.inl)).support,
        ∀ b ∈ (p.2.1.mapDomain (toLex ∘ Sum.inr)).support, a < b := by
      intro a ha b hb
      obtain ⟨i, _, rfl⟩ := Finset.mem_image.1 (Finsupp.mapDomain_support ha)
      obtain ⟨j, _, rfl⟩ := Finset.mem_image.1 (Finsupp.mapDomain_support hb)
      exact Sum.Lex.sep i j
    have hval : bZ f = standardMonomial x p.1.1 ᵍ⊗ₜ[R] standardMonomial y p.2.1 := by
      simp only [bZ, Module.Basis.reindex_apply, Equiv.symm_symm, Module.Basis.map_apply,
        Module.Basis.tensorProduct_apply', basis_apply]
      rfl
    rw [hval, hsplit, standardMonomial_add_of_lt z hlt,
      standardMonomial_mapDomain_strictMono (e := toLex ∘ Sum.inl) Sum.Lex.inl_strictMono,
      standardMonomial_mapDomain_strictMono (e := toLex ∘ Sum.inr) Sum.Lex.inr_strictMono]
    have hL : standardMonomial (z ∘ (toLex ∘ Sum.inl)) p.1.1 =
        (standardMonomial x p.1.1 ᵍ⊗ₜ[R] (1 : B) : 𝒜 ᵍ⊗[R] ℬ) := by
      simpa [z, Function.comp_def] using
        (map_standardMonomial (gradedTensorIncludeLeft 𝒜 ℬ) x p.1.1).symm
    have hR : standardMonomial (z ∘ (toLex ∘ Sum.inr)) p.2.1 =
        ((1 : A) ᵍ⊗ₜ[R] standardMonomial y p.2.1 : 𝒜 ᵍ⊗[R] ℬ) := by
      simpa [z, Function.comp_def] using
        (map_standardMonomial (gradedTensorIncludeRight 𝒜 ℬ) y p.2.1).symm
    rw [hL, hR, GradedTensorProduct.tmul_coe_mul_coe_tmul 𝒜 ℬ (standardMonomial x p.1.1)
      ⟨1, SetLike.one_mem_graded ℬ⟩ ⟨1, SetLike.one_mem_graded 𝒜⟩ (standardMonomial y p.2.1)]
    simp
  refine ⟨hz_mem, hz_comm, ?_, ?_⟩
  · convert bZ.linearIndependent using 1
    exact funext fun f => (hbZ_apply f).symm
  · convert bZ.span_eq using 2
    ext a
    simp [hbZ_apply, z, degZ]

/-- **Tensor decomposition**: when `2` is invertible, multiplication identifies the Koszul-signed
tensor product of the subalgebras generated by `S` and `Sᶜ` with `A`. -/
noncomputable def tensorDecompositionEquiv [GradedAlgebra 𝒜] [Invertible (2 : R)]
    (hx : IsFreeGradedCommutative 𝒜 x deg) (S : Set ι)
    [GradedAlgebra ((Algebra.adjoin R (x '' S)).grading 𝒜)]
    [GradedAlgebra ((Algebra.adjoin R (x '' Sᶜ)).grading 𝒜)] :
    ((Algebra.adjoin R (x '' S)).grading 𝒜 ᵍ⊗[R]
      (Algebra.adjoin R (x '' Sᶜ)).grading 𝒜) ≃ₐ[R] A := by
  classical
  let T₁ := Algebra.adjoin R (x '' S)
  let T₂ := Algebra.adjoin R (x '' Sᶜ)
  let 𝒯₁ := T₁.grading 𝒜
  let 𝒯₂ := T₂.grading 𝒜
  have hx₁ := hx.restrict S
  have hx₂ := hx.restrict Sᶜ
  have hcomm : ∀ ⦃i j : ℤ⦄ (a : 𝒯₁ i) (b : 𝒯₂ j),
      (T₁.gradedVal 𝒜 a : A) * T₂.gradedVal 𝒜 b =
        (-1 : ℤˣ) ^ (j * i) • (T₂.gradedVal 𝒜 b * T₁.gradedVal 𝒜 a) := fun i j a b => by
    rw [_root_.mul_comm j i]
    simpa [Int.negOnePow_def, Subalgebra.coe_gradedVal] using
      hx.mul_comm_graded ((Subalgebra.mem_grading_iff T₁ 𝒜).1 a.2)
        ((Subalgebra.mem_grading_iff T₂ 𝒜).1 b.2)
  let fwd : gradedTensorGrading 𝒯₁ 𝒯₂ →ₐᵍ[R] 𝒜 :=
    gradedTensorLift 𝒯₁ 𝒯₂ 𝒜 (T₁.gradedVal 𝒜) (T₂.gradedVal 𝒜) hcomm
  let img : ι → 𝒯₁ ᵍ⊗[R] 𝒯₂ := fun i =>
    if h : i ∈ S then
      (⟨x i, Algebra.subset_adjoin ⟨i, h, rfl⟩⟩ : T₁) ᵍ⊗ₜ[R] (1 : T₂)
    else
      (1 : T₁) ᵍ⊗ₜ[R] (⟨x i, Algebra.subset_adjoin ⟨i, h, rfl⟩⟩ : T₂)
  have himg_mem : ∀ i, img i ∈ gradedTensorGrading 𝒯₁ 𝒯₂ (deg i) := fun i => by
    by_cases h : i ∈ S
    · simpa [img, h] using tmul_mem_gradedTensorGrading 𝒯₁ 𝒯₂
        ((Subalgebra.mem_grading_iff T₁ 𝒜).2 (hx.mem i) :
          (⟨x i, Algebra.subset_adjoin ⟨i, h, rfl⟩⟩ : T₁) ∈ 𝒯₁ (deg i))
        (SetLike.one_mem_graded 𝒯₂)
    · simpa [img, h] using tmul_mem_gradedTensorGrading 𝒯₁ 𝒯₂
        (SetLike.one_mem_graded 𝒯₁)
        ((Subalgebra.mem_grading_iff T₂ 𝒜).2 (hx.mem i) :
          (⟨x i, Algebra.subset_adjoin ⟨i, h, rfl⟩⟩ : T₂) ∈ 𝒯₂ (deg i))
  have hTcomm : ∀ {p q : ℤ} {u v : 𝒯₁ ᵍ⊗[R] 𝒯₂},
      u ∈ gradedTensorGrading 𝒯₁ 𝒯₂ p → v ∈ gradedTensorGrading 𝒯₁ 𝒯₂ q →
      u * v = (p * q).negOnePow • (v * u) :=
    gradedTensor_mul_comm_of_mul_comm 𝒯₁ 𝒯₂
      (fun ha hb => Subtype.ext (hx.mul_comm_graded
        ((Subalgebra.mem_grading_iff T₁ 𝒜).1 ha) ((Subalgebra.mem_grading_iff T₁ 𝒜).1 hb)))
      (fun ha hb => Subtype.ext (hx.mul_comm_graded
        ((Subalgebra.mem_grading_iff T₂ 𝒜).1 ha) ((Subalgebra.mem_grading_iff T₂ 𝒜).1 hb)))
  let bwd : 𝒜 →ₐᵍ[R] gradedTensorGrading 𝒯₁ 𝒯₂ :=
    hx.gradedLift hTcomm img himg_mem
  have hval₁ : ∀ u : T₁, (T₁.gradedVal 𝒜) u = u.1 := congr_fun (Subalgebra.coe_gradedVal T₁ 𝒜)
  have hval₂ : ∀ u : T₂, (T₂.gradedVal 𝒜) u = u.1 := congr_fun (Subalgebra.coe_gradedVal T₂ 𝒜)
  refine AlgEquiv.ofAlgHom fwd.toAlgHom bwd.toAlgHom ?_ ?_
  · refine hx.algHom_ext fun i => ?_
    simp only [AlgHom.comp_apply, AlgHom.id_apply, GradedAlgHom.coe_toAlgHom, bwd,
      hx.gradedLift_apply, fwd]
    by_cases h : i ∈ S <;> simp [img, h, hval₁, hval₂]
  · refine GradedTensorProduct.algHom_ext 𝒯₁ 𝒯₂ ?_ ?_
    · refine hx₁.algHom_ext fun ⟨i, hi⟩ => ?_
      simp [fwd, bwd, hval₁, img, hi]; rfl
    · refine hx₂.algHom_ext fun ⟨i, hi⟩ => ?_
      have hi' : i ∉ S := hi
      simp [fwd, bwd, hval₂, img, hi']; rfl

@[simp]
theorem tensorDecompositionEquiv_tmul [GradedAlgebra 𝒜] [Invertible (2 : R)]
    (hx : IsFreeGradedCommutative 𝒜 x deg) (S : Set ι)
    [GradedAlgebra ((Algebra.adjoin R (x '' S)).grading 𝒜)]
    [GradedAlgebra ((Algebra.adjoin R (x '' Sᶜ)).grading 𝒜)]
    (a : Algebra.adjoin R (x '' S)) (b : Algebra.adjoin R (x '' Sᶜ)) :
    hx.tensorDecompositionEquiv S (a ᵍ⊗ₜ[R] b) = (a : A) * (b : A) := by
  simp only [tensorDecompositionEquiv, AlgEquiv.ofAlgHom_apply, GradedAlgHom.coe_toAlgHom,
    gradedTensorLift_tmul]
  rw [Subalgebra.coe_gradedVal, Subalgebra.coe_gradedVal]

end IsFreeGradedCommutative

end TauCeti
