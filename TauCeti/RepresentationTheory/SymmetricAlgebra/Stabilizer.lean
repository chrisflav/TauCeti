/-!
# Polynomial invariants of point stabilizers and Steinberg's theorem

Let a finite group `G` act linearly on a finite-dimensional vector space `V` over a field `K`. For
any vector `v : V`, the completed-local quotient comparison
(`Representation.adicCompletionUnderKerLiftEvalEquiv`) identifies the completion of `Sym(V*)^G` at
the maximal ideal corresponding to the orbit of `v` with the completion of `Sym(V*)^{G_v}` at its
homogeneous irrelevant ideal. Consequently, `Sym(V*)^G` is regular at the orbit of `v` if and only
if `Sym(V*)^{G_v}` is regular at its vertex
(`Representation.isRegularLocalRing_atPrime_under_ker_lift_eval_iff`).

By the graded regularity criterion
(`Representation.exists_bijective_aeval_symmetricAlgebraInvariants_of_isRegularLocalRing`),
regularity of `Sym(V*)^{G_v}` at its vertex implies—with no assumption on the characteristic of
`K` or on `#G`—that `Sym(V*)^{G_v}` is a polynomial algebra on `dim V` homogeneous invariants of
positive degree. In particular:

* Over an arbitrary field `K`, if `Sym(V*)^G` is a regular ring (for instance, a polynomial
  algebra), then `Sym(V*)^{G_v}` is a polynomial algebra on homogeneous invariants for every
  `v : V`, and likewise for the pointwise stabilizer of any subset `s ⊆ V` whenever
  `#(G ⧸ ker ρ) ≤ #K`.
* In nonmodular characteristic (`#G` invertible in `K`), if `G` is generated by pseudoreflections,
  the forward direction of Chevalley–Shephard–Todd makes `Sym(V*)` faithfully flat over
  `Sym(V*)^G`, so `Sym(V*)^G` is a regular ring and `Sym(V*)^{G_v}` is a polynomial algebra on
  `dim V` homogeneous invariants of positive degree.
* In characteristic zero (`[CharZero K]`), combining this polynomiality with the converse of
  Chevalley–Shephard–Todd (`ShephardTodd`) yields **Steinberg's theorem**: for a faithful finite
  pseudoreflection representation in characteristic zero, the stabilizer `G_v` of any `v ∈ V`
  (and more generally the pointwise stabilizer of any subset `s ⊆ V`) is itself generated by the
  pseudoreflections of `G` fixing `v` (respectively, every point of `s`). Both directions of
  Chevalley–Shephard–Todd precede this proof rather than depending on it.

## Main results

* `exists_bijective_aeval_symmetricAlgebraInvariants_dual_stabilizer_of_isRegularLocalRing`:
  if `Sym(V*)^G` is regular at the orbit of `v`, then `Sym(V*)^{G_v}` is a polynomial algebra on
  `dim V` homogeneous invariants of positive degree (characteristic-free).
* `exists_bijective_aeval_symmetricAlgebraInvariants_dual_stabilizer_of_isRegularRing`:
  if `Sym(V*)^G` is a regular ring and `G ⧸ ker ρ` is finite, then `Sym(V*)^{G_v}` is a
  polynomial algebra on `dim V` homogeneous invariants of positive degree for every `v : V`.
* `isRegularRing_symmetricAlgebraInvariants_dual_of_pseudoreflectionSubgroup_eq_top`:
  if `#G` is invertible in `K` and `G` is generated by pseudoreflections, then `Sym(V*)^G` is a
  regular ring.
* `Representation.pseudoreflectionSubgroup_comp_stabilizer_eq_top`,
  `Representation.stabilizer_eq_closure_finrank_quotient_fixedSubmodule_eq_one`: **Steinberg's
  theorem** for the stabilizer of a vector `v ∈ V` in characteristic zero.
* `Representation.pseudoreflectionSubgroup_comp_biInf_stabilizer_eq_top`,
  `Representation.biInf_stabilizer_eq_closure_finrank_quotient_fixedSubmodule_eq_one`:
  **Steinberg's theorem** for the pointwise stabilizer of an arbitrary subset `s ⊆ V`.
* `Representation.pseudoreflectionSubgroup_comp_stabilizer_sup_ker_eq_top`,
  `Representation.pseudoreflectionSubgroup_comp_biInf_stabilizer_sup_ker_eq_top`: Steinberg's
  theorem for representations with finite faithful image `G ⧸ ker ρ`.

## References

* R. Steinberg, *Differential equations invariant under finite reflection groups*, Trans. Amer.
  Math. Soc. **112** (1964), 392–400, Theorem 1.5 and Corollary 1.6.
* N. Bourbaki, *Lie Groups and Lie Algebras*, Chapters 4–6, Chapter V, § 5, Exercise 8.
* R. Kane, *Reflection Groups and Invariant Theory*, Springer (2001), § 22.1.
* L. Smith, *Polynomial Invariants of Finite Groups*, A K Peters (1995), § 7.4.
-/

public section

open TauCeti.SymmetricAlgebra

namespace Representation

section QuotientStabilizer

variable {R G M : Type*} [CommSemiring R] [Group G] [AddCommMonoid M] [Module R M]
  (ρ : Representation R G M)

/-- The canonical surjective homomorphism from `ρ.stabilizer v` onto
`(ρ.ofQuotient ρ.ker).stabilizer v` induced by `QuotientGroup.mk' ρ.ker`. -/
private def stabilizerToOfQuotientKer (v : M) :
    ρ.stabilizer v →* (ρ.ofQuotient ρ.ker).stabilizer v :=
  ((QuotientGroup.mk' ρ.ker).domRestrict (ρ.stabilizer v)).codRestrict
    ((ρ.ofQuotient ρ.ker).stabilizer v) fun h ↦ by
      rw [mem_stabilizer]
      exact (ρ.ofQuotient_coe_apply ρ.ker h.1 v).trans h.2

private theorem stabilizerToOfQuotientKer_surjective (v : M) :
    Function.Surjective (ρ.stabilizerToOfQuotientKer v) := by
  intro q
  obtain ⟨g, hg⟩ := QuotientGroup.mk'_surjective ρ.ker q.1
  have hgv : g ∈ ρ.stabilizer v := by
    rw [mem_stabilizer]
    have hq : (ρ.ofQuotient ρ.ker) (QuotientGroup.mk' ρ.ker g) v = v := hg.symm ▸ q.2
    exact (ρ.ofQuotient_coe_apply ρ.ker g v).symm.trans hq
  exact ⟨⟨g, hgv⟩, Subtype.ext hg⟩

private theorem ofQuotient_ker_comp_stabilizerToOfQuotientKer (v : M) :
    ((ρ.ofQuotient ρ.ker).comp ((ρ.ofQuotient ρ.ker).stabilizer v).subtype).comp
      (ρ.stabilizerToOfQuotientKer v) =
      ρ.comp (ρ.stabilizer v).subtype :=
  MonoidHom.ext fun h ↦ LinearMap.ext fun m ↦ ρ.ofQuotient_coe_apply ρ.ker h.1 m

private theorem ker_stabilizerToOfQuotientKer (v : M) :
    (ρ.stabilizerToOfQuotientKer v).ker = MonoidHom.ker (ρ.comp (ρ.stabilizer v).subtype) := by
  ext h
  dsimp only [stabilizerToOfQuotientKer]
  rw [MonoidHom.ker_codRestrict, MonoidHom.mem_ker, MonoidHom.domRestrict_apply,
    ← MonoidHom.mem_ker, QuotientGroup.ker_mk', MonoidHom.mem_ker, MonoidHom.mem_ker,
    MonoidHom.comp_apply, Subgroup.coe_subtype]

/-- Quotienting by `ker ρ` preserves the polynomial invariant subalgebra of the stabilizer of `v`
inside the same ambient symmetric algebra `Sym(M*)`. -/
theorem symmetricAlgebraInvariants_dual_comp_stabilizer_ofQuotient_ker (v : M) :
    (dual (ρ.comp (ρ.stabilizer v).subtype)).symmetricAlgebraInvariants =
      (dual ((ρ.ofQuotient ρ.ker).comp
        ((ρ.ofQuotient ρ.ker).stabilizer v).subtype)).symmetricAlgebraInvariants := by
  have hcomp :
      (dual ((ρ.ofQuotient ρ.ker).comp ((ρ.ofQuotient ρ.ker).stabilizer v).subtype)).comp
        (ρ.stabilizerToOfQuotientKer v) =
        dual (ρ.comp (ρ.stabilizer v).subtype) := by
    rw [← dual_comp, ρ.ofQuotient_ker_comp_stabilizerToOfQuotientKer v]
  exact (congrArg symmetricAlgebraInvariants hcomp.symm).trans
    ((dual ((ρ.ofQuotient ρ.ker).comp
      ((ρ.ofQuotient ρ.ker).stabilizer v).subtype)).symmetricAlgebraInvariants_comp_of_surjective
        (ρ.stabilizerToOfQuotientKer v) (ρ.stabilizerToOfQuotientKer_surjective v))

end QuotientStabilizer

section Regular

variable {K G V : Type*} [Field K] [Group G] [AddCommGroup V] [Module K V] [FiniteDimensional K V]
  (ρ : Representation K G V)

/-- **Polynomial stabilizer invariants from local regularity.** Let a finite group `G` act linearly
on a finite-dimensional vector space `V` over an arbitrary field `K`, and let `v : V`. If the
invariant algebra `Sym(V*)^G` is regular at the contraction of the evaluation ideal at `v`, then
the stabilizer invariant algebra `Sym(V*)^{G_v}` is a polynomial algebra on `dim V` homogeneous
invariants of positive degree. Neither `CharZero K` nor invertibility of `#G` is needed. -/
theorem exists_bijective_aeval_symmetricAlgebraInvariants_dual_stabilizer_of_isRegularLocalRing
    [Finite G] (v : V)
    [IsRegularLocalRing (Localization.AtPrime
      ((RingHom.ker (SymmetricAlgebra.lift (Module.Dual.eval K V v))).under
        ρ.dual.symmetricAlgebraInvariants))] :
    ∃ f : Fin (Module.finrank K V) →
        (dual (ρ.comp (ρ.stabilizer v).subtype)).symmetricAlgebraInvariants,
      (∀ i, ∃ d, 0 < d ∧ (f i : SymmetricAlgebra K (Module.Dual K V)) ∈
        homogeneousSubmodule K (Module.Dual K V) d) ∧
        Function.Bijective (MvPolynomial.aeval (R := K) f) := by
  have : IsRegularLocalRing (Localization.AtPrime
      ((HomogeneousIdeal.irrelevant (homogeneousSubmodule K (Module.Dual K V))).toIdeal.under
        (dual (ρ.comp (ρ.stabilizer v).subtype)).symmetricAlgebraInvariants)) :=
    (ρ.isRegularLocalRing_atPrime_under_ker_lift_eval_iff v).mp inferInstance
  let ρv := dual (ρ.comp (ρ.stabilizer v).subtype)
  obtain ⟨f, hf, hbij⟩ :=
    ρv.exists_bijective_aeval_symmetricAlgebraInvariants_of_isRegularLocalRing
  let e := finCongr (Subspace.dual_finrank_eq (K := K) (V := V)).symm
  refine ⟨f ∘ e, fun i ↦ hf (e i), ?_⟩
  have haeval : MvPolynomial.aeval (R := K) (f ∘ e) =
      (MvPolynomial.aeval f).comp (MvPolynomial.rename e) := by
    ext
    simp
  rw [haeval]
  exact hbij.comp (MvPolynomial.renameEquiv K e).bijective

/-- **Polynomial stabilizer invariants from global regularity.** If `G ⧸ ker ρ` is finite and
`Sym(V*)^G` is a regular ring (for instance, a polynomial algebra in any characteristic), then for
every `v : V` the stabilizer invariant algebra `Sym(V*)^{G_v}` is a polynomial algebra on `dim V`
homogeneous invariants of positive degree. -/
theorem exists_bijective_aeval_symmetricAlgebraInvariants_dual_stabilizer_of_isRegularRing
    [Finite (G ⧸ ρ.ker)] [IsRegularRing ρ.dual.symmetricAlgebraInvariants] (v : V) :
    ∃ f : Fin (Module.finrank K V) →
        (dual (ρ.comp (ρ.stabilizer v).subtype)).symmetricAlgebraInvariants,
      (∀ i, ∃ d, 0 < d ∧ (f i : SymmetricAlgebra K (Module.Dual K V)) ∈
        homogeneousSubmodule K (Module.Dual K V) d) ∧
        Function.Bijective (MvPolynomial.aeval (R := K) f) := by
  let ρ' := ρ.ofQuotient ρ.ker
  have hreg : IsRegularRing ρ'.dual.symmetricAlgebraInvariants := by
    rw [ρ.symmetricAlgebraInvariants_dual_ofQuotient ρ.ker]
    infer_instance
  have : IsRegularLocalRing (Localization.AtPrime
      ((RingHom.ker (SymmetricAlgebra.lift (Module.Dual.eval K V v))).under
        ρ'.dual.symmetricAlgebraInvariants)) :=
    IsRegularRing.isRegularLocalRing_localization _
  rw [ρ.symmetricAlgebraInvariants_dual_comp_stabilizer_ofQuotient_ker v]
  exact
    ρ'.exists_bijective_aeval_symmetricAlgebraInvariants_dual_stabilizer_of_isRegularLocalRing v

/-- **Polynomial pointwise-stabilizer invariants from global regularity.** If `G ⧸ ker ρ` is
finite with `#(G ⧸ ker ρ) ≤ #K` and `Sym(V*)^G` is a regular ring, then for every subset `s ⊆ V`
the invariant algebra of the pointwise stabilizer `⨅ v ∈ s, ρ.stabilizer v` is a polynomial
algebra on `dim V` homogeneous invariants of positive degree. -/
theorem exists_bijective_aeval_symmetricAlgebraInvariants_dual_biInf_stabilizer_of_isRegularRing
    [Finite (G ⧸ ρ.ker)] [IsRegularRing ρ.dual.symmetricAlgebraInvariants]
    (hcard : (Nat.card (G ⧸ ρ.ker) : ENat) ≤ ENat.card K) (s : Set V) :
    ∃ f : Fin (Module.finrank K V) →
        (dual (ρ.comp (⨅ v ∈ s, ρ.stabilizer v).subtype)).symmetricAlgebraInvariants,
      (∀ i, ∃ d, 0 < d ∧ (f i : SymmetricAlgebra K (Module.Dual K V)) ∈
        homogeneousSubmodule K (Module.Dual K V) d) ∧
        Function.Bijective (MvPolynomial.aeval (R := K) f) := by
  obtain ⟨v, -, hv⟩ := ρ.exists_mem_span_stabilizer_eq_biInf hcard s
  rw [← hv]
  exact ρ.exists_bijective_aeval_symmetricAlgebraInvariants_dual_stabilizer_of_isRegularRing v

end Regular

section Pseudoreflection

variable {K G V : Type*} [Field K] [Group G] [AddCommGroup V] [Module K V] [FiniteDimensional K V]
  (ρ : Representation K G V)

/-- **Regularity of polynomial invariants for nonmodular pseudoreflection groups.** If `G` is
finite with `#G` invertible in `K` and is generated by pseudoreflections, then `Sym(V*)^G` is a
regular ring. -/
theorem isRegularRing_symmetricAlgebraInvariants_dual_of_pseudoreflectionSubgroup_eq_top
    [Fintype G] [Invertible (Fintype.card G : K)] (hG : ρ.pseudoreflectionSubgroup = ⊤) :
    IsRegularRing ρ.dual.symmetricAlgebraInvariants := by
  have := ρ.faithfullyFlat_symmetricAlgebra_dual_of_pseudoreflectionSubgroup_eq_top hG
  exact TauCeti.IsRegularRing.of_faithfullyFlat (S := SymmetricAlgebra K (Module.Dual K V))

/-- **Regularity of polynomial invariants for a finite faithful image.** If `G ⧸ ker ρ` is finite
with order invertible in `K` and pseudoreflections together with `ker ρ` generate `G`, then
`Sym(V*)^G` is a regular ring. -/
theorem isRegularRing_symmetricAlgebraInvariants_dual_of_pseudoreflectionSubgroup_sup_ker_eq_top
    [Finite (G ⧸ ρ.ker)] [Invertible (Nat.card (G ⧸ ρ.ker) : K)]
    (hG : ρ.pseudoreflectionSubgroup ⊔ ρ.ker = ⊤) :
    IsRegularRing ρ.dual.symmetricAlgebraInvariants := by
  classical
  let := Fintype.ofFinite (G ⧸ ρ.ker)
  let : Invertible (Fintype.card (G ⧸ ρ.ker) : K) :=
    Invertible.copy (inferInstance : Invertible (Nat.card (G ⧸ ρ.ker) : K)) _
      (by rw [Nat.card_eq_fintype_card])
  rw [← ρ.symmetricAlgebraInvariants_dual_ofQuotient ρ.ker]
  exact (ρ.ofQuotient ρ.ker)
    |>.isRegularRing_symmetricAlgebraInvariants_dual_of_pseudoreflectionSubgroup_eq_top
      (ρ.pseudoreflectionSubgroup_ofQuotient_ker_eq_top_iff.mpr hG)

end Pseudoreflection

section Steinberg

variable {K G V : Type*} [Field K] [CharZero K] [Group G] [AddCommGroup V] [Module K V]
  [FiniteDimensional K V] (ρ : Representation K G V)

/-- **Steinberg's theorem.** Let a finite group `G` act faithfully and linearly on a
finite-dimensional vector space `V` over a field `K` of characteristic zero. If `G` is generated by
pseudoreflections, then for every `v : V` the point stabilizer `ρ.stabilizer v` is generated by its
own pseudoreflections. -/
theorem pseudoreflectionSubgroup_comp_stabilizer_eq_top [Finite G]
    (hρ : Function.Injective ρ) (hG : ρ.pseudoreflectionSubgroup = ⊤) (v : V) :
    pseudoreflectionSubgroup (ρ.comp (ρ.stabilizer v).subtype) = ⊤ := by
  classical
  have := Fintype.ofFinite G
  have : Invertible (Fintype.card G : K) :=
    invertibleOfNonzero (Nat.cast_ne_zero.2 Fintype.card_ne_zero)
  have := ρ.isRegularRing_symmetricAlgebraInvariants_dual_of_pseudoreflectionSubgroup_eq_top hG
  obtain ⟨f, hf, hbij⟩ :=
    ρ.exists_bijective_aeval_symmetricAlgebraInvariants_dual_stabilizer_of_isRegularRing v
  choose d _ hd using hf
  exact pseudoreflectionSubgroup_eq_top_of_bijective_aeval_symmetricAlgebraInvariants_dual
    (ρ.comp (ρ.stabilizer v).subtype) (hρ.comp Subtype.val_injective) hd hbij

/-- **Steinberg's theorem (closure form).** For a faithful finite pseudoreflection representation
in characteristic zero, the stabilizer of any vector `v : V` is generated by the pseudoreflections
of `G` that fix `v`. -/
theorem stabilizer_eq_closure_finrank_quotient_fixedSubmodule_eq_one [Finite G]
    (hρ : Function.Injective ρ) (hG : ρ.pseudoreflectionSubgroup = ⊤) (v : V) :
    ρ.stabilizer v = Subgroup.closure
      {g : G | Module.finrank K (V ⧸ (ρ g).fixedSubmodule) = 1 ∧ ρ g v = v} := by
  have htop := congrArg (Subgroup.map (ρ.stabilizer v).subtype)
    (ρ.pseudoreflectionSubgroup_comp_stabilizer_eq_top hρ hG v)
  rw [pseudoreflectionSubgroup_def, MonoidHom.map_closure] at htop
  have hrange :
      (⊤ : Subgroup (ρ.stabilizer v)).map (ρ.stabilizer v).subtype = ρ.stabilizer v := by
    ext g
    simp
  rw [hrange] at htop
  refine htop.symm.trans (congrArg Subgroup.closure ?_)
  ext g
  simp only [Set.mem_image, Set.mem_ofPred, MonoidHom.comp_apply, Subgroup.coe_subtype]
  exact ⟨fun ⟨h, h1, h2⟩ ↦ ⟨h2 ▸ h1, h2 ▸ h.2⟩,
    fun ⟨h1, h2⟩ ↦ ⟨⟨g, ρ.mem_stabilizer.mpr h2⟩, h1, rfl⟩⟩

/-- **Steinberg's theorem for pointwise stabilizers.** For a faithful finite pseudoreflection
representation in characteristic zero and any subset `s ⊆ V`, the pointwise stabilizer
`⨅ v ∈ s, ρ.stabilizer v` is generated by its own pseudoreflections. -/
theorem pseudoreflectionSubgroup_comp_biInf_stabilizer_eq_top [Finite G]
    (hρ : Function.Injective ρ) (hG : ρ.pseudoreflectionSubgroup = ⊤) (s : Set V) :
    pseudoreflectionSubgroup (ρ.comp (⨅ v ∈ s, ρ.stabilizer v).subtype) = ⊤ := by
  obtain ⟨v, -, hv⟩ := ρ.exists_mem_span_stabilizer_eq_biInf_of_infinite s
  rw [← hv]
  exact ρ.pseudoreflectionSubgroup_comp_stabilizer_eq_top hρ hG v

/-- **Steinberg's theorem for pointwise stabilizers (closure form).** For a faithful finite
pseudoreflection representation in characteristic zero and any subset `s ⊆ V`, the pointwise
stabilizer `⨅ v ∈ s, ρ.stabilizer v` is generated by the pseudoreflections of `G` fixing every
point of `s`. -/
theorem biInf_stabilizer_eq_closure_finrank_quotient_fixedSubmodule_eq_one [Finite G]
    (hρ : Function.Injective ρ) (hG : ρ.pseudoreflectionSubgroup = ⊤) (s : Set V) :
    (⨅ v ∈ s, ρ.stabilizer v) = Subgroup.closure
      {g : G | Module.finrank K (V ⧸ (ρ g).fixedSubmodule) = 1 ∧ ∀ v ∈ s, ρ g v = v} := by
  obtain ⟨v, -, hv⟩ := ρ.exists_mem_span_stabilizer_eq_biInf_of_infinite s
  rw [← hv, ρ.stabilizer_eq_closure_finrank_quotient_fixedSubmodule_eq_one hρ hG v]
  congr 1
  ext g
  simp only [Set.mem_ofPred, ← ρ.mem_stabilizer, hv, Subgroup.mem_iInf]

/-- **Steinberg's theorem for a finite faithful image.** Suppose `G ⧸ ker ρ` is finite and
pseudoreflections together with `ker ρ` generate `G`. Then for every `v : V`, the pseudoreflections
fixing `v` together with `ker ρ` generate `ρ.stabilizer v`. -/
theorem pseudoreflectionSubgroup_comp_stabilizer_sup_ker_eq_top [Finite (G ⧸ ρ.ker)]
    (hG : ρ.pseudoreflectionSubgroup ⊔ ρ.ker = ⊤) (v : V) :
    pseudoreflectionSubgroup (ρ.comp (ρ.stabilizer v).subtype) ⊔
      MonoidHom.ker (ρ.comp (ρ.stabilizer v).subtype) = ⊤ := by
  have hρ' : Function.Injective (ρ.ofQuotient ρ.ker) :=
    (ρ.injective_ofQuotient_iff ρ.ker).mpr rfl
  have hG' : (ρ.ofQuotient ρ.ker).pseudoreflectionSubgroup = ⊤ :=
    ρ.pseudoreflectionSubgroup_ofQuotient_ker_eq_top_iff.mpr hG
  have hstab :=
    (ρ.ofQuotient ρ.ker).pseudoreflectionSubgroup_comp_stabilizer_eq_top hρ' hG' v
  have hcomap := comap_pseudoreflectionSubgroup
    ((ρ.ofQuotient ρ.ker).comp ((ρ.ofQuotient ρ.ker).stabilizer v).subtype)
    (ρ.stabilizerToOfQuotientKer v) (ρ.stabilizerToOfQuotientKer_surjective v)
  rw [hstab, Subgroup.comap_top, ρ.ofQuotient_ker_comp_stabilizerToOfQuotientKer v,
    ρ.ker_stabilizerToOfQuotientKer v] at hcomap
  exact hcomap.symm

/-- **Steinberg's theorem for pointwise stabilizers of a finite faithful image.** Suppose
`G ⧸ ker ρ` is finite and pseudoreflections together with `ker ρ` generate `G`. Then for every
subset `s ⊆ V`, the pseudoreflections fixing `s` pointwise together with `ker ρ` generate
`⨅ v ∈ s, ρ.stabilizer v`. -/
theorem pseudoreflectionSubgroup_comp_biInf_stabilizer_sup_ker_eq_top [Finite (G ⧸ ρ.ker)]
    (hG : ρ.pseudoreflectionSubgroup ⊔ ρ.ker = ⊤) (s : Set V) :
    pseudoreflectionSubgroup (ρ.comp (⨅ v ∈ s, ρ.stabilizer v).subtype) ⊔
      MonoidHom.ker (ρ.comp (⨅ v ∈ s, ρ.stabilizer v).subtype) = ⊤ := by
  obtain ⟨v, -, hv⟩ := ρ.exists_mem_span_stabilizer_eq_biInf_of_infinite s
  rw [← hv]
  exact ρ.pseudoreflectionSubgroup_comp_stabilizer_sup_ker_eq_top hG v

end Steinberg

end Representation
