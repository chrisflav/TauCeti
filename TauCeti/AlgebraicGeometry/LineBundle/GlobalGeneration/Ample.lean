/-!
# Serre's Theorem A: global generation by ample twists

Let `X` be a quasi-compact, quasi-separated scheme, `L` an ample line bundle on `X`, and `F` a
quasi-coherent `𝒪_X`-module of finite type. This file proves **Serre's Theorem A**: for every
sufficiently large `n : ℕ`, the twisted sheaf `F ⊗ L^{⊗n}` is generated by finitely many global
sections (`TauCeti.AlgebraicGeometry.LineBundleClass.IsAmple.exists_epi_free_tensor_tensorPow`),
and consequently `F` is a quotient of a finite direct sum of copies of `(L^{⊗n})∨`
(`TauCeti.AlgebraicGeometry.LineBundleClass.IsAmple.exists_epi_biproduct_dual_tensorPow`). No
Noetherian hypothesis is required.

## Main results

* `AlgebraicGeometry.Scheme.Modules.nonvanishingLocus_tensorPowSection`: for `n > 0`, the
  nonvanishing locus of `sⁿ` in `L^{⊗n}` equals the nonvanishing locus of `s` in `L`.
* `AlgebraicGeometry.Scheme.Modules.epi_freeHomEquiv_symm_of_affine_cover`: a finite family of
  global sections of a quasi-coherent module generates the sheaf if it generates sections on every
  member of an affine open cover.
* `AlgebraicGeometry.Scheme.Modules.exists_epi_free_tensor_tensorPow_of_iSup_nonvanishingLocus`:
  global generation of twists `F ⊗ L^{⊗n}` for `n ≫ 0` when `X` is covered by finitely many affine
  nonvanishing loci of global sections of `L`.
* `TauCeti.AlgebraicGeometry.LineBundleClass.mk_tensorPow`: the line-bundle class of `L^{⊗n}` is
  `[L]^n`.
* `TauCeti.AlgebraicGeometry.LineBundleClass.IsAmple.exists_pos_iSup_nonvanishingLocus_tensorPow`:
  some positive tensor power `L^{⊗D}` of an ample line bundle admits finitely many global sections
  whose nonvanishing loci are affine and cover `X`.
* `TauCeti.AlgebraicGeometry.LineBundleClass.IsAmple.exists_epi_free_tensor_tensorPow`: Serre's
  Theorem A for an arbitrary ample line bundle on a quasi-separated scheme.
* `TauCeti.AlgebraicGeometry.LineBundleClass.IsAmple.exists_epi_biproduct_dual_tensorPow`:
  presentation of `F` as a quotient of a finite direct sum of copies of `(L^{⊗n})∨` for `n ≫ 0`.

## References

* R. Hartshorne, *Algebraic Geometry*, GTM 52, Springer, 1977, Theorem II.5.17.
* [The Stacks Project, Tag 01Q3](https://stacks.math.columbia.edu/tag/01Q3), global generation of
  finite-type quasi-coherent modules twisted by an ample invertible sheaf.
-/

public section

open CategoryTheory Limits MonoidalCategory AlgebraicGeometry Opposite TopologicalSpace TauCeti
open TauCeti.AlgebraicGeometry

universe u

noncomputable section

namespace AlgebraicGeometry.Scheme.Modules

variable {X : Scheme.{u}}

/-! ### Tensor powers of invertible sheaves and their sections -/

/-- The `n`-th monoidal tensor power of an invertible sheaf is invertible. -/
instance isInvertible_tensorPow (L : X.Modules)
    [TauCeti.AlgebraicGeometry.SheafOfModules.isInvertible X L] (n : ℕ) :
    TauCeti.AlgebraicGeometry.SheafOfModules.isInvertible X (tensorPow L n) := by
  induction n with
  | zero =>
    exact (TauCeti.AlgebraicGeometry.SheafOfModules.isInvertible X).prop_of_iso
      (InvertibleSheaf.trivialObjIsoUnit X) (InvertibleSheaf.trivial X).property
  | succ n ih =>
    let K : InvertibleSheaf X := ⟨L, ‹_›⟩
    let Kn : InvertibleSheaf X := ⟨tensorPow L n, ih⟩
    exact (TauCeti.AlgebraicGeometry.SheafOfModules.isInvertible X).prop_of_iso
      (InvertibleSheaf.tensorProductObjIso K Kn) (InvertibleSheaf.tensorProduct K Kn).property

/-- For `n > 0` and an invertible sheaf `L`, the nonvanishing locus of `sⁿ ∈ Γ(L^{⊗n}, U)` equals
the nonvanishing locus of `s ∈ Γ(L, U)`. -/
theorem nonvanishingLocus_tensorPowSection {L : X.Modules}
    [TauCeti.AlgebraicGeometry.SheafOfModules.isInvertible X L] {U : X.Opens} (s : Γ(L, U))
    {n : ℕ} (hn : 0 < n) :
    (tensorPow L n).nonvanishingLocus (tensorPowSection s n) = L.nonvanishingLocus s := by
  ext x
  by_cases hxU : x ∈ U
  · obtain ⟨V, t, hxV⟩ := exists_mem_trivialization L x
    let W := U ⊓ V
    let i : W ⟶ U := homOfLE inf_le_left
    let j : W ⟶ V := homOfLE inf_le_right
    have hxW : x ∈ W := ⟨hxU, hxV⟩
    have hWle : W ≤ L.nonvanishingLocus (L.presheaf.map j.op (trivializationGenerator L t)) := by
      rw [nonvanishingLocus_map, nonvanishingLocus_trivializationGenerator]
      exact le_inf le_rfl inf_le_right
    obtain ⟨f, hf⟩ := surjective_smul_of_le_nonvanishingLocus hWle (L.presheaf.map i.op s)
    -- On `W`, `s|_W = f • e`, so `sⁿ|_W = fⁿ • eⁿ` with `eⁿ` a basis of `L^{⊗n}` over `W`.
    have heW : ∀ (W' : X.Opens) (k : W' ⟶ W),
        Function.Bijective fun r : Γ(X, W') ↦
          r • L.presheaf.map k.op (L.presheaf.map j.op (trivializationGenerator L t)) := by
      intro W' k
      have := (le_nonvanishingLocus_iff _ (𝟙 W)).mp hWle W' k
      simpa only [Category.comp_id] using this
    have henW : W ≤ (tensorPow L n).nonvanishingLocus
        (tensorPowSection (L.presheaf.map j.op (trivializationGenerator L t)) n) := by
      rw [le_nonvanishingLocus_iff _ (𝟙 W)]
      intro W' k
      simpa only [Category.comp_id] using bijective_smul_tensorPowSection _ heW n W' k
    have h1 : W ⊓ L.nonvanishingLocus s = X.basicOpen f := by
      rw [← nonvanishingLocus_map i, ← hf, nonvanishingLocus_smul,
        inf_eq_left.mpr ((X.basicOpen_le f).trans hWle)]
    have h2 : W ⊓ (tensorPow L n).nonvanishingLocus (tensorPowSection s n) =
        X.basicOpen (f ^ n) := by
      rw [← nonvanishingLocus_map i, map_tensorPowSection, ← hf, tensorPowSection_smul,
        nonvanishingLocus_smul, inf_eq_left.mpr ((X.basicOpen_le _).trans henW)]
    have hpow : X.basicOpen (f ^ n) = X.basicOpen f := Scheme.basicOpen_pow _ _ hn
    have hmem1 : x ∈ L.nonvanishingLocus s ↔ x ∈ X.basicOpen f := by
      rw [← h1]
      exact ⟨fun hx ↦ ⟨hxW, hx⟩, fun hx ↦ hx.2⟩
    have hmem2 : x ∈ (tensorPow L n).nonvanishingLocus (tensorPowSection s n) ↔
        x ∈ X.basicOpen (f ^ n) := by
      rw [← h2]
      exact ⟨fun hx ↦ ⟨hxW, hx⟩, fun hx ↦ hx.2⟩
    simpa only [SetLike.mem_coe] using hmem2.trans (hpow ▸ hmem1.symm)
  · exact iff_of_false (fun h ↦ hxU ((tensorPow L n).nonvanishingLocus_le _ h))
      (fun h ↦ hxU (L.nonvanishingLocus_le _ h))

/-! ### Serre's Theorem A -/

/-- If a finite family of global sections of a quasi-coherent module `G` generates `Γ(G, Uᵢ)` on
every member of an affine open cover `{Uᵢ}`, then the induced morphism `𝒪_X^J ⟶ G` is an
epimorphism. -/
theorem epi_freeHomEquiv_symm_of_affine_cover {ι : Type*} (U : ι → X.Opens)
    (hUa : ∀ i, IsAffineOpen (U i)) (hU : ⨆ i, U i = ⊤) {J : Type u} [Finite J]
    {G : X.Modules} [G.IsQuasicoherent] (g : J → Γ(G, ⊤))
    (hgen : ∀ i, Submodule.span Γ(X, U i)
      (Set.range fun j ↦ G.presheaf.map (U i).leTop.op (g j)) = ⊤) :
    Epi (G.freeHomEquiv.symm fun j ↦ G.sectionsEquivTop.symm (g j)) := by
  let F : X.Modules := SheafOfModules.free J
  let π : F ⟶ G := G.freeHomEquiv.symm fun j ↦ G.sectionsEquivTop.symm (g j)
  have hFqc : F.IsQuasicoherent :=
    SheafOfModules.instIsQuasicoherentOfIsFinitePresentation F
  have hJoint : JointlyReflectIsomorphisms fun i ↦ pullback (U i).ι :=
    ⟨fun f _ ↦ (isIso_iff_of_isOpenCover hU f).mpr fun i ↦ inferInstance⟩
  refine (hJoint.jointlyReflectEpimorphisms.epi_iff π).mpr fun i ↦ ?_
  have : IsAffine (U i).toScheme := hUa i
  -- Transfer `Epi` from `(restrictFunctor (U i).ι).map π` to `(pullback (U i).ι).map π`.
  suffices Epi ((restrictFunctor (U i).ι).map π) by
    have e := restrictFunctorIsoPullback (U i).ι
    have hnat : (pullback (U i).ι).map π =
        (e.inv.app F) ≫ (restrictFunctor (U i).ι).map π ≫ (e.hom.app G) := by
      rw [← e.inv.naturality_assoc, Iso.inv_hom_id_app, Category.comp_id]
    rw [hnat]
    exact epi_comp _ _
  let ψ := (restrictFunctor (U i).ι).map π
  have hsurj : Function.Surjective ((sectionsFunctor ⊤).map ψ) := by
    -- Show every section over `U i` lies in the image of `π.app (U i)` by checking on generators.
    have hle : Submodule.span Γ(X, U i)
        (Set.range fun j ↦ G.presheaf.map (U i).leTop.op (g j)) ≤
        LinearMap.range ((sectionsFunctor (U i)).map π).hom := by
      refine Submodule.span_le.mpr ?_
      rintro _ ⟨j, rfl⟩
      refine ⟨(SheafOfModules.freeSection j).val (op (U i)), ?_⟩
      have hfree : SheafOfModules.sectionsMap π (SheafOfModules.freeSection j) =
          G.sectionsEquivTop.symm (g j) :=
        (SheafOfModules.freeHomEquiv_apply (M := G) π j).symm.trans
          (congrFun (G.freeHomEquiv.apply_symm_apply _) j)
      have hval := congrArg (fun σ : G.sections ↦ σ.val (op (U i))) hfree
      rwa [sectionsEquivTop_symm_val] at hval
    have hπsurj : Function.Surjective (π.app (U i)) := fun y ↦ hle (hgen i ▸ Submodule.mem_top)
    intro y
    -- Identify `Γ((restrictFunctor (U i).ι).obj G, ⊤)` with `Γ(G, (U i).ι ''ᵁ ⊤)`.
    let y' : Γ(G, (U i).ι ''ᵁ ⊤) := y
    have himg : (U i).ι ''ᵁ ⊤ = U i := Opens.ι_image_top (U i)
    obtain ⟨x, hx⟩ := hπsurj (G.presheaf.map (eqToHom himg.symm).op y')
    refine ⟨F.presheaf.map (eqToHom himg).op x, ?_⟩
    have hnat := π.mapPresheaf.naturality_apply (eqToHom himg).op x
    simp only [Scheme.Modules.mapPresheaf_app, unop_op] at hnat
    have heq : π.app ((U i).ι ''ᵁ ⊤) (F.presheaf.map (eqToHom himg).op x) = y' := by
      rw [hnat, hx, ← ConcreteCategory.comp_apply, ← CategoryTheory.Functor.map_comp, ← op_comp,
        eqToHom_trans, eqToHom_refl, op_id, CategoryTheory.Functor.map_id]
      -- The identity morphism on `Γ(G, (U i).ι ''ᵁ ⊤)` acts as the identity function.
      rfl
    exact heq
  have : IsIso (image.ι ψ) := by
    refine isIso_of_mono_of_surjective_sectionsFunctor_map_top (image.ι ψ) fun y ↦ ?_
    obtain ⟨x, rfl⟩ := hsurj y
    refine ⟨((sectionsFunctor ⊤).map (factorThruImage ψ)) x, ?_⟩
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp, image.fac]
  have := epi_comp (factorThruImage ψ) (image.ι ψ)
  rwa [image.fac] at this

/-- **Global generation of twists for a finite affine nonvanishing cover.** Let `X` be
quasi-compact and quasi-separated, `L` an invertible sheaf with finitely many global sections
`sᵢ` whose nonvanishing loci `X_{sᵢ}` are affine and cover `X`, and `F` a quasi-coherent
`𝒪_X`-module of finite type. Then there exists `n₀ : ℕ` such that for every `n ≥ n₀`,
`F ⊗ L^{⊗n}` is generated by finitely many global sections. -/
theorem exists_epi_free_tensor_tensorPow_of_iSup_nonvanishingLocus
    [CompactSpace X] [QuasiSeparatedSpace X]
    {L : X.Modules} [TauCeti.AlgebraicGeometry.SheafOfModules.isInvertible X L]
    {ι : Type*} [Finite ι] (s : ι → Γ(L, ⊤))
    (hs_aff : ∀ i, IsAffineOpen (L.nonvanishingLocus (s i)))
    (hs_cov : ⨆ i, L.nonvanishingLocus (s i) = ⊤)
    (F : X.Modules) [F.IsQuasicoherent] [F.IsFiniteType] :
    ∃ n₀ : ℕ, ∀ n ≥ n₀,
      ∃ (J : Type u) (_ : Finite J) (π : SheafOfModules.free J ⟶ F ⊗ tensorPow L n), Epi π := by
  classical
  cases nonempty_fintype ι
  let U (i : ι) : X.Opens := L.nonvanishingLocus (s i)
  -- On each affine chart `U i`, pick finitely many generators of `Γ(F, U i)`.
  have hfg (i : ι) : ∃ T : Finset Γ(F, U i), Submodule.span Γ(X, U i) (T : Set Γ(F, U i)) = ⊤ := by
    have := F.finite_sections_of_isAffineOpen (U i) (hs_aff i)
    exact Module.Finite.fg_top
  choose T hT using hfg
  let J₀ := Σ i : ι, {t : Γ(F, U i) // t ∈ T i}
  -- Extend each generator `t` on `U i` after tensoring with a power `sᵢ^{m(i, t)}`.
  have hext (j : J₀) : ∃ (m : ℕ) (t' : Γ(F ⊗ tensorPow L m, ⊤)),
      (F ⊗ tensorPow L m).presheaf.map (homOfLE (L.nonvanishingLocus_le (s j.1))).op t' =
        tmulRight F (tensorPowSection
          (L.presheaf.map (homOfLE (L.nonvanishingLocus_le (s j.1))).op (s j.1)) m) j.2.1 :=
    exists_map_eq_tmulRight_tensorPowSection F isCompact_univ isQuasiSeparated_univ (s j.1) j.2.1
  choose m t' ht' using hext
  let n₀ : ℕ := Finset.univ.sup m
  refine ⟨n₀, fun n hn ↦ ?_⟩
  -- For any `n ≥ n₀`, raise `t' j` from twist `m j` to twist `n` by tensoring with `sᵢ^{n - m j}`.
  let raiseIso (j : J₀) : (F ⊗ tensorPow L (m j)) ⊗ tensorPow L (n - m j) ≅ F ⊗ tensorPow L n :=
    α_ F (tensorPow L (m j)) (tensorPow L (n - m j)) ≪≫
      whiskerLeftIso F (tensorPowAddIso L (m j) (n - m j)) ≪≫
      eqToIso (by
        have hle : m j ≤ n := (Finset.le_sup (f := m) (Finset.mem_univ j)).trans hn
        rw [Nat.sub_add_cancel hle])
  let g₀ (j : J₀) : Γ(F ⊗ tensorPow L n, ⊤) :=
    (raiseIso j).hom.app ⊤
      (tmulRight (F ⊗ tensorPow L (m j)) (tensorPowSection (s j.1) (n - m j)) (t' j))
  -- Restricting `g₀ j` to `U j.1` yields `j.2.1 ⊗ s_{j.1}ⁿ`.
  have hg₀_res (j : J₀) : (F ⊗ tensorPow L n).presheaf.map (U j.1).leTop.op (g₀ j) =
      tmulRight F (tensorPowSection (L.presheaf.map (U j.1).leTop.op (s j.1)) n) j.2.1 := by
    have hle : m j ≤ n := (Finset.le_sup (f := m) (Finset.mem_univ j)).trans hn
    have hnat := (raiseIso j).hom.mapPresheaf.naturality_apply (U j.1).leTop.op
      (tmulRight (F ⊗ tensorPow L (m j)) (tensorPowSection (s j.1) (n - m j)) (t' j))
    simp only [Scheme.Modules.mapPresheaf_app, unop_op] at hnat
    dsimp only [g₀]
    rw [← hnat, map_tmulRight_tensorPowSection]
    have ht'' : (F ⊗ tensorPow L (m j)).presheaf.map (U j.1).leTop.op (t' j) =
        tmulRight F (tensorPowSection (L.presheaf.map (U j.1).leTop.op (s j.1)) (m j)) j.2.1 :=
      ht' j
    rw [ht'']
    dsimp only [raiseIso, Iso.trans_hom]
    rw [Hom.comp_app, Hom.comp_app, ConcreteCategory.comp_apply, ConcreteCategory.comp_apply,
      associator_hom_app_tmulRight, whiskerLeftIso_hom, whiskerLeft_app_tmulRight,
      tensorPowAddIso_hom_app_tmulRight_tensorPowSection]
    generalize_proofs hpf
    have hsub : n - m j + m j = n := Nat.sub_add_cancel hle
    revert hpf
    rw [hsub]
    intro _
    simp
  -- Reindex the finite generating family in universe `u`.
  let J : Type u := ULift.{u} (Fin (Fintype.card J₀))
  let eJ : J ≃ J₀ := Equiv.ulift.trans (Fintype.equivFin J₀).symm
  let g (j : J) : Γ(F ⊗ tensorPow L n, ⊤) := g₀ (eJ j)
  have : TauCeti.SheafOfModules.IsInvertible (R := X.ringCatSheaf) (tensorPow L n) :=
    isInvertible_tensorPow L n
  have : (tensorPow L n).IsFinitePresentation :=
    TauCeti.SheafOfModules.IsInvertible.isFinitePresentation (M := tensorPow L n)
  have : (tensorPow L n).IsQuasicoherent :=
    SheafOfModules.instIsQuasicoherentOfIsFinitePresentation (tensorPow L n)
  refine ⟨J, inferInstance,
    (F ⊗ tensorPow L n).freeHomEquiv.symm fun j ↦ (F ⊗ tensorPow L n).sectionsEquivTop.symm (g j),
    epi_freeHomEquiv_symm_of_affine_cover U hs_aff hs_cov g fun i ↦ ?_⟩
  -- On `U i`, tensoring with `sᵢⁿ` is a bijection `Γ(F, U i) → Γ(F ⊗ L^{⊗n}, U i)`.
  have hUi : U i ≤ L.nonvanishingLocus (L.presheaf.map (U i).leTop.op (s i)) := by
    rw [nonvanishingLocus_map]
    exact le_inf le_rfl le_rfl
  have hbij := bijective_tmulRight_tensorPowSection_of_le_nonvanishingLocus F
    (L.presheaf.map (U i).leTop.op (s i)) hUi n
  set φ : Γ(F, U i) →ₗ[Γ(X, U i)] Γ(F ⊗ tensorPow L n, U i) :=
    tmulRight F (tensorPowSection (L.presheaf.map (U i).leTop.op (s i)) n)
  refine eq_top_iff.mpr fun y _ ↦ ?_
  obtain ⟨x, rfl⟩ := hbij.2 y
  have hx : x ∈ Submodule.span Γ(X, U i) (T i : Set Γ(F, U i)) := hT i ▸ Submodule.mem_top
  have hmap : φ x ∈ Submodule.map φ (Submodule.span Γ(X, U i) (T i : Set Γ(F, U i))) :=
    Submodule.mem_map_of_mem hx
  rw [Submodule.map_span] at hmap
  refine Submodule.span_mono ?_ hmap
  rintro _ ⟨t, ht, rfl⟩
  refine ⟨eJ.symm ⟨i, ⟨t, ht⟩⟩, ?_⟩
  simpa only [g, Equiv.apply_symm_apply] using hg₀_res ⟨i, ⟨t, ht⟩⟩

end AlgebraicGeometry.Scheme.Modules

namespace TauCeti.AlgebraicGeometry.LineBundleClass

open _root_.AlgebraicGeometry.Scheme.Modules

variable {X : Scheme.{u}}

/-- The line-bundle class of the `n`-th monoidal tensor power `tensorPow L.obj n` is the `n`-th
power of the class of `L` in the Picard group. -/
theorem mk_tensorPow (L : InvertibleSheaf X) (n : ℕ) :
    LineBundleClass.mk ⟨tensorPow L.obj n, isInvertible_tensorPow L.obj n⟩ =
      (LineBundleClass.mk L) ^ n := by
  induction n with
  | zero =>
    rw [pow_zero, LineBundleClass.mk_eq_one_iff]
    exact ⟨Iso.refl _⟩
  | succ n ih =>
    let Kn : InvertibleSheaf X := ⟨tensorPow L.obj n, isInvertible_tensorPow L.obj n⟩
    have hiso : (⟨tensorPow L.obj (n + 1), isInvertible_tensorPow L.obj (n + 1)⟩ :
        InvertibleSheaf X).obj ≅ (InvertibleSheaf.tensorProduct L Kn).obj :=
      (InvertibleSheaf.tensorProductObjIso L Kn).symm
    rw [LineBundleClass.mk_eq_mk_iff.mpr ⟨hiso⟩, LineBundleClass.mk_tensorProduct, ih, pow_succ']

/-- For an ample line bundle `L`, some positive tensor power `L^{⊗D}` admits finitely many global
sections whose nonvanishing loci are affine and cover `X`. -/
theorem IsAmple.exists_pos_iSup_nonvanishingLocus_tensorPow
    {L : InvertibleSheaf X} (hL : (LineBundleClass.mk L).IsAmple) :
    ∃ (D : ℕ) (_ : 0 < D) (ι : Type u) (_ : Finite ι) (t : ι → Γ(tensorPow L.obj D, ⊤)),
      (∀ i, IsAffineOpen ((tensorPow L.obj D).nonvanishingLocus (t i))) ∧
      ⨆ i, (tensorPow L.obj D).nonvanishingLocus (t i) = ⊤ := by
  classical
  have : CompactSpace X := hL.compactSpace
  -- At each point `x`, find `d x > 0` and a global section of `L^{⊗(d x)}` with affine locus `∋ x`.
  have hpt (x : X) : ∃ (d : ℕ) (_ : 0 < d) (s : Γ(tensorPow L.obj d, ⊤)),
      x ∈ (tensorPow L.obj d).nonvanishingLocus s ∧
        IsAffineOpen ((tensorPow L.obj d).nonvanishingLocus s) := by
    obtain ⟨d, hd, hfor⟩ := hL.exists_pos_forall_mk_eq x
    obtain ⟨s, hx, haff⟩ := hfor ⟨tensorPow L.obj d, isInvertible_tensorPow L.obj d⟩
      (mk_tensorPow L d)
    exact ⟨d, hd, s, hx, haff⟩
  choose d hd s hxs hs_aff using hpt
  -- Compactness extracts a finite subcover.
  obtain ⟨S, hS⟩ := isCompact_univ.elim_finite_subcover
    (fun x : X ↦ ((tensorPow L.obj (d x)).nonvanishingLocus (s x) : Set X))
    (fun x ↦ ((tensorPow L.obj (d x)).nonvanishingLocus (s x)).isOpen)
    (fun x _ ↦ Set.mem_iUnion.mpr ⟨x, hxs x⟩)
  -- Raise every section to the common power `D = ∏_{x ∈ S} d x > 0`.
  let D : ℕ := ∏ x ∈ S, d x
  have hD : 0 < D := Finset.prod_pos fun x _ ↦ hd x
  let q (x : S) : ℕ := D / d x.1
  have hdq (x : S) : d x.1 * q x = D := Nat.mul_div_cancel' (Finset.dvd_prod_of_mem d x.2)
  have hqpos (x : S) : 0 < q x := by
    by_contra h
    have h0 : q x = 0 := by omega
    have := hdq x
    rw [h0, mul_zero] at this
    omega
  let eMul (x : S) : tensorPow (tensorPow L.obj (d x.1)) (q x) ≅ tensorPow L.obj D :=
    tensorPowMulIso L.obj (d x.1) (q x) ≪≫ eqToIso (congrArg (tensorPow L.obj) (hdq x))
  let t (x : S) : Γ(tensorPow L.obj D, ⊤) :=
    (eMul x).hom.app ⊤ (tensorPowSection (s x.1) (q x))
  have ht_locus (x : S) : (tensorPow L.obj D).nonvanishingLocus (t x) =
      (tensorPow L.obj (d x.1)).nonvanishingLocus (s x.1) := by
    rw [nonvanishingLocus_hom_app (eMul x) (tensorPowSection (s x.1) (q x)),
      nonvanishingLocus_tensorPowSection (s x.1) (hqpos x)]
  refine ⟨D, hD, S, inferInstance, t, fun x ↦ ht_locus x ▸ hs_aff x.1, ?_⟩
  refine top_unique fun y _ ↦ ?_
  obtain ⟨x, hxS, hyx⟩ := Set.mem_iUnion₂.mp (hS (Set.mem_univ y))
  exact Opens.mem_iSup.mpr ⟨⟨x, hxS⟩, (ht_locus ⟨x, hxS⟩).symm ▸ hyx⟩

/-- **Serre's Theorem A (Hartshorne, Theorem II.5.17; Stacks, Tag 01Q3).** Let `X` be a
quasi-separated scheme, `L` an ample line bundle on `X`, and `F` a quasi-coherent `𝒪_X`-module
of finite type. Then there exists `n₀ : ℕ` such that for every `n ≥ n₀`, `F ⊗ L^{⊗n}` is
generated by finitely many global sections. No Noetherian hypothesis is needed. -/
theorem IsAmple.exists_epi_free_tensor_tensorPow [QuasiSeparatedSpace X]
    {L : InvertibleSheaf X} (hL : (LineBundleClass.mk L).IsAmple)
    (F : X.Modules) [F.IsQuasicoherent] [F.IsFiniteType] :
    ∃ n₀ : ℕ, ∀ n ≥ n₀,
      ∃ (J : Type u) (_ : Finite J) (π : SheafOfModules.free J ⟶ F ⊗ tensorPow L.obj n),
        Epi π := by
  classical
  have : CompactSpace X := hL.compactSpace
  obtain ⟨D, hD, ι, _, t, ht_aff, ht_cov⟩ := hL.exists_pos_iSup_nonvanishingLocus_tensorPow
  -- Apply the degree-one theorem to `L^{⊗D}` and each remainder twist `F ⊗ L^{⊗r}`, `r < D`.
  have hrem (r : Fin D) : ∃ k₀ : ℕ, ∀ k ≥ k₀,
      ∃ (J : Type u) (_ : Finite J)
        (π : SheafOfModules.free J ⟶ (F ⊗ tensorPow L.obj r.1) ⊗ tensorPow (tensorPow L.obj D) k),
        Epi π := by
    have : TauCeti.SheafOfModules.IsInvertible (R := X.ringCatSheaf) (tensorPow L.obj r.1) :=
      isInvertible_tensorPow L.obj r.1
    have : (tensorPow L.obj r.1).IsFinitePresentation :=
      TauCeti.SheafOfModules.IsInvertible.isFinitePresentation (M := tensorPow L.obj r.1)
    have : (tensorPow L.obj r.1).IsQuasicoherent :=
      SheafOfModules.instIsQuasicoherentOfIsFinitePresentation (tensorPow L.obj r.1)
    have : (tensorPow L.obj r.1).IsFiniteType :=
      SheafOfModules.instIsFiniteTypeOfIsFinitePresentation (tensorPow L.obj r.1)
    exact exists_epi_free_tensor_tensorPow_of_iSup_nonvanishingLocus t ht_aff ht_cov
      (F ⊗ tensorPow L.obj r.1)
  choose k₀ hk₀ using hrem
  let K : ℕ := Finset.univ.sup k₀
  refine ⟨D * K, fun n hn ↦ ?_⟩
  let r : Fin D := ⟨n % D, Nat.mod_lt n hD⟩
  let k : ℕ := n / D
  have hkK : K ≤ k := (Nat.le_div_iff_mul_le hD).mpr (by rw [mul_comm]; exact hn)
  have hkr : k₀ r ≤ k := (Finset.le_sup (f := k₀) (Finset.mem_univ r)).trans hkK
  obtain ⟨J, hJ, π, hπ⟩ := hk₀ r k hkr
  -- Identify `(F ⊗ L^{⊗r}) ⊗ (L^{⊗D})^{⊗k}` with `F ⊗ L^{⊗n}`.
  have hnr : D * k + r.1 = n := Nat.div_add_mod n D
  let e : (F ⊗ tensorPow L.obj r.1) ⊗ tensorPow (tensorPow L.obj D) k ≅
      F ⊗ tensorPow L.obj n :=
    α_ F (tensorPow L.obj r.1) (tensorPow (tensorPow L.obj D) k) ≪≫
      whiskerLeftIso F (whiskerLeftIso (tensorPow L.obj r.1) (tensorPowMulIso L.obj D k) ≪≫
        tensorPowAddIso L.obj r.1 (D * k) ≪≫ eqToIso (congrArg (tensorPow L.obj) hnr))
  exact ⟨J, hJ, π ≫ e.hom, @epi_comp _ _ _ _ _ π hπ e.hom (IsIso.epi_of_iso e.hom)⟩

/-- **Presentation by negative ample twists.** Under the hypotheses of Serre's Theorem A, for
every sufficiently large `n : ℕ`, `F` is a quotient of a finite direct sum of copies of
`(L^{⊗n})∨`. -/
theorem IsAmple.exists_epi_biproduct_dual_tensorPow [QuasiSeparatedSpace X]
    {L : InvertibleSheaf X} (hL : (LineBundleClass.mk L).IsAmple)
    (F : X.Modules) [F.IsQuasicoherent] [F.IsFiniteType] :
    ∃ n₀ : ℕ, ∀ n ≥ n₀,
      ∃ (r : ℕ)
        (π : (⨁ fun _ : Fin r ↦ (tensorPow L.obj n).dual) ⟶ F), Epi π := by
  obtain ⟨n₀, hn₀⟩ := hL.exists_epi_free_tensor_tensorPow F
  refine ⟨n₀, fun n hn ↦ ?_⟩
  obtain ⟨J, hJ, π, hπ⟩ := hn₀ n hn
  cases nonempty_fintype J
  let r : ℕ := Fintype.card J
  let eJ : Fin r ≃ J := (Fintype.equivFin J).symm
  let Ln : InvertibleSheaf X := ⟨tensorPow L.obj n, isInvertible_tensorPow L.obj n⟩
  let M : X.Modules := Ln.obj.dual
  have hM : TauCeti.AlgebraicGeometry.SheafOfModules.isInvertible X M := by
    dsimp only [M]
    rw [← InvertibleSheaf.dual_obj Ln]
    exact (InvertibleSheaf.dual Ln).property
  have : (MonoidalCategory.tensorRight M).IsEquivalence :=
    @isEquivalence_tensorRight_of_isInvertible X M hM
  have hPres : (MonoidalCategory.tensorRight M).PreservesEpimorphisms :=
    Functor.preservesEpimorphisms_of_adjunction
      (MonoidalCategory.tensorRight M).asEquivalence.toAdjunction
  -- Tensor `π : free J ⟶ F ⊗ L^{⊗n}` on the right with `(L^{⊗n})∨`.
  have hπM : Epi ((MonoidalCategory.tensorRight M).map π) := @hPres.preserves _ _ π hπ
  let eIdx : (⨁ fun _ : Fin r ↦ M) ≅ (⨁ fun _ : J ↦ M) :=
    { hom := biproduct.desc fun i ↦ biproduct.ι (fun _ : J ↦ M) (eJ i)
      inv := biproduct.desc fun j ↦ biproduct.ι (fun _ : Fin r ↦ M) (eJ.symm j)
      hom_inv_id := by
        apply biproduct.hom_ext'
        intro i
        simp
      inv_hom_id := by
        apply biproduct.hom_ext'
        intro j
        simp }
  let eFree : (⨁ fun _ : Fin r ↦ M) ≅ SheafOfModules.free J ⊗ M :=
    eIdx ≪≫
      biproduct.mapIso (fun _ : J ↦ (λ_ M).symm) ≪≫
      ((MonoidalCategory.tensorRight M).mapBiproduct
        (fun _ : J ↦ (𝟙_ X.Modules : X.Modules))).symm ≪≫
      (MonoidalCategory.tensorRight M).mapIso
        (TauCeti.SheafOfModules.biproductIsoFree (R := X.sheaf) J)
  let eEval : Ln.obj ⊗ M ≅ 𝟙_ X.Modules := InvertibleSheaf.evaluationDualIsoSheaf Ln
  let eTarget : (F ⊗ Ln.obj) ⊗ M ≅ F :=
    α_ F Ln.obj M ≪≫ whiskerLeftIso F eEval ≪≫ ρ_ F
  refine ⟨r, eFree.hom ≫ (MonoidalCategory.tensorRight M).map π ≫ eTarget.hom, ?_⟩
  exact @epi_comp _ _ _ _ _ eFree.hom (IsIso.epi_of_iso eFree.hom) _
    (@epi_comp _ _ _ _ _ _ hπM eTarget.hom (IsIso.epi_of_iso eTarget.hom))

end TauCeti.AlgebraicGeometry.LineBundleClass
