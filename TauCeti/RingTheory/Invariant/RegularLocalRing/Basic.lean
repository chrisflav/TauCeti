/-!
# Invariant subrings of complete regular local rings

This file proves Katz–Mazur's regularity theorem (Theorem 7.5.2) for invariant subrings of complete
Noetherian regular local rings with perfect residue field.

Let `A` be a complete Noetherian regular local ring with perfect residue field, and let a finite
group `H` act on `A` by ring automorphisms inducing the identity on `ResidueField A`. Suppose
`{y} ∪ range x` is a regular system of parameters of `A` such that `H` fixes every `x i`. Then:

1. **Power basis** (`TauCeti.FixedPoints.powerBasis`): when `H` acts faithfully on `A`, `A` is a
   free module over `A^H` with power basis `1, y, …, y ^ (|H| - 1)`.
2. **Regularity and completeness** (`TauCeti.FixedPoints.isRegularLocalRing_subring`,
   `TauCeti.FixedPoints.isAdicComplete_subring`): even without assuming faithfulness, `A^H` is a
   complete regular local ring of the same Krull dimension as `A`.
3. **Regular parameters** (`TauCeti.FixedPoints.maximalIdeal_subring_eq_span`): when `H` acts
   faithfully, the maximal ideal of `A^H` is generated by the `x i` together with the orbit
   product `∏_{h ∈ H} h • y`.

## Main definitions

* `TauCeti.FixedPoints.powerBasis`: the power basis `1, y, …, y ^ (|H| - 1)` of `A` over `A^H`.

## Main results

* `TauCeti.FixedPoints.ringKrullDim_subring`: `dim A^H = dim A` for any finite group action on a
  commutative ring.
* `TauCeti.FixedPoints.isRegularLocalRing_subring`: `A^H` is a regular local ring (without
  requiring faithfulness).
* `TauCeti.FixedPoints.isAdicComplete_subring`: `A^H` is `𝔪_{A^H}`-adically complete.
* `TauCeti.FixedPoints.maximalIdeal_subring_eq_span`: regular system of parameters of `A^H` when
  `H` acts faithfully.
* `TauCeti.FixedPoints.spanFinrank_maximalIdeal_subring`: `spanFinrank 𝔪_{A^H} = |ι| + 1`.
* `TauCeti.FixedPoints.exists_powerBasis` and
  `TauCeti.FixedPoints.exists_maximalIdeal_subring_eq_span`: non-faithful versions obtained by
  quotienting `H` by the kernel of its action.

## References

* N. M. Katz and B. Mazur, *Arithmetic Moduli of Elliptic Curves*, Theorem 7.5.2.
-/

public section

open IsLocalRing Ideal

namespace TauCeti.FixedPoints

universe u

/-- **Krull dimension of an invariant subring.** For any commutative ring `A` and finite group `H`
acting on `A` by ring automorphisms, `FixedPoints.subring A H` has the same Krull dimension as
`A` because `A` is integral over `FixedPoints.subring A H`. -/
theorem ringKrullDim_subring {A : Type u} [CommRing A] {H : Type*} [Group H] [Finite H]
    [MulSemiringAction H A] :
    ringKrullDim (FixedPoints.subring A H) = ringKrullDim A := by
  have : Algebra.IsIntegral (FixedPoints.subring A H) A :=
    Algebra.IsInvariant.isIntegral (FixedPoints.subring A H) A H
  have : FaithfulSMul (FixedPoints.subring A H) A :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr Subtype.val_injective
  exact (TauCeti.ringKrullDim_eq_of_isIntegral_of_faithfulSMul
    (R := FixedPoints.subring A H) (S := A)).symm

section Helpers

variable {A : Type u} [CommRing A] {ι : Type*}

/-- Membership in `Ideal.span (insert z (Set.range x))` is tested modulo `Ideal.span (Set.range x)`.
-/
private lemma mem_span_insert_range_iff {x : ι → A} {z a : A} :
    a ∈ span (insert z (Set.range x)) ↔
      Ideal.Quotient.mk (span (Set.range x)) a ∈
        span {Ideal.Quotient.mk (span (Set.range x)) z} := by
  have hmap : (span {z}).map (Ideal.Quotient.mk (span (Set.range x))) =
      span {Ideal.Quotient.mk (span (Set.range x)) z} := by
    rw [Ideal.map_span, Set.image_singleton]
  rw [← hmap, ← Ideal.mem_comap,
    Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
    ← RingHom.ker_eq_comap_bot, Ideal.mk_ker, ← Ideal.span_union, Set.singleton_union]

variable [IsRegularLocalRing A] {H : Type*} [Group H] [Finite H] [MulSemiringAction H A]

/-- The ideal `I₀ = (orbitProd H y, x i)` lies in `maximalIdeal A^H`. -/
private lemma I₀_le_maximalIdeal {x : ι → A} {y : A}
    (hspan : span (insert y (Set.range x)) = maximalIdeal A)
    (hfix : ∀ (h : H) (i : ι), h • x i = x i) :
    let B := FixedPoints.subring A H
    let I₀ : Ideal B :=
      span (insert (orbitProd H y) (Set.range fun i ↦ (⟨x i, fun h ↦ hfix h i⟩ : B)))
    I₀ ≤ maximalIdeal B := by
  intro B _
  refine span_le.mpr ?_
  rintro b (rfl | ⟨i, rfl⟩)
  · rw [SetLike.mem_coe, mem_maximalIdeal_subring_iff]
    have hy : y ∈ maximalIdeal A := hspan ▸ subset_span (Set.mem_insert y _)
    classical
    have := Fintype.ofFinite H
    rw [coe_orbitProd]
    have h1 : (1 : H) ∈ (Finset.univ : Finset H) := Finset.mem_univ 1
    rw [← Finset.mul_prod_erase _ _ h1, one_smul]
    exact Ideal.mul_mem_right _ _ hy
  · rw [SetLike.mem_coe, mem_maximalIdeal_subring_iff]
    exact hspan ▸ subset_span (Set.mem_insert_of_mem y ⟨i, rfl⟩)

omit [Finite H] in
/-- An `𝔪`-adic limit of `H`-invariant elements is `H`-invariant when `H` acts trivially on
`ResidueField A`. -/
private lemma isInvariant_of_smodEq [IsHausdorff (maximalIdeal A) A]
    (hres : ∀ (h : H) (a : A), residue A (h • a) = residue A a)
    {seq : ℕ → FixedPoints.subring A H} {L : A}
    (hL : ∀ n, (seq n : A) ≡ L [SMOD (maximalIdeal A ^ n • ⊤ : Submodule A A)]) :
    L ∈ FixedPoints.subring A H := by
  intro h
  rw [IsHausdorff.eq_iff_smodEq (I := maximalIdeal A)]
  intro n
  have hdiff : (seq n : A) - L ∈ maximalIdeal A ^ n := by
    simpa [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top] using hL n
  have hsmul := smul_mem_maximalIdeal_pow (hres h) hdiff
  rw [smul_sub, (seq n).2 h] at hsmul
  have h1 : h • L - L ∈ maximalIdeal A ^ n := by
    have : h • L - L = ((seq n : A) - L) - ((seq n : A) - h • L) := by ring
    rw [this]
    exact sub_mem hdiff hsmul
  simpa [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top] using h1

variable [Fintype ι]

/-- In the DVR `A ⧸ span (range x)`, the image of the orbit product `∏_{h ∈ H} h • y` generates the
same principal ideal as `q y ^ |H|`. -/
private lemma span_mk_orbitProd_eq_pow {x : ι → A} {y : A}
    (hspan : span (insert y (Set.range x)) = maximalIdeal A)
    (hrank : (maximalIdeal A).spanFinrank = Fintype.card ι + 1)
    (hfix : ∀ (h : H) (i : ι), h • x i = x i) :
    let q := Ideal.Quotient.mk (span (Set.range x))
    span {q (orbitProd H y : A)} = span {q y ^ Nat.card H} := by
  have := Fintype.ofFinite H
  set J := span (Set.range x)
  set q := Ideal.Quotient.mk J
  have hreg : IsRegularLocalRing (A ⧸ J) :=
    TauCeti.IsRegularLocalRing.quotient_span_range hspan hrank
  have hdvr : IsDiscreteValuationRing (A ⧸ J) :=
    TauCeti.IsRegularLocalRing.isDiscreteValuationRing_quotient_span_range hspan hrank
  have hirr : Irreducible (q y) :=
    TauCeti.IsRegularLocalRing.irreducible_mk_quotient_span_range hspan hrank
  have hJ : ∀ h : H, J.map (MulSemiringAction.toRingEquiv H A h : A →+* A) = J := fun h ↦ by
    rw [Ideal.map_span]
    congr 1
    ext r
    simp only [Set.mem_image, Set.mem_range]
    exact ⟨by rintro ⟨_, ⟨i, rfl⟩, rfl⟩; exact ⟨i, (hfix h i).symm⟩,
      by rintro ⟨i, rfl⟩; exact ⟨x i, ⟨i, rfl⟩, hfix h i⟩⟩
  let φ := (MulSemiringAction.toRingEquiv H A).quotientRingAut J hJ
  have hassoc : ∀ h : H, Associated (q (h • y)) (q y) := fun h ↦ by
    have hirr_h : Irreducible (q (h • y)) := by
      have hφ : φ h (q y) = q (h • y) :=
        MonoidHom.quotientRingAut_apply_mk (MulSemiringAction.toRingEquiv H A) J hJ h y
      rw [← hφ]
      exact (MulEquiv.irreducible_iff (φ h).toMulEquiv).mpr hirr
    exact IsDiscreteValuationRing.associated_of_irreducible _ hirr_h hirr
  have hprod : Associated (∏ h : H, q (h • y)) (∏ _ : H, q y) :=
    Associated.prod Finset.univ (fun h ↦ q (h • y)) (fun _ ↦ q y) fun h _ ↦ hassoc h
  rw [← map_prod, ← coe_orbitProd, Finset.prod_const, Finset.card_univ,
    ← Nat.card_eq_fintype_card] at hprod
  exact Ideal.span_singleton_eq_span_singleton.mpr hprod

/-- The extension of `I₀ = (orbitProd H y, x i)` to `A` equals
`Ideal.span (insert (y ^ |H|) (Set.range x))`. -/
private lemma map_I₀_eq_span_pow {x : ι → A} {y : A}
    (hspan : span (insert y (Set.range x)) = maximalIdeal A)
    (hrank : (maximalIdeal A).spanFinrank = Fintype.card ι + 1)
    (hfix : ∀ (h : H) (i : ι), h • x i = x i) :
    let B := FixedPoints.subring A H
    let I₀ : Ideal B := span (insert (orbitProd H y) (Set.range fun i ↦ ⟨x i, fun h ↦ hfix h i⟩))
    I₀.map B.subtype = span (insert (y ^ Nat.card H) (Set.range x)) := by
  intro B I₀
  have hmap : I₀.map B.subtype = span (insert (orbitProd H y : A) (Set.range x)) := by
    rw [Ideal.map_span]
    congr 1
    ext r
    simp only [Set.mem_image, Set.mem_insert_iff, Set.mem_range, Subring.coe_subtype]
    constructor
    · rintro ⟨_, rfl | ⟨i, rfl⟩, rfl⟩
      · exact Or.inl rfl
      · exact Or.inr ⟨i, rfl⟩
    · rintro (rfl | ⟨i, rfl⟩)
      · exact ⟨orbitProd H y, Or.inl rfl, rfl⟩
      · exact ⟨⟨x i, fun h ↦ hfix h i⟩, Or.inr ⟨i, rfl⟩, rfl⟩
  rw [hmap]
  ext a
  rw [mem_span_insert_range_iff, mem_span_insert_range_iff,
    span_mk_orbitProd_eq_pow hspan hrank hfix, map_pow]

/-- The `|H|`-th power of `maximalIdeal A` is contained in `I₀ · A`. -/
private lemma maximalIdeal_pow_le_map_I₀ {x : ι → A} {y : A}
    (hspan : span (insert y (Set.range x)) = maximalIdeal A)
    (hrank : (maximalIdeal A).spanFinrank = Fintype.card ι + 1)
    (hfix : ∀ (h : H) (i : ι), h • x i = x i) :
    let B := FixedPoints.subring A H
    let I₀ : Ideal B := span (insert (orbitProd H y) (Set.range fun i ↦ ⟨x i, fun h ↦ hfix h i⟩))
    maximalIdeal A ^ Nat.card H ≤ I₀.map B.subtype := by
  intro B I₀
  have hreg : IsRegularLocalRing (A ⧸ span (Set.range x)) :=
    TauCeti.IsRegularLocalRing.quotient_span_range hspan hrank
  rw [map_I₀_eq_span_pow hspan hrank hfix]
  intro a ha
  rw [mem_span_insert_range_iff, map_pow]
  set q := Ideal.Quotient.mk (span (Set.range x))
  have hq : q a ∈ maximalIdeal (A ⧸ span (Set.range x)) ^ Nat.card H := by
    rw [← map_maximalIdeal_of_surjective q Ideal.Quotient.mk_surjective, ← Ideal.map_pow]
    exact Ideal.mem_map_of_mem q ha
  rw [TauCeti.IsLocalRing.maximalIdeal_quotient_span_range hspan,
    Ideal.span_singleton_pow] at hq
  exact hq

/-- Every element `d` of `A ⧸ span (range x)` admits a polynomial expansion in `q y` up to degree
`< m` with coefficients in `A^H`, and if `d` is a unit and `m ≥ 1` then the constant coefficient
does not lie in `maximalIdeal A^H`. -/
private lemma exists_expansion_quotient [IsAdicComplete (maximalIdeal A) A]
    [PerfectField (ResidueField A)]
    {x : ι → A} {y : A}
    (hres : ∀ (h : H) (a : A), residue A (h • a) = residue A a)
    (hspan : span (insert y (Set.range x)) = maximalIdeal A)
    (hrank : (maximalIdeal A).spanFinrank = Fintype.card ι + 1)
    (m : ℕ) (d : A ⧸ span (Set.range x)) :
    let B := FixedPoints.subring A H
    let q := Ideal.Quotient.mk (span (Set.range x))
    ∃ (b : Fin m → B) (r : A ⧸ span (Set.range x)),
      d = (∑ j : Fin m, q (b j : A) * q y ^ (j : ℕ)) + q y ^ m * r ∧
      ∀ (hm : 0 < m), IsUnit d → b ⟨0, hm⟩ ∉ maximalIdeal B := by
  intro B q
  have hreg : IsRegularLocalRing (A ⧸ span (Set.range x)) :=
    TauCeti.IsRegularLocalRing.quotient_span_range hspan hrank
  induction m generalizing d with
  | zero =>
    exact ⟨Fin.elim0, d, by simp, fun hm _ ↦ absurd hm (lt_irrefl 0)⟩
  | succ m ih =>
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective d
    obtain ⟨b₀, hb₀⟩ := exists_residue_eq hres a
    have hsub : a - (b₀ : A) ∈ maximalIdeal A := by
      rw [← residue_eq_zero_iff, map_sub, hb₀, sub_self]
    have hqsub : q a - q (b₀ : A) ∈ span {q y} := by
      rw [← map_sub, ← TauCeti.IsLocalRing.maximalIdeal_quotient_span_range hspan,
        ← map_maximalIdeal_of_surjective q Ideal.Quotient.mk_surjective]
      exact Ideal.mem_map_of_mem q hsub
    obtain ⟨d', hd'⟩ := Ideal.mem_span_singleton.mp hqsub
    obtain ⟨b', r, hrec, _⟩ := ih d'
    refine ⟨Fin.cons b₀ b', r, ?_, ?_⟩
    · rw [Fin.sum_univ_succ]
      simp only [Fin.cons_zero, Fin.val_zero, pow_zero, mul_one, Fin.cons_succ, Fin.val_succ]
      have hmul : ∑ j : Fin m, q (b' j : A) * q y ^ ((j : ℕ) + 1) =
          q y * ∑ j : Fin m, q (b' j : A) * q y ^ (j : ℕ) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun j _ ↦ ?_
        rw [pow_succ']
        ring
      rw [hmul, pow_succ', mul_assoc, add_assoc, ← mul_add, ← hrec, ← hd']
      ring
    · intro _ hunit hb₀_mem
      have ha_mem : a ∈ maximalIdeal A := by
        rw [← residue_eq_zero_iff, ← hb₀, residue_eq_zero_iff]
        exact mem_maximalIdeal_subring_iff.mp hb₀_mem
      have hqa_mem : q a ∈ maximalIdeal (A ⧸ span (Set.range x)) := by
        rw [← map_maximalIdeal_of_surjective q Ideal.Quotient.mk_surjective]
        exact Ideal.mem_map_of_mem q ha_mem
      exact (notMem_maximalIdeal.mpr hunit) hqa_mem

/-- Every element of `A` expands modulo `I₀ · A` as an `A^H`-linear combination of
`1, y, …, y ^ (|H| - 1)`. -/
private lemma exists_expansion_mod_I₀ [IsAdicComplete (maximalIdeal A) A]
    [PerfectField (ResidueField A)]
    {x : ι → A} {y : A}
    (hres : ∀ (h : H) (a : A), residue A (h • a) = residue A a)
    (hspan : span (insert y (Set.range x)) = maximalIdeal A)
    (hrank : (maximalIdeal A).spanFinrank = Fintype.card ι + 1)
    (hfix : ∀ (h : H) (i : ι), h • x i = x i) (a : A) :
    let B := FixedPoints.subring A H
    let I₀ : Ideal B := span (insert (orbitProd H y) (Set.range fun i ↦ ⟨x i, fun h ↦ hfix h i⟩))
    ∃ (b : Fin (Nat.card H) → B) (r : A),
      r ∈ I₀.map B.subtype ∧
      a = (∑ j : Fin (Nat.card H), (b j : A) * y ^ (j : ℕ)) + r := by
  intro B I₀
  set q := Ideal.Quotient.mk (span (Set.range x))
  obtain ⟨b, r', hr', -⟩ := exists_expansion_quotient hres hspan hrank (Nat.card H) (q a)
  refine ⟨b, a - ∑ j : Fin (Nat.card H), (b j : A) * y ^ (j : ℕ), ?_, by ring⟩
  rw [map_I₀_eq_span_pow hspan hrank hfix, mem_span_insert_range_iff, map_pow,
    Ideal.mem_span_singleton]
  refine ⟨r', ?_⟩
  rw [map_sub, map_sum]
  simp only [map_mul, map_pow]
  rw [hr', add_sub_cancel_left]

/-- One inductive step of successive approximation modulo powers of `I₀ · A`. -/
private lemma approx_step [IsAdicComplete (maximalIdeal A) A] [PerfectField (ResidueField A)]
    {x : ι → A} {y : A}
    (hres : ∀ (h : H) (a : A), residue A (h • a) = residue A a)
    (hspan : span (insert y (Set.range x)) = maximalIdeal A)
    (hrank : (maximalIdeal A).spanFinrank = Fintype.card ι + 1)
    (hfix : ∀ (h : H) (i : ι), h • x i = x i) (a : A) (k : ℕ)
    (f : Fin (Nat.card H) → FixedPoints.subring A H)
    (hf : a - ∑ j : Fin (Nat.card H), (f j : A) * y ^ (j : ℕ) ∈
      ((span (insert (orbitProd H y)
        (Set.range fun i ↦ (⟨x i, fun h ↦ hfix h i⟩ : FixedPoints.subring A H)))) ^ k).map
        (FixedPoints.subring A H).subtype) :
    let B := FixedPoints.subring A H
    let I₀ : Ideal B := span (insert (orbitProd H y) (Set.range fun i ↦ ⟨x i, fun h ↦ hfix h i⟩))
    ∃ g : Fin (Nat.card H) → B,
      (∀ j, g j - f j ∈ I₀ ^ k) ∧
      a - ∑ j : Fin (Nat.card H), (g j : A) * y ^ (j : ℕ) ∈ (I₀ ^ (k + 1)).map B.subtype := by
  intro B I₀
  have hfg : I₀.FG := Submodule.fg_span ((Set.finite_range _).insert _)
  obtain ⟨s, hs⟩ := Ideal.FG.pow hfg (n := k)
  have hmap_k : (I₀ ^ k).map B.subtype = span (Set.range fun g : s ↦ (g.1 : A)) := by
    rw [← hs, Ideal.map_span]
    congr 1
    ext r
    simp
  rw [hmap_k, Submodule.mem_span_range_iff_exists_fun] at hf
  obtain ⟨t, ht⟩ := hf
  choose d e he hde using fun g : s ↦ exists_expansion_mod_I₀ hres hspan hrank hfix (t g)
  let Δ : Fin (Nat.card H) → B := fun j ↦ ∑ g : s, g.1 * d g j
  refine ⟨fun j ↦ f j + Δ j, fun j ↦ ?_, ?_⟩
  · simp only [add_sub_cancel_left, Δ]
    exact Submodule.sum_mem _ fun g _ ↦ Ideal.mul_mem_right _ _ (hs ▸ subset_span g.2)
  · have hΔ : ∀ j, (Δ j : A) = ∑ g : s, (g.1 : A) * (d g j : A) := fun j ↦ by
      rw [← Subring.coe_subtype, map_sum]
      simp
    have hsum_Δ : ∑ j : Fin (Nat.card H), (Δ j : A) * y ^ (j : ℕ) =
        ∑ g : s, (g.1 : A) * ∑ j : Fin (Nat.card H), (d g j : A) * y ^ (j : ℕ) := by
      simp only [hΔ, Finset.sum_mul]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun g _ ↦ ?_
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl fun j _ ↦ by ring
    have hrem : a - ∑ j : Fin (Nat.card H), ((f j + Δ j : B) : A) * y ^ (j : ℕ) =
        ∑ g : s, (g.1 : A) * e g := by
      simp_rw [Subring.coe_add, add_mul, Finset.sum_add_distrib, ← sub_sub, hsum_Δ]
      rw [← ht, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun g _ ↦ ?_
      rw [smul_eq_mul, mul_comm, hde g]
      ring
    rw [hrem, pow_succ, Ideal.map_mul]
    exact Submodule.sum_mem _ fun g _ ↦
      Ideal.mul_mem_mul (Ideal.mem_map_of_mem B.subtype (hs ▸ subset_span g.2)) (he g)

/-- `1, y, …, y ^ (|H| - 1)` span `A` as an `A^H`-module. -/
private lemma exists_sum_pow_eq [IsAdicComplete (maximalIdeal A) A]
    [PerfectField (ResidueField A)]
    {x : ι → A} {y : A}
    (hres : ∀ (h : H) (a : A), residue A (h • a) = residue A a)
    (hspan : span (insert y (Set.range x)) = maximalIdeal A)
    (hrank : (maximalIdeal A).spanFinrank = Fintype.card ι + 1)
    (hfix : ∀ (h : H) (i : ι), h • x i = x i) (a : A) :
    ∃ c : Fin (Nat.card H) → FixedPoints.subring A H,
      a = ∑ j : Fin (Nat.card H), (c j : A) * y ^ (j : ℕ) := by
  set B := FixedPoints.subring A H
  set I₀ : Ideal B := span (insert (orbitProd H y) (Set.range fun i ↦ ⟨x i, fun h ↦ hfix h i⟩))
  have hI₀_le : ∀ k : ℕ, (I₀ ^ k).map B.subtype ≤ maximalIdeal A ^ k := fun k ↦ by
    rw [Ideal.map_pow]
    refine Ideal.pow_right_mono ?_ k
    rw [Ideal.map_le_iff_le_comap, ← maximalIdeal_subring]
    exact I₀_le_maximalIdeal hspan hfix
  let seq : (k : ℕ) → { f : Fin (Nat.card H) → B //
      a - ∑ j : Fin (Nat.card H), (f j : A) * y ^ (j : ℕ) ∈ (I₀ ^ k).map B.subtype } :=
    Nat.rec ⟨0, by simp [Ideal.map_top]⟩ fun k prev ↦
      ⟨(approx_step hres hspan hrank hfix a k prev.1 prev.2).choose,
        (approx_step hres hspan hrank hfix a k prev.1 prev.2).choose_spec.2⟩
  have hstep : ∀ k j, (seq (k + 1)).1 j - (seq k).1 j ∈ I₀ ^ k := fun k j ↦
    (approx_step hres hspan hrank hfix a k (seq k).1 (seq k).2).choose_spec.1 j
  have hcauchy : ∀ (j : Fin (Nat.card H)) {m n : ℕ}, m ≤ n →
      ((seq m).1 j : A) ≡ ((seq n).1 j : A) [SMOD (maximalIdeal A ^ m • ⊤ : Submodule A A)] := by
    intro j m n hmn
    induction hmn with
    | refl => rfl
    | @step n hmn ih =>
      refine ih.trans ?_
      rw [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top]
      have hmemA := hI₀_le n (Ideal.mem_map_of_mem B.subtype (hstep n j))
      exact Ideal.pow_le_pow_right hmn (by simpa [neg_sub] using neg_mem hmemA)
  choose L hL using fun j ↦ IsPrecomplete.prec (inferInstance : IsPrecomplete (maximalIdeal A) A)
    (hcauchy j)
  refine ⟨fun j ↦ ⟨L j, isInvariant_of_smodEq hres (hL j)⟩, ?_⟩
  rw [IsHausdorff.eq_iff_smodEq (I := maximalIdeal A)]
  intro n
  rw [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top]
  have hrem := hI₀_le n (seq n).2
  have hsum : ∑ j : Fin (Nat.card H), (((seq n).1 j : A) - L j) * y ^ (j : ℕ) ∈
      maximalIdeal A ^ n :=
    Submodule.sum_mem _ fun j _ ↦ Ideal.mul_mem_right _ _
      (by simpa [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top] using hL j n)
  have heq : a - ∑ j : Fin (Nat.card H), L j * y ^ (j : ℕ) =
      (a - ∑ j : Fin (Nat.card H), ((seq n).1 j : A) * y ^ (j : ℕ)) +
        ∑ j : Fin (Nat.card H), (((seq n).1 j : A) - L j) * y ^ (j : ℕ) := by
    simp only [sub_mul, Finset.sum_sub_distrib]
    ring
  rw [heq]
  exact add_mem hrem hsum

/-- The powers `1, y, …, y ^ (|H| - 1)` span `FractionRing A` over `FractionRing A^H`. -/
private lemma span_fractionRing_pow [IsAdicComplete (maximalIdeal A) A]
    [PerfectField (ResidueField A)]
    {x : ι → A} {y : A}
    (hres : ∀ (h : H) (a : A), residue A (h • a) = residue A a)
    (hspan : span (insert y (Set.range x)) = maximalIdeal A)
    (hrank : (maximalIdeal A).spanFinrank = Fintype.card ι + 1)
    (hfix : ∀ (h : H) (i : ι), h • x i = x i) :
    let B := FixedPoints.subring A H
    let K := FractionRing B
    let L := FractionRing A
    let _ : Algebra K L := FractionRing.liftAlgebra B L
    ⊤ ≤ Submodule.span K (Set.range fun j : Fin (Nat.card H) ↦ algebraMap A L (y ^ (j : ℕ))) := by
  classical
  have := Fintype.ofFinite H
  intro B K L _ z _
  have _ : IsScalarTower B K L := FractionRing.isScalarTower_liftAlgebra B L
  obtain ⟨a, s, hs, rfl⟩ := IsFractionRing.div_surjective A z
  have hs_ne : s ≠ 0 := nonZeroDivisors.ne_zero hs
  let t : A := ∏ h ∈ Finset.univ.erase (1 : H), h • s
  have hst : s * t = (orbitProd H s : A) := by
    rw [coe_orbitProd, ← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ (1 : H)), one_smul]
  have hNs_ne : (orbitProd H s : B) ≠ 0 := fun h0 ↦ by
    have h0A : (orbitProd H s : A) = 0 := congrArg Subtype.val h0
    rw [coe_orbitProd, Finset.prod_eq_zero_iff] at h0A
    obtain ⟨h, -, hh⟩ := h0A
    exact hs_ne (by simpa [inv_smul_smul] using congrArg (h⁻¹ • ·) hh)
  obtain ⟨c, hc⟩ := exists_sum_pow_eq hres hspan hrank hfix (a * t)
  have htL : algebraMap A L (s * t) = algebraMap K L (algebraMap B K (orbitProd H s)) := by
    rw [hst, ← IsScalarTower.algebraMap_apply B K L, IsScalarTower.algebraMap_apply B A L]
    rfl
  have hNsL : algebraMap K L (algebraMap B K (orbitProd H s)) ≠ 0 := by
    intro h0
    have h1 : algebraMap B K (orbitProd H s) = 0 :=
      RingHom.injective (algebraMap K L) (by simpa using h0)
    exact hNs_ne (IsFractionRing.injective B K (by simpa using h1))
  have hstL : algebraMap A L t ≠ 0 := fun ht0 ↦ hNsL (by rw [← htL, map_mul, ht0, mul_zero])
  have hmul : algebraMap A L a / algebraMap A L s =
      algebraMap A L (a * t) / algebraMap A L (s * t) := by
    rw [map_mul, map_mul, mul_div_mul_right _ _ hstL]
  have hdiv : algebraMap A L a / algebraMap A L s =
      ∑ j : Fin (Nat.card H),
        (algebraMap B K (c j) / algebraMap B K (orbitProd H s)) •
          algebraMap A L (y ^ (j : ℕ)) := by
    rw [hmul, hc, htL, map_sum, Finset.sum_div]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [Algebra.smul_def, map_div₀, map_mul, ← IsScalarTower.algebraMap_apply B K L,
      IsScalarTower.algebraMap_apply B A L, ← IsScalarTower.algebraMap_apply B K L,
      IsScalarTower.algebraMap_apply B A L, div_mul_eq_mul_div]
    rfl
  rw [hdiv]
  exact Submodule.sum_mem _ fun j _ ↦ Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)

/-- When `H` acts faithfully on `A`, the powers `1, y, …, y ^ (|H| - 1)` are `A^H`-linearly
independent. -/
private lemma linearIndependent_pow [IsAdicComplete (maximalIdeal A) A]
    [PerfectField (ResidueField A)] [FaithfulSMul H A]
    {x : ι → A} {y : A}
    (hres : ∀ (h : H) (a : A), residue A (h • a) = residue A a)
    (hspan : span (insert y (Set.range x)) = maximalIdeal A)
    (hrank : (maximalIdeal A).spanFinrank = Fintype.card ι + 1)
    (hfix : ∀ (h : H) (i : ι), h • x i = x i) :
    LinearIndependent (FixedPoints.subring A H) (fun j : Fin (Nat.card H) ↦ y ^ (j : ℕ)) := by
  classical
  have := Fintype.ofFinite H
  set B := FixedPoints.subring A H
  let K := FractionRing B
  let L := FractionRing A
  let _ : Algebra K L := FractionRing.liftAlgebra B L
  have _ : IsScalarTower B K L := FractionRing.isScalarTower_liftAlgebra B L
  let _ : MulSemiringAction H L := IsFractionRing.mulSemiringAction H A L
  have _ : SMulDistribClass H A L := IsFractionRing.smulDistribClass H A L
  have _ : FaithfulSMul H L := IsFractionRing.faithfulSMul H A L
  have _ : SMulCommClass H K L := IsFractionRing.smulCommClass H B A K L
  have hspanL := span_fractionRing_pow hres hspan hrank hfix
  have _ : FiniteDimensional K L :=
    ⟨top_le_iff.mp hspanL ▸ Submodule.fg_span (Set.finite_range _)⟩
  have hle_finrank : Nat.card H ≤ Module.finrank K L := by
    rw [Nat.card_eq_fintype_card]
    exact (Fintype.card_le_of_injective _
      (MulSemiringAction.toAlgHom_injective K L)).trans AlgHom.card_le
  have hliL : LinearIndependent K (fun j : Fin (Nat.card H) ↦ algebraMap A L (y ^ (j : ℕ))) :=
    linearIndependent_of_top_le_span_of_card_le_finrank hspanL (by simpa using hle_finrank)
  rw [Fintype.linearIndependent_iff] at hliL ⊢
  intro g hg j
  have hgL : ∑ i : Fin (Nat.card H), algebraMap B K (g i) • algebraMap A L (y ^ (i : ℕ)) = 0 := by
    have h0 := congrArg (algebraMap A L) hg
    rw [map_sum, map_zero] at h0
    convert h0 using 2 with i
    rw [Algebra.smul_def, ← IsScalarTower.algebraMap_apply B K L,
      IsScalarTower.algebraMap_apply B A L, Algebra.smul_def, map_mul]
  exact IsFractionRing.injective B K (by simpa using hliL (fun i ↦ algebraMap B K (g i)) hgL j)

end Helpers

section KM752

variable {A : Type u} [CommRing A] [IsRegularLocalRing A] [IsAdicComplete (maximalIdeal A) A]
variable [PerfectField (ResidueField A)]
variable {H : Type*} [Group H] [Finite H] [MulSemiringAction H A]
variable {ι : Type*} [Fintype ι] {x : ι → A} {y : A}

/-- **Katz–Mazur Theorem 7.5.2 (power basis).** Let `A` be a complete Noetherian regular local ring
with perfect residue field, and let a finite group `H` act faithfully on `A` and trivially on
`ResidueField A`. If `{y} ∪ range x` is a regular system of parameters of `A` such that `H` fixes
every `x i`, then `1, y, …, y ^ (|H| - 1)` is a power basis of `A` over `A^H`. -/
noncomputable def powerBasis [FaithfulSMul H A]
    (hres : ∀ (h : H) (a : A), residue A (h • a) = residue A a)
    (hspan : span (insert y (Set.range x)) = maximalIdeal A)
    (hrank : (maximalIdeal A).spanFinrank = Fintype.card ι + 1)
    (hfix : ∀ (h : H) (i : ι), h • x i = x i) :
    PowerBasis (FixedPoints.subring A H) A where
  gen := y
  dim := Nat.card H
  basis := Module.Basis.mk
    (linearIndependent_pow hres hspan hrank hfix)
    (fun a _ ↦ by
      obtain ⟨c, rfl⟩ := exists_sum_pow_eq hres hspan hrank hfix a
      exact Submodule.sum_mem _ fun j _ ↦
        Submodule.smul_mem _ (c j) (Submodule.subset_span ⟨j, rfl⟩))
  basis_eq_pow j := by simp

/-- The generator of `powerBasis` is `y`. -/
@[simp]
theorem powerBasis_gen [FaithfulSMul H A]
    (hres : ∀ (h : H) (a : A), residue A (h • a) = residue A a)
    (hspan : span (insert y (Set.range x)) = maximalIdeal A)
    (hrank : (maximalIdeal A).spanFinrank = Fintype.card ι + 1)
    (hfix : ∀ (h : H) (i : ι), h • x i = x i) :
    (powerBasis hres hspan hrank hfix).gen = y := by
  rfl

/-- The dimension of `powerBasis` is `Nat.card H`. -/
@[simp]
theorem powerBasis_dim [FaithfulSMul H A]
    (hres : ∀ (h : H) (a : A), residue A (h • a) = residue A a)
    (hspan : span (insert y (Set.range x)) = maximalIdeal A)
    (hrank : (maximalIdeal A).spanFinrank = Fintype.card ι + 1)
    (hfix : ∀ (h : H) (i : ι), h • x i = x i) :
    (powerBasis hres hspan hrank hfix).dim = Nat.card H := by
  rfl

omit [IsAdicComplete (maximalIdeal A) A] [PerfectField (ResidueField A)] in
/-- In a ring with a power basis over `B`, every basis coordinate of an element of `I · A` lies in
`I`. -/
private lemma repr_mem_of_mem_map {B : Type*} [CommRing B] [Algebra B A]
    (pb : PowerBasis B A) (I : Ideal B) {a : A} (ha : a ∈ I.map (algebraMap B A))
    (j : Fin pb.dim) : pb.basis.repr a j ∈ I := by
  suffices ∀ j : Fin pb.dim, pb.basis.repr a j ∈ I from this j
  refine Submodule.span_induction ?_ ?_ ?_ ?_ ha
  · rintro _ ⟨b, hb, rfl⟩ k
    have h0 : pb.basis ⟨0, pb.dim_pos⟩ = 1 := by rw [pb.basis_eq_pow, pow_zero]
    rw [Algebra.algebraMap_eq_smul_one, ← h0, map_smul, pb.basis.repr_self, Finsupp.smul_apply,
      smul_eq_mul, Finsupp.single_apply]
    split_ifs
    · simpa using hb
    · simp
  · intro k
    simp
  · intro u v _ _ hu hv k
    rw [map_add, Finsupp.add_apply]
    exact add_mem (hu k) (hv k)
  · intro r u _ hu k
    have hu' : u = ∑ i : Fin pb.dim, pb.basis.repr u i • pb.basis i := (pb.basis.sum_repr u).symm
    have hmul : r • u = ∑ i : Fin pb.dim, pb.basis.repr u i • (r * pb.basis i) := by
      conv_lhs => rw [hu']
      rw [Finset.smul_sum]
      refine Finset.sum_congr rfl fun i _ ↦ ?_
      rw [smul_eq_mul, Algebra.mul_smul_comm]
    rw [hmul, ← pb.basis.coord_apply, map_sum]
    refine Submodule.sum_mem _ fun i _ ↦ ?_
    rw [map_smul, smul_eq_mul]
    exact Ideal.mul_mem_right _ _ (hu i)

omit [IsAdicComplete (maximalIdeal A) A] [PerfectField (ResidueField A)] in
/-- The basis coordinates of an element of a subring `B ≤ A` with respect to a power basis of `A`
over `B` vanish except in degree `0`. -/
private lemma repr_subring (B : Subring A) (pb : PowerBasis B A) (b : B) (k : Fin pb.dim) :
    pb.basis.repr (b : A) k = if (k : ℕ) = 0 then b else 0 := by
  have h0 : pb.basis ⟨0, pb.dim_pos⟩ = 1 := by rw [pb.basis_eq_pow, pow_zero]
  have hb : (b : A) = b • pb.basis ⟨0, pb.dim_pos⟩ := by
    rw [h0, Subring.smul_def, smul_eq_mul, mul_one]
  rw [hb, map_smul, pb.basis.repr_self, Finsupp.smul_apply, Finsupp.single_apply, smul_eq_mul]
  split_ifs with h1 h2 h2
  · exact mul_one b
  · exact absurd (congrArg Fin.val h1.symm) h2
  · exact absurd (Fin.ext h2.symm) h1
  · exact mul_zero b

omit [IsRegularLocalRing A] [IsAdicComplete (maximalIdeal A) A] [PerfectField (ResidueField A)] in
/-- The `m`-th basis coordinate of a shifted polynomial `∑ j, d j * pb.gen ^ (m + j)` is `d 0`. -/
private lemma repr_sum_pow_shift (B : Subring A) (pb : PowerBasis B A)
    {m : ℕ} (hm : m < pb.dim) (d : Fin (pb.dim - m) → B) :
    pb.basis.repr (∑ j : Fin (pb.dim - m), (d j : A) * pb.gen ^ (m + (j : ℕ))) ⟨m, hm⟩ =
      d ⟨0, Nat.sub_pos_of_lt hm⟩ := by
  rw [← pb.basis.coord_apply, map_sum, Finset.sum_eq_single ⟨0, Nat.sub_pos_of_lt hm⟩]
  · have hterm : (d ⟨0, Nat.sub_pos_of_lt hm⟩ : A) * pb.gen ^ (m + 0) =
        d ⟨0, Nat.sub_pos_of_lt hm⟩ • pb.basis ⟨m, hm⟩ := by
      rw [pb.basis_eq_pow, add_zero, Subring.smul_def, smul_eq_mul]
    rw [hterm, map_smul, Module.Basis.coord_apply, pb.basis.repr_self, Finsupp.single_eq_same,
      smul_eq_mul, mul_one]
  · intro j _ hj
    have hj_pos : 0 < (j : ℕ) := Nat.pos_of_ne_zero fun h0 ↦ hj (Fin.ext h0)
    have hmj : m + (j : ℕ) < pb.dim := by omega
    have hterm : (d j : A) * pb.gen ^ (m + (j : ℕ)) = d j • pb.basis ⟨m + (j : ℕ), hmj⟩ := by
      rw [pb.basis_eq_pow, Subring.smul_def, smul_eq_mul]
    have hne : (⟨m + (j : ℕ), hmj⟩ : Fin pb.dim) ≠ ⟨m, hm⟩ := by
      intro heq
      have : m + (j : ℕ) = m := congrArg Fin.val heq
      omega
    rw [hterm, map_smul, Module.Basis.coord_apply, pb.basis.repr_self,
      Finsupp.single_eq_of_ne hne.symm, smul_zero]
  · intro hnot
    exact absurd (Finset.mem_univ _) hnot

/-- **Katz–Mazur Theorem 7.5.2 (regular system of parameters).** When `H` acts faithfully on `A`,
the maximal ideal of `A^H` is generated by `orbitProd H y` together with the fixed parameters
`x i`. -/
theorem maximalIdeal_subring_eq_span [FaithfulSMul H A]
    (hres : ∀ (h : H) (a : A), residue A (h • a) = residue A a)
    (hspan : span (insert y (Set.range x)) = maximalIdeal A)
    (hrank : (maximalIdeal A).spanFinrank = Fintype.card ι + 1)
    (hfix : ∀ (h : H) (i : ι), h • x i = x i) :
    maximalIdeal (FixedPoints.subring A H) =
      span (insert (orbitProd H y)
        (Set.range fun i ↦ (⟨x i, fun h ↦ hfix h i⟩ : FixedPoints.subring A H))) := by
  let B := FixedPoints.subring A H
  let I₀ : Ideal B := span (insert (orbitProd H y) (Set.range fun i ↦ ⟨x i, fun h ↦ hfix h i⟩))
  refine le_antisymm ?_ (I₀_le_maximalIdeal hspan hfix)
  intro b hb
  by_contra hb_not
  let pb := powerBasis hres hspan hrank hfix
  have hb_not_map : (b : A) ∉ I₀.map B.subtype := fun hmem ↦ by
    have h0 := repr_mem_of_mem_map pb I₀ hmem ⟨0, pb.dim_pos⟩
    simp only [repr_subring B pb b ⟨0, pb.dim_pos⟩, ↓reduceIte] at h0
    exact hb_not h0
  -- Step 1: factor `q b = u * (q y) ^ m` in the DVR `A ⧸ (x)` with `0 < m < |H|`.
  set J := span (Set.range x)
  set q := Ideal.Quotient.mk J
  have hregD : IsRegularLocalRing (A ⧸ J) :=
    TauCeti.IsRegularLocalRing.quotient_span_range hspan hrank
  have hdvrD : IsDiscreteValuationRing (A ⧸ J) :=
    TauCeti.IsRegularLocalRing.isDiscreteValuationRing_quotient_span_range hspan hrank
  have hirr : Irreducible (q y) :=
    TauCeti.IsRegularLocalRing.irreducible_mk_quotient_span_range hspan hrank
  have hq_not : q (b : A) ∉ span {q y ^ Nat.card H} := fun hmem ↦
    hb_not_map ((map_I₀_eq_span_pow hspan hrank hfix).symm ▸
      (mem_span_insert_range_iff.mpr (by rwa [map_pow])))
  have hq_ne : q (b : A) ≠ 0 := fun h0 ↦ hq_not (h0 ▸ zero_mem _)
  obtain ⟨m, u, hbu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hq_ne hirr
  have hm_lt : m < Nat.card H := by
    by_contra hge
    push Not at hge
    apply hq_not
    rw [Ideal.mem_span_singleton]
    refine ⟨(u : A ⧸ J) * q y ^ (m - Nat.card H), ?_⟩
    rw [hbu, ← mul_assoc, mul_comm (q y ^ Nat.card H), mul_assoc, ← pow_add,
      Nat.add_sub_cancel' hge]
  have hm_pos : 0 < m := by
    by_contra hm0
    rw [Nat.eq_zero_of_not_pos hm0, pow_zero, mul_one] at hbu
    have hqb_mem : q (b : A) ∈ maximalIdeal (A ⧸ J) := by
      rw [← map_maximalIdeal_of_surjective q Ideal.Quotient.mk_surjective]
      exact Ideal.mem_map_of_mem q (mem_maximalIdeal_subring_iff.mp hb)
    exact (notMem_maximalIdeal.mpr (hbu ▸ u.isUnit)) hqb_mem
  -- Step 2: expand the unit `u` modulo `(q y) ^ (|H| - m)` with `A^H`-coefficients.
  obtain ⟨d, r, hu_exp, hd0⟩ :=
    exists_expansion_quotient hres hspan hrank (Nat.card H - m) (u : A ⧸ J)
  have hdiff_mem : (b : A) - ∑ j : Fin (Nat.card H - m),
      (d j : A) * y ^ (m + (j : ℕ)) ∈ I₀.map B.subtype := by
    rw [map_I₀_eq_span_pow hspan hrank hfix, mem_span_insert_range_iff, map_pow,
      Ideal.mem_span_singleton]
    refine ⟨r, ?_⟩
    rw [map_sub, map_sum, hbu, hu_exp, add_mul, Finset.sum_mul]
    have hsum_eq : ∑ j : Fin (Nat.card H - m), q (d j : A) * q y ^ (j : ℕ) * q y ^ m =
        ∑ j : Fin (Nat.card H - m), q ((d j : A) * y ^ (m + (j : ℕ))) :=
      Finset.sum_congr rfl fun j _ ↦ by rw [map_mul, map_pow, mul_assoc, ← pow_add, add_comm]
    rw [hsum_eq, add_sub_cancel_left, mul_right_comm, ← pow_add, Nat.sub_add_cancel hm_lt.le]
  -- Step 3: read off the degree-`m` power-basis coordinate to contradict `d 0 ∉ 𝔪_{A^H}`.
  have hm_lt' : m < pb.dim := hm_lt
  have hcoord := repr_mem_of_mem_map pb I₀ hdiff_mem ⟨m, hm_lt'⟩
  have hrepr_b : pb.basis.repr (b : A) ⟨m, hm_lt'⟩ = 0 := by
    simp only [repr_subring B pb b ⟨m, hm_lt'⟩, hm_pos.ne', ↓reduceIte]
  have hrepr_sum : pb.basis.repr
      (∑ j : Fin (Nat.card H - m), (d j : A) * y ^ (m + (j : ℕ))) ⟨m, hm_lt'⟩ =
      d ⟨0, Nat.sub_pos_of_lt hm_lt⟩ := repr_sum_pow_shift B pb hm_lt' d
  rw [map_sub, Finsupp.sub_apply, hrepr_b, hrepr_sum, zero_sub] at hcoord
  have hd0_I₀ : d ⟨0, Nat.sub_pos_of_lt hm_lt⟩ ∈ I₀ := by simpa using neg_mem hcoord
  exact hd0 (Nat.sub_pos_of_lt hm_lt) u.isUnit (I₀_le_maximalIdeal hspan hfix hd0_I₀)

/-- Faithful case of `isRegularLocalRing_subring`. -/
private lemma isRegularLocalRing_subring_of_faithful [FaithfulSMul H A]
    (hres : ∀ (h : H) (a : A), residue A (h • a) = residue A a)
    (hspan : span (insert y (Set.range x)) = maximalIdeal A)
    (hrank : (maximalIdeal A).spanFinrank = Fintype.card ι + 1)
    (hfix : ∀ (h : H) (i : ι), h • x i = x i) :
    IsRegularLocalRing (FixedPoints.subring A H) := by
  have : Module.Free (FixedPoints.subring A H) A :=
    Module.Free.of_basis (powerBasis hres hspan hrank hfix).basis
  exact TauCeti.IsRegularLocalRing.of_flat_of_isLocalHom (S := A)

/-- Faithful case of `isAdicComplete_subring`. -/
private lemma isAdicComplete_subring_of_faithful [FaithfulSMul H A]
    (hres : ∀ (h : H) (a : A), residue A (h • a) = residue A a)
    (hspan : span (insert y (Set.range x)) = maximalIdeal A)
    (hrank : (maximalIdeal A).spanFinrank = Fintype.card ι + 1)
    (hfix : ∀ (h : H) (i : ι), h • x i = x i) :
    IsAdicComplete (maximalIdeal (FixedPoints.subring A H)) (FixedPoints.subring A H) := by
  set B := FixedPoints.subring A H
  have hmap_le : (maximalIdeal B).map (algebraMap B A) ≤ maximalIdeal A := by
    rw [Ideal.map_le_iff_le_comap]
    exact (maximalIdeal_subring (M := H) (A := A)).le
  have hpow_le : maximalIdeal A ^ Nat.card H ≤ (maximalIdeal B).map (algebraMap B A) := by
    rw [maximalIdeal_subring_eq_span hres hspan hrank hfix]
    exact maximalIdeal_pow_le_map_I₀ hspan hrank hfix
  have : IsPrecomplete ((maximalIdeal B).map (algebraMap B A)) A :=
    IsPrecomplete.of_pow_le_of_pow_le (I := maximalIdeal A) (k := 1) (l := Nat.card H)
      (by simpa using hmap_le) hpow_le
  have : IsPrecomplete (maximalIdeal B) A :=
    (IsPrecomplete.map_algebraMap_iff (I := maximalIdeal B) (S := A) (M := A)).mp inferInstance
  obtain ⟨t, ht⟩ := (powerBasis hres hspan hrank hfix).exists_linearMap_apply_one
  have ht_surj : Function.Surjective t := fun b ↦ ⟨algebraMap B A b, by
    rw [Algebra.algebraMap_eq_smul_one, map_smul, ht, smul_eq_mul, mul_one]⟩
  have : IsPrecomplete (maximalIdeal B) B := IsPrecomplete.of_surjective (maximalIdeal B) t ht_surj
  have : IsHausdorff (maximalIdeal B) B := ⟨fun b hb ↦ by
    apply Subtype.ext
    apply IsHausdorff.haus (inferInstance : IsHausdorff (maximalIdeal A) A) (b : A)
    intro n
    have hbn : b ∈ maximalIdeal B ^ n := by
      simpa [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top] using hb n
    have hA : (b : A) ∈ maximalIdeal A ^ n := by
      have : (maximalIdeal B ^ n).map (algebraMap B A) ≤ maximalIdeal A ^ n := by
        rw [Ideal.map_pow]
        exact Ideal.pow_right_mono hmap_le n
      exact this (Ideal.mem_map_of_mem (algebraMap B A) hbn)
    simpa [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top] using hA⟩
  exact ⟨⟩

omit [IsAdicComplete (maximalIdeal A) A] [PerfectField (ResidueField A)] [Finite H]
  [Fintype ι] in
/-- Quotienting `H` by the kernel of its action on `A` produces a faithful action of a finite group
with the exact same invariant subring. -/
private lemma exists_faithful_quotient_action
    (hres : ∀ (h : H) (a : A), residue A (h • a) = residue A a)
    (hfix : ∀ (h : H) (i : ι), h • x i = x i) :
    let K := MonoidHom.ker (MulSemiringAction.toRingEquiv H A)
    ∃ (inst : MulSemiringAction (H ⧸ K) A),
      @FaithfulSMul (H ⧸ K) A inst.toSMul ∧
      FixedPoints.subring A H = @FixedPoints.subring A _ (H ⧸ K) _ inst ∧
      (∀ (q : H ⧸ K) (a : A), residue A (inst.smul q a) = residue A a) ∧
      (∀ (q : H ⧸ K) (i : ι), inst.smul q (x i) = x i) := by
  set K := MonoidHom.ker (MulSemiringAction.toRingEquiv H A)
  let φ : (H ⧸ K) →* (A ≃+* A) :=
    QuotientGroup.lift K (MulSemiringAction.toRingEquiv H A) fun _ hk ↦ hk
  let inst : MulSemiringAction (H ⧸ K) A := MulSemiringAction.compHom A φ
  refine ⟨inst, ?_, ?_, ?_, ?_⟩
  · refine ⟨fun {q₁ q₂} hq ↦ ?_⟩
    induction q₁ using QuotientGroup.induction_on with | H h₁ =>
    induction q₂ using QuotientGroup.induction_on with | H h₂ =>
    rw [QuotientGroup.eq, MonoidHom.mem_ker]
    refine RingEquiv.ext fun a ↦ ?_
    have ha : h₁ • a = h₂ • a := hq a
    simpa [mul_smul, inv_smul_eq_iff] using ha.symm
  · ext a
    constructor
    · intro ha q
      induction q using QuotientGroup.induction_on with | H h =>
      exact ha h
    · intro ha h
      exact ha (h : H ⧸ K)
  · intro q a
    induction q using QuotientGroup.induction_on with | H h =>
    exact hres h a
  · intro q i
    induction q using QuotientGroup.induction_on with | H h =>
    exact hfix h i

/-- **Katz–Mazur Theorem 7.5.2 (regularity).** Let `A` be a complete Noetherian regular local ring
with perfect residue field, and let a finite group `H` act on `A` trivially on `ResidueField A`.
If `{y} ∪ range x` is a regular system of parameters of `A` such that `H` fixes every `x i`, then
`FixedPoints.subring A H` is a regular local ring. Faithfulness of the action is not required. -/
theorem isRegularLocalRing_subring
    (hres : ∀ (h : H) (a : A), residue A (h • a) = residue A a)
    (hspan : span (insert y (Set.range x)) = maximalIdeal A)
    (hrank : (maximalIdeal A).spanFinrank = Fintype.card ι + 1)
    (hfix : ∀ (h : H) (i : ι), h • x i = x i) :
    IsRegularLocalRing (FixedPoints.subring A H) := by
  obtain ⟨inst, hfaith, heq, hres', hfix'⟩ := exists_faithful_quotient_action hres hfix
  rw [heq]
  exact @isRegularLocalRing_subring_of_faithful A _ _ _ _ _ _ _ inst _ _ _ _ hfaith hres' hspan
    hrank hfix'

/-- **Katz–Mazur Theorem 7.5.2 (completeness).** Under the hypotheses of
`isRegularLocalRing_subring`, the invariant subring `FixedPoints.subring A H` is complete for its
maximal ideal. -/
theorem isAdicComplete_subring
    (hres : ∀ (h : H) (a : A), residue A (h • a) = residue A a)
    (hspan : span (insert y (Set.range x)) = maximalIdeal A)
    (hrank : (maximalIdeal A).spanFinrank = Fintype.card ι + 1)
    (hfix : ∀ (h : H) (i : ι), h • x i = x i) :
    IsAdicComplete (maximalIdeal (FixedPoints.subring A H)) (FixedPoints.subring A H) := by
  obtain ⟨inst, hfaith, heq, hres', hfix'⟩ := exists_faithful_quotient_action hres hfix
  have := hfaith
  let _ := inst
  have hcomp := isAdicComplete_subring_of_faithful hres' hspan hrank hfix'
  have : ∀ (S₁ S₂ : Subring A) (_ : S₁ = S₂) [IsLocalRing S₁] [IsLocalRing S₂],
      IsAdicComplete (maximalIdeal S₂) S₂ → IsAdicComplete (maximalIdeal S₁) S₁ := by
    rintro S₁ _ rfl _ _ h
    exact h
  exact this _ _ heq hcomp

/-- **Katz–Mazur Theorem 7.5.2 (embedding dimension).** Under the hypotheses of
`isRegularLocalRing_subring`, the maximal ideal of `FixedPoints.subring A H` has minimal number of
generators `|ι| + 1`. -/
theorem spanFinrank_maximalIdeal_subring
    (hres : ∀ (h : H) (a : A), residue A (h • a) = residue A a)
    (hspan : span (insert y (Set.range x)) = maximalIdeal A)
    (hrank : (maximalIdeal A).spanFinrank = Fintype.card ι + 1)
    (hfix : ∀ (h : H) (i : ι), h • x i = x i) :
    (maximalIdeal (FixedPoints.subring A H)).spanFinrank = Fintype.card ι + 1 := by
  have := isRegularLocalRing_subring hres hspan hrank hfix
  have h1 := IsRegularLocalRing.spanFinrank_maximalIdeal (R := FixedPoints.subring A H)
  have h2 := IsRegularLocalRing.spanFinrank_maximalIdeal (R := A)
  have hdim := ringKrullDim_subring (A := A) (H := H)
  rw [← hrank]
  exact_mod_cast h1.trans (hdim.trans h2.symm)

/-- **Katz–Mazur Theorem 7.5.2 (power basis without faithfulness).** Without assuming faithfulness
of the `H`-action, `A` still admits a power basis over `FixedPoints.subring A H` with generator `y`
and dimension equal to the index `[H : ker(H → Aut(A))]`. -/
theorem exists_powerBasis
    (hres : ∀ (h : H) (a : A), residue A (h • a) = residue A a)
    (hspan : span (insert y (Set.range x)) = maximalIdeal A)
    (hrank : (maximalIdeal A).spanFinrank = Fintype.card ι + 1)
    (hfix : ∀ (h : H) (i : ι), h • x i = x i) :
    ∃ pb : PowerBasis (FixedPoints.subring A H) A,
      pb.gen = y ∧
      pb.dim = Nat.card (H ⧸ MonoidHom.ker (MulSemiringAction.toRingEquiv H A)) := by
  obtain ⟨inst, hfaith, heq, hres', hfix'⟩ := exists_faithful_quotient_action hres hfix
  let _ := inst
  have := hfaith
  rw [heq]
  exact ⟨powerBasis hres' hspan hrank hfix', rfl, rfl⟩

/-- **Katz–Mazur Theorem 7.5.2 (regular parameters without faithfulness).** Without assuming
faithfulness of the `H`-action, the maximal ideal of `FixedPoints.subring A H` is generated by the
fixed parameters `x i` together with one additional invariant element. -/
theorem exists_maximalIdeal_subring_eq_span
    (hres : ∀ (h : H) (a : A), residue A (h • a) = residue A a)
    (hspan : span (insert y (Set.range x)) = maximalIdeal A)
    (hrank : (maximalIdeal A).spanFinrank = Fintype.card ι + 1)
    (hfix : ∀ (h : H) (i : ι), h • x i = x i) :
    ∃ z : FixedPoints.subring A H,
      maximalIdeal (FixedPoints.subring A H) =
        span (insert z
          (Set.range fun i ↦ (⟨x i, fun h ↦ hfix h i⟩ : FixedPoints.subring A H))) := by
  obtain ⟨inst, hfaith, heq, hres', hfix'⟩ := exists_faithful_quotient_action hres hfix
  let _ := inst
  have := hfaith
  set K := MonoidHom.ker (MulSemiringAction.toRingEquiv H A)
  have hmax := maximalIdeal_subring_eq_span (H := H ⧸ K) hres' hspan hrank hfix'
  refine ⟨⟨(orbitProd (H ⧸ K) y : A), ?_⟩, ?_⟩
  · rw [heq]
    exact (orbitProd (H ⧸ K) y).2
  · have : ∀ (S₁ S₂ : Subring A) (_ : S₁ = S₂) [IsLocalRing S₁] [IsLocalRing S₂]
        (z₁ : S₁) (z₂ : S₂) (_ : (z₁ : A) = (z₂ : A))
        (f₁ : ι → S₁) (f₂ : ι → S₂) (_ : ∀ i, (f₁ i : A) = (f₂ i : A)),
        maximalIdeal S₂ = span (insert z₂ (Set.range f₂)) →
        maximalIdeal S₁ = span (insert z₁ (Set.range f₁)) := by
      rintro S₁ _ rfl _ _ z₁ z₂ hz f₁ f₂ hf hspan₂
      have hz' : z₁ = z₂ := Subtype.ext hz
      have hf' : f₁ = f₂ := funext fun i ↦ Subtype.ext (hf i)
      subst hz'
      subst hf'
      exact hspan₂
    exact this _ _ heq _ _ rfl _ _ (fun _ ↦ rfl) hmax

end KM752

