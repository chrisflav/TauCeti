/-!
# Krasner approximation and countability of finite intermediate fields

Let `L` be an algebraically closed normed field over a normed field `K` satisfying Krasner's lemma
(`IsKrasner K L`), and let `k` be a field whose image in `K` is dense. Approximating the minimal
polynomial of a separable element `x ∈ L` over `K` by a monic polynomial of the same degree over
`k` produces a root `y` algebraic over `k` close enough to `x` for Krasner's lemma to force
`x ∈ K⟮y⟯`, and comparing degrees over `K` gives `K⟮y⟯ = K⟮x⟯`.

Combined with the primitive element theorem, every finite separable intermediate field `E` of `L/K`
is generated over `K` by a single element algebraic over `k`. When `k` is countable, it follows
that `L/K` has only countably many finite separable intermediate fields, and hence countably many
finite intermediate fields when `K` is perfect.

## Main results

* `IsSeparable.exists_isAlgebraic_adjoin_eq`: a separable simple extension `K⟮x⟯` equals `K⟮y⟯`
  for some `y` algebraic over a dense subfield `k` of `K`.
* `IntermediateField.exists_isAlgebraic_adjoin_simple_eq`: every finite separable intermediate
  field of `L/K` has a primitive element algebraic over `k`.
* `IntermediateField.countable_setOf_finiteDimensional_isSeparable`: when `k` is countable and
  dense in `K`, `L/K` has only countably many finite separable intermediate fields.
* `IntermediateField.countable_setOf_finiteDimensional`: over a perfect field `K` with a countable
  dense subfield `k`, `L/K` has only countably many finite intermediate fields.

## References

* J. Neukirch, *Algebraic Number Theory*, Chapter II, §4 (Krasner's lemma).
* A. M. Robert, *A Course in p-adic Analysis*, Graduate Texts in Mathematics 198, Springer, 2000,
  Chapter 3, §1.4.
-/

public section

open IntermediateField Polynomial

section Krasner

variable {k K L : Type*} [Field k] [NormedField K] [NormedField L] [NormedAlgebra K L]
  [Algebra k K] [Algebra k L] [IsScalarTower k K L] [IsKrasner K L] [IsAlgClosed L]

/-- **Krasner approximation of a separable generator.** In an algebraically closed Krasner
extension `L/K`, any simple extension `K⟮x⟯` generated by a `K`-separable element `x` equals
`K⟮y⟯` for an element `y` algebraic over any dense subfield `k` of `K`. -/
theorem IsSeparable.exists_isAlgebraic_adjoin_eq {x : L} (hx : IsSeparable K x)
    (hk : DenseRange (algebraMap k K)) :
    ∃ y : L, IsAlgebraic k y ∧ K⟮y⟯ = K⟮x⟯ := by
  classical
  have hfm : (minpoly K x).Monic := minpoly.monic hx.isIntegral
  have hn : (minpoly K x).natDegree ≠ 0 := (minpoly.natDegree_pos hx.isIntegral).ne'
  -- Choose `δ > 0` below the distance from `x` to every distinct `K`-conjugate root in `L`.
  let S : Finset L := ((minpoly K x).aroots L).toFinset.erase x
  have hconj_mem {x' : L} (hx' : IsConjRoot K x x') (hne : x ≠ x') : x' ∈ S := by
    refine Finset.mem_erase.mpr ⟨hne.symm, Multiset.mem_toFinset.mpr ?_⟩
    exact mem_aroots.mpr ⟨hfm.ne_zero, by simpa using hx'.aeval_eq_zero⟩
  obtain ⟨δ, hδ_pos, hδ_le⟩ :
      ∃ δ : ℝ, 0 < δ ∧ ∀ x' : L, IsConjRoot K x x' → x ≠ x' → δ ≤ ‖x - x'‖ := by
    by_cases hS : S.Nonempty
    · refine ⟨S.inf' hS fun x' ↦ ‖x - x'‖, ?_,
        fun x' hx' hne ↦ Finset.inf'_le _ (hconj_mem hx' hne)⟩
      exact (Finset.lt_inf'_iff hS).mpr fun x' hx' ↦
        norm_pos_iff.mpr (sub_ne_zero.mpr (Finset.mem_erase.mp hx').1.symm)
    · exact ⟨1, one_pos, fun x' hx' hne ↦ (hS ⟨x', hconj_mem hx' hne⟩).elim⟩
  have hM : 0 < max ‖x‖ 1 := lt_max_of_lt_right one_pos
  have hε : 0 < (δ / max ‖x‖ 1) ^ (minpoly K x).natDegree / ((minpoly K x).natDegree + 1) := by
    positivity
  -- Approximate `minpoly K x` by a monic polynomial `g` over `k` of the same degree and take a
  -- root `y` of `g` within `δ` of `x`.
  obtain ⟨g, hgm, hdeg, hcoeff⟩ :=
    exists_monic_and_natDegree_eq_and_norm_map_algebraMap_coeff_sub_lt hk hfm hε
  obtain ⟨y, hy, hxy⟩ := exists_aroots_norm_sub_lt_of_norm_coeff_sub_lt hε (minpoly.aeval K x) hfm
    (hgm.map _) (by rw [natDegree_map, hdeg]) hcoeff (IsAlgClosed.splits _)
  have hxy_lt : ‖x - y‖ < δ := by
    rwa [mul_div_cancel₀ _ (by positivity), Real.pow_rpow_inv_natCast (div_pos hδ_pos hM).le hn,
      div_mul_cancel₀ _ hM.ne'] at hxy
  have hgy : aeval y (g.map (algebraMap k K)) = 0 := (mem_aroots.mp hy).2
  have hyk : IsAlgebraic k y := ⟨g, hgm.ne_zero, by simpa [aeval_map_algebraMap] using hgy⟩
  have hyK : IsIntegral K y := hyk.isIntegral.tower_top
  -- Krasner's lemma gives `K⟮x⟯ ≤ K⟮y⟯`; equality follows from the degree bound on `y`.
  have hle : K⟮x⟯ ≤ K⟮y⟯ := IntermediateField.adjoin_simple_le_iff.mpr <|
    IsKrasner.krasner hx (IsAlgClosed.splits _) hyK fun x' hx' hne ↦
      hxy_lt.trans_le (hδ_le x' hx' hne)
  have : FiniteDimensional K K⟮y⟯ := IntermediateField.adjoin.finiteDimensional hyK
  have hfin : Module.finrank K K⟮y⟯ ≤ Module.finrank K K⟮x⟯ := by
    rw [IntermediateField.adjoin.finrank hyK, IntermediateField.adjoin.finrank hx.isIntegral, hdeg,
      ← natDegree_map (algebraMap k K)]
    exact natDegree_le_of_dvd (minpoly.dvd K y hgy) (hgm.map _).ne_zero
  have hle_sub : K⟮x⟯.toSubmodule ≤ K⟮y⟯.toSubmodule := fun _ hz ↦ hle hz
  have hsub : K⟮y⟯.toSubmodule = K⟮x⟯.toSubmodule :=
    (Submodule.eq_of_le_of_finrank_le hle_sub hfin).symm
  exact ⟨y, hyk, IntermediateField.ext fun z ↦ SetLike.ext_iff.mp hsub z⟩

namespace IntermediateField

/-- **Primitive element algebraic over a dense subfield.** Every finite separable intermediate
field of an algebraically closed Krasner extension `L/K` is generated over `K` by a single element
algebraic over any dense subfield `k` of `K`. -/
theorem exists_isAlgebraic_adjoin_simple_eq (E : IntermediateField K L) [FiniteDimensional K E]
    [Algebra.IsSeparable K E] (hk : DenseRange (algebraMap k K)) :
    ∃ y : L, IsAlgebraic k y ∧ K⟮y⟯ = E := by
  obtain ⟨α, hα⟩ := Field.exists_primitive_element K E
  have hsep : IsSeparable K (α : L) := by
    rw [IsSeparable, ← IntermediateField.coe_val E, minpoly.algHom_eq E.val E.val.injective α]
    exact Algebra.IsSeparable.isSeparable K α
  have hE : K⟮(α : L)⟯ = E := by
    have hmap := congrArg (IntermediateField.map E.val) hα
    simpa [IntermediateField.adjoin_map, ← AlgHom.fieldRange_eq_map] using hmap
  obtain ⟨y, hy, hyx⟩ := hsep.exists_isAlgebraic_adjoin_eq hk
  exact ⟨y, hy, hyx.trans hE⟩

/-- **Countability of finite separable intermediate fields.** If `K` has a countable dense subfield
`k`, an algebraically closed Krasner extension `L/K` has only countably many finite separable
intermediate fields. -/
theorem countable_setOf_finiteDimensional_isSeparable [Countable k]
    (hk : DenseRange (algebraMap k K)) :
    {E : IntermediateField K L | FiniteDimensional K E ∧ Algebra.IsSeparable K E}.Countable := by
  refine ((Algebraic.countable k L).image (fun y : L ↦ K⟮y⟯)).mono fun E ⟨hfin, hsep⟩ ↦ ?_
  obtain ⟨y, hy, rfl⟩ := E.exists_isAlgebraic_adjoin_simple_eq hk
  exact ⟨y, hy, rfl⟩

/-- **Countability of finite intermediate fields.** Over a perfect field `K` with a countable dense
subfield `k`, an algebraically closed Krasner extension `L/K` has only countably many finite
intermediate fields. -/
theorem countable_setOf_finiteDimensional [Countable k] [PerfectField K]
    (hk : DenseRange (algebraMap k K)) :
    {E : IntermediateField K L | FiniteDimensional K E}.Countable := by
  refine (countable_setOf_finiteDimensional_isSeparable (L := L) hk).mono fun E hfin ↦ ?_
  have : FiniteDimensional K E := hfin
  exact ⟨hfin, inferInstance⟩

end IntermediateField

end Krasner
