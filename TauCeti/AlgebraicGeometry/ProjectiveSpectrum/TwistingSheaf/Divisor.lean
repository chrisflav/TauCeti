/-!
# Effective Cartier divisors of homogeneous elements and twisting sheaves

Let `A = ⨁ᵢ 𝒜 i` be an `ℕ`-graded commutative ring and `z ∈ 𝒜 d` a homogeneous element of
degree `d`. Pointwise multiplication by `z / 1` sends local fractions of degree `-d` to local
fractions of degree `0`, giving a morphism of `𝒪_{Proj A}`-modules

`mulHom z : 𝒪(-d) ⟶ 𝒪_{Proj A}`.

On the standard open `D₊(g)` of a homogeneous element `g` of degree one, the basis section `g⁻ᵈ` of
`𝒪(-d)` maps to the regular function `z / gᵈ`, so the image ideal of `mulHom z` on `D₊(g)` is
generated by `z / gᵈ`. When `z` is a nonzerodivisor in `A`, `mulHom z` is a monomorphism on
`Proj A` without any hypothesis on the chart denominators, and identifies `𝒪(-d)` with its image
ideal sheaf `(mulHom z).imageIdealSheaf`.

When the standard opens `D₊(f i)` of a family of degree-one elements cover `Proj A`, any ideal
sheaf `I` whose pullback along each chart `Spec A_{(f i)} ⟶ Proj A` is generated by `z / fᵢᵈ`
coincides with `(mulHom z).imageIdealSheaf`. Since `𝒪(-d)` is invertible, `I` is an effective
Cartier divisor with `I ≅ 𝒪(-d)`, its dual line bundle `𝒪(D)` has class `[𝒪(d)]` in the Picard
group, and `𝒪(D)` is ample whenever `Proj A` is quasi-compact and `d > 0`.

## Main definitions

* `AlgebraicGeometry.Proj.twistingSheaf.mulHom`: multiplication by `z : 𝒜 d`, as a morphism
  `𝒪(-d) ⟶ 𝒪_{Proj A}` of `𝒪_{Proj A}`-modules.
* `AlgebraicGeometry.Proj.idealSheafIsoTwistingSheafNeg`: the isomorphism `I.sheaf ≅ 𝒪(-d)` for an
  ideal sheaf `I` cut out on degree-one charts by a homogeneous nonzerodivisor `z : 𝒜 d`.

## Main results

* `AlgebraicGeometry.Proj.twistingSheaf.mono_mulHom_of_isSMulRegular`: if `z` is regular on `A`,
  then `mulHom z` is a monomorphism.
* `AlgebraicGeometry.Proj.eq_imageIdealSheaf_mulHom`: an ideal sheaf cut out by `z / fᵢᵈ` on a
  covering family of degree-one charts equals `(mulHom z).imageIdealSheaf`.
* `AlgebraicGeometry.Proj.isEffectiveCartier_of_comap_awayι`: such an ideal sheaf is an effective
  Cartier divisor when `z` is regular on `A`.
* `AlgebraicGeometry.Proj.mk_toInvertibleSheaf_eq_twistingSheaf_neg` and
  `AlgebraicGeometry.Proj.mk_dual_toInvertibleSheaf_eq_twistingSheaf`: the Picard classes of `I`
  and its dual `𝒪(D)` are `[𝒪(-d)]` and `[𝒪(d)]`.
* `AlgebraicGeometry.Proj.isAmple_dual_toInvertibleSheaf`: when `Proj A` is quasi-compact and
  `0 < d`, the dual line bundle `𝒪(D)` is ample.

## References

* R. Hartshorne, *Algebraic Geometry*, Section II.5 and Propositions II.6.13–II.6.14.
* [The Stacks Project, Tag 01M3](https://stacks.math.columbia.edu/tag/01M3) and
  [Tag 01WQ](https://stacks.math.columbia.edu/tag/01WQ).
-/

public section

noncomputable section

open CategoryTheory Opposite TopologicalSpace

namespace AlgebraicGeometry.Proj

universe u

variable {A : Type u} {σ : Type*} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
variable {𝒜 : ℕ → σ} [GradedRing 𝒜]

/-- Restricting a section `awayToSection 𝒜 g a` on `D₊(g)` along the chart open immersion
`awayι 𝒜 g hg hm : Spec A_{(g)} ⟶ Proj A` recovers `a` in `Γ(Spec A_{(g)}, ⊤)`. -/
theorem awayToSection_comp_awayι_appLE {g : A} {m : ℕ} (hg : g ∈ 𝒜 m) (hm : 0 < m)
    (e : ⊤ ≤ awayι 𝒜 g hg hm ⁻¹ᵁ basicOpen 𝒜 g) :
    awayToSection 𝒜 g ≫ (awayι 𝒜 g hg hm).appLE (basicOpen 𝒜 g) ⊤ e =
      (Scheme.ΓSpecIso (.of (HomogeneousLocalization.Away 𝒜 g))).inv := by
  have : IsIso (awayToSection 𝒜 g) := by
    rw [← basicOpenIsoAway_hom 𝒜 g hg hm]
    infer_instance
  rw [← IsIso.eq_inv_comp, Iso.eq_comp_inv]
  refine IsIso.eq_inv_of_inv_hom_id ?_
  rw [← cancel_mono (basicOpen 𝒜 g).topIso.inv]
  simp only [Category.assoc, Category.id_comp]
  rw [← basicOpenToSpec_app_top, ← basicOpenIsoSpec_hom 𝒜 g hg hm, Scheme.Hom.app_eq_appLE]
  refine (Scheme.Hom.appLE_comp_appLE _ (awayι 𝒜 g hg hm) _ ⊤ _ e le_rfl).trans ?_
  simp only [awayι, Iso.hom_inv_id_assoc]
  rfl

namespace twistingSheaf

open ProjectiveSpectrum.TwistingSheaf

section MulHom

variable {d : ℕ} (z : 𝒜 d)

/-- Pointwise multiplication of a local fraction of degree `-d` by `z / 1`, viewed in `𝒪(0)`. -/
private def mulSectionZero (U : (Proj 𝒜).Opens) (s : Γ(twistingSheaf 𝒜 (-d : ℤ), U)) :
    Γ(twistingSheaf 𝒜 0, U) :=
  ⟨s.1 * (toTwistingSheaf 𝒜 rfl U z).1, by
    apply (mem_sectionsAddSubgroup_iff _).mpr
    simpa only [neg_add_cancel] using isLocallyFraction_mul s.2 (toTwistingSheaf 𝒜 rfl U z).2⟩

/-- Pointwise multiplication by `z / 1` as a `Γ(Proj A, U)`-linear map `Γ(U, 𝒪(-d)) → Γ(U, 𝒪)`. -/
private def mulLinearMap (U : (Proj 𝒜).Opens) :
    Γ(twistingSheaf 𝒜 (-d : ℤ), U) →ₗ[Γ(Proj 𝒜, U)] Γ(Proj 𝒜, U) where
  toFun s := (sectionsLinearEquivTwistingSheafZero 𝒜 U).symm (mulSectionZero z U s)
  map_add' s t := by
    have h : mulSectionZero z U (s + t) = mulSectionZero z U s + mulSectionZero z U t :=
      ext fun x ↦ add_mul (s.1 x) (t.1 x) _
    rw [h, map_add]
  map_smul' a s := by
    have h : mulSectionZero z U (a • s) = a • mulSectionZero z U s :=
      ext fun x ↦ mul_assoc ((a.1 x).val) (s.1 x) _
    rw [h, LinearEquiv.map_smul, RingHom.id_apply]

private theorem val_mulLinearMap_apply (U : (Proj 𝒜).Opens) (s : Γ(twistingSheaf 𝒜 (-d : ℤ), U))
    (x : U) : (((mulLinearMap z U s).1 x)).val = s.1 x * Localization.mk (z : A) 1 :=
  sectionsLinearEquivTwistingSheafZero_symm_apply_val U (mulSectionZero z U s) x

private theorem res_mulLinearMap {U V : (Proj 𝒜).Opens} (i : V ⟶ U)
    (s : Γ(twistingSheaf 𝒜 (-d : ℤ), U)) :
    (Proj 𝒜).presheaf.map i.op (mulLinearMap z U s) =
      mulLinearMap z V ((twistingSheaf 𝒜 (-d : ℤ)).presheaf.map i.op s) :=
  Subtype.ext <| funext fun x ↦ HomogeneousLocalization.val_injective _ <|
    (val_mulLinearMap_apply z U s (i x)).trans
      (val_mulLinearMap_apply z V ((twistingSheaf 𝒜 (-d : ℤ)).presheaf.map i.op s) x).symm

/-- Multiplication by a homogeneous element `z ∈ 𝒜 d`, as a morphism `𝒪(-d) ⟶ 𝒪_{Proj A}` of
sheaves of modules on `Proj A`. -/
def mulHom (z : 𝒜 d) :
    twistingSheaf 𝒜 (-d : ℤ) ⟶ SheafOfModules.unit (Proj 𝒜).ringCatSheaf where
  val :=
    { app U := ModuleCat.ofHom (X := (twistingSheaf 𝒜 (-d : ℤ)).val.obj U)
        (Y := (SheafOfModules.unit (Proj 𝒜).ringCatSheaf).val.obj U)
        { toFun := mulLinearMap z U.unop
          map_add' := map_add _
          map_smul' := (mulLinearMap z U.unop).map_smul }
      naturality {_ _} i := ModuleCat.hom_ext <| LinearMap.ext fun s ↦
        (res_mulLinearMap z i.unop s).symm }

/-- On sections over `U`, `mulHom z` multiplies values in the localizations by `z / 1`. -/
@[simp]
theorem val_mulHom_app_apply (U : (Proj 𝒜).Opens) (s : Γ(twistingSheaf 𝒜 (-d : ℤ), U)) (x : U) :
    (((mulHom z).app U s).1 x).val = s.1 x * Localization.mk (z : A) 1 :=
  val_mulLinearMap_apply z U s x

/-- On the degree-one chart `D₊(g)`, `mulHom z` sends the standard generator `g⁻ᵈ` of `𝒪(-d)` to
the regular function `z / gᵈ`. -/
@[simp]
theorem mulHom_app_chartGenerator {g : A} (hg : g ∈ 𝒜 1) :
    (mulHom z).app (basicOpen 𝒜 g) (chartGenerator (-d : ℤ) g hg (basicOpen 𝒜 g) le_rfl) =
      awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg d (z : A)
        (by simpa only [smul_eq_mul, mul_one] using z.2)) := by
  apply Subtype.ext
  funext (x : basicOpen 𝒜 g)
  apply HomogeneousLocalization.val_injective
  have := x.1.isPrime
  refine (val_mulHom_app_apply z (basicOpen 𝒜 g) _ x).trans
    (Eq.trans ?_ (val_awayToSection_mk_apply ..).symm)
  simp only [chartGenerator_apply]
  rw [Localization.mk_mul, Localization.mk_eq_mk_iff]
  apply Localization.r_of_eq
  simp

/-- On the degree-one chart `D₊(g)`, the image ideal of `mulHom z` is generated by `z / gᵈ`. -/
theorem imageIdeal_mulHom_basicOpen {g : A} (hg : g ∈ 𝒜 1) :
    (mulHom z).imageIdeal (basicOpen 𝒜 g) =
      Ideal.span {(awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg d (z : A)
        (by simpa only [smul_eq_mul, mul_one] using z.2)))} := by
  ext s
  rw [Scheme.Modules.Hom.mem_imageIdeal, Ideal.mem_span_singleton']
  constructor
  · rintro ⟨t, rfl⟩
    let e := chartSectionsLinearEquiv (-d : ℤ) g hg (basicOpen 𝒜 g) le_rfl
    refine ⟨e.symm t, ?_⟩
    have ht : t = (e.symm t) • chartGenerator (-d : ℤ) g hg (basicOpen 𝒜 g) le_rfl :=
      (e.apply_symm_apply t).symm.trans (chartSectionsLinearEquiv_apply ..)
    conv_rhs => rw [ht]
    exact (((mulLinearMap z (basicOpen 𝒜 g)).map_smul _ _).trans
      (congrArg (_ * ·) (mulHom_app_chartGenerator z hg))).symm
  · rintro ⟨a, rfl⟩
    refine ⟨a • chartGenerator (-d : ℤ) g hg (basicOpen 𝒜 g) le_rfl, ?_⟩
    exact ((mulLinearMap z (basicOpen 𝒜 g)).map_smul a _).trans
      (congrArg (a * ·) (mulHom_app_chartGenerator z hg))

/-- Pulling `(mulHom z).imageIdealSheaf` back along a degree-one chart `awayι 𝒜 g hg one_pos` gives
the principal ideal sheaf generated by `z / gᵈ`. -/
theorem imageIdealSheaf_mulHom_comap_awayι {g : A} (hg : g ∈ 𝒜 1) :
    (mulHom z).imageIdealSheaf.comap (awayι 𝒜 g hg one_pos) =
      Scheme.IdealSheafData.ofIdealTop
        ((Ideal.span {(HomogeneousLocalization.Away.mk 𝒜 hg d (z : A)
          (by simpa only [smul_eq_mul, mul_one] using z.2))}).map
            (Scheme.ΓSpecIso (.of (HomogeneousLocalization.Away 𝒜 g))).inv.hom) := by
  have he : (⊤ : (Spec (.of (HomogeneousLocalization.Away 𝒜 g))).Opens) ≤
      awayι 𝒜 g hg one_pos ⁻¹ᵁ basicOpen 𝒜 g := fun p _ ↦ by
    rw [Scheme.Hom.mem_preimage, ← opensRange_awayι 𝒜 g hg one_pos]
    exact ⟨p, rfl⟩
  apply Scheme.IdealSheafData.ext_of_isAffine
  rw [Scheme.IdealSheafData.ideal_comap_of_le _ _
    ⟨basicOpen 𝒜 g, isAffineOpen_basicOpen 𝒜 g hg one_pos⟩ ⟨⊤, isAffineOpen_top _⟩ he]
  simp only [Scheme.Modules.Hom.imageIdealSheaf_ideal, imageIdeal_mulHom_basicOpen z hg,
    Scheme.IdealSheafData.ofIdealTop_ideal, homOfLE_refl, op_id, CategoryTheory.Functor.map_id,
    CommRingCat.hom_id, Ideal.map_span, Set.image_singleton, RingHom.id_apply]
  rw [← CommRingCat.comp_apply, awayToSection_comp_awayι_appLE hg one_pos he]

variable {z}

/-- If `z` is regular on `A`, then `(mulHom z).app U` is injective over every open `U`. -/
theorem mulHom_app_injective (hz : IsSMulRegular A (z : A)) (U : (Proj 𝒜).Opens) :
    Function.Injective ((mulHom z).app U) := by
  refine (injective_iff_map_eq_zero ((mulHom z).app U).hom).mpr fun s hs ↦ ext fun (x : U) ↦ ?_
  have := x.1.isPrime
  have hx : s.1 x * Localization.mk (z : A) 1 = 0 :=
    (val_mulHom_app_apply z U s x).symm.trans
      ((congrArg (fun a : Γ(Proj 𝒜, U) ↦ (a.1 x).val) hs).trans HomogeneousLocalization.val_zero)
  induction hrep : s.1 x using Localization.induction_on with
  | H data =>
    rcases data with ⟨r, m⟩
    rw [hrep, Localization.mk_mul, mul_one, ← Localization.mk_zero 1, Localization.mk_eq_mk_iff,
      Localization.r_iff_exists] at hx
    obtain ⟨c, hc⟩ := hx
    simp only [OneMemClass.coe_one, one_mul, mul_zero] at hc
    have hcr : (c : A) * r = 0 := hz (by linear_combination hc)
    refine Eq.trans ?_ (zero_apply x).symm
    rw [← Localization.mk_zero 1, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    exact ⟨c, by simp [hcr]⟩

/-- If `z` is regular on `A`, then `mulHom z : 𝒪(-d) ⟶ 𝒪_{Proj A}` is a monomorphism. -/
theorem mono_mulHom_of_isSMulRegular (hz : IsSMulRegular A (z : A)) : Mono (mulHom z) :=
  ⟨fun _ _ h ↦ SheafOfModules.Hom.ext <| PresheafOfModules.Hom.ext <| funext fun U ↦
    ModuleCat.hom_ext <| LinearMap.ext fun s ↦
      mulHom_app_injective hz U.unop <| congrArg (fun φ ↦ (φ.val.app U).hom s) h⟩

end MulHom

end twistingSheaf

section Divisor

variable {ι : Type*} (f : ι → A) (hf : ∀ i, f i ∈ 𝒜 1) (hcover : ⨆ i, basicOpen 𝒜 (f i) = ⊤)
variable {d : ℕ} {z : 𝒜 d} {I : (Proj 𝒜).IdealSheafData}

include hf hcover

omit hf in
private theorem iSup_basicOpen_range_eq_top :
    ⨆ g : Set.range f, basicOpen 𝒜 g.1 = ⊤ :=
  le_top.antisymm fun x hx ↦ by
    obtain ⟨i, hi⟩ := Opens.mem_iSup.mp (hcover.ge hx)
    exact Opens.mem_iSup.mpr ⟨⟨f i, i, rfl⟩, hi⟩

/-- All integer twists `𝒪(n)` are invertible when the standard opens of a family of degree-one
elements (indexed by a type in any universe) cover `Proj A`. -/
theorem isInvertible_twistingSheaf_of_cover (n : ℤ) :
    TauCeti.SheafOfModules.IsInvertible (R := (Proj 𝒜).ringCatSheaf) (twistingSheaf 𝒜 n) :=
  isInvertible_twistingSheaf_of_iSup_eq_top (Subtype.val : Set.range f → A)
    (fun ⟨_, i, hi⟩ ↦ hi ▸ hf i) (iSup_basicOpen_range_eq_top f hcover) n

/-- An ideal sheaf on `Proj A` whose pullback to each chart `D₊(f i)` of a covering family of
degree-one opens is generated by `z / fᵢᵈ` equals `(twistingSheaf.mulHom z).imageIdealSheaf`. -/
theorem eq_imageIdealSheaf_mulHom (z : 𝒜 d)
    (hI : ∀ i, I.comap (awayι 𝒜 (f i) (hf i) one_pos) =
      Scheme.IdealSheafData.ofIdealTop
        ((Ideal.span {(HomogeneousLocalization.Away.mk 𝒜 (hf i) d (z : A)
          (by simpa only [smul_eq_mul, mul_one] using z.2))}).map
            (Scheme.ΓSpecIso (.of (HomogeneousLocalization.Away 𝒜 (f i)))).inv.hom)) :
    I = (twistingSheaf.mulHom z).imageIdealSheaf := by
  let 𝒰 : (Proj 𝒜).OpenCover := Scheme.Cover.mkOfCovers (Set.range f)
    (fun g ↦ Spec (.of (HomogeneousLocalization.Away 𝒜 (f g.2.choose))))
    (fun g ↦ awayι 𝒜 (f g.2.choose) (hf g.2.choose) one_pos) fun x ↦ by
      obtain ⟨i, hi⟩ := Opens.mem_iSup.mp (hcover.ge (Set.mem_univ x))
      let g : Set.range f := ⟨f i, Set.mem_range_self i⟩
      have hg : f g.2.choose = f i := g.2.choose_spec
      refine ⟨g, Scheme.Hom.mem_opensRange.mp ?_⟩
      rw [opensRange_awayι 𝒜 (f g.2.choose) (hf g.2.choose) one_pos, hg]
      exact hi
  exact Scheme.IdealSheafData.ext_of_comap_openCover 𝒰 fun g ↦
    (hI g.2.choose).trans (twistingSheaf.imageIdealSheaf_mulHom_comap_awayι z (hf g.2.choose)).symm

/-- For an ideal sheaf `I` cut out on a covering family of degree-one charts by a homogeneous
nonzerodivisor `z ∈ 𝒜 d`, multiplication by `z` induces an isomorphism `I.sheaf ≅ 𝒪(-d)`. -/
def idealSheafIsoTwistingSheafNeg (hz : IsSMulRegular A (z : A))
    (hI : ∀ i, I.comap (awayι 𝒜 (f i) (hf i) one_pos) =
      Scheme.IdealSheafData.ofIdealTop
        ((Ideal.span {(HomogeneousLocalization.Away.mk 𝒜 (hf i) d (z : A)
          (by simpa only [smul_eq_mul, mul_one] using z.2))}).map
            (Scheme.ΓSpecIso (.of (HomogeneousLocalization.Away 𝒜 (f i)))).inv.hom)) :
    I.sheaf ≅ twistingSheaf 𝒜 (-d : ℤ) :=
  have : Mono (twistingSheaf.mulHom z) := twistingSheaf.mono_mulHom_of_isSMulRegular hz
  eqToIso (congrArg Scheme.IdealSheafData.sheaf (eq_imageIdealSheaf_mulHom f hf hcover z hI)) ≪≫
    (twistingSheaf.mulHom z).imageIdealSheafIso.symm

/-- The inverse of `idealSheafIsoTwistingSheafNeg` composed with the ideal inclusion `I ⟶ 𝒪` is
`twistingSheaf.mulHom z`. -/
@[simp, reassoc]
theorem idealSheafIsoTwistingSheafNeg_inv_sheafι (hz : IsSMulRegular A (z : A))
    (hI : ∀ i, I.comap (awayι 𝒜 (f i) (hf i) one_pos) =
      Scheme.IdealSheafData.ofIdealTop
        ((Ideal.span {(HomogeneousLocalization.Away.mk 𝒜 (hf i) d (z : A)
          (by simpa only [smul_eq_mul, mul_one] using z.2))}).map
            (Scheme.ΓSpecIso (.of (HomogeneousLocalization.Away 𝒜 (f i)))).inv.hom)) :
    (idealSheafIsoTwistingSheafNeg f hf hcover hz hI).inv ≫ I.sheafι = twistingSheaf.mulHom z := by
  have : Mono (twistingSheaf.mulHom z) := twistingSheaf.mono_mulHom_of_isSMulRegular hz
  have heq := eq_imageIdealSheaf_mulHom f hf hcover z hI
  subst heq
  simp [idealSheafIsoTwistingSheafNeg]

/-- An ideal sheaf on `Proj A` cut out on a covering family of degree-one charts by a homogeneous
nonzerodivisor `z ∈ 𝒜 d` is an effective Cartier divisor. -/
theorem isEffectiveCartier_of_comap_awayι (hz : IsSMulRegular A (z : A))
    (hI : ∀ i, I.comap (awayι 𝒜 (f i) (hf i) one_pos) =
      Scheme.IdealSheafData.ofIdealTop
        ((Ideal.span {(HomogeneousLocalization.Away.mk 𝒜 (hf i) d (z : A)
          (by simpa only [smul_eq_mul, mul_one] using z.2))}).map
            (Scheme.ΓSpecIso (.of (HomogeneousLocalization.Away 𝒜 (f i)))).inv.hom)) :
    I.IsEffectiveCartier := by
  have : TauCeti.AlgebraicGeometry.SheafOfModules.isInvertible (Proj 𝒜) I.sheaf :=
    (TauCeti.AlgebraicGeometry.SheafOfModules.isInvertible (Proj 𝒜)).prop_of_iso
      (idealSheafIsoTwistingSheafNeg f hf hcover hz hI).symm
      (isInvertible_twistingSheaf_of_cover f hf hcover (-d : ℤ))
  exact I.isEffectiveCartier_of_isInvertible_sheaf

/-- The Picard class of the ideal sheaf `I` cut out by `z ∈ 𝒜 d` is `[𝒪(-d)]`. -/
theorem mk_toInvertibleSheaf_eq_twistingSheaf_neg (hz : IsSMulRegular A (z : A))
    (hI : ∀ i, I.comap (awayι 𝒜 (f i) (hf i) one_pos) =
      Scheme.IdealSheafData.ofIdealTop
        ((Ideal.span {(HomogeneousLocalization.Away.mk 𝒜 (hf i) d (z : A)
          (by simpa only [smul_eq_mul, mul_one] using z.2))}).map
            (Scheme.ΓSpecIso (.of (HomogeneousLocalization.Away 𝒜 (f i)))).inv.hom))
    (hI' : I.IsEffectiveCartier) :
    TauCeti.AlgebraicGeometry.LineBundleClass.mk hI'.toInvertibleSheaf =
      TauCeti.AlgebraicGeometry.LineBundleClass.mk
        ⟨twistingSheaf 𝒜 (-d : ℤ),
          isInvertible_twistingSheaf_of_cover f hf hcover (-d : ℤ)⟩ :=
  TauCeti.AlgebraicGeometry.LineBundleClass.mk_eq_mk_iff.mpr
    ⟨eqToIso hI'.toInvertibleSheaf_obj ≪≫ idealSheafIsoTwistingSheafNeg f hf hcover hz hI⟩

/-- The Picard class of the dual line bundle `𝒪(D)` of an effective Cartier divisor `D` cut out by
`z ∈ 𝒜 d` is `[𝒪(d)]`. -/
theorem mk_dual_toInvertibleSheaf_eq_twistingSheaf (hz : IsSMulRegular A (z : A))
    (hI : ∀ i, I.comap (awayι 𝒜 (f i) (hf i) one_pos) =
      Scheme.IdealSheafData.ofIdealTop
        ((Ideal.span {(HomogeneousLocalization.Away.mk 𝒜 (hf i) d (z : A)
          (by simpa only [smul_eq_mul, mul_one] using z.2))}).map
            (Scheme.ΓSpecIso (.of (HomogeneousLocalization.Away 𝒜 (f i)))).inv.hom))
    (hI' : I.IsEffectiveCartier) :
    TauCeti.AlgebraicGeometry.LineBundleClass.mk hI'.toInvertibleSheaf.dual =
      TauCeti.AlgebraicGeometry.LineBundleClass.mk
        ⟨twistingSheaf 𝒜 (d : ℤ),
          isInvertible_twistingSheaf_of_cover f hf hcover (d : ℤ)⟩ := by
  have hf' : ∀ g : Set.range f, g.1 ∈ 𝒜 1 := fun ⟨_, i, hi⟩ ↦ hi ▸ hf i
  have hcover' := iSup_basicOpen_range_eq_top f hcover
  rw [← TauCeti.AlgebraicGeometry.LineBundleClass.inv_mk,
    mk_toInvertibleSheaf_eq_twistingSheaf_neg f hf hcover hz hI hI',
    lineBundleClass_twistingSheaf_eq_zpow (Subtype.val : Set.range f → A) hf' hcover' (-d : ℤ),
    lineBundleClass_twistingSheaf_eq_zpow (Subtype.val : Set.range f → A) hf' hcover' (d : ℤ),
    zpow_neg, inv_inv]

/-- On a quasi-compact `Proj A` covered by degree-one charts, the dual line bundle `𝒪(D)` of an
effective Cartier divisor cut out by a homogeneous nonzerodivisor of positive degree is ample. -/
theorem isAmple_dual_toInvertibleSheaf [CompactSpace (Proj 𝒜)] {d : ℕ} (hd : 0 < d) {z : 𝒜 d}
    (hz : IsSMulRegular A (z : A)) {I : (Proj 𝒜).IdealSheafData}
    (hI : ∀ i, I.comap (awayι 𝒜 (f i) (hf i) one_pos) =
      Scheme.IdealSheafData.ofIdealTop
        ((Ideal.span {(HomogeneousLocalization.Away.mk 𝒜 (hf i) d (z : A)
          (by simpa only [smul_eq_mul, mul_one] using z.2))}).map
            (Scheme.ΓSpecIso (.of (HomogeneousLocalization.Away 𝒜 (f i)))).inv.hom))
    (hI' : I.IsEffectiveCartier) :
    (TauCeti.AlgebraicGeometry.LineBundleClass.mk hI'.toInvertibleSheaf.dual).IsAmple := by
  rw [mk_dual_toInvertibleSheaf_eq_twistingSheaf f hf hcover hz hI hI']
  exact isAmple_twistingSheaf (Subtype.val : Set.range f → A) (fun ⟨_, i, hi⟩ ↦ hi ▸ hf i)
    (iSup_basicOpen_range_eq_top f hcover) hd

end Divisor

end AlgebraicGeometry.Proj
