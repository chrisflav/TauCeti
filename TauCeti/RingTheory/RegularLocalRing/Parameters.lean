/-!
# Quotients of a regular local ring by part of a regular system of parameters

Let `(R, 𝔪)` be a regular local ring and let `x : ι → R` be a regular system of parameters,
meaning that `x` generates `𝔪` and `|ι| = spanFinrank 𝔪` (equivalently `dim R = |ι|`).
Every entry `x i` lies in `𝔪 \ 𝔪²`, and for any subset `s : Finset ι`, the quotient
`R ⧸ (x i : i ∈ s)` is again a regular local ring of dimension `|ι| - |s|`, with regular system
of parameters given by the images of `x i` for `i ∉ s`.

In particular, quotienting by all but one parameter `y` yields a one-dimensional regular local ring,
hence a discrete valuation ring whose maximal ideal is generated by the image of `y` and for which
the image of `y` is a uniformizer.

## Main results

* `TauCeti.IsLocalRing.notMem_maximalIdeal_sq_of_span_range`: every member of a minimal generating
  family of the maximal ideal of a local ring lies outside `𝔪²`.
* `TauCeti.IsLocalRing.maximalIdeal_quotient_span_image` and
  `TauCeti.IsLocalRing.maximalIdeal_quotient_span_range`: the maximal ideal of the quotient of a
  local ring by a subset of a generating family of `𝔪` is generated by the remaining images.
* `TauCeti.IsRegularLocalRing.quotient_span_image`: the quotient of a regular local ring by a
  subset of a regular system of parameters is a regular local ring.
* `TauCeti.IsRegularLocalRing.spanFinrank_maximalIdeal_quotient_span_image`: its embedding
  dimension is `|ι| - |s|`.
* `TauCeti.IsRegularLocalRing.isDiscreteValuationRing_quotient_span_range` and
  `TauCeti.IsRegularLocalRing.irreducible_mk_quotient_span_range`: quotienting by all parameters
  except `y` produces a discrete valuation ring with uniformizer `y`.

## References

* [Stacks Project, Lemma 10.106.3](https://stacks.math.columbia.edu/tag/00NQ).
-/

public section

open _root_.IsLocalRing Ideal

namespace TauCeti

namespace IsLocalRing

variable {R : Type*} [CommRing R] [_root_.IsLocalRing R]

/-- **Every member of a minimal generating family of `𝔪` lies outside `𝔪²`.** Let `x : ι → R`
generate the maximal ideal `𝔪` of a local ring with `|ι|` equal to the minimal number of
generators of `𝔪`. Then `x i ∉ 𝔪²` for every `i : ι`. -/
theorem notMem_maximalIdeal_sq_of_span_range {ι : Type*} [Fintype ι] {x : ι → R}
    (hx : span (Set.range x) = maximalIdeal R)
    (hrank : (maximalIdeal R).spanFinrank = Fintype.card ι) (i : ι) :
    x i ∉ maximalIdeal R ^ 2 := by
  classical
  let e : ι ≃ Fin (Fintype.card ι) := Fintype.equivFin ι
  have hrange : Set.range (x ∘ e.symm) = Set.range x := by
    ext r
    simp only [Set.mem_range, Function.comp_apply]
    exact ⟨fun ⟨k, hk⟩ ↦ ⟨e.symm k, hk⟩, fun ⟨j, hj⟩ ↦ ⟨e j, by simpa using hj⟩⟩
  intro hsq
  let c : Fin (Fintype.card ι) → R := Pi.single (e i) 1
  have hsum : ∑ k, c k * (x ∘ e.symm) k ∈ maximalIdeal R ^ 2 := by
    simpa [c, Pi.single_apply] using hsq
  have h1 : (1 : R) ∈ maximalIdeal R := by
    simpa [c] using mem_maximalIdeal_of_sum_mul_mem_sq (hrange.symm ▸ hx) hrank hsum (e i)
  exact (maximalIdeal.isMaximal R).ne_top (eq_top_of_isUnit_mem _ h1 isUnit_one)

/-- When `x : ι → R` generates the maximal ideal of a local ring `R`, the maximal ideal of the
quotient `R ⧸ (x i : i ∈ s)` is generated by the images of `x i` for `i ∉ s`. -/
theorem maximalIdeal_quotient_span_image {ι : Type*} {x : ι → R}
    (hx : span (Set.range x) = maximalIdeal R) (s : Set ι)
    [_root_.IsLocalRing (R ⧸ span (x '' s))] :
    maximalIdeal (R ⧸ span (x '' s)) =
      span ((Ideal.Quotient.mk (span (x '' s)) ∘ x) '' sᶜ) := by
  rw [← map_maximalIdeal_of_surjective (Ideal.Quotient.mk (span (x '' s)))
    Ideal.Quotient.mk_surjective, ← hx, Ideal.map_span]
  refine le_antisymm (span_le.mpr ?_) (span_mono ?_)
  · rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
    by_cases hi : i ∈ s
    · have : Ideal.Quotient.mk (span (x '' s)) (x i) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (subset_span ⟨i, hi, rfl⟩)
      rw [this]
      exact zero_mem _
    · exact subset_span ⟨i, hi, rfl⟩
  · rintro _ ⟨i, -, rfl⟩
    exact ⟨x i, ⟨i, rfl⟩, rfl⟩

/-- The maximal ideal of `R ⧸ (x)` is generated by the image of `y` when `{y} ∪ range x` generates
`maximalIdeal R`. -/
theorem maximalIdeal_quotient_span_range {ι : Type*} {x : ι → R} {y : R}
    (hx : span (insert y (Set.range x)) = maximalIdeal R)
    [_root_.IsLocalRing (R ⧸ span (Set.range x))] :
    maximalIdeal (R ⧸ span (Set.range x)) =
      span {Ideal.Quotient.mk (span (Set.range x)) y} := by
  rw [← map_maximalIdeal_of_surjective (Ideal.Quotient.mk (span (Set.range x)))
    Ideal.Quotient.mk_surjective, ← hx, Ideal.map_span]
  refine le_antisymm (span_le.mpr ?_) (span_mono ?_)
  · rintro _ ⟨a, ha, rfl⟩
    rcases Set.mem_insert_iff.mp ha with rfl | ⟨i, rfl⟩
    · exact mem_span_singleton_self _
    · have : Ideal.Quotient.mk (span (Set.range x)) (x i) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (subset_span ⟨i, rfl⟩)
      rw [this]
      exact zero_mem _
  · rintro _ rfl
    exact ⟨y, Set.mem_insert y _, rfl⟩

end IsLocalRing

namespace IsRegularLocalRing

universe u

variable {R : Type u} [CommRing R] [_root_.IsRegularLocalRing R]

/-- Single inductive step for `quotient_span_image_aux`: quotienting `R ⧸ (x '' s)` by the image
of one more regular parameter `x a` (`a ∉ s`) yields a regular local ring of dimension
`(|ι| - |s|) - 1` isomorphic to `R ⧸ (x '' insert a s)`. -/
private theorem quotient_span_image_step {ι : Type*} [Fintype ι] [DecidableEq ι] {x : ι → R}
    (hx : span (Set.range x) = maximalIdeal R) {s : Finset ι} {a : ι} (ha : a ∉ s)
    (hregI : _root_.IsRegularLocalRing (R ⧸ span (x '' (s : Set ι))))
    (hrankI : (maximalIdeal (R ⧸ span (x '' (s : Set ι)))).spanFinrank =
      Fintype.card ι - s.card) :
    let J := span (x '' ((insert a s : Finset ι) : Set ι))
    ∃ _ : _root_.IsRegularLocalRing (R ⧸ J),
      (maximalIdeal (R ⧸ J)).spanFinrank = Fintype.card ι - (insert a s).card := by
  let I := span (x '' (s : Set ι))
  let J := span (x '' ((insert a s : Finset ι) : Set ι))
  have _ : _root_.IsRegularLocalRing (R ⧸ I) := hregI
  have hmaxI : maximalIdeal (R ⧸ I) = span ((Ideal.Quotient.mk I ∘ x) '' (s : Set ι)ᶜ) :=
    IsLocalRing.maximalIdeal_quotient_span_image hx (s : Set ι)
  let y : {i : ι // i ∈ sᶜ} → R ⧸ I := fun i ↦ Ideal.Quotient.mk I (x i.1)
  have hy_span : span (Set.range y) = maximalIdeal (R ⧸ I) := by
    rw [hmaxI]
    congr 1
    ext r
    simp [y]
  have hcard_compl : Fintype.card {i : ι // i ∈ sᶜ} = Fintype.card ι - s.card := by
    rw [Fintype.card_coe, Finset.card_compl]
  have ha_compl : a ∈ sᶜ := Finset.mem_compl.mpr ha
  have hrankI' : (maximalIdeal (R ⧸ I)).spanFinrank = Fintype.card ι - s.card := hrankI
  have ha_not_sq : Ideal.Quotient.mk I (x a) ∉ maximalIdeal (R ⧸ I) ^ 2 :=
    IsLocalRing.notMem_maximalIdeal_sq_of_span_range hy_span (hrankI'.trans hcard_compl.symm)
      ⟨a, ha_compl⟩
  have ha_mem : Ideal.Quotient.mk I (x a) ∈ maximalIdeal (R ⧸ I) :=
    hy_span ▸ subset_span ⟨⟨a, ha_compl⟩, rfl⟩
  have ha_ne : Ideal.Quotient.mk I (x a) ≠ 0 := fun h0 ↦ ha_not_sq (h0 ▸ zero_mem _)
  have hreg_step : _root_.IsRegularLocalRing ((R ⧸ I) ⧸ span {Ideal.Quotient.mk I (x a)}) :=
    quotient_span_singleton ha_mem ha_not_sq
  have hdrop : (maximalIdeal ((R ⧸ I) ⧸ span {Ideal.Quotient.mk I (x a)})).spanFinrank + 1 =
      (maximalIdeal (R ⧸ I)).spanFinrank :=
    spanFinrank_maximalIdeal_quotient_span_singleton_add_one ha_ne
  have hIJ : I ≤ J := span_mono (Set.image_mono (by simp))
  have hJmap : J.map (Ideal.Quotient.mk I) = span {Ideal.Quotient.mk I (x a)} := by
    rw [Ideal.map_span]
    refine le_antisymm (span_le.mpr ?_) ((span_singleton_le_iff_mem _).mpr ?_)
    · rintro _ ⟨_, ⟨i, hi, rfl⟩, rfl⟩
      rcases Finset.mem_insert.mp hi with rfl | his
      · exact mem_span_singleton_self _
      · have : Ideal.Quotient.mk I (x i) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (subset_span ⟨i, his, rfl⟩)
        rw [this]
        exact zero_mem _
    · exact subset_span ⟨x a, ⟨a, Finset.mem_insert_self a s, rfl⟩, rfl⟩
  let e : ((R ⧸ I) ⧸ span {Ideal.Quotient.mk I (x a)}) ≃+* (R ⧸ J) :=
    (Ideal.quotientEquivAlgOfEq (R ⧸ I) hJmap.symm).toRingEquiv.trans
      (DoubleQuot.quotQuotEquivQuotOfLE hIJ)
  have hregJ : _root_.IsRegularLocalRing (R ⧸ J) := .of_ringEquiv e
  refine ⟨hregJ, ?_⟩
  have hdim := ringKrullDim_eq_of_ringEquiv e
  have h1 := _root_.IsRegularLocalRing.spanFinrank_maximalIdeal
    (R := (R ⧸ I) ⧸ span {Ideal.Quotient.mk I (x a)})
  have h2 := _root_.IsRegularLocalRing.spanFinrank_maximalIdeal (R := R ⧸ J)
  have heq : (maximalIdeal ((R ⧸ I) ⧸ span {Ideal.Quotient.mk I (x a)})).spanFinrank =
      (maximalIdeal (R ⧸ J)).spanFinrank := by
    exact_mod_cast h1.trans (hdim.trans h2.symm)
  have hle : s.card < Fintype.card ι := by
    have hss : s ⊂ Finset.univ :=
      Finset.ssubset_univ_iff.mpr fun h ↦ ha (h.symm ▸ Finset.mem_univ a)
    simpa using Finset.card_lt_card hss
  rw [Finset.card_insert_of_notMem ha, ← heq]
  omega

/-- Induction simultaneously establishing regularity and embedding dimension for the quotient by
any subset `s` of a regular system of parameters. -/
private theorem quotient_span_image_aux {ι : Type*} [Fintype ι] {x : ι → R}
    (hx : span (Set.range x) = maximalIdeal R)
    (hrank : (maximalIdeal R).spanFinrank = Fintype.card ι) (s : Finset ι) :
    let I := span (x '' (s : Set ι))
    ∃ _ : _root_.IsRegularLocalRing (R ⧸ I),
      (maximalIdeal (R ⧸ I)).spanFinrank = Fintype.card ι - s.card := by
  classical
  induction s using Finset.induction with
  | empty =>
    have hbot : span (x '' ((∅ : Finset ι) : Set ι)) = ⊥ := by simp
    let e : (R ⧸ span (x '' ((∅ : Finset ι) : Set ι))) ≃+* R :=
      (Ideal.quotientEquivAlgOfEq R hbot).toRingEquiv.trans (RingEquiv.quotientBot R)
    have hreg : _root_.IsRegularLocalRing (R ⧸ span (x '' ((∅ : Finset ι) : Set ι))) :=
      .of_ringEquiv e.symm
    refine ⟨hreg, ?_⟩
    rw [Finset.card_empty, Nat.sub_zero, ← hrank]
    have hdim := ringKrullDim_eq_of_ringEquiv e
    have h1 := _root_.IsRegularLocalRing.spanFinrank_maximalIdeal
      (R := R ⧸ span (x '' ((∅ : Finset ι) : Set ι)))
    have h2 := _root_.IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)
    exact_mod_cast h1.trans (hdim.trans h2.symm)
  | @insert a s ha ih =>
    obtain ⟨hregI, hrankI⟩ := ih
    exact quotient_span_image_step hx ha hregI hrankI

/-- **Quotienting a regular local ring by a subset of a regular system of parameters produces a
regular local ring.** -/
@[stacks 00NQ]
theorem quotient_span_image {ι : Type*} [Fintype ι] {x : ι → R}
    (hx : span (Set.range x) = maximalIdeal R)
    (hrank : (maximalIdeal R).spanFinrank = Fintype.card ι) (s : Finset ι) :
    _root_.IsRegularLocalRing (R ⧸ span (x '' (s : Set ι))) :=
  (quotient_span_image_aux hx hrank s).1

/-- The maximal ideal of `R ⧸ (x i : i ∈ s)` has minimal number of generators `|ι| - |s|`. -/
theorem spanFinrank_maximalIdeal_quotient_span_image {ι : Type*} [Fintype ι] {x : ι → R}
    (hx : span (Set.range x) = maximalIdeal R)
    (hrank : (maximalIdeal R).spanFinrank = Fintype.card ι) (s : Finset ι)
    [_root_.IsLocalRing (R ⧸ span (x '' (s : Set ι)))] :
    (maximalIdeal (R ⧸ span (x '' (s : Set ι)))).spanFinrank = Fintype.card ι - s.card := by
  obtain ⟨_, hsf⟩ := quotient_span_image_aux hx hrank s
  exact hsf

/-- Helper reindexing `{y} ∪ range x` as a family on `Option ι`. -/
private lemma option_param_setup {ι : Type*} [Fintype ι] [DecidableEq ι] {x : ι → R} {y : R}
    (hx : span (insert y (Set.range x)) = maximalIdeal R)
    (hrank : (maximalIdeal R).spanFinrank = Fintype.card ι + 1) :
    let f : Option ι → R := Option.elim' y x
    let s : Finset (Option ι) := Finset.univ.image some
    span (Set.range f) = maximalIdeal R ∧
      (maximalIdeal R).spanFinrank = Fintype.card (Option ι) ∧
      f '' (s : Set (Option ι)) = Set.range x ∧
      s.card = Fintype.card ι := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [← hx]
    congr 1
    ext r
    simp only [Set.mem_range, Option.exists, Option.elim'_none, Option.elim'_some,
      Set.mem_insert_iff]
    tauto
  · simpa [Fintype.card_option] using hrank
  · ext r
    simp
  · rw [Finset.card_image_of_injective _ (Option.some_injective ι), Finset.card_univ]

/-- **Quotienting a regular local ring by `n` of `n + 1` regular parameters yields a regular local
ring.** -/
theorem quotient_span_range {ι : Type*} [Fintype ι] {x : ι → R} {y : R}
    (hx : span (insert y (Set.range x)) = maximalIdeal R)
    (hrank : (maximalIdeal R).spanFinrank = Fintype.card ι + 1) :
    _root_.IsRegularLocalRing (R ⧸ span (Set.range x)) := by
  classical
  obtain ⟨h1, h2, h3, -⟩ := option_param_setup hx hrank
  rw [← h3]
  exact quotient_span_image h1 h2 (Finset.univ.image some)

/-- **Quotienting a regular local ring by `n` of `n + 1` regular parameters yields a discrete
valuation ring.** -/
theorem isDiscreteValuationRing_quotient_span_range {ι : Type*} [Fintype ι] {x : ι → R} {y : R}
    (hx : span (insert y (Set.range x)) = maximalIdeal R)
    (hrank : (maximalIdeal R).spanFinrank = Fintype.card ι + 1)
    [IsDomain (R ⧸ span (Set.range x))] :
    IsDiscreteValuationRing (R ⧸ span (Set.range x)) := by
  classical
  have := quotient_span_range hx hrank
  obtain ⟨h1, h2, h3, h4⟩ := option_param_setup hx hrank
  let s : Finset (Option ι) := Finset.univ.image some
  have hreg' := quotient_span_image h1 h2 s
  have hsf := spanFinrank_maximalIdeal_quotient_span_image h1 h2 s
  simp only [Fintype.card_option, s, h4, Nat.add_sub_cancel_left] at hsf
  have hsf' : (maximalIdeal (R ⧸ span (Set.range x))).spanFinrank = 1 := by
    let e := (Ideal.quotientEquivAlgOfEq R (congrArg span h3)).toRingEquiv
    have hdim := ringKrullDim_eq_of_ringEquiv e
    have ha := _root_.IsRegularLocalRing.spanFinrank_maximalIdeal
      (R := R ⧸ span (Option.elim' y x '' (s : Set (Option ι))))
    have hb := _root_.IsRegularLocalRing.spanFinrank_maximalIdeal (R := R ⧸ span (Set.range x))
    exact_mod_cast (hb.trans (hdim.symm.trans ha.symm)).trans (congrArg Nat.cast hsf)
  refine isDiscreteValuationRing_iff_ringKrullDim_eq_one.mpr ?_
  rw [← _root_.IsRegularLocalRing.spanFinrank_maximalIdeal, hsf']
  rfl

/-- The image of `y` in the discrete valuation ring `R ⧸ (x)` is irreducible (a uniformizer). -/
theorem irreducible_mk_quotient_span_range {ι : Type*} [Fintype ι] {x : ι → R} {y : R}
    (hx : span (insert y (Set.range x)) = maximalIdeal R)
    (hrank : (maximalIdeal R).spanFinrank = Fintype.card ι + 1) :
    Irreducible (Ideal.Quotient.mk (span (Set.range x)) y) := by
  have := quotient_span_range hx hrank
  have := isDiscreteValuationRing_quotient_span_range hx hrank
  exact (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mpr
    (IsLocalRing.maximalIdeal_quotient_span_range hx)

end IsRegularLocalRing

end TauCeti
