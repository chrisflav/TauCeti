/-!
# Explicit small Jacobian-open models of number fields

A number field `K` has a bounded Jacobian-open model in `r` variables, degree `d`, and height
`H` (`TauCeti.NumberField.HasBoundedModel K r d H`) when there exist algebraic integers
`κ : Fin r → 𝓞 K` generating `K` over `ℚ` and `r` integer polynomials
`E : Fin r → MvPolynomial (Fin r) ℤ` of total degree at most `d` and coefficients bounded in
absolute value by `H` that vanish at `κ` with `TauCeti.jacobian E` nonzero at `κ`, together with
a surjective `ℚ`-algebra homomorphism from
`TauCeti.JacobianOpenAlgebra (fun i ↦ (E i).map (Int.castRingHom ℚ))` to `K` compatible with
polynomial evaluation at `κ`.

By `TauCeti.JacobianOpenAlgebra.etale`, that Jacobian-open algebra is étale over `ℚ` for every
square system `E`, hence a finite product of finite separable field extensions
(`Algebra.Etale.iff_exists_algEquiv_prod`). Any compatible surjection `φ` onto `K` has kernel
generated by an idempotent (`TauCeti.Algebra.Etale.exists_isIdempotentElem_ker_eq_span`), so it
exhibits `Spec K` as an open and closed field component of `Spec (JacobianOpenAlgebra ...)`, and
is uniquely determined by polynomial evaluation at `κ` (`TauCeti.JacobianOpenAlgebra.eq_lift_iff`).

## Main definitions

* `TauCeti.NumberField.HasBoundedModel`: existence of an integral generating point `κ`, bounded
  integer equations `E` vanishing at `κ` with nonzero Jacobian determinant at `κ`, and a
  compatible surjection from the étale Jacobian-open algebra to `K`.
* `TauCeti.NumberField.explicitCoefficientBound`: Couveignes's explicit coefficient bound
  `ℓ ^ (ℓ / (2 * n)) * √M * (n ^ 2 * d * (r + 1)) ^ d * δ ^ (2 * d)`, where
  `M = (d + r choose d)` and `ℓ = M - n`.

## Main results

* `TauCeti.NumberField.hasBoundedModel_of_aeval_zero`: extending rational evaluation at a square
  system zero with nonzero Jacobian to the compatible surjection of `HasBoundedModel`.
* `TauCeti.NumberField.HasBoundedModel.mono`,
  `TauCeti.NumberField.HasBoundedModel.algEquiv`: monotonicity in the degree and height bounds,
  and invariance under `ℚ`-algebra equivalence.
* `TauCeti.NumberField.HasBoundedModel.exists_mem_coefficientBox_surjective`: a bounded
  model places `E` in `TauCeti.MvPolynomial.coefficientBox (Fin r) (Fin r) d ⌊H⌋₊` and
  realizes `K` as an idempotent quotient of `TauCeti.JacobianOpenAlgebra`.
* `TauCeti.NumberField.hasBoundedModel_rat`: `HasBoundedModel ℚ r d H` holds for `1 ≤ d` and
  `1 ≤ H`.
* `TauCeti.NumberField.hasBoundedModel_of_wellPoised`,
  `TauCeti.NumberField.hasBoundedModel_explicitCoefficientBound_of_wellPoised`: building a
  bounded model from a tuple whose complex conjugate points are well poised in degree `d`.

## References

* J.-M. Couveignes, *Enumerating number fields*, Ann. of Math. 192 (2020), 487–497, §3,
  Proposition 2, pp. 494–495.
-/

public section

open Module MvPolynomial NumberField

namespace TauCeti.NumberField

private theorem aeval_map_intCastRingHom {A σ : Type*} [CommRing A] [Algebra ℚ A]
    (x : σ → A) (p : MvPolynomial σ ℤ) :
    aeval x (p.map (Int.castRingHom ℚ)) = aeval x p :=
  (map_aeval_eq_aeval_map (Int.castRingHom ℚ) (RingHom.id A) (Subsingleton.elim _ _) p x).symm

/-- A number field `K` has an `(r, d, H)` bounded Jacobian-open model if some `r`-tuple of
algebraic integers `κ` generates `K` over `ℚ` and satisfies `r` integer equations `E` of total
degree at most `d` and coefficient moduli at most `H` with nonzero Jacobian at `κ`, accompanied by
a surjective `ℚ`-algebra homomorphism from the étale Jacobian-open algebra of `E` onto `K`
agreeing with evaluation at `κ`. -/
def HasBoundedModel (K : Type*) [Field K] [NumberField K] (r d : ℕ) (H : ℝ) : Prop :=
  ∃ (κ : Fin r → 𝓞 K) (E : Fin r → MvPolynomial (Fin r) ℤ),
    (∀ i, (E i).totalDegree ≤ d) ∧
    (∀ i s, |((E i).coeff s : ℝ)| ≤ H) ∧
    (∀ i, aeval (fun j ↦ (κ j : K)) (E i) = 0) ∧
    Function.Surjective (aeval (fun j ↦ (κ j : K)) : MvPolynomial (Fin r) ℚ →ₐ[ℚ] K) ∧
    aeval (fun j ↦ (κ j : K)) (TauCeti.jacobian E) ≠ 0 ∧
    ∃ φ : TauCeti.JacobianOpenAlgebra (fun i ↦ (E i).map (Int.castRingHom ℚ)) →ₐ[ℚ] K,
      Function.Surjective φ ∧
      ∀ f : MvPolynomial (Fin r) ℚ,
        φ (TauCeti.JacobianOpenAlgebra.ofMvPolynomial _ f) = aeval (fun j ↦ (κ j : K)) f

/-- **Arithmetic component map.** Any integral tuple `κ` generating `K` over `ℚ` and satisfying a
square integer system `E` of degree `≤ d` and coefficient height `≤ H` with nonzero Jacobian at
`κ` yields `HasBoundedModel K r d H`, via `TauCeti.JacobianOpenAlgebra.lift`. -/
theorem hasBoundedModel_of_aeval_zero {K : Type*} [Field K] [NumberField K]
    {r d : ℕ} {H : ℝ} (κ : Fin r → 𝓞 K) (E : Fin r → MvPolynomial (Fin r) ℤ)
    (hdeg : ∀ i, (E i).totalDegree ≤ d)
    (hcoeff : ∀ i s, |((E i).coeff s : ℝ)| ≤ H)
    (hzero : ∀ i, aeval (fun j ↦ (κ j : K)) (E i) = 0)
    (hsurj : Function.Surjective
      (aeval (fun j ↦ (κ j : K)) : MvPolynomial (Fin r) ℚ →ₐ[ℚ] K))
    (hJ : aeval (fun j ↦ (κ j : K)) (TauCeti.jacobian E) ≠ 0) :
    HasBoundedModel K r d H := by
  let Eℚ : Fin r → MvPolynomial (Fin r) ℚ := fun i ↦ (E i).map (Int.castRingHom ℚ)
  have hzeroℚ (i : Fin r) : aeval (fun j ↦ (κ j : K)) (Eℚ i) = 0 := by
    rw [aeval_map_intCastRingHom, hzero i]
  have hJℚ : IsUnit (aeval (fun j ↦ (κ j : K)) (TauCeti.jacobian Eℚ)) := by
    rw [← TauCeti.map_jacobian, aeval_map_intCastRingHom]
    exact IsUnit.mk0 _ hJ
  refine ⟨κ, E, hdeg, hcoeff, hzero, hsurj, hJ,
    TauCeti.JacobianOpenAlgebra.lift (fun j ↦ (κ j : K)) hzeroℚ hJℚ,
    TauCeti.JacobianOpenAlgebra.lift_surjective _ hzeroℚ hJℚ hsurj,
    TauCeti.JacobianOpenAlgebra.lift_ofMvPolynomial _ hzeroℚ hJℚ⟩

/-- Raising the degree bound and the coefficient bound preserves `HasBoundedModel`. -/
theorem HasBoundedModel.mono {K : Type*} [Field K] [NumberField K] {r d d' : ℕ} {H H' : ℝ}
    (h : HasBoundedModel K r d H) (hd : d ≤ d') (hH : H ≤ H') :
    HasBoundedModel K r d' H' := by
  obtain ⟨κ, E, hdeg, hcoeff, hzero, hsurj, hJ, φ, hφ_surj, hφ_compat⟩ := h
  exact ⟨κ, E, fun i ↦ (hdeg i).trans hd, fun i s ↦ (hcoeff i s).trans hH,
    hzero, hsurj, hJ, φ, hφ_surj, hφ_compat⟩

/-- A `ℚ`-algebra equivalence of number fields transports bounded Jacobian-open models. -/
theorem HasBoundedModel.algEquiv {K K' : Type*} [Field K] [NumberField K] [Field K']
    [NumberField K'] {r d : ℕ} {H : ℝ} (h : HasBoundedModel K r d H) (e : K ≃ₐ[ℚ] K') :
    HasBoundedModel K' r d H := by
  obtain ⟨κ, E, hdeg, hcoeff, hzero, hsurj, hJ, φ, hφ_surj, hφ_compat⟩ := h
  let κ' : Fin r → 𝓞 K' := fun j ↦ RingOfIntegers.mapRingEquiv e.toRingEquiv (κ j)
  have hκ' (j : Fin r) : (κ' j : K') = e (κ j : K) := rfl
  have haeval (p : MvPolynomial (Fin r) ℚ) :
      aeval (fun j ↦ (κ' j : K')) p = e (aeval (fun j ↦ (κ j : K)) p) := by
    have hcomp : e.toAlgHom.comp (aeval fun j ↦ (κ j : K)) = aeval fun j ↦ (κ' j : K') :=
      MvPolynomial.algHom_ext fun j ↦ by simp [hκ']
    exact (AlgHom.congr_fun hcomp p).symm
  have haevalℤ (p : MvPolynomial (Fin r) ℤ) :
      aeval (fun j ↦ (κ' j : K')) p = e (aeval (fun j ↦ (κ j : K)) p) := by
    rw [← aeval_map_intCastRingHom (fun j ↦ (κ' j : K')),
      ← aeval_map_intCastRingHom (fun j ↦ (κ j : K)), haeval]
  refine ⟨κ', E, hdeg, hcoeff, fun i ↦ ?_, ?_, ?_, e.toAlgHom.comp φ,
    e.surjective.comp hφ_surj, fun f ↦ ?_⟩
  · rw [haevalℤ, hzero i, map_zero]
  · intro y
    obtain ⟨f, hf⟩ := hsurj (e.symm y)
    exact ⟨f, by rw [haeval, hf, e.apply_symm_apply]⟩
  · rw [haevalℤ, map_ne_zero_iff e (AlgEquiv.injective e)]
    exact hJ
  · simp [haeval, hφ_compat]

/-- Every bounded model places its equations in `TauCeti.MvPolynomial.coefficientBox` of bound
`⌊H⌋₊` and realizes `K` as an idempotent quotient of the étale algebra
`TauCeti.JacobianOpenAlgebra`. -/
theorem HasBoundedModel.exists_mem_coefficientBox_surjective {K : Type*} [Field K] [NumberField K]
    {r d : ℕ} {H : ℝ} (h : HasBoundedModel K r d H) :
    ∃ E ∈ TauCeti.MvPolynomial.coefficientBox (Fin r) (Fin r) d ⌊H⌋₊,
      ∃ φ : TauCeti.JacobianOpenAlgebra
          (fun i ↦ (E i).map (Int.castRingHom ℚ)) →ₐ[ℚ] K,
        Function.Surjective φ ∧
        ∃ e : TauCeti.JacobianOpenAlgebra
            (fun i ↦ (E i).map (Int.castRingHom ℚ)),
          IsIdempotentElem e ∧ RingHom.ker φ = Ideal.span {e} := by
  obtain ⟨κ, E, hdeg, hcoeff, -, -, -, φ, hφ_surj, -⟩ := h
  have hE : E ∈ TauCeti.MvPolynomial.coefficientBox (Fin r) (Fin r) d ⌊H⌋₊ := by
    rw [TauCeti.MvPolynomial.mem_coefficientBox]
    intro i
    refine ⟨hdeg i, fun s ↦ ?_⟩
    have hH : 0 ≤ H := (abs_nonneg _).trans (hcoeff i s)
    rw [Int.abs_eq_natAbs, Nat.cast_le, Nat.le_floor_iff hH]
    simpa [Int.cast_abs] using hcoeff i s
  have : Algebra.Etale ℚ K := Algebra.Etale.of_isSeparable ℚ K
  obtain ⟨e, he, hker⟩ := TauCeti.Algebra.Etale.exists_isIdempotentElem_ker_eq_span φ hφ_surj
  exact ⟨E, hE, φ, hφ_surj, e, he, hker⟩

/-- Over `ℚ`, the linear system `E i = X i` at `κ = 0` witnesses `HasBoundedModel ℚ r d H` for
all `1 ≤ d` and `1 ≤ H`. -/
theorem hasBoundedModel_rat {r d : ℕ} (hd : 1 ≤ d) {H : ℝ} (hH : 1 ≤ H) :
    HasBoundedModel ℚ r d H := by
  let κ : Fin r → 𝓞 ℚ := fun _ ↦ 0
  let E : Fin r → MvPolynomial (Fin r) ℤ := fun i ↦ X i
  have hdeg (i : Fin r) : (E i).totalDegree ≤ d := by
    simpa [E, totalDegree_X] using hd
  have hcoeff (i : Fin r) (s : Fin r →₀ ℕ) : |((E i).coeff s : ℝ)| ≤ H := by
    by_cases h : Finsupp.single i 1 = s
    · simpa [E, coeff_X, h] using hH
    · simpa [E, coeff_X, h] using zero_le_one.trans hH
  have hzero (i : Fin r) : aeval (fun j ↦ (κ j : ℚ)) (E i) = 0 := by
    simp [E, κ]
  have hsurj : Function.Surjective
      (aeval (fun j ↦ (κ j : ℚ)) : MvPolynomial (Fin r) ℚ →ₐ[ℚ] ℚ) :=
    fun q ↦ ⟨C q, by simp⟩
  have hjac : TauCeti.jacobian E = 1 := by
    rw [TauCeti.jacobian_eq_det]
    have hmat : (Matrix.of fun i j : Fin r ↦ pderiv j (E i)) = 1 := by
      ext i j
      simp [E, pderiv_X, Pi.single_apply, Matrix.one_apply]
    rw [hmat, Matrix.det_one]
  exact hasBoundedModel_of_aeval_zero κ E hdeg hcoeff hzero hsurj (by simp [hjac])

/-- Couveignes's explicit coefficient bound `ℓ ^ (ℓ / (2 * n)) * √M *
(n ^ 2 * d * (r + 1)) ^ d * δ ^ (2 * d)`, where `M = (d + r choose d)` and `ℓ = M - n`. -/
noncomputable def explicitCoefficientBound (n r d : ℕ) (δ : ℝ) : ℝ :=
  let M := (d + r).choose d
  let ℓ := M - n
  (ℓ : ℝ) ^ ((ℓ : ℝ) / (2 * (n : ℝ))) * √(M : ℝ) *
    ((n : ℝ) ^ 2 * d * (r + 1)) ^ d * δ ^ (2 * d)

/-- The explicit coefficient bound is nonnegative for every `n`, `r`, `d`, and `δ`. -/
theorem explicitCoefficientBound_nonneg (n r d : ℕ) (δ : ℝ) :
    0 ≤ explicitCoefficientBound n r d δ := by
  dsimp [explicitCoefficientBound]
  have hsq : 0 ≤ δ ^ (2 * d) := by
    rw [mul_comm, pow_mul]
    positivity
  exact mul_nonneg (by positivity) hsq

/-- The explicit coefficient bound is strictly positive whenever `0 < n` and `δ ≠ 0`. -/
theorem explicitCoefficientBound_pos {n : ℕ} (r d : ℕ) {δ : ℝ} (hn : 0 < n)
    (hδ : δ ≠ 0) :
    0 < explicitCoefficientBound n r d δ := by
  dsimp [explicitCoefficientBound]
  set M := (d + r).choose d
  set ℓ := M - n
  have hM : 0 < M := Nat.choose_pos (Nat.le_add_right d r)
  have hl : 0 < (ℓ : ℝ) ^ ((ℓ : ℝ) / (2 * (n : ℝ))) := by
    rcases eq_or_ne ℓ 0 with h0 | hpos
    · simp [h0]
    · exact Real.rpow_pos_of_pos (Nat.cast_pos.2 (Nat.pos_of_ne_zero hpos)) _
  have hpow : 0 < ((n : ℝ) ^ 2 * d * (r + 1)) ^ d := by
    rcases eq_or_ne d 0 with rfl | hd
    · simp
    · have : 0 < d := Nat.pos_of_ne_zero hd
      positivity
  have hδp : 0 < δ ^ (2 * d) := by
    rw [mul_comm, pow_mul]
    exact sq_pos_iff.mpr (pow_ne_zero d hδ)
  positivity

/-- If the complex conjugates of an integral tuple `κ : Fin r → 𝓞 K` are well poised in degree
`d` and every `κ j` has house at most `C₀ ≥ 1`, then `K` has a bounded Jacobian-open model of
degree `d` and coefficient bound `ℓ ^ (ℓ / (2 * n)) * √M * C₀ ^ d`. -/
theorem hasBoundedModel_of_wellPoised {K : Type*} [Field K] [NumberField K]
    {r d : ℕ} (κ : Fin r → 𝓞 K)
    (hWP : WellPoised (fun (τ : K →+* ℂ) j ↦ τ (κ j : K)) d)
    {C₀ : ℝ} (hC₀ : 1 ≤ C₀) (hκ : ∀ j, house (κ j : K) ≤ C₀) :
    let M := (d + r).choose d
    let n := finrank ℚ K
    let ℓ := M - n
    HasBoundedModel K r d
      ((ℓ : ℝ) ^ ((ℓ : ℝ) / (2 * (n : ℝ))) * √(M : ℝ) * C₀ ^ d) := by
  have hch : (d + Fintype.card (Fin r)).choose (Fintype.card (Fin r)) = (d + r).choose d := by
    rw [Fintype.card_fin, Nat.choose_symm_add]
  obtain ⟨E, hdeg, hcoeff, hzero, hJ⟩ :=
    exists_jacobian_ne_zero_equations_of_wellPoised κ d hWP hC₀ hκ
  have hval :
      Function.Surjective (firstJetValueMap (fun (τ : K →+* ℂ) j ↦ τ (κ j : K)) d) :=
    (firstJetMap_surjective_iff.1 (wellPoised_iff.1 hWP)).1
  have hsurj : Function.Surjective
      (aeval (fun j ↦ (κ j : K)) : MvPolynomial (Fin r) ℚ →ₐ[ℚ] K) :=
    aeval_surjective_of_firstJetValueMap_surjective hval
  rw [hch] at hcoeff
  exact hasBoundedModel_of_aeval_zero κ E hdeg hcoeff hzero hsurj hJ

/-- Specializing `TauCeti.NumberField.hasBoundedModel_of_wellPoised` to Couveignes's house bound
`n ^ 2 * d * (r + 1) * (rootDiscr K) ^ 2` gives `HasBoundedModel` with coefficient bound
`TauCeti.NumberField.explicitCoefficientBound (finrank ℚ K) r d (rootDiscr K)`. -/
theorem hasBoundedModel_explicitCoefficientBound_of_wellPoised
    {K : Type*} [Field K] [NumberField K] {r d : ℕ} (κ : Fin r → 𝓞 K)
    (hWP : WellPoised (fun (τ : K →+* ℂ) j ↦ τ (κ j : K)) d)
    (hκ : ∀ j, house (κ j : K) ≤
      (finrank ℚ K : ℝ) ^ 2 * d * (r + 1) * rootDiscr K ^ 2) :
    HasBoundedModel K r d
      (explicitCoefficientBound (finrank ℚ K) r d (rootDiscr K)) := by
  rcases eq_or_ne r 0 with rfl | hr0
  · have hval :
        Function.Surjective (firstJetValueMap (fun (τ : K →+* ℂ) j ↦ τ (κ j : K)) d) :=
      (firstJetMap_surjective_iff.1 (wellPoised_iff.1 hWP)).1
    have hsurj : Function.Surjective
        (aeval (fun j ↦ (κ j : K)) : MvPolynomial (Fin 0) ℚ →ₐ[ℚ] K) :=
      aeval_surjective_of_firstJetValueMap_surjective hval
    refine hasBoundedModel_of_aeval_zero κ (fun i ↦ i.elim0) (fun i ↦ i.elim0)
      (fun i ↦ i.elim0) (fun i ↦ i.elim0) hsurj ?_
    rw [TauCeti.jacobian_eq_det, Matrix.det_isEmpty, map_one]
    exact one_ne_zero
  · have : Nonempty (Fin r) := Fin.pos_iff_nonempty.mp (Nat.pos_of_ne_zero hr0)
    have hd0 : d ≠ 0 := fun h0 ↦
      not_wellPoised_zero (fun (τ : K →+* ℂ) j ↦ τ (κ j : K)) (h0 ▸ hWP)
    have hd1 : (1 : ℝ) ≤ d := by exact_mod_cast Nat.pos_of_ne_zero hd0
    have hn1 : (1 : ℝ) ≤ finrank ℚ K := by exact_mod_cast (finrank_pos : 0 < finrank ℚ K)
    have hdiscr1 : (1 : ℝ) ≤ ((|discr K| : ℤ) : ℝ) := by
      simpa using Int.cast_le (R := ℝ).mpr (Int.one_le_abs (discr_ne_zero K))
    have hδ : 1 ≤ rootDiscr K := by
      rw [rootDiscr_def]
      exact Real.one_le_rpow hdiscr1 (by positivity)
    set C₀ : ℝ := (finrank ℚ K : ℝ) ^ 2 * d * (r + 1) * rootDiscr K ^ 2
    have hC₀ : 1 ≤ C₀ := by
      have h1 : 1 ≤ (finrank ℚ K : ℝ) ^ 2 := one_le_pow₀ hn1
      have h2 : 1 ≤ (r : ℝ) + 1 := by linarith [Nat.cast_nonneg (α := ℝ) r]
      have h3 : 1 ≤ rootDiscr K ^ 2 := one_le_pow₀ hδ
      exact one_le_mul_of_one_le_of_one_le
        (one_le_mul_of_one_le_of_one_le (one_le_mul_of_one_le_of_one_le h1 hd1) h2) h3
    have hmodel := hasBoundedModel_of_wellPoised κ hWP hC₀ hκ
    have hC₀_pow : C₀ ^ d =
        ((finrank ℚ K : ℝ) ^ 2 * d * (r + 1)) ^ d * rootDiscr K ^ (2 * d) := by
      rw [show C₀ ^ d = ((finrank ℚ K : ℝ) ^ 2 * d * (r + 1)) ^ d * (rootDiscr K ^ 2) ^ d from
        mul_pow _ _ d, ← pow_mul]
    simpa only [explicitCoefficientBound, hC₀_pow, mul_assoc] using hmodel

end TauCeti.NumberField
