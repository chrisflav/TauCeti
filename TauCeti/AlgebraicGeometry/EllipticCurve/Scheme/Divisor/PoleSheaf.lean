module

public import TauCeti.AlgebraicGeometry.EffectiveCartierDivisor.Pullback
public import TauCeti.AlgebraicGeometry.EllipticCurve.Scheme.Divisor.Basic
public import TauCeti.AlgebraicGeometry.LineBundle.RelativelyAmple
public import TauCeti.AlgebraicGeometry.ProjectiveSpectrum.TwistingSheaf.Divisor
import TauCeti.AlgebraicGeometry.EllipticCurve.Projective.Prime
import TauCeti.AlgebraicGeometry.IdealSheaf.OfIdealTop

/-!
# Pole sheaves on the projective Weierstrass model

Let `W` be a Weierstrass curve over a commutative ring `R`, with projective model
`projModel W = Proj (R[X, Y, Z] ⧸ (W))` over `Spec R`.

With **no ellipticity hypothesis** on `W`, the divisor `3[0]` (`W.zeroSectionDivisor ^ 3`) is the
hyperplane section `Z = 0`: on each degree-one chart `D₊(Xᵢ)` its ideal is generated by `Z / Xᵢ`,
and the homogeneous coordinate `Z` (`W.toProjective.coord 2`) is a nonzerodivisor of degree one in
the homogeneous coordinate ring. By `AlgebraicGeometry.Proj.isEffectiveCartier_of_comap_awayι`,
`3[0]` is an effective Cartier divisor on `projModel W` whose ideal sheaf is isomorphic to the
twisting sheaf `𝒪(-1)`. Its dual invertible sheaf `WeierstrassCurve.cubicPoleSheaf` (`𝒪(3[0])`)
therefore represents the hyperplane class `[𝒪(1)]` in the Picard group, is ample and relatively
ample over `Spec R`, and commutes with arbitrary ring base change `f : R →+* R'`.

When `W` is elliptic (`[W.IsElliptic]`), every nonnegative multiple `n[0]` is a relative effective
Cartier divisor, giving the family of pole sheaves `WeierstrassCurve.poleSheaf W n` (`𝒪(n[0])`).
Their Picard classes satisfy `[𝒪(0[0])] = 1`, `[𝒪((m + n)[0])] = [𝒪(m[0])] * [𝒪(n[0])]`, and
`[𝒪(n[0])] = [𝒪([0])] ^ n`, with `W.poleSheaf 3 = W.cubicPoleSheaf`, commute with arbitrary base
change, and are ample and relatively ample over `Spec R` for every `0 < n` (descending ampleness
from `3[0]` to `[0]` via `LineBundleClass.IsAmple.of_pow` and back to `n[0]` via
`LineBundleClass.IsAmple.pow`).

## Main definitions

* `WeierstrassCurve.zeroSectionDivisorPowThreeSheafIso`: the isomorphism
  `(W.zeroSectionDivisor ^ 3).sheaf ≅ 𝒪(-1)` on `projModel W`, with no ellipticity hypothesis.
* `WeierstrassCurve.cubicPoleSheaf`: the invertible sheaf `𝒪(3[0])` on `projModel W`, with no
  ellipticity hypothesis.
* `WeierstrassCurve.poleSheaf`: the invertible sheaf `𝒪(n[0])` on `projModel W` for `[W.IsElliptic]`
  and `n : ℕ`.

## Main results

* `WeierstrassCurve.isEffectiveCartier_zeroSectionDivisor_pow_three`: `3[0]` is an effective Cartier
  divisor for any Weierstrass curve.
* `WeierstrassCurve.mk_cubicPoleSheaf_eq_twistingSheaf_one`: `[𝒪(3[0])] = [𝒪(1)]`.
* `WeierstrassCurve.isAmple_cubicPoleSheaf` and `WeierstrassCurve.isRelativelyAmple_cubicPoleSheaf`:
  `𝒪(3[0])` is ample and relatively ample over `Spec R`.
* `WeierstrassCurve.pullback_mk_cubicPoleSheaf` and `WeierstrassCurve.pullback_mk_poleSheaf`:
  `𝒪(3[0])` and `𝒪(n[0])` commute with arbitrary change of coefficient ring.
* `WeierstrassCurve.mk_poleSheaf_zero`, `WeierstrassCurve.mk_poleSheaf_add`, and
  `WeierstrassCurve.mk_poleSheaf`: additivity of `n ↦ [𝒪(n[0])]` in the Picard group.
* `WeierstrassCurve.isAmple_poleSheaf` and `WeierstrassCurve.isRelativelyAmple_poleSheaf`: for
  `[W.IsElliptic]` and `0 < n`, `𝒪(n[0])` is ample and relatively ample over `Spec R`.

## References

* N. M. Katz and B. Mazur, *Arithmetic Moduli of Elliptic Curves*, §2.1–2.2.
* P. Deligne and M. Rapoport, *Les schémas de modules de courbes elliptiques*, II.1.
* [J. H. Silverman, *The Arithmetic of Elliptic Curves*][silverman2009], III.1 and III.3.
-/

public section

open CategoryTheory Limits AlgebraicGeometry TauCeti.AlgebraicGeometry

universe u

namespace WeierstrassCurve

variable {R : Type u} [CommRing R] (W : WeierstrassCurve R)

/-! ### The cubic pole sheaf `𝒪(3[0])` without ellipticity -/

/-- All integer twisting sheaves `𝒪(n)` on `projModel W` are invertible, since the three degree-one
coordinate charts cover `projModel W`. -/
instance isInvertible_twistingSheaf_projModel (n : ℤ) :
    TauCeti.SheafOfModules.IsInvertible (R := W.projModel.ringCatSheaf)
      (Proj.twistingSheaf W.toProjective.grading n) :=
  Proj.isInvertible_twistingSheaf_of_cover W.toProjective.coord W.toProjective.coord_mem_grading
    (Proj.iSup_basicOpen_eq_top _ _ W.toProjective.irrelevant_le_span_range_coord) n

/-- The homogeneous coordinate `Z` is regular on the homogeneous coordinate ring of `W`. -/
theorem isSMulRegular_coord_two :
    IsSMulRegular W.toProjective.CoordinateRing (W.toProjective.coord 2) :=
  (isRegular_iff_mem_nonZeroDivisors.mpr
    W.toProjective.coord_two_mem_nonZeroDivisors).isSMulRegular

/-- On each degree-one localization chart `Spec A_{(Xᵢ)} ⟶ projModel W`, the divisor `3[0]` is
generated by `Z / Xᵢ`. -/
theorem zeroSectionDivisor_pow_three_comap_awayι (i : Fin 3) :
    (W.zeroSectionDivisor ^ 3).comap
        (Proj.awayι W.toProjective.grading (W.toProjective.coord i)
          (W.toProjective.coord_mem_grading i) one_pos) =
      Scheme.IdealSheafData.ofIdealTop
        ((Ideal.span {(HomogeneousLocalization.Away.mk W.toProjective.grading
          (W.toProjective.coord_mem_grading i) 1 (W.toProjective.coord 2)
          (by simpa only [smul_eq_mul, mul_one] using
            W.toProjective.coord_mem_grading 2))}).map
            (Scheme.ΓSpecIso
              (.of (HomogeneousLocalization.Away W.toProjective.grading
                (W.toProjective.coord i)))).inv.hom) := by
  have hcomp :
      CommRingCat.ofHom (W.toProjective.awayEquivChartRing i).toRingHom ≫
        CommRingCat.ofHom (W.toProjective.awayEquivChartRing i).symm.toRingHom = 𝟙 _ :=
    CommRingCat.hom_ext (RingHom.ext (W.toProjective.awayEquivChartRing i).symm_apply_apply)
  have haway : Proj.awayι W.toProjective.grading (W.toProjective.coord i)
      (W.toProjective.coord_mem_grading i) one_pos =
      Spec.map (CommRingCat.ofHom (W.toProjective.awayEquivChartRing i).symm.toRingHom) ≫
        W.chartι i := by
    rw [W.chartι_def, ← RingEquiv.toRingHom_eq_coe, ← Category.assoc, ← Spec.map_comp, hcomp,
      Spec.map_id, Category.id_comp]
  rw [haway, Scheme.IdealSheafData.comap_comp, W.zeroSectionDivisor_pow_three_comap_chartι i,
    Scheme.IdealSheafData.comap_ofIdealTop_map_ΓSpecIso_inv, Ideal.map_span,
    Set.image_singleton]
  simp only [CommRingCat.hom_ofHom, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom,
    Projective.chartPoint_apply, Projective.awayEquivChartRing_symm_mk_X]

/-- **For any Weierstrass curve, `3[0]` is an effective Cartier divisor.** It is cut out on the
three standard charts by the regular degree-one element `Z`. -/
theorem isEffectiveCartier_zeroSectionDivisor_pow_three :
    (W.zeroSectionDivisor ^ 3).IsEffectiveCartier :=
  Proj.isEffectiveCartier_of_comap_awayι W.toProjective.coord W.toProjective.coord_mem_grading
    (Proj.iSup_basicOpen_eq_top _ _ W.toProjective.irrelevant_le_span_range_coord)
    (z := ⟨W.toProjective.coord 2, W.toProjective.coord_mem_grading 2⟩)
    W.isSMulRegular_coord_two W.zeroSectionDivisor_pow_three_comap_awayι

/-- Multiplication by the homogeneous coordinate `Z` identifies the ideal sheaf of `3[0]` with the
twisting sheaf `𝒪(-1)` on `projModel W`. -/
noncomputable def zeroSectionDivisorPowThreeSheafIso :
    (W.zeroSectionDivisor ^ 3).sheaf ≅ Proj.twistingSheaf W.toProjective.grading (-1 : ℤ) :=
  Proj.idealSheafIsoTwistingSheafNeg W.toProjective.coord W.toProjective.coord_mem_grading
    (Proj.iSup_basicOpen_eq_top _ _ W.toProjective.irrelevant_le_span_range_coord)
    (z := ⟨W.toProjective.coord 2, W.toProjective.coord_mem_grading 2⟩)
    W.isSMulRegular_coord_two W.zeroSectionDivisor_pow_three_comap_awayι

/-- Composing the inverse of `zeroSectionDivisorPowThreeSheafIso` with the ideal inclusion gives
multiplication by `Z : 𝒪(-1) ⟶ 𝒪`. -/
@[simp, reassoc]
theorem zeroSectionDivisorPowThreeSheafIso_inv_sheafι :
    W.zeroSectionDivisorPowThreeSheafIso.inv ≫ (W.zeroSectionDivisor ^ 3).sheafι =
      Proj.twistingSheaf.mulHom
        ⟨W.toProjective.coord 2, W.toProjective.coord_mem_grading 2⟩ := by
  rw [zeroSectionDivisorPowThreeSheafIso]
  exact Proj.idealSheafIsoTwistingSheafNeg_inv_sheafι W.toProjective.coord
    W.toProjective.coord_mem_grading
    (Proj.iSup_basicOpen_eq_top _ _ W.toProjective.irrelevant_le_span_range_coord)
    (I := W.zeroSectionDivisor ^ 3)
    (z := ⟨W.toProjective.coord 2, W.toProjective.coord_mem_grading 2⟩)
    W.isSMulRegular_coord_two W.zeroSectionDivisor_pow_three_comap_awayι

/-- The **cubic pole sheaf** `𝒪(3[0])` on `projModel W`, defined as the dual of the invertible ideal
sheaf of `3[0]`, with no ellipticity hypothesis on `W`. -/
noncomputable def cubicPoleSheaf : InvertibleSheaf W.projModel :=
  W.isEffectiveCartier_zeroSectionDivisor_pow_three.toInvertibleSheaf.dual

/-- Unfolding lemma for `WeierstrassCurve.cubicPoleSheaf`. -/
theorem cubicPoleSheaf_def :
    W.cubicPoleSheaf = W.isEffectiveCartier_zeroSectionDivisor_pow_three.toInvertibleSheaf.dual :=
  (rfl)

/-- **The cubic pole sheaf `𝒪(3[0])` has the Picard class of the hyperplane bundle `𝒪(1)`.** -/
theorem mk_cubicPoleSheaf_eq_twistingSheaf_one :
    LineBundleClass.mk W.cubicPoleSheaf =
      LineBundleClass.mk ⟨Proj.twistingSheaf W.toProjective.grading 1, inferInstance⟩ :=
  Proj.mk_dual_toInvertibleSheaf_eq_twistingSheaf W.toProjective.coord
    W.toProjective.coord_mem_grading
    (Proj.iSup_basicOpen_eq_top _ _ W.toProjective.irrelevant_le_span_range_coord)
    (z := ⟨W.toProjective.coord 2, W.toProjective.coord_mem_grading 2⟩)
    W.isSMulRegular_coord_two W.zeroSectionDivisor_pow_three_comap_awayι
    W.isEffectiveCartier_zeroSectionDivisor_pow_three

/-- **The cubic pole sheaf `𝒪(3[0])` is ample** on `projModel W` over any commutative ring, with no
ellipticity hypothesis. -/
theorem isAmple_cubicPoleSheaf : (LineBundleClass.mk W.cubicPoleSheaf).IsAmple :=
  Proj.isAmple_dual_toInvertibleSheaf W.toProjective.coord W.toProjective.coord_mem_grading
    (Proj.iSup_basicOpen_eq_top _ _ W.toProjective.irrelevant_le_span_range_coord) one_pos
    (z := ⟨W.toProjective.coord 2, W.toProjective.coord_mem_grading 2⟩)
    W.isSMulRegular_coord_two W.zeroSectionDivisor_pow_three_comap_awayι
    W.isEffectiveCartier_zeroSectionDivisor_pow_three

/-- **The cubic pole sheaf `𝒪(3[0])` is relatively ample** over `Spec R`, with no ellipticity
hypothesis. -/
theorem isRelativelyAmple_cubicPoleSheaf :
    (LineBundleClass.mk W.cubicPoleSheaf).IsRelativelyAmple W.projModelOver :=
  (LineBundleClass.isRelativelyAmple_iff_isAmple (f := W.projModelOver)).mpr
    W.isAmple_cubicPoleSheaf

/-- **The cubic pole sheaf commutes with arbitrary base change.** -/
@[simp]
theorem pullback_mk_cubicPoleSheaf {R' : Type u} [CommRing R'] (f : R →+* R') :
    LineBundleClass.pullback (W.projModelBaseChange f) (LineBundleClass.mk W.cubicPoleSheaf) =
      LineBundleClass.mk (W.map f).cubicPoleSheaf := by
  have hcomap : ((W.zeroSectionDivisor ^ 3).comap (W.projModelBaseChange f)).IsEffectiveCartier :=
    W.zeroSectionDivisor_pow_map f 3 ▸ (W.map f).isEffectiveCartier_zeroSectionDivisor_pow_three
  rw [cubicPoleSheaf_def, cubicPoleSheaf_def, ← LineBundleClass.inv_mk,
    LineBundleClass.pullback_inv,
    W.isEffectiveCartier_zeroSectionDivisor_pow_three.pullback_mk_toInvertibleSheaf hcomap,
    LineBundleClass.mk_toInvertibleSheaf_congr hcomap
      (W.map f).isEffectiveCartier_zeroSectionDivisor_pow_three
      (W.zeroSectionDivisor_pow_map f 3).symm,
    LineBundleClass.inv_mk]

/-- Pulling back `W.cubicPoleSheaf` along `projModelBaseChange W f` yields an invertible sheaf
isomorphic to `(W.map f).cubicPoleSheaf`. -/
theorem nonempty_pullback_cubicPoleSheaf_iso {R' : Type u} [CommRing R'] (f : R →+* R') :
    Nonempty (((InvertibleSheaf.pullback (W.projModelBaseChange f)).obj W.cubicPoleSheaf).obj ≅
      (W.map f).cubicPoleSheaf.obj) := by
  rw [← LineBundleClass.mk_eq_mk_iff, ← LineBundleClass.pullback_mk]
  exact W.pullback_mk_cubicPoleSheaf f

/-! ### The pole sheaves `𝒪(n[0])` for elliptic Weierstrass curves -/

section IsElliptic

variable [W.IsElliptic]

/-- The **pole sheaf** `𝒪(n[0])` on the projective model of an elliptic Weierstrass curve `W`,
defined as the dual of the invertible ideal sheaf of the relative effective Cartier divisor
`n[0] = W.zeroSectionDivisor ^ n`. -/
noncomputable def poleSheaf (n : ℕ) : InvertibleSheaf W.projModel :=
  (W.isRelativeEffectiveCartier_zeroSectionDivisor_pow n).isEffectiveCartier.toInvertibleSheaf.dual

/-- Unfolding lemma for `WeierstrassCurve.poleSheaf`. -/
theorem poleSheaf_def (n : ℕ) :
    W.poleSheaf n =
      (W.isRelativeEffectiveCartier_zeroSectionDivisor_pow
        n).isEffectiveCartier.toInvertibleSheaf.dual :=
  (rfl)

/-- For `n = 3`, `poleSheaf W 3` coincides with `cubicPoleSheaf W`. -/
@[simp]
theorem poleSheaf_three : W.poleSheaf 3 = W.cubicPoleSheaf := by
  rw [poleSheaf_def, cubicPoleSheaf_def]

/-- The zero-th pole sheaf `𝒪(0[0])` has trivial Picard class. -/
@[simp]
theorem mk_poleSheaf_zero : LineBundleClass.mk (W.poleSheaf 0) = 1 := by
  rw [poleSheaf_def, ← LineBundleClass.inv_mk,
    LineBundleClass.mk_toInvertibleSheaf_congr _ (Scheme.IdealSheafData.isEffectiveCartier_top _)
      (by rw [pow_zero, Scheme.IdealSheafData.one_eq_top]),
    LineBundleClass.mk_toInvertibleSheaf_top, inv_one]

/-- In the Picard group of `projModel W`, `[𝒪((m + n)[0])] = [𝒪(m[0])] * [𝒪(n[0])]`. -/
theorem mk_poleSheaf_add (m n : ℕ) :
    LineBundleClass.mk (W.poleSheaf (m + n)) =
      LineBundleClass.mk (W.poleSheaf m) * LineBundleClass.mk (W.poleSheaf n) := by
  have hm := (W.isRelativeEffectiveCartier_zeroSectionDivisor_pow m).isEffectiveCartier
  have hn := (W.isRelativeEffectiveCartier_zeroSectionDivisor_pow n).isEffectiveCartier
  rw [poleSheaf_def, poleSheaf_def, poleSheaf_def, ← LineBundleClass.inv_mk,
    ← LineBundleClass.inv_mk, ← LineBundleClass.inv_mk,
    LineBundleClass.mk_toInvertibleSheaf_congr _ (TauCeti.isEffectiveCartier_mul hm hn)
      (pow_add _ m n),
    LineBundleClass.mk_toInvertibleSheaf_mul, mul_inv]

/-- In the Picard group of `projModel W`, `[𝒪(n[0])] = [𝒪([0])] ^ n`. -/
theorem mk_poleSheaf (n : ℕ) :
    LineBundleClass.mk (W.poleSheaf n) = LineBundleClass.mk (W.poleSheaf 1) ^ n := by
  induction n with
  | zero => simp
  | succ n ih => rw [mk_poleSheaf_add, ih, pow_succ]

/-- The Picard class of `𝒪(3[0])` on an elliptic Weierstrass curve is `[𝒪(1)]`. -/
theorem mk_poleSheaf_three_eq_twistingSheaf_one :
    LineBundleClass.mk (W.poleSheaf 3) =
      LineBundleClass.mk ⟨Proj.twistingSheaf W.toProjective.grading 1, inferInstance⟩ := by
  rw [poleSheaf_three, W.mk_cubicPoleSheaf_eq_twistingSheaf_one]

/-- **Every pole sheaf `𝒪(n[0])` commutes with arbitrary base change.** -/
@[simp]
theorem pullback_mk_poleSheaf {R' : Type u} [CommRing R'] (f : R →+* R') (n : ℕ) :
    LineBundleClass.pullback (W.projModelBaseChange f) (LineBundleClass.mk (W.poleSheaf n)) =
      LineBundleClass.mk ((W.map f).poleSheaf n) := by
  have hI := (W.isRelativeEffectiveCartier_zeroSectionDivisor_pow n).isEffectiveCartier
  have hI' := ((W.map f).isRelativeEffectiveCartier_zeroSectionDivisor_pow n).isEffectiveCartier
  have hcomap : ((W.zeroSectionDivisor ^ n).comap (W.projModelBaseChange f)).IsEffectiveCartier :=
    W.zeroSectionDivisor_pow_map f n ▸ hI'
  rw [poleSheaf_def, poleSheaf_def, ← LineBundleClass.inv_mk, LineBundleClass.pullback_inv,
    hI.pullback_mk_toInvertibleSheaf hcomap,
    LineBundleClass.mk_toInvertibleSheaf_congr hcomap hI' (W.zeroSectionDivisor_pow_map f n).symm,
    LineBundleClass.inv_mk]

/-- Pulling back `W.poleSheaf n` along `projModelBaseChange W f` yields an invertible sheaf
isomorphic to `(W.map f).poleSheaf n`. -/
theorem nonempty_pullback_poleSheaf_iso {R' : Type u} [CommRing R'] (f : R →+* R') (n : ℕ) :
    Nonempty (((InvertibleSheaf.pullback (W.projModelBaseChange f)).obj (W.poleSheaf n)).obj ≅
      ((W.map f).poleSheaf n).obj) := by
  rw [← LineBundleClass.mk_eq_mk_iff, ← LineBundleClass.pullback_mk]
  exact W.pullback_mk_poleSheaf f n

/-- **Every positive pole sheaf `𝒪(n[0])` (`0 < n`) is ample** on `projModel W`. Ampleness of
`𝒪(3[0])` descends to `𝒪([0])` and then passes to every positive multiple. -/
theorem isAmple_poleSheaf {n : ℕ} (hn : 0 < n) :
    (LineBundleClass.mk (W.poleSheaf n)).IsAmple := by
  have h1 : (LineBundleClass.mk (W.poleSheaf 1)).IsAmple :=
    LineBundleClass.IsAmple.of_pow (by decide : 0 < 3)
      (by rw [← W.mk_poleSheaf 3, W.poleSheaf_three]; exact W.isAmple_cubicPoleSheaf)
  rw [W.mk_poleSheaf n]
  exact h1.pow hn

/-- **Every positive pole sheaf `𝒪(n[0])` (`0 < n`) is relatively ample** over `Spec R`. -/
theorem isRelativelyAmple_poleSheaf {n : ℕ} (hn : 0 < n) :
    (LineBundleClass.mk (W.poleSheaf n)).IsRelativelyAmple W.projModelOver :=
  (LineBundleClass.isRelativelyAmple_iff_isAmple (f := W.projModelOver)).mpr
    (W.isAmple_poleSheaf hn)

end IsElliptic

end WeierstrassCurve
