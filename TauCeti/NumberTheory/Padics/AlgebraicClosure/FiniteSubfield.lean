module

public import Mathlib.NumberTheory.Padics.Complex
public import TauCeti.NumberTheory.LocalField.FiniteExtension.IntermediateField
public import TauCeti.NumberTheory.LocalField.Padic
import TauCeti.Analysis.Normed.Field.Krasner

/-!
# Finite subfields of `PadicAlgCl p`

Every finite intermediate field `E` of `PadicAlgCl p / ℚ_[p]` is generated over `ℚ_[p]` by an
element algebraic over `ℚ`, so there are only countably many such subfields. Moreover, because the
norm on `PadicAlgCl p` extends the normalized absolute value of `ℚ_[p]`, the spectral norm on any
intermediate field `E ⊆ PadicAlgCl p` coincides with the restriction of the norm of `PadicAlgCl p`.
Consequently, its spectral-norm topology coincides with the subspace topology, its ring of integers
`𝒪[E]` is `{x ∈ E | ‖(x : PadicAlgCl p)‖ ≤ 1}`, and every finite intermediate field `E` is a
nonarchimedean local field for its subspace topology.

## Main results

* `PadicAlgCl.norm_algebraMap_eq_normalizedAbsoluteValue`: the norm on `PadicAlgCl p` extends
  `TauCeti.normalizedAbsoluteValue ℚ_[p]`.
* `PadicAlgCl.exists_isAlgebraic_rat_adjoin_simple_eq`: every finite intermediate field
  `E ⊆ PadicAlgCl p` equals `ℚ_[p]⟮β⟯` for some `β` algebraic over `ℚ`.
* `PadicAlgCl.countable_setOf_finiteDimensional`: `PadicAlgCl p / ℚ_[p]` has only countably many
  finite intermediate fields.
* `PadicAlgCl.algebraicExtensionNormedField_norm_eq`: the spectral norm on an intermediate field
  `E ⊆ PadicAlgCl p` equals the ambient norm.
* `PadicAlgCl.algebraicExtensionNormedFieldTopology_eq`: the spectral-norm topology on an
  intermediate field `E ⊆ PadicAlgCl p` coincides with the subspace topology.
* `PadicAlgCl.mem_integerRing_iff`: for `E ⊆ PadicAlgCl p` with `algebraicExtensionValuativeRel`,
  `x ∈ 𝒪[E]` if and only if `‖(x : PadicAlgCl p)‖ ≤ 1`.
* `PadicAlgCl.isNonarchimedeanLocalField`: a finite intermediate field `E ⊆ PadicAlgCl p` is a
  nonarchimedean local field for its subspace topology.

## References

* J. Neukirch, *Algebraic Number Theory*, Chapter II, §§4, 6.
* A. M. Robert, *A Course in p-adic Analysis*, Graduate Texts in Mathematics 198, Springer, 2000,
  Chapter 3.
-/

public section

open IntermediateField ValuativeRel

namespace PadicAlgCl

variable (p : ℕ) [Fact p.Prime]

private theorem denseRange_algebraMap_rat : DenseRange (algebraMap ℚ ℚ_[p]) := by
  have hcast : ⇑(algebraMap ℚ ℚ_[p]) = Rat.cast := funext (eq_ratCast _)
  rw [hcast]
  exact Padic.denseRange_ratCast p

/-- The norm on `PadicAlgCl p` extends the normalized local-field absolute value of `ℚ_[p]`. -/
theorem norm_algebraMap_eq_normalizedAbsoluteValue (x : ℚ_[p]) :
    ‖algebraMap ℚ_[p] (PadicAlgCl p) x‖ = TauCeti.normalizedAbsoluteValue ℚ_[p] x := by
  rw [PadicAlgCl.norm_extends, ← coe_nnNorm, ← Padic.normalizedAbsoluteValue_eq_nnnorm p x]
  norm_cast

/-- **Every finite extension of `ℚ_[p]` inside `PadicAlgCl p` is generated by an algebraic
number**: it equals `ℚ_[p]⟮β⟯` for some `β : PadicAlgCl p` algebraic over `ℚ`. -/
theorem exists_isAlgebraic_rat_adjoin_simple_eq (E : IntermediateField ℚ_[p] (PadicAlgCl p))
    [FiniteDimensional ℚ_[p] E] :
    ∃ β : PadicAlgCl p, IsAlgebraic ℚ β ∧ ℚ_[p]⟮β⟯ = E :=
  E.exists_isAlgebraic_adjoin_simple_eq (denseRange_algebraMap_rat p)

/-- **`PadicAlgCl p / ℚ_[p]` has only countably many finite intermediate fields.** -/
theorem countable_setOf_finiteDimensional :
    {E : IntermediateField ℚ_[p] (PadicAlgCl p) | FiniteDimensional ℚ_[p] E}.Countable :=
  IntermediateField.countable_setOf_finiteDimensional (L := PadicAlgCl p)
    (denseRange_algebraMap_rat p)

variable {p} in
/-- The spectral norm on an intermediate field `E ⊆ PadicAlgCl p` agrees with the norm inherited
from `PadicAlgCl p`. -/
theorem algebraicExtensionNormedField_norm_eq (E : IntermediateField ℚ_[p] (PadicAlgCl p))
    (x : E) :
    (letI := TauCeti.algebraicExtensionNormedField ℚ_[p] E; ‖x‖) = ‖(x : PadicAlgCl p)‖ :=
  E.algebraicExtensionNormedField_norm_eq (norm_algebraMap_eq_normalizedAbsoluteValue p) x

variable {p} in
/-- The spectral-norm topology on an intermediate field `E ⊆ PadicAlgCl p` equals the subspace
topology inherited from `PadicAlgCl p`. -/
theorem algebraicExtensionNormedFieldTopology_eq (E : IntermediateField ℚ_[p] (PadicAlgCl p)) :
    TauCeti.algebraicExtensionNormedFieldTopology ℚ_[p] E = (inferInstance : TopologicalSpace E) :=
  E.algebraicExtensionNormedFieldTopology_eq (norm_algebraMap_eq_normalizedAbsoluteValue p)

variable {p} in
/-- For an intermediate field `E ⊆ PadicAlgCl p` equipped with its spectral-norm valuative
relation, an element lies in `𝒪[E]` if and only if its norm in `PadicAlgCl p` is at most `1`. -/
theorem mem_integerRing_iff (E : IntermediateField ℚ_[p] (PadicAlgCl p)) (x : E) :
    letI := TauCeti.algebraicExtensionValuativeRel ℚ_[p] E
    x ∈ 𝒪[E] ↔ ‖(x : PadicAlgCl p)‖ ≤ 1 :=
  E.mem_integerRing_algebraicExtensionValuativeRel_iff
    (norm_algebraMap_eq_normalizedAbsoluteValue p) x

variable {p} in
/-- **Every finite intermediate field of `PadicAlgCl p / ℚ_[p]` is a nonarchimedean local field**
for its subspace topology and spectral-norm valuative relation. -/
theorem isNonarchimedeanLocalField (E : IntermediateField ℚ_[p] (PadicAlgCl p))
    [FiniteDimensional ℚ_[p] E] :
    @IsNonarchimedeanLocalField E _
      (TauCeti.algebraicExtensionValuativeRel ℚ_[p] E) inferInstance :=
  E.isNonarchimedeanLocalField_of_norm_algebraMap (norm_algebraMap_eq_normalizedAbsoluteValue p)

end PadicAlgCl
