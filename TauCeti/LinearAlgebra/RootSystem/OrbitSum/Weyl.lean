/-!
# The fixed Weyl group of an orthogonal orbit-sum fold

Let `P` be a root pairing and `σ : P.Aut` an automorphism of `P`. The **fixed Weyl group**
`RootPairing.fixedWeylGroup P σ` is the subgroup of `P.weylGroup` fixed by conjugation by `σ` in
`P.Aut` — that is, the inverse image of `Subgroup.centralizer {σ}` along `P.weylGroup.subtype`.
Every element `w ∈ P.fixedWeylGroup σ` commutes with `σ.weightMap` and therefore restricts to an
`R`-linear automorphism of the fixed weight space `LinearMap.fixedSubmodule σ.weightMap`
(`RootPairing.fixedWeylGroupWeightHom`).

Following Stembridge (Claim 3), when `P` is a finite reduced crystallographic root pairing over a
domain of characteristic zero and `σ` permutes the simple roots of a base `b`:

1. **Faithfulness on the fixed space**
   (`RootPairing.eq_one_of_mem_fixedWeylGroup_of_forall_smul_eq`): if `w ∈ P.fixedWeylGroup σ`
   acts trivially on `LinearMap.fixedSubmodule σ.weightMap`, then `w = 1`. Indeed, any `w ≠ 1`
   inverts some simple root `αᵢ`; then `P.orbitSum σ (w αᵢ) = w • P.orbitSum σ i = P.orbitSum σ i`
   belongs to `TauCeti.posRootCone P b` while its negative also belongs to `TauCeti.posRootCone P b`
   because `w αᵢ` is negative, contradicting pointedness of the positive root cone.
2. **Generation by simple-orbit reflections**
   (`RootPairing.fixedWeylGroup_eq_closure_orbitReflection`): when each simple `σ`-orbit is
   pairwise orthogonal, every `w ∈ P.fixedWeylGroup σ` is a product of the simple-orbit reflections
   `P.orbitReflection σ i`. Right-multiplying `w ≠ 1` by the orbit reflection of a simple inversion
   `i ∈ b.support` decreases `(TauCeti.inversions P b w).ncard` by `#(P.orbitIndices σ i)`.
3. **Isomorphism with the folded Weyl group**
   (`RootPairing.OrbitSumRealization.fixedWeylGroupMulEquiv` and `RootPairing.fixed_weyl_group`):
   for a simply laced root system over a linearly ordered field and any orbit-sum realization `F`,
   both `P.fixedWeylGroup σ` and `F.pairing.weylGroup` embed faithfully into the group of linear
   automorphisms of `LinearMap.fixedSubmodule σ.weightMap` with the same generating reflections,
   yielding a canonical multiplicative equivalence compatible with the action on fixed weights.

## Main definitions

* `RootPairing.fixedWeylGroup`: the subgroup of `P.weylGroup` commuting with `σ` in `P.Aut`.
* `RootPairing.fixedWeylGroupWeightHom`: restriction of the weight-space action of
  `P.fixedWeylGroup σ` to `LinearMap.fixedSubmodule σ.weightMap`.
* `RootPairing.OrbitSumRealization.fixedWeylGroupMulEquiv`: the canonical group isomorphism
  `P.fixedWeylGroup σ ≃* F.pairing.weylGroup` for an orthogonal simply laced fold.

## Main results

* `RootPairing.eq_one_of_mem_fixedWeylGroup_of_forall_smul_eq` and
  `RootPairing.fixedWeylGroupWeightHom_injective`: faithfulness of `P.fixedWeylGroup σ` on the
  fixed weight space.
* `RootPairing.fixedWeylGroup_eq_closure_orbitReflection`: `P.fixedWeylGroup σ` is generated by the
  simple-orbit reflections.
* `RootPairing.OrbitSumRealization.coe_fixedWeylGroupMulEquiv_smul`,
  `RootPairing.OrbitSumRealization.fixedWeylGroupMulEquiv_orbitReflection`, and
  `RootPairing.fixed_weyl_group`: restriction identifies `P.fixedWeylGroup σ` with
  `F.pairing.weylGroup`, matching orbit reflections with folded reflections.

## References

* J. R. Stembridge, *Folding by automorphisms*, note of 20 August 2008, Claim 3 (pages 2–3).
-/

public section

namespace RootPairing

open Finset TauCeti

/-! ### The conjugation-fixed Weyl subgroup and its action on fixed weights -/

section Basic

variable {ι R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]

/-- The subgroup of the native Weyl group fixed by conjugation by an automorphism `σ`, expressed as
the inverse image of its centralizer in `P.Aut`. -/
noncomputable def fixedWeylGroup (P : RootPairing ι R M N) (σ : P.Aut) : Subgroup P.weylGroup :=
  (Subgroup.centralizer ({σ} : Set P.Aut)).comap P.weylGroup.subtype

theorem fixedWeylGroup_def (P : RootPairing ι R M N) (σ : P.Aut) :
    P.fixedWeylGroup σ = (Subgroup.centralizer ({σ} : Set P.Aut)).comap P.weylGroup.subtype := by
  rw [fixedWeylGroup]

@[simp]
theorem mem_fixedWeylGroup_iff {P : RootPairing ι R M N} {σ : P.Aut} {w : P.weylGroup} :
    w ∈ P.fixedWeylGroup σ ↔ Commute (w : P.Aut) σ := by
  rw [fixedWeylGroup, Subgroup.mem_comap, Subgroup.coe_subtype,
    Subgroup.mem_centralizer_singleton_iff, commute_iff_eq]

theorem mem_fixedWeylGroup_iff_conj {P : RootPairing ι R M N} {σ : P.Aut} {w : P.weylGroup} :
    w ∈ P.fixedWeylGroup σ ↔ σ * (w : P.Aut) * σ⁻¹ = (w : P.Aut) := by
  rw [mem_fixedWeylGroup_iff, commute_iff_eq, mul_inv_eq_iff_eq_mul, eq_comm]

@[simp]
theorem fixedWeylGroup_one (P : RootPairing ι R M N) : P.fixedWeylGroup 1 = ⊤ := by
  ext w
  simp [Commute.one_right]

theorem weylGroupToPerm_indexEquiv_of_mem_fixedWeylGroup {P : RootPairing ι R M N} {σ : P.Aut}
    {w : P.weylGroup} (hw : w ∈ P.fixedWeylGroup σ) (i : ι) :
    P.weylGroupToPerm w (σ.indexEquiv i) = σ.indexEquiv (P.weylGroupToPerm w i) :=
  congrArg (fun u : P.Aut ↦ u.indexEquiv i) (P.mem_fixedWeylGroup_iff.mp hw).eq

theorem weightMap_smul_of_mem_fixedWeylGroup {P : RootPairing ι R M N} {σ : P.Aut}
    {w : P.weylGroup} (hw : w ∈ P.fixedWeylGroup σ) (x : M) :
    σ.weightMap (w • x) = w • σ.weightMap x := by
  have h := congrArg (fun u : P.Aut ↦ Equiv.weightHom P u x)
    (P.mem_fixedWeylGroup_iff.mp hw).symm.eq
  rw [map_mul, map_mul, mul_apply_eq_comp, mul_apply_eq_comp] at h
  exact h

theorem smul_mem_fixedSubmodule_of_mem_fixedWeylGroup {P : RootPairing ι R M N} {σ : P.Aut}
    {w : P.weylGroup} (hw : w ∈ P.fixedWeylGroup σ) {x : M}
    (hx : x ∈ LinearMap.fixedSubmodule σ.weightMap) :
    w • x ∈ LinearMap.fixedSubmodule σ.weightMap := by
  rw [LinearMap.mem_fixedSubmodule_iff] at hx ⊢
  rw [weightMap_smul_of_mem_fixedWeylGroup hw, hx]

/-- Restriction of the weight-space representation of `P.fixedWeylGroup σ` to the fixed submodule
`LinearMap.fixedSubmodule σ.weightMap`. -/
noncomputable def fixedWeylGroupWeightHom (P : RootPairing ι R M N) (σ : P.Aut) :
    P.fixedWeylGroup σ →*
      (LinearMap.fixedSubmodule σ.weightMap ≃ₗ[R] LinearMap.fixedSubmodule σ.weightMap) where
  toFun w :=
    { toFun x := ⟨(w : P.weylGroup) • x.1,
        smul_mem_fixedSubmodule_of_mem_fixedWeylGroup w.2 x.2⟩
      invFun x := ⟨(w⁻¹ : P.fixedWeylGroup σ).1 • x.1,
        smul_mem_fixedSubmodule_of_mem_fixedWeylGroup (w⁻¹).2 x.2⟩
      map_add' x y := Subtype.ext (smul_add (w : P.weylGroup) x.1 y.1)
      map_smul' r x := Subtype.ext (smul_comm (w : P.weylGroup) r x.1)
      left_inv x := Subtype.ext (inv_smul_smul (w : P.weylGroup) x.1)
      right_inv x := Subtype.ext (smul_inv_smul (w : P.weylGroup) x.1) }
  map_one' := by
    ext x
    exact one_smul P.weylGroup x.1
  map_mul' u v := by
    ext x
    exact mul_smul (u : P.weylGroup) (v : P.weylGroup) x.1

@[simp]
theorem coe_fixedWeylGroupWeightHom_apply (P : RootPairing ι R M N) (σ : P.Aut)
    (w : P.fixedWeylGroup σ) (x : LinearMap.fixedSubmodule σ.weightMap) :
    (P.fixedWeylGroupWeightHom σ w x : M) = (w : P.weylGroup) • (x : M) := by
  simp [fixedWeylGroupWeightHom]

theorem smul_orbitSum_of_mem_fixedWeylGroup [Finite ι] {P : RootPairing ι R M N} {σ : P.Aut}
    {w : P.weylGroup} (hw : w ∈ P.fixedWeylGroup σ) (i : ι) :
    w • P.orbitSum σ i = P.orbitSum σ (P.weylGroupToPerm w i) :=
  P.weightMap_orbitSum (w : P.Aut) (weylGroupToPerm_indexEquiv_of_mem_fixedWeylGroup hw) i

/-- Every orbit reflection of a pairwise orthogonal `σ`-orbit belongs to `P.fixedWeylGroup σ`. -/
theorem orbitReflection_mem_fixedWeylGroup [Finite ι] (P : RootPairing ι R M N) (σ : P.Aut)
    (i : ι) (horth : ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0) :
    P.orbitReflection σ i horth ∈ P.fixedWeylGroup σ :=
  P.mem_fixedWeylGroup_iff.mpr (commute_coe_orbitReflection horth)

end Basic

/-! ### Faithfulness on fixed weights and generation by simple-orbit reflections -/

section Descent

variable {ι R M N : Type*} [CommRing R] [CharZero R] [IsDomain R]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  (P : RootPairing ι R M N) [Finite ι] [P.IsCrystallographic] [P.IsReduced]
  (b : P.Base) (σ : P.Aut)

/-- If `σ` permutes the simple roots of `b`, then any `w ∈ P.fixedWeylGroup σ` acting trivially on
`LinearMap.fixedSubmodule σ.weightMap` is the identity. -/
theorem eq_one_of_mem_fixedWeylGroup_of_forall_smul_eq
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support) {w : P.weylGroup}
    (hw : w ∈ P.fixedWeylGroup σ)
    (hfix : ∀ x ∈ LinearMap.fixedSubmodule σ.weightMap, w • x = x) :
    w = 1 := by
  by_contra hne
  obtain ⟨i, hi, hinv⟩ := exists_mem_support_mem_inversions_of_ne_one P b hne
  set k := P.weylGroupToPerm w i
  have hk_neg : ¬ b.IsPos k := ((mem_inversions P b w i).mp hinv).2
  have hk_refl_pos : b.IsPos (P.reflectionPerm k k) :=
    (isPos_reflectionPerm_self_iff_mem_negRoots P b k).mpr ((mem_negRoots P b k).mpr hk_neg)
  have horb_eq : P.orbitSum σ k = P.orbitSum σ i := by
    rw [← smul_orbitSum_of_mem_fixedWeylGroup hw i,
      hfix (P.orbitSum σ i) (P.orbitSum_mem_fixedSubmodule σ i)]
  have hmem₁ : P.orbitSum σ k ∈ posRootCone P b := by
    rw [horb_eq]
    exact orbitSum_mem_posRootCone hσ (b.isPos_of_mem_support hi)
  have hmem₂ : -P.orbitSum σ k ∈ posRootCone P b := by
    rw [← orbitSum_reflectionPerm_self]
    exact orbitSum_mem_posRootCone hσ hk_refl_pos
  exact orbitSum_ne_zero hσ k
    (eq_zero_of_add_eq_zero_of_mem_posRootCone P b hmem₁ hmem₂ (add_neg_cancel _))

/-- When `σ` permutes `b.support`, the representation of `P.fixedWeylGroup σ` on
`LinearMap.fixedSubmodule σ.weightMap` is faithful. -/
theorem fixedWeylGroupWeightHom_injective
    (hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support) :
    Function.Injective (P.fixedWeylGroupWeightHom σ) := by
  rw [← MonoidHom.ker_eq_bot_iff, Subgroup.eq_bot_iff_forall]
  intro w hw
  apply Subtype.ext
  refine P.eq_one_of_mem_fixedWeylGroup_of_forall_smul_eq b σ hσ w.2 fun x hx ↦ ?_
  have h := LinearEquiv.congr_fun (MonoidHom.mem_ker.mp hw) ⟨x, hx⟩
  simpa using congrArg Subtype.val h

/-- When `σ` permutes `b.support` and every simple `σ`-orbit is pairwise orthogonal,
`P.fixedWeylGroup σ` is generated by the simple-orbit reflections (Stembridge, Claim 3). -/
theorem fixedWeylGroup_eq_closure_orbitReflection
    (hbase : ∀ i : ι, i ∈ b.support ↔ σ.indexEquiv i ∈ b.support)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0) :
    (⊤ : Subgroup (P.fixedWeylGroup σ)) =
      Subgroup.closure
        {w : P.fixedWeylGroup σ | ∃ (i : ι) (hi : i ∈ b.support),
          (w : P.weylGroup) = P.orbitReflection σ i (horth i hi)} := by
  set H : Subgroup (P.fixedWeylGroup σ) :=
    Subgroup.closure
      {w : P.fixedWeylGroup σ | ∃ (i : ι) (hi : i ∈ b.support),
        (w : P.weylGroup) = P.orbitReflection σ i (horth i hi)}
  have hσ : ∀ j ∈ b.support, σ.indexEquiv j ∈ b.support := fun j hj ↦ (hbase j).mp hj
  suffices hdesc : ∀ n : ℕ, ∀ w : P.fixedWeylGroup σ,
      (inversions P b (w : P.weylGroup)).ncard ≤ n → w ∈ H by
    exact le_antisymm (fun w _ ↦ hdesc _ w le_rfl) le_top
  intro n
  induction n with
  | zero =>
    intro w hlen
    have hempty : inversions P b (w : P.weylGroup) = ∅ :=
      (Set.ncard_eq_zero (Set.toFinite _)).mp (Nat.eq_zero_of_le_zero hlen)
    have hw1 : w = 1 := Subtype.ext (eq_one_of_inversions_eq_empty hempty)
    exact hw1 ▸ one_mem H
  | succ n ih =>
    intro w hlen
    by_cases hw1 : (w : P.weylGroup) = 1
    · exact (Subtype.ext hw1 : w = 1) ▸ one_mem H
    · obtain ⟨i, hi, hi_inv⟩ := exists_mem_support_mem_inversions_of_ne_one P b hw1
      let r : P.fixedWeylGroup σ :=
        ⟨P.orbitReflection σ i (horth i hi), P.orbitReflection_mem_fixedWeylGroup σ i (horth i hi)⟩
      have hr : r ∈ H := Subgroup.subset_closure ⟨i, hi, rfl⟩
      have hsupp : (P.orbitIndices σ i : Set ι) ⊆ b.support := by
        intro j hj
        obtain ⟨m, rfl⟩ := mem_orbitIndices_iff_exists_pow.mp hj
        clear hj
        induction m with
        | zero => exact hi
        | succ m ihm =>
          rw [pow_succ', _root_.Equiv.Perm.mul_apply]
          exact (hbase _).mp ihm
      have hinv_all : ∀ j ∈ P.orbitIndices σ i, j ∈ inversions P b (w : P.weylGroup) := by
        intro j hj
        have hmap := P.map_orbitIndices ((w : P.weylGroup) : P.Aut)
          (weylGroupToPerm_indexEquiv_of_mem_fixedWeylGroup w.2) i
        have hj' : P.weylGroupToPerm (w : P.weylGroup) j ∈
            P.orbitIndices σ (P.weylGroupToPerm (w : P.weylGroup) i) := by
          rw [P.weylGroupToPerm_apply, P.weylGroupToPerm_apply, ← hmap]
          exact mem_map.mpr ⟨j, hj, rfl⟩
        refine (mem_inversions P b (w : P.weylGroup) j).mpr
          ⟨b.isPos_of_mem_support (hsupp hj), fun hpos ↦ ?_⟩
        exact ((mem_inversions P b (w : P.weylGroup) i).mp hi_inv).2
          ((isPos_iff_of_mem_orbitIndices hσ hj').mp hpos)
      have hdrop : (inversions P b ((w * r : P.fixedWeylGroup σ) : P.weylGroup)).ncard +
          #(P.orbitIndices σ i) = (inversions P b (w : P.weylGroup)).ncard := by
        change (inversions P b ((w : P.weylGroup) * P.orbitReflection σ i (horth i hi))).ncard +
          #(P.orbitIndices σ i) = (inversions P b (w : P.weylGroup)).ncard
        rw [P.orbitReflection_def σ i (horth i hi)]
        exact P.ncard_inversions_mul_orthogonalReflectionProd b (w : P.weylGroup)
          (P.orbitIndices σ i) (isOrthogonal_on_orbitIndices (horth i hi)) hsupp hinv_all
      have hcard_pos := P.card_orbitIndices_pos σ i
      have hwr : w * r ∈ H := ih (w * r) (by omega)
      have hrr : w * r * r = w := by
        rw [mul_assoc]
        have hr_sq : r * r = 1 := Subtype.ext (orbitReflection_mul_self (horth i hi))
        rw [hr_sq, mul_one]
      exact hrr ▸ mul_mem hwr hr

end Descent

/-! ### Isomorphism with the Weyl group of an orthogonal orbit-sum realization -/

section Isomorphism

variable {ι R M N : Type*} [Field R] [LinearOrder R] [IsStrictOrderedRing R]
  [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
  (P : RootPairing ι R M N) [Finite ι] [P.IsRootSystem] [P.IsReduced] [P.IsCrystallographic]
  (b : P.Base) (σ : P.Aut)

private theorem fixedWeylGroupWeightHom_range_eq
    (hbase : ∀ i : ι, i ∈ b.support ↔ σ.indexEquiv i ∈ b.support)
    (hsimply : b.cartanMatrix.IsSimplyLaced)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0)
    (F : P.OrbitSumRealization b σ) :
    (P.fixedWeylGroupWeightHom σ).range =
      ((Equiv.weightHom F.pairing).domRestrict F.pairing.weylGroup).range := by
  set φ₁ := P.fixedWeylGroupWeightHom σ
  set φ₂ := (Equiv.weightHom F.pairing).domRestrict F.pairing.weylGroup
  set S₁ : Set (P.fixedWeylGroup σ) :=
    {w : P.fixedWeylGroup σ | ∃ (i : ι) (hi : i ∈ b.support),
      (w : P.weylGroup) = P.orbitReflection σ i (horth i hi)}
  set S₂ : Set F.pairing.weylGroup :=
    Set.range fun γ : F.base.support ↦ weylGroup.ofIdx F.pairing (γ : P.foldedIndices σ)
  have hrange₁ : φ₁.range = Subgroup.closure (φ₁ '' S₁) := by
    rw [← Subgroup.map_top, P.fixedWeylGroup_eq_closure_orbitReflection b σ hbase horth,
      MonoidHom.map_closure]
  have hrange₂ : φ₂.range = Subgroup.closure (φ₂ '' S₂) := by
    rw [← Subgroup.map_top, weylGroup_eq_closure_simple F.pairing F.base, MonoidHom.map_closure]
  have hgen (i : ι) (hi : i ∈ b.support) :
      φ₁ ⟨P.orbitReflection σ i (horth i hi),
          P.orbitReflection_mem_fixedWeylGroup σ i (horth i hi)⟩ =
        φ₂ (weylGroup.ofIdx F.pairing (P.toFoldedIndices σ i)) := by
    ext x : 1
    apply Subtype.ext
    rw [coe_fixedWeylGroupWeightHom_apply]
    change P.orbitReflection σ i (horth i hi) • (x : M) =
      (F.pairing.reflection (P.toFoldedIndices σ i) x : M)
    rw [F.coe_reflection_toFoldedIndices_apply hbase hsimply horth i x]
  rw [hrange₁, hrange₂]
  congr 1
  ext g
  simp only [Set.mem_image]
  refine ⟨?_, ?_⟩
  · rintro ⟨w, ⟨i, hi, hw⟩, rfl⟩
    have hw_eq : w = ⟨P.orbitReflection σ i (horth i hi),
        P.orbitReflection_mem_fixedWeylGroup σ i (horth i hi)⟩ := Subtype.ext hw
    refine ⟨weylGroup.ofIdx F.pairing (P.toFoldedIndices σ i),
      ⟨⟨P.toFoldedIndices σ i, F.toFoldedIndices_mem_support hi⟩, rfl⟩, ?_⟩
    rw [hw_eq, hgen i hi]
  · rintro ⟨u, ⟨γ, rfl⟩, rfl⟩
    obtain ⟨i, hi, hiγ⟩ := (F.base_eq γ.1).mp γ.2
    have hγ_eq : (γ : P.foldedIndices σ) = P.toFoldedIndices σ i :=
      Subtype.ext (hiγ.symm.trans (P.coe_toFoldedIndices σ i).symm)
    refine ⟨⟨P.orbitReflection σ i (horth i hi),
        P.orbitReflection_mem_fixedWeylGroup σ i (horth i hi)⟩,
      ⟨i, hi, rfl⟩, ?_⟩
    dsimp only
    rw [hγ_eq, ← hgen i hi]

namespace OrbitSumRealization

variable {P b σ}

omit [LinearOrder R] [IsStrictOrderedRing R] [P.IsRootSystem] [P.IsReduced]
  [P.IsCrystallographic] in
private theorem weylGroup_weightHom_injective (F : P.OrbitSumRealization b σ) :
    Function.Injective ((Equiv.weightHom F.pairing).domRestrict F.pairing.weylGroup) :=
  fun _ _ h ↦ Subtype.ext (Equiv.weightHom_injective F.pairing h)

/-- **The fixed Weyl group isomorphism** (Stembridge, Claim 3): restriction to the fixed weight
space `LinearMap.fixedSubmodule σ.weightMap` identifies `P.fixedWeylGroup σ` with the Weyl group
`F.pairing.weylGroup` of any orthogonal simply laced orbit-sum realization `F`. -/
noncomputable def fixedWeylGroupMulEquiv (F : P.OrbitSumRealization b σ)
    (hbase : ∀ i : ι, i ∈ b.support ↔ σ.indexEquiv i ∈ b.support)
    (hsimply : b.cartanMatrix.IsSimplyLaced)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0) :
    P.fixedWeylGroup σ ≃* F.pairing.weylGroup :=
  (MonoidHom.ofInjective (P.fixedWeylGroupWeightHom_injective b σ fun j hj ↦ (hbase j).mp hj)).trans
    ((MulEquiv.subgroupCongr (fixedWeylGroupWeightHom_range_eq P b σ hbase hsimply horth F)).trans
      (MonoidHom.ofInjective (weylGroup_weightHom_injective F)).symm)

@[simp]
theorem coe_fixedWeylGroupMulEquiv_smul (F : P.OrbitSumRealization b σ)
    (hbase : ∀ i : ι, i ∈ b.support ↔ σ.indexEquiv i ∈ b.support)
    (hsimply : b.cartanMatrix.IsSimplyLaced)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0)
    (w : P.fixedWeylGroup σ) (x : LinearMap.fixedSubmodule σ.weightMap) :
    ((F.fixedWeylGroupMulEquiv hbase hsimply horth w • x :
        LinearMap.fixedSubmodule σ.weightMap) : M) =
      (w : P.weylGroup) • (x : M) := by
  have hEq : ((Equiv.weightHom F.pairing).domRestrict F.pairing.weylGroup)
      (F.fixedWeylGroupMulEquiv hbase hsimply horth w) =
      P.fixedWeylGroupWeightHom σ w := by
    rw [fixedWeylGroupMulEquiv, MulEquiv.trans_apply, MulEquiv.trans_apply,
      MonoidHom.apply_ofInjective_symm, MulEquiv.subgroupCongr_apply,
      MonoidHom.ofInjective_apply]
  have hx := congrArg Subtype.val (LinearEquiv.congr_fun hEq x)
  rw [coe_fixedWeylGroupWeightHom_apply] at hx
  exact hx

@[simp]
theorem fixedWeylGroupMulEquiv_orbitReflection (F : P.OrbitSumRealization b σ)
    (hbase : ∀ i : ι, i ∈ b.support ↔ σ.indexEquiv i ∈ b.support)
    (hsimply : b.cartanMatrix.IsSimplyLaced)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0)
    (k : ι) (hk : ∀ j ∈ P.orbitIndices σ k, k ≠ j → P.pairing k j = 0) :
    F.fixedWeylGroupMulEquiv hbase hsimply horth
      ⟨P.orbitReflection σ k hk, P.orbitReflection_mem_fixedWeylGroup σ k hk⟩ =
      weylGroup.ofIdx F.pairing (P.toFoldedIndices σ k) := by
  refine weylGroup.ext fun x ↦ Subtype.ext ?_
  rw [F.coe_fixedWeylGroupMulEquiv_smul hbase hsimply horth, weylGroup.ofIdx_smul,
    Equiv.reflection_smul, F.coe_reflection_toFoldedIndices_apply hbase hsimply horth k x]

@[simp]
theorem coe_fixedWeylGroupMulEquiv_symm_ofIdx (F : P.OrbitSumRealization b σ)
    (hbase : ∀ i : ι, i ∈ b.support ↔ σ.indexEquiv i ∈ b.support)
    (hsimply : b.cartanMatrix.IsSimplyLaced)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0)
    (k : ι) :
    ((F.fixedWeylGroupMulEquiv hbase hsimply horth).symm
      (weylGroup.ofIdx F.pairing (P.toFoldedIndices σ k)) : P.weylGroup) =
      P.orbitReflection σ k
        (P.pairing_eq_zero_of_mem_orbitIndices_of_isSimplyLaced b σ hbase hsimply horth k) := by
  set hk := P.pairing_eq_zero_of_mem_orbitIndices_of_isSimplyLaced b σ hbase hsimply horth k
  have h := (F.fixedWeylGroupMulEquiv hbase hsimply horth).symm_apply_eq.mpr
    (F.fixedWeylGroupMulEquiv_orbitReflection hbase hsimply horth k hk).symm
  exact congrArg Subtype.val h

end OrbitSumRealization

/-- Restriction identifies the conjugation-fixed Weyl subgroup with the Weyl group of an orthogonal
orbit-sum realization, preserving the action on fixed weights (Stembridge, Claim 3). -/
theorem fixed_weyl_group
    (hbase : ∀ i : ι, i ∈ b.support ↔ σ.indexEquiv i ∈ b.support)
    (hsimply : b.cartanMatrix.IsSimplyLaced)
    (horth : ∀ i ∈ b.support, ∀ j ∈ P.orbitIndices σ i, i ≠ j → P.pairing i j = 0)
    (F : P.OrbitSumRealization b σ) :
    ∃ e : P.fixedWeylGroup σ ≃* F.pairing.weylGroup,
      ∀ (w : P.fixedWeylGroup σ) (x : LinearMap.fixedSubmodule σ.weightMap),
        ((e w • x : LinearMap.fixedSubmodule σ.weightMap) : M) =
          ((w : P.weylGroup) • (x : M)) :=
  ⟨F.fixedWeylGroupMulEquiv hbase hsimply horth,
    F.coe_fixedWeylGroupMulEquiv_smul hbase hsimply horth⟩

end Isomorphism

end RootPairing
