/-!
# The extended Rees algebra of an ideal

For an ideal `I` of a commutative semiring `R`, the *extended Rees algebra* `R[It, t⁻¹]` is the
`R`-subalgebra `Ideal.extendedReesAlgebra I` of the Laurent polynomial ring `R[T;T⁻¹]` consisting of
Laurent polynomials whose coefficient in degree `d : ℤ` lies in `I.zFiltration (-d)`: equivalently,
every nonnegative coefficient `f.coeff n` (`n : ℕ`) lies in `I ^ n`, while coefficients in strictly
negative degrees are unconstrained.

Unlike the ordinary Rees algebra `reesAlgebra I = R[It]` inside `R[X]`, which need not contain `t`
as a scalar parameter, `I.extendedReesAlgebra` contains the inverse parameter
`Ideal.extendedReesAlgebra.invT I = T (-1)` (`t⁻¹`) and carries a flat-degeneration family over
`R[t⁻¹]`:

* inverting `invT I` recovers the full Laurent polynomial ring `R[T;T⁻¹]`
  (`Ideal.extendedReesAlgebra.isLocalizationAwayInvT`);
* over a commutative ring `R`, pulling back along `Polynomial.toLaurentAlg` recovers Mathlib's
  `reesAlgebra I` as the subalgebra of elements with vanishing negative-degree coefficients
  (`reesAlgebra.toExtended` and `Ideal.extendedReesAlgebra.mem_range_toExtended_iff`);
* evaluating at `T = 1` gives the `t⁻¹ = 1` generic fibre `(R[It, t⁻¹] ⧸ (t⁻¹ - 1)) ≃ₐ[R] R`
  (`Ideal.extendedReesAlgebra.quotientInvTSubOneEquiv`), while the `t⁻¹ = 0` special fibre is
  identified with `Ideal.AssociatedGraded I` in
  `TauCeti.RingTheory.ReesAlgebra.Extended.AssociatedGraded`.

## Main definitions

* `Ideal.extendedReesAlgebra I`: the extended Rees algebra `R[It, t⁻¹]`, as an `R`-subalgebra of
  `R[T;T⁻¹]`.
* `Ideal.extendedReesAlgebra.invT I`: the inverse parameter `T (-1) ∈ R[It, t⁻¹]`.
* `Ideal.extendedReesAlgebra.monomial I d r hr`: the monomial `C r * T d` in `R[It, t⁻¹]`.
* `Ideal.extendedReesAlgebra.monomialDegreeOne ha`: the degree-one generator `C a * T 1` for
  `a ∈ I`.
* `Ideal.extendedReesAlgebra.map f h`: functoriality along `f : R →+* S` with `I ≤ J.comap f`.
* `Ideal.extendedReesAlgebra.evalOne I` and `Ideal.extendedReesAlgebra.quotientInvTSubOneEquiv I`:
  evaluation at `T = 1` and the isomorphism `(R[It, t⁻¹] ⧸ (t⁻¹ - 1)) ≃ₐ[R] R`.
* `reesAlgebra.toExtended I`: the injective `R`-algebra inclusion `reesAlgebra I →ₐ[R] R[It, t⁻¹]`.

## Main results

* `Ideal.mem_extendedReesAlgebra_iff`: `f ∈ I.extendedReesAlgebra ↔ ∀ n : ℕ, f.coeff n ∈ I ^ n`.
* `Ideal.extendedReesAlgebra.mem_span_invT_iff`: `f ∈ Ideal.span {invT I}` iff
  `(f : R[T;T⁻¹]).coeff n ∈ I ^ (n + 1)` for every `n : ℕ`.
* `Ideal.adjoin_C_mul_T_union_invT_eq_extendedReesAlgebra` and
  `Ideal.extendedReesAlgebra.adjoin_invT_union_monomialDegreeOne_eq_top`: generation over `R` by
  `t⁻¹` and the degree-one elements `a t` (`a ∈ I` or a generating set of `I`).
* `Ideal.extendedReesAlgebra.fg_of_fg` and `Ideal.extendedReesAlgebra.finiteType_of_fg`: finite
  generation as an `R`-algebra when `I.FG`.
* `Ideal.extendedReesAlgebra.isLocalizationAwayInvT`: `R[T;T⁻¹]` is the localization of
  `I.extendedReesAlgebra` away from `invT I`.
* `Ideal.extendedReesAlgebra.ker_evalOne`: the kernel of evaluation at `1` is generated by
  `invT I - 1`.

## References

* D. Eisenbud, *Commutative Algebra with a View Toward Algebraic Geometry*, GTM 150, §6.5.
* H. Matsumura, *Commutative Ring Theory*, Cambridge Studies in Advanced Mathematics 8, §15.
* W. Fulton, *Intersection Theory*, Ergebnisse der Mathematik, 2nd ed., §5.1.
-/

public section

open LaurentPolynomial

namespace Ideal

section Semiring

variable {R : Type*} [CommSemiring R] (I : Ideal R)

/-- The **extended Rees algebra** `R[It, t⁻¹]` of an ideal `I`, realized inside the Laurent
polynomial ring `R[T;T⁻¹]` as the `R`-subalgebra of Laurent polynomials whose `d`-th coefficient
lies in `I.zFiltration (-d)` for every `d : ℤ` (equivalently, `f.coeff n ∈ I ^ n` for every
`n : ℕ`). -/
def extendedReesAlgebra : Subalgebra R R[T;T⁻¹] where
  carrier := {f | ∀ d : ℤ, f.coeff d ∈ I.zFiltration (-d)}
  mul_mem' {f g} hf hg d := by
    rw [AddMonoidAlgebra.coeff_mul, Finsupp.sum]
    refine Submodule.sum_mem _ fun m₁ _ ↦ ?_
    rw [Finsupp.sum]
    refine Submodule.sum_mem _ fun m₂ _ ↦ ?_
    split_ifs with h
    · rw [← h, neg_add]
      exact SetLike.mul_mem_graded (hf m₁) (hg m₂)
    · exact zero_mem _
  add_mem' {f g} hf hg d := by
    rw [AddMonoidAlgebra.coeff_add]
    exact add_mem (hf d) (hg d)
  algebraMap_mem' r d := by
    rw [LaurentPolynomial.algebraMap_apply, LaurentPolynomial.C_apply]
    split_ifs with hd
    · subst hd
      simp
    · exact zero_mem _

variable {I}

/-- Filtration-indexed membership test for `I.extendedReesAlgebra`. -/
theorem mem_extendedReesAlgebra_iff_zFiltration {f : R[T;T⁻¹]} :
    f ∈ I.extendedReesAlgebra ↔ ∀ d : ℤ, f.coeff d ∈ I.zFiltration (-d) :=
  Iff.rfl

/-- **Membership in the extended Rees algebra.** A Laurent polynomial belongs to `R[It, t⁻¹]`
precisely when its coefficient at each nonnegative exponent `n : ℕ` lies in `I ^ n`. -/
theorem mem_extendedReesAlgebra_iff {f : R[T;T⁻¹]} :
    f ∈ I.extendedReesAlgebra ↔ ∀ n : ℕ, f.coeff (n : ℤ) ∈ I ^ n := by
  rw [mem_extendedReesAlgebra_iff_zFiltration]
  refine ⟨fun h n ↦ by simpa using h (n : ℤ), fun h d ↦ ?_⟩
  rcases le_or_gt 0 d with hd | hd
  · obtain ⟨n, rfl⟩ : ∃ n : ℕ, (n : ℤ) = d := ⟨d.toNat, Int.toNat_of_nonneg hd⟩
    simpa using h n
  · rw [I.zFiltration_of_nonneg (by omega)]
    exact Submodule.mem_top

/-- Under Laurent inversion `T ↦ T⁻¹`, `I.extendedReesAlgebra` consists of the Laurent polynomials
whose `j`-th coefficient lies in `I.zFiltration j`. -/
theorem mem_extendedReesAlgebra_iff_invert_coeff {f : R[T;T⁻¹]} :
    f ∈ I.extendedReesAlgebra ↔ ∀ j : ℤ, (invert f).coeff j ∈ I.zFiltration j := by
  rw [mem_extendedReesAlgebra_iff_zFiltration]
  refine ⟨fun h j ↦ ?_, fun h d ↦ ?_⟩
  · simpa [invert] using h (-j)
  · simpa [invert] using h (-d)

/-- A Laurent monomial `C r * T d` lies in `I.extendedReesAlgebra` iff `r ∈ I.zFiltration (-d)`. -/
@[simp]
theorem C_mul_T_mem_extendedReesAlgebra_iff {d : ℤ} {r : R} :
    C r * T d ∈ I.extendedReesAlgebra ↔ r ∈ I.zFiltration (-d) := by
  rw [← single_eq_C_mul_T, mem_extendedReesAlgebra_iff_zFiltration]
  refine ⟨fun h ↦ by simpa using h d, fun hr m ↦ ?_⟩
  rw [AddMonoidAlgebra.coeff_single, Finsupp.single_apply]
  split_ifs with h
  · exact h ▸ hr
  · exact zero_mem _

/-- A nonnegative Laurent monomial `C r * T n` (`n : ℕ`) lies in `I.extendedReesAlgebra` iff
`r ∈ I ^ n`. -/
theorem C_mul_T_natCast_mem_extendedReesAlgebra_iff {n : ℕ} {r : R} :
    C r * T (n : ℤ) ∈ I.extendedReesAlgebra ↔ r ∈ I ^ n := by
  simp

/-- Every nonpositive Laurent monomial `C r * T d` (`d ≤ 0`) belongs to `I.extendedReesAlgebra`. -/
theorem C_mul_T_of_nonpos_mem_extendedReesAlgebra {d : ℤ} (hd : d ≤ 0) (r : R) :
    C r * T d ∈ I.extendedReesAlgebra := by
  rw [C_mul_T_mem_extendedReesAlgebra_iff, I.zFiltration_of_nonneg (neg_nonneg.mpr hd)]
  exact Submodule.mem_top

/-- Every nonpositive power `T d` (`d ≤ 0`) belongs to `I.extendedReesAlgebra`. -/
theorem T_of_nonpos_mem_extendedReesAlgebra {d : ℤ} (hd : d ≤ 0) :
    (T d : R[T;T⁻¹]) ∈ I.extendedReesAlgebra := by
  simpa using C_mul_T_of_nonpos_mem_extendedReesAlgebra (I := I) hd 1

namespace extendedReesAlgebra

variable (I)

/-- The inverse parameter `t⁻¹ = T (-1)` of the extended Rees algebra `R[It, t⁻¹]`. -/
noncomputable def invT : I.extendedReesAlgebra :=
  ⟨T (-1), T_of_nonpos_mem_extendedReesAlgebra (by omega)⟩

@[simp]
theorem coe_invT : (invT I : R[T;T⁻¹]) = T (-1) :=
  (rfl)

theorem coe_invT_pow (k : ℕ) :
    ((invT I ^ k : I.extendedReesAlgebra) : R[T;T⁻¹]) = T (-(k : ℤ)) := by
  rw [SubmonoidClass.coe_pow, coe_invT, T_pow, mul_neg_one]

/-- Multiplication by `invT I` is injective on `I.extendedReesAlgebra`. -/
theorem invT_mul_injective : Function.Injective (invT I * ·) := fun _ _ hxy ↦ by
  apply Subtype.ext
  have h := congr_arg Subtype.val hxy
  simpa only [Subalgebra.coe_mul, coe_invT, (isUnit_T (-1 : ℤ)).mul_right_inj] using h

variable {I} in
/-- **Ideal generated by `t⁻¹`.** An element `f ∈ I.extendedReesAlgebra` is divisible by
`invT I = T (-1)` in `I.extendedReesAlgebra` precisely when its `n`-th Laurent coefficient lies in
`I ^ (n + 1)` for every `n : ℕ`. -/
theorem mem_span_invT_iff {f : I.extendedReesAlgebra} :
    f ∈ Ideal.span {invT I} ↔ ∀ n : ℕ, (f : R[T;T⁻¹]).coeff (n : ℤ) ∈ I ^ (n + 1) := by
  rw [Ideal.mem_span_singleton]
  refine ⟨fun ⟨g, hg⟩ n ↦ ?_, fun hf ↦ ?_⟩
  · have hcoeff : (f : R[T;T⁻¹]).coeff (n : ℤ) = (g : R[T;T⁻¹]).coeff ((n + 1 : ℕ) : ℤ) := by
      have hfg := congr_arg (fun x : I.extendedReesAlgebra ↦ (x : R[T;T⁻¹]).coeff (n : ℤ)) hg
      rw [Subalgebra.coe_mul, coe_invT, coeff_T_mul] at hfg
      exact hfg.trans (congr_arg (g : R[T;T⁻¹]).coeff (by push_cast; omega))
    rw [hcoeff]
    exact mem_extendedReesAlgebra_iff.mp g.2 (n + 1)
  · have hq : T 1 * (f : R[T;T⁻¹]) ∈ I.extendedReesAlgebra := by
      rw [mem_extendedReesAlgebra_iff]
      intro n
      cases n with
      | zero =>
        rw [pow_zero, Ideal.one_eq_top]
        exact Submodule.mem_top
      | succ m =>
        rw [coeff_T_mul]
        have hm : ((m + 1 : ℕ) : ℤ) - 1 = (m : ℤ) := by push_cast; ring
        rw [hm]
        exact hf m
    refine ⟨⟨T 1 * (f : R[T;T⁻¹]), hq⟩, Subtype.ext ?_⟩
    rw [Subalgebra.coe_mul, coe_invT, ← mul_assoc, ← T_add]
    simp

/-- The Laurent monomial `C r * T d` as an element of `I.extendedReesAlgebra`, for
`r ∈ I.zFiltration (-d)`. -/
noncomputable def monomial (d : ℤ) (r : R) (hr : r ∈ I.zFiltration (-d)) :
    I.extendedReesAlgebra :=
  ⟨C r * T d, C_mul_T_mem_extendedReesAlgebra_iff.mpr hr⟩

@[simp]
theorem coe_monomial (d : ℤ) (r : R) (hr : r ∈ I.zFiltration (-d)) :
    (monomial I d r hr : R[T;T⁻¹]) = C r * T d :=
  (rfl)

variable {I} in
/-- Each single-monomial component of `f ∈ I.extendedReesAlgebra` lies in
`I.extendedReesAlgebra`. -/
theorem coeff_C_mul_T_mem (f : I.extendedReesAlgebra) (d : ℤ) :
    C ((f : R[T;T⁻¹]).coeff d) * T d ∈ I.extendedReesAlgebra :=
  C_mul_T_mem_extendedReesAlgebra_iff.mpr (mem_extendedReesAlgebra_iff_zFiltration.mp f.2 d)

variable {I} in
/-- Finite support expansion of an element of `I.extendedReesAlgebra` into its Laurent monomials. -/
theorem as_sum_support (f : I.extendedReesAlgebra) :
    f = ∑ d ∈ (f : R[T;T⁻¹]).coeff.support,
      monomial I d ((f : R[T;T⁻¹]).coeff d)
        (mem_extendedReesAlgebra_iff_zFiltration.mp f.2 d) := by
  apply Subtype.ext
  rw [AddSubmonoidClass.coe_finsetSum]
  simp_rw [coe_monomial, ← single_eq_C_mul_T]
  exact (AddMonoidAlgebra.sum_coeff_single (f : R[T;T⁻¹])).symm

variable {I}

/-- The degree-one generator `a t = C a * T 1` of `I.extendedReesAlgebra`, for `a ∈ I`. -/
noncomputable def monomialDegreeOne {a : R} (ha : a ∈ I) : I.extendedReesAlgebra :=
  monomial I 1 a (by simpa using ha)

@[simp]
theorem coe_monomialDegreeOne {a : R} (ha : a ∈ I) :
    (monomialDegreeOne ha : R[T;T⁻¹]) = C a * T 1 :=
  (rfl)

/-- The `R`-algebra map `R[X] →ₐ[R] I.extendedReesAlgebra` sending `X` to the inverse parameter
`invT I`. Installed on demand via `(invTAlgHom I).toRingHom.toAlgebra` to avoid conflicting with
Mathlib's `LaurentPolynomial.algebraPolynomial`, which sends `X` to `T 1`. -/
noncomputable def invTAlgHom (I : Ideal R) : Polynomial R →ₐ[R] I.extendedReesAlgebra :=
  Polynomial.aeval (invT I)

@[simp]
theorem invTAlgHom_X (I : Ideal R) : invTAlgHom I Polynomial.X = invT I :=
  Polynomial.aeval_X _

/-! ### Generators and finiteness -/

private theorem C_mul_T_natCast_mem_adjoin {s : Set R} (hs : Ideal.span s = I) :
    ∀ {n : ℕ} {r : R}, r ∈ I ^ n →
      C r * T (n : ℤ) ∈
        Algebra.adjoin R (({T (-1)} : Set R[T;T⁻¹]) ∪ (fun a ↦ C a * T 1) '' s) := by
  set A : Subalgebra R R[T;T⁻¹] :=
    Algebra.adjoin R (({T (-1)} : Set R[T;T⁻¹]) ∪ (fun a ↦ C a * T 1) '' s)
  intro n r hr
  rw [← hs] at hr
  induction hr using Submodule.pow_induction_on_left' with
  | algebraMap c =>
    simpa [← C_eq_algebraMap] using A.algebraMap_mem c
  | add x y _ _ _ hx hy =>
    simpa [add_mul] using A.add_mem hx hy
  | mem_mul m hm k x _ ih =>
    have hm1 : C m * T 1 ∈ A := by
      induction hm using Submodule.span_induction with
      | mem a ha => exact Algebra.subset_adjoin (Or.inr ⟨a, ha, rfl⟩)
      | zero => simp
      | add a b _ _ ha hb => simpa [add_mul] using A.add_mem ha hb
      | smul c a _ ha =>
        simpa [smul_eq_mul, mul_assoc, ← smul_eq_C_mul] using A.smul_mem ha c
    have hmul : (C m * T 1) * (C x * T (k : ℤ)) = C (m * x) * T ((k + 1 : ℕ) : ℤ) := by
      rw [Nat.cast_add_one, add_comm (k : ℤ) 1, T_add, map_mul]
      ring
    exact hmul ▸ A.mul_mem hm1 ih

/-- **Ambient generation.** If `s` generates `I`, then `I.extendedReesAlgebra` is generated inside
`R[T;T⁻¹]` over `R` by `T (-1)` together with the degree-one monomials `C a * T 1` (`a ∈ s`). -/
theorem _root_.Ideal.adjoin_invT_union_image_eq_extendedReesAlgebra {s : Set R}
    (hs : Ideal.span s = I) :
    Algebra.adjoin R (({T (-1)} : Set R[T;T⁻¹]) ∪ (fun a ↦ C a * T 1) '' s) =
      I.extendedReesAlgebra := by
  set A : Subalgebra R R[T;T⁻¹] :=
    Algebra.adjoin R (({T (-1)} : Set R[T;T⁻¹]) ∪ (fun a ↦ C a * T 1) '' s)
  refine le_antisymm (Algebra.adjoin_le ?_) fun f hf ↦ ?_
  · rintro _ (rfl | ⟨a, ha, rfl⟩)
    · exact T_of_nonpos_mem_extendedReesAlgebra (by omega)
    · exact C_mul_T_natCast_mem_extendedReesAlgebra_iff (n := 1) |>.mpr
        (by rw [pow_one, ← hs]; exact Ideal.subset_span ha)
  · rw [← AddMonoidAlgebra.sum_coeff_single f, Finsupp.sum]
    refine _root_.sum_mem fun d _ ↦ ?_
    rw [single_eq_C_mul_T]
    rcases le_or_gt 0 d with hd | hd
    · obtain ⟨n, rfl⟩ : ∃ n : ℕ, (n : ℤ) = d := ⟨d.toNat, Int.toNat_of_nonneg hd⟩
      exact C_mul_T_natCast_mem_adjoin hs (mem_extendedReesAlgebra_iff.mp hf n)
    · obtain ⟨k, rfl⟩ : ∃ k : ℕ, -(k : ℤ) = d := ⟨(-d).toNat, by omega⟩
      have hT : (T (-1) : R[T;T⁻¹]) ^ k = T (-(k : ℤ)) := by rw [T_pow, mul_neg_one]
      rw [← hT, C_eq_algebraMap]
      exact A.mul_mem (A.algebraMap_mem _) (A.pow_mem (Algebra.subset_adjoin (Or.inl rfl)) k)

/-- `I.extendedReesAlgebra` is generated over `R` inside `R[T;T⁻¹]` by `T (-1)` and `C a * T 1`
for `a ∈ I`. -/
theorem _root_.Ideal.adjoin_C_mul_T_union_invT_eq_extendedReesAlgebra (I : Ideal R) :
    Algebra.adjoin R (({T (-1)} : Set R[T;T⁻¹]) ∪ (fun a ↦ C a * T 1) '' (I : Set R)) =
      I.extendedReesAlgebra :=
  adjoin_invT_union_image_eq_extendedReesAlgebra (Ideal.span_eq I)

/-- **Internal generation.** If `s` generates `I`, then `invT I` and the elements
`monomialDegreeOne` for `a ∈ s` generate `I.extendedReesAlgebra` as an `R`-algebra. -/
theorem adjoin_invT_union_monomialDegreeOne_eq_top {s : Set R} (hs : Ideal.span s = I) :
    Algebra.adjoin R (({invT I} : Set I.extendedReesAlgebra) ∪
      Set.range fun a : s ↦ monomialDegreeOne (hs ▸ Ideal.subset_span a.2)) = ⊤ := by
  refine Subalgebra.map_injective (f := I.extendedReesAlgebra.val) Subtype.val_injective ?_
  rw [AlgHom.map_adjoin, Algebra.map_top, Subalgebra.range_val]
  refine Eq.trans ?_ (Ideal.adjoin_invT_union_image_eq_extendedReesAlgebra hs)
  congr 1
  ext g
  constructor
  · rintro ⟨x, rfl | ⟨⟨a, ha⟩, rfl⟩, rfl⟩
    · exact Or.inl rfl
    · exact Or.inr ⟨a, ha, rfl⟩
  · rintro (rfl | ⟨a, ha, rfl⟩)
    · exact ⟨invT I, Or.inl rfl, rfl⟩
    · exact ⟨monomialDegreeOne (hs ▸ Ideal.subset_span ha), Or.inr ⟨⟨a, ha⟩, rfl⟩, rfl⟩

/-- If `I` is finitely generated, then `I.extendedReesAlgebra` is finitely generated as an
`R`-subalgebra of `R[T;T⁻¹]`. -/
theorem fg_of_fg (hI : I.FG) : I.extendedReesAlgebra.FG := by
  classical
  obtain ⟨s, hs⟩ := hI
  refine ⟨insert (T (-1)) (s.image fun a ↦ C a * T 1), ?_⟩
  rw [Finset.coe_insert, Finset.coe_image, ← Set.singleton_union]
  exact Ideal.adjoin_invT_union_image_eq_extendedReesAlgebra hs

/-- If `I` is finitely generated, then `I.extendedReesAlgebra` is a finitely generated
`R`-algebra. -/
theorem finiteType_of_fg (hI : I.FG) : Algebra.FiniteType R I.extendedReesAlgebra :=
  ⟨I.extendedReesAlgebra.fg_top.mpr (fg_of_fg hI)⟩

variable (I) in
/-- Over a Noetherian commutative semiring `R`, `I.extendedReesAlgebra` is of finite type over
`R`. -/
instance [IsNoetherianRing R] : Algebra.FiniteType R I.extendedReesAlgebra :=
  finiteType_of_fg (IsNoetherian.noetherian I)

/-! ### Localization away from `t⁻¹` -/

variable (I) in
/-- **Generic localization.** Inverting the parameter `invT I = T (-1)` in `I.extendedReesAlgebra`
recovers the ambient Laurent polynomial ring `R[T;T⁻¹]`, for any ideal `I` (including `I = ⊥`). -/
instance isLocalizationAwayInvT : IsLocalization.Away (invT I) R[T;T⁻¹] := by
  apply IsLocalization.Away.mk
  · exact isUnit_T (-1)
  · intro g
    induction g using LaurentPolynomial.induction_on' with
    | add p q hp hq =>
      obtain ⟨k₁, x₁, hx₁⟩ := hp
      obtain ⟨k₂, x₂, hx₂⟩ := hq
      have hx₁' : p * T (-1) ^ k₁ = (x₁ : R[T;T⁻¹]) := hx₁
      have hx₂' : q * T (-1) ^ k₂ = (x₂ : R[T;T⁻¹]) := hx₂
      refine ⟨k₁ + k₂, x₁ * invT I ^ k₂ + x₂ * invT I ^ k₁, ?_⟩
      -- Unfold the subalgebra inclusion on both sides to compute in `R[T;T⁻¹]`.
      change (p + q) * T (-1) ^ (k₁ + k₂) =
        (x₁ : R[T;T⁻¹]) * T (-1) ^ k₂ + (x₂ : R[T;T⁻¹]) * T (-1) ^ k₁
      calc
        (p + q) * T (-1) ^ (k₁ + k₂)
            = p * T (-1) ^ k₁ * T (-1) ^ k₂ + q * T (-1) ^ k₂ * T (-1) ^ k₁ := by ring
        _ = (x₁ : R[T;T⁻¹]) * T (-1) ^ k₂ + (x₂ : R[T;T⁻¹]) * T (-1) ^ k₁ := by
              rw [← hx₁', ← hx₂']
    | C_mul_T d r =>
      refine ⟨d.toNat, ⟨C r * T (d - d.toNat),
        C_mul_T_of_nonpos_mem_extendedReesAlgebra (by omega) r⟩, ?_⟩
      -- Unfold the subalgebra inclusion on both sides to compute in `R[T;T⁻¹]`.
      change C r * T d * T (-1) ^ d.toNat = C r * T (d - d.toNat)
      rw [T_pow, mul_assoc, ← T_add]
      congr 2
      omega
  · intro x y hxy
    exact ⟨0, by simp [Subtype.ext hxy]⟩

/-! ### Functoriality -/

section Map

variable {S : Type*} [CommSemiring S] {J : Ideal S}

/-- The ring homomorphism `I.extendedReesAlgebra →+* J.extendedReesAlgebra` induced by a ring
homomorphism `f : R →+* S` satisfying `I ≤ J.comap f`. -/
noncomputable def map (f : R →+* S) (h : I ≤ J.comap f) :
    I.extendedReesAlgebra →+* J.extendedReesAlgebra :=
  ((AddMonoidAlgebra.mapRingHom (M := ℤ) f).comp I.extendedReesAlgebra.val.toRingHom).codRestrict
    J.extendedReesAlgebra.toSubsemiring fun x ↦
      Ideal.mem_extendedReesAlgebra_iff_zFiltration.mpr fun d ↦ by
        rw [RingHom.comp_apply]
        exact (AddMonoidAlgebra.coeff_mapRingHom f (x : R[T;T⁻¹]) d).symm ▸
          Ideal.map_mem_zFiltration_of_le_comap f h
            (Ideal.mem_extendedReesAlgebra_iff_zFiltration.mp x.2 d)

@[simp]
theorem coe_map_apply (f : R →+* S) (h : I ≤ J.comap f) (x : I.extendedReesAlgebra) :
    (map f h x : S[T;T⁻¹]) = AddMonoidAlgebra.mapRingHom (M := ℤ) f (x : R[T;T⁻¹]) :=
  (rfl)

theorem coeff_map_apply (f : R →+* S) (h : I ≤ J.comap f) (x : I.extendedReesAlgebra) (d : ℤ) :
    (map f h x : S[T;T⁻¹]).coeff d = f ((x : R[T;T⁻¹]).coeff d) :=
  AddMonoidAlgebra.coeff_mapRingHom f (x : R[T;T⁻¹]) d

@[simp]
theorem map_invT (f : R →+* S) (h : I ≤ J.comap f) : map f h (invT I) = invT J := by
  apply Subtype.ext
  rw [coe_map_apply, coe_invT, coe_invT, T, T, AddMonoidAlgebra.mapRingHom_single, map_one]

@[simp]
theorem map_monomial (f : R →+* S) (h : I ≤ J.comap f) (d : ℤ) (r : R)
    (hr : r ∈ I.zFiltration (-d)) :
    map f h (monomial I d r hr) =
      monomial J d (f r) (Ideal.map_mem_zFiltration_of_le_comap f h hr) := by
  apply Subtype.ext
  rw [coe_map_apply, coe_monomial, coe_monomial, ← single_eq_C_mul_T, ← single_eq_C_mul_T,
    AddMonoidAlgebra.mapRingHom_single]

@[simp]
theorem map_monomialDegreeOne (f : R →+* S) (h : I ≤ J.comap f) {a : R} (ha : a ∈ I) :
    map f h (monomialDegreeOne ha) = monomialDegreeOne (Ideal.mem_comap.mp (h ha)) :=
  map_monomial f h 1 a (by simpa using ha)

@[simp]
theorem map_algebraMap (f : R →+* S) (h : I ≤ J.comap f) (r : R) :
    map f h (algebraMap R I.extendedReesAlgebra r) = algebraMap S J.extendedReesAlgebra (f r) := by
  apply Subtype.ext
  rw [coe_map_apply, Subalgebra.coe_algebraMap, Subalgebra.coe_algebraMap,
    LaurentPolynomial.algebraMap_apply, LaurentPolynomial.algebraMap_apply,
    Algebra.algebraMap_self, Algebra.algebraMap_self, RingHom.id_apply, RingHom.id_apply,
    ← single_eq_C, ← single_eq_C, AddMonoidAlgebra.mapRingHom_single]

@[simp]
theorem map_id (h : I ≤ I.comap (RingHom.id R)) : map (RingHom.id R) h = RingHom.id _ := by
  ext x : 2
  simp

theorem map_comp {U : Type*} [CommSemiring U] {K : Ideal U} (g : S →+* U) (f : R →+* S)
    (hJK : J ≤ K.comap g) (hIJ : I ≤ J.comap f) (hIK : I ≤ K.comap (g.comp f)) :
    (map g hJK).comp (map f hIJ) = map (g.comp f) hIK := by
  ext x : 2
  simp

end Map

/-! ### Evaluation at `T = 1` -/

variable (I) in
/-- Evaluation at `T = 1` (`t⁻¹ = 1`), an `R`-algebra map `I.extendedReesAlgebra →ₐ[R] R` summing
the coefficients of a Laurent polynomial. -/
noncomputable def evalOne : I.extendedReesAlgebra →ₐ[R] R :=
  (TauCeti.laurentEval (1 : Rˣ)).comp I.extendedReesAlgebra.val

theorem evalOne_apply (f : I.extendedReesAlgebra) :
    evalOne I f = TauCeti.laurentEval (1 : Rˣ) (f : R[T;T⁻¹]) :=
  (rfl)

@[simp]
theorem evalOne_invT : evalOne I (invT I) = 1 := by
  simp [evalOne_apply, invT]

@[simp]
theorem evalOne_monomial (d : ℤ) (r : R) (hr : r ∈ I.zFiltration (-d)) :
    evalOne I (monomial I d r hr) = r := by
  simp [evalOne_apply, monomial]

@[simp]
theorem evalOne_monomialDegreeOne {a : R} (ha : a ∈ I) :
    evalOne I (monomialDegreeOne ha) = a :=
  evalOne_monomial 1 a (by simpa using ha)

variable (I) in
/-- Evaluation at `1` is surjective onto `R`. -/
theorem evalOne_surjective : Function.Surjective (evalOne I) :=
  fun r ↦ ⟨algebraMap R _ r, (evalOne I).commutes r⟩

end extendedReesAlgebra

end Semiring

end Ideal

/-! ### Comparison with `reesAlgebra I`, Noetherianity, and the `t⁻¹ = 1` fibre -/

section CommRing

variable {R : Type*} [CommRing R] (I : Ideal R)

variable {I} in
/-- Truncating negative exponents sends `I.extendedReesAlgebra` into `reesAlgebra I`. -/
theorem LaurentPolynomial.trunc_mem_reesAlgebra {f : R[T;T⁻¹]}
    (hf : f ∈ I.extendedReesAlgebra) : trunc f ∈ reesAlgebra I :=
  (mem_reesAlgebra_iff I _).mpr fun n ↦ by
    rw [coeff_trunc]
    exact Ideal.mem_extendedReesAlgebra_iff.mp hf n

variable {I} in
/-- An ordinary polynomial `p ∈ R[X]` maps into `I.extendedReesAlgebra` under `toLaurent` precisely
when `p ∈ reesAlgebra I`. -/
@[simp]
theorem Polynomial.toLaurent_mem_extendedReesAlgebra_iff {p : Polynomial R} :
    p.toLaurent ∈ I.extendedReesAlgebra ↔ p ∈ reesAlgebra I := by
  rw [Ideal.mem_extendedReesAlgebra_iff, mem_reesAlgebra_iff]
  refine forall_congr' fun n ↦ ?_
  rw [← coeff_trunc, Polynomial.trunc_toLaurent]

/-- Pulling `I.extendedReesAlgebra` back along `Polynomial.toLaurentAlg` recovers
`reesAlgebra I`. -/
@[simp]
theorem Ideal.comap_toLaurentAlg_extendedReesAlgebra :
    I.extendedReesAlgebra.comap Polynomial.toLaurentAlg = reesAlgebra I := by
  ext p
  exact Polynomial.toLaurent_mem_extendedReesAlgebra_iff

/-- **Inclusion of the ordinary Rees algebra into the extended Rees algebra.** -/
noncomputable def reesAlgebra.toExtended :
    reesAlgebra I →ₐ[R] I.extendedReesAlgebra :=
  (Polynomial.toLaurentAlg.comp (reesAlgebra I).val).codRestrict I.extendedReesAlgebra fun f ↦
    Polynomial.toLaurent_mem_extendedReesAlgebra_iff.mpr f.2

variable {I} in
@[simp]
theorem reesAlgebra.coe_toExtended (f : reesAlgebra I) :
    (reesAlgebra.toExtended I f : R[T;T⁻¹]) = (f : Polynomial R).toLaurent :=
  (rfl)

/-- The canonical map `reesAlgebra I →ₐ[R] I.extendedReesAlgebra` is injective. -/
theorem reesAlgebra.toExtended_injective :
    Function.Injective (reesAlgebra.toExtended I) := fun _ _ hxy ↦
  Subtype.ext <| Polynomial.toLaurent_injective (congr_arg Subtype.val hxy)

namespace Ideal.extendedReesAlgebra

/-- Over a Noetherian commutative ring `R`, `I.extendedReesAlgebra` is Noetherian. -/
instance [IsNoetherianRing R] : IsNoetherianRing I.extendedReesAlgebra :=
  Algebra.FiniteType.isNoetherianRing R _

variable {I}

/-- **Range of `reesAlgebra.toExtended`.** An element of `I.extendedReesAlgebra` comes from
`reesAlgebra I` precisely when all of its strictly negative Laurent coefficients vanish. -/
theorem mem_range_toExtended_iff {f : I.extendedReesAlgebra} :
    f ∈ (reesAlgebra.toExtended I).range ↔ ∀ d < 0, (f : R[T;T⁻¹]).coeff d = 0 := by
  rw [← TauCeti.exists_toLaurent_eq_iff]
  refine ⟨fun ⟨p, hp⟩ ↦ ⟨p, congr_arg Subtype.val hp⟩, fun ⟨p, hp⟩ ↦ ?_⟩
  have hpI : p ∈ reesAlgebra I :=
    Polynomial.toLaurent_mem_extendedReesAlgebra_iff.mp (hp ▸ f.2)
  exact ⟨⟨p, hpI⟩, Subtype.ext hp⟩

private theorem monomial_natCast_sub_algebraMap_mem_span_invT_sub_one (n : ℕ) (r : R)
    (hr : r ∈ I.zFiltration (-(n : ℤ))) :
    monomial I (n : ℤ) r hr - algebraMap R I.extendedReesAlgebra r ∈
      Ideal.span {invT I - 1} := by
  induction n with
  | zero =>
    have heq : monomial I (0 : ℤ) r hr = algebraMap R _ r := by
      apply Subtype.ext
      rw [coe_monomial, T_zero, mul_one, Subalgebra.coe_algebraMap,
        LaurentPolynomial.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]
    simp [heq]
  | succ n ih =>
    have hr' : r ∈ I.zFiltration (-(n : ℤ)) :=
      I.zFiltration_mono (by omega : -(n + 1 : ℤ) ≤ -(n : ℤ)) (by simpa using hr)
    have hstep :
        monomial I ((n + 1 : ℕ) : ℤ) r hr - algebraMap R _ r =
          -monomial I ((n + 1 : ℕ) : ℤ) r hr * (invT I - 1) +
            (monomial I (n : ℤ) r hr' - algebraMap R _ r) := by
      apply Subtype.ext
      push_cast [coe_monomial, coe_invT]
      rw [T_add]
      have hT : (T 1 : R[T;T⁻¹]) * T (-1) = 1 := by rw [← T_add]; simp
      calc
        C r * (T (n : ℤ) * T 1) - algebraMap R R[T;T⁻¹] r
            = -(C r * (T (n : ℤ) * (T 1 * T (-1)))) + C r * (T (n : ℤ) * T 1) +
                (C r * T (n : ℤ) - algebraMap R R[T;T⁻¹] r) := by
              rw [hT, mul_one]; ring
        _ = -(C r * (T (n : ℤ) * T 1)) * (T (-1) - 1) +
              (C r * T (n : ℤ) - algebraMap R R[T;T⁻¹] r) := by ring
    rw [hstep]
    exact add_mem (Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)) (ih hr')

private theorem monomial_sub_algebraMap_mem_span_invT_sub_one (d : ℤ) (r : R)
    (hr : r ∈ I.zFiltration (-d)) :
    monomial I d r hr - algebraMap R I.extendedReesAlgebra r ∈ Ideal.span {invT I - 1} := by
  rcases le_or_gt 0 d with hd | hd
  · obtain ⟨n, rfl⟩ : ∃ n : ℕ, (n : ℤ) = d := ⟨d.toNat, Int.toNat_of_nonneg hd⟩
    exact monomial_natCast_sub_algebraMap_mem_span_invT_sub_one n r hr
  · obtain ⟨k, rfl⟩ : ∃ k : ℕ, -(k : ℤ) = d := ⟨(-d).toNat, by omega⟩
    have heq : monomial I (-(k : ℤ)) r hr - algebraMap R _ r =
        algebraMap R _ r * (invT I ^ k - 1) := by
      apply Subtype.ext
      rw [Subalgebra.coe_sub, coe_monomial, Subalgebra.coe_mul, Subalgebra.coe_sub,
        Subalgebra.coe_algebraMap, coe_invT_pow, OneMemClass.coe_one,
        LaurentPolynomial.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
        mul_sub, mul_one]
    rw [heq]
    obtain ⟨q, hq⟩ : invT I - 1 ∣ invT I ^ k - 1 := by
      simpa using sub_dvd_pow_sub_pow (invT I) 1 k
    have hmul : algebraMap R _ r * (invT I ^ k - 1) = (algebraMap R _ r * q) * (invT I - 1) := by
      rw [hq]; ring
    rw [hmul]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)

variable (I)

/-- **Kernel at `t⁻¹ = 1`.** The kernel of evaluation at `T = 1` on `I.extendedReesAlgebra` is
generated by `invT I - 1`. -/
theorem ker_evalOne :
    RingHom.ker (evalOne I : I.extendedReesAlgebra →+* R) = Ideal.span {invT I - 1} := by
  refine le_antisymm (fun f hf ↦ ?_) (Ideal.span_le.mpr ?_)
  · rw [RingHom.mem_ker, AlgHom.coe_toRingHom] at hf
    have hsum : ∑ d ∈ (f : R[T;T⁻¹]).coeff.support, (f : R[T;T⁻¹]).coeff d = 0 := by
      simpa [evalOne_apply, LaurentPolynomial.laurentEval_one_eq_sum, Finsupp.sum] using hf
    have hf_eq : f = ∑ d ∈ (f : R[T;T⁻¹]).coeff.support,
        (monomial I d ((f : R[T;T⁻¹]).coeff d)
          (Ideal.mem_extendedReesAlgebra_iff_zFiltration.mp f.2 d) -
            algebraMap R _ ((f : R[T;T⁻¹]).coeff d)) := by
      rw [Finset.sum_sub_distrib, ← map_sum, hsum, map_zero, sub_zero]
      exact as_sum_support f
    rw [hf_eq]
    exact Ideal.sum_mem _ fun d _ ↦
      monomial_sub_algebraMap_mem_span_invT_sub_one d _
        (Ideal.mem_extendedReesAlgebra_iff_zFiltration.mp f.2 d)
  · rintro _ (rfl : _ = invT I - 1)
    simp [RingHom.mem_ker]

/-- **Generic fibre at `t⁻¹ = 1`.** Quotienting the extended Rees algebra `R[It, t⁻¹]` by
`invT I - 1` recovers `R`. -/
noncomputable def quotientInvTSubOneEquiv :
    (I.extendedReesAlgebra ⧸ Ideal.span {invT I - 1}) ≃ₐ[R] R :=
  (Ideal.quotientEquivAlgOfEq R (ker_evalOne I).symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective (evalOne_surjective I))

@[simp]
theorem quotientInvTSubOneEquiv_mk (f : I.extendedReesAlgebra) :
    quotientInvTSubOneEquiv I (Ideal.Quotient.mk _ f) = evalOne I f :=
  (rfl)

@[simp]
theorem quotientInvTSubOneEquiv_symm_apply (r : R) :
    (quotientInvTSubOneEquiv I).symm r = Ideal.Quotient.mk _ (algebraMap R _ r) := by
  apply (quotientInvTSubOneEquiv I).symm_apply_eq.mpr
  simp

end Ideal.extendedReesAlgebra

end CommRing
