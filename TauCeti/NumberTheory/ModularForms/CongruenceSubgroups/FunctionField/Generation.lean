/-!
# Arithmetic generation and `SL(2, ℤ/Nℤ)`-stability of `F_N`

For any subfield `K ⊆ ℂ` containing the Laurent `q_N`-expansion coefficients of all Fricke functions
`f_a` (in particular `K = ℚ(ζ_N)`, by `TauCeti.frickeMeromorphicFunction_mem_modularFunctionField`),
the subfield of the coefficient field generated over `K(j)` by `{f_a : a ≠ 0}` is stable under the
right action of `SL(2, ℤ/Nℤ)`, which permutes the Fricke functions faithfully up to `±1`. Comparing
the resulting Artin lower bound on the degree over `K(j)` with the upper bound
`TauCeti.finrank_adjoin_modularFunctionJ_le` identifies the two fields.

In particular, `F_N = ℚ(ζ_N)(j, f_a : a ≠ 0)` (`TauCeti.modularFunctionField_eq_closure`), its
degree over `ℚ(ζ_N)(j)` equals the order of the image of `SL(2, ℤ/Nℤ)`
(`TauCeti.finrank_adjoin_modularFunctionJ_cyclotomic`), and `F_N` is preserved by the fractional
linear actions of `SL(2, ℤ/Nℤ)` and `SL(2, ℤ)`
(`TauCeti.unop_modularFunctionActionZMod_mem_modularFunctionField`,
`TauCeti.unop_modularFunctionAction_mem_modularFunctionField`).

## Main declarations

* `TauCeti.modularFunctionField_eq_closure`: `F_N = ℚ(ζ_N)(j, f_a : a ≠ 0)`.
* `TauCeti.finrank_adjoin_modularFunctionJ_cyclotomic`: `[F_N : ℚ(ζ_N)(j)] = |im(SL(2, ℤ/Nℤ))|`.
* `TauCeti.unop_modularFunctionActionZMod_mem_modularFunctionField` and
  `TauCeti.unop_modularFunctionAction_mem_modularFunctionField`: stability of `F_N` under
  `SL(2, ℤ/Nℤ)` and `SL(2, ℤ)`.

## References

* Goro Shimura, *Introduction to the Arithmetic Theory of Automorphic Functions*, Princeton
  University Press, 1971, §6.1.
* Serge Lang, *Elliptic Functions*, 2nd ed., Graduate Texts in Mathematics 112, Springer, 1987,
  Chapter 6, §§2–3.
-/

public noncomputable section

open CongruenceSubgroup MulOpposite UpperHalfPlane
open Subgroup.CompactifiedQuotient TauCeti.RiemannSurface
open scoped IntermediateField Matrix MatrixGroups

namespace TauCeti

variable {N : ℕ} [NeZero N]

/-! ### Arithmetic generation of `F_N` and stability under `SL(2, ℤ/Nℤ)` -/

/-- Every automorphism in the image of `SL(2, ℤ/Nℤ)` fixes `K(j)` pointwise for any subfield `K`
of `ℂ`. -/
private theorem modularFunctionActionZMod_fix_adjoin_j (K : Subfield ℂ)
    (τ : (modularFunctionActionZMod N).range.unop)
    (x : K⟮modularFunctionJ N K⟯) :
    τ.1 ((coeffIntermediateField (cuspDatumInftyGamma N) K).val x.1) =
      (coeffIntermediateField (cuspDatumInftyGamma N) K).val x.1 := by
  let F_K := coeffIntermediateField (cuspDatumInftyGamma N) K
  obtain ⟨g, hg⟩ := Subgroup.mem_unop.mp τ.2
  have hτ : τ.1 = unop (modularFunctionActionZMod N g) := by
    rw [← unop_op τ.1, ← hg]
  let P : IntermediateField K F_K :=
    { carrier := {y : F_K | τ.1 (F_K.val y) = F_K.val y}
      mul_mem' := fun {u v} hu hv ↦ by
        change τ.1 (F_K.val (u * v)) = F_K.val (u * v)
        rw [map_mul, map_mul, hu, hv]
      one_mem' := by
        change τ.1 (F_K.val 1) = F_K.val 1
        rw [map_one, map_one]
      add_mem' := fun {u v} hu hv ↦ by
        change τ.1 (F_K.val (u + v)) = F_K.val (u + v)
        rw [map_add, map_add, hu, hv]
      zero_mem' := by
        change τ.1 (F_K.val 0) = F_K.val 0
        rw [map_zero, map_zero]
      inv_mem' := fun {u} hu ↦ by
        change τ.1 (F_K.val u⁻¹) = F_K.val u⁻¹
        rw [map_inv₀, map_inv₀, hu]
      algebraMap_mem' := fun c ↦ by
        change τ.1 (F_K.val (algebraMap K F_K c)) = F_K.val (algebraMap K F_K c)
        rw [F_K.val.commutes]
        exact τ.1.commutes (c : ℂ) }
  have hle : K⟮modularFunctionJ N K⟯ ≤ P := IntermediateField.adjoin_le_iff.mpr fun z hz ↦ by
    rw [Set.mem_singleton_iff.mp hz]
    change τ.1 (F_K.val (modularFunctionJ N K)) = F_K.val (modularFunctionJ N K)
    rw [IntermediateField.coe_val, coe_modularFunctionJ, hτ,
      unop_modularFunctionActionZMod_compactifiedQuotientComap]
  exact hle x.2

/-- The subfield generated by `j`, `K`, and `{f_a : a ≠ 0}` is stable under the image of
`SL(2, ℤ/Nℤ)`. -/
private theorem frickeClosure_le_comap_modularFunctionActionZMod (K : Subfield ℂ)
    (τ : (modularFunctionActionZMod N).range.unop) :
    Subfield.closure
        (insert (Subgroup.compactifiedQuotientComap
            (Gamma N).map_sl2zToPSL2R_le_range_psl2zToPSL2R ModularGroup.jMeromorphicFunction)
          ((algebraMap ℂ _ '' K) ∪ (frickeMeromorphicFunction '' {a : Fin 2 → ZMod N | a ≠ 0}))) ≤
      (Subfield.closure
        (insert (Subgroup.compactifiedQuotientComap
            (Gamma N).map_sl2zToPSL2R_le_range_psl2zToPSL2R ModularGroup.jMeromorphicFunction)
          ((algebraMap ℂ _ '' K) ∪
            (frickeMeromorphicFunction '' {a : Fin 2 → ZMod N | a ≠ 0})))).comap
        τ.1.toRingHom := by
  let G := Subfield.closure
    (insert (Subgroup.compactifiedQuotientComap
        (Gamma N).map_sl2zToPSL2R_le_range_psl2zToPSL2R ModularGroup.jMeromorphicFunction)
      ((algebraMap ℂ _ '' K) ∪ (frickeMeromorphicFunction '' {a : Fin 2 → ZMod N | a ≠ 0})))
  obtain ⟨g, hg⟩ := Subgroup.mem_unop.mp τ.2
  have hτ : τ.1 = unop (modularFunctionActionZMod N g) := by
    rw [← unop_op τ.1, ← hg]
  change G ≤ G.comap τ.1.toRingHom
  rw [Subfield.closure_le, Set.insert_subset_iff, Set.union_subset_iff]
  refine ⟨?_, ?_, ?_⟩
  · change τ.1 _ ∈ G
    rw [hτ, unop_modularFunctionActionZMod_compactifiedQuotientComap]
    exact Subfield.subset_closure (Set.mem_insert _ _)
  · rintro _ ⟨c, hc, rfl⟩
    change τ.1 (algebraMap ℂ _ c) ∈ G
    rw [AlgEquiv.commutes]
    exact Subfield.subset_closure (Set.mem_insert_of_mem _ (Set.mem_union_left _ ⟨c, hc, rfl⟩))
  · rintro _ ⟨a, ha, rfl⟩
    change τ.1 (frickeMeromorphicFunction a) ∈ G
    rw [hτ, unop_modularFunctionActionZMod_frickeMeromorphicFunction]
    have hga : a ᵥ* (g : Matrix (Fin 2) (Fin 2) (ZMod N)) ≠ 0 := fun h ↦ ha <| by
      simpa using Matrix.vecMul_injective_of_isUnit g.toGL.isUnit (by simpa using h)
    exact Subfield.subset_closure (Set.mem_insert_of_mem _ (Set.mem_union_right _ ⟨_, hga, rfl⟩))

/-- Every element of `K(j)` lies in the subfield generated by `j`, `K`, and `{f_a : a ≠ 0}`. -/
private theorem coe_adjoin_j_mem_frickeClosure (K : Subfield ℂ) (c : K⟮modularFunctionJ N K⟯) :
    (coeffIntermediateField (cuspDatumInftyGamma N) K).val c.1 ∈
      Subfield.closure
        (insert (Subgroup.compactifiedQuotientComap
            (Gamma N).map_sl2zToPSL2R_le_range_psl2zToPSL2R ModularGroup.jMeromorphicFunction)
          ((algebraMap ℂ _ '' K) ∪
            (frickeMeromorphicFunction '' {a : Fin 2 → ZMod N | a ≠ 0}))) := by
  let F_K := coeffIntermediateField (cuspDatumInftyGamma N) K
  let G := Subfield.closure
    (insert (Subgroup.compactifiedQuotientComap
        (Gamma N).map_sl2zToPSL2R_le_range_psl2zToPSL2R ModularGroup.jMeromorphicFunction)
      ((algebraMap ℂ _ '' K) ∪ (frickeMeromorphicFunction '' {a : Fin 2 → ZMod N | a ≠ 0})))
  let P : IntermediateField K F_K :=
    { carrier := {y : F_K | F_K.val y ∈ G}
      mul_mem' := fun {u v} hu hv ↦ by
        change F_K.val (u * v) ∈ G
        rw [map_mul]
        exact G.mul_mem hu hv
      one_mem' := by
        change F_K.val 1 ∈ G
        rw [map_one]
        exact G.one_mem
      add_mem' := fun {u v} hu hv ↦ by
        change F_K.val (u + v) ∈ G
        rw [map_add]
        exact G.add_mem hu hv
      zero_mem' := by
        change F_K.val 0 ∈ G
        rw [map_zero]
        exact G.zero_mem
      inv_mem' := fun {u} hu ↦ by
        change F_K.val u⁻¹ ∈ G
        rw [map_inv₀]
        exact G.inv_mem hu
      algebraMap_mem' := fun d ↦ by
        change F_K.val (algebraMap K F_K d) ∈ G
        rw [F_K.val.commutes]
        exact Subfield.subset_closure
          (Set.mem_insert_of_mem _ (Set.mem_union_left _ ⟨d.1, d.2, rfl⟩)) }
  have hle : K⟮modularFunctionJ N K⟯ ≤ P := IntermediateField.adjoin_le_iff.mpr fun y hy ↦ by
    rw [Set.mem_singleton_iff.mp hy]
    change F_K.val (modularFunctionJ N K) ∈ G
    rw [IntermediateField.coe_val, coe_modularFunctionJ]
    exact Subfield.subset_closure (Set.mem_insert _ _)
  exact hle c.2

private def frickeIntermediateField (N : ℕ) [NeZero N] (K : Subfield ℂ) :
    IntermediateField (K⟮modularFunctionJ N K⟯)
      (coeffIntermediateField (cuspDatumInftyGamma N) K) :=
  let F_K := coeffIntermediateField (cuspDatumInftyGamma N) K
  let G_sub := Subfield.closure
    (insert (Subgroup.compactifiedQuotientComap
        (Gamma N).map_sl2zToPSL2R_le_range_psl2zToPSL2R ModularGroup.jMeromorphicFunction)
      ((algebraMap ℂ _ '' K) ∪ (frickeMeromorphicFunction '' {a : Fin 2 → ZMod N | a ≠ 0})))
  { carrier := {y : F_K | F_K.val y ∈ G_sub}
    mul_mem' := fun {u v} hu hv ↦ by
      change F_K.val (u * v) ∈ G_sub
      rw [map_mul]
      exact G_sub.mul_mem hu hv
    one_mem' := by
      change F_K.val 1 ∈ G_sub
      rw [map_one]
      exact G_sub.one_mem
    add_mem' := fun {u v} hu hv ↦ by
      change F_K.val (u + v) ∈ G_sub
      rw [map_add]
      exact G_sub.add_mem hu hv
    zero_mem' := by
      change F_K.val 0 ∈ G_sub
      rw [map_zero]
      exact G_sub.zero_mem
    inv_mem' := fun {u} hu ↦ by
      change F_K.val u⁻¹ ∈ G_sub
      rw [map_inv₀]
      exact G_sub.inv_mem hu
    algebraMap_mem' := fun c ↦ coe_adjoin_j_mem_frickeClosure K c }

private theorem frickeClosure_le_coeffIntermediateField (K : Subfield ℂ)
    (hK : ∀ a : Fin 2 → ZMod N, a ≠ 0 →
      frickeMeromorphicFunction a ∈ coeffSubfield (cuspDatumInftyGamma N) K) :
    Subfield.closure
        (insert (Subgroup.compactifiedQuotientComap
            (Gamma N).map_sl2zToPSL2R_le_range_psl2zToPSL2R ModularGroup.jMeromorphicFunction)
          ((algebraMap ℂ _ '' K) ∪ (frickeMeromorphicFunction '' {a : Fin 2 → ZMod N | a ≠ 0}))) ≤
      (coeffIntermediateField (cuspDatumInftyGamma N) K).toSubfield := by
  have hF_toSub : (coeffIntermediateField (cuspDatumInftyGamma N) K).toSubfield =
      coeffSubfield (cuspDatumInftyGamma N) K := SetLike.ext fun _ ↦ mem_coeffIntermediateField
  rw [hF_toSub, Subfield.closure_le, Set.insert_subset_iff, Set.union_subset_iff]
  refine ⟨?_, ?_, ?_⟩
  · exact (compactifiedQuotientComap_mem_coeffSubfield_iff
      (D := cuspDatumInftyGamma N) _ (by simp)).mpr
      (ModularGroup.jMeromorphicFunction_mem_coeffSubfield K)
  · rintro _ ⟨c, hc, rfl⟩
    exact (algebraMap_mem_coeffSubfield _).mpr hc
  · rintro _ ⟨a, ha, rfl⟩
    exact hK a ha

private def frickeIntermediateFieldAut (K : Subfield ℂ)
    (hK : ∀ a : Fin 2 → ZMod N, a ≠ 0 →
      frickeMeromorphicFunction a ∈ coeffSubfield (cuspDatumInftyGamma N) K)
    (τ : (modularFunctionActionZMod N).range.unop) :
    frickeIntermediateField N K ≃ₐ[K⟮modularFunctionJ N K⟯] frickeIntermediateField N K :=
  let F_K := coeffIntermediateField (cuspDatumInftyGamma N) K
  let hGF := frickeClosure_le_coeffIntermediateField K hK
  { toFun := fun y ↦
      ⟨⟨τ.1 (F_K.val y.1), hGF (frickeClosure_le_comap_modularFunctionActionZMod K τ y.2)⟩,
        frickeClosure_le_comap_modularFunctionActionZMod K τ y.2⟩
    invFun := fun y ↦
      ⟨⟨τ⁻¹.1 (F_K.val y.1), hGF (frickeClosure_le_comap_modularFunctionActionZMod K τ⁻¹ y.2)⟩,
        frickeClosure_le_comap_modularFunctionActionZMod K τ⁻¹ y.2⟩
    left_inv := fun y ↦ Subtype.ext <| Subtype.ext <| by
      change (τ⁻¹ * τ).1 (F_K.val y.1) = F_K.val y.1
      rw [inv_mul_cancel]
      rfl
    right_inv := fun y ↦ Subtype.ext <| Subtype.ext <| by
      change (τ * τ⁻¹).1 (F_K.val y.1) = F_K.val y.1
      rw [mul_inv_cancel]
      rfl
    map_mul' := fun x y ↦ Subtype.ext <| Subtype.ext <|
      (congrArg τ.1 (map_mul F_K.val x.1 y.1)).trans (map_mul τ.1 _ _)
    map_add' := fun x y ↦ Subtype.ext <| Subtype.ext <|
      (congrArg τ.1 (map_add F_K.val x.1 y.1)).trans (map_add τ.1 _ _)
    commutes' := fun c ↦ Subtype.ext <| Subtype.ext <|
      modularFunctionActionZMod_fix_adjoin_j K τ c }

private theorem frickeIntermediateFieldAut_injective (K : Subfield ℂ)
    (hK : ∀ a : Fin 2 → ZMod N, a ≠ 0 →
      frickeMeromorphicFunction a ∈ coeffSubfield (cuspDatumInftyGamma N) K) :
    Function.Injective (frickeIntermediateFieldAut K hK) := fun τ₁ τ₂ h ↦ by
  let F_K := coeffIntermediateField (cuspDatumInftyGamma N) K
  let hGF := frickeClosure_le_coeffIntermediateField K hK
  obtain ⟨g₁, hg₁⟩ := Subgroup.mem_unop.mp τ₁.2
  obtain ⟨g₂, hg₂⟩ := Subgroup.mem_unop.mp τ₂.2
  have hτ₁ : τ₁.1 = unop (modularFunctionActionZMod N g₁) := by rw [← unop_op τ₁.1, ← hg₁]
  have hτ₂ : τ₂.1 = unop (modularFunctionActionZMod N g₂) := by rw [← unop_op τ₂.1, ← hg₂]
  have hfix : ∀ a : Fin 2 → ZMod N, a ≠ 0 →
      unop (modularFunctionActionZMod N (g₂ * g₁⁻¹)) (frickeMeromorphicFunction a) =
        frickeMeromorphicFunction a := fun a ha ↦ by
    have hfaG : frickeMeromorphicFunction a ∈ Subfield.closure
        (insert (Subgroup.compactifiedQuotientComap
            (Gamma N).map_sl2zToPSL2R_le_range_psl2zToPSL2R ModularGroup.jMeromorphicFunction)
          ((algebraMap ℂ _ '' K) ∪
            (frickeMeromorphicFunction '' {a : Fin 2 → ZMod N | a ≠ 0}))) :=
      Subfield.subset_closure (Set.mem_insert_of_mem _ (Set.mem_union_right _ ⟨a, ha, rfl⟩))
    let fa : frickeIntermediateField N K := ⟨⟨frickeMeromorphicFunction a, hGF hfaG⟩, hfaG⟩
    have h12 : unop (modularFunctionActionZMod N g₁) (frickeMeromorphicFunction a) =
        unop (modularFunctionActionZMod N g₂) (frickeMeromorphicFunction a) := by
      have := congrArg (fun (φ : frickeIntermediateField N K ≃ₐ[K⟮modularFunctionJ N K⟯]
          frickeIntermediateField N K) ↦ F_K.val (φ fa).1) h
      change τ₁.1 (frickeMeromorphicFunction a) = τ₂.1 (frickeMeromorphicFunction a) at this
      rwa [hτ₁, hτ₂] at this
    rw [map_mul, MulOpposite.unop_mul, AlgEquiv.mul_apply, ← h12,
      ← AlgEquiv.mul_apply, ← MulOpposite.unop_mul, ← map_mul, mul_inv_cancel, map_one,
      MulOpposite.unop_one, AlgEquiv.one_apply]
  refine Subtype.ext ?_
  rw [hτ₁, hτ₂]
  rcases (forall_unop_modularFunctionActionZMod_frickeMeromorphicFunction_eq_iff
    (g₂ * g₁⁻¹)).mp hfix with h1 | h1
  · rw [eq_of_mul_inv_eq_one h1]
  · have hg : g₂ = -g₁ := by simpa using congrArg (· * g₁) h1
    rw [hg, modularFunctionActionZMod_neg]

/-- If every Fricke function `f_a` (`a ≠ 0`) has its Laurent `q_N`-expansion coefficients in a
subfield `K` of `ℂ`, then `j`, `K`, and `{f_a : a ≠ 0}` generate the coefficient field over `K`,
and its degree over `K(j)` equals the order of the image of `SL(2, ℤ/Nℤ)`. -/
private theorem coeffSubfield_eq_closure_and_finrank (K : Subfield ℂ)
    (hK : ∀ a : Fin 2 → ZMod N, a ≠ 0 →
      frickeMeromorphicFunction a ∈ coeffSubfield (cuspDatumInftyGamma N) K) :
    coeffSubfield (cuspDatumInftyGamma N) K =
        Subfield.closure
          (insert (Subgroup.compactifiedQuotientComap
              (Gamma N).map_sl2zToPSL2R_le_range_psl2zToPSL2R ModularGroup.jMeromorphicFunction)
            ((algebraMap ℂ _ '' K) ∪ (frickeMeromorphicFunction '' {a : Fin 2 → ZMod N | a ≠ 0}))) ∧
      Module.finrank (K⟮modularFunctionJ N K⟯)
          (coeffIntermediateField (cuspDatumInftyGamma N) K) =
        Nat.card (modularFunctionActionZMod N).range.unop := by
  let F_K := coeffIntermediateField (cuspDatumInftyGamma N) K
  let E := K⟮modularFunctionJ N K⟯
  let G := frickeIntermediateField N K
  have hF_toSub : F_K.toSubfield = coeffSubfield (cuspDatumInftyGamma N) K :=
    SetLike.ext fun _ ↦ mem_coeffIntermediateField
  have hGF := frickeClosure_le_coeffIntermediateField K hK
  have : FiniteDimensional E G :=
    FiniteDimensional.of_injective G.val.toLinearMap G.val.injective
  have hle_G : Nat.card (modularFunctionActionZMod N).range.unop ≤ Module.finrank E G :=
    (Nat.card_le_card_of_injective (frickeIntermediateFieldAut K hK)
      (frickeIntermediateFieldAut_injective K hK)).trans
      (Nat.le_of_dvd Module.finrank_pos (natCard_algEquiv_dvd_finrank E G))
  have hG_le_F : Module.finrank E G ≤ Module.finrank E F_K :=
    Submodule.finrank_le G.toSubmodule
  have hF_le : Module.finrank E F_K ≤ Nat.card (modularFunctionActionZMod N).range.unop :=
    finrank_adjoin_modularFunctionJ_le N K
  have htop : G.toSubmodule = ⊤ :=
    Submodule.eq_top_of_finrank_eq (le_antisymm hG_le_F (hF_le.trans hle_G))
  refine ⟨le_antisymm (fun x hx ↦ ?_) (hF_toSub ▸ hGF), le_antisymm hF_le (hle_G.trans hG_le_F)⟩
  have hmem : (⟨x, mem_coeffIntermediateField.mpr hx⟩ : F_K) ∈ G.toSubmodule :=
    htop.symm ▸ Submodule.mem_top
  exact hmem

/-- **Arithmetic generation of `F_N`.** The field `F_N` of level-`N` modular functions with
coefficients in `ℚ(ζ_N)` is generated by `j` (pulled back from `X(1)`), the constants in `ℚ(ζ_N)`,
and the Fricke functions `f_a` (`a ≠ 0`). -/
theorem modularFunctionField_eq_closure :
    modularFunctionField N = Subfield.closure
      (insert (Subgroup.compactifiedQuotientComap (Gamma N).map_sl2zToPSL2R_le_range_psl2zToPSL2R
          ModularGroup.jMeromorphicFunction)
        ((algebraMap ℂ _ '' Subfield.closure {z : ℂ | z ^ N = 1}) ∪
          (frickeMeromorphicFunction '' {a : Fin 2 → ZMod N | a ≠ 0}))) := by
  rw [modularFunctionField_def]
  exact (coeffSubfield_eq_closure_and_finrank (Subfield.closure {z : ℂ | z ^ N = 1}) fun a _ ↦
    modularFunctionField_def (N := N) ▸ frickeMeromorphicFunction_mem_modularFunctionField a).1

/-- **The exact degree of `F_N` over `ℚ(ζ_N)(j)`.** The arithmetic modular function field `F_N`
has degree over `ℚ(ζ_N)(j)` equal to the order of the image of `SL(2, ℤ/Nℤ)`, matching the
complex degree of `X(N)` over `X(1)`. -/
theorem finrank_adjoin_modularFunctionJ_cyclotomic :
    Module.finrank
        ((Subfield.closure {z : ℂ | z ^ N = 1})⟮modularFunctionJ N
          (Subfield.closure {z : ℂ | z ^ N = 1})⟯)
        (coeffIntermediateField (cuspDatumInftyGamma N) (Subfield.closure {z : ℂ | z ^ N = 1})) =
      Nat.card (modularFunctionActionZMod N).range.unop :=
  (coeffSubfield_eq_closure_and_finrank (Subfield.closure {z : ℂ | z ^ N = 1}) fun a _ ↦
    modularFunctionField_def (N := N) ▸ frickeMeromorphicFunction_mem_modularFunctionField a).2

/-- **`F_N` is stable under `SL(2, ℤ/Nℤ)`.** For every `g ∈ SL(2, ℤ/Nℤ)` and `F ∈ F_N`, the
fractional linear translate `g` of `F` still has its Laurent `q_N`-expansion coefficients in
`ℚ(ζ_N)`. -/
theorem unop_modularFunctionActionZMod_mem_modularFunctionField (g : SL(2, ZMod N))
    {F : MeromorphicFunction ((Gamma N).map sl2zToPSL2R).CompactifiedQuotient}
    (hF : F ∈ modularFunctionField N) :
    unop (modularFunctionActionZMod N g) F ∈ modularFunctionField N := by
  have hle : modularFunctionField N ≤
      (modularFunctionField N).comap (unop (modularFunctionActionZMod N g)).toRingHom := by
    conv_lhs => rw [modularFunctionField_eq_closure]
    rw [Subfield.closure_le, Set.insert_subset_iff, Set.union_subset_iff]
    refine ⟨?_, ?_, ?_⟩
    · change unop (modularFunctionActionZMod N g) _ ∈ modularFunctionField N
      rw [unop_modularFunctionActionZMod_compactifiedQuotientComap]
      exact compactifiedQuotientComap_jMeromorphicFunction_mem_modularFunctionField
    · rintro _ ⟨c, hc, rfl⟩
      change unop (modularFunctionActionZMod N g) (algebraMap ℂ _ c) ∈ modularFunctionField N
      rw [AlgEquiv.commutes]
      exact algebraMap_mem_modularFunctionField.mpr hc
    · rintro _ ⟨a, -, rfl⟩
      change unop (modularFunctionActionZMod N g) (frickeMeromorphicFunction a) ∈
        modularFunctionField N
      rw [unop_modularFunctionActionZMod_frickeMeromorphicFunction]
      exact frickeMeromorphicFunction_mem_modularFunctionField _
  exact hle hF

/-- **`F_N` is stable under `SL(2, ℤ)`.** For every `γ ∈ SL(2, ℤ)` and `F ∈ F_N`, the fractional
linear translate `γ` of `F` still lies in `F_N`. -/
theorem unop_modularFunctionAction_mem_modularFunctionField (γ : SL(2, ℤ))
    {F : MeromorphicFunction ((Gamma N).map sl2zToPSL2R).CompactifiedQuotient}
    (hF : F ∈ modularFunctionField N) :
    unop (modularFunctionAction N γ) F ∈ modularFunctionField N := by
  rw [← modularFunctionActionZMod_map]
  exact unop_modularFunctionActionZMod_mem_modularFunctionField _ hF

end TauCeti
